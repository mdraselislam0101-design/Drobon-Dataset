{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0133",
  "title": "poetry.lock entry resolved from git",
  "description": "poetry.lock declares a locked package whose source type is `git`. The code sits outside index publication controls, so the lockfile hash model and advisory ranges do not describe it.",
  "severity": "MEDIUM",
  "cwe": "CWE-829",
  "category": "lockfile-integrity",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "poetry.lock",
  "parser": "toml",
  "check": {
    "type": "sca-field-matches",
    "path": "package[].source.type",
    "valuePattern": "^git$"
  },
  "tests": [
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "acme-sdk",
            "version": "4.2.0",
            "files": [
              {
                "file": "acme-sdk-4.2.0.tar.gz",
                "hash": "sha256:aaaa"
              }
            ],
            "source": {
              "type": "git",
              "url": "https://github.com/acme/sdk.git",
              "resolved_reference": "9f2c4a1"
            }
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "acme-cli",
            "version": "2.1.0",
            "files": [
              {
                "file": "acme-cli-2.1.0.tar.gz",
                "hash": "sha256:aaaa"
              }
            ],
            "source": {
              "type": "git",
              "url": "https://github.com/acme/cli.git",
              "reference": "main"
            }
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "version": "2.32.3",
            "files": [
              {
                "file": "requests-2.32.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": false
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "acme-sdk",
            "version": "4.2.0",
            "files": [
              {
                "file": "acme-sdk-4.2.0.tar.gz",
                "hash": "sha256:aaaa"
              }
            ],
            "source": {
              "type": "legacy",
              "url": "https://pypi.acme.example/simple"
            }
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2270"
  ],
  "remediation": "Publish the package and lock the released version from the index.",
  "limitation": "It matches a locked package whose source type is `git` in the parsed poetry.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
