{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-1019",
  "title": "Target-specific dependency declared as a wildcard",
  "description": "Cargo.toml declares a `*` version under a `[target.*.dependencies]` table. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a `*` version under a `[target.*.dependencies]` table.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "cargo"
  ],
  "artifact": "Cargo.toml",
  "parser": "toml",
  "check": {
    "type": "sca-field-matches",
    "path": "target.*.dependencies.*.version",
    "valuePattern": "^\\*$"
  },
  "tests": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "target": {
          "cfg(unix)": {
            "dependencies": {
              "nix": {
                "version": "*"
              }
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "target": {
          "cfg(windows)": {
            "dependencies": {
              "winapi": {
                "version": "*"
              }
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "target": {
          "cfg(unix)": {
            "dependencies": {
              "nix": {
                "version": "0.29.0"
              }
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "target": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3156"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a `*` version under a `[target.*.dependencies]` table.",
  "limitation": "It matches a `*` version under a `[target.*.dependencies]` table in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
