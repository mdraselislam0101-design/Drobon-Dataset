{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0803",
  "title": "Interpreter floor with no upper bound",
  "description": "setup.cfg declares a `python_requires` of `>=X.Y` only. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a `python_requires` of `>=X.Y` only.",
  "severity": "LOW",
  "cwe": "CWE-1104",
  "category": "policy-metadata",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "setup.cfg",
  "parser": "ini",
  "check": {
    "type": "sca-field-matches",
    "path": "options.python_requires",
    "valuePattern": "^>=\\d+\\.\\d+$"
  },
  "tests": [
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "python_requires": ">=3.9"
        }
      },
      "match": true
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "python_requires": ">=3.10"
        }
      },
      "match": true
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "python_requires": ">=3.10,<4"
        }
      },
      "match": false
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "python_requires": ">=3.11,<3.14"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2940"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a `python_requires` of `>=X.Y` only.",
  "limitation": "It matches a `python_requires` of `>=X.Y` only in the parsed setup.cfg; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
