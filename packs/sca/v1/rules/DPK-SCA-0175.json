{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0175",
  "title": "Gradle verification entry without an artifact hash",
  "description": "verification-metadata.xml declares a dependency verification entry whose artifact records no checksum. Dependency verification is on, but that entry cannot verify anything, so a substituted jar passes while the build still claims verification.",
  "severity": "MEDIUM",
  "cwe": "CWE-494",
  "category": "lockfile-integrity",
  "ecosystems": [
    "gradle"
  ],
  "artifact": "verification-metadata.xml",
  "parser": "xml",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "components[].artifacts",
    "field": "sha256"
  },
  "tests": [
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "com.acme",
            "name": "internal-core",
            "version": "1.4.2",
            "artifacts": [
              {
                "name": "internal-core-1.4.2.jar"
              }
            ]
          }
        ]
      },
      "match": true
    },
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "org.example",
            "name": "lib",
            "version": "2.0.1",
            "artifacts": [
              {
                "name": "lib-2.0.1.jar"
              }
            ]
          }
        ]
      },
      "match": true
    },
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "com.acme",
            "name": "internal-core",
            "version": "1.4.2",
            "artifacts": [
              {
                "name": "internal-core-1.4.2.jar",
                "sha256": "aaaabbbb"
              }
            ]
          }
        ]
      },
      "match": false
    },
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "org.example",
            "name": "lib",
            "version": "2.0.1",
            "artifacts": [
              {
                "name": "lib-2.0.1.jar",
                "sha256": "ccccdddd"
              }
            ]
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2312"
  ],
  "remediation": "Regenerate the verification metadata so every artifact carries a checksum.",
  "limitation": "It matches a dependency verification entry whose artifact records no checksum in the parsed verification-metadata.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
