{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0203",
  "title": "Gemfile requirement with an open lower bound",
  "description": "Gemfile declares a `>=` requirement with no upper bound. Every later major satisfies the requirement, so Bundler can resolve an incompatible release the project never tested.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "rubygems"
  ],
  "artifact": "Gemfile",
  "parser": "lockfile-text",
  "check": {
    "type": "sca-field-matches",
    "path": "gems[].requirement",
    "valuePattern": "^>=\\s*\\d"
  },
  "tests": [
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "requirement": ">= 7.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "puma",
            "requirement": ">= 6.4.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "requirement": "~> 7.1.3"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "puma",
            "requirement": "6.4.2"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2340"
  ],
  "remediation": "Use a pessimistic (`~>`) requirement or pin the exact version.",
  "limitation": "It matches a `>=` requirement with no upper bound in the parsed Gemfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
