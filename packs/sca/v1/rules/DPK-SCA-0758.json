{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0758",
  "title": "Crate dependency declared by major version only",
  "description": "Cargo.toml declares a version string that is a bare major number. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a version string that is a bare major number.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "cargo"
  ],
  "artifact": "Cargo.toml",
  "parser": "toml",
  "check": {
    "type": "sca-field-matches",
    "path": "dependencies.*.version",
    "valuePattern": "^\\d+$"
  },
  "tests": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          },
          "tokio": {
            "version": "1"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          },
          "tokio": {
            "version": "1.40.0"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2895"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a version string that is a bare major number.",
  "limitation": "It matches a version string that is a bare major number in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
