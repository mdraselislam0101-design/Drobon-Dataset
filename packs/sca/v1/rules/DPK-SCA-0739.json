{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0739",
  "title": "Locked package hosted over cleartext",
  "description": "pubspec.lock declares a hosted description URL over cleartext. An artifact fetched over plain HTTP can be replaced in transit, so the bytes that install are not bound to what the author published. This rule reads a hosted description URL over cleartext.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "registry-configuration",
  "ecosystems": [
    "pub"
  ],
  "artifact": "pubspec.lock",
  "parser": "yaml",
  "check": {
    "type": "sca-field-matches",
    "path": "packages.*.description.url",
    "valuePattern": "^http://"
  },
  "tests": [
    {
      "file": "pubspec.lock",
      "document": {
        "packages": {
          "http": {
            "version": "1.2.0",
            "source": "hosted",
            "description": {
              "name": "http",
              "url": "http://pub.acme.example"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pubspec.lock",
      "document": {
        "packages": {
          "http": {
            "version": "1.2.0",
            "source": "hosted",
            "description": {
              "name": "http",
              "url": "https://pub.dev"
            }
          },
          "intl": {
            "version": "0.19.0",
            "source": "hosted",
            "description": {
              "url": "http://10.24.8.9"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pubspec.lock",
      "document": {
        "packages": {
          "http": {
            "version": "1.2.0",
            "source": "hosted",
            "description": {
              "name": "http",
              "url": "https://pub.dev"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "pubspec.lock",
      "document": {
        "packages": {
          "http": {
            "version": "1.2.0",
            "source": "hosted",
            "description": {
              "name": "http",
              "url": "https://pub.dev"
            }
          },
          "intl": {
            "version": "0.19.0",
            "source": "hosted",
            "description": {
              "url": "https://pub.acme.example"
            }
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2876"
  ],
  "remediation": "Use the HTTPS endpoint the registry publishes and keep the hostname in the configuration reviewable. Specifically: fix a hosted description URL over cleartext.",
  "limitation": "It matches a hosted description URL over cleartext in the parsed pubspec.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
