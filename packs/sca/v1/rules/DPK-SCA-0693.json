{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0693",
  "title": "Arithmetic overflow wraps silently in release builds",
  "description": "Cargo.toml declares a release profile that switches integer overflow checks off. A verification or locking control is switched off, so the integrity guarantees the ecosystem offers are not applied here. This rule reads a release profile that switches integer overflow checks off.",
  "severity": "MEDIUM",
  "cwe": "CWE-190",
  "category": "policy-metadata",
  "ecosystems": [
    "cargo"
  ],
  "artifact": "Cargo.toml",
  "parser": "toml",
  "check": {
    "type": "sca-field-matches",
    "path": "profile.release.overflow-checks",
    "valuePattern": "^false$"
  },
  "tests": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "profile": {
          "release": {
            "overflow-checks": false
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "profile": {
          "release": {
            "overflow-checks": "false"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "profile": {
          "release": {
            "overflow-checks": true
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "profile": {
          "release": {
            "overflow-checks": "true"
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2830"
  ],
  "remediation": "Turn the control back on and fix what it reported instead of disabling the check. Specifically: fix a release profile that switches integer overflow checks off.",
  "limitation": "It matches a release profile that switches integer overflow checks off in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
