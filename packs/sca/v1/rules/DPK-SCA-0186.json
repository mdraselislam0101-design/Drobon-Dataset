{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0186",
  "title": "Central package version entry without a version",
  "description": "Directory.Packages.props declares a `PackageVersion` entry that declares no version. With central package management the version comes from this file only, so an empty entry leaves the restore to the feed's latest.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "nuget"
  ],
  "artifact": "Directory.Packages.props",
  "parser": "xml",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "project.itemGroup.PackageVersion",
    "field": "Version"
  },
  "tests": [
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Serilog"
              },
              {
                "Include": "Dapper",
                "Version": "2.1.35"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          }
        }
      },
      "match": false
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Dapper",
                "Version": "2.1.35"
              }
            ]
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2323"
  ],
  "remediation": "Record the version the project tested for every centrally managed package.",
  "limitation": "It matches a `PackageVersion` entry that declares no version in the parsed Directory.Packages.props; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
