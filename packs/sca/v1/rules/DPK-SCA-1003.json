{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-1003",
  "title": "Repository restricted to snapshots",
  "description": "build.gradle declares a repository that serves only snapshot artifacts. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a repository that serves only snapshot artifacts.",
  "severity": "MEDIUM",
  "cwe": "CWE-829",
  "category": "registry-configuration",
  "ecosystems": [
    "gradle"
  ],
  "artifact": "build.gradle",
  "parser": "gradle",
  "check": {
    "type": "sca-field-matches",
    "path": "repositories[].mavenContent.snapshotsOnly",
    "valuePattern": "^true$"
  },
  "tests": [
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "acme",
            "url": "https://nexus.acme.example/snapshots",
            "mavenContent": {
              "snapshotsOnly": true
            }
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "internal",
            "url": "https://nexus.acme.example/snapshots",
            "mavenContent": {
              "snapshotsOnly": "true"
            }
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2",
            "mavenContent": {
              "releasesOnly": true
            }
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3140"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a repository that serves only snapshot artifacts.",
  "limitation": "It matches a repository that serves only snapshot artifacts in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
