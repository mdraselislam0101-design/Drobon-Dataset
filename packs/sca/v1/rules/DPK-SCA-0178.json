{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0178",
  "title": "go.sum records a non-standard hash prefix",
  "description": "go.sum declares a checksum file in which no line carries the expected `h1:` hash. Go only enforces the `h1:` directory hash, so lines in another format are either ignored or rejected rather than verified.",
  "severity": "MEDIUM",
  "cwe": "CWE-494",
  "category": "lockfile-integrity",
  "ecosystems": [
    "go"
  ],
  "artifact": "go.sum",
  "parser": "lockfile-text",
  "check": {
    "type": "sca-field-not-matches",
    "path": "entries[].hash",
    "valuePattern": "^h1:"
  },
  "tests": [
    {
      "file": "go.sum",
      "document": {
        "entries": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0",
            "hash": "sha1:aaaabbbb"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.sum",
      "document": {
        "entries": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.1.0",
            "hash": "md5:ccccdddd"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.sum",
      "document": {
        "entries": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0",
            "hash": "h1:aaaa"
          }
        ]
      },
      "match": false
    },
    {
      "file": "go.sum",
      "document": {
        "entries": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.1.0",
            "hash": "h1:bbbb"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2315"
  ],
  "remediation": "Regenerate `go.sum` so every line carries an `h1:` hash.",
  "limitation": "It matches a checksum file in which no line carries the expected `h1:` hash in the parsed go.sum; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
