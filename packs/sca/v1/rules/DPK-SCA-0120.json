{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0120",
  "title": "Python requirement verified with a SHA-1 hash",
  "description": "requirements.txt declares a `--hash` value that uses SHA-1. SHA-1 collisions are practical, so the hash cannot prove that the artifact is the one that was reviewed.",
  "severity": "MEDIUM",
  "cwe": "CWE-328",
  "category": "lockfile-integrity",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "requirements.txt",
  "parser": "requirements",
  "check": {
    "type": "sca-field-matches",
    "path": "requirements[].hashes[]",
    "valuePattern": "^sha1:"
  },
  "tests": [
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "requests",
            "specifier": "==2.32.3",
            "hashes": [
              "sha1:aaaabbbbccccddddeeeeffff"
            ]
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "flask",
            "specifier": "==3.0.3",
            "hashes": [
              "sha1:111122223333444455556666"
            ]
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "requests",
            "specifier": "==2.32.3",
            "hashes": [
              "sha256:aaaa"
            ]
          }
        ]
      },
      "match": false
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "flask",
            "specifier": "==3.0.3",
            "hashes": [
              "sha256:bbbb"
            ]
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2257"
  ],
  "remediation": "Record a `sha256:` hash from the index metadata.",
  "limitation": "It matches a `--hash` value that uses SHA-1 in the parsed requirements.txt; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
