{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0745",
  "title": "Dependency marked optional at the root",
  "description": "pom.xml declares an optional dependency that no consumer inherits. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads an optional dependency that no consumer inherits.",
  "severity": "LOW",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "maven"
  ],
  "artifact": "pom.xml",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "project.dependencies[].optional",
    "valuePattern": "^true$"
  },
  "tests": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "sdk",
              "version": "4.2.0",
              "optional": "true"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "com.google.guava",
              "artifactId": "guava",
              "version": "33.3.0-jre",
              "optional": "true"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "sdk",
              "version": "4.2.0",
              "optional": "false"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api",
              "version": "2.0.13"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2882"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix an optional dependency that no consumer inherits.",
  "limitation": "It matches an optional dependency that no consumer inherits in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
