{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0177",
  "title": "Gradle properties point at a cleartext repository",
  "description": "gradle.properties declares a repository URL property that uses cleartext http. The whole build resolves through an unencrypted endpoint, so artifacts and checksums can be replaced in transit.",
  "severity": "HIGH",
  "cwe": "CWE-319",
  "category": "registry-configuration",
  "ecosystems": [
    "gradle"
  ],
  "artifact": "gradle.properties",
  "parser": "properties",
  "check": {
    "type": "sca-field-matches",
    "path": "properties.repoUrl",
    "valuePattern": "^http://"
  },
  "tests": [
    {
      "file": "gradle.properties",
      "document": {
        "properties": {
          "repoUrl": "http://repo.acme.example/maven2"
        }
      },
      "match": true
    },
    {
      "file": "gradle.properties",
      "document": {
        "properties": {
          "repoUrl": "http://10.24.8.9/maven2"
        }
      },
      "match": true
    },
    {
      "file": "gradle.properties",
      "document": {
        "properties": {
          "repoUrl": "https://repo.acme.example/maven2"
        }
      },
      "match": false
    },
    {
      "file": "gradle.properties",
      "document": {
        "properties": {
          "repoUrl": "https://nexus.acme.example/repository/releases"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2314"
  ],
  "remediation": "Point the property at https.",
  "limitation": "It matches a repository URL property that uses cleartext http in the parsed gradle.properties; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
