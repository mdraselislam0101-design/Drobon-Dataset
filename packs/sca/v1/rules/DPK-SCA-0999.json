{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0999",
  "title": "BOM imported as an ordinary dependency",
  "description": "pom.xml declares a dependency of `type` `pom` without scope `import`. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a dependency of `type` `pom` without scope `import`.",
  "severity": "LOW",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "maven"
  ],
  "artifact": "pom.xml",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "project.dependencies[].type",
    "valuePattern": "^pom$"
  },
  "tests": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "properties": {
            "maven.compiler.release": "21",
            "project.build.sourceEncoding": "UTF-8"
          },
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.springframework.boot",
              "artifactId": "spring-boot-dependencies",
              "version": "3.3.4",
              "type": "pom"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
