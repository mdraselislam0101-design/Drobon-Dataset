{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0165",
  "title": "Maven parent declared with a version range",
  "description": "pom.xml declares a parent POM version written as a range. The dependency management the build inherits changes with every matching parent release, so reviewed versions can move without a commit.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "maven"
  ],
  "artifact": "pom.xml",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "project.parent.version",
    "valuePattern": "^\\["
  },
  "tests": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "parent": {
            "groupId": "com.acme",
            "artifactId": "platform-parent",
            "version": "[1.0,2.0)"
          }
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "parent": {
            "groupId": "com.acme",
            "artifactId": "service-parent",
            "version": "[4.0,)"
          }
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "parent": {
            "groupId": "com.acme",
            "artifactId": "platform-parent",
            "version": "1.4.0"
          }
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "parent": {
            "groupId": "com.acme",
            "artifactId": "service-parent",
            "version": "4.2.0"
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2302"
  ],
  "remediation": "Pin the parent version exactly.",
  "limitation": "It matches a parent POM version written as a range in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
