{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0202",
  "title": "Gemfile entry with no version requirement",
  "description": "Gemfile declares a gem declared with no version requirement. Bundler resolves the newest release, so a gem published after review installs with no change to the Gemfile.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "rubygems"
  ],
  "artifact": "Gemfile",
  "parser": "lockfile-text",
  "check": {
    "type": "sca-field-matches",
    "path": "gems[].requirement",
    "valuePattern": "^$"
  },
  "tests": [
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "requirement": ""
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "puma",
            "requirement": ""
          },
          {
            "name": "rails",
            "requirement": "~> 7.1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "requirement": "~> 7.1.3"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "puma",
            "requirement": ">= 6.0"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2339"
  ],
  "remediation": "Declare the requirement the project tested and commit `Gemfile.lock`.",
  "limitation": "It matches a gem declared with no version requirement in the parsed Gemfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
