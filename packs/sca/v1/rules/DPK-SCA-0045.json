{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0045",
  "title": "Lockfile resolves a package over cleartext HTTP",
  "description": "package-lock.json declares a lockfile entry that resolves its tarball over cleartext http. Cleartext transport lets a network attacker replace the tarball in flight, and the integrity value only helps if it is checked against the substituted bytes.",
  "severity": "MEDIUM",
  "cwe": "CWE-494",
  "category": "supply-chain-integrity",
  "ecosystems": [
    "npm"
  ],
  "artifact": "package-lock.json",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "packages.*.resolved",
    "valuePattern": "^http://"
  },
  "tests": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "http://registry.acme.example/x/-/x-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "resolved": "http://mirror.acme.example/y/-/y-2.0.0.tgz"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org/x/-/x-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "resolved": "https://registry.npmjs.org/y/-/y-2.0.0.tgz"
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2182"
  ],
  "remediation": "Resolve the dependency over HTTPS and commit the regenerated lockfile.",
  "limitation": "It matches a lockfile entry that resolves its tarball over cleartext http in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
