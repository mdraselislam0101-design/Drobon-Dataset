{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0688",
  "title": "Locked graph mixes a local project into a package restore",
  "description": "packages.lock.json declares a locked dependency that resolves to a project reference. A dependency resolved from a local path or a mutable branch is not the published artifact the rest of the project audits. This rule reads a locked dependency that resolves to a project reference.",
  "severity": "LOW",
  "cwe": "CWE-829",
  "category": "dependency-confusion",
  "ecosystems": [
    "nuget"
  ],
  "artifact": "packages.lock.json",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "dependencies.*.*.type",
    "valuePattern": "^Project$"
  },
  "tests": [
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            },
            "Acme.Core": {
              "type": "Project",
              "resolved": "1.4.2"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            },
            "Acme.Sdk": {
              "type": "Project",
              "resolved": "4.2.0"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            },
            "Dapper": {
              "type": "Transitive",
              "resolved": "2.1.35"
            }
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2825"
  ],
  "remediation": "Depend on a published, versioned artifact, and keep local paths or branch references out of the committed manifest. Specifically: fix a locked dependency that resolves to a project reference.",
  "limitation": "It matches a locked dependency that resolves to a project reference in the parsed packages.lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
