{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0183",
  "title": "NuGet package declared with a version range",
  "description": "packages.config declares a package version written as a range. The restore resolves whatever satisfies the range on that day, so two restores of the same file can bring different code.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "nuget"
  ],
  "artifact": "packages.config",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "packages[].version",
    "valuePattern": "^\\["
  },
  "tests": [
    {
      "file": "packages.config",
      "document": {
        "packages": [
          {
            "id": "Newtonsoft.Json",
            "version": "[13.0.1,14.0.0)"
          }
        ]
      },
      "match": true
    },
    {
      "file": "packages.config",
      "document": {
        "packages": [
          {
            "id": "Serilog",
            "version": "[3.0.0,)"
          }
        ]
      },
      "match": true
    },
    {
      "file": "packages.config",
      "document": {
        "packages": [
          {
            "id": "Newtonsoft.Json",
            "version": "13.0.3"
          }
        ]
      },
      "match": false
    },
    {
      "file": "packages.config",
      "document": {
        "packages": [
          {
            "id": "Serilog",
            "version": "4.0.1"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2320"
  ],
  "remediation": "Pin the exact version and update it deliberately.",
  "limitation": "It matches a package version written as a range in the parsed packages.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
