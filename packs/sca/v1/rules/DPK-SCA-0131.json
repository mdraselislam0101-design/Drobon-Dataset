{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0131",
  "title": "poetry.lock entry without file hashes",
  "description": "poetry.lock declares a locked package that records no file hashes. Nothing ties the downloaded distribution to the lockfile, so a mirror or proxy can serve different bytes for the same version.",
  "severity": "MEDIUM",
  "cwe": "CWE-494",
  "category": "lockfile-integrity",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "poetry.lock",
  "parser": "toml",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "package",
    "field": "files"
  },
  "tests": [
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "version": "2.32.3"
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "flask",
            "version": "3.0.3"
          },
          {
            "name": "jinja2",
            "version": "3.1.4",
            "files": [
              {
                "file": "jinja2-3.1.4.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "version": "2.32.3",
            "files": [
              {
                "file": "requests-2.32.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": false
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "flask",
            "version": "3.0.3",
            "files": [
              {
                "file": "flask-3.0.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          },
          {
            "name": "jinja2",
            "version": "3.1.4",
            "files": [
              {
                "file": "jinja2-3.1.4.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2268"
  ],
  "remediation": "Regenerate the lockfile so every package records its file hashes.",
  "limitation": "It matches a locked package that records no file hashes in the parsed poetry.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
