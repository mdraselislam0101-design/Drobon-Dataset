{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0227",
  "title": "Package.resolved pin records no version",
  "description": "Package.resolved declares a resolved pin whose state carries only a revision. The dependency is a bare commit, so no release review or advisory range describes what is compiled.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "lockfile-integrity",
  "ecosystems": [
    "swift"
  ],
  "artifact": "Package.resolved",
  "parser": "json",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "pins[].state",
    "field": "version"
  },
  "tests": [
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "sdk",
            "location": "https://github.com/acme/sdk",
            "state": {
              "branch": null,
              "revision": "9f2c4a1b7c3d0a1b2c3d4e5f60718293"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "cli",
            "location": "https://github.com/acme/cli",
            "state": {
              "revision": "0a1b2c3d4e5f60718293a4b5c6d7e8f9"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "sdk",
            "location": "https://github.com/acme/sdk",
            "state": {
              "version": "4.2.0",
              "revision": "9f2c4a1"
            }
          }
        ]
      },
      "match": false
    },
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "cli",
            "location": "https://github.com/acme/cli",
            "state": {
              "version": "2.1.0",
              "revision": "0a1b2c3"
            }
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2364"
  ],
  "remediation": "Depend on a tagged version so the resolved pin records it.",
  "limitation": "It matches a resolved pin whose state carries only a revision in the parsed Package.resolved; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
