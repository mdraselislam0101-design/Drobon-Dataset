{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0230",
  "title": "Podfile installs a pod from git",
  "description": "Podfile declares a pod sourced from a git remote. The code is outside the spec repo's publication controls, so its checksum and version history are not covered.",
  "severity": "MEDIUM",
  "cwe": "CWE-829",
  "category": "dependency-hygiene",
  "ecosystems": [
    "cocoapods"
  ],
  "artifact": "Podfile",
  "parser": "lockfile-text",
  "check": {
    "type": "sca-field-matches",
    "path": "pods[].git",
    "valuePattern": "^https?://"
  },
  "tests": [
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "AcmeSDK",
            "git": "https://github.com/acme/sdk.git",
            "tag": "4.2.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "AcmeCLI",
            "git": "https://github.com/acme/cli.git",
            "branch": "main"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": "~> 5.9.1"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "SnapKit",
            "requirement": "5.7.1"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2367"
  ],
  "remediation": "Publish the pod to a spec repo and depend on the version.",
  "limitation": "It matches a pod sourced from a git remote in the parsed Podfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
