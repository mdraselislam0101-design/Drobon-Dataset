{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0998",
  "title": "Development requirement declared as a wildcard",
  "description": "Pipfile declares a `*` specifier in `[dev-packages]`. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a `*` specifier in `[dev-packages]`.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "Pipfile",
  "parser": "toml",
  "check": {
    "type": "sca-field-matches",
    "path": "dev-packages.*",
    "valuePattern": "^\\*$"
  },
  "tests": [
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "*"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3",
          "black": "*"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": false
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3",
          "black": "==24.8.0"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3135"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a `*` specifier in `[dev-packages]`.",
  "limitation": "It matches a `*` specifier in `[dev-packages]` in the parsed Pipfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
