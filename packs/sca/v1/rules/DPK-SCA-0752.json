{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0752",
  "title": "Build plugin resolved from a dynamic version",
  "description": "settings.gradle declares a plugin version written as `+` or `latest.release`. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a plugin version written as `+` or `latest.release`.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "gradle"
  ],
  "artifact": "settings.gradle",
  "parser": "gradle",
  "check": {
    "type": "sca-field-matches",
    "path": "pluginManagement.plugins[].version",
    "valuePattern": "^(?:\\+|latest\\.release)$"
  },
  "tests": [
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ],
          "plugins": [
            {
              "id": "com.acme.build",
              "version": "+"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ],
          "plugins": [
            {
              "id": "org.acme.plugin",
              "version": "latest.release"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ],
          "plugins": [
            {
              "id": "com.acme.build",
              "version": "4.2.0"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ],
          "plugins": []
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2889"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a plugin version written as `+` or `latest.release`.",
  "limitation": "It matches a plugin version written as `+` or `latest.release` in the parsed settings.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
