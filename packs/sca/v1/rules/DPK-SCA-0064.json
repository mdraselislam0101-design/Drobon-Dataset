{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0064",
  "title": "Lockfile entry without licence metadata",
  "description": "package-lock.json declares a package entry that records no licence. Redistribution rights cannot be established for a dependency whose licence is unknown, which blocks release review and downstream use.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "supply-chain-integrity",
  "ecosystems": [
    "npm"
  ],
  "artifact": "package-lock.json",
  "parser": "json",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "packages",
    "field": "license"
  },
  "tests": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "license": "MIT"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "license": "Apache-2.0"
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2201"
  ],
  "remediation": "Regenerate the lockfile with a registry that publishes licence metadata, and record the licence in review.",
  "limitation": "It matches a package entry that records no licence in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
