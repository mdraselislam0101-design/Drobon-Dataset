{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0014",
  "title": "Dependency fetched over cleartext HTTP",
  "description": "package.json declares a dependency URL that uses cleartext `http://`. Cleartext transport lets a network attacker replace the artifact in flight, and the substitution is invisible after the install succeeds.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "npm"
  ],
  "artifact": "package.json",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "dependencies.*",
    "valuePattern": "^http://"
  },
  "tests": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "http://downloads.acme.example/sdk-4.2.0.tgz"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "http://registry.acme.example/sdk"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "https://downloads.acme.example/sdk-4.2.0.tgz"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2151"
  ],
  "remediation": "Serve the artifact over HTTPS, or install from the registry.",
  "limitation": "It matches a dependency URL that uses cleartext `http://` in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
