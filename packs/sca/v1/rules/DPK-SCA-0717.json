{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0717",
  "title": "Dependency ranged with a caret under a zero-zero major",
  "description": "package.json declares a `^0.0.x` specifier whose range is a single patch. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a `^0.0.x` specifier whose range is a single patch.",
  "severity": "LOW",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "npm"
  ],
  "artifact": "package.json",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "dependencies.*",
    "valuePattern": "^\\^0\\.0\\.\\d+$"
  },
  "tests": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21",
          "acme-core": "^0.0.3"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21",
          "acme-sdk": "^0.0.9"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21",
          "acme-core": "^0.1.3"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2854"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a `^0.0.x` specifier whose range is a single patch.",
  "limitation": "It matches a `^0.0.x` specifier whose range is a single patch in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
