{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0237",
  "title": "conda channel configured over cleartext",
  "description": "environment.yml declares a channel URL that uses cleartext http. Packages cross the network unencrypted, so a network attacker can serve a different build of the same name and version.",
  "severity": "HIGH",
  "cwe": "CWE-319",
  "category": "registry-configuration",
  "ecosystems": [
    "conda"
  ],
  "artifact": "environment.yml",
  "parser": "yaml",
  "check": {
    "type": "sca-field-matches",
    "path": "channels[]",
    "valuePattern": "^http://"
  },
  "tests": [
    {
      "file": "environment.yml",
      "document": {
        "name": "demo",
        "channels": [
          "defaults",
          "http://conda.acme.example"
        ],
        "dependencies": []
      },
      "match": true
    },
    {
      "file": "environment.yml",
      "document": {
        "name": "demo",
        "channels": [
          "http://10.24.8.9/conda"
        ],
        "dependencies": []
      },
      "match": true
    },
    {
      "file": "environment.yml",
      "document": {
        "name": "demo",
        "channels": [
          "defaults",
          "conda-forge"
        ],
        "dependencies": []
      },
      "match": false
    },
    {
      "file": "environment.yml",
      "document": {
        "name": "demo",
        "channels": [
          "https://conda.acme.example"
        ],
        "dependencies": []
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2374"
  ],
  "remediation": "Use an https channel.",
  "limitation": "It matches a channel URL that uses cleartext http in the parsed environment.yml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
