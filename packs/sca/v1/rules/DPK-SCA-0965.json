{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0965",
  "title": "Resolution without metadata source policy",
  "description": "settings.gradle declares a setup that accepts whatever metadata variant a repository serves. Without a recorded digest the downloaded artifact cannot be checked against what was reviewed, so substitution is undetectable at install time. This rule reads a setup that accepts whatever metadata variant a repository serves.",
  "severity": "LOW",
  "cwe": "CWE-494",
  "category": "lockfile-integrity",
  "ecosystems": [
    "gradle"
  ],
  "artifact": "settings.gradle",
  "parser": "gradle",
  "check": {
    "type": "sca-field-absent",
    "path": "dependencyResolutionManagement.metadataSources"
  },
  "tests": [
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": []
        }
      },
      "match": true
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "metadataSources": {
            "gradleMetadata": true
          }
        }
      },
      "match": false
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "metadataSources": {
            "mavenPom": true
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3102"
  ],
  "remediation": "Regenerate the artifact with integrity data enabled and commit the recorded digest or checksum. Specifically: fix a setup that accepts whatever metadata variant a repository serves.",
  "limitation": "It matches a setup that accepts whatever metadata variant a repository serves in the parsed settings.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
