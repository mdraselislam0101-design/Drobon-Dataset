{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0996",
  "title": "Project dependency installed from git",
  "description": "pyproject.toml declares a PEP 508 git URL in `project.dependencies`. A dependency resolved from a local path or a mutable branch is not the published artifact the rest of the project audits. This rule reads a PEP 508 git URL in `project.dependencies`.",
  "severity": "MEDIUM",
  "cwe": "CWE-829",
  "category": "supply-chain-integrity",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "pyproject.toml",
  "parser": "toml",
  "check": {
    "type": "sca-field-matches",
    "path": "project.dependencies[]",
    "valuePattern": "^[^@]+@\\s*git\\+"
  },
  "tests": [
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "acme-sdk @ git+https://github.com/acme/sdk@v4.2.0"
          ],
          "license": {
            "text": "MIT"
          }
        },
        "build-system": {
          "requires": [
            "setuptools==75.1.0"
          ],
          "build-backend": "setuptools.build_meta"
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "acme-core @ git+ssh://git@github.com/acme/core"
          ],
          "license": {
            "text": "MIT"
          }
        },
        "build-system": {
          "requires": [
            "setuptools==75.1.0"
          ],
          "build-backend": "setuptools.build_meta"
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "requests==2.32.3"
          ],
          "license": {
            "text": "MIT"
          }
        },
        "build-system": {
          "requires": [
            "setuptools==75.1.0"
          ],
          "build-backend": "setuptools.build_meta"
        }
      },
      "match": false
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "urllib3==2.2.2"
          ],
          "license": {
            "text": "MIT"
          }
        },
        "build-system": {
          "requires": [
            "setuptools==75.1.0"
          ],
          "build-backend": "setuptools.build_meta"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3133"
  ],
  "remediation": "Depend on a published, versioned artifact, and keep local paths or branch references out of the committed manifest. Specifically: fix a PEP 508 git URL in `project.dependencies`.",
  "limitation": "It matches a PEP 508 git URL in `project.dependencies` in the parsed pyproject.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
