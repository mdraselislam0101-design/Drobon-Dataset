{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0118",
  "title": "Python requirement fetched from a direct URL",
  "description": "requirements.txt declares a requirement that points at a wheel or sdist URL instead of a package name. The artifact is fetched without index metadata, so its provenance and any advisory linkage are unknown at install time.",
  "severity": "MEDIUM",
  "cwe": "CWE-829",
  "category": "dependency-hygiene",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "requirements.txt",
  "parser": "requirements",
  "check": {
    "type": "sca-field-matches",
    "path": "requirements[].source",
    "valuePattern": "^https?://"
  },
  "tests": [
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "acme-sdk",
            "specifier": "",
            "source": "https://downloads.acme.example/acme_sdk-4.2.0-py3-none-any.whl"
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "acme-cli",
            "specifier": "",
            "source": "https://files.acme.example/cli.tar.gz"
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "acme-sdk",
            "specifier": "==4.2.0",
            "hashes": [
              "sha256:aaaa"
            ]
          }
        ]
      },
      "match": false
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "acme-cli",
            "specifier": "==2.1.0"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2255"
  ],
  "remediation": "Install from the index and pin the version with `--hash`.",
  "limitation": "It matches a requirement that points at a wheel or sdist URL instead of a package name in the parsed requirements.txt; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
