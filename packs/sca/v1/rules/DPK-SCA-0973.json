{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0973",
  "title": "Platform package faked for resolution",
  "description": "composer.json declares a `config.platform` entry that pretends an extension is absent. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a `config.platform` entry that pretends an extension is absent.",
  "severity": "LOW",
  "cwe": "CWE-1104",
  "category": "policy-metadata",
  "ecosystems": [
    "composer"
  ],
  "artifact": "composer.json",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "config.platform.*",
    "valuePattern": "^false$"
  },
  "tests": [
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0",
            "ext-gd": false
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0",
            "ext-intl": "false"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": false
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3110"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a `config.platform` entry that pretends an extension is absent.",
  "limitation": "It matches a `config.platform` entry that pretends an extension is absent in the parsed composer.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
