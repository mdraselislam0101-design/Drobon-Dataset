{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0137",
  "title": "Pipfile source configured over cleartext",
  "description": "Pipfile declares a Pipfile source URL that uses cleartext http. Artifacts and hashes travel unencrypted, so a network attacker can replace the package and the hash that verifies it.",
  "severity": "HIGH",
  "cwe": "CWE-319",
  "category": "registry-configuration",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "Pipfile",
  "parser": "toml",
  "check": {
    "type": "sca-field-matches",
    "path": "source[].url",
    "valuePattern": "^http://"
  },
  "tests": [
    {
      "file": "Pipfile",
      "document": {
        "source": [
          {
            "name": "acme",
            "url": "http://pypi.acme.example/simple",
            "verify_ssl": true
          }
        ],
        "packages": {}
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "source": [
          {
            "name": "mirror",
            "url": "http://10.24.8.9/simple",
            "verify_ssl": true
          }
        ],
        "packages": {}
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "source": [
          {
            "name": "pypi",
            "url": "https://pypi.org/simple",
            "verify_ssl": true
          }
        ],
        "packages": {}
      },
      "match": false
    },
    {
      "file": "Pipfile",
      "document": {
        "source": [
          {
            "name": "acme",
            "url": "https://pypi.acme.example/simple"
          }
        ],
        "packages": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2274"
  ],
  "remediation": "Point the source at an https endpoint.",
  "limitation": "It matches a Pipfile source URL that uses cleartext http in the parsed Pipfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
