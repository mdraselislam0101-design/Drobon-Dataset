{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0764",
  "title": "Repository declared non-canonical",
  "description": "composer.json declares a repository that load-balances with the default one. A name or scope that resolves outside the project's intended registry is fetched from a source nobody reviewed, so a publish there becomes an install here. This rule reads a repository that load-balances with the default one.",
  "severity": "LOW",
  "cwe": "CWE-829",
  "category": "registry-configuration",
  "ecosystems": [
    "composer"
  ],
  "artifact": "composer.json",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "repositories[].canonical",
    "valuePattern": "^false$"
  },
  "tests": [
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "composer",
            "url": "https://mirror.acme.example",
            "canonical": false
          }
        ]
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "composer",
            "url": "https://mirror2.acme.example",
            "canonical": "false"
          }
        ]
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "composer",
            "url": "https://packagist.org",
            "canonical": true
          }
        ]
      },
      "match": false
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": []
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2901"
  ],
  "remediation": "Point the declaration or the registry configuration at the namespace the project controls, and remove the lookup path that resolves elsewhere. Specifically: fix a repository that load-balances with the default one.",
  "limitation": "It matches a repository that load-balances with the default one in the parsed composer.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
