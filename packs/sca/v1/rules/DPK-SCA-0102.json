{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0102",
  "title": "pnpm lockfile fetches a tarball over cleartext",
  "description": "pnpm-lock.yaml declares a pnpm tarball URL that uses cleartext http. The package crosses the network unencrypted, so its bytes can be replaced before the integrity check runs.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "lockfile-integrity",
  "ecosystems": [
    "npm"
  ],
  "artifact": "pnpm-lock.yaml",
  "parser": "yaml",
  "check": {
    "type": "sca-field-matches",
    "path": "packages.*.resolution.tarball",
    "valuePattern": "^http://"
  },
  "tests": [
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/left-pad@1.3.0": {
            "resolution": {
              "tarball": "http://registry.acme.example/left-pad-1.3.0.tgz"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/ms@2.1.3": {
            "resolution": {
              "tarball": "http://10.24.8.9/ms-2.1.3.tgz"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/left-pad@1.3.0": {
            "resolution": {
              "tarball": "https://registry.npmjs.org/left-pad/-/left-pad-1.3.0.tgz"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/ms@2.1.3": {
            "resolution": {
              "integrity": "sha512-BBBB"
            }
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2239"
  ],
  "remediation": "Serve the tarball over https, or drop the explicit URL and use the registry.",
  "limitation": "It matches a pnpm tarball URL that uses cleartext http in the parsed pnpm-lock.yaml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
