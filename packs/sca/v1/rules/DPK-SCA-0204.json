{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0204",
  "title": "Gemfile installs a gem from a git remote",
  "description": "Gemfile declares a gem sourced from a git remote rather than rubygems.org. The code is outside the gem checksum and yank controls, so the lockfile's integrity model does not describe it.",
  "severity": "MEDIUM",
  "cwe": "CWE-829",
  "category": "dependency-hygiene",
  "ecosystems": [
    "rubygems"
  ],
  "artifact": "Gemfile",
  "parser": "lockfile-text",
  "check": {
    "type": "sca-field-matches",
    "path": "gems[].git",
    "valuePattern": "^https?://"
  },
  "tests": [
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "acme-sdk",
            "git": "https://github.com/acme/sdk.git",
            "ref": "9f2c4a1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "acme-cli",
            "git": "https://github.com/acme/cli.git",
            "branch": "main"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "requirement": "~> 7.1.3"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "puma",
            "requirement": "6.4.2"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2341"
  ],
  "remediation": "Build and publish the gem, or pin the git reference to a commit and record why.",
  "limitation": "It matches a gem sourced from a git remote rather than rubygems.org in the parsed Gemfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
