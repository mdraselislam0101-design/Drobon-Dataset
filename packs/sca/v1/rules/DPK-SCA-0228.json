{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0228",
  "title": "CocoaPods spec source declared over cleartext",
  "description": "Podfile declares a Podfile source URL that uses cleartext http. Pod specs and their checksums cross the network unencrypted, so a network attacker can redirect a pod.",
  "severity": "HIGH",
  "cwe": "CWE-319",
  "category": "registry-configuration",
  "ecosystems": [
    "cocoapods"
  ],
  "artifact": "Podfile",
  "parser": "lockfile-text",
  "check": {
    "type": "sca-field-matches",
    "path": "sources[]",
    "valuePattern": "^http://"
  },
  "tests": [
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "http://cdn.cocoapods.acme.example/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": "~> 5.9"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "http://10.24.8.9/specs/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": "~> 5.9"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": "~> 5.9"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://specs.acme.example/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": "~> 5.9"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2365"
  ],
  "remediation": "Use an https spec source.",
  "limitation": "It matches a Podfile source URL that uses cleartext http in the parsed Podfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
