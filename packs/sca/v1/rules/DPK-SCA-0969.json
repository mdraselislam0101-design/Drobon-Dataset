{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0969",
  "title": "Build tooling declared as a runtime crate",
  "description": "Cargo.toml declares a build-script crate in the runtime dependency table. A name or scope that resolves outside the project's intended registry is fetched from a source nobody reviewed, so a publish there becomes an install here. This rule reads a build-script crate in the runtime dependency table.",
  "severity": "LOW",
  "cwe": "CWE-829",
  "category": "dependency-confusion",
  "ecosystems": [
    "cargo"
  ],
  "artifact": "Cargo.toml",
  "parser": "toml",
  "check": {
    "type": "sca-key-matches",
    "path": "dependencies",
    "keyPattern": "^(?:cc|cmake|bindgen|pkg-config)$"
  },
  "tests": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          },
          "cc": {
            "version": "1.1.31"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          },
          "bindgen": {
            "version": "0.70.1"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "build-dependencies": {
          "cc": {
            "version": "1.1.31"
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "build-dependencies": {
          "bindgen": {
            "version": "0.70.1"
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3106"
  ],
  "remediation": "Point the declaration or the registry configuration at the namespace the project controls, and remove the lookup path that resolves elsewhere. Specifically: fix a build-script crate in the runtime dependency table.",
  "limitation": "It matches a build-script crate in the runtime dependency table in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
