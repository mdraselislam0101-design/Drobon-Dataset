{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0166",
  "title": "Maven build plugin without a pinned version",
  "description": "pom.xml declares a build plugin that declares no version. Maven resolves the plugin to its latest release, so code that runs during the build changes without any change to the pom.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "maven"
  ],
  "artifact": "pom.xml",
  "parser": "xml",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "project.build.plugins",
    "field": "version"
  },
  "tests": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "build": {
            "plugins": [
              {
                "groupId": "org.apache.maven.plugins",
                "artifactId": "maven-shade-plugin"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "build": {
            "plugins": [
              {
                "groupId": "org.codehaus.mojo",
                "artifactId": "exec-maven-plugin"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "build": {
            "plugins": [
              {
                "groupId": "org.apache.maven.plugins",
                "artifactId": "maven-shade-plugin",
                "version": "3.6.0"
              }
            ]
          }
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "build": {
            "plugins": [
              {
                "groupId": "org.codehaus.mojo",
                "artifactId": "exec-maven-plugin",
                "version": "3.4.1"
              }
            ]
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2303"
  ],
  "remediation": "Pin every build plugin to the version the project tested.",
  "limitation": "It matches a build plugin that declares no version in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
