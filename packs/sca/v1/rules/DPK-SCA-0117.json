{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0117",
  "title": "Python requirement installed from a git remote",
  "description": "requirements.txt declares a requirement installed straight from a git remote. The installed code is outside index publication controls, so no index signature, hash or advisory range covers it.",
  "severity": "MEDIUM",
  "cwe": "CWE-829",
  "category": "dependency-hygiene",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "requirements.txt",
  "parser": "requirements",
  "check": {
    "type": "sca-field-matches",
    "path": "requirements[].source",
    "valuePattern": "^git\\+"
  },
  "tests": [
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "acme-sdk",
            "specifier": "",
            "source": "git+https://github.com/acme/sdk.git@9f2c4a1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "acme-cli",
            "specifier": "",
            "source": "git+ssh://git@github.com/acme/cli.git@0a1b2c3"
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "acme-sdk",
            "specifier": "==4.2.0"
          }
        ]
      },
      "match": false
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "acme-cli",
            "specifier": ">=2.1,<3"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2254"
  ],
  "remediation": "Publish the package to the index and pin the released version with a hash.",
  "limitation": "It matches a requirement installed straight from a git remote in the parsed requirements.txt; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
