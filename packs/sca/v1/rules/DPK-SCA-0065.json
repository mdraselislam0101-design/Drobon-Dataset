{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0065",
  "title": "Lockfile drops a dependency's own requirements",
  "description": "package-lock.json declares a package entry that records no dependency requirements where the package declares some. The transitive surface disappears from the lockfile, so the tree that installs is larger than the tree the review read.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "supply-chain-integrity",
  "ecosystems": [
    "npm"
  ],
  "artifact": "package-lock.json",
  "parser": "json",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "packages",
    "field": "requires"
  },
  "tests": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "requires": {
              "left-pad": "^1.3.0"
            },
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "requires": {
              "ms": "^2.1.3"
            },
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2202"
  ],
  "remediation": "Regenerate the lockfile with a tool that records transitive requirements, and review the resulting graph.",
  "limitation": "It matches a package entry that records no dependency requirements where the package declares some in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
