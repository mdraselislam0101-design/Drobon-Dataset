{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0095",
  "title": "Yarn lockfile entry without a checksum",
  "description": "yarn.lock declares a Yarn Berry entry that records no archive checksum. The archive Yarn fetches is never verified against the lockfile, so a tampered or cached substitute installs silently.",
  "severity": "MEDIUM",
  "cwe": "CWE-494",
  "category": "supply-chain-integrity",
  "ecosystems": [
    "npm"
  ],
  "artifact": "yarn.lock",
  "parser": "lockfile-text",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "entries",
    "field": "checksum"
  },
  "tests": [
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "left-pad",
            "version": "1.3.0",
            "resolution": "left-pad@npm:1.3.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "ms",
            "version": "2.1.3",
            "resolution": "ms@npm:2.1.3",
            "dependencies": {}
          }
        ]
      },
      "match": true
    },
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "left-pad",
            "version": "1.3.0",
            "checksum": "8/abcdef"
          }
        ]
      },
      "match": false
    },
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "ms",
            "version": "2.1.3",
            "checksum": "10/0123456789"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2232"
  ],
  "remediation": "Regenerate the lockfile so each entry carries its checksum, and commit it.",
  "limitation": "It matches a Yarn Berry entry that records no archive checksum in the parsed yarn.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
