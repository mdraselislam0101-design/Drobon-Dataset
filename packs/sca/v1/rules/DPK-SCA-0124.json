{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0124",
  "title": "pyproject dependency with no version constraint",
  "description": "pyproject.toml declares a dependency string that names only the package. The build takes whatever the index serves, so a release published after review installs with no change to the file.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "pyproject.toml",
  "parser": "toml",
  "check": {
    "type": "sca-field-matches",
    "path": "project.dependencies[]",
    "valuePattern": "^[A-Za-z0-9._-]{1,80}$"
  },
  "tests": [
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "requests"
          ]
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "flask",
            "jinja2==3.1.4"
          ]
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "requests==2.32.3"
          ]
        }
      },
      "match": false
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "flask>=3.0,<4"
          ]
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2261"
  ],
  "remediation": "Add the version the project tested, or let the lockfile pin it and state that policy here.",
  "limitation": "It matches a dependency string that names only the package in the parsed pyproject.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
