{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0231",
  "title": "Podfile.lock spec without a checksum",
  "description": "Podfile.lock declares a locked pod that records no checksum. CocoaPods cannot verify the downloaded pod against the lockfile, so a substituted pod installs silently.",
  "severity": "MEDIUM",
  "cwe": "CWE-494",
  "category": "lockfile-integrity",
  "ecosystems": [
    "cocoapods"
  ],
  "artifact": "Podfile.lock",
  "parser": "lockfile-text",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "pods",
    "field": "checksum"
  },
  "tests": [
    {
      "file": "Podfile.lock",
      "document": {
        "pods": [
          {
            "name": "Alamofire",
            "version": "5.9.1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile.lock",
      "document": {
        "pods": [
          {
            "name": "SnapKit",
            "version": "5.7.1"
          },
          {
            "name": "Alamofire",
            "version": "5.9.1",
            "checksum": "aaaa"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile.lock",
      "document": {
        "pods": [
          {
            "name": "Alamofire",
            "version": "5.9.1",
            "checksum": "aaaabbbb"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Podfile.lock",
      "document": {
        "pods": [
          {
            "name": "SnapKit",
            "version": "5.7.1",
            "checksum": "ccccdddd"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2368"
  ],
  "remediation": "Regenerate the lockfile so every pod records its checksum.",
  "limitation": "It matches a locked pod that records no checksum in the parsed Podfile.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
