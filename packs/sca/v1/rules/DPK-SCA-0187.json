{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0187",
  "title": "NuGet package pinned with a wildcard",
  "description": "packages.config declares a `N.N.*` wildcard pin. The wildcard accepts every patch the feed publishes, so a package added after review installs without a manifest change.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "nuget"
  ],
  "artifact": "packages.config",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "packages[].version",
    "valuePattern": "^\\d{1,3}\\.\\d{1,3}\\.\\*$"
  },
  "tests": [
    {
      "file": "packages.config",
      "document": {
        "packages": [
          {
            "id": "Newtonsoft.Json",
            "version": "13.0.*"
          }
        ]
      },
      "match": true
    },
    {
      "file": "packages.config",
      "document": {
        "packages": [
          {
            "id": "Serilog",
            "version": "4.0.*"
          }
        ]
      },
      "match": true
    },
    {
      "file": "packages.config",
      "document": {
        "packages": [
          {
            "id": "Newtonsoft.Json",
            "version": "13.0.3"
          }
        ]
      },
      "match": false
    },
    {
      "file": "packages.config",
      "document": {
        "packages": [
          {
            "id": "Serilog",
            "version": "4.0.1"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2324"
  ],
  "remediation": "Pin the exact patch version.",
  "limitation": "It matches a `N.N.*` wildcard pin in the parsed packages.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
