{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0096",
  "title": "Yarn lockfile pins a SHA-1 integrity value",
  "description": "yarn.lock declares an integrity value that is a SHA-1 digest. SHA-1 collisions are practical, so the digest cannot prove that the installed archive is the one the lockfile recorded.",
  "severity": "MEDIUM",
  "cwe": "CWE-328",
  "category": "lockfile-integrity",
  "ecosystems": [
    "npm"
  ],
  "artifact": "yarn.lock",
  "parser": "lockfile-text",
  "check": {
    "type": "sca-field-matches",
    "path": "entries[].integrity",
    "valuePattern": "^sha1-"
  },
  "tests": [
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "left-pad",
            "version": "1.3.0",
            "integrity": "sha1-AAAABBBBCCCCDDDD"
          }
        ]
      },
      "match": true
    },
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "ms",
            "version": "2.1.3",
            "integrity": "sha1-EEEEFFFFGGGGHHHH"
          }
        ]
      },
      "match": true
    },
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "left-pad",
            "version": "1.3.0",
            "integrity": "sha512-AAAA"
          }
        ]
      },
      "match": false
    },
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "ms",
            "version": "2.1.3",
            "integrity": "sha512-BBBB"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2233"
  ],
  "remediation": "Re-resolve with a current Yarn so the entry records a SHA-2 value.",
  "limitation": "It matches an integrity value that is a SHA-1 digest in the parsed yarn.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
