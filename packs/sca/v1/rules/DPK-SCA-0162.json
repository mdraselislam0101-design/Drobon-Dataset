{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0162",
  "title": "Maven repository declared over cleartext",
  "description": "pom.xml declares a repository URL that uses cleartext http. Artifacts and their checksums cross the network unencrypted, so a network attacker can replace both the jar and the checksum file.",
  "severity": "HIGH",
  "cwe": "CWE-319",
  "category": "registry-configuration",
  "ecosystems": [
    "maven"
  ],
  "artifact": "pom.xml",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "project.repositories[].url",
    "valuePattern": "^http://"
  },
  "tests": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "repositories": [
            {
              "id": "acme",
              "url": "http://repo.acme.example/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "repositories": [
            {
              "id": "mirror",
              "url": "http://10.24.8.9/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "repositories": [
            {
              "id": "acme",
              "url": "https://repo.acme.example/maven2"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo.maven.apache.org/maven2"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2299"
  ],
  "remediation": "Point the repository at https.",
  "limitation": "It matches a repository URL that uses cleartext http in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
