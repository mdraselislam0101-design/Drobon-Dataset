{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0960",
  "title": "Build plugin skipped",
  "description": "pom.xml declares a plugin whose `skip` configuration is true. A verification or locking control is switched off, so the integrity guarantees the ecosystem offers are not applied here. This rule reads a plugin whose `skip` configuration is true.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "trust-bypass",
  "ecosystems": [
    "maven"
  ],
  "artifact": "pom.xml",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "project.build.plugins[].configuration.skip",
    "valuePattern": "^true$"
  },
  "tests": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ],
          "build": {
            "plugins": [
              {
                "groupId": "org.apache.maven.plugins",
                "artifactId": "maven-enforcer-plugin",
                "configuration": {
                  "skip": "true"
                }
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ],
          "build": {
            "plugins": [
              {
                "groupId": "org.apache.maven.plugins",
                "artifactId": "maven-dependency-plugin",
                "configuration": {
                  "skip": true
                }
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ],
          "build": {
            "plugins": [
              {
                "groupId": "org.apache.maven.plugins",
                "artifactId": "maven-enforcer-plugin",
                "configuration": {
                  "skip": "false"
                }
              }
            ]
          }
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ],
          "build": {
            "plugins": []
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3097"
  ],
  "remediation": "Turn the control back on and fix what it reported instead of disabling the check. Specifically: fix a plugin whose `skip` configuration is true.",
  "limitation": "It matches a plugin whose `skip` configuration is true in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
