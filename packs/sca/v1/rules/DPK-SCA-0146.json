{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0146",
  "title": "Python requirement pinned without a hash",
  "description": "requirements.txt declares a pinned requirement that carries no `--hash` value. Without a hash the installer cannot verify the artifact, so a compromised index or proxy can serve different bytes for the same version.",
  "severity": "MEDIUM",
  "cwe": "CWE-494",
  "category": "lockfile-integrity",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "requirements.txt",
  "parser": "requirements",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "requirements",
    "field": "hashes"
  },
  "tests": [
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "requests",
            "specifier": "==2.32.3"
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "flask",
            "specifier": "==3.0.3"
          },
          {
            "name": "jinja2",
            "specifier": "==3.1.4"
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "urllib3",
            "specifier": "==2.2.2"
          },
          {
            "name": "certifi",
            "specifier": "==2024.8.30"
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "requests",
            "specifier": "==2.32.3",
            "hashes": [
              "sha256:aaaa"
            ]
          },
          {
            "name": "flask",
            "specifier": "==3.0.3",
            "hashes": [
              "sha256:bbbb"
            ]
          }
        ]
      },
      "match": false
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "jinja2",
            "specifier": "==3.1.4",
            "hashes": [
              "sha256:cccc"
            ]
          },
          {
            "name": "click",
            "specifier": "==8.1.7",
            "hashes": [
              "sha256:dddd"
            ]
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2283"
  ],
  "remediation": "Run installs in hash-checking mode and record the hashes in the requirements file.",
  "limitation": "It matches a pinned requirement that carries no `--hash` value in the parsed requirements.txt; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
