{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0179",
  "title": "Gradle verification entry with an empty signature field",
  "description": "verification-metadata.xml declares an artifact entry whose signature value is empty. The entry reads as signature-verified to any tool that only checks the key, while no signature is actually checked.",
  "severity": "MEDIUM",
  "cwe": "CWE-347",
  "category": "lockfile-integrity",
  "ecosystems": [
    "gradle"
  ],
  "artifact": "verification-metadata.xml",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "components[].artifacts[].pgp",
    "valuePattern": "^$"
  },
  "tests": [
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "com.acme",
            "name": "internal-core",
            "version": "1.4.2",
            "artifacts": [
              {
                "name": "internal-core-1.4.2.jar",
                "pgp": ""
              }
            ]
          }
        ]
      },
      "match": true
    },
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "org.example",
            "name": "lib",
            "version": "2.0.1",
            "artifacts": [
              {
                "name": "lib-2.0.1.jar",
                "pgp": ""
              }
            ]
          }
        ]
      },
      "match": true
    },
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "com.acme",
            "name": "internal-core",
            "version": "1.4.2",
            "artifacts": [
              {
                "name": "internal-core-1.4.2.jar",
                "pgp": "9F2C4A1B"
              }
            ]
          }
        ]
      },
      "match": false
    },
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "org.example",
            "name": "lib",
            "version": "2.0.1",
            "artifacts": [
              {
                "name": "lib-2.0.1.jar",
                "pgp": "0A1B2C3D"
              }
            ]
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2316"
  ],
  "remediation": "Record the real signature, or rely on checksums and remove the empty key.",
  "limitation": "It matches an artifact entry whose signature value is empty in the parsed verification-metadata.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
