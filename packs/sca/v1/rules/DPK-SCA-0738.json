{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0738",
  "title": "Pub dependency pinned to a moving git reference",
  "description": "pubspec.yaml declares a git dependency whose ref is a branch name. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a git dependency whose ref is a branch name.",
  "severity": "MEDIUM",
  "cwe": "CWE-494",
  "category": "supply-chain-integrity",
  "ecosystems": [
    "pub"
  ],
  "artifact": "pubspec.yaml",
  "parser": "yaml",
  "check": {
    "type": "sca-field-matches",
    "path": "dependencies.*.git.ref",
    "valuePattern": "^(?:main|master|develop|HEAD)$"
  },
  "tests": [
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0",
          "acme_sdk": {
            "git": {
              "url": "https://github.com/acme/sdk",
              "ref": "main"
            }
          }
        },
        "dependency_overrides": {}
      },
      "match": true
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0",
          "acme_core": {
            "git": {
              "url": "https://github.com/acme/core",
              "ref": "develop"
            }
          }
        },
        "dependency_overrides": {}
      },
      "match": true
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0",
          "acme_sdk": {
            "git": {
              "url": "https://github.com/acme/sdk",
              "ref": "9f2c3d4e5f60"
            }
          }
        },
        "dependency_overrides": {}
      },
      "match": false
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2875"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a git dependency whose ref is a branch name.",
  "limitation": "It matches a git dependency whose ref is a branch name in the parsed pubspec.yaml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
