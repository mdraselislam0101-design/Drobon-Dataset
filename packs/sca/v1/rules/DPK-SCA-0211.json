{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0211",
  "title": "NuGet lockfile entry without a content hash",
  "description": "packages.lock.json declares a locked package that records no `contentHash`. Restore cannot verify the package it downloads against the lockfile, so a feed substitution installs silently.",
  "severity": "MEDIUM",
  "cwe": "CWE-494",
  "category": "lockfile-integrity",
  "ecosystems": [
    "nuget"
  ],
  "artifact": "packages.lock.json",
  "parser": "json",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "dependencies.*",
    "field": "contentHash"
  },
  "tests": [
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Serilog": {
              "type": "Transitive",
              "resolved": "4.0.1"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3",
              "contentHash": "aaaa"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Serilog": {
              "type": "Transitive",
              "resolved": "4.0.1",
              "contentHash": "bbbb"
            }
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2348"
  ],
  "remediation": "Regenerate the lockfile with `RestorePackagesWithLockFile` enabled so hashes are recorded.",
  "limitation": "It matches a locked package that records no `contentHash` in the parsed packages.lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
