{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0051",
  "title": "Lockfile resolved a prerelease build",
  "description": "package-lock.json declares a resolved version that is a prerelease build. Prerelease builds sit outside most advisory ranges and outside the stability promises the project tested against.",
  "severity": "MEDIUM",
  "cwe": "CWE-494",
  "category": "supply-chain-integrity",
  "ecosystems": [
    "npm"
  ],
  "artifact": "package-lock.json",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "packages.*.version",
    "valuePattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}-(?:alpha|beta|rc|next|canary|dev)"
  },
  "tests": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0-rc.1",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.4.0-beta.7",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.4.0",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2188"
  ],
  "remediation": "Pin the first stable release once it exists, and record the review that approved the prerelease.",
  "limitation": "It matches a resolved version that is a prerelease build in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
