{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-1029",
  "title": "Central package version declared as a wildcard",
  "description": "Directory.Packages.props declares a `<PackageVersion>` value of `*`. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a `<PackageVersion>` value of `*`.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "nuget"
  ],
  "artifact": "Directory.Packages.props",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "project.itemGroup.PackageVersion[].Version",
    "valuePattern": "^\\*$"
  },
  "tests": [
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "*"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Dapper",
                "Version": "*"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          }
        }
      },
      "match": false
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Dapper",
                "Version": "2.1.35"
              }
            ]
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3166"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a `<PackageVersion>` value of `*`.",
  "limitation": "It matches a `<PackageVersion>` value of `*` in the parsed Directory.Packages.props; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
