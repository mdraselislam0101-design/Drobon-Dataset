{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0028",
  "title": "Dependency pinned with build metadata",
  "description": "package.json declares a version carrying `+build` metadata. Build metadata is ignored by precedence but not by every resolver, so two tools can disagree about which artifact the pin names.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "npm"
  ],
  "artifact": "package.json",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "dependencies.*",
    "valuePattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}\\+"
  },
  "tests": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0+build.20250104"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "2.1.0+sha.9f2c4a1"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "^4.2.0"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2165"
  ],
  "remediation": "Pin the plain semantic version and record the build identity elsewhere.",
  "limitation": "It matches a version carrying `+build` metadata in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
