{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0683",
  "title": "Transitive versions escape central management",
  "description": "Directory.Packages.props declares a central-package-management build that does not pin transitive versions. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a central-package-management build that does not pin transitive versions.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "nuget"
  ],
  "artifact": "Directory.Packages.props",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "project.propertyGroup.CentralPackageTransitivePinningEnabled",
    "valuePattern": "^false$"
  },
  "tests": [
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          },
          "propertyGroup": {
            "CentralPackageTransitivePinningEnabled": "false"
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          },
          "propertyGroup": {
            "CentralPackageTransitivePinningEnabled": false
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          },
          "propertyGroup": {
            "CentralPackageTransitivePinningEnabled": "true"
          }
        }
      },
      "match": false
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          },
          "propertyGroup": {
            "CentralPackageTransitivePinningEnabled": true
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2820"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a central-package-management build that does not pin transitive versions.",
  "limitation": "It matches a central-package-management build that does not pin transitive versions in the parsed Directory.Packages.props; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
