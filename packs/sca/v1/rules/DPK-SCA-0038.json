{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0038",
  "title": "Dependency fetched from a source archive URL",
  "description": "package.json declares a dependency pointing at a forge source archive instead of a package. The archive is generated on demand from a branch or tag, so the bytes are not the published artifact and carry no registry integrity value.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "npm"
  ],
  "artifact": "package.json",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "dependencies.*",
    "valuePattern": "^https://(?:codeload\\.github\\.com|github\\.com/[^/ ]+/[^/ ]+/archive)/"
  },
  "tests": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "https://codeload.github.com/acme/sdk/tar.gz/refs/tags/v4.2.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "https://github.com/acme/cli/archive/refs/heads/main.tar.gz"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "https://downloads.acme.example/sdk-4.2.0.tgz"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2175"
  ],
  "remediation": "Publish a package and depend on its version.",
  "limitation": "It matches a dependency pointing at a forge source archive instead of a package in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
