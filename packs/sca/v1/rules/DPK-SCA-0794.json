{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0794",
  "title": "Lockfile generation switched off",
  "description": ".npmrc declares a `package-lock=false` setting. A verification or locking control is switched off, so the integrity guarantees the ecosystem offers are not applied here. This rule reads a `package-lock=false` setting.",
  "severity": "MEDIUM",
  "cwe": "CWE-494",
  "category": "lockfile-integrity",
  "ecosystems": [
    "npm"
  ],
  "artifact": ".npmrc",
  "parser": "ini",
  "check": {
    "type": "sca-field-matches",
    "path": "package-lock",
    "valuePattern": "^false$"
  },
  "tests": [
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true",
        "package-lock": "false"
      },
      "match": true
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true",
        "package-lock": false
      },
      "match": true
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true",
        "package-lock": "true"
      },
      "match": false
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true",
        "package-lock": true
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2931"
  ],
  "remediation": "Turn the control back on and fix what it reported instead of disabling the check. Specifically: fix a `package-lock=false` setting.",
  "limitation": "It matches a `package-lock=false` setting in the parsed .npmrc; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
