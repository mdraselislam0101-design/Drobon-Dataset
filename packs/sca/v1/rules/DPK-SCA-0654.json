{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0654",
  "title": "Pre-release versions are accepted by the resolver",
  "description": "Pipfile declares a Pipfile that allows pre-releases. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a Pipfile that allows pre-releases.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "Pipfile",
  "parser": "toml",
  "check": {
    "type": "sca-field-matches",
    "path": "pipenv.allow_prereleases",
    "valuePattern": "^true$"
  },
  "tests": [
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": true
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": "true"
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": false
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": "false"
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2791"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a Pipfile that allows pre-releases.",
  "limitation": "It matches a Pipfile that allows pre-releases in the parsed Pipfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
