{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0695",
  "title": "Dependency content changes whenever the branch moves",
  "description": "Cargo.toml declares a git dependency pinned to a branch name. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a git dependency pinned to a branch name.",
  "severity": "MEDIUM",
  "cwe": "CWE-494",
  "category": "supply-chain-integrity",
  "ecosystems": [
    "cargo"
  ],
  "artifact": "Cargo.toml",
  "parser": "toml",
  "check": {
    "type": "sca-field-matches",
    "path": "dependencies.*.branch",
    "valuePattern": "^.+$"
  },
  "tests": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          },
          "acme-core": {
            "git": "https://github.com/acme/core",
            "branch": "main"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          },
          "acme-sdk": {
            "git": "https://github.com/acme/sdk",
            "branch": "develop"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          },
          "acme-core": {
            "git": "https://github.com/acme/core",
            "rev": "9f2c3d4e5f60"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2832"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a git dependency pinned to a branch name.",
  "limitation": "It matches a git dependency pinned to a branch name in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
