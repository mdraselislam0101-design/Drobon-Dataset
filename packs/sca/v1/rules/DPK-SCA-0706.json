{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0706",
  "title": "Locked gems carry no recorded digest",
  "description": "Gemfile.lock declares a Gemfile.lock with no `CHECKSUMS` block. Without a recorded digest the downloaded artifact cannot be checked against what was reviewed, so substitution is undetectable at install time. This rule reads a Gemfile.lock with no `CHECKSUMS` block.",
  "severity": "MEDIUM",
  "cwe": "CWE-494",
  "category": "lockfile-integrity",
  "ecosystems": [
    "rubygems"
  ],
  "artifact": "Gemfile.lock",
  "parser": "yaml",
  "check": {
    "type": "sca-field-absent",
    "path": "checksums"
  },
  "tests": [
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "ruby_version": "ruby 3.3.4p94",
        "bundled_with": "BUNDLED WITH 2.5.11"
      },
      "match": true
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "ruby_version": "ruby 3.3.4p94",
        "bundled_with": "BUNDLED WITH 2.5.11"
      },
      "match": true
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "checksums": {
          "rails": "sha256=9f2c3d4e"
        },
        "ruby_version": "ruby 3.3.4p94",
        "bundled_with": "BUNDLED WITH 2.5.11"
      },
      "match": false
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "checksums": {
          "rails": "sha256=9f2c3d4e",
          "puma": "sha256=a1b2c3d4"
        },
        "ruby_version": "ruby 3.3.4p94",
        "bundled_with": "BUNDLED WITH 2.5.11"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2843"
  ],
  "remediation": "Regenerate the artifact with integrity data enabled and commit the recorded digest or checksum. Specifically: fix a Gemfile.lock with no `CHECKSUMS` block.",
  "limitation": "It matches a Gemfile.lock with no `CHECKSUMS` block in the parsed Gemfile.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
