{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0066",
  "title": "Lockfile entry records no supported Node version",
  "description": "package-lock.json declares a package entry that declares no supported Node runtime. Nothing tells the build whether the package was tested on the runtime that executes it, so a mismatch fails at run time rather than at review.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "supply-chain-integrity",
  "ecosystems": [
    "npm"
  ],
  "artifact": "package-lock.json",
  "parser": "json",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "packages",
    "field": "engines"
  },
  "tests": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "engines": {
              "node": ">=18"
            },
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "engines": {
              "node": ">=20.11"
            },
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2203"
  ],
  "remediation": "Regenerate the lockfile so the engine constraint is recorded, and align it with the runtime the project ships.",
  "limitation": "It matches a package entry that declares no supported Node runtime in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
