{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0242",
  "title": "vcpkg registry without a baseline",
  "description": "vcpkg-configuration.json declares a registry entry that records no baseline commit. Port versions come from the registry's current head, so a port can change without any change to the project.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "registry-configuration",
  "ecosystems": [
    "vcpkg"
  ],
  "artifact": "vcpkg-configuration.json",
  "parser": "json",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "registries",
    "field": "baseline"
  },
  "tests": [
    {
      "file": "vcpkg-configuration.json",
      "document": {
        "registries": [
          {
            "kind": "git",
            "repository": "https://git.acme.example/vcpkg-registry"
          }
        ]
      },
      "match": true
    },
    {
      "file": "vcpkg-configuration.json",
      "document": {
        "registries": [
          {
            "kind": "git",
            "repository": "https://git.acme.example/ports"
          }
        ]
      },
      "match": true
    },
    {
      "file": "vcpkg-configuration.json",
      "document": {
        "registries": [
          {
            "kind": "git",
            "repository": "https://git.acme.example/vcpkg-registry",
            "baseline": "9f2c4a1"
          }
        ]
      },
      "match": false
    },
    {
      "file": "vcpkg-configuration.json",
      "document": {
        "registries": [
          {
            "kind": "git",
            "repository": "https://git.acme.example/ports",
            "baseline": "0a1b2c3"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2379"
  ],
  "remediation": "Pin the baseline for every registry.",
  "limitation": "It matches a registry entry that records no baseline commit in the parsed vcpkg-configuration.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
