{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0663",
  "title": "Requirement resolves to an untagged commit",
  "description": "go.mod declares a requirement pinned to a pseudo-version. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a requirement pinned to a pseudo-version.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "go"
  ],
  "artifact": "go.mod",
  "parser": "lockfile-text",
  "check": {
    "type": "sca-field-matches",
    "path": "require[].version",
    "valuePattern": "^v0\\.0\\.0-"
  },
  "tests": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v0.0.0-20240101120000-9f2c3d4e5f60"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/core",
            "version": "v0.0.0-20240304050000-a1b2c3d4e5f6"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2800"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a requirement pinned to a pseudo-version.",
  "limitation": "It matches a requirement pinned to a pseudo-version in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
