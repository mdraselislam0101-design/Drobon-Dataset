{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0776",
  "title": "renv package restored from a non-repository source",
  "description": "renv.lock declares a package whose `Source` is a code host rather than a repository. A dependency resolved from a local path or a mutable branch is not the published artifact the rest of the project audits. This rule reads a package whose `Source` is a code host rather than a repository.",
  "severity": "MEDIUM",
  "cwe": "CWE-829",
  "category": "supply-chain-integrity",
  "ecosystems": [
    "cran"
  ],
  "artifact": "renv.lock",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "Packages.*.Source",
    "valuePattern": "^(?:GitHub|GitLab|Bitbucket|URL)$"
  },
  "tests": [
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1",
          "Repositories": [
            {
              "Name": "CRAN",
              "URL": "https://cloud.r-project.org"
            }
          ]
        },
        "Packages": {
          "dplyr": {
            "Package": "dplyr",
            "Version": "1.1.4",
            "Source": "GitHub"
          }
        }
      },
      "match": true
    },
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1",
          "Repositories": [
            {
              "Name": "CRAN",
              "URL": "https://cloud.r-project.org"
            }
          ]
        },
        "Packages": {
          "dplyr": {
            "Package": "dplyr",
            "Version": "1.1.4",
            "Source": "Repository"
          },
          "tidyr": {
            "Package": "tidyr",
            "Version": "1.3.1",
            "Source": "URL"
          }
        }
      },
      "match": true
    },
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1",
          "Repositories": [
            {
              "Name": "CRAN",
              "URL": "https://cloud.r-project.org"
            }
          ]
        },
        "Packages": {
          "dplyr": {
            "Package": "dplyr",
            "Version": "1.1.4",
            "Source": "Repository"
          }
        }
      },
      "match": false
    },
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1",
          "Repositories": [
            {
              "Name": "CRAN",
              "URL": "https://cloud.r-project.org"
            }
          ]
        },
        "Packages": {
          "dplyr": {
            "Package": "dplyr",
            "Version": "1.1.4",
            "Source": "Repository"
          },
          "tidyr": {
            "Package": "tidyr",
            "Version": "1.3.1",
            "Source": "Repository"
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2913"
  ],
  "remediation": "Depend on a published, versioned artifact, and keep local paths or branch references out of the committed manifest. Specifically: fix a package whose `Source` is a code host rather than a repository.",
  "limitation": "It matches a package whose `Source` is a code host rather than a repository in the parsed renv.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
