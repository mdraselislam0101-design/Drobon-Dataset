{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0702",
  "title": "Dependency resolved from a local directory",
  "description": "composer.json declares a repository of type `path`. A dependency resolved from a local path or a mutable branch is not the published artifact the rest of the project audits. This rule reads a repository of type `path`.",
  "severity": "HIGH",
  "cwe": "CWE-1104",
  "category": "local-source",
  "ecosystems": [
    "composer"
  ],
  "artifact": "composer.json",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "repositories[].type",
    "valuePattern": "^path$"
  },
  "tests": [
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "path",
            "url": "../acme-core"
          }
        ]
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "path",
            "url": "/opt/vendor/acme-core"
          }
        ]
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "composer",
            "url": "https://packagist.acme.example"
          }
        ]
      },
      "match": false
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": []
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2839"
  ],
  "remediation": "Depend on a published, versioned artifact, and keep local paths or branch references out of the committed manifest. Specifically: fix a repository of type `path`.",
  "limitation": "It matches a repository of type `path` in the parsed composer.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
