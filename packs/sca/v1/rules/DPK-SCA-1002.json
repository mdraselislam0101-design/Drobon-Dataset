{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-1002",
  "title": "Repository backed by a filesystem path",
  "description": "build.gradle declares a repository URL of the `file:` scheme. A dependency resolved from a local path or a mutable branch is not the published artifact the rest of the project audits. This rule reads a repository URL of the `file:` scheme.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "local-source",
  "ecosystems": [
    "gradle"
  ],
  "artifact": "build.gradle",
  "parser": "gradle",
  "check": {
    "type": "sca-field-matches",
    "path": "repositories[].url",
    "valuePattern": "^file:"
  },
  "tests": [
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "libs",
            "url": "file:../libs"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "vendor",
            "url": "file:/opt/vendor/m2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "google"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3139"
  ],
  "remediation": "Depend on a published, versioned artifact, and keep local paths or branch references out of the committed manifest. Specifically: fix a repository URL of the `file:` scheme.",
  "limitation": "It matches a repository URL of the `file:` scheme in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
