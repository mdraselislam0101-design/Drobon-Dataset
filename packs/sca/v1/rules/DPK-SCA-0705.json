{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0705",
  "title": "Test tooling is installed into the production dependency tree",
  "description": "composer.json declares a test-only package declared in `require`. A name or scope that resolves outside the project's intended registry is fetched from a source nobody reviewed, so a publish there becomes an install here. This rule reads a test-only package declared in `require`.",
  "severity": "LOW",
  "cwe": "CWE-829",
  "category": "dependency-confusion",
  "ecosystems": [
    "composer"
  ],
  "artifact": "composer.json",
  "parser": "json",
  "check": {
    "type": "sca-key-matches",
    "path": "require",
    "keyPattern": "^(?:phpunit/phpunit|mockery/mockery|phpstan/phpstan)$"
  },
  "tests": [
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7",
          "phpunit/phpunit": "^11.3"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7",
          "mockery/mockery": "^1.6"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "require-dev": {
          "phpunit/phpunit": "^11.3"
        }
      },
      "match": false
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "require-dev": {
          "phpstan/phpstan": "^1.12"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2842"
  ],
  "remediation": "Point the declaration or the registry configuration at the namespace the project controls, and remove the lookup path that resolves elsewhere. Specifically: fix a test-only package declared in `require`.",
  "limitation": "It matches a test-only package declared in `require` in the parsed composer.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
