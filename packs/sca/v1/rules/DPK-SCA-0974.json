{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0974",
  "title": "Gemfile.lock with no PLATFORMS section",
  "description": "Gemfile.lock declares a lockfile that records no target platforms. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a lockfile that records no target platforms.",
  "severity": "LOW",
  "cwe": "CWE-1104",
  "category": "policy-metadata",
  "ecosystems": [
    "rubygems"
  ],
  "artifact": "Gemfile.lock",
  "parser": "yaml",
  "check": {
    "type": "sca-field-absent",
    "path": "platforms"
  },
  "tests": [
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "checksums": {
          "rails": "sha256=9f2c3d4e"
        },
        "ruby_version": "ruby 3.3.4p94",
        "bundled_with": "BUNDLED WITH 2.5.11"
      },
      "match": true
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [],
        "checksums": {
          "rails": "sha256=9f2c3d4e"
        },
        "ruby_version": "ruby 3.3.4p94",
        "bundled_with": "BUNDLED WITH 2.5.11"
      },
      "match": true
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "checksums": {
          "rails": "sha256=9f2c3d4e"
        },
        "ruby_version": "ruby 3.3.4p94",
        "bundled_with": "BUNDLED WITH 2.5.11",
        "platforms": [
          "ruby",
          "x86_64-linux"
        ]
      },
      "match": false
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "checksums": {
          "rails": "sha256=9f2c3d4e"
        },
        "ruby_version": "ruby 3.3.4p94",
        "bundled_with": "BUNDLED WITH 2.5.11",
        "platforms": [
          "arm64-darwin-23"
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3111"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a lockfile that records no target platforms.",
  "limitation": "It matches a lockfile that records no target platforms in the parsed Gemfile.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
