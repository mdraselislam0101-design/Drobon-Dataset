{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0206",
  "title": "Gemfile resolves a gem from a local path",
  "description": "Gemfile declares a gem that installs from a directory on the build machine. The build compiles whatever that directory holds, so the artifact is not reproducible from the Gemfile.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "rubygems"
  ],
  "artifact": "Gemfile",
  "parser": "lockfile-text",
  "check": {
    "type": "sca-field-matches",
    "path": "gems[].path",
    "valuePattern": "^(?:\\.{1,2}/|/)"
  },
  "tests": [
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "acme-shared",
            "path": "../acme-shared"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "acme-assets",
            "path": "/opt/vendor/acme-assets"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "requirement": "~> 7.1.3"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "puma",
            "requirement": "6.4.2"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2343"
  ],
  "remediation": "Build and publish the gem, and depend on a version for releases.",
  "limitation": "It matches a gem that installs from a directory on the build machine in the parsed Gemfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
