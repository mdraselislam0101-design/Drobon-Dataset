{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0135",
  "title": "poetry.lock in the legacy format",
  "description": "poetry.lock declares a lockfile whose `lock-version` is 1.x. The old format records less provenance per package and is regenerated differently, so the graph the review reads can differ from the one that installs.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "lockfile-integrity",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "poetry.lock",
  "parser": "toml",
  "check": {
    "type": "sca-field-matches",
    "path": "metadata.lock-version",
    "valuePattern": "^1\\."
  },
  "tests": [
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "version": "2.32.3",
            "files": [
              {
                "file": "requests-2.32.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "1.1"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "flask",
            "version": "3.0.3",
            "files": [
              {
                "file": "flask-3.0.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "1.0"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "version": "2.32.3",
            "files": [
              {
                "file": "requests-2.32.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": false
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "flask",
            "version": "3.0.3",
            "files": [
              {
                "file": "flask-3.0.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2272"
  ],
  "remediation": "Re-lock with a current Poetry release.",
  "limitation": "It matches a lockfile whose `lock-version` is 1.x in the parsed poetry.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
