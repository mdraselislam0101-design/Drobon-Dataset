{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0751",
  "title": "Version forced by a resolution strategy",
  "description": "build.gradle declares a forced version that overrides every declared constraint. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a forced version that overrides every declared constraint.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "gradle"
  ],
  "artifact": "build.gradle",
  "parser": "gradle",
  "check": {
    "type": "sca-field-matches",
    "path": "configurations[].resolutionStrategy.force[].version",
    "valuePattern": "^.+$"
  },
  "tests": [
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [
          {
            "name": "runtimeClasspath",
            "resolutionStrategy": {
              "force": [
                {
                  "group": "com.acme",
                  "name": "sdk",
                  "version": "4.2.0"
                }
              ]
            }
          }
        ],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [
          {
            "name": "compileClasspath",
            "resolutionStrategy": {
              "force": [
                {
                  "group": "org.slf4j",
                  "name": "slf4j-api",
                  "version": "1.7.36"
                }
              ]
            }
          }
        ],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [
          {
            "name": "runtimeClasspath",
            "resolutionStrategy": {
              "force": []
            }
          }
        ],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2888"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a forced version that overrides every declared constraint.",
  "limitation": "It matches a forced version that overrides every declared constraint in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
