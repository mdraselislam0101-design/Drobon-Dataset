{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-1006",
  "title": "Default push source over cleartext",
  "description": "nuget.config declares a `defaultPushSource` over cleartext. An artifact fetched over plain HTTP can be replaced in transit, so the bytes that install are not bound to what the author published. This rule reads a `defaultPushSource` over cleartext.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "registry-configuration",
  "ecosystems": [
    "nuget"
  ],
  "artifact": "nuget.config",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "config.defaultPushSource",
    "valuePattern": "^http://"
  },
  "tests": [
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {
          "defaultPushSource": "http://nuget.acme.example/v3/index.json"
        },
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {
          "defaultPushSource": "http://10.24.8.9/v3/index.json"
        },
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {
          "defaultPushSource": "https://nuget.acme.example/v3/index.json"
        },
        "settings": {}
      },
      "match": false
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3143"
  ],
  "remediation": "Use the HTTPS endpoint the registry publishes and keep the hostname in the configuration reviewable. Specifically: fix a `defaultPushSource` over cleartext.",
  "limitation": "It matches a `defaultPushSource` over cleartext in the parsed nuget.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
