{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0692",
  "title": "Workspace-wide dependency version is left open",
  "description": "Cargo.toml declares a workspace dependency that declares no version. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a workspace dependency that declares no version.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "cargo"
  ],
  "artifact": "Cargo.toml",
  "parser": "toml",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "workspace.dependencies",
    "field": "version"
  },
  "tests": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": {}
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": {},
            "tokio": {
              "version": "1.40.0"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": {
              "version": "1.0.210"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210",
            "tokio": {
              "version": "1.40.0"
            }
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2829"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a workspace dependency that declares no version.",
  "limitation": "It matches a workspace dependency that declares no version in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
