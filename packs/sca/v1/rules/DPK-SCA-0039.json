{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0039",
  "title": "Dependency declared with a multi-segment wildcard",
  "description": "package.json declares a multi-segment wildcard that accepts every version of every major. The declaration is unbounded in every segment, so the install follows whatever the registry publishes next, including a compromised release.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "npm"
  ],
  "artifact": "package.json",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "dependencies.*",
    "valuePattern": "^\\*\\.\\*$|^\\*\\.\\*\\.\\*$"
  },
  "tests": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "*.*"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "*.*.*"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "*"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "1.*"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2176"
  ],
  "remediation": "Pin the tested version.",
  "limitation": "It matches a multi-segment wildcard that accepts every version of every major in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
