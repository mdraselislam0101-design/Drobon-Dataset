{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-1020",
  "title": "Composer requirement allowed to float within a line",
  "description": "composer.json declares a `~` requirement. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a `~` requirement.",
  "severity": "LOW",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "composer"
  ],
  "artifact": "composer.json",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "require.*",
    "valuePattern": "^~"
  },
  "tests": [
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "~3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7",
          "guzzlehttp/guzzle": "~7.9"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "3.7.1"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": false
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7",
          "guzzlehttp/guzzle": "^7.9"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3157"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a `~` requirement.",
  "limitation": "It matches a `~` requirement in the parsed composer.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
