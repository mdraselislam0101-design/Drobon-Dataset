{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-1016",
  "title": "Exclusion written as a wildcard",
  "description": "pom.xml declares an exclusion whose groupId is `*`. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads an exclusion whose groupId is `*`.",
  "severity": "LOW",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "maven"
  ],
  "artifact": "pom.xml",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "project.dependencies[].exclusions[].groupId",
    "valuePattern": "^\\*$"
  },
  "tests": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "properties": {
            "maven.compiler.release": "21",
            "project.build.sourceEncoding": "UTF-8"
          },
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "sdk",
              "version": "4.2.0",
              "exclusions": [
                {
                  "groupId": "*",
                  "artifactId": "*"
                }
              ]
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "properties": {
            "maven.compiler.release": "21",
            "project.build.sourceEncoding": "UTF-8"
          },
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.apache.httpcomponents",
              "artifactId": "httpclient",
              "version": "4.5.14",
              "exclusions": [
                {
                  "groupId": "*",
                  "artifactId": "commons-logging"
                }
              ]
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "properties": {
            "maven.compiler.release": "21",
            "project.build.sourceEncoding": "UTF-8"
          },
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "sdk",
              "version": "4.2.0",
              "exclusions": [
                {
                  "groupId": "commons-logging",
                  "artifactId": "commons-logging"
                }
              ]
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "properties": {
            "maven.compiler.release": "21",
            "project.build.sourceEncoding": "UTF-8"
          },
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api",
              "version": "2.0.13"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3153"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix an exclusion whose groupId is `*`.",
  "limitation": "It matches an exclusion whose groupId is `*` in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
