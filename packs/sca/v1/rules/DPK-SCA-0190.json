{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0190",
  "title": "Cargo dependency installed from a git remote",
  "description": "Cargo.toml declares a dependency sourced from a git remote rather than crates.io. The code is outside the registry's checksum and yank controls, so the lockfile hash model does not cover it.",
  "severity": "MEDIUM",
  "cwe": "CWE-829",
  "category": "dependency-hygiene",
  "ecosystems": [
    "cargo"
  ],
  "artifact": "Cargo.toml",
  "parser": "toml",
  "check": {
    "type": "sca-field-matches",
    "path": "dependencies.*.git",
    "valuePattern": "^https?://"
  },
  "tests": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_sdk": {
            "git": "https://github.com/acme/sdk",
            "tag": "v4.2.0"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_cli": {
            "git": "https://github.com/acme/cli"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_sdk": {
            "version": "4.2.0"
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_cli": {
            "version": "2.1.0"
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2327"
  ],
  "remediation": "Publish the crate and depend on the version.",
  "limitation": "It matches a dependency sourced from a git remote rather than crates.io in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
