{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0052",
  "title": "Lockfile records git or path dependencies as version 0.0.0",
  "description": "package-lock.json declares a package entry whose version is the git/path placeholder `0.0.0`. The placeholder hides the real identity of the code, so version-based review and advisory matching cannot see what actually runs.",
  "severity": "MEDIUM",
  "cwe": "CWE-494",
  "category": "supply-chain-integrity",
  "ecosystems": [
    "npm"
  ],
  "artifact": "package-lock.json",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "packages.*.version",
    "valuePattern": "^0\\.0\\.0$"
  },
  "tests": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "0.0.0",
            "resolved": "git+https://github.com/acme/sdk.git#9f2c4a1"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "0.0.0",
            "resolved": "file:../acme-lib"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "0.0.1",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2189"
  ],
  "remediation": "Replace the git or path dependency with a published, versioned package.",
  "limitation": "It matches a package entry whose version is the git/path placeholder `0.0.0` in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
