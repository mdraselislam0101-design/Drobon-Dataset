{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0159",
  "title": "Maven dependency declared with a version range",
  "description": "pom.xml declares a dependency version written as a range. A range resolves to whatever matching release exists on the day of the build, so two builds of the same pom can compile different code.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "maven"
  ],
  "artifact": "pom.xml",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "project.dependencies[].version",
    "valuePattern": "^\\["
  },
  "tests": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "org.apache.commons",
              "artifactId": "commons-lang3",
              "version": "[3.0,4.0)"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.google.guava",
              "artifactId": "guava",
              "version": "[30.0,)"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "org.apache.commons",
              "artifactId": "commons-lang3",
              "version": "3.15.0"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.google.guava",
              "artifactId": "guava",
              "version": "33.2.1-jre"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2296"
  ],
  "remediation": "Pin the exact version and let a deliberate change move it.",
  "limitation": "It matches a dependency version written as a range in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
