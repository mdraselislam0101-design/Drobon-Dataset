{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0997",
  "title": "Pipfile source with TLS verification off",
  "description": "Pipfile declares a `verify_ssl = false` source. A verification or locking control is switched off, so the integrity guarantees the ecosystem offers are not applied here. This rule reads a `verify_ssl = false` source.",
  "severity": "HIGH",
  "cwe": "CWE-295",
  "category": "trust-bypass",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "Pipfile",
  "parser": "toml",
  "check": {
    "type": "sca-field-matches",
    "path": "sources[].verify_ssl",
    "valuePattern": "^false$"
  },
  "tests": [
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        },
        "sources": [
          {
            "name": "pypi",
            "url": "https://pypi.acme.example/simple",
            "verify_ssl": false
          }
        ]
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        },
        "sources": [
          {
            "name": "internal",
            "url": "https://10.24.8.9/simple",
            "verify_ssl": "false"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        },
        "sources": [
          {
            "name": "pypi",
            "url": "https://pypi.org/simple",
            "verify_ssl": true
          }
        ]
      },
      "match": false
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        },
        "sources": [
          {
            "name": "acme",
            "url": "https://pypi.acme.example/simple",
            "verify_ssl": true
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3134"
  ],
  "remediation": "Turn the control back on and fix what it reported instead of disabling the check. Specifically: fix a `verify_ssl = false` source.",
  "limitation": "It matches a `verify_ssl = false` source in the parsed Pipfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
