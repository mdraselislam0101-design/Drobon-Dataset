{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0646",
  "title": "Install hook runs before any review step",
  "description": "package.json declares a package.json that runs a `preinstall` script. A script that runs during install or build executes with the developer or CI identity, before any test or review has looked at the code. This rule reads a package.json that runs a `preinstall` script.",
  "severity": "HIGH",
  "cwe": "CWE-829",
  "category": "build-hook",
  "ecosystems": [
    "npm"
  ],
  "artifact": "package.json",
  "parser": "json",
  "check": {
    "type": "sca-field-matches",
    "path": "scripts.preinstall",
    "valuePattern": "^.+$"
  },
  "tests": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p .",
          "preinstall": "node ./hooks/setup.js"
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p .",
          "preinstall": "node -e \"require('./hook')\""
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2783"
  ],
  "remediation": "Move the step out of the install lifecycle into an explicit, reviewed command that the build runs on purpose. Specifically: fix a package.json that runs a `preinstall` script.",
  "limitation": "It matches a package.json that runs a `preinstall` script in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
