{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0984",
  "title": "Central package with assets excluded",
  "description": "Directory.Packages.props declares a `<PackageVersion>` that strips runtime assets. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a `<PackageVersion>` that strips runtime assets.",
  "severity": "LOW",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "nuget"
  ],
  "artifact": "Directory.Packages.props",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "project.itemGroup.PackageVersion[].ExcludeAssets",
    "valuePattern": "^(?:runtime|all|compile|build|analyzers)$"
  },
  "tests": [
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "System.Text.Json",
                "Version": "8.0.5",
                "ExcludeAssets": "runtime"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "NLog",
                "Version": "5.3.4",
                "ExcludeAssets": "all"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          }
        }
      },
      "match": false
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Dapper",
                "Version": "2.1.35",
                "ExcludeAssets": "none"
              }
            ]
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-3121"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a `<PackageVersion>` that strips runtime assets.",
  "limitation": "It matches a `<PackageVersion>` that strips runtime assets in the parsed Directory.Packages.props; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
