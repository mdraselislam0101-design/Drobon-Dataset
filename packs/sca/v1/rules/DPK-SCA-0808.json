{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0808",
  "title": "pnpm lockfile on an older format",
  "description": "pnpm-lock.yaml declares a `lockfileVersion` from the pnpm 5/6 era. Without a recorded digest the downloaded artifact cannot be checked against what was reviewed, so substitution is undetectable at install time. This rule reads a `lockfileVersion` from the pnpm 5/6 era.",
  "severity": "LOW",
  "cwe": "CWE-494",
  "category": "lockfile-integrity",
  "ecosystems": [
    "npm"
  ],
  "artifact": "pnpm-lock.yaml",
  "parser": "yaml",
  "check": {
    "type": "sca-field-matches",
    "path": "lockfileVersion",
    "valuePattern": "^[56]\\.[0-9]+$"
  },
  "tests": [
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "6.0",
        "packages": {
          "/left-pad@1.3.0": {
            "resolution": {
              "tarball": "https://registry.npmjs.org/left-pad-1.3.0.tgz"
            },
            "integrity": "sha512-9f2c3d4e"
          }
        }
      },
      "match": true
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "5.4",
        "packages": {
          "/left-pad@1.3.0": {
            "resolution": {
              "tarball": "https://registry.npmjs.org/left-pad-1.3.0.tgz"
            },
            "integrity": "sha512-9f2c3d4e"
          }
        }
      },
      "match": true
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/left-pad@1.3.0": {
            "resolution": {
              "tarball": "https://registry.npmjs.org/left-pad-1.3.0.tgz"
            },
            "integrity": "sha512-9f2c3d4e"
          }
        }
      },
      "match": false
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "8.0",
        "packages": {
          "/left-pad@1.3.0": {
            "resolution": {
              "tarball": "https://registry.npmjs.org/left-pad-1.3.0.tgz"
            },
            "integrity": "sha512-9f2c3d4e"
          }
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2945"
  ],
  "remediation": "Regenerate the artifact with integrity data enabled and commit the recorded digest or checksum. Specifically: fix a `lockfileVersion` from the pnpm 5/6 era.",
  "limitation": "It matches a `lockfileVersion` from the pnpm 5/6 era in the parsed pnpm-lock.yaml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
