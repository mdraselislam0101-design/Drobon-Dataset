{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0704",
  "title": "The dependency audit step is left unconfigured",
  "description": "composer.json declares a composer.json with no `config.audit` block. A verification or locking control is switched off, so the integrity guarantees the ecosystem offers are not applied here. This rule reads a composer.json with no `config.audit` block.",
  "severity": "LOW",
  "cwe": "CWE-1104",
  "category": "policy-metadata",
  "ecosystems": [
    "composer"
  ],
  "artifact": "composer.json",
  "parser": "json",
  "check": {
    "type": "sca-field-absent",
    "path": "config.audit"
  },
  "tests": [
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          },
          "audit": {
            "abandoned": "fail"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": false
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          },
          "audit": {
            "block-insecure": true
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2841"
  ],
  "remediation": "Turn the control back on and fix what it reported instead of disabling the check. Specifically: fix a composer.json with no `config.audit` block.",
  "limitation": "It matches a composer.json with no `config.audit` block in the parsed composer.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
