{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0959",
  "title": "Dependency resolved with a classifier",
  "description": "pom.xml declares a dependency that pins a classifier artifact. Without a recorded digest the downloaded artifact cannot be checked against what was reviewed, so substitution is undetectable at install time. This rule reads a dependency that pins a classifier artifact.",
  "severity": "LOW",
  "cwe": "CWE-1104",
  "category": "supply-chain-integrity",
  "ecosystems": [
    "maven"
  ],
  "artifact": "pom.xml",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "project.dependencies[].classifier",
    "valuePattern": "^.+$"
  },
  "tests": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "sdk",
              "version": "4.2.0",
              "classifier": "jar-with-dependencies"
            }
          ]
        }
      },
      "match": true
    },
    {
