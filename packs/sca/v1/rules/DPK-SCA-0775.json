{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0775",
  "title": "R package whose project URL is cleartext",
  "description": "DESCRIPTION declares a `URL` field over cleartext. An artifact fetched over plain HTTP can be replaced in transit, so the bytes that install are not bound to what the author published. This rule reads a `URL` field over cleartext.",
  "severity": "LOW",
  "cwe": "CWE-319",
  "category": "registry-configuration",
  "ecosystems": [
    "cran"
  ],
  "artifact": "DESCRIPTION",
  "parser": "yaml",
  "check": {
    "type": "sca-field-matches",
    "path": "URL[]",
    "valuePattern": "^http://"
  },
  "tests": [
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT",
        "URL": [
          "http://acme.example/demo"
        ]
      },
      "match": true
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT",
        "URL": [
          "http://10.24.8.9/demo"
        ]
      },
      "match": true
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT",
        "URL": [
          "https://acme.example/demo"
        ]
      },
      "match": false
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT",
        "URL": [
          "https://github.com/acme/demo"
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2912"
  ],
  "remediation": "Use the HTTPS endpoint the registry publishes and keep the hostname in the configuration reviewable. Specifically: fix a `URL` field over cleartext.",
  "limitation": "It matches a `URL` field over cleartext in the parsed DESCRIPTION; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
