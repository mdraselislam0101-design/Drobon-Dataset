{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0214",
  "title": "Hex dependency declared without a requirement",
  "description": "mix.exs declares a `mix.exs` dependency with no version requirement. Mix resolves the newest release on every fetch, so a package published after review installs with no change to the file.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "hex"
  ],
  "artifact": "mix.exs",
  "parser": "lockfile-text",
  "check": {
    "type": "sca-field-matches",
    "path": "deps[].requirement",
    "valuePattern": "^$"
  },
  "tests": [
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "phoenix",
            "requirement": ""
          }
        ]
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "ecto",
            "requirement": ""
          },
          {
            "name": "phoenix",
            "requirement": "~> 1.7"
          }
        ]
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "phoenix",
            "requirement": "~> 1.7.10"
          }
        ]
      },
      "match": false
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "ecto",
            "requirement": "~> 3.11"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2351"
  ],
  "remediation": "Declare the requirement the project tested and commit `mix.lock`.",
  "limitation": "It matches a `mix.exs` dependency with no version requirement in the parsed mix.exs; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
