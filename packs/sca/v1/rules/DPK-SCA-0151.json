{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0151",
  "title": "Go dependency pinned to a prerelease tag",
  "description": "go.mod declares a prerelease module version. Prereleases sit outside most advisory ranges and carry no stability promise, so a known defect can ship behind a deliberate pin.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "go"
  ],
  "artifact": "go.mod",
  "parser": "ini",
  "check": {
    "type": "sca-field-matches",
    "path": "require[].version",
    "valuePattern": "^v\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}-(?:alpha|beta|rc)\\b"
  },
  "tests": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.0.0-rc.1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.1.0-beta.3"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.0.0"
          }
        ]
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.1.0"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2288"
  ],
  "remediation": "Pin the first stable tag.",
  "limitation": "It matches a prerelease module version in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
