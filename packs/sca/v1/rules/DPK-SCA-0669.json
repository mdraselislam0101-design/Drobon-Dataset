{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0669",
  "title": "Release build resolves snapshot artifacts",
  "description": "pom.xml declares a repository URL that points at a snapshot channel. The declaration leaves version choice to a resolver run, so a release published after this review is taken without a new decision. This rule reads a repository URL that points at a snapshot channel.",
  "severity": "MEDIUM",
  "cwe": "CWE-829",
  "category": "registry-configuration",
  "ecosystems": [
    "maven"
  ],
  "artifact": "pom.xml",
  "parser": "xml",
  "check": {
    "type": "sca-field-matches",
    "path": "project.repositories[].url",
    "valuePattern": "snapshots?/?$"
  },
  "tests": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "acme",
              "url": "https://nexus.acme.example/snapshots"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "acme",
              "url": "https://nexus.acme.example/snapshot"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "acme",
              "url": "https://nexus.acme.example/releases"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2806"
  ],
  "remediation": "Pin the declaration to an exact version or to the narrowest range the project tests, and update it deliberately. Specifically: fix a repository URL that points at a snapshot channel.",
  "limitation": "It matches a repository URL that points at a snapshot channel in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
