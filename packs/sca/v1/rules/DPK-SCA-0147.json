{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0147",
  "title": "Go module required with no version",
  "description": "go.mod declares a `require` line whose version is empty. Go resolves the missing version to the latest release at build time, so the module that compiles is decided by the proxy, not the file.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "go"
  ],
  "artifact": "go.mod",
  "parser": "ini",
  "check": {
    "type": "sca-field-matches",
    "path": "require[].version",
    "valuePattern": "^$"
  },
  "tests": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": ""
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "golang.org/x/text",
            "version": ""
          },
          {
            "module": "github.com/pkg/errors",
            "version": "v0.9.1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ]
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "golang.org/x/text",
            "version": "v0.16.0"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2284"
  ],
  "remediation": "Record the version the project tested and commit `go.sum` with it.",
  "limitation": "It matches a `require` line whose version is empty in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
