{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0134",
  "title": "poetry.lock entry without a version",
  "description": "poetry.lock declares a locked package that records no version. Without a resolved version Poetry's install is keyed on whatever the environment resolves, so the lockfile stops being a record of what was audited and no version-based check can read the install at all.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "lockfile-integrity",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "poetry.lock",
  "parser": "toml",
  "check": {
    "type": "sca-entry-missing-field",
    "path": "package",
    "field": "version"
  },
  "tests": [
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "files": [
              {
                "file": "requests.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "flask",
            "files": [
              {
                "file": "flask.whl",
                "hash": "sha256:bbbb"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "version": "2.32.3",
            "files": [
              {
                "file": "requests-2.32.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": false
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "flask",
            "version": "3.0.3",
            "files": [
              {
                "file": "flask-3.0.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2271"
  ],
  "remediation": "Re-run `poetry lock --no-update` and commit the regenerated `poetry.lock`, so every `[[package]]` block records the version Poetry resolved.",
  "limitation": "It matches a locked package that records no version in the parsed poetry.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
