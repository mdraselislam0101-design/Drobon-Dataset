{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0111",
  "title": "Python requirement with an open lower bound",
  "description": "requirements.txt declares a `>=` requirement with no upper bound. Every future major release satisfies the line, so an incompatible or compromised release installs on the next build.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "requirements.txt",
  "parser": "requirements",
  "check": {
    "type": "sca-field-matches",
    "path": "requirements[].specifier",
    "valuePattern": "^>=[^,]{1,20}$"
  },
  "tests": [
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "requests",
            "specifier": ">=2.31.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "urllib3",
            "specifier": ">=2.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "requests",
            "specifier": ">=2.31.0,<3"
          }
        ]
      },
      "match": false
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "urllib3",
            "specifier": "==2.2.2"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2248"
  ],
  "remediation": "Add an upper bound, or pin an exact version.",
  "limitation": "It matches a `>=` requirement with no upper bound in the parsed requirements.txt; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
