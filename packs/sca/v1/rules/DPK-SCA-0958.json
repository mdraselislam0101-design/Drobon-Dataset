          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ],
          "distributionManagement": {}
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
