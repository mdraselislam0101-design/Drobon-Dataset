{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0958",
  "title": "Module relocated to other coordinates",
  "description": "pom.xml declares a relocation block that redirects the module. A name or scope that resolves outside the project's intended registry is fetched from a source nobody reviewed, so a publish there becomes an install here. This rule reads a relocation block that redirects the module.",
  "severity": "LOW",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "maven"
  ],
  "artifact": "pom.xml",
  "parser": "xml",
  "check": {
    "type": "sca-key-matches",
    "path": "project.distributionManagement.relocation",
    "keyPattern": "^(?:groupId|artifactId)$"
  },
  "tests": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ],
          "distributionManagement": {
            "relocation": {
              "groupId": "com.acme",
              "artifactId": "demo-service-core"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
