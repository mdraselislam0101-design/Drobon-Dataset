{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0229",
  "title": "Podfile entry with no version requirement",
  "description": "Podfile declares a pod declared without a requirement. CocoaPods resolves the newest matching pod, so a release published after review installs unchanged.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "cocoapods"
  ],
  "artifact": "Podfile",
  "parser": "lockfile-text",
  "check": {
    "type": "sca-field-matches",
    "path": "pods[].requirement",
    "valuePattern": "^$"
  },
  "tests": [
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": ""
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "SnapKit",
            "requirement": ""
          },
          {
            "name": "Alamofire",
            "requirement": "~> 5.9"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": "~> 5.9.1"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "SnapKit",
            "requirement": "5.7.1"
          }
        ]
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2366"
  ],
  "remediation": "Declare the requirement and commit `Podfile.lock`.",
  "limitation": "It matches a pod declared without a requirement in the parsed Podfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
