{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0773",
  "title": "R package that declares no licence restriction",
  "description": "DESCRIPTION declares a `License: Unlimited` field. An unknown or absent licence class leaves the redistribution question unanswered, which matters for every packaged build. This rule reads a `License: Unlimited` field.",
  "severity": "LOW",
  "cwe": "CWE-1104",
  "category": "policy-metadata",
  "ecosystems": [
    "cran"
  ],
  "artifact": "DESCRIPTION",
  "parser": "yaml",
  "check": {
    "type": "sca-field-matches",
    "path": "License",
    "valuePattern": "^Unlimited$"
  },
  "tests": [
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "Unlimited"
      },
      "match": true
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.2.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "Unlimited"
      },
      "match": true
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT + file LICENSE"
      },
      "match": false
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "GPL-3"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2910"
  ],
  "remediation": "Record the licence class the project actually ships under, or stop depending on the component until it is known. Specifically: fix a `License: Unlimited` field.",
  "limitation": "It matches a `License: Unlimited` field in the parsed DESCRIPTION; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
