{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0661",
  "title": "Module substituted by an unreleased pseudo-version",
  "description": "go.mod declares a `replace` directive that pins a pre-release pseudo-version. A dependency resolved from a local path or a mutable branch is not the published artifact the rest of the project audits. This rule reads a `replace` directive that pins a pre-release pseudo-version.",
  "severity": "MEDIUM",
  "cwe": "CWE-1104",
  "category": "dependency-hygiene",
  "ecosystems": [
    "go"
  ],
  "artifact": "go.mod",
  "parser": "lockfile-text",
  "check": {
    "type": "sca-field-matches",
    "path": "replace[].new.version",
    "valuePattern": "^v0\\.0\\.0-"
  },
  "tests": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [
          {
            "old": {
              "path": "example.com/acme/core"
            },
            "new": {
              "path": "example.com/acme/core",
              "version": "v0.0.0-20240101120000-9f2c3d4e5f60"
            }
          }
        ],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [
          {
            "old": {
              "path": "example.com/acme/sdk"
            },
            "new": {
              "path": "github.com/acme/sdk",
              "version": "v0.0.0-20240202080000-a1b2c3d4e5f6"
            }
          }
        ],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [
          {
            "old": {
              "path": "example.com/acme/core"
            },
            "new": {
              "path": "example.com/acme/core",
              "version": "v1.4.2"
            }
          }
        ],
        "exclude": []
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2798"
  ],
  "remediation": "Depend on a published, versioned artifact, and keep local paths or branch references out of the committed manifest. Specifically: fix a `replace` directive that pins a pre-release pseudo-version.",
  "limitation": "It matches a `replace` directive that pins a pre-release pseudo-version in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
