{
  "schemaVersion": "drobon.pack.sca/v1",
  "id": "DPK-SCA-0132",
  "title": "poetry.lock hash recorded as SHA-1",
  "description": "poetry.lock declares a locked file hash that uses SHA-1. SHA-1 collisions are practical, so the hash cannot prove that the installed distribution is the reviewed one.",
  "severity": "MEDIUM",
  "cwe": "CWE-328",
  "category": "lockfile-integrity",
  "ecosystems": [
    "pypi"
  ],
  "artifact": "poetry.lock",
  "parser": "toml",
  "check": {
    "type": "sca-field-matches",
    "path": "package[].files[].hash",
    "valuePattern": "^sha1:"
  },
  "tests": [
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "version": "2.32.3",
            "files": [
              {
                "file": "requests-2.32.3.tar.gz",
                "hash": "sha1:aaaabbbbcccc"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "flask",
            "version": "3.0.3",
            "files": [
              {
                "file": "flask-3.0.3-py3-none-any.whl",
                "hash": "sha1:111122223333"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "version": "2.32.3",
            "files": [
              {
                "file": "requests-2.32.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": false
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "flask",
            "version": "3.0.3",
            "files": [
              {
                "file": "flask-3.0.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2269"
  ],
  "remediation": "Re-lock with a current Poetry so the hashes are SHA-256.",
  "limitation": "It matches a locked file hash that uses SHA-1 in the parsed poetry.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code."
}
