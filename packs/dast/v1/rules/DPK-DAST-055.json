{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-055",
  "title": "HTTP subresource on an HTTPS page",
  "description": "The HTTPS response references a HTTP subresource over cleartext HTTP. Browsers block or warn on active mixed content, but passive resources still cross the network unprotected. This check reads one observed response body and confirms the cleartext reference.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "mixed-content",
  "remediation": "Serve every subresource over HTTPS (HTTPS URLs for every script, style, image, and frame).",
  "limitation": "Body text check on one response: it matches common markup tags only, not CSS url() or script-built URLs, and it does not prove the browser fetched the resource.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "<(?:script|img|link|iframe|audio|video|source)\\b[^>]*\\s(?:src|href)\\s*=\\s*[\"']http://",
    "requireScheme": "https"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "content-type": "text/html"
        },
        "body": "<script src=\"http://cdn.example/app.js\"></script>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "content-type": "text/html"
        },
        "body": "<script src=\"https://cdn.example/app.js\"></script>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "content-type": "text/html"
        },
        "body": "<script src=\"http://cdn.example/app.js\"></script>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "content-type": "text/html"
        },
        "body": "<html xmlns=\"http://www.w3.org/1999/xhtml\"></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0908"
  ]
}
