{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-092",
  "title": "Content-Security-Policy frame-ancestors allows every origin",
  "description": "The frame-ancestors directive contains a standalone wildcard, so any site may embed this document in a frame. The directive is the modern replacement for X-Frame-Options, and a wildcard silently removes the clickjacking protection that the policy appears to provide. The check reports the directive value.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "csp-weakness",
  "remediation": "Replace frame-ancestors * with 'none' or an explicit list of embedding origins.",
  "limitation": "Observation-level: matches a standalone wildcard in frame-ancestors. A policy that omits the directive entirely is reported by a separate rule.",
  "check": {
    "type": "response-header-matches",
    "header": "Content-Security-Policy",
    "valuePattern": "^(?:(?!frame-ancestors)[^;]*;\\s*)*frame-ancestors(?=\\s)[^;]*?(?<=\\s)(?:\\*|(?:https?|wss?)://\\*)(?=\\s|;|$)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors 'self' *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors 'self'; frame-ancestors *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *; frame-ancestors 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors https://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors https://*.example.com"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1161"
  ]
}
