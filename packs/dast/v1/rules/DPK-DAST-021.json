{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-021",
  "title": "Weak Content-Security-Policy (unsafe-inline) header value",
  "description": "The response carries Content-Security-Policy (unsafe-inline) with a weak or deprecated value. A weak value grants partial protection at best. This check matches the weak value directly.",
  "severity": "LOW",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Strengthen the value (nonce-based scripts).",
  "limitation": "Value check: it cannot confirm the deployment context.",
  "check": {
    "type": "response-header-matches",
    "header": "Content-Security-Policy",
    "valuePattern": "unsafe-inline"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'unsafe-inline'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; style-src 'unsafe-inline'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'nonce-a1b2'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0051"
  ]
}
