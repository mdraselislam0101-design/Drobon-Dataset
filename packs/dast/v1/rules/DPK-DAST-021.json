{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-021",
  "title": "Weak Content-Security-Policy (unsafe-inline) header value",
  "description": "A script or style directive still permits inline code through 'unsafe-inline'. When the same directive also carries a nonce or a hash, browsers ignore 'unsafe-inline', so that policy is not reported. The check looks at script-src, script-src-elem, script-src-attr, style-src, style-src-elem, style-src-attr and default-src only; a policy that neutralises inline code with a nonce is left alone.",
  "severity": "LOW",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Replace 'unsafe-inline' with a per-response nonce or a hash of each inline block, and remove the keyword so a regression is visible.",
  "limitation": "Directive-scoped value check: a nonce or hash anywhere in the same directive neutralises 'unsafe-inline' and suppresses the finding. It cannot tell whether the nonce is actually random, nor whether every inline script carries it, and it does not evaluate the deployment context.",
  "check": {
    "type": "response-header-matches",
    "header": "Content-Security-Policy",
    "valuePattern": "(?:^|;)\\s*(?:script-src(?:-elem|-attr)?|style-src(?:-elem|-attr)?|default-src)(?=[\\s;]|$)(?![^;]*(?:'nonce-[^'\\s]+'|'sha(?:256|384|512)-[^'\\s]+'))[^;]*'?unsafe-inline'?(?=['\\s;]|$)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'unsafe-inline'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; style-src 'unsafe-inline'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src-attr 'unsafe-inline'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'unsafe-inline' 'nonce-abc'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'unsafe-inline' 'sha256-AAA'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "style-src 'unsafe-inline' 'nonce-xyz'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "img-src 'unsafe-inline'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'unsafe-inline-x'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'nonce-a1b2'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src https://nonce-cdn.example 'unsafe-inline'"
        }
      },
      "match": true
    }
  ],
  "patternRefs": [
    "DPK-PAT-0051"
  ]
}
