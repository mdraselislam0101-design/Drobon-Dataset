{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-677",
  "title": "Supabase service role key in a response",
  "description": "A Supabase service role label next to a JWT appears in the response body. The service role key bypasses row-level security, so anyone holding it can read every table in the project, which makes it a full data breach rather than a scoped leak.",
  "severity": "CRITICAL",
  "cwe": "CWE-200",
  "category": "credential-exposure",
  "remediation": "Rotate the key and never let the service role reach a browser bundle.",
  "limitation": "One response body, first 32,768 bytes. It matches the service role label with a JWT; it cannot tell whether the value behind the marker is live or whether the page needs authentication.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?:service_role[\\s\\S]{0,160}?eyJ[A-Za-z0-9_-]{8,}|eyJ[A-Za-z0-9_-]{8,}[\\s\\S]{0,160}?service_role)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"supabase\":{\"role\":\"service_role\",\"key\":\"eyJhbGciOiJIUzI1NiJ9.SYNTHETIC.sig\"}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"key\":\"eyJhbGciOiJIUzI1NiJ9.SYNTHETIC.sig\",\"role\":\"service_role\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"supabase\":{\"role\":\"anon\",\"key\":\"eyJhbGciOiJIUzI1NiJ9.PUBLIC.sig\"}}"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1796"
  ]
}
