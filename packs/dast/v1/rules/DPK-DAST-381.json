{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-381",
  "title": "composer.lock dependency lockfile served",
  "description": "The response is a Composer lockfile: the packages array with its content hash. It lists every PHP package, its version and its source URL, which is the exact dependency set of the application.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Exclude lockfiles from the deployed tree and deny them at the server level.",
  "limitation": "One response body. The rule reads the JSON shape; it does not resolve the package versions.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*\"content-hash\"\\s*:)(?=[\\s\\S]*\"packages\"\\s*:)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"_readme\":[\"This file locks the dependencies\"],\"content-hash\":\"a1b2c3d4\",\"packages\":[{\"name\":\"monolog/monolog\",\"version\":\"3.5.0\"}],\"packages-dev\":[]}\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"packages\":[{\"name\":\"shop/core\",\"version\":\"1.2.0\",\"source\":{\"url\":\"https://git.internal/shop/core.git\"}}],\"content-hash\":\"ffff0000\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"require\":{\"php\":\">=8.1\",\"monolog/monolog\":\"^3.5\"}}\n"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/deploy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Deployment guide</title></head><body><p>Commit composer.lock and install with --no-dev.</p></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1450"
  ]
}
