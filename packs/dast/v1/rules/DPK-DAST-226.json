{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-226",
  "title": "Jenkins dashboard disclosed",
  "description": "The response is the Jenkins dashboard: the Jenkins chrome together with the Manage Jenkins link and the job list identifies the controller home page. The dashboard names the jobs and exposes the management entry point.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Require authentication for the dashboard and disable anonymous read access. Restrict the controller to the internal network.",
  "limitation": "One response body. The rule reports the dashboard; it does not open a job and cannot show whether builds or credentials are reachable.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*Jenkins)(?=[\\s\\S]*Manage\\ Jenkins)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Dashboard [Jenkins]</title></head><body><div id=\"jenkins-head\"><a href=\"/manage\">Manage Jenkins</a></div><div id=\"job_shop\"><a href=\"/job/shop/\">shop</a></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div id=\"jenkins\"><span>Jenkins</span><a href=\"manage\">Manage Jenkins</a></div><table id=\"projectstatus\"><tr><td>deploy-prod</td></tr></table></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Dashboard []</title></head><body><div id=\"-head\"><a href=\"/manage\">Manage </a></div><div id=\"job_shop\"><a href=\"/job/shop/\">shop</a></div></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1295"
  ]
}
