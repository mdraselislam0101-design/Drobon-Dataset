{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-086",
  "title": "Content-Security-Policy connect-src allows every origin",
  "description": "The Content-Security-Policy header grants a standalone wildcard to connect-src, so script running on the page may send fetch, XHR, WebSocket and EventSource traffic to any host. A strict script-src does not help once injected code can exfiltrate through a permitted channel. The check reports the directive value; it does not claim injection is present.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "csp-weakness",
  "remediation": "Replace the wildcard with the explicit API origins the application calls.",
  "limitation": "Observation-level: matches a standalone * source in connect-src. Host wildcards such as *.example.com and other directives are separate checks.",
  "check": {
    "type": "response-header-matches",
    "header": "Content-Security-Policy",
    "valuePattern": "^(?:(?!connect-src)[^;]*;\\s*)*connect-src(?=\\s)[^;]*?(?<=\\s)(?:\\*|(?:https?|wss?)://\\*)(?=\\s|;|$)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src 'self' *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src 'self'; connect-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src 'self' https://api.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src https://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src wss://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src https://*.api.example"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1155"
  ]
}
