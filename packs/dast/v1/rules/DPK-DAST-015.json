{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-015",
  "title": "Missing Content-Security-Policy response header",
  "description": "The response carries no Content-Security-Policy header. Its absence forfeits the protection the header provides. This check evaluates a normal observation and confirms the header is absent.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Emit Content-Security-Policy on every response (default-src 'self').",
  "limitation": "Header-name check: it cannot judge whether the header value is correct.",
  "check": {
    "type": "missing-response-header",
    "header": "Content-Security-Policy"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "Content-Security-Policy": "default-src 'none'"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0045"
  ]
}
