{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-047",
  "title": "Weak response control (COOP without same-origin)",
  "description": "The response weakens a control: COOP without same-origin. Protocol-relative redirects, wildcard timing origins, and charset-less content types widen attacks. This check matches the weakness directly.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Strengthen the control (same-origin).",
  "limitation": "Header check: it cannot confirm exploitability.",
  "check": {
    "type": "response-header-missing-directive",
    "header": "Cross-Origin-Opener-Policy",
    "directive": "same-origin"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": "unsafe-none"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0572"
  ]
}
