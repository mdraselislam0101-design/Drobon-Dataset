{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-398",
  "title": "Apache Storm UI is reachable without authentication",
  "description": "The response is the Storm UI: the topology summary together with the cluster summary. It lists the topologies, their executors, the supervisor hosts and the nimbus address of the cluster.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Restrict the Storm UI to the cluster network and put it behind an authenticating proxy.",
  "limitation": "One response body. The rule reports the UI summary; it does not open a topology.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*Storm UI)(?=[\\s\\S]*topology summary)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://storm.example:8080/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Storm UI</title></head><body><h2>Cluster Summary</h2><h2>Topology summary</h2><p>Nimbus uptime 4d</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://storm.example:8080/topology.html?id=web",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Storm UI</h1><h2>Topology summary</h2><p>Supervisors 4</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Streaming guide</title></head><body><p>The UI lists the topology summary for the cluster.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/stream",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Stream</title></head><body><p>Streaming is healthy.</p></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1467"
  ]
}
