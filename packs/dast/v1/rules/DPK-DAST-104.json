{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-104",
  "title": "Content-Security-Policy frame-src allows every origin",
  "description": "The policy lets a frame embed content from any origin (frame-src wildcard). Embedded third-party content runs with its own privileges inside the page, can phish the user in place of the application, and can drive the top-level navigation of a page that trusts what it frames. The directive is read from its first declaration only.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "csp-weakness",
  "remediation": "Name the embeddable origins, for example frame-src 'self' https://player.example. Cross-origin frames that need to run script should be isolated with sandbox attributes and a matching Cross-Origin-Opener-Policy.",
  "limitation": "One header value, first declaration of the directive only. The rule cannot see which frames a page actually contains.",
  "check": {
    "type": "response-header-matches",
    "header": "Content-Security-Policy",
    "valuePattern": "^(?:(?!frame-src(?=[\\s;]|$))[^;]*;\\s*)*frame-src(?=[\\s;]|$)[^;]*?(?<=\\s)(?:\\*|(?:https?|wss?)://\\*)(?=\\s|;|$)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-src *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; frame-src 'self' https://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-src https://*.example.com"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-src 'self'; frame-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1173"
  ]
}
