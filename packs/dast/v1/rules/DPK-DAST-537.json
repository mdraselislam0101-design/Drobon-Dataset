{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-537",
  "title": "Absolute node_modules path in a response",
  "description": "An absolute path into a node_modules directory appears in the response body. The path discloses the deployment root, the operating system and the exact dependency layout, which lets an attacker match a known vulnerable package version without touching the server.",
  "severity": "LOW",
  "cwe": "CWE-209",
  "category": "information-disclosure",
  "remediation": "Install dependencies outside the served tree, return generic errors and keep stack frames in the log.",
  "limitation": "One response body. It matches an absolute path ending in a package directory, not a relative import in source that was never executed.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "/(?:srv|app|home|usr|opt)/[^<>\\\"']{0,120}node_modules/"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<pre>at Object.&lt;anonymous&gt; (/srv/app/node_modules/express/lib/router/index.js:281:7)</pre>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "Error: Cannot find module '/opt/drobon/node_modules/pg/lib/index.js'"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<p>Something went wrong. Reference c-2201.</p>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1656"
  ]
}
