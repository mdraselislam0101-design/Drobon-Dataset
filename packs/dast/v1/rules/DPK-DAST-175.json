{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-175",
  "title": "Kubelet pod list disclosed",
  "description": "The response is a Kubernetes PodList document: the kubelet read-only API returns the pods scheduled on the node, including namespaces and container images. That endpoint normally answers only on the node network or to authenticated callers.",
  "severity": "HIGH",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Disable the kubelet read-only port or set authentication and authorization on the kubelet, and restrict the node network. Anonymous access to the kubelet API is not a supported configuration.",
  "limitation": "One response body. The rule reports the pod list the kubelet returned; it does not attempt any other kubelet endpoint and cannot show whether exec or logs are reachable.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*\"kind\"\\s*:\\s*\"PodList)(?=[\\s\\S]*\"apiVersion\")"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"kind\":\"PodList\",\"apiVersion\":\"v1\",\"metadata\":{\"resourceVersion\":\"12345\"},\"items\":[{\"metadata\":{\"name\":\"api-7d9f\",\"namespace\":\"prod\"},\"spec\":{\"nodeName\":\"node-1\"}}]}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"kind\":\"PodList\",\"apiVersion\":\"v1\",\"items\":[{\"metadata\":{\"name\":\"worker-1\",\"namespace\":\"default\"}}]}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\",:\"v1\",\"metadata\":{\"resourceVersion\":\"12345\"},\"items\":[{\"metadata\":{\"name\":\"api-7d9f\",\"namespace\":\"prod\"},\"spec\":{\"nodeName\":\"node-1\"}}]}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1244"
  ]
}
