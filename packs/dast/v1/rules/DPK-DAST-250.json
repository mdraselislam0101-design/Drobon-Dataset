{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-250",
  "title": "WordPress version in generator meta tag",
  "description": "The response carries a generator meta tag naming WordPress with its version: the meta name and the WordPress content string together publish the exact release. That version tells a reader which plugin and core issues apply.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Remove the generator meta tag from the theme and keep the core and plugins updated. Version hiding is defence in depth, not a substitute for patching.",
  "limitation": "One response body. The rule reports the meta tag; it does not look the version up against an advisory source and makes no claim that the release is vulnerable.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*name=[\"\\']generator[\"\\'])(?=[\\s\\S]*WordPress)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta name=\"generator\" content=\"WordPress 6.2.2\"><title>Blog</title></head><body><h1>Blog</h1></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><head><meta name=\"generator\" content=\"WordPress 5.9.8\"></head><body>Home</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta  content=\" 6.2.2\"><title>Blog</title></head><body><h1>Blog</h1></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1319"
  ]
}
