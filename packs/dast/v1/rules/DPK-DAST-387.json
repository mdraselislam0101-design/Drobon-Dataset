{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-387",
  "title": "poetry.lock dependency lockfile served",
  "description": "The response is a Poetry lockfile: repeated package tables with their names, versions and file hashes. It is the resolved dependency set of the Python environment.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Exclude lockfiles from the deployed tree and deny them at the server level.",
  "limitation": "One response body. The rule reads the table shape; it does not resolve the versions.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*(?:^|\\n)\\[\\[package\\]\\])(?=[\\s\\S]*\\nname = \"[a-z0-9-]{2,40}\")"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "[[package]]\nname = \"requests\"\nversion = \"2.31.0\"\ndescription = \"Python HTTP for Humans.\"\n\n[[package]]\nname = \"urllib3\"\nversion = \"2.2.1\"\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "[[package]]\nname = \"shop-client\"\nversion = \"0.9.1\"\nsource = {type = \"legacy\", url = \"https://pypi.internal/simple\"}\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "[tool.poetry]\nname = \"shop\"\nversion = \"1.4.0\"\n"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/deploy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Deployment guide</title></head><body><p>Run poetry install --no-root in the image.</p></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1456"
  ]
}
