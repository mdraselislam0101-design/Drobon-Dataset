{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-511",
  "title": "Bank account number served together with a balance",
  "description": "A JSON response pairs an account number with a balance value. Together they form a complete financial profile of the customer, which is far more useful to a fraudster than either field alone and is not something a page renderer needs in one payload.",
  "severity": "HIGH",
  "cwe": "CWE-359",
  "category": "privacy-exposure",
  "remediation": "Return a masked account number (last four digits) with the balance, and keep the full number behind a step-up authenticated detail endpoint.",
  "limitation": "One response body and the JSON key shapes only. A balance rendered without an account key is out of scope.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*(?:balance|available))(?=[\\s\\S]*\\\"(?:account_number|accountNumber|acct_no)\\\")[\\s\\S]*?\\\"(?:account_number|accountNumber|acct_no)\\\"\\s*:\\s*\\\"?[0-9]{8,17}\\\"?"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/api/accounts",
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"account_number\":\"0123456789012\",\"balance\":\"18420.55\",\"currency\":\"BDT\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/summary",
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"accounts\":[{\"acct_no\": 55100488291177, \"available\": 920.10}]}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/accounts/masked",
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"account_number\":\"****8821\",\"balance\":\"18420.55\",\"currency\":\"BDT\"}"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1580"
  ]
}
