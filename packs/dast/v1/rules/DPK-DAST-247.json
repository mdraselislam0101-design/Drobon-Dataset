{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-247",
  "title": "Traefik dashboard disclosed",
  "description": "The response is the Traefik dashboard: the Traefik name together with the dashboard container identifies the proxy administration UI. The dashboard lists routers, services and middlewares, including their forwarding targets.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Keep the dashboard on the internal network or disable it, and require authentication through a middleware when it must be reachable.",
  "limitation": "One response body. The rule reports the dashboard; it does not read provider data and cannot show whether the API is enabled insecurely.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*traefik)(?=[\\s\\S]*Dashboard)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Traefik</title></head><body><div id=\"traefik-dashboard\"></div><script src=\"/dashboard/traefik.js\"></script><h1>Dashboard</h1></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h2>Traefik</h2><section id=\"dashboard\"><p>HTTP Routers</p></section></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><div id=\"-\"></div><script src=\"//.js\"></script><h1></h1></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1316"
  ]
}
