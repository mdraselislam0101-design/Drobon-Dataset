{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-045",
  "title": "Weak response control (charset-less Content-Type)",
  "description": "The response weakens a control: charset-less Content-Type. Protocol-relative redirects, wildcard timing origins, and charset-less content types widen attacks. This check matches the weakness directly.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Strengthen the control (charset=utf-8).",
  "limitation": "Header check: it cannot confirm exploitability.",
  "check": {
    "type": "response-header-missing-directive",
    "header": "Content-Type",
    "directive": "charset"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0570"
  ]
}
