{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-168",
  "title": "Jaeger tracing UI disclosed",
  "description": "The response is the Jaeger query UI: the jaeger-ui bundle and the product name identify the tracing console. Traces carry service names, timings and sometimes request attributes from production traffic.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Keep the Jaeger query service on an internal network behind an authenticating proxy and restrict trace retention to what is needed.",
  "limitation": "One response body. The rule reports the UI shell; it does not fetch a trace and cannot show which attributes a span carries.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*jaeger\\-ui)(?=[\\s\\S]*Jaeger)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Jaeger</title></head><body><div id=\"jaeger-ui\"></div><script src=\"/static/jaeger-ui.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div class=\"jaeger-ui\"></div><span>Jaeger</span></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><div id=\"\"></div><script src=\"/static/.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1237"
  ]
}
