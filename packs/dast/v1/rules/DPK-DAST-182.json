{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-182",
  "title": "Apache Spark master UI disclosed",
  "description": "The response is the Spark master web UI: the Spark Master heading with the spark:// URL identifies the cluster manager and its coordinator address. The UI lists applications, workers and drivers.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Keep the Spark master UI on the internal network and enable the authentication filter. Do not publish port 8080 through the application ingress.",
  "limitation": "One response body. The rule reports the master UI; it does not submit an application and cannot show whether submission is open.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*Spark\\ Master)(?=[\\s\\S]*spark://)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Spark Master at spark://master:7077</title></head><body><h1>Spark Master at spark://master:7077</h1><ul><li>Workers: 4</li></ul></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h2>Spark Master at spark://10.0.0.5:7077</h2><a href=\"app/\">Running Applications</a></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title> at master:7077</title></head><body><h1> at master:7077</h1><ul><li>Workers: 4</li></ul></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1251"
  ]
}
