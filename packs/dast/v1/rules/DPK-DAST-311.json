{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-311",
  "title": "Set-Cookie Partitioned is sent without Secure",
  "description": "A cookie carries the Partitioned attribute but not Secure. The specification requires Secure with Partitioned, so browsers discard the cookie: the partitioned storage the author asked for never exists, and the failure is silent.",
  "severity": "LOW",
  "cwe": "CWE-614",
  "category": "cookie-flags",
  "remediation": "Always pair Partitioned with Secure and SameSite=None; consider the __Host- prefix so the whole contract is enforced by the browser.",
  "limitation": "One Set-Cookie value. The check reads the attributes; it does not test which user agents implement partitioned storage.",
  "check": {
    "type": "response-header-matches",
    "header": "Set-Cookie",
    "valuePattern": "^(?=[\\s\\S]*;\\s*partitioned\\s*(?:;|$))(?!([\\s\\S]*;\\s*secure\\s*(?:;|$)))"
  },
  "tests": [
    {
      "observation": {
        "url": "https://shop.example/embed",
        "status": 200,
        "headers": {
          "Set-Cookie": "__Host-ps=abc; Path=/; HttpOnly; Partitioned"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://shop.example/embed",
        "status": 200,
        "headers": {
          "Set-Cookie": "ps=abc; Path=/; SameSite=None; Partitioned"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://shop.example/embed",
        "status": 200,
        "headers": {
          "Set-Cookie": "__Host-ps=abc; Path=/; Secure; HttpOnly; SameSite=None; Partitioned"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://shop.example/embed",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; Secure; HttpOnly; SameSite=Lax"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1380"
  ]
}
