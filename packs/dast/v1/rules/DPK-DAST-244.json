{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-244",
  "title": "Symfony profiler toolbar disclosed",
  "description": "The response carries the Symfony web profiler toolbar: the sf-toolbar element and the Symfony name are the toolbar that development builds inject into every page. The toolbar links a profiler that records queries, configuration and request data.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Disable the web profiler outside development (web_profiler toolbar false, debug false), clear the profiler store, and confirm the toolbar is absent from production pages.",
  "limitation": "One response body. The rule reports the toolbar; it does not request a profile token and cannot show what a stored profile contains.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*sf\\-toolbar)(?=[\\s\\S]*Symfony)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"sfToolbarMainContent\"><span>Symfony</span></div><style>#sf-toolbar{}</style><script>var sf_toolbar = 1;</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div class=\"sf-toolbar\" data-sf-role=\"toolbar\"><span>Symfony v6.3</span></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"sfToolbarMainContent\"><span></span></div><style>#{}</style><script>var sf_toolbar = 1;</script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1313"
  ]
}
