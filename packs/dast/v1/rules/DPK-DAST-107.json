{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-107",
  "title": "Content-Security-Policy style-src allows every origin",
  "description": "The policy lets a stylesheet load from any origin (style-src wildcard or scheme wildcard). Loaded CSS is not inert: attribute selectors can read input values back out through background requests, and a foreign stylesheet can hide or reposition interface elements. The directive is read from its first declaration only, because later duplicates are ignored by browsers.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "csp-weakness",
  "remediation": "List the stylesheet origins, for example style-src 'self' https://cdn.example. If inline style is required, use a nonce or hash instead of 'unsafe-inline'.",
  "limitation": "One header value, first declaration of the directive only. It reports the wildcard permission, not whether an attacker can influence the style sources a page loads.",
  "check": {
    "type": "response-header-matches",
    "header": "Content-Security-Policy",
    "valuePattern": "^(?:(?!style-src(?=[\\s;]|$))[^;]*;\\s*)*style-src(?=[\\s;]|$)[^;]*?(?<=\\s)(?:\\*|(?:https?|wss?)://\\*)(?=\\s|;|$)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "style-src *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; style-src 'self' https://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "style-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "style-src https://*.example.com"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "style-src 'self'; style-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1176"
  ]
}
