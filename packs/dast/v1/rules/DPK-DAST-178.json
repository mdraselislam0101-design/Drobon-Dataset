{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-178",
  "title": "Portainer interface disclosed",
  "description": "The response is the Portainer front end: the portainer root element and the product name identify the container management console. Portainer holds credentials for the container hosts it manages.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Keep Portainer on the management network behind an authenticating proxy and never publish it through the application ingress.",
  "limitation": "One response body. The rule reports the Portainer shell; it does not list a container or a stack.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*portainer)(?=[\\s\\S]*Portainer)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Portainer</title></head><body><div id=\"portainer-root\"></div><script src=\"/js/portainer.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><script>window.portainer = {\"version\":\"2.19.1\"};</script><span>Portainer</span></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><div id=\"-root\"></div><script src=\"/js/.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1247"
  ]
}
