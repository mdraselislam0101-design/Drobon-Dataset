{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-029",
  "title": "Server version disclosed (X-Jenkins header)",
  "description": "The response discloses a versioned X-Jenkins header banner. Version banners let attackers aim known exploits. This check matches the banner directly.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Suppress the version (restricted Jenkins access).",
  "limitation": "Banner check: version visibility alone is not exploitability.",
  "check": {
    "type": "response-header-matches",
    "header": "X-Jenkins",
    "valuePattern": "[^ ]"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Jenkins": "2.440"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Jenkins": "2.1"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0059"
  ]
}
