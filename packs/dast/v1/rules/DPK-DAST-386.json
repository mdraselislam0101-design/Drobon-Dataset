{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-386",
  "title": "Azure Functions local.settings.json served",
  "description": "The response is a Functions local settings file: the IsEncrypted flag with its Values block. That block holds the storage connection string, the service bus keys and the application settings the function needs at runtime.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Exclude local.settings.json from the deployed tree and rotate every value it exposes.",
  "limitation": "One response body. The rule reads the file shape; it does not use the values.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*\"IsEncrypted\"\\s*:)(?=[\\s\\S]*\"Values\"\\s*:)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/local.settings.json",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\n  \"IsEncrypted\": false,\n  \"Values\": {\n    \"AzureWebJobsStorage\": \"UseDevelopmentStorage=true\",\n    \"FUNCTIONS_WORKER_RUNTIME\": \"node\"\n  }\n}\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api/local.settings.json",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"IsEncrypted\":false,\"Values\":{\"ServiceBusConnection\":\"Endpoint=sb://shop.servicebus.windows.net/;SharedAccessKeyName=send\"}}\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/appsettings.json",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"App\":{\"Name\":\"shop\"},\"Logging\":{\"LogLevel\":{\"Default\":\"Information\"}}}\n"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/deploy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Deployment guide</title></head><body><p>Set IsEncrypted to false for local runs only.</p></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1455"
  ]
}
