{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-912",
  "title": "Scrape target list exposed",
  "description": "A Prometheus target list with internal addresses appears in the response body. The list names every monitored host and port, which is a ready inventory of the internal estate for anyone who can reach the endpoint.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "exposed-interface",
  "remediation": "Restrict the targets endpoint and keep it off customer-facing hosts.",
  "limitation": "One response body, first 32,768 bytes. It matches a targets payload with scrape URLs; it cannot tell whether the value behind the marker is live or whether the page needs authentication.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "\"activeTargets\"[\\s\\S]{0,200}?\"scrapeUrl\"\\s*:\\s*\"http"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"status\":\"success\",\"data\":{\"activeTargets\":[{\"scrapeUrl\":\"http://10.24.8.19:9100/metrics\",\"health\":\"up\"}]}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"activeTargets\":[{\"scrapeUrl\":\"http://ledger.core:8080/actuator/prometheus\"}]}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"status\":\"success\",\"data\":{\"activeTargets\":[]}}"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2031"
  ]
}
