{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-164",
  "title": "Docker daemon API info disclosed",
  "description": "The response is the Docker daemon info document: DockerRootDir, ApiVersion and ServerVersion are fields of the /info endpoint. That endpoint belongs to the daemon API, which can create and run containers.",
  "severity": "HIGH",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Never expose the Docker daemon TCP socket. Bind it to a local socket, and if remote access is required put an authenticating TLS proxy in front of it with client certificates.",
  "limitation": "One response body. The rule reports the info document; it does not list a container or start one, so it does not prove that container control is possible from this position.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*\"DockerRootDir\")(?=[\\s\\S]*\"ApiVersion\")"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"ID\":\"abc\",\"Containers\":12,\"Images\":40,\"Driver\":\"overlay2\",\"DockerRootDir\":\"/var/lib/docker\",\"ServerVersion\":\"24.0.7\",\"ApiVersion\":\"1.43\",\"OperatingSystem\":\"Ubuntu 22.04\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"Containers\":3,\"DockerRootDir\":\"/var/lib/docker\",\"ApiVersion\":\"1.41\",\"ServerVersion\":\"20.10.24\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"ID\":\"abc\",\"Containers\":12,\"Images\":40,\"Driver\":\"overlay2\",:\"/var/lib/docker\",\"ServerVersion\":\"24.0.7\",:\"1.43\",\"OperatingSystem\":\"Ubuntu 22.04\"}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1233"
  ]
}
