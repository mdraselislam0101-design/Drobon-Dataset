{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-516",
  "title": "Security answer rendered into a form field",
  "description": "A knowledge-based recovery answer is rendered as an input value. The answer is a shared secret used to reset the account, so once it is readable in markup it no longer proves anything, and customers reuse the same answer across banks.",
  "severity": "MEDIUM",
  "cwe": "CWE-522",
  "category": "credential-exposure",
  "remediation": "Never render a stored security answer; ask the question and compare a hash server-side, and prefer an out-of-band recovery channel.",
  "limitation": "One response body. It matches the input name and a short literal value, not the answer's correctness.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "<input(?=[^>]{0,200}(?:name|id)\\s*=\\s*[\\\"'][^\\\"']{0,50}(?:security[ _-]?answer|secret[ _-]?answer|mothers?[ _-]?maiden)[^\\\"']{0,50}[\\\"'])(?=[^>]{0,200}value\\s*=\\s*[\\\"'][^\\\"']{2,80}[\\\"'])"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/profile/recovery",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<label>First school</label><input name=\"security_answer\" value=\"Greenfield\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/profile/recovery",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<input id=\"mothers_maiden_name\" value=\"Chowdhury\" type=\"text\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/profile/recovery",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<input name=\"security_answer\" value=\"\" type=\"text\">"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1585"
  ]
}
