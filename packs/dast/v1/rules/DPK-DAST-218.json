{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-218",
  "title": "Clockwork debug toolbar disclosed",
  "description": "The response carries the Clockwork debug toolbar: the clockwork element together with the Clockwork script object is the toolbar the Clockwork package injects. It records requests, queries and timeline data for the profiler.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Disable Clockwork outside development and confirm production responses carry no toolbar markup or profiling endpoint.",
  "limitation": "One response body. The rule reports the toolbar; it does not request a profile and cannot show what one contains.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*clockwork)(?=[\\s\\S]*Clockwork)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"clockwork\"></div><script>window.Clockwork = {version: \"5.1\"};</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div class=\"clockwork-toolbar\" data-clockwork=\"1\"><span>Clockwork</span></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"\"></div><script>window. = {version: \"5.1\"};</script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1287"
  ]
}
