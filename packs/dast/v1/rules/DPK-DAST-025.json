{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-025",
  "title": "Weak X-Frame-Options (ALLOW-FROM) header value",
  "description": "The response carries X-Frame-Options (ALLOW-FROM) with a weak or deprecated value. A weak value grants partial protection at best. This check matches the weak value directly.",
  "severity": "LOW",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Strengthen the value (frame-ancestors in CSP).",
  "limitation": "Value check: it cannot confirm the deployment context.",
  "check": {
    "type": "response-header-matches",
    "header": "X-Frame-Options",
    "valuePattern": "ALLOW-FROM"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Frame-Options": "ALLOW-FROM https://a.example/"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Frame-Options": "ALLOW-FROM https://b.example/"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Frame-Options": "DENY"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0055"
  ]
}
