{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-165",
  "title": "Cloud Storage bucket listing disclosed",
  "description": "The response is a Cloud Storage bucket listing served through the XML API: the ListBucketResult document and the storage.googleapis.com marker identify the bucket and return object keys to an anonymous caller.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Remove the allUsers storage.objects.list grant, keep the bucket private, and serve public assets through a controlled endpoint or a signed URL.",
  "limitation": "One response body. The rule reports the listing; it does not download an object and cannot show what the objects contain.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*<ListBucketResult)(?=[\\s\\S]*storage\\.googleapis\\.com)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><ListBucketResult xmlns=\"http://doc.s3.amazonaws.com/2006-03-01/\"><Name>assets-prod</Name><Contents><Key>backup.sql.gz</Key></Contents></ListBucketResult><!-- storage.googleapis.com -->"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?xml version=\"1.0\"?><ListBucketResult><Name>media</Name><Contents><Key>video.mp4</Key></Contents></ListBucketResult><!-- storage.googleapis.com/storage/v1 -->"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?> xmlns=\"http://doc.s3.amazonaws.com/2006-03-01/\"><Name>assets-prod</Name><Contents><Key>backup.sql.gz</Key></Contents></ListBucketResult><!--  -->"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1234"
  ]
}
