{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-228",
  "title": "Joomla version in generator meta tag",
  "description": "The response carries a generator meta tag naming Joomla: the meta name and the Joomla content string publish the CMS and, in many templates, its version. That identity tells a reader which extension and core issues may apply.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Remove or genericise the generator meta tag and keep core and extensions updated.",
  "limitation": "One response body. The rule reports the meta tag; it does not resolve the version against an advisory source and makes no claim that the site is vulnerable.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*name=[\"\\']generator[\"\\'])(?=[\\s\\S]*Joomla)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta name=\"generator\" content=\"Joomla! - Open Source Content Management\"><title>Site</title></head><body>Site</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><head><meta name=\"generator\" content=\"Joomla! 4.4.1\"></head><body>Home</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta  content=\"! - Open Source Content Management\"><title>Site</title></head><body>Site</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1297"
  ]
}
