{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-176",
  "title": "Nexus Repository interface disclosed",
  "description": "The response is the Sonatype Nexus Repository interface: the nexus-repository bundle and the product name identify the artefact repository manager. A repository manager serves the packages that builds consume.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Keep the repository manager on the internal network behind an authenticating proxy, require authentication for browsing, and keep the version patched.",
  "limitation": "One response body. The rule reports the Nexus shell; it does not list a repository or download an artefact.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*nexus\\-repository)(?=[\\s\\S]*Nexus\\ Repository)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Nexus Repository</title></head><body><script src=\"/static/nexus-repository.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><span>Nexus Repository</span><script src=\"/static/nexus-repository/manifest.js\"></script><script>var v = {\"version\":\"3.61.0\"};</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><script src=\"/static/.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1245"
  ]
}
