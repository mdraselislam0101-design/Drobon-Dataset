{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-022",
  "title": "Weak Content-Security-Policy (wildcard source) header value",
  "description": "The response carries Content-Security-Policy (wildcard source) with a weak or deprecated value. A weak value grants partial protection at best. This check matches the weak value directly.",
  "severity": "LOW",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Strengthen the value (explicit source lists).",
  "limitation": "Value check: it cannot confirm the deployment context.",
  "check": {
    "type": "response-header-matches",
    "header": "Content-Security-Policy",
    "valuePattern": "default-src\\s+\\*"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *; script-src 'self'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0052"
  ]
}
