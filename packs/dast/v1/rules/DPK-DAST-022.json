{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-022",
  "title": "Weak Content-Security-Policy default-src wildcard header value",
  "description": "The first default-src declaration contains the wildcard source, either a bare `*` or a scheme wildcard such as `https://*`. Every fetch directive that does not override the fallback then accepts any origin, so CSP constrains only the directives the policy names explicitly while the header still reads like a restriction.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Replace the wildcard with an explicit source list, keep `default-src 'self'` and add the hosts, schemes or nonces each directive needs. Use `'none'` for directives the page never uses.",
  "limitation": "Value check on the first default-src declaration. It cannot see the directives the policy overrides later, and it cannot read a policy delivered by a meta element.",
  "check": {
    "type": "response-header-matches",
    "header": "Content-Security-Policy",
    "valuePattern": "^(?:(?!default-src)[^;]*;\\s*)*default-src(?=\\s)[^;]*?(?<=\\s)(?:\\*|(?:https?|wss?)://\\*)(?=\\s|;|$)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self' *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'; default-src *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; default-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src https://*.example.com"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src https://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src http://*; script-src 'self'"
        }
      },
      "match": true
    }
  ],
  "patternRefs": [
    "DPK-PAT-0052"
  ]
}
