{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-121",
  "title": "Strict-Transport-Security max-age is not a valid delta-seconds value",
  "description": "The HSTS header carries a max-age directive whose value is not an unsigned decimal integer: it is empty, negative, fractional, or contains trailing characters. A user agent that cannot parse delta-seconds discards the whole header, so the site has no HSTS policy at all while its operators believe one is deployed. Quoted values are excluded here because DPK-DAST-024 already reports every quoted max-age as invalid.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "transport-security",
  "remediation": "Send max-age as a bare unsigned integer number of seconds, for example max-age=31536000. Validate the value at the framework or proxy layer so a template error cannot ship a non-numeric duration.",
  "limitation": "One header value. The rule judges the max-age syntax visible in the response; it cannot prove that a browser discarded the header, and quoted values are graded by DPK-DAST-024 instead.",
  "check": {
    "type": "response-header-matches",
    "header": "Strict-Transport-Security",
    "valuePattern": "(?:^|;)\\s*max-age\\s*(?:;|$)|(?:^|;)\\s*max-age\\s*=\\s*(?![0-9]+\\s*(?:;|$))(?!\")[^;\\s]*"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=abc"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age="
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=-1; includeSubDomains"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=300abc"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=\"300\""
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "includeSubDomains"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1190"
  ]
}
