{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-183",
  "title": "Spring Actuator health details disclosed",
  "description": "The response is the Spring Boot Actuator health document with component details: the status field and the diskSpace component show that health detail is published rather than summarised. The detail names the storage paths, database product and free capacity.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Set management.endpoint.health.show-details to never or to when-authorized, and keep the management port on the internal network rather than the application port.",
  "limitation": "One response body. The rule reports the health detail; it does not call another actuator endpoint and cannot show whether env or heapdump is exposed.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*\"status\"\\s*:\\s*\"UP\")(?=[\\s\\S]*\"diskSpace\")"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"status\":\"UP\",\"components\":{\"diskSpace\":{\"status\":\"UP\",\"details\":{\"total\":536870912000,\"free\":107374182400,\"path\":\"/var/app/.\"}},\"db\":{\"status\":\"UP\",\"details\":{\"database\":\"PostgreSQL\"}}}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"status\":\"UP\",\"components\":{\"diskSpace\":{\"status\":\"UP\",\"details\":{\"free\":10737,\"total\":53687,\"path\":\"/\"}},\"ping\":{\"status\":\"UP\"}}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{,\"components\":{:{,\"details\":{\"total\":536870912000,\"free\":107374182400,\"path\":\"/var/app/.\"}},\"db\":{,\"details\":{\"database\":\"PostgreSQL\"}}}}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1252"
  ]
}
