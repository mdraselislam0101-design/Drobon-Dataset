{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-568",
  "title": "POST form without a CSRF token",
  "description": "A form that posts and carries no anti-CSRF field appears in the response body. Without a token the endpoint accepts a request the browser sends on behalf of a logged-in user from another site, so an attacker can submit the action with the victim's session.",
  "severity": "MEDIUM",
  "cwe": "CWE-352",
  "category": "weak-markup",
  "remediation": "Add a per-session CSRF token to every state-changing form and verify it server-side.",
  "limitation": "One response body. It matches a POST form whose markup contains no csrf-shaped field, not whether the endpoint checks a header instead.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "<form\\b(?=[^>]{0,300}method\\s*=\\s*[\\\"']?post)(?=[\\s\\S]{0,1200}?<input)(?![\\s\\S]{0,1200}?csrf)[\\s\\S]{0,1200}?</form>"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<form method=\"post\" action=\"/transfer\"><input type=\"text\" name=\"iban\"><input type=\"text\" name=\"amount\"></form>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<form method='post' action='/profile/email'><input type='email' name='email'></form>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<form method=\"post\" action=\"/transfer\"><input type=\"hidden\" name=\"csrf_token\" value=\"EXAMPLE-TOKEN\"><input type=\"text\" name=\"iban\"></form>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1687"
  ]
}
