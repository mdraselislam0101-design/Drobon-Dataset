{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-468",
  "title": "SHA-1 password digest served with its password marker",
  "description": "The response pairs a password marker with a bare 40-character hexadecimal digest. Like MD5, SHA-1 is far too fast to protect a password and is cheap to attack in bulk.",
  "severity": "MEDIUM",
  "cwe": "CWE-916",
  "category": "credential-exposure",
  "remediation": "Re-hash on next login with Argon2id and remove the digest from every response.",
  "limitation": "One response body. The rule reads the marker and the digest; it does not verify the value.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*(?:password_hash|passwd_hash|pwd_hash))[\\s\\S]*?\\b[a-f0-9]{40}\\b"
  },
  "tests": [
    {
      "observation": {
        "url": "https://legacy.example/users/45",
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "{\"user\":45,\"password_hash\":\"5baa61e4c9b93f3f0682250b6cf8331b7ee68fd8\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://legacy.example/export.csv",
        "status": 200,
        "headers": {
          "Content-Type": "text/csv; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "id,password_hash\n45,7c6a180b36896a0a8c02787eeafb0e4c0b5d8e2f"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://legacy.example/help/digests",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "<html><body><h1>Digests</h1><p>SHA-1 produces a 40-character hexadecimal digest and is not used for passwords here.</p></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1537"
  ]
}
