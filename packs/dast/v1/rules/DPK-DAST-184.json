{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-184",
  "title": "Zabbix interface disclosed",
  "description": "The response is the Zabbix front end: the zabbix bundle and the product attribution identify the monitoring console. Zabbix holds host inventories, agent credentials and alerting integrations.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Keep Zabbix on an internal network behind an authenticating proxy, require authentication, and keep the front end patched.",
  "limitation": "One response body. The rule reports the Zabbix shell; it does not read a host or a trigger.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*zabbix)(?=[\\s\\S]*Zabbix)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Zabbix</title></head><body><script src=\"/js/zabbix.js\"></script><span>Zabbix SIA</span></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div id=\"zabbix-app\"></div><footer>Zabbix</footer></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><script src=\"/js/.js\"></script><span> SIA</span></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1253"
  ]
}
