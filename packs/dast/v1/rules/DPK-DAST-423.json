{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-423",
  "title": "Pipfile dependency manifest served",
  "description": "The body is a Pipfile with a packages table and at least two version pins. It plays the same role as requirements.txt and carries the same version disclosure.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Keep the Pipfile out of the published tree.",
  "limitation": "One response body. The rule matches the TOML table header and a version pin.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*\\[packages\\])[\\s\\S]*?\\n[A-Za-z0-9_.-]+\\s*=\\s*\"[=~><]{0,2}[0-9][^\"\\n]{0,20}\""
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/Pipfile",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "[packages]\ndjango = \"==3.2.5\"\nrequests = \"==2.25.1\"\n\n[dev-packages]\npytest = \"*\""
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/app/Pipfile",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "[packages]\nflask = \"==2.0.1\"\njinja2 = \"==2.11.3\""
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/docs/pipenv",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "<html><body><h1>Pipenv</h1><p>Add packages under [packages] and run pipenv lock.</p></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1492"
  ]
}
