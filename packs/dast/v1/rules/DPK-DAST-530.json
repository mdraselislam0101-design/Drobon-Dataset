{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-530",
  "title": "Inline event handler shipped in markup",
  "description": "The response body attaches JavaScript to an element through an inline event attribute such as onclick or onerror. Inline handlers require 'unsafe-inline' in the script policy, so their presence usually means the page has no effective XSS mitigation, and any injected markup can run script the same way.",
  "severity": "MEDIUM",
  "cwe": "CWE-79",
  "category": "content-injection",
  "remediation": "Move the behaviour into an external script and attach listeners with addEventListener; then remove 'unsafe-inline' from the Content-Security-Policy script-src directive.",
  "limitation": "One response body. It matches elements that carry an inline handler attribute; it cannot tell whether the handler's code is safe, only that the page depends on inline script.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "<(?:a|button|div|span|img|input|form|iframe|body|td|li)[^>]{0,200}\\son(?:click|dblclick|mouseover|focus|load|error)\\s*=\\s*[\"']"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<button class=\"cta\" onclick=\"transferFunds('42')\">Confirm</button>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/diagnostics",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<img src=\"/icons/alert.svg\" onerror=\"trackFailure(this)\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<button class=\"cta\" data-action=\"transfer\">Confirm</button>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1649"
  ]
}
