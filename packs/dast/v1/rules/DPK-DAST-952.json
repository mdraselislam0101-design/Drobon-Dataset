{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-952",
  "title": "Second factor disabled on a privileged account",
  "description": "An mfaEnabled flag set to false beside an administrative role appears in the response body. The account holds elevated rights without the second factor, so a password alone is enough to reach the back office.",
  "severity": "HIGH",
  "cwe": "CWE-306",
  "category": "information-disclosure",
  "remediation": "Enforce the second factor for privileged roles and report the state to monitoring.",
  "limitation": "One response body, first 32,768 bytes. It matches the disabled flag beside a privileged role; it cannot tell whether the value behind the marker is live or whether the page needs authentication.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "\"mfaEnabled\"\\s*:\\s*false[\\s\\S]{0,200}?\"role\"\\s*:\\s*\"(?:ADMIN|admin|SUPERUSER|BACKOFFICE)\"|\"role\"\\s*:\\s*\"(?:ADMIN|admin|SUPERUSER|BACKOFFICE)\"[\\s\\S]{0,200}?\"mfaEnabled\"\\s*:\\s*false"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"userId\":\"ops.777\",\"role\":\"ADMIN\",\"mfaEnabled\":false}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"role\": \"BACKOFFICE\", \"mfaEnabled\": false}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"userId\":\"C-8841\",\"role\":\"CUSTOMER\",\"mfaEnabled\":false}"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-2071"
  ]
}
