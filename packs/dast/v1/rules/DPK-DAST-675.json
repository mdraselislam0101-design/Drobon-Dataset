{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-675",
  "title": "Rollbar access token in a response",
  "description": "A Rollbar access token inside client configuration appears in the response body. The token lets anyone post items to the project's item feed, so an attacker can flood the queue or hide a genuine crash report among synthetic ones.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "credential-exposure",
  "remediation": "Use a scoped post-client item token minted per page load, never a project token.",
  "limitation": "One response body, first 32,768 bytes. It matches the Rollbar access token field; it cannot tell whether the value behind the marker is live or whether the page needs authentication.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "\"(?:rollbar\"[\\s\\S]{0,160}?\"accessToken\"\\s*:\\s*\"[0-9a-f]{32}\"|accessToken\"\\s*:\\s*\"[0-9a-f]{32}\"[\\s\\S]{0,160}?rollbar)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"rollbar\":{\"accessToken\":\"4c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f\",\"captureUncaught\":true}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"accessToken\": \"9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d\", \"rollbar\": {\"enabled\": true}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"rollbar\":{\"enabled\":true,\"accessToken\":\"<redacted>\"}}"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1794"
  ]
}
