{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-068",
  "title": "Referrer-Policy sends full URLs (unsafe-url)",
  "description": "The Referrer-Policy header is unsafe-url. Browsers then send the full page URL, including its query string, to every destination, which can carry tokens or identifiers to third parties.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Use strict-origin-when-cross-origin so cross-origin requests carry only the origin.",
  "limitation": "Header value check: it cannot see which URLs carry sensitive query strings.",
  "check": {
    "type": "response-header-matches",
    "header": "Referrer-Policy",
    "valuePattern": "(?:^|[,\\s])unsafe-url(?:$|[,\\s])"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "unsafe-url"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "no-referrer, unsafe-url"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "strict-origin-when-cross-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0965"
  ]
}
