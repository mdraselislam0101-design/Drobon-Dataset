{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-413",
  "title": ".htpasswd credential file served from the web root",
  "description": "The body is an .htpasswd file: one username and one hash per line. The file protects a directory, so serving it hands over the account list and the hashes that guard it.",
  "severity": "HIGH",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Deny access to dotfiles at the web server and move password files outside the document root.",
  "limitation": "One response body. The rule recognises the colon-separated user and hash lines; it does not crack the hashes.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?:^|\\n)[A-Za-z0-9._-]{2,}:(?:\\$apr1\\$|\\$2[aby]\\$|\\{SHA\\})[^\\n]{10,}"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/.htpasswd",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "admin:$apr1$example$abcdefghijklmnopqrstuv\nops:$apr1$example$zyxwvutsrqponmlkjihgfe"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/private/.htpasswd",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "rahim:{SHA}5en6G6MezRroT3XKqkdPOmY/BfQ=\nkarim:{SHA}qUqP5cyxm6YcTAhz05Hph5gvu9M="
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/docs/auth",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "<html><body><h1>Basic auth</h1><p>Create the file with htpasswd -c .htpasswd admin and keep it outside the document root.</p></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1482"
  ]
}
