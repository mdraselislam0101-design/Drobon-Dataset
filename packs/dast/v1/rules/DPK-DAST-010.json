{
 "schemaVersion": "drobon.pack.dast/v1",
 "id": "DPK-DAST-010",
 "title": "Content-Security-Policy without frame-ancestors",
 "description": "The Content-Security-Policy header is missing or carries no frame-ancestors directive, so nothing stops arbitrary sites from framing the page, which enables clickjacking against authenticated users.",
 "severity": "MEDIUM",
 "cwe": "CWE-693",
 "category": "response-headers",
 "remediation": "Add frame-ancestors 'self' (or 'none' for unframed pages) to the policy. Keep X-Frame-Options during migration for older browsers.",
 "limitation": "Directive-presence only: a present-but-permissive frame-ancestors value still passes this check. Policy strength is out of scope. A response with no Content-Security-Policy header also matches; DPK-DAST-002 reports that absence as the stronger finding.",
 "check": {
  "type": "response-header-missing-directive",
  "header": "content-security-policy",
  "directive": "frame-ancestors"
 },
 "tests": [
  {
   "observation": {
    "url": "https://example.com/",
    "status": 200,
    "headers": {
     "Content-Security-Policy": "default-src 'self'"
    }
   },
   "match": true
  },
  {
   "observation": {
    "url": "https://example.com/",
    "status": 200,
    "headers": {}
   },
   "match": true
  },
  {
   "observation": {
    "url": "https://example.com/",
    "status": 200,
    "headers": {
     "content-security-policy": "default-src 'self'; frame-ancestors 'self'"
    }
   },
   "match": false
  },
  {
   "observation": {
    "url": "https://example.com/",
    "status": 200,
    "headers": {
     "Content-Security-Policy": "default-src 'self'; report-uri https://c.example/r"
    }
   },
   "match": true
  },
  {
   "observation": {
    "url": "https://example.com/",
    "status": 200,
    "headers": {
     "Content-Security-Policy": "frame-ancestors 'self'"
    }
   },
   "match": false
  },
  {
   "observation": {
    "url": "https://app.example/",
    "status": 200,
    "headers": {
     "Content-Security-Policy": [
      "default-src 'self'",
      "script-src 'self'; frame-ancestors 'none'"
     ]
    }
   },
   "match": false
  },
  {
   "observation": {
    "url": "https://app.example/",
    "status": 200,
    "headers": {
     "Content-Security-Policy": [
      "",
      ""
     ]
    }
   },
   "match": true
  }
 ],
 "patternRefs": [
  "DPK-PAT-0010"
 ]
}
