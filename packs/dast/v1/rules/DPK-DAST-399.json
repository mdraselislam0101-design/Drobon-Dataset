{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-399",
  "title": "TensorBoard is reachable without authentication",
  "description": "The response is the TensorBoard interface. It reads the event files of a training run, so it publishes the experiment directory, the run names, the metrics and, through the text plugin, sample records of the training data.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Bind TensorBoard to the training host or put an authenticating proxy in front of it.",
  "limitation": "One response body. The rule reports the TensorBoard shell; it does not read a scalar or a text sample.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "<title>[^<]{0,60}TensorBoard"
  },
  "tests": [
    {
      "observation": {
        "url": "https://ml.example:6006/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>TensorBoard</title></head><body><script>window.tensorboard = {};</script><div id=\"root\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://ml.example:6006/#runs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>TensorBoard · runs</title></head><body><h3>Runs</h3><p>tensorboard reads /logs/exp-42</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Training guide</title></head><body><p>TensorBoard reads event files from the log directory.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/dashboard",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Dashboard</title></head><body><p>Model version 4 is live.</p></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1468"
  ]
}
