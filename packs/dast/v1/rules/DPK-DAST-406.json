{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-406",
  "title": "Nuxt DevTools overlay served",
  "description": "The response carries the Nuxt DevTools overlay. It exposes the component tree, the Nuxt configuration, the server routes and the state of every composable, and in its default configuration it is reachable from any origin that can frame the page.",
  "severity": "MEDIUM",
  "cwe": "CWE-489",
  "category": "debug-exposure",
  "remediation": "Disable DevTools in the production build (`devtools: { enabled: false }`) and rebuild.",
  "limitation": "One response body. The rule reports the overlay shell; it does not walk the component tree.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*nuxt-devtools)(?=[\\s\\S]*__NUXT_DEVTOOLS__)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"__nuxt\"></div><iframe class=\"nuxt-devtools-frame\" src=\"/_nuxt/devtools\" title=\"Nuxt DevTools\"></iframe><script>window.__NUXT_DEVTOOLS__ = 1;</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/_nuxt/devtools",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Nuxt DevTools</title><script>window.__NUXT_DEVTOOLS__ = {}</script></head><body><div class=\"nuxt-devtools-panel\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"__nuxt\"><h1>Shop</h1></div></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Nuxt guide</title></head><body><p>Disable devtools before building for production.</p></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1475"
  ]
}
