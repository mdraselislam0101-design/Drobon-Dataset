{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-170",
  "title": "Jupyter notebook server disclosed",
  "description": "The response is the Jupyter Notebook tree page: the title and the notebook_path attribute identify the server that lists notebooks and kernels. A notebook server exposes a file browser and a kernel that executes code.",
  "severity": "HIGH",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Require the server token on every interface, bind the server to loopback, and place it behind an authenticating proxy. Never expose the notebook server on an application ingress.",
  "limitation": "One response body. The rule reports the tree page; it does not attempt to start a kernel or read a notebook, and a token-protected server is indistinguishable from an open one at this layer.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*Jupyter\\ Notebook)(?=[\\s\\S]*notebook_path)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Jupyter Notebook</title></head><body><div id=\"notebook\" data-notebook_path=\"/tree\"></div><script src=\"/static/tree.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><head><title>Home Page - Jupyter Notebook</title></head><body><div data-notebook_path=\"/lab\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><div id=\"notebook\" data-=\"/tree\"></div><script src=\"/static/tree.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1239"
  ]
}
