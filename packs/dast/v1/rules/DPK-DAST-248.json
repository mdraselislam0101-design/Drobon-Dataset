{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-248",
  "title": "HashiCorp Vault UI disclosed",
  "description": "The response is the Vault web UI: the Vault name together with the seal-status panel identifies the secrets-engine console. The panel distinguishes a sealed from an unsealed instance and leads to the unseal flow.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Keep the Vault UI on the management network behind an authenticating proxy, and never expose the listener on the application ingress.",
  "limitation": "One response body. The rule reports the UI; it does not authenticate and cannot read a secret.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*Vault)(?=[\\s\\S]*Seal)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Vault</title></head><body><div id=\"vault-ui\"></div><p>Seal status</p><script src=\"/ui/vault.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h1>Vault</h1><section><h2>Seal</h2><p>Vault is sealed</p></section></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><div id=\"-ui\"></div><p> status</p><script src=\"/ui/.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1317"
  ]
}
