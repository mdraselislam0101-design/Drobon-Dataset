{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-027",
  "title": "Server version disclosed (X-AspNet-Version header)",
  "description": "The response discloses a versioned X-AspNet-Version header banner. Version banners let attackers aim known exploits. This check matches the banner directly.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Suppress the version (enableVersionHeader false).",
  "limitation": "Banner check: version visibility alone is not exploitability.",
  "check": {
    "type": "response-header-matches",
    "header": "X-AspNet-Version",
    "valuePattern": "[^ ]"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-AspNet-Version": "4.0.30319"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-AspNet-Version": "2.0.50727"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0057"
  ]
}
