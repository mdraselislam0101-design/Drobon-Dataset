{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-220",
  "title": "Drupal version in generator meta tag",
  "description": "The response carries a generator meta tag naming Drupal and its major version: the meta name and the Drupal content string together publish the release line. That line tells a reader which core issues may still apply.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Remove the generator meta tag where the site does not need it and keep core and contributed modules updated.",
  "limitation": "One response body. The rule reports the meta tag; it does not look up an advisory and makes no claim that the release is vulnerable.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*name=[\"\\']Generator[\"\\'])(?=[\\s\\S]*Drupal)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta name=\"Generator\" content=\"Drupal 10 (https://www.drupal.org)\"><title>Portal</title></head><body>Portal</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><head><meta name=\"generator\" content=\"Drupal 9 (https://www.drupal.org)\"></head><body>Home</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta  content=\" 10 (https://www..org)\"><title>Portal</title></head><body>Portal</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1289"
  ]
}
