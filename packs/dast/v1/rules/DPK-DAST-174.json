{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-174",
  "title": "Kubernetes Dashboard interface disclosed",
  "description": "The response is the Kubernetes Dashboard single-page application: its bundle names and root element appear in the markup. The dashboard is a cluster management interface, so its presence identifies an administrative console on the network.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Keep the dashboard on an internal network behind an authenticating proxy, or remove it where it is not required. Do not publish it through the same ingress as application traffic.",
  "limitation": "One response body. The rule reports the dashboard front end; it does not prove that the login can be bypassed or that a service account token is reachable.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*kubernetes\\-dashboard)(?=[\\s\\S]*Kubernetes\\ Dashboard)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Kubernetes Dashboard</title><script src=\"/dashboard/static/kubernetes-dashboard.js\"></script></head><body><app-root></app-root></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><head><title>Kubernetes Dashboard</title></head><body><div id=\"kubernetes-dashboard-root\"></div><script src=\"kubernetes-dashboard.bundle.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title><script src=\"/dashboard/static/.js\"></script></head><body><app-root></app-root></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1243"
  ]
}
