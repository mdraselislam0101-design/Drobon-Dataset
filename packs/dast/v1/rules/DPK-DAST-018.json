{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-018",
  "title": "Missing Referrer-Policy response header",
  "description": "The response carries no Referrer-Policy header. Its absence forfeits the protection the header provides. This check evaluates a normal observation and confirms the header is absent.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Emit Referrer-Policy on every response (strict-origin-when-cross-origin).",
  "limitation": "Header-name check: it cannot judge whether the header value is correct.",
  "check": {
    "type": "missing-response-header",
    "header": "Referrer-Policy"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "no-referrer"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "Referrer-Policy": "no-referrer"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0048"
  ]
}
