{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-239",
  "title": "package.json manifest served from the web root",
  "description": "The response is a package.json manifest: the name, dependencies and version fields are the manifest schema, and they pin the exact package versions the application build resolved.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Serve the built application rather than its source manifest, and keep manifests outside the document root. Where a package identity is genuinely public, publish it from the registry instead.",
  "limitation": "One response body. The rule reports the manifest; it does not look up any version against an advisory source and makes no claim that a pinned version is vulnerable.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*\"dependencies\")(?=[\\s\\S]*\"name\")"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"name\":\"shop-web\",\"version\":\"4.2.1\",\"scripts\":{\"build\":\"vite build\"},\"dependencies\":{\"express\":\"4.18.2\",\"axios\":\"0.21.1\",\"lodash\":\"4.17.19\"},\"devDependencies\":{\"vite\":\"4.5.0\"}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"name\":\"internal-api\",\"version\":\"1.3.0\",\"dependencies\":{\"jsonwebtoken\":\"8.5.1\",\"pg\":\"8.11.3\"},\"engines\":{\"node\":\">=18\"}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{:\"shop-web\",\"version\":\"4.2.1\",\"scripts\":{\"build\":\"vite build\"},:{\"express\":\"4.18.2\",\"axios\":\"0.21.1\",\"lodash\":\"4.17.19\"},\"devDependencies\":{\"vite\":\"4.5.0\"}}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1308"
  ]
}
