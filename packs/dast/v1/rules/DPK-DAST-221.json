{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-221",
  "title": "ELMAH error log disclosed",
  "description": "The response is an ELMAH error log page: the Error Log heading together with the ELMAH attribution identifies the ASP.NET error-log module. The page lists exception types and request paths, and each entry opens the full exception detail.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Restrict the elmah.axd path to administrators or remove the module from production, and purge existing log entries.",
  "limitation": "One response body. The rule reports the log index; it does not open an entry and cannot show which values an exception recorded.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*Error\\ Log\\ for)(?=[\\s\\S]*ELMAH)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>ELMAH</title></head><body><h1>Error Log for application</h1><table><tr><td>System.NullReferenceException</td><td>/Orders/Edit</td></tr></table><p>Powered by ELMAH</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h2>Error Log for shop</h2><span>ELMAH</span><ul><li>SqlException at /api/items</li></ul></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><h1> application</h1><table><tr><td>System.NullReferenceException</td><td>/Orders/Edit</td></tr></table><p>Powered by </p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1290"
  ]
}
