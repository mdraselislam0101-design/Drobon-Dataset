{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-033",
  "title": "Infrastructure banner disclosed (Via header)",
  "description": "The response discloses a Via header banner. Infrastructure banners map the stack for attackers. This check matches the banner directly.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Suppress the banner (stripped proxy headers).",
  "limitation": "Banner check: version visibility alone is not exploitability.",
  "check": {
    "type": "response-header-matches",
    "header": "Via",
    "valuePattern": "[^ ]"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Via": "1.1 proxy"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Via": "2.0 edge"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0558"
  ]
}
