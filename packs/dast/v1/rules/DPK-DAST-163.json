{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-163",
  "title": "CouchDB HTTP API root disclosed",
  "description": "The response is the CouchDB HTTP API root document: the couchdb Welcome field and the version field identify an unauthenticated CouchDB server. That API exposes databases and documents directly.",
  "severity": "HIGH",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Require the admin credentials, create named users, bind the interface to the internal network, and keep the version patched.",
  "limitation": "One response body. The rule reports the root document; it does not enumerate a database or read a document.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*\"couchdb\"\\s*:\\s*\"Welcome\")(?=[\\s\\S]*\"version\")"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"couchdb\":\"Welcome\",\"version\":\"3.3.2\",\"git_sha\":\"abc123\",\"features\":[\"access-ready\",\"partitioned\"],\"vendor\":{\"name\":\"The Apache Software Foundation\"}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"couchdb\":\"Welcome\",\"version\":\"3.2.2\",\"uuid\":\"a1b2c3\",\"features\":[\"pluggable-storage-engines\"]}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{,:\"3.3.2\",\"git_sha\":\"abc123\",\"features\":[\"access-ready\",\"partitioned\"],\"vendor\":{\"name\":\"The Apache Software Foundation\"}}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1232"
  ]
}
