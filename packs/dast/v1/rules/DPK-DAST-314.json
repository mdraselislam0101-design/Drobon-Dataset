{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-314",
  "title": "Meta tag delivers a CSP that permits inline script",
  "description": "The page declares its Content-Security-Policy in a meta tag and that policy carries unsafe-inline. The policy can neither stop an injected inline script nor be tightened with hashes later, and because it arrives in the body it is also the easiest policy to remove by an injection.",
  "severity": "MEDIUM",
  "cwe": "CWE-79",
  "category": "csp-weakness",
  "remediation": "Send the policy as a response header and remove unsafe-inline in favour of nonces or hashes.",
  "limitation": "One response body. The check reads the meta element; it does not evaluate whether other directives would still block a specific payload.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "<meta[^>]{0,400}http-equiv\\s*=\\s*[\"']?content-security-policy[^>]{0,400}content\\s*=\\s*(?:\"[^\"]{0,300}unsafe-inline|'[^']{0,300}unsafe-inline)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/app",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'; script-src 'self' 'unsafe-inline'\"></head></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/app",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<meta http-equiv='Content-Security-Policy' content=\"style-src 'unsafe-inline'\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/app",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<meta http-equiv=\"Content-Security-Policy\" content=\"script-src 'nonce-abc123'\">"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/app",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1383"
  ]
}
