{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-523",
  "title": "Authorization decision carried in a hidden field",
  "description": "The response body contains a hidden input that names a role, admin flag or privilege level. Values like this are submitted back to the server, and if the server trusts them the client chooses its own authorization.",
  "severity": "HIGH",
  "cwe": "CWE-284",
  "category": "weak-markup",
  "remediation": "Derive authorization from the server-side session and never read a client-submitted role; remove the field and re-check the endpoint that consumed it.",
  "limitation": "One response body. It matches hidden inputs whose name looks like a role or admin flag; it cannot tell whether the receiving endpoint validates the value.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "<input[^>]{0,200}type\\s*=\\s*[\"']hidden[\"'][^>]{0,200}name\\s*=\\s*[\"'](?:role|admin|is[_]?admin|privilege|user[_]?role)[\"']"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<form method=\"post\" action=\"/admin/users/42/edit\"><input type=\"hidden\" name=\"role\" value=\"analyst\"></form>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/diagnostics",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<input type=\"hidden\" name=\"is_admin\" value=\"false\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<input type=\"hidden\" name=\"csrf_token\" value=\"EXAMPLE-TOKEN-VALUE\">"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1642"
  ]
}
