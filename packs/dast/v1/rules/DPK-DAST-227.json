{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-227",
  "title": "Jenkins script console disclosed",
  "description": "The response is the Jenkins script console: the Groovy script editor and the Jenkins chrome identify the administrative page that runs arbitrary Groovy inside the controller process. The console is a remote-code-execution surface by design.",
  "severity": "HIGH",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Require authentication and an administrative role for the script console, restrict Jenkins to the internal network, and confirm that anonymous read access is disabled.",
  "limitation": "One response body. The rule reports the console page; it does not submit the form and cannot show whether the request was authorised.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*Groovy\\ script)(?=[\\s\\S]*Jenkins)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Jenkins</title></head><body><h1>Jenkins</h1><form action=\"/script\"><textarea name=\"script\">println \"hello\"</textarea><p>Groovy script</p></form></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h2>Jenkins</h2><div id=\"script-console\">Groovy script</div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><h1></h1><form action=\"/script\"><textarea name=\"script\">println \"hello\"</textarea><p></p></form></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1296"
  ]
}
