{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-665",
  "title": "Elastic APM secret token in a response",
  "description": "An APM server URL with a secret token appears in the response body. The secret token is full write access to the APM index, so leaking it lets an attacker erase or forge the transactions that prove what a request did.",
  "severity": "HIGH",
  "cwe": "CWE-200",
  "category": "credential-exposure",
  "remediation": "Keep the secret token on the APM agent running server-side only.",
  "limitation": "One response body, first 32,768 bytes. It matches the APM server address with a secret token; it cannot tell whether the value behind the marker is live or whether the page needs authentication.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "apm-server[\\s\\S]{0,160}?secret_token|secret_token[\\s\\S]{0,160}?apm-server"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"apm\":{\"serverUrl\":\"http://apm-server.monitoring:8200\",\"secret_token\":\"c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6\"}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"secret_token\":\"00112233445566778899aabbccddeeff\",\"serverUrl\":\"https://apm-server.monitoring:8200\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"apm\":{\"enabled\":false}}"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1784"
  ]
}
