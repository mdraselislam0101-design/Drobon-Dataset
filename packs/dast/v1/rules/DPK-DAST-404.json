{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-404",
  "title": "Flask Debug Toolbar disclosed",
  "description": "The response carries the Flask Debug Toolbar: its flDebug container with the flt- panel markers. The panels list the SQL statements, the request variables, the configuration and the template variables of the request.",
  "severity": "MEDIUM",
  "cwe": "CWE-215",
  "category": "debug-exposure",
  "remediation": "Disable the toolbar outside development and keep its configuration out of the deployed settings.",
  "limitation": "One response body. The rule reports the toolbar container; it does not open a panel.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*flDebug)(?=[\\s\\S]*flt-)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/invoices",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Invoices</h1><div id=\"flDebug\" class=\"debug-toolbar\"><span id=\"flt-sql\"></span><span id=\"flt-config\"></span></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/search",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<div id=\"flDebug\"><div id=\"flt-sql-panel\"><pre>SELECT id FROM items LIMIT 20</pre></div></div>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/invoices",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Invoices</h1><p>No open invoices.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Flask guide</title></head><body><p>The toolbar is enabled only when DEBUG is true.</p></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1473"
  ]
}
