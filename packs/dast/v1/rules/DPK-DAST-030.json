{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-030",
  "title": "Server version disclosed (Server header)",
  "description": "The response discloses a versioned Server header banner. Version banners let attackers aim known exploits. This check matches the banner directly.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Suppress the version (ServerTokens Prod).",
  "limitation": "Banner check: version visibility alone is not exploitability.",
  "check": {
    "type": "response-header-matches",
    "header": "Server",
    "valuePattern": "[0-9]+\\.[0-9]+"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "Apache/2.4.58"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "nginx/1.25.3"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0060"
  ]
}
