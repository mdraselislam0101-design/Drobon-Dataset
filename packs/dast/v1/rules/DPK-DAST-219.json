{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-219",
  "title": "Docker client configuration served",
  "description": "The response is a Docker client configuration file: the auths object keyed by registry URLs holds base64 user:password pairs for each registry. It is the file the Docker CLI reads from its configuration directory.",
  "severity": "HIGH",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Remove the file from the web root, revoke the registry credentials it holds, and issue per-host tokens through a credential helper instead of a configuration file.",
  "limitation": "One response body. The rule reports the configuration shape; it does not decode the auth values and cannot tell which registries are writable.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*\"auths\"\\s*:)(?=[\\s\\S]*\"auth\"\\s*:)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"auths\":{\"https://index.docker.io/v1/\":{\"auth\":\"dXNlcjpwYXNzd29yZA==\",\"email\":\"ops@example.com\"}},\"credsStore\":\"desktop\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"auths\":{\"registry.example.com\":{\"auth\":\"c2VydmljZTp0b2tlbg==\"}},\"HttpHeaders\":{\"User-Agent\":\"Docker-Client/24.0.7\"}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{{\"https://index.docker.io/v1/\":{\"dXNlcjpwYXNzd29yZA==\",\"email\":\"ops@example.com\"}},\"credsStore\":\"desktop\"}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1288"
  ]
}
