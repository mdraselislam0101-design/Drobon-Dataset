{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-032",
  "title": "Infrastructure banner disclosed (P3P header)",
  "description": "The response discloses a P3P header banner. Infrastructure banners map the stack for attackers. This check matches the banner directly.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Suppress the banner (removed legacy headers).",
  "limitation": "Banner check: version visibility alone is not exploitability.",
  "check": {
    "type": "response-header-matches",
    "header": "P3P",
    "valuePattern": "[^ ]"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "P3P": "CP=\"NOI\""
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "P3P": "CP=\"IDC\""
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0557"
  ]
}
