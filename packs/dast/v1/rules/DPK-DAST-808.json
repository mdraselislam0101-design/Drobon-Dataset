{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-808",
  "title": "Environment dump returned in a response",
  "description": "An environment listing with database URLs and secrets appears in the response body. The environment carries database URLs, API keys and feature switches for the whole process, so a dump is usually the shortest path from a web bug to production access.",
  "severity": "CRITICAL",
  "cwe": "CWE-200",
  "category": "credential-exposure",
  "remediation": "Never serialise the environment; expose a curated settings list with secrets removed.",
  "limitation": "One response body, first 32,768 bytes. It matches several secret-bearing environment assignments in one body; it cannot tell whether the value behind the marker is live or whether the page needs authentication.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?:DATABASE_URL|SESSION_SECRET|DB_PASSWORD|API_KEY)=[^\\s&\\\"']{4,80}|(?:DATABASE_URL|SESSION_SECRET|DB_PASSWORD)\\\"\\s*:\\s*\\\"[^\\\"]{4,80}\\\""
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"env\":{\"NODE_ENV\":\"production\",\"DATABASE_URL\":\"postgres://app:SYNTH3T1C@db:5432/core\",\"REDIS_URL\":\"redis://cache:6379\"}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "NODE_ENV=production SESSION_SECRET=SYNTH3T1C VALUE"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"env\":{\"NODE_ENV\":\"production\",\"secrets\":\"managed\"}}"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1927"
  ]
}
