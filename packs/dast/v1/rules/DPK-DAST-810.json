{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-810",
  "title": "Identity token claims disclosed with internal roles",
  "description": "A decoded identity token whose claims include internal group or role names appears in the response body. The claims name the identity groups a workforce account belongs to, which is the authorisation map an attacker uses to choose a target account.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Project only the claims the client needs and keep group membership server-side.",
  "limitation": "One response body, first 32,768 bytes. It matches the identity token with a role or group claim; it cannot tell whether the value behind the marker is live or whether the page needs authentication.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "\"(?:idToken|id_token)\"\\s*:\\s*\"[A-Za-z0-9._-]{20,}\"[\\s\\S]{0,200}?\"(?:groups|roles)\"|\"(?:groups|roles)\"\\s*:\\s*\\[[\\s\\S]{0,120}?\"(?:bank_admins|core_ops|ledger_write)\""
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"idToken\":\"eyJhbGciOiJSUzI1NiJ9.eyJzdWIiOiI4ODQxIn0.c2ln\",\"claims\":{\"groups\":[\"bank_admins\",\"ledger_write\"]}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"claims\":{\"roles\":[\"core_ops\",\"kyc_reviewer\"]},\"id_token\":\"eyJhbGciOiJSUzI1NiJ9.e30.c2ln\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"claims\":{\"sub\":\"8841\",\"aud\":\"portal\"}}"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1929"
  ]
}
