{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-414",
  "title": "kubeconfig file served with its client key",
  "description": "The body is a kubeconfig with a cluster entry and client certificate data. It authenticates to the cluster as the identity embedded in the certificate.",
  "severity": "CRITICAL",
  "cwe": "CWE-798",
  "category": "credential-exposure",
  "remediation": "Keep kubeconfig out of the web root, rotate the client certificate and use short-lived tokens.",
  "limitation": "One response body. The rule matches the kubeconfig keys; it does not contact the cluster.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*clusters:)(?=[\\s\\S]*users:)(?=[\\s\\S]*client-certificate-data)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://ops.example/kubeconfig",
        "status": 200,
        "headers": {
          "Content-Type": "text/yaml; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "apiVersion: v1\nkind: Config\nclusters:\n- name: prod\n  cluster:\n    server: https://k8s.example:6443\nusers:\n- name: admin\n  user:\n    client-certificate-data: ZXhhbXBsZS1jZXJ0\n    client-key-data: ZXhhbXBsZS1rZXk="
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://ops.example/.kube/config",
        "status": 200,
        "headers": {
          "Content-Type": "text/yaml; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "clusters:\n- cluster:\n    server: https://k8s.example\nusers:\n- user:\n    client-certificate-data: ZXhhbXBsZQ=="
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://ops.example/docs/kube",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "<html><body><h1>kubeconfig</h1><p>The file lists clusters and users. client-certificate-data holds the certificate in base64.</p></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1483"
  ]
}
