{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-396",
  "title": "Quarkus Dev UI served",
  "description": "The response is the Quarkus Dev UI. It lists the extensions on the classpath, the configuration properties with their values and the dev services the application started, including the databases it provisioned.",
  "severity": "MEDIUM",
  "cwe": "CWE-489",
  "category": "debug-exposure",
  "remediation": "Run the production build (`quarkus.package.type` set and dev mode off) and never expose the dev-mode port.",
  "limitation": "One response body. The rule reports the Dev UI shell; it does not read a configuration page.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*/q/dev)(?=[\\s\\S]*quarkus)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/q/dev-ui/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Dev UI</title></head><body><div id=\"quarkus-devui\"></div><a href=\"/q/dev-ui/extensions\">Extensions</a></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/q/dev-ui/configuration-form",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Configuration</h1><p>quarkus.datasource.jdbc.url=jdbc:postgresql://db.internal:5432/app</p><a href=\"/q/dev-ui/io.quarkus.quarkus-datasource\">datasource</a></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api/items",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Items</h1></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Framework guide</title></head><body><p>Development-mode extensions are listed under the dev UI.</p></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1465"
  ]
}
