{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-023",
  "title": "Weak HSTS preload directive header value",
  "description": "The response carries HSTS preload directive with a weak or deprecated value. A weak value grants partial protection at best. This check matches the weak value directly.",
  "severity": "LOW",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Strengthen the value (preload with list submission).",
  "limitation": "Value check: it cannot confirm the deployment context.",
  "check": {
    "type": "response-header-missing-directive",
    "header": "Strict-Transport-Security",
    "directive": "preload"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000; preload"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=1; preload"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0053"
  ]
}
