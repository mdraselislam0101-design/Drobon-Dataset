{
 "schemaVersion": "drobon.pack.dast/v1",
 "id": "DPK-DAST-002",
 "title": "Content-Security-Policy header missing",
 "description": "The observed response carries no Content-Security-Policy header, so the browser has no allowlist for scripts, frames, or connections. A single injection flaw then runs with full page privileges.",
 "severity": "MEDIUM",
 "cwe": "CWE-693",
 "category": "response-headers",
 "remediation": "Send a Content-Security-Policy header with a tight allowlist (default-src 'self' at minimum) and verify in report-only mode first.",
 "limitation": "Presence-only: a present-but-permissive policy (e.g. unsafe-inline everywhere) still passes this check. Policy strength is out of scope.",
 "check": {
  "type": "missing-response-header",
  "header": "content-security-policy"
 },
 "tests": [
  {
   "observation": {
    "url": "https://example.com/",
    "status": 200,
    "headers": {
     "server": "example"
    }
   },
   "match": true
  },
  {
   "observation": {
    "url": "https://example.com/",
    "status": 200,
    "headers": {
     "Content-Security-Policy": "default-src 'self'"
    }
   },
   "match": false
  },
  {
   "observation": {
    "url": "https://example.com/",
    "status": 200,
    "headers": {
     "Content-Security-Policy-Report-Only": "default-src 'self'"
    }
   },
   "match": true
  },
  {
   "observation": {
    "url": "https://example.com/",
    "status": 200,
    "headers": {
     "content-security-policy": "script-src 'self'"
    }
   },
   "match": false
  },
  {
   "observation": {
    "url": "https://app.example/",
    "status": 200,
    "headers": {
     "Content-Security-Policy": [
      "",
      "default-src 'self'"
     ]
    }
   },
   "match": false
  },
  {
   "observation": {
    "url": "https://app.example/",
    "status": 200,
    "headers": {
     "Content-Security-Policy": [
      "",
      "  "
     ]
    }
   },
   "match": true
  }
 ],
 "patternRefs": [
  "DPK-PAT-0002"
 ]
}
