{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-017",
  "title": "Missing Permissions-Policy response header",
  "description": "The response carries no Permissions-Policy header. Its absence forfeits the protection the header provides. This check evaluates a normal observation and confirms the header is absent.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Emit Permissions-Policy on every response (camera=(), microphone=()).",
  "limitation": "Header-name check: it cannot judge whether the header value is correct.",
  "check": {
    "type": "missing-response-header",
    "header": "Permissions-Policy"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "camera=()"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "Permissions-Policy": "camera=()"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0047"
  ]
}
