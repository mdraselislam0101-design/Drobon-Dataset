{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-042",
  "title": "Missing Origin-Agent-Cluster header response header",
  "description": "The response carries no Origin-Agent-Cluster header header. Its absence forfeits the protection the header provides. This check evaluates a normal observation and confirms the header is absent.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Emit Origin-Agent-Cluster header on every response (?1).",
  "limitation": "Header-name check: it cannot judge whether the header value is correct.",
  "check": {
    "type": "missing-response-header",
    "header": "Origin-Agent-Cluster"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Origin-Agent-Cluster": "?1"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "Origin-Agent-Cluster": "?1"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0567"
  ]
}
