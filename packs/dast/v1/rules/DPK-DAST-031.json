{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-031",
  "title": "Server version disclosed (X-Powered-By header)",
  "description": "The response discloses a versioned X-Powered-By header banner. Version banners let attackers aim known exploits. This check matches the banner directly.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Suppress the version (expose_php Off or header removal).",
  "limitation": "Banner check: version visibility alone is not exploitability.",
  "check": {
    "type": "response-header-matches",
    "header": "X-Powered-By",
    "valuePattern": "[^ ]"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Powered-By": "PHP/8.2.1"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Powered-By": "Express"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0061"
  ]
}
