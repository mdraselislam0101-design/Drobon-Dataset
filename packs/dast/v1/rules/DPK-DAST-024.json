{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-024",
  "title": "Weak Strict-Transport-Security max-age header value",
  "description": "The response carries Strict-Transport-Security max-age with a weak or deprecated value. A weak value grants partial protection at best. This check matches the weak value directly.",
  "severity": "LOW",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Strengthen the value (max-age=31536000).",
  "limitation": "Value check: it cannot confirm the deployment context.",
  "check": {
    "type": "response-header-matches",
    "header": "Strict-Transport-Security",
    "valuePattern": "max-age\\s*=\\s*[0-9]{1,7}\\b"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=86400"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=1000; includeSubDomains"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0054"
  ]
}
