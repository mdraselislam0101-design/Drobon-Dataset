{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-050",
  "title": "Weak response control (protocol-relative Location)",
  "description": "The response weakens a control: protocol-relative Location. Protocol-relative redirects, wildcard timing origins, and charset-less content types widen attacks. This check matches the weakness directly.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Strengthen the control (absolute https URLs).",
  "limitation": "Header check: it cannot confirm exploitability.",
  "check": {
    "type": "response-header-matches",
    "header": "Location",
    "valuePattern": "^//"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 302,
        "headers": {
          "Location": "//evil.example/x"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 301,
        "headers": {
          "Location": "//cdn.example/x"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 302,
        "headers": {
          "Location": "https://app.example/x"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0575"
  ]
}
