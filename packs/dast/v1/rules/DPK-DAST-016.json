{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-016",
  "title": "Missing Strict-Transport-Security response header",
  "description": "The response carries no Strict-Transport-Security header. Its absence forfeits the protection the header provides. This check evaluates a normal observation and confirms the header is absent.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Emit Strict-Transport-Security on every response (max-age=31536000; includeSubDomains).",
  "limitation": "Header-name check: it cannot judge whether the header value is correct.",
  "check": {
    "type": "missing-response-header",
    "header": "Strict-Transport-Security"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "Strict-Transport-Security": "max-age=1"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0046"
  ]
}
