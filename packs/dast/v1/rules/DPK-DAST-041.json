{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-041",
  "title": "Missing NEL header response header",
  "description": "The response carries no NEL header header. Its absence forfeits the protection the header provides. This check evaluates a normal observation and confirms the header is absent.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Emit NEL header on every response (a report-to group).",
  "limitation": "Header-name check: it cannot judge whether the header value is correct.",
  "check": {
    "type": "missing-response-header",
    "header": "NEL"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "NEL": "{\"report_to\":\"x\"}"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "NEL": "{\"report_to\":\"x\"}"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0566"
  ]
}
