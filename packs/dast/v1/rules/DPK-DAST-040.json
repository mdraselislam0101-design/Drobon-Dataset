{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-040",
  "title": "Missing Expect-CT header response header",
  "description": "The response carries no Expect-CT header header. Its absence forfeits the protection the header provides. This check evaluates a normal observation and confirms the header is absent.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Emit Expect-CT header on every response (enforce with report-uri).",
  "limitation": "Header-name check: it cannot judge whether the header value is correct.",
  "check": {
    "type": "missing-response-header",
    "header": "Expect-CT"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Expect-CT": "enforce, max-age=86400"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "Expect-CT": "enforce, max-age=1"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0565"
  ]
}
