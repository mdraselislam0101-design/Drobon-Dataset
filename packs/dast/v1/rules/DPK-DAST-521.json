{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-521",
  "title": "Link that turns on debug output",
  "description": "The response body contains a link whose query string sets a debug flag. Debug modes commonly add stack traces, timing data, SQL and configuration to the response, and a link makes the mode one click away for anyone who can see the page.",
  "severity": "MEDIUM",
  "cwe": "CWE-489",
  "category": "debug-exposure",
  "remediation": "Remove debug switches from production builds, gate diagnostics behind server-side authorisation and delete the generated links.",
  "limitation": "One response body. It matches a link carrying a debug=1/true/yes/on parameter, not whether the parameter is honoured.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "href\\s*=\\s*[\"'][^\"']{0,120}[?&]debug=(?:1|true|yes|on)\\b"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<a href=\"/reports/statement?id=88&debug=true\">Troubleshoot this report</a>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/diagnostics",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<a href=\"/portal/settings?debug=1\">Settings (diagnostics)</a>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<a href=\"/help/troubleshooting\">Troubleshooting guide</a>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1640"
  ]
}
