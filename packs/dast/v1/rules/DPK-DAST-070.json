{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-070",
  "title": "Weak Content-Security-Policy script-src wildcard header value",
  "description": "The response carries Content-Security-Policy script-src wildcard, which lets any host supply script. A wildcard script source lets an injected script run, because the policy does not block it. This check matches the wildcard directly.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Immediate: replace `*` in `script-src` with the exact script origins, or move to nonces or hashes with `'strict-dynamic'` where the markup allows. Durable: generate the source list from the assets the application actually serves, and keep `default-src` restrictive so an omitted directive cannot fall back to a wildcard. Trade-off: third-party widgets need explicit origins, and narrowing will break any that relied on the wildcard.",
  "limitation": "Value check: a host wildcard such as *.example.com is out of scope. It cannot confirm the deployment context.",
  "check": {
    "type": "response-header-matches",
    "header": "Content-Security-Policy",
    "valuePattern": "^(?:(?!script-src(?=[\\s;]|$))[^;]*;\\s*)*script-src(?=[\\s;]|$)[^;]*?(?<=\\s)(?:\\*|(?:https?|wss?)://\\*)(?=\\s|;|$)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self' * 'unsafe-inline'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; script-src *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'; script-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src https://*.cdn.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *; script-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src https://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src http://* 'self'"
        }
      },
      "match": true
    }
  ],
  "patternRefs": [
    "DPK-PAT-0971"
  ]
}
