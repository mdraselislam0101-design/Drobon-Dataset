{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-098",
  "title": "Content-Security-Policy base-uri allows every origin",
  "description": "The policy permits any origin as the document base URL (base-uri * or a scheme wildcard). An injected base element then rewrites every relative script, style, form and link target to another origin, which defeats the relative-URL assumptions the rest of the policy depends on. The directive is read from its first declaration only, because later duplicates are ignored by browsers.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "csp-weakness",
  "remediation": "Set base-uri 'none' unless the application genuinely needs a base element, in which case set base-uri 'self'. Do not rely on default-src: base-uri has no fallback.",
  "limitation": "One header value, first declaration of the directive only. It reports the wildcard permission, not whether a base element can actually be injected into any page.",
  "check": {
    "type": "response-header-matches",
    "header": "Content-Security-Policy",
    "valuePattern": "^(?:(?!base-uri(?=[\\s;]|$))[^;]*;\\s*)*base-uri(?=[\\s;]|$)[^;]*?(?<=\\s)(?:\\*|(?:https?|wss?)://\\*)(?=\\s|;|$)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "base-uri *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; base-uri 'self' *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "base-uri https://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "base-uri 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "base-uri 'none'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "base-uri 'self'; base-uri *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1167"
  ]
}
