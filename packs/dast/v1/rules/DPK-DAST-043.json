{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-043",
  "title": "Missing Report-To header response header",
  "description": "The response carries no Report-To header header. Its absence forfeits the protection the header provides. This check evaluates a normal observation and confirms the header is absent.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Emit Report-To header on every response (an endpoint group).",
  "limitation": "Header-name check: it cannot judge whether the header value is correct.",
  "check": {
    "type": "missing-response-header",
    "header": "Report-To"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Report-To": "{\"group\":\"x\"}"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "Report-To": "{\"group\":\"x\"}"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0568"
  ]
}
