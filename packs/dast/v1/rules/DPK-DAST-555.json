{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-555",
  "title": "Azure blob SAS URL in a response",
  "description": "A blob storage URL that carries a shared-access signature appears in the response body. The signature authorises whoever holds it to read, write or delete the blob until it expires, and it travels in history, logs and Referer headers exactly like any other URL.",
  "severity": "HIGH",
  "cwe": "CWE-200",
  "category": "data-exposure",
  "remediation": "Issue short-lived, least-privilege SAS tokens server-side per request and never embed them in a page that outlives the operation.",
  "limitation": "One response body. It matches the signature parameters, not the token's expiry or permissions.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "\\.blob\\.core\\.windows\\.net/[^\\s\\\"'<>]{0,200}[?&](?:sig|se|sp)="
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "href=\"https://bankstatements.blob.core.windows.net/2026/statement.pdf?sv=2024-05-04&sig=EXAMPLE\""
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"url\":\"https://docs.blob.core.windows.net/kyc/scan.pdf?sp=r&se=2026-10-23&sig=EXAMPLE2\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<a href=\"/statements/2026-09.pdf\">September statement</a>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1674"
  ]
}
