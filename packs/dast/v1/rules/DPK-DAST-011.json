{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-011",
  "title": "Wildcard CORS (Access-Control-Allow-Origin *)",
  "description": "The response allows every origin: Access-Control-Allow-Origin *. Any site can read the response. This check matches the wildcard directly.",
  "severity": "MEDIUM",
  "cwe": "CWE-942",
  "category": "cors",
  "remediation": "Allowlist origins (an explicit origin list).",
  "limitation": "Header check: it cannot confirm which callers are legitimate.",
  "check": {
    "type": "response-header-matches",
    "header": "Access-Control-Allow-Origin",
    "valuePattern": "^\\*$"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://app.example/"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0041"
  ]
}
