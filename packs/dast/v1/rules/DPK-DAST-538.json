{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-538",
  "title": "Nominee or next-of-kin details in a response",
  "description": "A nominee block naming a person together with a relation or date of birth appears in the response body. That combination identifies a third party who never consented to the disclosure, and it is enough to answer knowledge-based identity questions about the account holder.",
  "severity": "HIGH",
  "cwe": "CWE-359",
  "category": "privacy-exposure",
  "remediation": "Return only the masked nominee name to the authenticated owner, keep relation and date of birth server-side and log the access.",
  "limitation": "One response body. It matches a nominee-style block followed by person fields within 120 characters, not whether the fields were masked elsewhere.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "\\b(?:[Nn]ominee|next[_ -]?of[_ -]?kin|[Ll]egal[_ -]?heir)\\b[\\s\\S]{0,120}?\\b(?:name|relation|dob|date[_ -]?of[_ -]?birth)\\b"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<dl><dt>Nominee</dt><dd>name: R. Ahmed, relation: spouse, dob: 1984-06-12</dd></dl>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"beneficiary\":{\"nominee\":\"S. Khatun\",\"relation\":\"daughter\"}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<dl><dt>Nominee</dt><dd>Registered. Contact the branch to change it.</dd></dl>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1657"
  ]
}
