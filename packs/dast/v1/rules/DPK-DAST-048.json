{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-048",
  "title": "Weak response control (CSP without frame-ancestors)",
  "description": "The response weakens a control: CSP without frame-ancestors. Protocol-relative redirects, wildcard timing origins, and charset-less content types widen attacks. This check matches the weakness directly.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Strengthen the control (frame-ancestors 'none').",
  "limitation": "Header check: it cannot confirm exploitability.",
  "check": {
    "type": "response-header-missing-directive",
    "header": "Content-Security-Policy",
    "directive": "frame-ancestors"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; frame-ancestors 'none'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors 'self'"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0573"
  ]
}
