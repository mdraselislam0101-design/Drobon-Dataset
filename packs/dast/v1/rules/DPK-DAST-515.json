{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-515",
  "title": "Card PIN value served in a response",
  "description": "A response gives a card PIN together with a card or account marker. PIN mailers exist precisely because the PIN must travel outside the banking session; a PIN in an HTTP payload is readable by anyone who can see the response and cannot be rotated without reissuing the card.",
  "severity": "HIGH",
  "cwe": "CWE-522",
  "category": "credential-exposure",
  "remediation": "Deliver or reset the PIN only through an approved out-of-band channel (printed mailer, ATM, IVR) and never include it in a response payload or a notification.",
  "limitation": "One response body. It requires a card or ATM marker in the same payload as the PIN field.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]{0,1500}(?:debit card|credit card|atm|cardholder|card))[\\s\\S]{0,1500}?\\bpin\\b[\\\"']?\\s*[:=]\\s*[\\\"']?[0-9]{4,6}\\b"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/api/cards/8842/pin",
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"card\":\"**** 4242\",\"pin\":\"4917\",\"channel\":\"branch\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/cards/issues",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<p>Debit card issued.</p><p>PIN: 550218</p>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/pin",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<h2>Debit card PIN</h2><p>Change your PIN at any ATM using the card and your current PIN.</p>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1584"
  ]
}
