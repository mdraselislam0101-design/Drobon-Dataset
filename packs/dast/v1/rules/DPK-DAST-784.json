{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-784",
  "title": "Environment file served from the web root",
  "description": "A dotenv file with application keys and database credentials appears in the response body. The file holds the application key and database password in clear text, which is usually enough to forge sessions and read the database directly.",
  "severity": "CRITICAL",
  "cwe": "CWE-538",
  "category": "exposed-interface",
  "remediation": "Serve the file from outside the document root and rotate every secret it contained.",
  "limitation": "One response body, first 32,768 bytes. It matches dotenv keys for the application and the database; it cannot tell whether the value behind the marker is live or whether the page needs authentication.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "APP_KEY=[A-Za-z0-9+/=]{16,}|DB_PASSWORD=[^\\s\\\"']{4,}"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"path\":\"/.env\",\"body\":\"APP_KEY=base64:U1lOVEgzVElDQUNDRVNTS0VZMTIzNDU2Nzg5MA==\\nDB_PASSWORD=SYNTH3T1C\\nDB_HOST=10.24.8.19\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"path\":\"/config/.env.production\",\"body\":\"DB_PASSWORD=hunter2SYNTH3T1CVALUE\\nAPP_ENV=production\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"path\":\"/docs/env\",\"body\":\"Set APP_KEY and DB_PASSWORD in the platform secret store.\"}"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1903"
  ]
}
