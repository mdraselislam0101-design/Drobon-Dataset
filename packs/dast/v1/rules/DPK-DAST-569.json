{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-569",
  "title": "KYC document reference in a response",
  "description": "A KYC block with a document reference value appears in the response body. The reference ties a real identity document to the account, and with the document type it is enough to impersonate the customer at a branch or in a call centre.",
  "severity": "HIGH",
  "cwe": "CWE-359",
  "category": "privacy-exposure",
  "remediation": "Return only a masked reference and the verification status, and keep the full number in the encrypted KYC store.",
  "limitation": "One response body. It matches the KYC wording and a document reference value, not the document image.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "\\b(?:kyc|know[_ ]?your[_ ]?customer)\\b[\\s\\S]{0,100}?\\b(?:document|doc|reference|ref)\\b[\\s\\S]{0,24}?[A-Z0-9][A-Z0-9-]{5,}"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<dl><dt>KYC status</dt><dd>Verified &middot; document: B1234567</dd></dl>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"kyc\":{\"doc\":\"NID-9931-4471\",\"state\":\"verified\"}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<dl><dt>KYC status</dt><dd>Verified</dd></dl>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1688"
  ]
}
