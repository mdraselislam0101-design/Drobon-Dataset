{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-529",
  "title": "Bearer token written to browser storage",
  "description": "The response body contains script that stores an access token, refresh token or JWT in localStorage or sessionStorage. Web storage is readable by any script on the origin, so one cross-site scripting bug hands over the token and, with a refresh token, the session beyond it.",
  "severity": "MEDIUM",
  "cwe": "CWE-522",
  "category": "credential-exposure",
  "remediation": "Keep refresh tokens in HttpOnly, Secure, SameSite cookies and hold access tokens in memory; never write credentials to localStorage or sessionStorage.",
  "limitation": "One response body. It matches the storage call and the credential-shaped key name, not the token value or whether the script actually runs.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?:localStorage|sessionStorage)\\.setItem\\(\\s*[\"'](?:token|jwt|access_token|refresh_token|id_token|auth)[\"']"
  },
  "tests": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<script>localStorage.setItem(\"token\", \"short\");</script>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/diagnostics",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "sessionStorage.setItem('refresh_token', 'x');"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<script>localStorage.setItem(\"theme\", \"dark\");</script>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1648"
  ]
}
