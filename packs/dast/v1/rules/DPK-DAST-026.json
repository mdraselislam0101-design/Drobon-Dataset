{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-026",
  "title": "Dangerous HTTP method allowed",
  "description": "The Allow response lists a dangerous method. PUT, DELETE, TRACE, and CONNECT widen what anonymous clients can do. This check matches the method name directly.",
  "severity": "MEDIUM",
  "cwe": "CWE-749",
  "category": "http-methods",
  "remediation": "Disable unneeded methods (GET, POST only).",
  "limitation": "Header check: it cannot exercise the method.",
  "check": {
    "type": "response-header-matches",
    "header": "Allow",
    "valuePattern": "\\b(?:PUT|DELETE|TRACE|CONNECT)\\b"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Allow": "GET, PUT"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Allow": "GET, HEAD, OPTIONS, TRACE"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Allow": "GET, POST"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0056"
  ]
}
