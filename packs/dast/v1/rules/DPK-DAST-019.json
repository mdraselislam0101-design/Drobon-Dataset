{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-019",
  "title": "Missing X-Content-Type-Options response header",
  "description": "The response carries no X-Content-Type-Options header. Its absence forfeits the protection the header provides. This check evaluates a normal observation and confirms the header is absent.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Emit X-Content-Type-Options on every response (nosniff).",
  "limitation": "Header-name check: it cannot judge whether the header value is correct.",
  "check": {
    "type": "missing-response-header",
    "header": "X-Content-Type-Options"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Content-Type-Options": "nosniff"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "X-Content-Type-Options": "nosniff"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0049"
  ]
}
