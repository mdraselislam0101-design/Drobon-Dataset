{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-046",
  "title": "Weak response control (COEP without require-corp)",
  "description": "The response weakens a control: COEP without require-corp. Protocol-relative redirects, wildcard timing origins, and charset-less content types widen attacks. This check matches the weakness directly.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Strengthen the control (require-corp).",
  "limitation": "Header check: it cannot confirm exploitability.",
  "check": {
    "type": "response-header-missing-directive",
    "header": "Cross-Origin-Embedder-Policy",
    "directive": "require-corp"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "unsafe-none"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "require-corp"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "require-corp"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0571"
  ]
}
