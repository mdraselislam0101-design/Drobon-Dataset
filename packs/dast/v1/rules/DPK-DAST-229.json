{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-229",
  "title": "Keycloak administration console disclosed",
  "description": "The response is the Keycloak administration console: the Keycloak name together with the Administration view identifies the identity-provider admin UI. That console manages realms, clients and user credentials.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Restrict the admin console to the management network, require strong administrator credentials with MFA, and disable the temporary admin account after realm setup.",
  "limitation": "One response body. The rule reports the console page; it does not attempt a login and cannot show which realms exist.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*Keycloak)(?=[\\s\\S]*Administration)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Keycloak Administration Console</title></head><body><div id=\"kc-admin\"></div><h1>Administration</h1><script src=\"/resources/keycloak.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><span>Keycloak</span><nav>Administration</nav><div id=\"admin-console\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>  Console</title></head><body><div id=\"kc-admin\"></div><h1></h1><script src=\"/resources/.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1298"
  ]
}
