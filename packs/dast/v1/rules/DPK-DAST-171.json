{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-171",
  "title": "Kibana interface disclosed",
  "description": "The response is the Kibana front end: the kbn-injected-metadata element and the Kibana bundle are the markers of the Elastic search and analytics console. That console sits in front of the cluster indices.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Keep Kibana on an internal network behind an authenticating proxy and disable anonymous access. Do not publish it through the application ingress.",
  "limitation": "One response body. The rule reports the Kibana shell; it does not query an index and cannot show that documents are readable.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*kbn\\-injected\\-metadata)(?=[\\s\\S]*kibana)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Kibana</title></head><body><kbn-injected-metadata data=\"{\"version\":\"8.11.0\"}\"></kbn-injected-metadata><script src=\"/bundles/kibana.bundle.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><kbn-injected-metadata></kbn-injected-metadata><script src=\"kibana.bundle.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body>< data=\"{\"version\":\"8.11.0\"}\"></><script src=\"/bundles/.bundle.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1240"
  ]
}
