{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-061",
  "title": "Weak Content-Security-Policy (unsafe-eval)",
  "description": "The Content-Security-Policy header allows string-to-code evaluation through the 'unsafe-eval' source expression. Injected text can then call eval-style APIs even when inline scripts are blocked.",
  "severity": "LOW",
  "cwe": "CWE-693",
  "category": "csp-weakness",
  "remediation": "Immediate: remove `'unsafe-eval'` and replace `eval`, `new Function` and string-argument timers with static code. Durable: keep the policy in `Content-Security-Policy` (not report-only) and add a report endpoint so a reintroduced `eval` is visible before release. Trade-off: some template engines and charting libraries compile expressions at runtime; those need a build-time rewrite or an isolated, nonce-based script rather than an exception in the policy.",
  "limitation": "Directive-scoped value check: only script-src, script-src-elem and the default-src fallback are read, because 'unsafe-eval' has no meaning in another directive. A nonce does not neutralise 'unsafe-eval' (only 'unsafe-inline' is neutralised), so policies that nonce every script are still reported.",
  "check": {
    "type": "response-header-matches",
    "header": "Content-Security-Policy",
    "valuePattern": "(?:^|;)\\s*script-src(?=[\\s;]|$)[^;]*'unsafe-eval'|^(?!.*(?:^|;)\\s*script-src(?=[\\s;]|$)).*(?:^|;)\\s*default-src(?=[\\s;]|$)[^;]*'unsafe-eval'"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self' 'unsafe-eval'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'unsafe-eval'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "img-src 'self'; script-src 'unsafe-eval'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "style-src 'unsafe-eval'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src-attr 'unsafe-eval'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'unsafe-eval'; script-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'; default-src 'unsafe-eval'"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0958"
  ]
}
