{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-169",
  "title": "JFrog Artifactory interface disclosed",
  "description": "The response is the JFrog Artifactory interface: the artifactory bundle and the JFrog attribution identify the artefact repository manager. It serves the packages and container layers that deployments pull.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Keep Artifactory on the internal network behind an authenticating proxy, require authentication for browsing, and keep the version patched.",
  "limitation": "One response body. The rule reports the Artifactory shell; it does not list a repository or download an artefact.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*artifactory)(?=[\\s\\S]*JFrog)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Artifactory</title></head><body><script src=\"/ui/artifactory.js\"></script><span>JFrog</span></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div id=\"artifactory-app\"></div><footer>JFrog Artifactory</footer></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><script src=\"/ui/.js\"></script><span></span></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1238"
  ]
}
