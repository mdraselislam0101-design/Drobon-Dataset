{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-049",
  "title": "Weak response control (HSTS without includeSubDomains)",
  "description": "The response weakens a control: HSTS without includeSubDomains. Protocol-relative redirects, wildcard timing origins, and charset-less content types widen attacks. This check matches the weakness directly.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Strengthen the control (includeSubDomains).",
  "limitation": "Header check: it cannot confirm exploitability.",
  "check": {
    "type": "response-header-missing-directive",
    "header": "Strict-Transport-Security",
    "directive": "includeSubDomains"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=1000"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=1; includeSubDomains"
        }
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0574"
  ]
}
