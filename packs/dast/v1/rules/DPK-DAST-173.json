{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-173",
  "title": "Azure Blob Storage container listing disclosed",
  "description": "The response is an Azure Blob Storage container listing: the EnumerationResults document with BlobService metadata returns blob names to an anonymous caller. The container was reached without a shared access signature.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Set the container access level to private and serve public assets through a controlled endpoint or a signed URL. Review the container policy for anonymous read.",
  "limitation": "One response body. The rule reports the listing document; it does not download a blob and cannot show what the blobs contain.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*<EnumerationResults)(?=[\\s\\S]*BlobService)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?><EnumerationResults ServiceEndpoint=\"https://acct.blob.core.windows.net/\" ContainerName=\"backups\"><Blobs><Blob><Name>db-2026-10-01.dump</Name></Blob></Blobs><NextMarker/></EnumerationResults><!-- BlobService -->"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?xml version=\"1.0\"?><EnumerationResults ContainerName=\"assets\"><Blobs><Blob><Name>logo.png</Name></Blob></Blobs></EnumerationResults><!-- BlobService version=2021-08-06 -->"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?> ServiceEndpoint=\"https://acct.blob.core.windows.net/\" ContainerName=\"backups\"><Blobs><Blob><Name>db-2026-10-01.dump</Name></Blob></Blobs><NextMarker/></EnumerationResults><!--  -->"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1242"
  ]
}
