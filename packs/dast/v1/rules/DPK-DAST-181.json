{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-181",
  "title": "SonarQube interface disclosed",
  "description": "The response is the SonarQube web interface: the sonarqube bundle and the product name identify the code-quality console. SonarQube holds source analysis results, project keys and often a database credential.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "debug-exposure",
  "remediation": "Keep SonarQube on an internal network behind an authenticating proxy, force authentication for project visibility, and keep the version patched.",
  "limitation": "One response body. The rule reports the SonarQube shell; it does not read a project or an analysis result.",
  "check": {
    "type": "response-body-matches",
    "valuePattern": "(?=[\\s\\S]*sonarqube)(?=[\\s\\S]*SonarQube)"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>SonarQube</title></head><body><script src=\"/js/sonarqube.js\"></script><div id=\"sonarqube-app\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><script>window.sonarqube = {\"version\":\"10.3.0\"};</script><span>SonarQube</span></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><script src=\"/js/.js\"></script><div id=\"-app\"></div></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-1250"
  ]
}
