{
  "schemaVersion": "drobon.pack.dast/v1",
  "id": "DPK-DAST-051",
  "title": "Weak response control (wildcard Timing-Allow-Origin)",
  "description": "The response weakens a control: wildcard Timing-Allow-Origin. Protocol-relative redirects, wildcard timing origins, and charset-less content types widen attacks. This check matches the weakness directly.",
  "severity": "MEDIUM",
  "cwe": "CWE-693",
  "category": "security-headers",
  "remediation": "Strengthen the control (explicit origins).",
  "limitation": "Header check: it cannot confirm exploitability.",
  "check": {
    "type": "response-header-matches",
    "header": "Timing-Allow-Origin",
    "valuePattern": "^\\*$"
  },
  "tests": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Timing-Allow-Origin": "*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/x",
        "status": 200,
        "headers": {
          "Timing-Allow-Origin": "*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Timing-Allow-Origin": "https://app.example/"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0576"
  ]
}
