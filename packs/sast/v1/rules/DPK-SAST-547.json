{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-547",
  "title": "Script evaluation (el) — review required",
  "description": "A el engine evaluates a string: new ELProcessor().eval(expr). Untrusted input becomes code execution. This lexical rule flags the evaluation; the reviewer confirms trust or removes it via fixed expressions.",
  "severity": "HIGH",
  "cwe": "CWE-95",
  "category": "code-injection",
  "remediation": "Remove evaluation or use fixed expressions.",
  "limitation": "Lexical, line-based: matches the evaluation.",
  "languages": [
    "java"
  ],
  "patterns": [
    {
      "source": "\\b(?:ELProcessor\\s*\\(\\s*\\)\\s*\\.eval\\s*\\()"
    }
  ],
  "tests": [
    {
      "line": "new ELProcessor().eval(expr)",
      "match": true
    },
    {
      "line": "# audit: new ELProcessor().eval(expr) present",
      "match": true
    },
    {
      "line": "factory.getELProcessor()",
      "match": false
    },
    {
      "line": "# verified: factory.getELProcessor()",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0664"
  ]
}
