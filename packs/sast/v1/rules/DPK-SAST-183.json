{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-183",
  "title": "MD5 package use (tcl) — review required",
  "description": "Code in tcl uses the MD5 package: md5::md5 $x. MD5 is broken for security uses. This lexical rule flags the use; the reviewer confirms a checksum or migrates.",
  "severity": "LOW",
  "cwe": "CWE-327",
  "category": "weak-cryptography",
  "remediation": "Migrate to the sha256 package.",
  "limitation": "Lexical, line-based: matches the package name.",
  "languages": [
    "tcl"
  ],
  "patterns": [
    {
      "source": "\\b(?:md5::md5)"
    }
  ],
  "tests": [
    {
      "line": "md5::md5 $x",
      "match": true
    },
    {
      "line": "# audit: md5::md5 $x present",
      "match": true
    },
    {
      "line": "sha256::sha256 $x",
      "match": false
    },
    {
      "line": "# verified: sha256::sha256 $x",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0222"
  ]
}
