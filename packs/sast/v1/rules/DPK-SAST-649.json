{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-649",
  "title": "Cleartext protocol client (telnet) — review required",
  "description": "Code uses a cleartext client: telnetlib.Telnets*( (telnet). Credentials and data travel unencrypted. This lexical rule flags the client; the reviewer migrates to SSH.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "cleartext-transmission",
  "remediation": "Migrate to SSH.",
  "limitation": "Lexical, line-based: matches the client.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "telnetlib\\.Telnet\\s*\\("
    }
  ],
  "tests": [
    {
      "line": "telnetlib.Telnet(h)",
      "match": true
    },
    {
      "line": "# audit: telnetlib.Telnet(h) present",
      "match": true
    },
    {
      "line": "paramiko.SSHClient()",
      "match": false
    },
    {
      "line": "# verified: paramiko.SSHClient()",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0766"
  ]
}
