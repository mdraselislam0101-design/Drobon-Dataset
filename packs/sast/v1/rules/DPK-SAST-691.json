{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-691",
  "title": "Framework SQL splice (sqlx) — review required",
  "description": "A sqlx query splices values unsafely: sqlx::query!s*([^)]*format!. Macro formatting and #$ splices bypass parameterization. This lexical rule flags the splice; the reviewer parameterizes via bind parameters.",
  "severity": "HIGH",
  "cwe": "CWE-89",
  "category": "sql-injection",
  "remediation": "Use bind parameters.",
  "limitation": "Lexical, line-based: matches the splice.",
  "languages": [
    "rust"
  ],
  "patterns": [
    {
      "source": "sqlx::query!\\s*\\([^)]*format!"
    }
  ],
  "tests": [
    {
      "line": "sqlx::query!(format!(\"SELECT {}\", q))",
      "match": true
    },
    {
      "line": "# audit: sqlx::query!(format!(\"SELECT {}\", q)) present",
      "match": true
    },
    {
      "line": "sqlx::query!(\"SELECT 1\")",
      "match": false
    },
    {
      "line": "# verified: sqlx::query!(\"SELECT 1\")",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0808"
  ]
}
