{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-583",
  "title": "Permissive Kubernetes pod (rolewild) — review required",
  "description": "Kubernetes grants host or root power: verbs: [\"*\"] (rolewild). Host namespaces, root users, writable roots, and privilege escalation erase pod isolation. This lexical rule flags the grant; the reviewer removes it via least-privilege verbs.",
  "severity": "HIGH",
  "cwe": "CWE-284",
  "category": "container-security",
  "remediation": "Remove or use least-privilege verbs.",
  "limitation": "Lexical, line-based: matches the grant.",
  "languages": [
    "k8s"
  ],
  "patterns": [
    {
      "source": "\\b(?:verbs\\s*:\\s*\\[[^\\]]*\"\\*\")"
    }
  ],
  "tests": [
    {
      "line": "verbs: [\"*\"]",
      "match": true
    },
    {
      "line": "# audit: verbs: [\"*\"] present",
      "match": true
    },
    {
      "line": "verbs: [\"get\"]",
      "match": false
    },
    {
      "line": "# verified: verbs: [\"get\"]",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0700"
  ]
}
