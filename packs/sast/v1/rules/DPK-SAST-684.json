{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-684",
  "title": "Risky Spring setting (mgmt) — review required",
  "description": "Spring exposes internals: management.security.enableds*=s*false (mgmt). Disabled SSL, open management, verbose health, and the H2 console widen access. This lexical rule flags the setting; the reviewer restricts via secured management.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Restrict with secured management.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "properties"
  ],
  "patterns": [
    {
      "source": "management\\.security\\.enabled\\s*=\\s*false"
    }
  ],
  "tests": [
    {
      "line": "management.security.enabled=false",
      "match": true
    },
    {
      "line": "# audit: management.security.enabled=false present",
      "match": true
    },
    {
      "line": "management.security.enabled=true",
      "match": false
    },
    {
      "line": "# verified: management.security.enabled=true",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0801"
  ]
}
