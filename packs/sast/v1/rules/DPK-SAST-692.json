{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-692",
  "title": "Framework SQL splice (slick) — review required",
  "description": "A slick query splices values unsafely: sql\"SELECT * FROM #$t\". Macro formatting and #$ splices bypass parameterization. This lexical rule flags the splice; the reviewer parameterizes via $ bindings.",
  "severity": "HIGH",
  "cwe": "CWE-89",
  "category": "sql-injection",
  "remediation": "Use $ bindings.",
  "limitation": "Lexical, line-based: matches the splice.",
  "languages": [
    "scala"
  ],
  "patterns": [
    {
      "source": "#\\$"
    }
  ],
  "tests": [
    {
      "line": "sql\"SELECT * FROM #$t\"",
      "match": true
    },
    {
      "line": "# audit: sql\"SELECT * FROM #$t\" present",
      "match": true
    },
    {
      "line": "sql\"SELECT * FROM $t\"",
      "match": false
    },
    {
      "line": "# verified: sql\"SELECT * FROM $t\"",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0809"
  ]
}
