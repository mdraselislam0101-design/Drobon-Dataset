{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-516",
  "title": "Risky Express setting (trustproxy) — review required",
  "description": "Express trusts broadly: app.set(\"trust proxy\", true) (trustproxy). Served dotfiles leak secrets; trusted proxies let clients spoof addresses. This lexical rule flags the setting; the reviewer narrows via scoped proxy trust.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Narrow with scoped proxy trust.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "javascript"
  ],
  "patterns": [
    {
      "source": "\\b(?:app\\.set\\s*\\(\\s*[\"']trust proxy[\"'])"
    }
  ],
  "tests": [
    {
      "line": "app.set(\"trust proxy\", true)",
      "match": true
    },
    {
      "line": "# audit: app.set(\"trust proxy\", true) present",
      "match": true
    },
    {
      "line": "app.set(\"port\", 3000)",
      "match": false
    },
    {
      "line": "# verified: app.set(\"port\", 3000)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0633"
  ]
}
