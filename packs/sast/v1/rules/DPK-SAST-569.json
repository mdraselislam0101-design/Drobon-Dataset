{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-569",
  "title": "JWT verification skipped (claimsjwt) — review required",
  "description": "JWT checks are skipped: parseClaimsJwts*( (claimsjwt). Ignored expiry, unverified parsing, disabled signatures, and none algorithms let forged tokens in. This lexical rule flags the skip; the reviewer enforces via signed JWS parsing.",
  "severity": "HIGH",
  "cwe": "CWE-347",
  "category": "broken-auth",
  "remediation": "Enforce signed JWS parsing.",
  "limitation": "Lexical, line-based: matches the skip.",
  "languages": [
    "java"
  ],
  "patterns": [
    {
      "source": "parseClaimsJwt\\s*\\("
    }
  ],
  "tests": [
    {
      "line": "parser.parseClaimsJwt(t)",
      "match": true
    },
    {
      "line": "# audit: parser.parseClaimsJwt(t) present",
      "match": true
    },
    {
      "line": "parser.parseClaimsJws(t)",
      "match": false
    },
    {
      "line": "# verified: parser.parseClaimsJws(t)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0686"
  ]
