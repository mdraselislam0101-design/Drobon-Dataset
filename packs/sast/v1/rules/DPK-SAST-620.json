{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-620",
  "title": "PHP session exposure (transsid) — review required",
  "description": "PHP sessions travel insecurely: session.use_trans_sid = 1 (transsid). Cookies without Secure or HttpOnly leak over HTTP and to scripts; URL session ids leak through links. This lexical rule flags the setting; the reviewer hardens via cookies-only sessions.",
  "severity": "MEDIUM",
  "cwe": "CWE-614",
  "category": "session-security",
  "remediation": "Harden with cookies-only sessions.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "ini"
  ],
  "patterns": [
    {
      "source": "\\b(?:session\\.use_trans_sid\\s*=\\s*1\\b)"
    }
  ],
  "tests": [
    {
      "line": "session.use_trans_sid = 1",
      "match": true
    },
    {
      "line": "# audit: session.use_trans_sid = 1 present",
      "match": true
    },
    {
      "line": "session.use_trans_sid = 0",
      "match": false
    },
    {
      "line": "# verified: session.use_trans_sid = 0",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0737"
  ]
}
