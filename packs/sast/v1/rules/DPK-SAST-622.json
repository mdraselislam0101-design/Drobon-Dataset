{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-622",
  "title": "Weak PHP crypto or diagnostics (ecb) — review required",
  "description": "PHP weakens crypto or diagnostics: openssl_encrypt($d, \"AES-128-ECB\", $k) (ecb). ECB leaks patterns, low bcrypt cost speeds guessing, silenced errors hide attacks, and register_globals resurrects variable injection. This lexical rule flags the setting; the reviewer hardens via an AEAD mode.",
  "severity": "MEDIUM",
  "cwe": "CWE-327",
  "category": "secure-configuration",
  "remediation": "Harden with an AEAD mode.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "php"
  ],
  "patterns": [
    {
      "source": "\\b(?:openssl_encrypt\\s*\\([^)]*AES[^)]*-ECB)"
    }
  ],
  "tests": [
    {
      "line": "openssl_encrypt($d, \"AES-128-ECB\", $k)",
      "match": true
    },
    {
      "line": "# audit: openssl_encrypt($d, \"AES-128-ECB\", $k) present",
      "match": true
    },
    {
      "line": "openssl_encrypt($d, \"AES-128-CBC\", $k)",
      "match": false
    },
    {
      "line": "# verified: openssl_encrypt($d, \"AES-128-CBC\", $k)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0739"
  ]
}
