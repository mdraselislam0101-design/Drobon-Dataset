{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-571",
  "title": "JWT verification skipped (decodefalse) — review required",
  "description": "JWT checks are skipped: JWT.decodes*([^)]*,s*nils*,s*false (decodefalse). Ignored expiry, unverified parsing, disabled signatures, and none algorithms let forged tokens in. This lexical rule flags the skip; the reviewer enforces via verified decoding.",
  "severity": "HIGH",
  "cwe": "CWE-347",
  "category": "broken-auth",
  "remediation": "Enforce verified decoding.",
  "limitation": "Lexical, line-based: matches the skip.",
  "languages": [
    "ruby"
  ],
  "patterns": [
    {
      "source": "JWT\\.decode\\s*\\([^)]*,\\s*nil\\s*,\\s*false"
    }
  ],
  "tests": [
    {
      "line": "JWT.decode(t, nil, false)",
      "match": true
    },
    {
      "line": "# audit: JWT.decode(t, nil, false) present",
      "match": true
    },
    {
      "line": "JWT.decode(t, key, true)",
      "match": false
    },
    {
      "line": "# verified: JWT.decode(t, key, true)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0688"
  ]
}
