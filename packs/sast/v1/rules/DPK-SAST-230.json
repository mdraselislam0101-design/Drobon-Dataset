{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-230",
  "title": "Remote file inclusion enabled (php) — review required",
  "description": "PHP allows including remote URLs as code: allow_url_include = On. Any include path touching input becomes remote execution. This lexical rule flags the switch; the reviewer disables it via allow_url_include = Off.",
  "severity": "HIGH",
  "cwe": "CWE-829",
  "category": "code-injection",
  "remediation": "Set allow_url_include = Off.",
  "limitation": "Lexical, line-based: matches the switch.",
  "languages": [
    "php"
  ],
  "patterns": [
    {
      "source": "\\b(?:allow_url_include\\s*=\\s*(?:On|1))"
    }
  ],
  "tests": [
    {
      "line": "allow_url_include = On",
      "match": true
    },
    {
      "line": "# audit: allow_url_include = On present",
      "match": true
    },
    {
      "line": "allow_url_include = Off",
      "match": false
    },
    {
      "line": "# verified: allow_url_include = Off",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0269"
  ]
}
