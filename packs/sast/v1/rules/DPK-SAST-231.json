{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-231",
  "title": "Rails force_ssl disabled (ruby) — review required",
  "description": "Rails HTTPS enforcement is off: force_ssls*=s*false. Cookies and pages travel over HTTP. This lexical rule flags the setting; the reviewer enables force_ssl true.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "transport-security",
  "remediation": "Enable force_ssl true.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "ruby"
  ],
  "patterns": [
    {
      "source": "force_ssl\\s*=\\s*false"
    }
  ],
  "tests": [
    {
      "line": "config.force_ssl = false",
      "match": true
    },
    {
      "line": "# audit: config.force_ssl = false present",
      "match": true
    },
    {
      "line": "config.force_ssl = true",
      "match": false
    },
    {
      "line": "# verified: config.force_ssl = true",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0270"
  ]
}
