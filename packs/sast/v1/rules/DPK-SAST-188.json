{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-188",
  "title": "Mobile cleartext traffic allowed (cleartext) — review required",
  "description": "The manifest allows cleartext traffic: android:usesCleartextTraffic=\"true\" (cleartext). App traffic becomes observable and modifiable. This lexical rule flags the flag; the reviewer confirms necessity or restores TLS via false plus network config.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "mobile-security",
  "remediation": "Apply false plus network config.",
  "limitation": "Lexical, line-based: matches the flag.",
  "languages": [
    "xml"
  ],
  "patterns": [
    {
      "source": "\\b(?:android:usesCleartextTraffic\\s*=\\s*[\"']true[\"'])"
    }
  ],
  "tests": [
    {
      "line": "android:usesCleartextTraffic=\"true\"",
      "match": true
    },
    {
      "line": "# audit: android:usesCleartextTraffic=\"true\" present",
      "match": true
    },
    {
      "line": "android:usesCleartextTraffic=\"false\"",
      "match": false
    },
    {
      "line": "# verified: android:usesCleartextTraffic=\"false\"",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0227"
  ]
}
