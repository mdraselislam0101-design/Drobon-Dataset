{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-579",
  "title": "Permissive Kubernetes pod (latest) — review required",
  "description": "Kubernetes grants host or root power: image: app:latest (latest). Host namespaces, root users, writable roots, and privilege escalation erase pod isolation. This lexical rule flags the grant; the reviewer removes it via pinned digests.",
  "severity": "HIGH",
  "cwe": "CWE-284",
  "category": "container-security",
  "remediation": "Remove or use pinned digests.",
  "limitation": "Lexical, line-based: matches the grant.",
  "languages": [
    "k8s"
  ],
  "patterns": [
    {
      "source": "\\b(?:image\\s*:[^\\n]*:latest)"
    }
  ],
  "tests": [
    {
      "line": "image: app:latest",
      "match": true
    },
    {
      "line": "# audit: image: app:latest present",
      "match": true
    },
    {
      "line": "image: app:1.2.3",
      "match": false
    },
    {
      "line": "# verified: image: app:1.2.3",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0696"
  ]
}
