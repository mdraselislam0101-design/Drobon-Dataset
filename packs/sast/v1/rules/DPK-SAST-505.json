{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-505",
  "title": "Django security setting off (djsess) — review required",
  "description": "Django disables a security control: SESSION_COOKIE_SECURE = False (djsess). Insecure cookies, no HTTPS redirect, no HSTS, and MD5 hashing weaken the app. This lexical rule flags the setting; the reviewer enables via secure session cookies.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Enable secure session cookies.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "\\b(?:SESSION_COOKIE_SECURE\\s*=\\s*False)"
    }
  ],
  "tests": [
    {
      "line": "SESSION_COOKIE_SECURE = False",
      "match": true
    },
    {
      "line": "# audit: SESSION_COOKIE_SECURE = False present",
      "match": true
    },
    {
      "line": "SESSION_COOKIE_SECURE = True",
      "match": false
    },
    {
      "line": "# verified: SESSION_COOKIE_SECURE = True",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0622"
  ]
}
