{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-629",
  "title": "Weak proxy or service setting (tls) — review required",
  "description": "A service weakens transport or trust: tls off (tls). Disabled TLS, skipped verification, and default credentials expose traffic and control. This lexical rule flags the setting; the reviewer hardens via managed TLS.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Harden with managed TLS.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "caddy"
  ],
  "patterns": [
    {
      "source": "\\b(?:tls\\s+off)"
    }
  ],
  "tests": [
    {
      "line": "tls off",
      "match": true
    },
    {
      "line": "# audit: tls off present",
      "match": true
    },
    {
      "line": "tls internal",
      "match": false
    },
    {
      "line": "# verified: tls internal",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0746"
  ]
}
