{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-102",
  "title": "Script evaluation of a variable (clojure) — review required",
  "description": "A clojure script evaluates a variable: (eval x). Variable content becomes running code. This lexical rule flags the evaluation; the reviewer confirms trust or restructures it.",
  "severity": "HIGH",
  "cwe": "CWE-95",
  "category": "code-injection",
  "remediation": "Replace evaluation with higher-order functions.",
  "limitation": "Lexical, line-based: matches variable evaluation.",
  "languages": [
    "clojure"
  ],
  "patterns": [
    {
      "source": "\\(eval\\s"
    }
  ],
  "tests": [
    {
      "line": "(eval x)",
      "match": true
    },
    {
      "line": "# audit: (eval x) present",
      "match": true
    },
    {
      "line": "(apply f x)",
      "match": false
    },
    {
      "line": "# verified: (apply f x)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0141"
  ]
}
