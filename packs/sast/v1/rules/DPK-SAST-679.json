{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-679",
  "title": "Shell runs a variable (backtick, ruby) — review required",
  "description": "A shell executes variable content: `[^`]*(?:$|#{) (backtick). Backticks, substitution, sourcing, and call operators turn variables into commands. This lexical rule flags the execution; the reviewer confirms trust or restructures via Open3 with args.",
  "severity": "HIGH",
  "cwe": "CWE-78",
  "category": "command-injection",
  "remediation": "Restructure with Open3 with args.",
  "limitation": "Lexical, line-based: matches the execution.",
  "languages": [
    "ruby"
  ],
  "patterns": [
    {
      "source": "`[^`]*(?:\\$|#\\{)"
    }
  ],
  "tests": [
    {
      "line": "`$cmd`",
      "match": true
    },
    {
      "line": "# audit: `$cmd` present",
      "match": true
    },
    {
      "line": "`ls`",
      "match": false
    },
    {
      "line": "# verified: `ls`",
      "match": false
    },
    {
      "line": "out = `ls #{user}`",
      "match": true
    },
    {
      "line": "out = `ls -la`",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0796"
  ]
}
