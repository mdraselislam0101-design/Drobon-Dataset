{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-647",
  "title": "Cleartext protocol client (pop) — review required",
  "description": "Code uses a cleartext client: poplib.POP3(h) (pop). Credentials and data travel unencrypted. This lexical rule flags the client; the reviewer migrates to POP3_SSL.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "cleartext-transmission",
  "remediation": "Migrate to POP3_SSL.",
  "limitation": "Lexical, line-based: matches the client.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "\\b(?:poplib\\.POP3\\s*\\()"
    }
  ],
  "tests": [
    {
      "line": "poplib.POP3(h)",
      "match": true
    },
    {
      "line": "# audit: poplib.POP3(h) present",
      "match": true
    },
    {
      "line": "poplib.POP3_SSL(h)",
      "match": false
    },
    {
      "line": "# verified: poplib.POP3_SSL(h)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0764"
  ]
}
