{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-618",
  "title": "PHP session exposure (sesshttponly) — review required",
  "description": "PHP sessions travel insecurely: session.cookie_httponly = 0 (sesshttponly). Cookies without Secure or HttpOnly leak over HTTP and to scripts; URL session ids leak through links. This lexical rule flags the setting; the reviewer hardens via HttpOnly session cookies.",
  "severity": "MEDIUM",
  "cwe": "CWE-614",
  "category": "session-security",
  "remediation": "Harden with HttpOnly session cookies.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "ini"
  ],
  "patterns": [
    {
      "source": "\\b(?:session\\.cookie_httponly\\s*=\\s*0\\b)"
    }
  ],
  "tests": [
    {
      "line": "session.cookie_httponly = 0",
      "match": true
    },
    {
      "line": "# audit: session.cookie_httponly = 0 present",
      "match": true
    },
    {
      "line": "session.cookie_httponly = 1",
      "match": false
    },
    {
      "line": "# verified: session.cookie_httponly = 1",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0735"
  ]
}
