{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-570",
  "title": "JWT verification skipped (ignoreexp) — review required",
  "description": "JWT checks are skipped: verifys*([^)]*ignoreExpirations*:s*true (ignoreexp). Ignored expiry, unverified parsing, disabled signatures, and none algorithms let forged tokens in. This lexical rule flags the skip; the reviewer enforces via enforced expiry.",
  "severity": "HIGH",
  "cwe": "CWE-347",
  "category": "broken-auth",
  "remediation": "Enforce enforced expiry.",
  "limitation": "Lexical, line-based: matches the skip.",
  "languages": [
    "javascript"
  ],
  "patterns": [
    {
      "source": "verify\\s*\\([^)]*ignoreExpiration\\s*:\\s*true"
    }
  ],
  "tests": [
    {
      "line": "jwt.verify(t, k, {ignoreExpiration: true})",
      "match": true
    },
    {
      "line": "# audit: jwt.verify(t, k, {ignoreExpiration: true}) present",
      "match": true
    },
    {
      "line": "jwt.verify(t, k, {})",
      "match": false
    },
    {
      "line": "# verified: jwt.verify(t, k, {})",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0687"
  ]
}
