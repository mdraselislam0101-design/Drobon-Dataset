{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-555",
  "title": "TLS trust weakened (jndi) — review required",
  "description": "TLS trust is weakened: ctx.lookup(\"ldap://h/o\") (jndi). Disabled checks and fixed secrets let attackers impersonate servers or authenticate. This lexical rule flags the weakness; the reviewer restores fixed JNDI names.",
  "severity": "HIGH",
  "cwe": "CWE-295",
  "category": "transport-security",
  "remediation": "Restore fixed JNDI names.",
  "limitation": "Lexical, line-based: matches the weakness.",
  "languages": [
    "java"
  ],
  "patterns": [
    {
      "source": "\\b(?:lookup\\s*\\(\\s*\"ldap:)"
    }
  ],
  "tests": [
    {
      "line": "ctx.lookup(\"ldap://h/o\")",
      "match": true
    },
    {
      "line": "# audit: ctx.lookup(\"ldap://h/o\") present",
      "match": true
    },
    {
      "line": "ctx.lookup(\"java:comp/env/x\")",
      "match": false
    },
    {
      "line": "# verified: ctx.lookup(\"java:comp/env/x\")",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0672"
  ]
}
