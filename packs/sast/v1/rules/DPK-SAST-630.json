{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-630",
  "title": "Weak proxy or service setting (verify) — review required",
  "description": "A service weakens transport or trust: verify_incoming = false (verify). Disabled TLS, skipped verification, and default credentials expose traffic and control. This lexical rule flags the setting; the reviewer hardens via verified TLS.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Harden with verified TLS.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "consul"
  ],
  "patterns": [
    {
      "source": "\\b(?:verify_incoming\\s*=\\s*false)"
    }
  ],
  "tests": [
    {
      "line": "verify_incoming = false",
      "match": true
    },
    {
      "line": "# audit: verify_incoming = false present",
      "match": true
    },
    {
      "line": "verify_incoming = true",
      "match": false
    },
    {
      "line": "# verified: verify_incoming = true",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0747"
  ]
}
