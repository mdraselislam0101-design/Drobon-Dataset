{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-741",
  "title": "Sensitive value in log call (fortran) — review required",
  "description": "A fortran log call outputs a credential-named value: WRITE(*,*) \"password\", p. Logs persist and spread. This lexical rule flags the call; the reviewer confirms non-sensitivity or redacts.",
  "severity": "MEDIUM",
  "cwe": "CWE-532",
  "category": "sensitive-logging",
  "remediation": "Log presence flags instead and scrub historic logs.",
  "limitation": "Lexical, line-based: matches credential-adjacent names.",
  "languages": [
    "fortran"
  ],
  "patterns": [
    {
      "source": "\\b(?:WRITE\\s*\\(\\s*\\*\\s*,\\s*\\*\\s*\\)[^\\n]{0,80}(?:password|passwd|secret|token))"
    }
  ],
  "tests": [
    {
      "line": "WRITE(*,*) \"password\", p",
      "match": true
    },
    {
      "line": "# audit: WRITE(*,*) \"password\", p present",
      "match": true
    },
    {
      "line": "WRITE(*,*) \"user\", u",
      "match": false
    },
    {
      "line": "# verified: WRITE(*,*) \"user\", u",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0892"
  ]
}
