{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-504",
  "title": "Django security setting off (djmd5) — review required",
  "description": "Django disables a security control: MD5PasswordHasher (djmd5). Insecure cookies, no HTTPS redirect, no HSTS, and MD5 hashing weaken the app. This lexical rule flags the setting; the reviewer enables via PBKDF2 or stronger.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Enable PBKDF2 or stronger.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "MD5PasswordHasher"
    }
  ],
  "tests": [
    {
      "line": "django.contrib.auth.hashers.MD5PasswordHasher",
      "match": true
    },
    {
      "line": "# audit: django.contrib.auth.hashers.MD5PasswordHasher present",
      "match": true
    },
    {
      "line": "django.contrib.auth.hashers.PBKDF2PasswordHasher",
      "match": false
    },
    {
      "line": "# verified: django.contrib.auth.hashers.PBKDF2PasswordHasher",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0621"
  ]
}
