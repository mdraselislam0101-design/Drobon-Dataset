{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-597",
  "title": "Authentication bypass (permit) — review required",
  "description": "Authentication is bypassed: auths+sufficients+pam_permit (permit). Permit modules, no-auth sudo, and environment-preserving sudo grant access without proof. This lexical rule flags the entry; the reviewer removes it via real authentication.",
  "severity": "HIGH",
  "cwe": "CWE-287",
  "category": "authentication",
  "remediation": "Remove or use real authentication.",
  "limitation": "Lexical, line-based: matches the entry.",
  "languages": [
    "pam"
  ],
  "patterns": [
    {
      "source": "auth\\s+sufficient\\s+pam_permit"
    }
  ],
  "tests": [
    {
      "line": "auth sufficient pam_permit.so",
      "match": true
    },
    {
      "line": "# audit: auth sufficient pam_permit.so present",
      "match": true
    },
    {
      "line": "auth required pam_unix.so",
      "match": false
    },
    {
      "line": "# verified: auth required pam_unix.so",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0714"
  ]
}
