{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-520",
  "title": "Risky GitHub Actions step (addpath) — review required",
  "description": "A workflow takes a risky shortcut: ::add-path (addpath). Mutable action refs, broad tokens, deprecated commands, and self-hosted runners widen supply-chain impact. This lexical rule flags the step; the reviewer hardens via GITHUB_PATH files.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "ci-security",
  "remediation": "Harden with GITHUB_PATH files.",
  "limitation": "Lexical, line-based: matches the step.",
  "languages": [
    "gha"
  ],
  "patterns": [
    {
      "source": "::add-path"
    }
  ],
  "tests": [
    {
      "line": "echo \"::add-path::/x\"",
      "match": true
    },
    {
      "line": "# audit: echo \"::add-path::/x\" present",
      "match": true
    },
    {
      "line": "echo \"/x\" >> $GITHUB_PATH",
      "match": false
    },
    {
      "line": "# verified: echo \"/x\" >> $GITHUB_PATH",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0637"
  ]
}
