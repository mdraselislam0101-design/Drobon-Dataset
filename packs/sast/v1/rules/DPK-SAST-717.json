{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-717",
  "title": "Weak Terraform setting (pg9) — review required",
  "description": "Terraform weakens protection: engine_versions*=s*\"9. (pg9). Ignored drift, local execution, skipped snapshots, public databases, and cleartext secrets widen blast radius. This lexical rule flags the setting; the reviewer hardens via a supported engine.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Harden with a supported engine.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "hcl"
  ],
  "patterns": [
    {
      "source": "engine_version\\s*=\\s*\"9\\."
    }
  ],
  "tests": [
    {
      "line": "engine_version = \"9.6\"",
      "match": true
    },
    {
      "line": "# audit: engine_version = \"9.6\" present",
      "match": true
    },
    {
      "line": "engine_version = \"15.4\"",
      "match": false
    },
    {
      "line": "# verified: engine_version = \"15.4\"",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0834"
  ]
}
