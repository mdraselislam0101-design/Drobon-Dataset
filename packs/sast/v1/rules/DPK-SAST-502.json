{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-502",
  "title": "Django security setting off (djcsrf) — review required",
  "description": "Django disables a security control: CSRF_COOKIE_SECUREs*=s*False (djcsrf). Insecure cookies, no HTTPS redirect, no HSTS, and MD5 hashing weaken the app. This lexical rule flags the setting; the reviewer enables via secure CSRF cookies.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Enable secure CSRF cookies.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "CSRF_COOKIE_SECURE\\s*=\\s*False"
    }
  ],
  "tests": [
    {
      "line": "CSRF_COOKIE_SECURE = False",
      "match": true
    },
    {
      "line": "# audit: CSRF_COOKIE_SECURE = False present",
      "match": true
    },
    {
      "line": "CSRF_COOKIE_SECURE = True",
      "match": false
    },
    {
      "line": "# verified: CSRF_COOKIE_SECURE = True",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0619"
  ]
}
