{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-683",
  "title": "Risky Spring setting (health) — review required",
  "description": "Spring exposes internals: endpoints.health.sensitive=false (health). Disabled SSL, open management, verbose health, and the H2 console widen access. This lexical rule flags the setting; the reviewer restricts via sensitive health.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Restrict with sensitive health.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "properties"
  ],
  "patterns": [
    {
      "source": "\\b(?:endpoints\\.health\\.sensitive\\s*=\\s*false)"
    }
  ],
  "tests": [
    {
      "line": "endpoints.health.sensitive=false",
      "match": true
    },
    {
      "line": "# audit: endpoints.health.sensitive=false present",
      "match": true
    },
    {
      "line": "endpoints.health.sensitive=true",
      "match": false
    },
    {
      "line": "# verified: endpoints.health.sensitive=true",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0800"
  ]
}
