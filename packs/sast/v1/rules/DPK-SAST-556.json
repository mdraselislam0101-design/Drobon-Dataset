{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-556",
  "title": "TLS trust weakened (rmi) — review required",
  "description": "TLS trust is weakened: RMIClassLoader (rmi). Disabled checks and fixed secrets let attackers impersonate servers or authenticate. This lexical rule flags the weakness; the reviewer restores disabled codebase downloading.",
  "severity": "HIGH",
  "cwe": "CWE-295",
  "category": "transport-security",
  "remediation": "Restore disabled codebase downloading.",
  "limitation": "Lexical, line-based: matches the weakness.",
  "languages": [
    "java"
  ],
  "patterns": [
    {
      "source": "RMIClassLoader"
    }
  ],
  "tests": [
    {
      "line": "RMIClassLoader.loadClass(url, name)",
      "match": true
    },
    {
      "line": "# audit: RMIClassLoader.loadClass(url, name) present",
      "match": true
    },
    {
      "line": "Class.forName(name)",
      "match": false
    },
    {
      "line": "# verified: Class.forName(name)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0673"
  ]
}
