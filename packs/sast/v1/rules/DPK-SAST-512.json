{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-512",
  "title": "ECB mode selected (ecb) — review required",
  "description": "Encryption uses ECB mode: aes-[0-9]+-ecb (ecb). ECB leaks plaintext patterns. This lexical rule flags the selection; the reviewer migrates to cbc or gcm.",
  "severity": "MEDIUM",
  "cwe": "CWE-327",
  "category": "weak-cryptography",
  "remediation": "Migrate to cbc or gcm.",
  "limitation": "Lexical, line-based: matches the mode name.",
  "languages": [
    "javascript"
  ],
  "patterns": [
    {
      "source": "aes-[0-9]+-ecb"
    }
  ],
  "tests": [
    {
      "line": "createCipheriv(\"aes-128-ecb\", k, iv)",
      "match": true
    },
    {
      "line": "# audit: createCipheriv(\"aes-128-ecb\", k, iv) present",
      "match": true
    },
    {
      "line": "createCipheriv(\"aes-128-cbc\", k, iv)",
      "match": false
    },
    {
      "line": "# verified: createCipheriv(\"aes-128-cbc\", k, iv)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0629"
  ]
}
