{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-652",
  "title": "Rails protection weakened (skipverify) — review required",
  "description": "Rails weakens a protection: skip_before_action :verify_authenticity_token (skipverify). Local-request errors leak internals, skipped forgery checks invite CSRF. This lexical rule flags the setting; the reviewer restores via kept verification.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Restore kept verification.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "ruby"
  ],
  "patterns": [
    {
      "source": "\\b(?:skip_before_action\\s+:verify_authenticity_token)"
    }
  ],
  "tests": [
    {
      "line": "skip_before_action :verify_authenticity_token",
      "match": true
    },
    {
      "line": "# audit: skip_before_action :verify_authenticity_token present",
      "match": true
    },
    {
      "line": "before_action :verify_authenticity_token",
      "match": false
    },
    {
      "line": "# verified: before_action :verify_authenticity_token",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0769"
  ]
}
