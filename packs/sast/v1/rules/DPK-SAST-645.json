{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-645",
  "title": "Cleartext protocol client (httpclient) — review required",
  "description": "Code uses a cleartext client: http.client.HTTPConnection(h) (httpclient). Credentials and data travel unencrypted. This lexical rule flags the client; the reviewer migrates to HTTPSConnection.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "cleartext-transmission",
  "remediation": "Migrate to HTTPSConnection.",
  "limitation": "Lexical, line-based: matches the client.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "\\b(?:http\\.client\\.HTTPConnection\\s*\\()"
    }
  ],
  "tests": [
    {
      "line": "http.client.HTTPConnection(h)",
      "match": true
    },
    {
      "line": "# audit: http.client.HTTPConnection(h) present",
      "match": true
    },
    {
      "line": "http.client.HTTPSConnection(h)",
      "match": false
    },
    {
      "line": "# verified: http.client.HTTPSConnection(h)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0762"
  ]
}
