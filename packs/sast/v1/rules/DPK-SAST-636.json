{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-636",
  "title": "Weak proxy or service setting (mlock) — review required",
  "description": "A service weakens transport or trust: disable_mlocks*=s*true (mlock). Disabled TLS, skipped verification, and default credentials expose traffic and control. This lexical rule flags the setting; the reviewer hardens via enabled mlock.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Harden with enabled mlock.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "vault"
  ],
  "patterns": [
    {
      "source": "disable_mlock\\s*=\\s*true"
    }
  ],
  "tests": [
    {
      "line": "disable_mlock = true",
      "match": true
    },
    {
      "line": "# audit: disable_mlock = true present",
      "match": true
    },
    {
      "line": "disable_mlock = false",
      "match": false
    },
    {
      "line": "# verified: disable_mlock = false",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0753"
  ]
}
