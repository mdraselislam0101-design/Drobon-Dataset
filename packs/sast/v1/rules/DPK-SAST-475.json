{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-475",
  "title": "Shell expansion of a variable (varbash) — review required",
  "description": "A shell runs a variable's content: bashs+-cs+\"$ (varbash). Variable content becomes command text. This lexical rule flags the expansion; the reviewer confirms trust or restructures via fixed command lines.",
  "severity": "HIGH",
  "cwe": "CWE-78",
  "category": "command-injection",
  "remediation": "Restructure with fixed command lines.",
  "limitation": "Lexical, line-based: matches the expansion.",
  "languages": [
    "shell"
  ],
  "patterns": [
    {
      "source": "bash\\s+-c\\s+\"\\$"
    }
  ],
  "tests": [
    {
      "line": "bash -c \"$CMD\"",
      "match": true
    },
    {
      "line": "# audit: bash -c \"$CMD\" present",
      "match": true
    },
    {
      "line": "bash -c \"ls\"",
      "match": false
    },
    {
      "line": "# verified: bash -c \"ls\"",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0592"
  ]
}
