{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-519",
  "title": "Open FTP setting (write) — review required",
  "description": "FTP grants anonymous or write access: write_enables*=s*YES (write). Anonymous upload turns the server into a drop box. This lexical rule flags the setting; the reviewer restricts via disabled write.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Restrict with disabled write.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "vsftpd"
  ],
  "patterns": [
    {
      "source": "write_enable\\s*=\\s*YES"
    }
  ],
  "tests": [
    {
      "line": "write_enable=YES",
      "match": true
    },
    {
      "line": "# audit: write_enable=YES present",
      "match": true
    },
    {
      "line": "write_enable=NO",
      "match": false
    },
    {
      "line": "# verified: write_enable=NO",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0636"
  ]
}
