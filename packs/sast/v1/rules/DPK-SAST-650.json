{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-650",
  "title": "Cleartext protocol client (xmlrpc) — review required",
  "description": "Code uses a cleartext client: ServerProxy(\"http://h/x\") (xmlrpc). Credentials and data travel unencrypted. This lexical rule flags the client; the reviewer migrates to https endpoints.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "cleartext-transmission",
  "remediation": "Migrate to https endpoints.",
  "limitation": "Lexical, line-based: matches the client.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "\\b(?:ServerProxy\\s*\\(\\s*\"http:)"
    }
  ],
  "tests": [
    {
      "line": "ServerProxy(\"http://h/x\")",
      "match": true
    },
    {
      "line": "# audit: ServerProxy(\"http://h/x\") present",
      "match": true
    },
    {
      "line": "ServerProxy(\"https://h/x\")",
      "match": false
    },
    {
      "line": "# verified: ServerProxy(\"https://h/x\")",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0767"
  ]
}
