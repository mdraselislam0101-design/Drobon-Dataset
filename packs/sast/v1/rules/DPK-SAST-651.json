{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-651",
  "title": "Rails protection weakened (forgexcept) — review required",
  "description": "Rails weakens a protection: protect_from_forgery except: :create (forgexcept). Local-request errors leak internals, skipped forgery checks invite CSRF. This lexical rule flags the setting; the reviewer restores via full forgery protection.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Restore full forgery protection.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "ruby"
  ],
  "patterns": [
    {
      "source": "\\b(?:protect_from_forgery\\s+except:)"
    }
  ],
  "tests": [
    {
      "line": "protect_from_forgery except: :create",
      "match": true
    },
    {
      "line": "# audit: protect_from_forgery except: :create present",
      "match": true
    },
    {
      "line": "protect_from_forgery with: :exception",
      "match": false
    },
    {
      "line": "# verified: protect_from_forgery with: :exception",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0768"
  ]
}
