{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-635",
  "title": "Weak proxy or service setting (tlsonly) — review required",
  "description": "A service weakens transport or trust: smtpd_tls_auth_only = no (tlsonly). Disabled TLS, skipped verification, and default credentials expose traffic and control. This lexical rule flags the setting; the reviewer hardens via TLS-only auth.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Harden with TLS-only auth.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "postfix"
  ],
  "patterns": [
    {
      "source": "\\b(?:smtpd_tls_auth_only\\s*=\\s*no)"
    }
  ],
  "tests": [
    {
      "line": "smtpd_tls_auth_only = no",
      "match": true
    },
    {
      "line": "# audit: smtpd_tls_auth_only = no present",
      "match": true
    },
    {
      "line": "smtpd_tls_auth_only = yes",
      "match": false
    },
    {
      "line": "# verified: smtpd_tls_auth_only = yes",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0752"
  ]
}
