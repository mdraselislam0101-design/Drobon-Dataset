{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-588",
  "title": "Sensitive value in log call (crystal) — review required",
  "description": "A crystal log call outputs a credential-named value: puts \"password=#{p}\". Logs persist and spread. This lexical rule flags the call; the reviewer confirms non-sensitivity or redacts.",
  "severity": "MEDIUM",
  "cwe": "CWE-532",
  "category": "sensitive-logging",
  "remediation": "Log presence flags instead and scrub historic logs.",
  "limitation": "Lexical, line-based: matches credential-adjacent names.",
  "languages": [
    "crystal"
  ],
  "patterns": [
    {
      "source": "\\b(?:puts\\s+[^\\n]*(?:password|passwd|secret|token))"
    }
  ],
  "tests": [
    {
      "line": "puts \"password=#{p}\"",
      "match": true
    },
    {
      "line": "# audit: puts \"password=#{p}\" present",
      "match": true
    },
    {
      "line": "puts \"user=#{u}\"",
      "match": false
    },
    {
      "line": "# verified: puts \"user=#{u}\"",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0705"
  ]
}
