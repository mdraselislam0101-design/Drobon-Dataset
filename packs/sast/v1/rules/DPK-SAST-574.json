{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-574",
  "title": "Permissive Kubernetes pod (escalate) — review required",
  "description": "Kubernetes grants host or root power: allowPrivilegeEscalations*:s*true (escalate). Host namespaces, root users, writable roots, and privilege escalation erase pod isolation. This lexical rule flags the grant; the reviewer removes it via no escalation.",
  "severity": "HIGH",
  "cwe": "CWE-284",
  "category": "container-security",
  "remediation": "Remove or use no escalation.",
  "limitation": "Lexical, line-based: matches the grant.",
  "languages": [
    "k8s"
  ],
  "patterns": [
    {
      "source": "allowPrivilegeEscalation\\s*:\\s*true"
    }
  ],
  "tests": [
    {
      "line": "allowPrivilegeEscalation: true",
      "match": true
    },
    {
      "line": "# audit: allowPrivilegeEscalation: true present",
      "match": true
    },
    {
      "line": "allowPrivilegeEscalation: false",
      "match": false
    },
    {
      "line": "# verified: allowPrivilegeEscalation: false",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0691"
  ]
}
