{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-554",
  "title": "TLS trust weakened (httpurl) — review required",
  "description": "TLS trust is weakened: new URL(\"http://h/x\") (httpurl). Disabled checks and fixed secrets let attackers impersonate servers or authenticate. This lexical rule flags the weakness; the reviewer restores https URLs.",
  "severity": "HIGH",
  "cwe": "CWE-295",
  "category": "transport-security",
  "remediation": "Restore https URLs.",
  "limitation": "Lexical, line-based: matches the weakness.",
  "languages": [
    "java"
  ],
  "patterns": [
    {
      "source": "\\b(?:new\\s+URL\\s*\\(\\s*\"http:)"
    }
  ],
  "tests": [
    {
      "line": "new URL(\"http://h/x\")",
      "match": true
    },
    {
      "line": "# audit: new URL(\"http://h/x\") present",
      "match": true
    },
    {
      "line": "new URL(\"https://h/x\")",
      "match": false
    },
    {
      "line": "# verified: new URL(\"https://h/x\")",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0671"
  ]
}
