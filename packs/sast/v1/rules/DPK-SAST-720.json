{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-720",
  "title": "TLS verification disabled (verify) — review required",
  "description": "TLS verification is switched off: require_ssl_verifications*=s*false (verify). Any certificate is then trusted. This lexical rule flags the switch; the reviewer restores verified TLS.",
  "severity": "HIGH",
  "cwe": "CWE-295",
  "category": "transport-security",
  "remediation": "Restore verified TLS.",
  "limitation": "Lexical, line-based: matches the switch regardless of environment.",
  "languages": [
    "julia"
  ],
  "patterns": [
    {
      "source": "require_ssl_verification\\s*=\\s*false"
    }
  ],
  "tests": [
    {
      "line": "HTTP.get(u; require_ssl_verification=false)",
      "match": true
    },
    {
      "line": "# audit: HTTP.get(u; require_ssl_verification=false) present",
      "match": true
    },
    {
      "line": "HTTP.get(u; require_ssl_verification=true)",
      "match": false
    },
    {
      "line": "# verified: HTTP.get(u; require_ssl_verification=true)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0837"
  ]
}
