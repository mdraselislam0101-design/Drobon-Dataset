{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-646",
  "title": "Cleartext protocol client (imap) — review required",
  "description": "Code uses a cleartext client: imaplib.IMAP4(h) (imap). Credentials and data travel unencrypted. This lexical rule flags the client; the reviewer migrates to IMAP4_SSL.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "cleartext-transmission",
  "remediation": "Migrate to IMAP4_SSL.",
  "limitation": "Lexical, line-based: matches the client.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "\\b(?:imaplib\\.IMAP4\\s*\\()"
    }
  ],
  "tests": [
    {
      "line": "imaplib.IMAP4(h)",
      "match": true
    },
    {
      "line": "# audit: imaplib.IMAP4(h) present",
      "match": true
    },
    {
      "line": "imaplib.IMAP4_SSL(h)",
      "match": false
    },
    {
      "line": "# verified: imaplib.IMAP4_SSL(h)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0763"
  ]
}
