{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-552",
  "title": "TLS trust weakened (changeit) — review required",
  "description": "TLS trust is weakened: ks.load(in, \"changeit\".toCharArray()) (changeit). Disabled checks and fixed secrets let attackers impersonate servers or authenticate. This lexical rule flags the weakness; the reviewer restores a managed password.",
  "severity": "HIGH",
  "cwe": "CWE-295",
  "category": "transport-security",
  "remediation": "Restore a managed password.",
  "limitation": "Lexical, line-based: matches the weakness.",
  "languages": [
    "java"
  ],
  "patterns": [
    {
      "source": "\\b(?:load\\s*\\([^)]*\"changeit\")"
    }
  ],
  "tests": [
    {
      "line": "ks.load(in, \"changeit\".toCharArray())",
      "match": true
    },
    {
      "line": "# audit: ks.load(in, \"changeit\".toCharArray()) present",
      "match": true
    },
    {
      "line": "ks.load(in, pw)",
      "match": false
    },
    {
      "line": "# verified: ks.load(in, pw)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0669"
  ]
}
