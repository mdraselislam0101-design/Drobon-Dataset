{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-540",
  "title": "SnakeYAML unsafe load (java) — review required",
  "description": "SnakeYAML loads untrusted documents: new Yamls*(s*)s*.loads*(. Unsafe constructors instantiate arbitrary classes. This lexical rule flags the load; the reviewer confirms trust or uses SafeConstructor.",
  "severity": "HIGH",
  "cwe": "CWE-502",
  "category": "unsafe-deserialization",
  "remediation": "Use SafeConstructor.",
  "limitation": "Lexical, line-based: matches the load.",
  "languages": [
    "java"
  ],
  "patterns": [
    {
      "source": "new Yaml\\s*\\(\\s*\\)\\s*\\.load\\s*\\("
    }
  ],
  "tests": [
    {
      "line": "new Yaml().load(doc)",
      "match": true
    },
    {
      "line": "# audit: new Yaml().load(doc) present",
      "match": true
    },
    {
      "line": "new Yaml(safe).load(doc)",
      "match": false
    },
    {
      "line": "# verified: new Yaml(safe).load(doc)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0657"
  ]
}
