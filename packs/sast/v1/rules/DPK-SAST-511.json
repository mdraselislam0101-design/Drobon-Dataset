{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-511",
  "title": "ECB mode selected (ecb) — review required",
  "description": "Encryption uses ECB mode: /ECB (ecb). ECB leaks plaintext patterns. This lexical rule flags the selection; the reviewer migrates to CBC or GCM.",
  "severity": "MEDIUM",
  "cwe": "CWE-327",
  "category": "weak-cryptography",
  "remediation": "Migrate to CBC or GCM.",
  "limitation": "Lexical, line-based: matches the mode name.",
  "languages": [
    "java"
  ],
  "patterns": [
    {
      "source": "/ECB"
    }
  ],
  "tests": [
    {
      "line": "Cipher.getInstance(\"AES/ECB/PKCS5Padding\")",
      "match": true
    },
    {
      "line": "# audit: Cipher.getInstance(\"AES/ECB/PKCS5Padding\") present",
      "match": true
    },
    {
      "line": "Cipher.getInstance(\"AES/CBC/PKCS5Padding\")",
      "match": false
    },
    {
      "line": "# verified: Cipher.getInstance(\"AES/CBC/PKCS5Padding\")",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0628"
  ]
}
