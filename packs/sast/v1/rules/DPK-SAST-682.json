{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-682",
  "title": "Risky Spring setting (h2) — review required",
  "description": "Spring exposes internals: spring.h2.console.enabled=true (h2). Disabled SSL, open management, verbose health, and the H2 console widen access. This lexical rule flags the setting; the reviewer restricts via a disabled console.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Restrict with a disabled console.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "properties"
  ],
  "patterns": [
    {
      "source": "\\b(?:spring\\.h2\\.console\\.enabled\\s*=\\s*true)"
    }
  ],
  "tests": [
    {
      "line": "spring.h2.console.enabled=true",
      "match": true
    },
    {
      "line": "# audit: spring.h2.console.enabled=true present",
      "match": true
    },
    {
      "line": "spring.h2.console.enabled=false",
      "match": false
    },
    {
      "line": "# verified: spring.h2.console.enabled=false",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0799"
  ]
}
