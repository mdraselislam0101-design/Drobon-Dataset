{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-685",
  "title": "Risky Spring setting (ssl) — review required",
  "description": "Spring exposes internals: server.ssl.enableds*=s*false (ssl). Disabled SSL, open management, verbose health, and the H2 console widen access. This lexical rule flags the setting; the reviewer restricts via enabled SSL.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Restrict with enabled SSL.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "properties"
  ],
  "patterns": [
    {
      "source": "server\\.ssl\\.enabled\\s*=\\s*false"
    }
  ],
  "tests": [
    {
      "line": "server.ssl.enabled=false",
      "match": true
    },
    {
      "line": "# audit: server.ssl.enabled=false present",
      "match": true
    },
    {
      "line": "server.ssl.enabled=true",
      "match": false
    },
    {
      "line": "# verified: server.ssl.enabled=true",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0802"
  ]
}
