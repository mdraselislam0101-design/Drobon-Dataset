{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-522",
  "title": "Risky GitHub Actions step (setoutput) — review required",
  "description": "A workflow takes a risky shortcut: ::set-output (setoutput). Mutable action refs, broad tokens, deprecated commands, and self-hosted runners widen supply-chain impact. This lexical rule flags the step; the reviewer hardens via GITHUB_OUTPUT files.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "ci-security",
  "remediation": "Harden with GITHUB_OUTPUT files.",
  "limitation": "Lexical, line-based: matches the step.",
  "languages": [
    "gha"
  ],
  "patterns": [
    {
      "source": "::set-output"
    }
  ],
  "tests": [
    {
      "line": "echo \"::set-output name=x::1\"",
      "match": true
    },
    {
      "line": "# audit: echo \"::set-output name=x::1\" present",
      "match": true
    },
    {
      "line": "echo \"x=1\" >> $GITHUB_OUTPUT",
      "match": false
    },
    {
      "line": "# verified: echo \"x=1\" >> $GITHUB_OUTPUT",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0639"
  ]
}
