{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-580",
  "title": "Permissive Kubernetes pod (nonroot) — review required",
  "description": "Kubernetes grants host or root power: runAsNonRoots*:s*false (nonroot). Host namespaces, root users, writable roots, and privilege escalation erase pod isolation. This lexical rule flags the grant; the reviewer removes it via runAsNonRoot true.",
  "severity": "HIGH",
  "cwe": "CWE-284",
  "category": "container-security",
  "remediation": "Remove or use runAsNonRoot true.",
  "limitation": "Lexical, line-based: matches the grant.",
  "languages": [
    "k8s"
  ],
  "patterns": [
    {
      "source": "runAsNonRoot\\s*:\\s*false"
    }
  ],
  "tests": [
    {
      "line": "runAsNonRoot: false",
      "match": true
    },
    {
      "line": "# audit: runAsNonRoot: false present",
      "match": true
    },
    {
      "line": "runAsNonRoot: true",
      "match": false
    },
    {
      "line": "# verified: runAsNonRoot: true",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0697"
  ]
}
