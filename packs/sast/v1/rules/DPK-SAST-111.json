{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-111",
  "title": "Flask session cookie without Secure (python) — review required",
  "description": "Flask session cookies may travel over HTTP: app.config[\"SESSION_COOKIE_SECURE\"] = False. Network observers steal the session. This lexical rule flags the setting; the reviewer enables SESSION_COOKIE_SECURE True.",
  "severity": "MEDIUM",
  "cwe": "CWE-614",
  "category": "cookie-flags",
  "remediation": "Enable SESSION_COOKIE_SECURE True.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "\\b(?:SESSION_COOKIE_SECURE[\"']?\\s*\\]\\s*=\\s*False)"
    }
  ],
  "tests": [
    {
      "line": "app.config[\"SESSION_COOKIE_SECURE\"] = False",
      "match": true
    },
    {
      "line": "# audit: app.config[\"SESSION_COOKIE_SECURE\"] = False present",
      "match": true
    },
    {
      "line": "app.config[\"SESSION_COOKIE_SECURE\"] = True",
      "match": false
    },
    {
      "line": "# verified: app.config[\"SESSION_COOKIE_SECURE\"] = True",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0150"
  ]
}
