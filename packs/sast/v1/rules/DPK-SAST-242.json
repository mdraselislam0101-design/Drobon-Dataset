{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-242",
  "title": "Berkeley r-command use (shell) — review required",
  "description": "Code or scripts use rsh/rlogin: brloginb|brshb. Trust-based, cleartext remote execution. This lexical rule flags the use; the reviewer migrates to SSH.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "cleartext-transmission",
  "remediation": "Migrate to SSH.",
  "limitation": "Lexical, line-based: matches the command name.",
  "languages": [
    "shell"
  ],
  "patterns": [
    {
      "source": "\\brlogin\\b|\\brsh\\b"
    }
  ],
  "tests": [
    {
      "line": "rsh host uptime",
      "match": true
    },
    {
      "line": "# audit: rsh host uptime present",
      "match": true
    },
    {
      "line": "ssh host uptime",
      "match": false
    },
    {
      "line": "# verified: ssh host uptime",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0281"
  ]
}
