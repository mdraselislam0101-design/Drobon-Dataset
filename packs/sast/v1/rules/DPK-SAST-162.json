{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-162",
  "title": "Sensitive value in log call (r) — review required",
  "description": "A r log call outputs a credential-named value: message(\"password=\", pw). Logs persist and spread. This lexical rule flags the call; the reviewer confirms non-sensitivity or redacts.",
  "severity": "MEDIUM",
  "cwe": "CWE-532",
  "category": "sensitive-logging",
  "remediation": "Log presence flags instead and scrub historic logs.",
  "limitation": "Lexical, line-based: matches credential-adjacent names.",
  "languages": [
    "r"
  ],
  "patterns": [
    {
      "source": "\\b(?:(?:message|cat)\\s*\\([^)]*(?:password|passwd|secret|token))"
    }
  ],
  "tests": [
    {
      "line": "message(\"password=\", pw)",
      "match": true
    },
    {
      "line": "# audit: message(\"password=\", pw) present",
      "match": true
    },
    {
      "line": "message(\"user=\", u)",
      "match": false
    },
    {
      "line": "# verified: message(\"user=\", u)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0201"
  ]
}
