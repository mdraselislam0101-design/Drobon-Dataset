{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-517",
  "title": "Open FTP setting (shell) — review required",
  "description": "FTP grants anonymous or write access: RequireValidShells+off (shell). Anonymous upload turns the server into a drop box. This lexical rule flags the setting; the reviewer restricts via required valid shells.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Restrict with required valid shells.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "proftpd"
  ],
  "patterns": [
    {
      "source": "RequireValidShell\\s+off"
    }
  ],
  "tests": [
    {
      "line": "RequireValidShell off",
      "match": true
    },
    {
      "line": "# audit: RequireValidShell off present",
      "match": true
    },
    {
      "line": "RequireValidShell on",
      "match": false
    },
    {
      "line": "# verified: RequireValidShell on",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0634"
  ]
}
