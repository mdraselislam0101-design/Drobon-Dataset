{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-591",
  "title": "Sensitive value in log call (nim) — review required",
  "description": "A nim log call outputs a credential-named value: echo \"password=\", p. Logs persist and spread. This lexical rule flags the call; the reviewer confirms non-sensitivity or redacts.",
  "severity": "MEDIUM",
  "cwe": "CWE-532",
  "category": "sensitive-logging",
  "remediation": "Log presence flags instead and scrub historic logs.",
  "limitation": "Lexical, line-based: matches credential-adjacent names.",
  "languages": [
    "nim"
  ],
  "patterns": [
    {
      "source": "\\b(?:echo\\s+[^\\n]*(?:password|passwd|secret|token))"
    }
  ],
  "tests": [
    {
      "line": "echo \"password=\", p",
      "match": true
    },
    {
      "line": "# audit: echo \"password=\", p present",
      "match": true
    },
    {
      "line": "echo \"user=\", u",
      "match": false
    },
    {
      "line": "# verified: echo \"user=\", u",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0708"
  ]
}
