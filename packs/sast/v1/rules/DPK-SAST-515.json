{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-515",
  "title": "Risky Express setting (dotfiles) — review required",
  "description": "Express trusts broadly: dotfiles: \"allow\" (dotfiles). Served dotfiles leak secrets; trusted proxies let clients spoof addresses. This lexical rule flags the setting; the reviewer narrows via denied dotfiles.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Narrow with denied dotfiles.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "javascript"
  ],
  "patterns": [
    {
      "source": "\\b(?:dotfiles\\s*:\\s*[\"']allow[\"'])"
    }
  ],
  "tests": [
    {
      "line": "dotfiles: \"allow\"",
      "match": true
    },
    {
      "line": "# audit: dotfiles: \"allow\" present",
      "match": true
    },
    {
      "line": "dotfiles: \"deny\"",
      "match": false
    },
    {
      "line": "# verified: dotfiles: \"deny\"",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0632"
  ]
}
