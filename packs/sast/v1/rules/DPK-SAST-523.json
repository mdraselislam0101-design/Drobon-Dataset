{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-523",
  "title": "Risky GitHub Actions step (unpinned) — review required",
  "description": "A workflow takes a risky shortcut: uses: actions/checkout@v4 (unpinned). Mutable action refs, broad tokens, deprecated commands, and self-hosted runners widen supply-chain impact. This lexical rule flags the step; the reviewer hardens via pinned SHAs.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "ci-security",
  "remediation": "Harden with pinned SHAs.",
  "limitation": "Lexical, line-based: matches the step.",
  "languages": [
    "gha"
  ],
  "patterns": [
    {
      "source": "\\b(?:uses\\s*:\\s*[^:\\n]+@(?:main|master|v[0-9]+)\\b)"
    }
  ],
  "tests": [
    {
      "line": "uses: actions/checkout@v4",
      "match": true
    },
    {
      "line": "# audit: uses: actions/checkout@v4 present",
      "match": true
    },
    {
      "line": "uses: actions/checkout@a5ac7e51b41094c92402da3b243769053744a45e2",
      "match": false
    },
    {
      "line": "# verified: uses: actions/checkout@a5ac7e51b41094c92402da3b243769053744a45e2",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0640"
  ]
}
