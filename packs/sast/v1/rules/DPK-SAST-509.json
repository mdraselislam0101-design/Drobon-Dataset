{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-509",
  "title": "Open DNS resolver (access) — review required",
  "description": "DNS answers the world: access-control: 0.0.0.0/0 allow (access). Open recursion fuels amplification attacks. This lexical rule flags the setting; the reviewer scopes via scoped access-control.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Scope with scoped access-control.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "unbound"
  ],
  "patterns": [
    {
      "source": "\\b(?:access-control\\s*:\\s*0\\.0\\.0\\.0/0\\s+allow)"
    }
  ],
  "tests": [
    {
      "line": "access-control: 0.0.0.0/0 allow",
      "match": true
    },
    {
      "line": "# audit: access-control: 0.0.0.0/0 allow present",
      "match": true
    },
    {
      "line": "access-control: 10.0.0.0/8 allow",
      "match": false
    },
    {
      "line": "# verified: access-control: 10.0.0.0/8 allow",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0626"
  ]
}
