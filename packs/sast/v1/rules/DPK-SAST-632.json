{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-632",
  "title": "Weak proxy or service setting (disable) — review required",
  "description": "A service weakens transport or trust: mode: DISABLE (disable). Disabled TLS, skipped verification, and default credentials expose traffic and control. This lexical rule flags the setting; the reviewer hardens via STRICT mTLS.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Harden with STRICT mTLS.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "istio"
  ],
  "patterns": [
    {
      "source": "\\b(?:mode\\s*:\\s*DISABLE)"
    }
  ],
  "tests": [
    {
      "line": "mode: DISABLE",
      "match": true
    },
    {
      "line": "# audit: mode: DISABLE present",
      "match": true
    },
    {
      "line": "mode: STRICT",
      "match": false
    },
    {
      "line": "# verified: mode: STRICT",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0749"
  ]
}
