{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-724",
  "title": "Umask cleared to zero (go) — review required",
  "description": "The process clears its umask: syscall.Umasks*(s*0b. New files then keep group and world permissions. This lexical rule flags the clearing; the reviewer restores a 022 or tighter mask.",
  "severity": "MEDIUM",
  "cwe": "CWE-732",
  "category": "permissions",
  "remediation": "Restore a 022 or tighter mask.",
  "limitation": "Lexical, line-based: matches the clearing.",
  "languages": [
    "go"
  ],
  "patterns": [
    {
      "source": "syscall\\.Umask\\s*\\(\\s*0\\b"
    }
  ],
  "tests": [
    {
      "line": "syscall.Umask(0)",
      "match": true
    },
    {
      "line": "# audit: syscall.Umask(0) present",
      "match": true
    },
    {
      "line": "syscall.Umask(022)",
      "match": false
    },
    {
      "line": "# verified: syscall.Umask(022)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0841"
  ]
}
