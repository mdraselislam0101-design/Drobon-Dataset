{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-587",
  "title": "Sensitive value in log call (cobol) — review required",
  "description": "A cobol log call outputs a credential-named value: DISPLAY \"password: \" p. Logs persist and spread. This lexical rule flags the call; the reviewer confirms non-sensitivity or redacts.",
  "severity": "MEDIUM",
  "cwe": "CWE-532",
  "category": "sensitive-logging",
  "remediation": "Log presence flags instead and scrub historic logs.",
  "limitation": "Lexical, line-based: matches credential-adjacent names.",
  "languages": [
    "cobol"
  ],
  "patterns": [
    {
      "source": "\\b(?:DISPLAY\\s+[^\\n]*(?:password|passwd|secret|token))"
    }
  ],
  "tests": [
    {
      "line": "DISPLAY \"password: \" p",
      "match": true
    },
    {
      "line": "# audit: DISPLAY \"password: \" p present",
      "match": true
    },
    {
      "line": "DISPLAY \"user: \" u",
      "match": false
    },
    {
      "line": "# verified: DISPLAY \"user: \" u",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0704"
  ]
}
