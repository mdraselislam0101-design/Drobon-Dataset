{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-163",
  "title": "Sensitive value in log call (rust) — review required",
  "description": "A rust log call outputs a credential-named value: info!(\"token={}\", t). Logs persist and spread. This lexical rule flags the call; the reviewer confirms non-sensitivity or redacts.",
  "severity": "MEDIUM",
  "cwe": "CWE-532",
  "category": "sensitive-logging",
  "remediation": "Log presence flags instead and scrub historic logs.",
  "limitation": "Lexical, line-based: matches credential-adjacent names.",
  "languages": [
    "rust"
  ],
  "patterns": [
    {
      "source": "\\b(?:info!\\s*\\([^)]*(?:password|passwd|secret|token))"
    }
  ],
  "tests": [
    {
      "line": "info!(\"token={}\", t)",
      "match": true
    },
    {
      "line": "# audit: info!(\"token={}\", t) present",
      "match": true
    },
    {
      "line": "info!(\"user={}\", u)",
      "match": false
    },
    {
      "line": "# verified: info!(\"user={}\", u)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0202"
  ]
}
