{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-407",
  "title": "Debug or management exposure (graphql) — review required",
  "description": "graphql exposes introspection or management: introspections*:s*true. Introspection leaks schema; open actuators leak health, config, and dumps. This lexical rule flags the exposure; the reviewer restricts via disabled introspection.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Restrict with disabled introspection.",
  "limitation": "Lexical, line-based: matches the exposure.",
  "languages": [
    "javascript"
  ],
  "patterns": [
    {
      "source": "introspection\\s*:\\s*true"
    }
  ],
  "tests": [
    {
      "line": "introspection: true",
      "match": true
    },
    {
      "line": "# audit: introspection: true present",
      "match": true
    },
    {
      "line": "introspection: false",
      "match": false
    },
    {
      "line": "# verified: introspection: false",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0446"
  ]
}
