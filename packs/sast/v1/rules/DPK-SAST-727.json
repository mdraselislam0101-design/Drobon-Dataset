{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-727",
  "title": "Umask cleared to zero (ruby) — review required",
  "description": "The process clears its umask: File.umasks*(s*0s*). New files then keep group and world permissions. This lexical rule flags the clearing; the reviewer restores a 022 or tighter mask.",
  "severity": "MEDIUM",
  "cwe": "CWE-732",
  "category": "permissions",
  "remediation": "Restore a 022 or tighter mask.",
  "limitation": "Lexical, line-based: matches the clearing.",
  "languages": [
    "ruby"
  ],
  "patterns": [
    {
      "source": "File\\.umask\\s*\\(\\s*0\\s*\\)"
    }
  ],
  "tests": [
    {
      "line": "File.umask(0)",
      "match": true
    },
    {
      "line": "# audit: File.umask(0) present",
      "match": true
    },
    {
      "line": "File.umask(022)",
      "match": false
    },
    {
      "line": "# verified: File.umask(022)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0844"
  ]
}
