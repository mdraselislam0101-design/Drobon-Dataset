{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-619",
  "title": "PHP session exposure (sesssecure) — review required",
  "description": "PHP sessions travel insecurely: session.cookie_secures*=s*0b (sesssecure). Cookies without Secure or HttpOnly leak over HTTP and to scripts; URL session ids leak through links. This lexical rule flags the setting; the reviewer hardens via secure session cookies.",
  "severity": "MEDIUM",
  "cwe": "CWE-614",
  "category": "session-security",
  "remediation": "Harden with secure session cookies.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "ini"
  ],
  "patterns": [
    {
      "source": "session\\.cookie_secure\\s*=\\s*0\\b"
    }
  ],
  "tests": [
    {
      "line": "session.cookie_secure = 0",
      "match": true
    },
    {
      "line": "# audit: session.cookie_secure = 0 present",
      "match": true
    },
    {
      "line": "session.cookie_secure = 1",
      "match": false
    },
    {
      "line": "# verified: session.cookie_secure = 1",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0736"
  ]
}
