{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-726",
  "title": "Umask cleared to zero (python) — review required",
  "description": "The process clears its umask: os.umasks*(s*0s*). New files then keep group and world permissions. This lexical rule flags the clearing; the reviewer restores a 0o022 or tighter mask.",
  "severity": "MEDIUM",
  "cwe": "CWE-732",
  "category": "permissions",
  "remediation": "Restore a 0o022 or tighter mask.",
  "limitation": "Lexical, line-based: matches the clearing.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "os\\.umask\\s*\\(\\s*0\\s*\\)"
    }
  ],
  "tests": [
    {
      "line": "os.umask(0)",
      "match": true
    },
    {
      "line": "# audit: os.umask(0) present",
      "match": true
    },
    {
      "line": "os.umask(0o022)",
      "match": false
    },
    {
      "line": "# verified: os.umask(0o022)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0843"
  ]
}
