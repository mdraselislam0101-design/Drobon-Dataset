{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-655",
  "title": "Predictable randomness via :rand.uniform(payload) (elixir) — review required",
  "description": "The elixir call :rand.uniform(payload) draws predictable values. Security uses need :crypto.strong_rand_bytes. This lexical rule flags the call; the reviewer confirms a statistical use.",
  "severity": "LOW",
  "cwe": "CWE-330",
  "category": "weak-cryptography",
  "remediation": "Use :crypto.strong_rand_bytes for security values.",
  "limitation": "Lexical, line-based: matches any :rand.uniform(payload) call.",
  "languages": [
    "elixir"
  ],
  "patterns": [
    {
      "source": "\\b(?:rand\\.uniform)\\s*\\("
    }
  ],
  "tests": [
    {
      "line": ":rand.uniform(payload)",
      "match": true
    },
    {
      "line": "out = :rand.uniform(data)",
      "match": true
    },
    {
      "line": "myranduniform(x)",
      "match": false
    },
    {
      "line": ":rand.uniform_safe()",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0772"
  ]
}
