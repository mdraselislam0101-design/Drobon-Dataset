{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-507",
  "title": "Open DNS resolver (allowquery) — review required",
  "description": "DNS answers the world: allow-querys*{s*any (allowquery). Open recursion fuels amplification attacks. This lexical rule flags the setting; the reviewer scopes via scoped query ACLs.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Scope with scoped query ACLs.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "bind"
  ],
  "patterns": [
    {
      "source": "allow-query\\s*\\{\\s*any"
    }
  ],
  "tests": [
    {
      "line": "allow-query { any; };",
      "match": true
    },
    {
      "line": "# audit: allow-query { any; }; present",
      "match": true
    },
    {
      "line": "allow-query { local; };",
      "match": false
    },
    {
      "line": "# verified: allow-query { local; };",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0624"
  ]
}
