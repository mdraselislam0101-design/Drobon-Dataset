{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-633",
  "title": "Weak proxy or service setting (default) — review required",
  "description": "A service weakens transport or trust: MINIO_ROOT_PASSWORD=minioadmin (default). Disabled TLS, skipped verification, and default credentials expose traffic and control. This lexical rule flags the setting; the reviewer hardens via a generated password.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Harden with a generated password.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "minio"
  ],
  "patterns": [
    {
      "source": "\\b(?:MINIO_ROOT_PASSWORD\\s*=\\s*minioadmin)"
    }
  ],
  "tests": [
    {
      "line": "MINIO_ROOT_PASSWORD=minioadmin",
      "match": true
    },
    {
      "line": "# audit: MINIO_ROOT_PASSWORD=minioadmin present",
      "match": true
    },
    {
      "line": "MINIO_ROOT_PASSWORD=${MANAGED}",
      "match": false
    },
    {
      "line": "# verified: MINIO_ROOT_PASSWORD=${MANAGED}",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0750"
  ]
}
