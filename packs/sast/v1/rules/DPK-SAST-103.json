{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-103",
  "title": "Script evaluation of a variable (tcl) — review required",
  "description": "A tcl script evaluates a variable: eval $x. Variable content becomes running code. This lexical rule flags the evaluation; the reviewer confirms trust or restructures it.",
  "severity": "HIGH",
  "cwe": "CWE-95",
  "category": "code-injection",
  "remediation": "Replace evaluation with direct commands.",
  "limitation": "Lexical, line-based: matches variable evaluation.",
  "languages": [
    "tcl"
  ],
  "patterns": [
    {
      "source": "\\b(?:eval\\s+\\$)"
    }
  ],
  "tests": [
    {
      "line": "eval $x",
      "match": true
    },
    {
      "line": "# audit: eval $x present",
      "match": true
    },
    {
      "line": "set y $x",
      "match": false
    },
    {
      "line": "# verified: set y $x",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0142"
  ]
}
