{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-711",
  "title": "Weak Terraform setting (authread) — review required",
  "description": "Terraform weakens protection: acls*=s*\"authenticated-read\" (authread). Ignored drift, local execution, skipped snapshots, public databases, and cleartext secrets widen blast radius. This lexical rule flags the setting; the reviewer hardens via private ACLs.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Harden with private ACLs.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "terraform"
  ],
  "patterns": [
    {
      "source": "acl\\s*=\\s*\"authenticated-read\""
    }
  ],
  "tests": [
    {
      "line": "acl = \"authenticated-read\"",
      "match": true
    },
    {
      "line": "# audit: acl = \"authenticated-read\" present",
      "match": true
    },
    {
      "line": "acl = \"private\"",
      "match": false
    },
    {
      "line": "# verified: acl = \"private\"",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0828"
  ]
}
