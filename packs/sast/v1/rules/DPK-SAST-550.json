{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-550",
  "title": "Java shell process (java) — review required",
  "description": "Java launches an explicit shell: new ProcessBuilder(\"/bin/sh\", c). Shell arguments reintroduce injection. This lexical rule flags the launch; the reviewer uses direct execution via direct binaries with args.",
  "severity": "HIGH",
  "cwe": "CWE-78",
  "category": "command-injection",
  "remediation": "Use direct binaries with args.",
  "limitation": "Lexical, line-based: matches the launch.",
  "languages": [
    "java"
  ],
  "patterns": [
    {
      "source": "\\b(?:new ProcessBuilder\\s*\\(\\s*\"/bin/sh\")"
    }
  ],
  "tests": [
    {
      "line": "new ProcessBuilder(\"/bin/sh\", c)",
      "match": true
    },
    {
      "line": "# audit: new ProcessBuilder(\"/bin/sh\", c) present",
      "match": true
    },
    {
      "line": "new ProcessBuilder(cmd)",
      "match": false
    },
    {
      "line": "# verified: new ProcessBuilder(cmd)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0667"
  ]
}
