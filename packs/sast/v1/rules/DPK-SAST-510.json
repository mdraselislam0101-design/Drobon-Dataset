{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-510",
  "title": "ECB mode selected (ecb, csharp) — review required",
  "description": "Encryption uses ECB mode: CipherMode.ECB (ecb). ECB leaks plaintext patterns. This lexical rule flags the selection; the reviewer migrates to an AEAD mode.",
  "severity": "MEDIUM",
  "cwe": "CWE-327",
  "category": "weak-cryptography",
  "remediation": "Migrate to an AEAD mode.",
  "limitation": "Lexical, line-based: matches the mode name.",
  "languages": [
    "csharp"
  ],
  "patterns": [
    {
      "source": "\\b(?:CipherMode\\.ECB)"
    }
  ],
  "tests": [
    {
      "line": "CipherMode.ECB",
      "match": true
    },
    {
      "line": "# audit: CipherMode.ECB present",
      "match": true
    },
    {
      "line": "CipherMode.CBC",
      "match": false
    },
    {
      "line": "# verified: CipherMode.CBC",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0627"
  ]
}
