{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-229",
  "title": "PHP version exposure (php) — review required",
  "description": "PHP advertises its version in responses: expose_phps*=s*(?:On|1). Banners speed targeted attacks. This lexical rule flags the switch; the reviewer quiets it via expose_php = Off.",
  "severity": "LOW",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Set expose_php = Off.",
  "limitation": "Lexical, line-based: matches the switch.",
  "languages": [
    "php"
  ],
  "patterns": [
    {
      "source": "expose_php\\s*=\\s*(?:On|1)"
    }
  ],
  "tests": [
    {
      "line": "expose_php = On",
      "match": true
    },
    {
      "line": "# audit: expose_php = On present",
      "match": true
    },
    {
      "line": "expose_php = Off",
      "match": false
    },
    {
      "line": "# verified: expose_php = Off",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0268"
  ]
}
