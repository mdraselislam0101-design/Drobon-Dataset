{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-714",
  "title": "Weak Terraform setting (localexec) — review required",
  "description": "Terraform weakens protection: provisioners+\"local-exec\" (localexec). Ignored drift, local execution, skipped snapshots, public databases, and cleartext secrets widen blast radius. This lexical rule flags the setting; the reviewer hardens via no local-exec.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Harden with no local-exec.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "terraform"
  ],
  "patterns": [
    {
      "source": "provisioner\\s+\"local-exec\""
    }
  ],
  "tests": [
    {
      "line": "provisioner \"local-exec\"",
      "match": true
    },
    {
      "line": "# audit: provisioner \"local-exec\" present",
      "match": true
    },
    {
      "line": "# provisioner removed",
      "match": false
    },
    {
      "line": "# verified: # provisioner removed",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0831"
  ]
}
