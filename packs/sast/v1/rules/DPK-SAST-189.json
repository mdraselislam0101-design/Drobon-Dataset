{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-189",
  "title": "Mobile cleartext traffic allowed (nsallows) — review required",
  "description": "The manifest allows cleartext traffic: NSAllowsArbitraryLoads (nsallows). App traffic becomes observable and modifiable. This lexical rule flags the flag; the reviewer confirms necessity or restores TLS via domain exceptions only.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "mobile-security",
  "remediation": "Apply domain exceptions only.",
  "limitation": "Lexical, line-based: matches the flag.",
  "languages": [
    "xml"
  ],
  "patterns": [
    {
      "source": "NSAllowsArbitraryLoads"
    }
  ],
  "tests": [
    {
      "line": "<key>NSAllowsArbitraryLoads</key>",
      "match": true
    },
    {
      "line": "# audit: <key>NSAllowsArbitraryLoads</key> present",
      "match": true
    },
    {
      "line": "<key>NSAllowsLocalNetworking</key>",
      "match": false
    },
    {
      "line": "# verified: <key>NSAllowsLocalNetworking</key>",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0228"
  ]
}
