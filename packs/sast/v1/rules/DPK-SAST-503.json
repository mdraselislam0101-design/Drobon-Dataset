{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-503",
  "title": "Django security setting off (djhsts) — review required",
  "description": "Django disables a security control: SECURE_HSTS_SECONDSs*=s*0b (djhsts). Insecure cookies, no HTTPS redirect, no HSTS, and MD5 hashing weaken the app. This lexical rule flags the setting; the reviewer enables via a long HSTS age.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Enable a long HSTS age.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "SECURE_HSTS_SECONDS\\s*=\\s*0\\b"
    }
  ],
  "tests": [
    {
      "line": "SECURE_HSTS_SECONDS = 0",
      "match": true
    },
    {
      "line": "# audit: SECURE_HSTS_SECONDS = 0 present",
      "match": true
    },
    {
      "line": "SECURE_HSTS_SECONDS = 31536000",
      "match": false
    },
    {
      "line": "# verified: SECURE_HSTS_SECONDS = 31536000",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0620"
  ]
}
