{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-713",
  "title": "Weak Terraform setting (ignoreall) — review required",
  "description": "Terraform weakens protection: ignore_changess*=s*all (ignoreall). Ignored drift, local execution, skipped snapshots, public databases, and cleartext secrets widen blast radius. This lexical rule flags the setting; the reviewer hardens via scoped ignores.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Harden with scoped ignores.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "terraform"
  ],
  "patterns": [
    {
      "source": "ignore_changes\\s*=\\s*all"
    }
  ],
  "tests": [
    {
      "line": "ignore_changes = all",
      "match": true
    },
    {
      "line": "# audit: ignore_changes = all present",
      "match": true
    },
    {
      "line": "ignore_changes = [tags]",
      "match": false
    },
    {
      "line": "# verified: ignore_changes = [tags]",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0830"
  ]
}
