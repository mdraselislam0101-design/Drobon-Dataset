{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-474",
  "title": "Shell expansion of a variable (varexpand) — review required",
  "description": "A shell runs a variable's content: cmd /c %CMD% (varexpand). Variable content becomes command text. This lexical rule flags the expansion; the reviewer confirms trust or restructures via fixed command lines.",
  "severity": "HIGH",
  "cwe": "CWE-78",
  "category": "command-injection",
  "remediation": "Restructure with fixed command lines.",
  "limitation": "Lexical, line-based: matches the expansion.",
  "languages": [
    "cmd"
  ],
  "patterns": [
    {
      "source": "\\b(?:cmd\\s*/[cC]\\s+[^\\n]*%[A-Za-z_]+%)"
    }
  ],
  "tests": [
    {
      "line": "cmd /c %CMD%",
      "match": true
    },
    {
      "line": "# audit: cmd /c %CMD% present",
      "match": true
    },
    {
      "line": "cmd /c dir",
      "match": false
    },
    {
      "line": "# verified: cmd /c dir",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0591"
  ]
}
