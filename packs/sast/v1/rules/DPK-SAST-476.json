{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-476",
  "title": "Privileged Compose service (net) — review required",
  "description": "Compose grants host-level access: network_mode: host (net). Privileged mode, host namespaces, and root mounts erase container isolation. This lexical rule flags the grant; the reviewer removes it via bridged networking.",
  "severity": "HIGH",
  "cwe": "CWE-284",
  "category": "container-security",
  "remediation": "Remove or use bridged networking.",
  "limitation": "Lexical, line-based: matches the grant.",
  "languages": [
    "compose"
  ],
  "patterns": [
    {
      "source": "\\b(?:network_mode\\s*:\\s*[\"']?host)"
    }
  ],
  "tests": [
    {
      "line": "network_mode: host",
      "match": true
    },
    {
      "line": "# audit: network_mode: host present",
      "match": true
    },
    {
      "line": "network_mode: bridge",
      "match": false
    },
    {
      "line": "# verified: network_mode: bridge",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0593"
  ]
}
