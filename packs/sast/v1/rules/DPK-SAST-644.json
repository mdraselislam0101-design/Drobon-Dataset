{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-644",
  "title": "Cleartext protocol client (ftp) — review required",
  "description": "Code uses a cleartext client: ftplib.FTPs*( (ftp). Credentials and data travel unencrypted. This lexical rule flags the client; the reviewer migrates to FTP_TLS or SFTP.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "cleartext-transmission",
  "remediation": "Migrate to FTP_TLS or SFTP.",
  "limitation": "Lexical, line-based: matches the client.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "ftplib\\.FTP\\s*\\("
    }
  ],
  "tests": [
    {
      "line": "ftplib.FTP(h)",
      "match": true
    },
    {
      "line": "# audit: ftplib.FTP(h) present",
      "match": true
    },
    {
      "line": "ftplib.FTP_TLS(h)",
      "match": false
    },
    {
      "line": "# verified: ftplib.FTP_TLS(h)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0761"
  ]
}
