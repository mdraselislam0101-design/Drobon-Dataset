{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-181",
  "title": "MD5 use via getMD5 (nim) — review required",
  "description": "The nim call getMD5 computes MD5, broken for security uses. This lexical rule flags the call; the reviewer confirms a checksum use or switches to sha256.",
  "severity": "LOW",
  "cwe": "CWE-327",
  "category": "weak-cryptography",
  "remediation": "Use sha256 for security purposes.",
  "limitation": "Lexical, line-based: matches any getMD5 call.",
  "languages": [
    "nim"
  ],
  "patterns": [
    {
      "source": "\\b(?:getMD5)\\s*\\("
    }
  ],
  "tests": [
    {
      "line": "getMD5(payload)",
      "match": true
    },
    {
      "line": "out = getMD5(data)",
      "match": true
    },
    {
      "line": "mygetMD5(x)",
      "match": false
    },
    {
      "line": "getMD5_safe()",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0220"
  ]
}
