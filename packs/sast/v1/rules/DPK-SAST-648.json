{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-648",
  "title": "Cleartext protocol client (smtp) — review required",
  "description": "Code uses a cleartext client: smtplib.SMTPs*( (smtp). Credentials and data travel unencrypted. This lexical rule flags the client; the reviewer migrates to SMTP_SSL or STARTTLS.",
  "severity": "MEDIUM",
  "cwe": "CWE-319",
  "category": "cleartext-transmission",
  "remediation": "Migrate to SMTP_SSL or STARTTLS.",
  "limitation": "Lexical, line-based: matches the client.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "smtplib\\.SMTP\\s*\\("
    }
  ],
  "tests": [
    {
      "line": "smtplib.SMTP(h)",
      "match": true
    },
    {
      "line": "# audit: smtplib.SMTP(h) present",
      "match": true
    },
    {
      "line": "smtplib.SMTP_SSL(h)",
      "match": false
    },
    {
      "line": "# verified: smtplib.SMTP_SSL(h)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0765"
  ]
}
