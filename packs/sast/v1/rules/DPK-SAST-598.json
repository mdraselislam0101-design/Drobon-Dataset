{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-598",
  "title": "Authentication bypass (noauth) — review required",
  "description": "Authentication is bypassed: Defaults !authenticate (noauth). Permit modules, no-auth sudo, and environment-preserving sudo grant access without proof. This lexical rule flags the entry; the reviewer removes it via authenticated sudo.",
  "severity": "HIGH",
  "cwe": "CWE-287",
  "category": "authentication",
  "remediation": "Remove or use authenticated sudo.",
  "limitation": "Lexical, line-based: matches the entry.",
  "languages": [
    "sudo"
  ],
  "patterns": [
    {
      "source": "!authenticate"
    }
  ],
  "tests": [
    {
      "line": "Defaults !authenticate",
      "match": true
    },
    {
      "line": "# audit: Defaults !authenticate present",
      "match": true
    },
    {
      "line": "Defaults authenticate",
      "match": false
    },
    {
      "line": "# verified: Defaults authenticate",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0715"
  ]
}
