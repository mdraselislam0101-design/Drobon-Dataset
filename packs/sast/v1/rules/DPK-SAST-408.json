{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-408",
  "title": "Debug or management exposure (actuator) — review required",
  "description": "actuator exposes introspection or management: endpoints.web.exposure.include=*. Introspection leaks schema; open actuators leak health, config, and dumps. This lexical rule flags the exposure; the reviewer restricts via health-only exposure.",
  "severity": "MEDIUM",
  "cwe": "CWE-200",
  "category": "information-disclosure",
  "remediation": "Restrict with health-only exposure.",
  "limitation": "Lexical, line-based: matches the exposure.",
  "languages": [
    "properties"
  ],
  "patterns": [
    {
      "source": "\\b(?:endpoints\\.web\\.exposure\\.include\\s*=\\s*[\"']?\\*)"
    }
  ],
  "tests": [
    {
      "line": "endpoints.web.exposure.include=*",
      "match": true
    },
    {
      "line": "# audit: endpoints.web.exposure.include=* present",
      "match": true
    },
    {
      "line": "endpoints.web.exposure.include=health",
      "match": false
    },
    {
      "line": "# verified: endpoints.web.exposure.include=health",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0447"
  ]
}
