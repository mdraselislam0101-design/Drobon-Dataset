{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-594",
  "title": "Password never expires (logindefs) — review required",
  "description": "Passwords effectively never expire: PASS_MAX_DAYS 99999. Stale credentials stay valid indefinitely. This lexical rule flags the setting; the reviewer bounds via 90 days or less.",
  "severity": "LOW",
  "cwe": "CWE-613",
  "category": "secure-configuration",
  "remediation": "Bound with 90 days or less.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "logindefs"
  ],
  "patterns": [
    {
      "source": "\\b(?:PASS_MAX_DAYS\\s+99999)"
    }
  ],
  "tests": [
    {
      "line": "PASS_MAX_DAYS 99999",
      "match": true
    },
    {
      "line": "# audit: PASS_MAX_DAYS 99999 present",
      "match": true
    },
    {
      "line": "PASS_MAX_DAYS 90",
      "match": false
    },
    {
      "line": "# verified: PASS_MAX_DAYS 90",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0711"
  ]
}
