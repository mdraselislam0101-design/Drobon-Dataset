{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-640",
  "title": "Dynamic execution via __import__ (python) — review required",
  "description": "The python call __import__ runs commands, code, or native libraries. Untrusted input becomes execution. This lexical rule flags the call; the reviewer confirms trust or replaces it with static imports.",
  "severity": "HIGH",
  "cwe": "CWE-95",
  "category": "code-injection",
  "remediation": "Replace with static imports.",
  "limitation": "Lexical, line-based: any __import__ call matches.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "\\b(?:__import__)\\s*\\("
    }
  ],
  "tests": [
    {
      "line": "__import__(payload)",
      "match": true
    },
    {
      "line": "out = __import__(data)",
      "match": true
    },
    {
      "line": "my__import__(x)",
      "match": false
    },
    {
      "line": "__import___safe()",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0757"
  ]
}
