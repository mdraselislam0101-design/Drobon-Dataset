{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-675",
  "title": "Guest share access (guest) — review required",
  "description": "Samba admits guests: guest ok = yes (guest). Guest shares expose files to anyone on the network. This lexical rule flags the setting; the reviewer restricts via authenticated shares.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "access-control",
  "remediation": "Restrict with authenticated shares.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "samba"
  ],
  "patterns": [
    {
      "source": "\\b(?:guest ok\\s*=\\s*yes)"
    }
  ],
  "tests": [
    {
      "line": "guest ok = yes",
      "match": true
    },
    {
      "line": "# audit: guest ok = yes present",
      "match": true
    },
    {
      "line": "guest ok = no",
      "match": false
    },
    {
      "line": "# verified: guest ok = no",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0792"
  ]
}
