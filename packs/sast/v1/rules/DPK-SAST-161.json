{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-161",
  "title": "Sensitive value in log call (matlab) — review required",
  "description": "A matlab log call outputs a credential-named value: fprintf(\"password=%s\", pw). Logs persist and spread. This lexical rule flags the call; the reviewer confirms non-sensitivity or redacts.",
  "severity": "MEDIUM",
  "cwe": "CWE-532",
  "category": "sensitive-logging",
  "remediation": "Log presence flags instead and scrub historic logs.",
  "limitation": "Lexical, line-based: matches credential-adjacent names.",
  "languages": [
    "matlab"
  ],
  "patterns": [
    {
      "source": "\\b(?:fprintf\\s*\\([^)]*(?:password|passwd|secret|token))"
    }
  ],
  "tests": [
    {
      "line": "fprintf(\"password=%s\", pw)",
      "match": true
    },
    {
      "line": "# audit: fprintf(\"password=%s\", pw) present",
      "match": true
    },
    {
      "line": "fprintf(\"user=%s\", u)",
      "match": false
    },
    {
      "line": "# verified: fprintf(\"user=%s\", u)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0200"
  ]
}
