{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-159",
  "title": "Sensitive value in log call (dart) — review required",
  "description": "A dart log call outputs a credential-named value: print(\"password=$pw\"). Logs persist and spread. This lexical rule flags the call; the reviewer confirms non-sensitivity or redacts.",
  "severity": "MEDIUM",
  "cwe": "CWE-532",
  "category": "sensitive-logging",
  "remediation": "Log presence flags instead and scrub historic logs.",
  "limitation": "Lexical, line-based: matches credential-adjacent names.",
  "languages": [
    "dart"
  ],
  "patterns": [
    {
      "source": "\\b(?:print\\s*\\([^)]*(?:password|passwd|secret|token))"
    }
  ],
  "tests": [
    {
      "line": "print(\"password=$pw\")",
      "match": true
    },
    {
      "line": "# audit: print(\"password=$pw\") present",
      "match": true
    },
    {
      "line": "print(\"user=$u\")",
      "match": false
    },
    {
      "line": "# verified: print(\"user=$u\")",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0198"
  ]
}
