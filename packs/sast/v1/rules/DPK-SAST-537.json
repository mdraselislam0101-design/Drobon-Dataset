{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-537",
  "title": "Legacy digest selected (md5m) — review required",
  "description": "Code selects MD5 or SHA-1: \"x\".md5() (md5m). Both are unsuitable for security uses. This lexical rule flags the selection; the reviewer confirms a checksum or migrates to sha256().",
  "severity": "LOW",
  "cwe": "CWE-327",
  "category": "weak-cryptography",
  "remediation": "Migrate to sha256().",
  "limitation": "Lexical, line-based: matches the selection.",
  "languages": [
    "groovy"
  ],
  "patterns": [
    {
      "source": "\\.md5\\s*\\(\\s*\\)"
    }
  ],
  "tests": [
    {
      "line": "\"x\".md5()",
      "match": true
    },
    {
      "line": "# audit: \"x\".md5() present",
      "match": true
    },
    {
      "line": "\"x\".sha256()",
      "match": false
    },
    {
      "line": "# verified: \"x\".sha256()",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0654"
  ]
}
