{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-506",
  "title": "Django security setting off (djssl) — review required",
  "description": "Django disables a security control: SECURE_SSL_REDIRECTs*=s*False (djssl). Insecure cookies, no HTTPS redirect, no HSTS, and MD5 hashing weaken the app. This lexical rule flags the setting; the reviewer enables via HTTPS redirect.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Enable HTTPS redirect.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "python"
  ],
  "patterns": [
    {
      "source": "SECURE_SSL_REDIRECT\\s*=\\s*False"
    }
  ],
  "tests": [
    {
      "line": "SECURE_SSL_REDIRECT = False",
      "match": true
    },
    {
      "line": "# audit: SECURE_SSL_REDIRECT = False present",
      "match": true
    },
    {
      "line": "SECURE_SSL_REDIRECT = True",
      "match": false
    },
    {
      "line": "# verified: SECURE_SSL_REDIRECT = True",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0623"
  ]
}
