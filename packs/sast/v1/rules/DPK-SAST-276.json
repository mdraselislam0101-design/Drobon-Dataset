{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-276",
  "title": "SHA-1 package use (tcl) — review required",
  "description": "Code in tcl uses the SHA-1 package: sha1::sha1. SHA-1 is deprecated for security uses. This lexical rule flags the use; the reviewer confirms interop or migrates.",
  "severity": "LOW",
  "cwe": "CWE-327",
  "category": "weak-cryptography",
  "remediation": "Migrate to the sha256 package.",
  "limitation": "Lexical, line-based: matches the package name.",
  "languages": [
    "tcl"
  ],
  "patterns": [
    {
      "source": "sha1::sha1"
    }
  ],
  "tests": [
    {
      "line": "sha1::sha1 $x",
      "match": true
    },
    {
      "line": "# audit: sha1::sha1 $x present",
      "match": true
    },
    {
      "line": "sha256::sha256 $x",
      "match": false
    },
    {
      "line": "# verified: sha256::sha256 $x",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0315"
  ]
}
