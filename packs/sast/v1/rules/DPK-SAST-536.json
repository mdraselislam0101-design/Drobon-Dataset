{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-536",
  "title": "Legacy digest selected (sha) — review required",
  "description": "Code selects MD5 or SHA-1: :crypto.hashs*(s*:shab (sha). Both are unsuitable for security uses. This lexical rule flags the selection; the reviewer confirms a checksum or migrates to :sha256.",
  "severity": "LOW",
  "cwe": "CWE-327",
  "category": "weak-cryptography",
  "remediation": "Migrate to :sha256.",
  "limitation": "Lexical, line-based: matches the selection.",
  "languages": [
    "elixir"
  ],
  "patterns": [
    {
      "source": ":crypto\\.hash\\s*\\(\\s*:sha\\b"
    }
  ],
  "tests": [
    {
      "line": ":crypto.hash(:sha, x)",
      "match": true
    },
    {
      "line": "# audit: :crypto.hash(:sha, x) present",
      "match": true
    },
    {
      "line": ":crypto.hash(:sha256, x)",
      "match": false
    },
    {
      "line": "# verified: :crypto.hash(:sha256, x)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0653"
  ]
}
