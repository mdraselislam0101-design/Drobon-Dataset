{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-725",
  "title": "Umask cleared to zero (perl) — review required",
  "description": "The process clears its umask: umask 0. New files then keep group and world permissions. This lexical rule flags the clearing; the reviewer restores a 022 or tighter mask.",
  "severity": "MEDIUM",
  "cwe": "CWE-732",
  "category": "permissions",
  "remediation": "Restore a 022 or tighter mask.",
  "limitation": "Lexical, line-based: matches the clearing.",
  "languages": [
    "perl"
  ],
  "patterns": [
    {
      "source": "\\b(?:umask\\s+0\\b)"
    }
  ],
  "tests": [
    {
      "line": "umask 0",
      "match": true
    },
    {
      "line": "# audit: umask 0 present",
      "match": true
    },
    {
      "line": "umask 022",
      "match": false
    },
    {
      "line": "# verified: umask 022",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0842"
  ]
}
