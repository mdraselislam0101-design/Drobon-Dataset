{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-081",
  "title": "BinaryFormatter instantiation (csharp) — review required",
  "description": "Code instantiates BinaryFormatter: new BinaryFormatter(). Its deserialization executes gadget chains on hostile bytes. This lexical rule flags the instantiation; the reviewer migrates to System.Text.Json.",
  "severity": "HIGH",
  "cwe": "CWE-502",
  "category": "unsafe-deserialization",
  "remediation": "Migrate to System.Text.Json.",
  "limitation": "Lexical, line-based: matches instantiation.",
  "languages": [
    "csharp"
  ],
  "patterns": [
    {
      "source": "\\b(?:new\\s+BinaryFormatter\\s*\\()"
    }
  ],
  "tests": [
    {
      "line": "new BinaryFormatter()",
      "match": true
    },
    {
      "line": "# audit: new BinaryFormatter() present",
      "match": true
    },
    {
      "line": "JsonSerializer.Deserialize<T>()",
      "match": false
    },
    {
      "line": "# verified: JsonSerializer.Deserialize<T>()",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0120"
  ]
}
