{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-464",
  "title": "Unbounded scanf conversion (c) — review required",
  "description": "A c scan uses an unbounded string conversion: sscanfs*([^)]*%s. Input longer than the buffer overflows it. This lexical rule flags the conversion; the reviewer bounds it via a %N width.",
  "severity": "HIGH",
  "cwe": "CWE-120",
  "category": "buffer-overflow",
  "remediation": "Bound with a %N width.",
  "limitation": "Lexical, line-based: matches the conversion.",
  "languages": [
    "c"
  ],
  "patterns": [
    {
      "source": "sscanf\\s*\\([^)]*%s"
    }
  ],
  "tests": [
    {
      "line": "sscanf(b, \"%s\", o)",
      "match": true
    },
    {
      "line": "# audit: sscanf(b, \"%s\", o) present",
      "match": true
    },
    {
      "line": "sscanf(b, \"%99s\", o)",
      "match": false
    },
    {
      "line": "# verified: sscanf(b, \"%99s\", o)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0581"
  ]
}
