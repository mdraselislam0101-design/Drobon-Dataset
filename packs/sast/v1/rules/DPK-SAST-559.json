{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-559",
  "title": "Overly broad browser channel (ws) — review required",
  "description": "Browser code broadcasts or fetches broadly: new WebSocket(\"ws://h/s\") (ws). postMessage to any origin leaks data to hostile frames, and ws:// sockets expose traffic. This lexical rule flags the channel; the reviewer narrows it via wss URLs.",
  "severity": "MEDIUM",
  "cwe": "CWE-940",
  "category": "cross-site-scripting",
  "remediation": "Narrow with wss URLs.",
  "limitation": "Lexical, line-based: matches the channel.",
  "languages": [
    "javascript"
  ],
  "patterns": [
    {
      "source": "\\b(?:new\\s+WebSocket\\s*\\(\\s*\"ws:)"
    }
  ],
  "tests": [
    {
      "line": "new WebSocket(\"ws://h/s\")",
      "match": true
    },
    {
      "line": "# audit: new WebSocket(\"ws://h/s\") present",
      "match": true
    },
    {
      "line": "new WebSocket(\"wss://h/s\")",
      "match": false
    },
    {
      "line": "# verified: new WebSocket(\"wss://h/s\")",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0676"
  ]
}
