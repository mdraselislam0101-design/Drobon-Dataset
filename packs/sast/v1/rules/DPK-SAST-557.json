{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-557",
  "title": "TLS trust weakened (setseed) — review required",
  "description": "TLS trust is weakened: setSeeds*(s*[0-9]+ (setseed). Disabled checks and fixed secrets let attackers impersonate servers or authenticate. This lexical rule flags the weakness; the reviewer restores self-seeding SecureRandom.",
  "severity": "HIGH",
  "cwe": "CWE-295",
  "category": "transport-security",
  "remediation": "Restore self-seeding SecureRandom.",
  "limitation": "Lexical, line-based: matches the weakness.",
  "languages": [
    "java"
  ],
  "patterns": [
    {
      "source": "setSeed\\s*\\(\\s*[0-9]+"
    }
  ],
  "tests": [
    {
      "line": "sr.setSeed(12345)",
      "match": true
    },
    {
      "line": "# audit: sr.setSeed(12345) present",
      "match": true
    },
    {
      "line": "sr.setSeed(secureBytes)",
      "match": false
    },
    {
      "line": "# verified: sr.setSeed(secureBytes)",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0674"
  ]
}
