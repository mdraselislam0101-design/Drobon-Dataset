{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-716",
  "title": "Weak Terraform setting (nobackup) — review required",
  "description": "Terraform weakens protection: backup_retention_period = 0 (nobackup). Ignored drift, local execution, skipped snapshots, public databases, and cleartext secrets widen blast radius. This lexical rule flags the setting; the reviewer hardens via a retention window.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Harden with a retention window.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "terraform"
  ],
  "patterns": [
    {
      "source": "\\b(?:backup_retention_period\\s*=\\s*0\\b)"
    }
  ],
  "tests": [
    {
      "line": "backup_retention_period = 0",
      "match": true
    },
    {
      "line": "# audit: backup_retention_period = 0 present",
      "match": true
    },
    {
      "line": "backup_retention_period = 7",
      "match": false
    },
    {
      "line": "# verified: backup_retention_period = 7",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0833"
  ]
}
