{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-576",
  "title": "Permissive Kubernetes pod (hostnet) — review required",
  "description": "Kubernetes grants host or root power: hostNetworks*:s*true (hostnet). Host namespaces, root users, writable roots, and privilege escalation erase pod isolation. This lexical rule flags the grant; the reviewer removes it via pod networking.",
  "severity": "HIGH",
  "cwe": "CWE-284",
  "category": "container-security",
  "remediation": "Remove or use pod networking.",
  "limitation": "Lexical, line-based: matches the grant.",
  "languages": [
    "k8s"
  ],
  "patterns": [
    {
      "source": "hostNetwork\\s*:\\s*true"
    }
  ],
  "tests": [
    {
      "line": "hostNetwork: true",
      "match": true
    },
    {
      "line": "# audit: hostNetwork: true present",
      "match": true
    },
    {
      "line": "hostNetwork: false",
      "match": false
    },
    {
      "line": "# verified: hostNetwork: false",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0693"
  ]
}
