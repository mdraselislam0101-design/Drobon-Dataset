{
  "schemaVersion": "drobon.pack.sast/v1",
  "id": "DPK-SAST-715",
  "title": "Weak Terraform setting (masterpw) — review required",
  "description": "Terraform weakens protection: master_password = \"x\" (masterpw). Ignored drift, local execution, skipped snapshots, public databases, and cleartext secrets widen blast radius. This lexical rule flags the setting; the reviewer hardens via a managed secret.",
  "severity": "MEDIUM",
  "cwe": "CWE-284",
  "category": "secure-configuration",
  "remediation": "Harden with a managed secret.",
  "limitation": "Lexical, line-based: matches the setting.",
  "languages": [
    "terraform"
  ],
  "patterns": [
    {
      "source": "\\b(?:master_password\\s*=\\s*\"[^\"]+\")"
    }
  ],
  "tests": [
    {
      "line": "master_password = \"x\"",
      "match": true
    },
    {
      "line": "# audit: master_password = \"x\" present",
      "match": true
    },
    {
      "line": "master_password = var.pw",
      "match": false
    },
    {
      "line": "# verified: master_password = var.pw",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0832"
  ]
}
