{
  "schemaVersion": "drobon.pack.secrets/v1",
  "id": "DPK-SEC-106",
  "title": "Possible password value in an unquoted assignment in source",
  "description": "A password value in an unquoted assignment sits in a configuration or source file in plain text. Anyone who can read the repository can use it to reach the service it names until the value is rotated. Shape-only: the match cannot prove the value is live or that it is not a variable reference.",
  "severity": "HIGH",
  "cwe": "CWE-798",
  "category": "hardcoded-credential",
  "remediation": "Rotate the credential, review the access logs of the service it names for use of the old value, and load the replacement from a secret manager at run time instead of committing it.",
  "limitation": "Shape-only heuristic over assignment syntax. Variable references whose names mix letters and digits can match (false positive), and pure letter values without digits are not matched (documented recall boundary). Quoted values are left to DPK-SEC-007.",
  "patterns": [
    {
      "source": "(?:^|[^A-Za-z0-9_])[A-Za-z0-9_]*(?:[pP][aA][sS][sS][wW][oO][rR][dD]|[pP][aA][sS][sS][wW][dD]|[pP][wW][dD])[A-Za-z0-9_]*[ \\t]*[=:][ \\t]*(?![A-Za-z0-9_.]*\\()(?!(?:[eE][xX][aA][mM][pP][lL][eE]|[cC][hH][aA][nN][gG][eE][mM][eE]|[pP][lL][aA][cC][eE][hH][oO][lL][dD][eE][rR]))(?=[^\\s]*[0-9])(?=[^\\s]*[A-Za-z])[A-Za-z0-9!@#^&()+_./~=|-]{10,}"
    }
  ],
  "confidence": "MEDIUM",
  "denylist": [
    "EXAMPLE"
  ],
  "redact": true,
  "tests": [
    {
      "line": "assign = \"DB_PASSWORD=zzzzzzzzzzS3cr9t\"",
      "match": true
    },
    {
      "line": "# audit: assign = \"DB_PASSWORD=zzzzzzzzzzS3cr9t\" present",
      "match": true
    },
    {
      "line": "assign = \"xy\"",
      "match": false
    },
    {
      "line": "assign = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    },
    {
      "line": "export DB_PASSWORD=zzzzzzzzzzS3cr9t",
      "match": true
    },
    {
      "line": "password: zzzzzzzzzzS3cr9t",
      "match": true
    },
    {
      "line": "conn = \"Server=db.internal;Password=zzzzzzzzzzS3cr9t;\"",
      "match": true
    },
    {
      "line": "# db_password: zzzzzzzzzzS3cr9t",
      "match": true
    },
    {
      "line": "password = \"zzzzzzzzzzS3cr9t\"",
      "match": false
    },
    {
      "line": "password = os.environ.get(\"DB_PASSWORD\")",
      "match": false
    },
    {
      "line": "password = EXAMPLE-NOT-A-REAL-VALUE",
      "match": false
    },
    {
      "line": "db_password = changeme",
      "match": false
    },
    {
      "line": "DB_PASSWORD=",
      "match": false
    },
    {
      "line": "password = secret_value",
      "match": false
    },
    {
      "line": "password=zzzzzzzz9",
      "match": false
    },
    {
      "line": "password=zzzzzzzzz9",
      "match": true
    }
  ],
  "patternRefs": [
    "DPK-PAT-0978"
  ]
}
