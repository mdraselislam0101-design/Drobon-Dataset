{
  "schemaVersion": "drobon.pack.secrets/v1",
  "id": "DPK-SEC-107",
  "title": "Possible password containing symbols in a URL in source",
  "description": "A committed password containing symbols in a URL was found in a source or configuration file. Anyone with repository access can use it to authenticate to the service the URL names until the credential is rotated. Shape-only: the match does not prove the value is live.",
  "severity": "HIGH",
  "cwe": "CWE-798",
  "category": "service-credential",
  "remediation": "Rotate the credential in the service the URL names, review its access logs for use of the old value, and load the replacement from a secret manager at run time.",
  "limitation": "Matches URL userinfo passwords of 6 to 64 characters that contain at least one symbol character. Pure alphanumeric userinfo passwords of 12 or more characters belong to DPK-SEC-063 instead; pure alphanumeric passwords shorter than 12 characters are matched by neither rule (documented recall boundary).",
  "patterns": [
    {
      "source": "[A-Za-z][A-Za-z0-9+.\\-]*://[^\\s:@/]{1,64}:(?!(?:[eE][xX][aA][mM][pP][lL][eE]|[cC][hH][aA][nN][gG][eE][mM][eE]|[pP][lL][aA][cC][eE][hH][oO][lL][dD][eE][rR]))(?=[A-Za-z0-9\\-._~!$&'()*+,;=:%]*[\\-._~!$&'()*+,;=:%])[A-Za-z0-9\\-._~!$&'()*+,;=:%]{6,64}@"
    }
  ],
  "confidence": "MEDIUM",
  "denylist": [
    "EXAMPLE"
  ],
  "redact": true,
  "tests": [
    {
      "line": "url = \"postgresql://svc:zzzzzzzz!z9@\"",
      "match": true
    },
    {
      "line": "# audit: url = \"postgresql://svc:zzzzzzzz!z9@\" present",
      "match": true
    },
    {
      "line": "url = \"xy\"",
      "match": false
    },
    {
      "line": "url = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    },
    {
      "line": "url = \"https://admin:P%40ssw0rd-x@host.internal/\"",
      "match": true
    },
    {
      "line": "url = \"postgres://svc@db.internal/app\"",
      "match": false
    },
    {
      "line": "url = \"https://user:short@host/\"",
      "match": false
    },
    {
      "line": "url = \"https://user:zzzzzzzzzzzz@host/\"",
      "match": false
    },
    {
      "line": "url = \"https://user:EXAMPLE-NOT-A-REAL@host/\"",
      "match": false
    },
    {
      "line": "url = \"jdbc:postgresql://db.internal/app?ssl=true&password=zzzzzzzz\"",
      "match": false
    },
    {
      "line": "url = \"postgresql://svc:zzz!z9\"",
      "match": false
    },
    {
      "line": "url = \"mailto:someone@mail.internal\"",
      "match": false
    },
    {
      "line": "url = \"https://u:zzz!z@h\"",
      "match": false
    },
    {
      "line": "url = \"https://u:zzzz!z@h\"",
      "match": true
    },
    {
      "line": "url = \"https://user:Changeme1@host/\"",
      "match": false
    },
    {
      "line": "url = \"https://user:changeme1@host/\"",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0979"
  ]
}
