{
  "schemaVersion": "drobon.pack.secrets/v1",
  "id": "DPK-SEC-063",
  "title": "Possible credentials in a URL in source",
  "description": "A string shaped like credentials in a URL was found in source. Anyone with repository access can try it until it is revoked. Shape-only: this does not prove the credential is live.",
  "severity": "HIGH",
  "cwe": "CWE-798",
  "category": "service-token",
  "remediation": "Revoke the value in the provider console, audit its use, and replace it with a minimally scoped credential stored outside version control.",
  "limitation": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "patterns": [
    {
      "source": "[A-Za-z][A-Za-z0-9+.\\-]*://[^\\s:@/]*:[A-Za-z0-9]{12,}@"
    }
  ],
  "confidence": "MEDIUM",
  "denylist": [
    "EXAMPLE"
  ],
  "redact": true,
  "tests": [
    {
      "line": "url = \"postgresql://user:AAAAAAAAAAAA@\"",
      "match": true
    },
    {
      "line": "# audit: url = \"postgresql://user:AAAAAAAAAAAA@\" present",
      "match": true
    },
    {
      "line": "url = \"xy\"",
      "match": false
    },
    {
      "line": "url = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    },
    {
      "line": "url = \"POSTGRESQL://root:AAAAAAAAAAAA@db.internal:5432/app\"",
      "match": true
    },
    {
      "line": "url = \"mysql://user:AAAAAAAAAAAA@db.internal/app?ssl=true\"",
      "match": true
    },
    {
      "line": "url = \"postgresql://user:AAAAAAAAAAA@\"",
      "match": false
    },
    {
      "line": "url = \"postgresql://user:AAAAAAAAAAAA\"",
      "match": false
    },
    {
      "line": "url = \"postgresql://user@db.internal/app\"",
      "match": false
    },
    {
      "line": "url = \"https://service.test:8443/path\"",
      "match": false
    },
    {
      "line": "url = \"mongodb+srv://svc:AAAAAAAAAAAA@cluster0.internal/app\"",
      "match": true
    },
    {
      "line": "url = \"redis://:AAAAAAAAAAAA@cache.internal:6379/0\"",
      "match": true
    },
    {
      "line": "url = \"postgresql://user:<password>@db.internal/app\"",
      "match": false
    },
    {
      "line": "url = \"postgresql://user:${DB_PASSWORD}@db.internal/app\"",
      "match": false
    }
  ],
  "patternRefs": [
    "DPK-PAT-0529"
  ]
}
