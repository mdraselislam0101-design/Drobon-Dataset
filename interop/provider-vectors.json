      "note": "single-version (=) range"
    },
    {
      "id": "VEC-006",
      "coordinate": { "ecosystem": "npm", "name": "bootstrap", "version": "3.4.0" },
      "expect": [],
      "note": "adjacent version outside single-version range"
    },
    {
      "id": "VEC-007",
      "coordinate": { "ecosystem": "npm", "name": "lodash", "version": "4.17.21" },
      "expect": [],
      "note": "package absent from dataset matches nothing (never 'clean', just unmatched)"
    },
    {
      "id": "VEC-008",
