{
  "schemaVersion": "drobon.vuln-intel/vectors/v1",
  "description": "Pinned provider behavior: given a DependencyCoordinate (ecosystem + name + version), these advisory ids MUST match. Checked by scripts/check-vectors.mjs. Matching is per advisory id (multi-file advisories collapse), real records only, version-less coordinates never match.",
  "vectors": [
    {
      "id": "VEC-001",
      "coordinate": { "ecosystem": "npm", "name": "fast-jwt", "version": "6.2.4" },
      "expect": [
        "GHSA-5hjw-83fp-phq9",
        "GHSA-687g-22h4-j4w4",
        "GHSA-8wpc-h4q6-8fxv",
        "GHSA-g3jj-5cmm-3hxx",
        "GHSA-ww5h-9m49-7xx4",
        "GHSA-x937-hj6v-793p"
      ],
      "note": "one coordinate matches six advisories — providers must return all, not first-hit"
    },
    {
      "id": "VEC-002",
      "coordinate": { "ecosystem": "npm", "name": "fast-jwt", "version": "6.3.4" },
      "expect": [],
      "note": "fixed version matches nothing"
    },
    {
      "id": "VEC-003",
      "coordinate": { "ecosystem": "npm", "name": "handlebars", "version": "4.7.9" },
      "expect": ["GHSA-8r5x-fm3f-whwj", "GHSA-p8wg-vrv2-v86f", "GHSA-xw65-4hp5-5hc7"],
      "note": "comma-AND npm range with lower and upper bounds (grew to three with the 100-record seed; new matches verified by hand)"
    },
    {
      "id": "VEC-004",
      "coordinate": { "ecosystem": "npm", "name": "handlebars", "version": "4.7.10" },
      "expect": [],
      "note": "exact fixed version is exclusive of <= 4.7.9"
    },
    {
      "id": "VEC-005",
