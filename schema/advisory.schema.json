{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mdraselislam0101-design/Drobon-Dataset/schema/advisory.schema.json",
  "title": "Drobon vulnerability-intelligence advisory record (v1)",
  "description": "Record format drobon.vuln-intel/v1. Bounds mirror the Drobon app ScaAdvisory contract exactly. Mirrors scripts/validate.mjs, which is authoritative if they disagree.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixture",
    "id",
    "ecosystem",
    "package",
    "summary",
    "severity",
    "affected",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "drobon.vuln-intel/v1"
    },
    "fixture": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "ecosystem": {
      "enum": ["npm", "pypi"]
    },
    "package": {
      "type": "string",
      "minLength": 1,
      "maxLength": 214,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "severity": {
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^https://[^\\u0000-\\u001F\\u007F]+$"
    },
    "affected": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["range"],
        "properties": {
          "range": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          },
          "fixed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "sourceUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "^https://[^\\u0000-\\u001F\\u007F]+$"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "fixture": { "const": true } },
        "required": ["fixture"]
      },
      "then": {
        "properties": {
          "id": { "pattern": "^DROBON-SAMPLE-[0-9]{3,}$" },
          "provenance": {
            "properties": {
              "source": { "const": "fixture" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "id": { "not": { "pattern": "^DROBON-SAMPLE-" } },
          "provenance": {
            "required": ["source", "sourceUrl", "retrievedAt"],
            "properties": {
              "source": { "not": { "const": "fixture" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fixture": { "const": false },
          "provenance": {
            "properties": { "source": { "const": "GHSA" } },
            "required": ["source"]
          }
        },
        "required": ["fixture", "provenance"]
      },
      "then": {
        "properties": {
          "id": { "pattern": "^GHSA-[0-9A-Za-z]{4}-[0-9A-Za-z]{4}-[0-9A-Za-z]{4}$" }
        }
      }
    }
  ]
}
