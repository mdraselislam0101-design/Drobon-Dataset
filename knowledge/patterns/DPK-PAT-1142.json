{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1142",
  "title": "Signal: All cipher suites enabled in nginx — review required",
  "targets": [
    "nginx"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bssl_ciphers\\s+[\"']?ALL\\b"
  },
  "scope": "Single-line match on ssl_ciphers ALL in nginx.",
  "limitations": "Lexical: matches the literal ALL token; a named list is out of scope even when it is weak.",
  "examples": [
    {
      "line": "ssl_ciphers ALL;",
      "match": true
    },
    {
      "line": "# audit: ssl_ciphers ALL; present",
      "match": true
    },
    {
      "line": "ssl_ciphers HIGH:!aNULL:!MD5;",
      "match": false
    },
    {
      "line": "# verified: ssl_ciphers HIGH:!aNULL:!MD5;",
      "match": false
    }
  ],
  "fpNotes": "A laboratory listener with a pinned test client is the accepted exception.",
  "linkedRules": [
    "DPK-SAST-957"
  ],
  "origin": "original-authored",
  "cell": "sast:nginx-ssl-ciphers-all:nginx",
  "validationStatus": "VALIDATED"
}
