{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0629",
  "title": "Signal: ECB mode selected (ecb) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "aes-[0-9]+-ecb"
  },
  "scope": "Single-line lexical match on ECB selection (ecb).",
  "limitations": "Lexical, line-based: matches the mode name.",
  "examples": [
    {
      "line": "createCipheriv(\"aes-128-ecb\", k, iv)",
      "match": true
    },
    {
      "line": "# audit: createCipheriv(\"aes-128-ecb\", k, iv) present",
      "match": true
    },
    {
      "line": "createCipheriv(\"aes-128-cbc\", k, iv)",
      "match": false
    },
    {
      "line": "# verified: createCipheriv(\"aes-128-cbc\", k, iv)",
      "match": false
    }
  ],
  "fpNotes": "Single-block uses are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-512"
  ],
  "origin": "original-authored",
  "cell": "sast:ecb-more:javascript:ecb",
  "validationStatus": "VALIDATED"
}
