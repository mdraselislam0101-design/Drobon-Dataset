{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0494",
  "title": "Signal: Possible a Hugging Face token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "hf_[A-Za-z0-9]{32,}"
  },
  "scope": "Single-line shape match for a Hugging Face token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"hf_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"hf_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-028"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:huggingface",
  "validationStatus": "VALIDATED"
}
