{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1282",
  "title": "Signal: X-Permitted-Cross-Domain-Policies value is not a recognised token",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-Permitted-Cross-Domain-Policies",
      "valuePattern": "^\\s*(?!none\\s*$)(?!master-only\\s*$)(?!by-content-type\\s*$)(?!by-ftp-filename\\s*$)(?!all\\s*$)\\S"
    }
  },
  "scope": "One response whose X-Permitted-Cross-Domain-Policies value is not a defined token.",
  "limitations": "One header value. The rule validates the token and does not inspect whether a cross-domain policy file is actually served.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Permitted-Cross-Domain-Policies": "master_only"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Permitted-Cross-Domain-Policies": "deny"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Permitted-Cross-Domain-Policies": "none"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Permitted-Cross-Domain-Policies": "all"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "The presence of a policy file is not checked; only the declared token is judged.",
  "linkedRules": [
    "DPK-DAST-213"
  ],
  "origin": "original-authored",
  "cell": "dast:xpp-unknown-token:unknown-token",
  "validationStatus": "VALIDATED"
}
