{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2263",
  "title": "Signal: pyproject dependency declared from a git remote",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.dependencies[]",
      "valuePattern": "^[A-Za-z0-9._-]{1,80} @ git\\+"
    }
  },
  "scope": "A pyproject.toml file that declares a `name @ git+…` dependency.",
  "limitations": "It matches a `name @ git+…` dependency in the parsed pyproject.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "acme-sdk @ git+https://github.com/acme/sdk.git@9f2c4a1"
          ]
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "acme-cli @ git+ssh://git@github.com/acme/cli.git@main"
          ]
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "acme-sdk==4.2.0"
          ]
        }
      },
      "match": false
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "acme-cli @ https://files.acme.example/cli.tar.gz"
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pyproject.toml that mentions a `name @ git+…` dependency in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0126"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-pyproject-vcs-dependency",
  "validationStatus": "VALIDATED"
}
