{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2275",
  "title": "Signal: Pipfile source skips certificate verification",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "source[].verify_ssl",
      "valuePattern": "^false$"
    }
  },
  "scope": "A Pipfile file that declares a source with `verify_ssl = false`.",
  "limitations": "It matches a source with `verify_ssl = false` in the parsed Pipfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Pipfile",
      "document": {
        "source": [
          {
            "name": "acme",
            "url": "https://pypi.acme.example/simple",
            "verify_ssl": false
          }
        ],
        "packages": {}
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "source": [
          {
            "name": "mirror",
            "url": "https://mirror.acme.example/simple",
            "verify_ssl": false
          }
        ],
        "packages": {}
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "source": [
          {
            "name": "pypi",
            "url": "https://pypi.org/simple",
            "verify_ssl": true
          }
        ],
        "packages": {}
      },
      "match": false
    },
    {
      "file": "Pipfile",
      "document": {
        "source": [
          {
            "name": "acme",
            "url": "https://pypi.acme.example/simple"
          }
        ],
        "packages": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A Pipfile that mentions a source with `verify_ssl = false` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0138"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-pipfile-verify-disabled",
  "validationStatus": "VALIDATED"
}
