{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2303",
  "title": "Signal: Maven build plugin without a pinned version",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "project.build.plugins",
      "field": "version"
    }
  },
  "scope": "A pom.xml file that declares a build plugin that declares no version.",
  "limitations": "It matches a build plugin that declares no version in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "build": {
            "plugins": [
              {
                "groupId": "org.apache.maven.plugins",
                "artifactId": "maven-shade-plugin"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "build": {
            "plugins": [
              {
                "groupId": "org.codehaus.mojo",
                "artifactId": "exec-maven-plugin"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "build": {
            "plugins": [
              {
                "groupId": "org.apache.maven.plugins",
                "artifactId": "maven-shade-plugin",
                "version": "3.6.0"
              }
            ]
          }
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "build": {
            "plugins": [
              {
                "groupId": "org.codehaus.mojo",
                "artifactId": "exec-maven-plugin",
                "version": "3.4.1"
              }
            ]
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pom.xml that mentions a build plugin that declares no version in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0166"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-plugin-version-absent",
  "validationStatus": "VALIDATED"
}
