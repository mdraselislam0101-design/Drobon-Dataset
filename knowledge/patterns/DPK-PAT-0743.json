{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0743",
  "title": "Signal: Privilege or root change via setuid (c) — review required",
  "targets": [
    "c"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:setuid)\\s*\\("
  },
  "scope": "Single-line lexical match on the setuid call in c code.",
  "limitations": "Lexical, line-based: any setuid call matches.",
  "examples": [
    {
      "line": "setuid(payload)",
      "match": true
    },
    {
      "line": "out = setuid(data)",
      "match": true
    },
    {
      "line": "mysetuid(x)",
      "match": false
    },
    {
      "line": "setuid_safe()",
      "match": false
    }
  ],
  "fpNotes": "Correct privilege drops are the common false positive.",
  "linkedRules": [
    "DPK-SAST-626"
  ],
  "origin": "original-authored",
  "cell": "sast:priv-call:c",
  "validationStatus": "VALIDATED"
}
