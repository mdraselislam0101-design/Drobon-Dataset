{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1085",
  "title": "Signal: External program executed from a command line in pascal — review required",
  "targets": [
    "pascal"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Exec|ExecuteProcess)\\s*\\("
  },
  "scope": "Single-line match on program execution in pascal.",
  "limitations": "Lexical: matches Exec and ExecuteProcess calls; TProcess usage is out of scope.",
  "examples": [
    {
      "line": "Exec(\"/bin/sh\", \"-c \" + userCmd);",
      "match": true
    },
    {
      "line": "# audit: Exec(\"/bin/sh\", \"-c \" + userCmd); present",
      "match": true
    },
    {
      "line": "proc.Executable := \"/usr/bin/convert\"; proc.Parameters.Add(userFile);",
      "match": false
    },
    {
      "line": "# verified: proc.Executable := \"/usr/bin/convert\"; proc.Parameters.Add(userFile);",
      "match": false
    }
  ],
  "fpNotes": "A constant command line in a build tool is the accepted false positive.",
  "linkedRules": [
    "DPK-SAST-902"
  ],
  "origin": "original-authored",
  "cell": "sast:pascal-runtime-exec:pascal",
  "validationStatus": "VALIDATED"
}
