{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0351",
  "title": "Signal: Weak service hardening (mode) — review required",
  "targets": [
    "logrotate"
  ],
  "signal": {
    "kind": "regex",
    "source": "create\\s+0?[0-7]{2}[2367]\\b"
  },
  "scope": "Single-line lexical match on weak settings (mode).",
  "limitations": "Lexical, line-based: matches the setting regardless of host trust.",
  "examples": [
    {
      "line": "create 0666 root utmp",
      "match": true
    },
    {
      "line": "# audit: create 0666 root utmp present",
      "match": true
    },
    {
      "line": "create 0640 root utmp",
      "match": false
    },
    {
      "line": "# verified: create 0640 root utmp",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-312"
  ],
  "origin": "original-authored",
  "cell": "sast:sys-services:logrotate:mode",
  "validationStatus": "VALIDATED"
}
