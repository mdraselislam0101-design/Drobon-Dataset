{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3121",
  "title": "Signal: Central package with assets excluded",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.itemGroup.PackageVersion[].ExcludeAssets",
      "valuePattern": "^(?:runtime|all|compile|build|analyzers)$"
    }
  },
  "scope": "A Directory.Packages.props file that declares a `<PackageVersion>` that strips runtime assets.",
  "limitations": "It matches a `<PackageVersion>` that strips runtime assets in the parsed Directory.Packages.props; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "System.Text.Json",
                "Version": "8.0.5",
                "ExcludeAssets": "runtime"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "NLog",
                "Version": "5.3.4",
                "ExcludeAssets": "all"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          }
        }
      },
      "match": false
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Dapper",
                "Version": "2.1.35",
                "ExcludeAssets": "none"
              }
            ]
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Directory.Packages.props that mentions a `<PackageVersion>` that strips runtime assets in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0984"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-package-reference-exclude-assets",
  "validationStatus": "VALIDATED"
}
