{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0782",
  "title": "Signal: Dynamic evaluation via constantize (ruby) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:constantize)\\s*\\("
  },
  "scope": "Single-line lexical match on the constantize call in ruby code.",
  "limitations": "Lexical, line-based: any constantize call matches.",
  "examples": [
    {
      "line": "constantize(payload)",
      "match": true
    },
    {
      "line": "out = constantize(data)",
      "match": true
    },
    {
      "line": "myconstantize(x)",
      "match": false
    },
    {
      "line": "constantize_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted templates are the common false positive.",
  "linkedRules": [
    "DPK-SAST-665"
  ],
  "origin": "original-authored",
  "cell": "sast:ruby-call:ruby",
  "validationStatus": "VALIDATED"
}
