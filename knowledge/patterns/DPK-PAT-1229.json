{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1229",
  "title": "Signal: X-DNS-Prefetch-Control explicitly enables DNS prefetching",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-DNS-Prefetch-Control",
      "valuePattern": "^\\s*on\\s*$"
    }
  },
  "scope": "One response whose X-DNS-Prefetch-Control value is on.",
  "limitations": "One header value. The rule reports the explicit enablement; it cannot see whether the page actually contains links to hosts worth prefetching.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-DNS-Prefetch-Control": "on"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-DNS-Prefetch-Control": "On"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-DNS-Prefetch-Control": "off"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-DNS-Prefetch-Control": ""
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A public marketing site that wants prefetching for speed is reported; the value is still an explicit choice to resolve hostnames early.",
  "linkedRules": [
    "DPK-DAST-160"
  ],
  "origin": "original-authored",
  "cell": "dast:x-dns-prefetch-control-on:on",
  "validationStatus": "VALIDATED"
}
