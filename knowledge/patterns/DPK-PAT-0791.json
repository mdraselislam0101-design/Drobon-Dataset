{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0791",
  "title": "Signal: ActiveRecord SQL from input (where) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "where\\s*\\(\\s*\"[^\"]*#\\{"
  },
  "scope": "Single-line lexical match on assembled SQL (where).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "where(\"a = #{q}\")",
      "match": true
    },
    {
      "line": "# audit: where(\"a = #{q}\") present",
      "match": true
    },
    {
      "line": "where(a: q)",
      "match": false
    },
    {
      "line": "# verified: where(a: q)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-674"
  ],
  "origin": "original-authored",
  "cell": "sast:ruby-flag:ruby:where",
  "validationStatus": "VALIDATED"
}
