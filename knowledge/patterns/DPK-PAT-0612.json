{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0612",
  "title": "Signal: Dangerous .NET construct (validateinput) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:ValidateInput\\s*\\(\\s*false\\s*\\))"
  },
  "scope": "Single-line lexical match on .NET constructs (validateinput).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "[ValidateInput(false)]",
      "match": true
    },
    {
      "line": "# audit: [ValidateInput(false)] present",
      "match": true
    },
    {
      "line": "[ValidateInput(true)]",
      "match": false
    },
    {
      "line": "# verified: [ValidateInput(true)]",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-495"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-flag:csharp:validateinput",
  "validationStatus": "VALIDATED"
}
