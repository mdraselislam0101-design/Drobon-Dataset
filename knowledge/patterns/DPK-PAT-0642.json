{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0642",
  "title": "Signal: Risky GitLab job (expiry) — review required",
  "targets": [
    "gitlab"
  ],
  "signal": {
    "kind": "regex",
    "source": "expire_in\\s*:\\s*never"
  },
  "scope": "Single-line lexical match on pipeline files.",
  "limitations": "Lexical, line-based: matches the job setting.",
  "examples": [
    {
      "line": "expire_in: never",
      "match": true
    },
    {
      "line": "# audit: expire_in: never present",
      "match": true
    },
    {
      "line": "expire_in: 1 week",
      "match": false
    },
    {
      "line": "# verified: expire_in: 1 week",
      "match": false
    }
  ],
  "fpNotes": "Release artifacts are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-525"
  ],
  "origin": "original-authored",
  "cell": "sast:gitlab-more:gitlab:expiry",
  "validationStatus": "VALIDATED"
}
