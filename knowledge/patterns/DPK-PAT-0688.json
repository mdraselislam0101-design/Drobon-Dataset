{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0688",
  "title": "Signal: JWT verification skipped (decodefalse) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:JWT\\.decode\\s*\\([^)]*,\\s*nil\\s*,\\s*false)"
  },
  "scope": "Single-line lexical match on JWT verification (decodefalse).",
  "limitations": "Lexical, line-based: matches the skip.",
  "examples": [
    {
      "line": "JWT.decode(t, nil, false)",
      "match": true
    },
    {
      "line": "# audit: JWT.decode(t, nil, false) present",
      "match": true
    },
    {
      "line": "JWT.decode(t, key, true)",
      "match": false
    },
    {
      "line": "# verified: JWT.decode(t, key, true)",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive.",
  "linkedRules": [
    "DPK-SAST-571"
  ],
  "origin": "original-authored",
  "cell": "sast:jwt-verify-off:ruby:decodefalse",
  "validationStatus": "VALIDATED"
}
