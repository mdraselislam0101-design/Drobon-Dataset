{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0526",
  "title": "Signal: Possible a Telegram bot token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b[0-9]{10,}:[A-Za-z0-9_-]{35,}"
  },
  "scope": "Single-line shape match for a Telegram bot token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"1111111111:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"1111111111:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-060"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:telegram-bot",
  "validationStatus": "VALIDATED"
}
