{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1276",
  "title": "Signal: Content-Security-Policy style-src allows unsafe-hashes",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "(?:^|;)\\s*style-src\\s[^;]*(?<=\\s)'unsafe-hashes'(?=[\\s;]|$)"
    }
  },
  "scope": "One response whose Content-Security-Policy style-src directive contains the `'unsafe-hashes'` keyword.",
  "limitations": "One header value and one directive. The rule reports the keyword in style-src; it cannot tell whether any element in the document carries a style body that matches a listed hash.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "style-src 'self' 'unsafe-hashes'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'none'; style-src 'unsafe-hashes' 'sha256-def456='"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "style-src 'self' 'sha256-def456='"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'unsafe-hashes'; style-src 'self'"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "The finding is the keyword in the policy, not proof that a style body in the page matches a listed hash.",
  "linkedRules": [
    "DPK-DAST-207"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-stylesrc-unsafe-hashes:stylesrc-unsafe-hashes",
  "validationStatus": "VALIDATED"
}
