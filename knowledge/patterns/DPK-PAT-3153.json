  "fpNotes": "A pom.xml that mentions an exclusion whose groupId is `*` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1016"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-exclusion-wildcard",
  "validationStatus": "VALIDATED"
