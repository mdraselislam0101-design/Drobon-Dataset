          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "properties": {
            "maven.compiler.release": "21",
            "project.build.sourceEncoding": "UTF-8"
          },
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
