{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0248",
  "title": "Signal: File access built from input (haskell) — review required",
  "targets": [
    "haskell"
  ],
  "signal": {
    "kind": "regex",
    "source": "readFile\\s+[^\\n]*\\+\\+"
  },
  "scope": "Single-line lexical match on input-built paths in haskell code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "readFile (dir ++ f)",
      "match": true
    },
    {
      "line": "# audit: readFile (dir ++ f) present",
      "match": true
    },
    {
      "line": "readFile fixed",
      "match": false
    },
    {
      "line": "# verified: readFile fixed",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-209"
  ],
  "origin": "original-authored",
  "cell": "sast:path-langs:haskell",
  "validationStatus": "VALIDATED"
}
