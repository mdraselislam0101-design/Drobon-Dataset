{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2815",
  "title": "Signal: Published dependency replaced by a local project at build time",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencySubstitution[].substitute.project.path",
      "valuePattern": "^\\.{0,2}/"
    }
  },
  "scope": "A settings.gradle file that declares a dependency substitution that swaps a published module for a local project.",
  "limitations": "It matches a dependency substitution that swaps a published module for a local project in the parsed settings.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        },
        "dependencySubstitution": [
          {
            "module": "com.acme:sdk",
            "substitute": {
              "project": {
                "path": "../sdk"
              }
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        },
        "dependencySubstitution": [
          {
            "module": "com.acme:core",
            "substitute": {
              "project": {
                "path": "./core"
              }
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        },
        "dependencySubstitution": []
      },
      "match": false
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        },
        "dependencySubstitution": [
          {
            "module": "com.acme:sdk",
            "substitute": {
              "module": "com.acme:sdk"
            }
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A settings.gradle that mentions a dependency substitution that swaps a published module for a local project in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0678"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-dependency-substitution",
  "validationStatus": "VALIDATED"
}
