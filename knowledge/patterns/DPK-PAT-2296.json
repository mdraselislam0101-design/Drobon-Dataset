{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2296",
  "title": "Signal: Maven dependency declared with a version range",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.dependencies[].version",
      "valuePattern": "^\\["
    }
  },
  "scope": "A pom.xml file that declares a dependency version written as a range.",
  "limitations": "It matches a dependency version written as a range in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "org.apache.commons",
              "artifactId": "commons-lang3",
              "version": "[3.0,4.0)"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.google.guava",
              "artifactId": "guava",
              "version": "[30.0,)"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "org.apache.commons",
              "artifactId": "commons-lang3",
              "version": "3.15.0"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.google.guava",
              "artifactId": "guava",
              "version": "33.2.1-jre"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pom.xml that mentions a dependency version written as a range in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0159"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-dependency-version-range",
  "validationStatus": "VALIDATED"
}
