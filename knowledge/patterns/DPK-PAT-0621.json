{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0621",
  "title": "Signal: Django security setting off (djmd5) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "MD5PasswordHasher"
  },
  "scope": "Single-line lexical match on Django settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "django.contrib.auth.hashers.MD5PasswordHasher",
      "match": true
    },
    {
      "line": "# audit: django.contrib.auth.hashers.MD5PasswordHasher present",
      "match": true
    },
    {
      "line": "django.contrib.auth.hashers.PBKDF2PasswordHasher",
      "match": false
    },
    {
      "line": "# verified: django.contrib.auth.hashers.PBKDF2PasswordHasher",
      "match": false
    }
  ],
  "fpNotes": "Local development is the common false positive.",
  "linkedRules": [
    "DPK-SAST-504"
  ],
  "origin": "original-authored",
  "cell": "sast:django-secure:python:djmd5",
  "validationStatus": "VALIDATED"
}
