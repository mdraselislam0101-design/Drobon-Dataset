{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0700",
  "title": "Signal: Permissive Kubernetes pod (rolewild) — review required",
  "targets": [
    "k8s"
  ],
  "signal": {
    "kind": "regex",
    "source": "verbs\\s*:\\s*\\[[^\\]]*\"\\*\""
  },
  "scope": "Single-line lexical match on Kubernetes manifests.",
  "limitations": "Lexical, line-based: matches the grant.",
  "examples": [
    {
      "line": "verbs: [\"*\"]",
      "match": true
    },
    {
      "line": "# audit: verbs: [\"*\"] present",
      "match": true
    },
    {
      "line": "verbs: [\"get\"]",
      "match": false
    },
    {
      "line": "# verified: verbs: [\"get\"]",
      "match": false
    }
  ],
  "fpNotes": "Node agents are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-583"
  ],
  "origin": "original-authored",
  "cell": "sast:k8s-more:k8s:rolewild",
  "validationStatus": "VALIDATED"
}
