{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1458",
  "title": "Signal: .travis.yml build definition served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*(?:^|\\n)language\\s*:\\s*[a-z]{2,20})(?=[\\s\\S]*(?:^|\\n)script\\s*:)"
    }
  },
  "scope": "One response body containing a Travis language declaration and a script list.",
  "limitations": "One response body. The rule reads the build definition; it does not run it.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "language: node_js\nnode_js:\n  - \"20\"\nscript:\n  - npm test\n  - npm run build\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "language: python\npython:\n  - \"3.12\"\nservices:\n  - postgresql\nscript:\n  - pytest\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "services:\n  web:\n    image: shop/web:4.2.1\n"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/deploy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Deployment guide</title></head><body><p>Declare the language and the script steps.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that shows a CI snippet is reported when it reproduces the language line and a script step.",
  "linkedRules": [
    "DPK-DAST-389"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-artefact-travis-config:travis-config-served",
  "validationStatus": "VALIDATED"
}
