{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0726",
  "title": "Signal: Dangerous function create_function (php) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:create_function)\\s*\\("
  },
  "scope": "Single-line lexical match on the create_function call in php code.",
  "limitations": "Lexical, line-based: any create_function call matches.",
  "examples": [
    {
      "line": "create_function(payload)",
      "match": true
    },
    {
      "line": "out = create_function(data)",
      "match": true
    },
    {
      "line": "mycreate_function(x)",
      "match": false
    },
    {
      "line": "create_function_safe()",
      "match": false
    }
  ],
  "fpNotes": "Legacy shims are the common false positive.",
  "linkedRules": [
    "DPK-SAST-609"
  ],
  "origin": "original-authored",
  "cell": "sast:php-call:php",
  "validationStatus": "VALIDATED"
}
