{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2339",
  "title": "Signal: Gemfile entry with no version requirement",
  "targets": [
    "rubygems"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "gems[].requirement",
      "valuePattern": "^$"
    }
  },
  "scope": "A Gemfile file that declares a gem declared with no version requirement.",
  "limitations": "It matches a gem declared with no version requirement in the parsed Gemfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "requirement": ""
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "puma",
            "requirement": ""
          },
          {
            "name": "rails",
            "requirement": "~> 7.1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "requirement": "~> 7.1.3"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "puma",
            "requirement": ">= 6.0"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Gemfile that mentions a gem declared with no version requirement in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0202"
  ],
  "origin": "original-authored",
  "cell": "sca:gemfile-unpinned-gem",
  "validationStatus": "VALIDATED"
}
