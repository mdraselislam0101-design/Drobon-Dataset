{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1405",
  "title": "Signal: clientaccesspolicy.xml permits every origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*<access-policy>)(?=[\\s\\S]*<domain[^>]{0,40}uri\\s*=\\s*\"\\*\")"
    }
  },
  "scope": "One response body containing a client access policy that allows every domain.",
  "limitations": "One response body. The rule reads the policy; it does not exercise a Silverlight client against it.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/clientaccesspolicy.xml",
        "status": 200,
        "headers": {
          "Content-Type": "application/xml"
        },
        "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<access-policy>\n  <cross-domain-access>\n    <policy>\n      <allow-from http-request-headers=\"*\"><domain uri=\"*\"/></allow-from>\n    </policy>\n  </cross-domain-access>\n</access-policy>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/clientaccesspolicy.xml",
        "status": 200,
        "headers": {
          "Content-Type": "application/xml"
        },
        "body": "<access-policy><cross-domain-access><policy><allow-from><domain uri=\"*\" /></allow-from></policy></cross-domain-access></access-policy>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/clientaccesspolicy.xml",
        "status": 200,
        "headers": {
          "Content-Type": "application/xml"
        },
        "body": "<access-policy><cross-domain-access><policy><allow-from><domain uri=\"https://app.example\"/></allow-from></policy></cross-domain-access></access-policy>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/policy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Do not use a wildcard domain in a client access policy.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A policy that lists explicit domains, or one that grants only specific paths, is not reported.",
  "linkedRules": [
    "DPK-DAST-336"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-artefact-clientaccesspolicy-allow-all:clientaccesspolicy-allow-all",
  "validationStatus": "VALIDATED"
}
