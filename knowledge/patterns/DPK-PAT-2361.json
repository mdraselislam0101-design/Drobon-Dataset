{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2361",
  "title": "Signal: pubspec.lock pins a non-hosted source",
  "targets": [
    "pub"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.source",
      "valuePattern": "^(?:git|path)$"
    }
  },
  "scope": "A pubspec.lock file that declares a locked package whose source is git or a local path.",
  "limitations": "It matches a locked package whose source is git or a local path in the parsed pubspec.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pubspec.lock",
      "document": {
        "packages": {
          "acme_sdk": {
            "version": "4.2.0",
            "source": "git",
            "description": {
              "url": "https://github.com/acme/sdk.git",
              "resolved-ref": "9f2c4a1"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pubspec.lock",
      "document": {
        "packages": {
          "acme_shared": {
            "version": "1.2.0",
            "source": "path",
            "description": {
              "path": "../acme-shared"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pubspec.lock",
      "document": {
        "packages": {
          "http": {
            "version": "1.2.0",
            "source": "hosted",
            "description": {
              "url": "https://pub.dev"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "pubspec.lock",
      "document": {
        "packages": {
          "path": {
            "version": "1.9.0",
            "source": "hosted",
            "description": {
              "url": "https://pub.dev"
            }
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pubspec.lock that mentions a locked package whose source is git or a local path in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0224"
  ],
  "origin": "original-authored",
  "cell": "sca:pub-lock-git-source",
  "validationStatus": "VALIDATED"
}
