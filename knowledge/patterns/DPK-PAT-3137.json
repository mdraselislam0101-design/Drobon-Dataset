{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3137",
  "title": "Signal: Repository reusing the central id",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.repositories[].id",
      "valuePattern": "^(?:central|maven-central)$"
    }
  },
  "scope": "A pom.xml file that declares a `<repository>` whose id shadows `central`.",
  "limitations": "It matches a `<repository>` whose id shadows `central` in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "properties": {
            "maven.compiler.release": "21",
            "project.build.sourceEncoding": "UTF-8"
          },
          "repositories": [
            {
              "id": "central",
              "url": "https://nexus.acme.example/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "properties": {
            "maven.compiler.release": "21",
            "project.build.sourceEncoding": "UTF-8"
          },
          "repositories": [
            {
              "id": "maven-central",
              "url": "https://repo.acme.example/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
