  "fpNotes": "A pom.xml that mentions a `<repository>` whose id shadows `central` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1000"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-central-id-override",
  "validationStatus": "VALIDATED"
