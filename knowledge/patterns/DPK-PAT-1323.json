{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1323",
  "title": "Signal: Access-Control-Allow-Methods permits TRACE",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Allow-Methods",
      "valuePattern": "(?:^|,)\\s*TRACE\\s*(?:,|$)"
    }
  },
  "scope": "One response whose Access-Control-Allow-Methods value lists TRACE.",
  "limitations": "One header value. The rule reports the advertised method and cannot show whether the server would answer a TRACE request.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Methods": "GET, POST, TRACE"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Methods": "TRACE"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Methods": "GET, POST, DELETE"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Methods": "GET, POST"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "The HTTP Allow header is a different surface with its own rule.",
  "linkedRules": [
    "DPK-DAST-254"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-allow-methods-trace:allow-methods-trace",
  "validationStatus": "VALIDATED"
}
