{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0798",
  "title": "Signal: Shell runs a variable (subst) — review required",
  "targets": [
    "shell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\$\\([^)]*\\$"
  },
  "scope": "Single-line lexical match on shell execution (subst).",
  "limitations": "Lexical, line-based: matches the execution.",
  "examples": [
    {
      "line": "$(cat $f)",
      "match": true
    },
    {
      "line": "# audit: $(cat $f) present",
      "match": true
    },
    {
      "line": "$(cat fixed)",
      "match": false
    },
    {
      "line": "# verified: $(cat fixed)",
      "match": false
    }
  ],
  "fpNotes": "Trusted variables are the common false positive.",
  "linkedRules": [
    "DPK-SAST-681"
  ],
  "origin": "original-authored",
  "cell": "sast:shell-risk:shell:subst",
  "validationStatus": "VALIDATED"
}
