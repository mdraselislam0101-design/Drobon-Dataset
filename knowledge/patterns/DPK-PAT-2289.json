{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2289",
  "title": "Signal: go.mod replace points at a local directory",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "replace[].new.path",
      "valuePattern": "^(?:\\.{1,2}/|/)"
    }
  },
  "scope": "A go.mod file that declares a `replace` whose target is a path on the build machine.",
  "limitations": "It matches a `replace` whose target is a path on the build machine in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0"
          }
        ],
        "replace": [
          {
            "old": {
              "path": "github.com/acme/sdk",
              "version": "v4.2.0"
            },
            "new": {
              "path": "../acme-sdk"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.1.0"
          }
        ],
        "replace": [
          {
            "old": {
              "path": "github.com/acme/cli"
            },
            "new": {
              "path": "/opt/vendor/acme-cli"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0"
          }
        ]
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.1.0"
          }
        ],
        "replace": [
          {
            "old": {
              "path": "github.com/acme/cli"
            },
            "new": {
              "path": "github.com/acme/cli-fork",
              "version": "v2.1.1"
            }
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A go.mod that mentions a `replace` whose target is a path on the build machine in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0152"
  ],
  "origin": "original-authored",
  "cell": "sca:go-replace-local-path",
  "validationStatus": "VALIDATED"
}
