{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2313",
  "title": "Signal: Gradle repository password written into the build script",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "repositories[].credentials.password",
      "valuePattern": "^[A-Za-z0-9!@#$%^&*._-]{8,40}$"
    }
  },
  "scope": "A build.gradle file that declares a repository credential written directly into the checked-in build script.",
  "limitations": "It matches a repository credential written directly into the checked-in build script in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "acme",
            "url": "https://repo.acme.example/maven2",
            "credentials": {
              "username": "ci",
              "password": "EXAMPLESECRETPASSWORD01"
            }
          }
        ],
        "dependencies": []
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mirror",
            "url": "https://mirror.acme.example/maven2",
            "credentials": {
              "username": "ci",
              "password": "EXAMPLESECONDPASSWORD1234"
            }
          }
        ],
        "dependencies": []
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "acme",
            "url": "https://repo.acme.example/maven2",
            "credentials": {
              "username": "ci",
              "password": "${ACME_REPO_PASSWORD}"
            }
          }
        ],
        "dependencies": []
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mavenCentral",
            "url": "https://repo.maven.apache.org/maven2"
          }
        ],
        "dependencies": []
      },
      "match": false
    }
  ],
  "fpNotes": "A build.gradle that mentions a repository credential written directly into the checked-in build script in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0176"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-repository-credentials-inline",
  "validationStatus": "VALIDATED"
}
