{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1256",
  "title": "Signal: Set-Cookie declares SameSite more than once",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Set-Cookie",
      "valuePattern": "^(?=[\\s\\S]*;\\s*samesite\\s*=[\\s\\S]*;\\s*samesite\\s*=)"
    }
  },
  "scope": "One Set-Cookie header whose attribute list contains the SameSite name twice.",
  "limitations": "One header value. The rule reports the repeated attribute and does not decide which value wins, because that depends on the user agent; the effective protection is outside the observation.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; Secure; HttpOnly; SameSite=Lax; SameSite=None"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Secure; HttpOnly; SameSite=Strict; SameSite=Lax"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; Secure; HttpOnly; SameSite=Lax"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; Secure; HttpOnly"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A duplicate with identical values is still flagged; the finding is the ambiguous header, not a specific effective policy.",
  "linkedRules": [
    "DPK-DAST-187"
  ],
  "origin": "original-authored",
  "cell": "dast:cookie-duplicate-samesite:duplicate-samesite",
  "validationStatus": "VALIDATED"
}
