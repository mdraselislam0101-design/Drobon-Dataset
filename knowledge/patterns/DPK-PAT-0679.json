{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0679",
  "title": "Signal: Dangerous JS construct (function) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:new\\s+Function\\s*\\()"
  },
  "scope": "Single-line lexical match on dangerous constructs (function).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "new Function(body)",
      "match": true
    },
    {
      "line": "# audit: new Function(body) present",
      "match": true
    },
    {
      "line": "functionRef",
      "match": false
    },
    {
      "line": "# verified: functionRef",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-562"
  ],
  "origin": "original-authored",
  "cell": "sast:js-flag:javascript:function",
  "validationStatus": "VALIDATED"
}
