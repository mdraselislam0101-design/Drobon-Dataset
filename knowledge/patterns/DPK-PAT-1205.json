{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1205",
  "title": "Signal: Spring Actuator environment endpoint disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*\"propertySources\")(?=[\\s\\S]*\"activeProfiles\")"
    }
  },
  "scope": "One response whose body contains both a propertySources array and an activeProfiles field.",
  "limitations": "Two body markers. A page that echoes one of the two field names without the rest of the document is not reported.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/actuator/env",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"activeProfiles\":[\"prod\"],\"propertySources\":[{\"name\":\"systemEnvironment\",\"properties\":{\"DB_PASSWORD\":{\"value\":\"******\"}}}]}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/actuator/env/db.url",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"propertySources\":[{\"name\":\"applicationConfig\"}],\"activeProfiles\":[]}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/docs/actuator",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<h1>Actuator</h1><p>The env endpoint lists property sources.</p>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>Welcome</body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A locally rendered documentation page about Actuator is reported only if it embeds both fields in the same body.",
  "linkedRules": [
    "DPK-DAST-136"
  ],
  "origin": "original-authored",
  "cell": "dast:body-spring-actuator-env:body-spring-actuator-env",
  "validationStatus": "VALIDATED"
}
