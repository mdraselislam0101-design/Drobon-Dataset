{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0205",
  "title": "Signal: Sensitive value in log call (tcl) — review required",
  "targets": [
    "tcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:puts\\s+[^;\\n]*(?:password|passwd|secret|token))"
  },
  "scope": "Single-line lexical match on credential-named log values in tcl code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "puts \"password=$pw\"",
      "match": true
    },
    {
      "line": "# audit: puts \"password=$pw\" present",
      "match": true
    },
    {
      "line": "puts \"user=$u\"",
      "match": false
    },
    {
      "line": "# verified: puts \"user=$u\"",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-166"
  ],
  "origin": "original-authored",
  "cell": "sast:log-langs:tcl",
  "validationStatus": "VALIDATED"
}
