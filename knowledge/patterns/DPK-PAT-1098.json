{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1098",
  "title": "Signal: Form submits over plaintext HTTP in html — review required",
  "targets": [
    "html"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\baction\\s*=\\s*[\"']http://"
  },
  "scope": "Single-line match on an http form action in html.",
  "limitations": "Lexical: matches a literal http action; a form whose action is built by script is out of scope.",
  "examples": [
    {
      "line": "<form method=\"post\" action=\"http://app.example/login\">",
      "match": true
    },
    {
      "line": "# audit: <form method=\"post\" action=\"http://app.example/login\"> present",
      "match": true
    },
    {
      "line": "<form method=\"post\" action=\"https://app.example/login\">",
      "match": false
    },
    {
      "line": "# verified: <form method=\"post\" action=\"https://app.example/login\">",
      "match": false
    }
  ],
  "fpNotes": "A local development page that posts to localhost is the accepted exception.",
  "linkedRules": [
    "DPK-SAST-915"
  ],
  "origin": "original-authored",
  "cell": "sast:html-form-http-action:html",
  "validationStatus": "VALIDATED"
}
