{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0272",
  "title": "Signal: Predictable randomness via RND (basic) — review required",
  "targets": [
    "basic"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:RND)\\s*\\("
  },
  "scope": "Single-line lexical match on the RND call in basic code.",
  "limitations": "Lexical, line-based: matches any RND call.",
  "examples": [
    {
      "line": "RND(payload)",
      "match": true
    },
    {
      "line": "out = RND(data)",
      "match": true
    },
    {
      "line": "myRND(x)",
      "match": false
    },
    {
      "line": "RND_safe()",
      "match": false
    }
  ],
  "fpNotes": "Simulations are the common false positive.",
  "linkedRules": [
    "DPK-SAST-233"
  ],
  "origin": "original-authored",
  "cell": "sast:random-extra:basic",
  "validationStatus": "VALIDATED"
}
