{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0514",
  "title": "Signal: Possible a SendGrid key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "SG\\.[A-Za-z0-9_-]{22,}"
  },
  "scope": "Single-line shape match for a SendGrid key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"SG.AAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: key = \"SG.AAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-048"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:sendgrid",
  "validationStatus": "VALIDATED"
}
