{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0053",
  "title": "Signal: Weak HSTS preload directive header value",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-missing-directive",
      "header": "Strict-Transport-Security",
      "directive": "preload"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Value check: it cannot confirm the deployment context.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000; preload"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=1; preload"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Transitional deployments are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-023"
  ],
  "origin": "original-authored",
  "cell": "dast:header-weak:hsts-nopreload",
  "validationStatus": "VALIDATED"
}
