{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1469",
  "title": "Signal: YARN ResourceManager UI is reachable without authentication",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*ResourceManager)(?=[\\s\\S]*hadoop)"
    }
  },
  "scope": "One response body containing the YARN ResourceManager shell.",
  "limitations": "One response body. The rule reports the ResourceManager shell; it does not submit an application.",
  "examples": [
    {
      "observation": {
        "url": "https://yarn.example:8088/cluster",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>ResourceManager</title></head><body><p>Cluster ID: cluster-1 · Hadoop 3.3.6</p><table><tr><td>node01:8041</td></tr></table></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://yarn.example:8088/cluster/apps",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h2>Applications</h2><p>ResourceManager state: RUNNING</p><small>Hadoop</small></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Cluster guide</title></head><body><p>The scheduler web interface runs on port 8088.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/cluster",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Cluster</title></head><body><p>Cluster is healthy.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that names YARN in prose is not reported, because the ResourceManager shell is required.",
  "linkedRules": [
    "DPK-DAST-400"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-console-yarn-resourcemanager:yarn-resourcemanager",
  "validationStatus": "VALIDATED"
}
