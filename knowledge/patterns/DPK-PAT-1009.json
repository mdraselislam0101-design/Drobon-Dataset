{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1009",
  "title": "Signal: Outbound request to a computed URL in python — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:(?:requests\\.(?:get|post|put|delete|patch|head|request)|httpx\\.(?:get|post|request)|urlopen)\\(\\s*(?:f[\"']|[\"'][^\"'\\n]*[\"']\\s*%|[\"'][^\"'\\n]*[\"']\\s*\\+|(?:request|req)\\.(?:args|form|values|json|data|GET|POST|query|body|params)))"
  },
  "scope": "Single-line match on an HTTP client call whose URL argument is computed in python.",
  "limitations": "Line-based lexical match for requests/httpx/urlopen call shapes; taint propagation, redirect chains, and DNS rebinding are out of scope.",
  "examples": [
    {
      "line": "requests.get(f\"https://{host}/api/users\")",
      "match": true
    },
    {
      "line": "# audit: requests.get(f\"https://{host}/api/users\") present",
      "match": true
    },
    {
      "line": "requests.get(\"https://api.example.com/v1/users\")",
      "match": false
    },
    {
      "line": "# verified: requests.get(\"https://api.example.com/v1/users\")",
      "match": false
    }
  ],
  "fpNotes": "Calls that compute a path under a hard-coded host from trusted configuration are the accepted false positives.",
  "linkedRules": [
    "DPK-SAST-831"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-computed-py:python",
  "validationStatus": "VALIDATED"
}
