{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0839",
  "title": "Signal: Pre-check file access via os.access (python) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:os\\.access)\\s*\\("
  },
  "scope": "Single-line lexical match on the os.access call in python code.",
  "limitations": "Lexical, line-based: any os.access call matches.",
  "examples": [
    {
      "line": "os.access(payload)",
      "match": true
    },
    {
      "line": "out = os.access(data)",
      "match": true
    },
    {
      "line": "myosaccess(x)",
      "match": false
    },
    {
      "line": "os.access_safe()",
      "match": false
    }
  ],
  "fpNotes": "Display-only checks are the common false positive.",
  "linkedRules": [
    "DPK-SAST-722"
  ],
  "origin": "original-authored",
  "cell": "sast:toctou:python",
  "validationStatus": "VALIDATED"
}
