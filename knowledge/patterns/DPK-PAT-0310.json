{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0310",
  "title": "Signal: bind left open — review required",
  "targets": [
    "redis"
  ],
  "signal": {
    "kind": "regex",
    "source": "bind\\s+0\\.0\\.0\\.0"
  },
  "scope": "Single-line lexical match on open settings for bind.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "bind 0.0.0.0",
      "match": true
    },
    {
      "line": "# audit: bind 0.0.0.0 present",
      "match": true
    },
    {
      "line": "bind 127.0.0.1",
      "match": false
    },
    {
      "line": "# verified: bind 127.0.0.1",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-271"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:redis:bind",
  "validationStatus": "VALIDATED"
}
