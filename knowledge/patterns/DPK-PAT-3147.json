{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3147",
  "title": "Signal: Dependency allowed to float within its minor line",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^~[1-9][0-9]*\\."
    }
  },
  "scope": "A package.json file that declares a `~` specifier that accepts every patch release.",
  "limitations": "It matches a `~` specifier that accepts every patch release in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21",
          "express": "~4.18.0"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21",
          "axios": "~1.6.0"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21",
          "express": "4.18.2"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21",
          "axios": "^1.6.0"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A package.json that mentions a `~` specifier that accepts every patch release in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1010"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-spec-tilde-above-zero",
  "validationStatus": "VALIDATED"
}
