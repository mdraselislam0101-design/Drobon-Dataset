{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2173",
  "title": "Signal: Git dependency that follows a tag name",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "#[A-Za-z][A-Za-z0-9._-]{0,40}$"
    }
  },
  "scope": "A package.json file that declares a git dependency fragment that names a tag rather than a commit.",
  "limitations": "It matches a git dependency fragment that names a tag rather than a commit in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "github:acme/sdk#v4.2.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "git+ssh://git@github.com/acme/cli.git#release"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "github:acme/sdk#9f2c4a1"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A branch fragment is a different mutable reference and is reported separately.",
  "linkedRules": [
    "DPK-SCA-0036"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-tag-fragment",
  "validationStatus": "VALIDATED"
}
