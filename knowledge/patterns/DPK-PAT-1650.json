{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1650",
  "title": "Signal: Link carries an absolute return URL",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "href\\s*=\\s*[\"'][^\"']{0,160}[?&](?:return|returnUrl|return_url|next|redirect|redirect_uri|continue|goto)=https?://"
    }
  },
  "scope": "A response body link carrying return, next, redirect, redirect_uri, continue or goto with an http or https value.",
  "limitations": "One response body. It matches the absolute URL in a return-shaped parameter; it cannot tell whether the target validates the value.",
  "examples": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<a href=\"/login?return=https://bank.example/accounts\">Sign in</a>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/diagnostics",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<a href=\"/sso/start?redirect_uri=https://portal.example/callback\">Continue</a>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<a href=\"/login?return=%2Faccounts%2Fsummary\">Sign in</a>"
      },
      "match": false
    }
  ],
  "fpNotes": "A link whose return parameter holds a same-site relative path is not reported, because the pattern requires an absolute URL.",
  "linkedRules": [
    "DPK-DAST-531"
  ],
  "origin": "original-authored",
  "cell": "dast:body-return-url-link:body-return-url-link",
  "validationStatus": "VALIDATED"
}
