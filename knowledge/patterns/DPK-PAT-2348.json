{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2348",
  "title": "Signal: NuGet lockfile entry without a content hash",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "dependencies.*",
      "field": "contentHash"
    }
  },
  "scope": "A packages.lock.json file that declares a locked package that records no `contentHash`.",
  "limitations": "It matches a locked package that records no `contentHash` in the parsed packages.lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Serilog": {
              "type": "Transitive",
              "resolved": "4.0.1"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3",
              "contentHash": "aaaa"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Serilog": {
              "type": "Transitive",
              "resolved": "4.0.1",
              "contentHash": "bbbb"
            }
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A packages.lock.json that mentions a locked package that records no `contentHash` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0211"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-lock-content-hash-absent",
  "validationStatus": "VALIDATED"
}
