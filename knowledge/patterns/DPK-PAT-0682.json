{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0682",
  "title": "Signal: Dangerous JS construct (require) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\brequire\\s*\\([^)\"']"
  },
  "scope": "Single-line lexical match on dangerous constructs (require).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "require(name)",
      "match": true
    },
    {
      "line": "# audit: require(name) present",
      "match": true
    },
    {
      "line": "require(\"./x\")",
      "match": false
    },
    {
      "line": "# verified: require(\"./x\")",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-565"
  ],
  "origin": "original-authored",
  "cell": "sast:js-flag:javascript:require",
  "validationStatus": "VALIDATED"
}
