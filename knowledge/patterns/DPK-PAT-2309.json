{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2309",
  "title": "Signal: Gradle dependency declared with a dynamic version",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies[].notation",
      "valuePattern": ":\\d{1,3}\\.\\+$"
    }
  },
  "scope": "A build.gradle file that declares a dependency notation ending in `N.+`, which accepts every later release of that major.",
  "limitations": "It matches a dependency notation ending in `N.+`, which accepts every later release of that major in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mavenCentral",
            "url": "https://repo.maven.apache.org/maven2"
          }
        ],
        "dependencies": [
          {
            "configuration": "implementation",
            "notation": "com.acme:internal-core:1.+"
          }
        ]
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mavenCentral",
            "url": "https://repo.maven.apache.org/maven2"
          }
        ],
        "dependencies": [
          {
            "configuration": "runtimeOnly",
            "notation": "org.example:lib:2.+"
          }
        ]
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mavenCentral",
            "url": "https://repo.maven.apache.org/maven2"
          }
        ],
        "dependencies": [
          {
            "configuration": "implementation",
            "notation": "com.acme:internal-core:1.4.2"
          }
        ]
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mavenCentral",
            "url": "https://repo.maven.apache.org/maven2"
          }
        ],
        "dependencies": [
          {
            "configuration": "runtimeOnly",
            "notation": "org.example:lib:2.0.1"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A build.gradle that mentions a dependency notation ending in `N.+`, which accepts every later release of that major in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0172"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-dynamic-version",
  "validationStatus": "VALIDATED"
}
