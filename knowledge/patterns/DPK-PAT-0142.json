{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0142",
  "title": "Signal: Script evaluation of a variable (tcl) — review required",
  "targets": [
    "tcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:eval\\s+\\$)"
  },
  "scope": "Single-line lexical match on variable evaluation in tcl code.",
  "limitations": "Lexical, line-based: matches variable evaluation.",
  "examples": [
    {
      "line": "eval $x",
      "match": true
    },
    {
      "line": "# audit: eval $x present",
      "match": true
    },
    {
      "line": "set y $x",
      "match": false
    },
    {
      "line": "# verified: set y $x",
      "match": false
    }
  ],
  "fpNotes": "Trusted macro expansion is the common false positive.",
  "linkedRules": [
    "DPK-SAST-103"
  ],
  "origin": "original-authored",
  "cell": "sast:eval-flag-extra:tcl",
  "validationStatus": "VALIDATED"
}
