{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2149",
  "title": "Signal: Dependency installed from an anonymous gist",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^gist:"
    }
  },
  "scope": "A package.json file that declares a gist dependency, which resolves an anonymous paste rather than a package.",
  "limitations": "It matches a gist dependency, which resolves an anonymous paste rather than a package in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-snippet": "gist:11081aaa281"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-helper": "gist:acme/8f0a2c"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-snippet": "1.0.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-snippet": "github:acme/snippet"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A gist that happens to be owned by the same organisation is still reported; the rule reports the resolver kind.",
  "linkedRules": [
    "DPK-SCA-0012"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-gist-shorthand",
  "validationStatus": "VALIDATED"
}
