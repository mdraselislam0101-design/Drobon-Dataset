{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1133",
  "title": "Signal: Remote download from a runtime URL in csharp — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.Download(?:String|Data)\\s*\\(\\s*[A-Za-z_]"
  },
  "scope": "Single-line match on dynamic WebClient downloads in csharp.",
  "limitations": "Lexical: matches a non-literal first argument; a validated helper is not inspected.",
  "examples": [
    {
      "line": "var body = client.DownloadString(targetUrl);",
      "match": true
    },
    {
      "line": "# audit: var body = client.DownloadString(targetUrl); present",
      "match": true
    },
    {
      "line": "var body = client.DownloadString(\"https://api.example.com/health\");",
      "match": false
    },
    {
      "line": "# verified: var body = client.DownloadString(\"https://api.example.com/health\");",
      "match": false
    }
  ],
  "fpNotes": "A download from a fixed constant address is the accepted false positive.",
  "linkedRules": [
    "DPK-SAST-948"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-webclient-ssrf:csharp",
  "validationStatus": "VALIDATED"
}
