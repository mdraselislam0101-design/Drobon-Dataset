{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1033",
  "title": "Signal: Content-Type header missing from the response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "missing-response-header",
      "header": "Content-Type"
    }
  },
  "scope": "One response: confirm that no Content-Type header is present.",
  "limitations": "Single-response observation: the check does not test how a specific browser would sniff the body.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/profile",
        "status": 200,
        "headers": {
          "Cache-Control": "no-store"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/upload",
        "status": 201,
        "headers": {
          "X-Content-Type-Options": "nosniff"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/profile",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/profile",
        "status": 200,
        "headers": {
          "Content-Type": ""
        }
      },
      "match": true
    }
  ],
  "fpNotes": "Responses with no body (204, 304) are the accepted exception and are often flagged in error.",
  "linkedRules": [
    "DPK-DAST-074"
  ],
  "origin": "original-authored",
  "cell": "dast:content-type-missing:content-type",
  "validationStatus": "VALIDATED"
}
