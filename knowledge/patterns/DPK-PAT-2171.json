{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2171",
  "title": "Signal: Dependency declared with RubyGems range syntax",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^~>"
    }
  },
  "scope": "A package.json file that declares a `~>` range, which is RubyGems syntax rather than npm syntax.",
  "limitations": "It matches a `~>` range, which is RubyGems syntax rather than npm syntax in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "~> 4.2"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "~> 2.1.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "~4.2.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": ">=4.2"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A `~>` inside a Gemfile is a different artifact and is handled by the rubygems rules.",
  "linkedRules": [
    "DPK-SCA-0034"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-rubygems-compatible",
  "validationStatus": "VALIDATED"
}
