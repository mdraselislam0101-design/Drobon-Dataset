{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0645",
  "title": "Signal: Dynamic load via template.HTML (go) — review required",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:template\\.HTML)\\s*\\("
  },
  "scope": "Single-line lexical match on the template.HTML call in go code.",
  "limitations": "Lexical, line-based: any template.HTML call matches.",
  "examples": [
    {
      "line": "template.HTML(payload)",
      "match": true
    },
    {
      "line": "out = template.HTML(data)",
      "match": true
    },
    {
      "line": "mytemplateHTML(x)",
      "match": false
    },
    {
      "line": "template.HTML_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted plugins are the common false positive.",
  "linkedRules": [
    "DPK-SAST-528"
  ],
  "origin": "original-authored",
  "cell": "sast:go-call:go:html",
  "validationStatus": "VALIDATED"
}
