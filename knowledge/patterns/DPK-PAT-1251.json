{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1251",
  "title": "Signal: Apache Spark master UI disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Spark\\ Master)(?=[\\s\\S]*spark://)"
    }
  },
  "scope": "One response whose body carries the Spark Master heading and a spark:// coordinator URL.",
  "limitations": "One response body. The rule reports the master UI; it does not submit an application and cannot show whether submission is open.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Spark Master at spark://master:7077</title></head><body><h1>Spark Master at spark://master:7077</h1><ul><li>Workers: 4</li></ul></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h2>Spark Master at spark://10.0.0.5:7077</h2><a href=\"app/\">Running Applications</a></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title> at master:7077</title></head><body><h1> at master:7077</h1><ul><li>Workers: 4</li></ul></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published UI is still reported; the finding is reachability.",
  "linkedRules": [
    "DPK-DAST-182"
  ],
  "origin": "original-authored",
  "cell": "dast:body-spark-master-ui:spark-master-ui",
  "validationStatus": "VALIDATED"
}
