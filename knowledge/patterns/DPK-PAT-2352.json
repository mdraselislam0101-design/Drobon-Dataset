{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2352",
  "title": "Signal: Hex dependency with an open lower bound",
  "targets": [
    "hex"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "deps[].requirement",
      "valuePattern": "^>=\\s*\\d"
    }
  },
  "scope": "A mix.exs file that declares a `>=` requirement with no upper bound.",
  "limitations": "It matches a `>=` requirement with no upper bound in the parsed mix.exs; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "phoenix",
            "requirement": ">= 1.7.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "ecto",
            "requirement": ">= 3.10.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "phoenix",
            "requirement": "~> 1.7.10"
          }
        ]
      },
      "match": false
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "ecto",
            "requirement": "3.11.2"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A mix.exs that mentions a `>=` requirement with no upper bound in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0215"
  ],
  "origin": "original-authored",
  "cell": "sca:hex-dependency-open-bound",
  "validationStatus": "VALIDATED"
}
