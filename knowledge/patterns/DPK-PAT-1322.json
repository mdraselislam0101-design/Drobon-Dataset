{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1322",
  "title": "Signal: Access-Control-Allow-Headers permits Authorization",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Allow-Headers",
      "valuePattern": "(?:^|,)\\s*authorization\\s*(?:,|$)"
    }
  },
  "scope": "One response whose Access-Control-Allow-Headers value lists Authorization.",
  "limitations": "One header value. The rule reads the preflight allow-list and cannot see the request Origin, so it does not claim that any particular origin is admitted.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Headers": "Authorization"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Headers": "content-type, authorization"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Headers": "content-type, x-request-id"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Headers": "x-authorization-id"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A preflight that allows the header but answers a strict origin allow-list is still reported; the rule reports the header grant, not the origin decision.",
  "linkedRules": [
    "DPK-DAST-253"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-allow-headers-authorization:allow-headers-authorization",
  "validationStatus": "VALIDATED"
}
