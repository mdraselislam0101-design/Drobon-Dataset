{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1587",
  "title": "Signal: Account statement exported as a CSV row set",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "\\b(?:date|transaction date)\\b[^\\r\\n]{0,80},[^\\r\\n]{0,80}\\b(?:debit|credit|amount)\\b[^\\r\\n]{0,80},[^\\r\\n]{0,80}\\bbalance\\b"
    }
  },
  "scope": "A CSV header row combining a date column, an amount or debit/credit column and a balance column.",
  "limitations": "One response body. It detects the CSV header shape rather than the file extension, so a renamed export is still reported.",
  "examples": [
    {
      "observation": {
        "url": "https://bank.example/accounts/export.csv",
        "status": 200,
        "headers": {
          "Content-Type": "text/csv; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "Transaction Date,Description,Debit,Credit,Balance\n2026-09-01,Salary,,42000.00,58120.55\n2026-09-02,ATM withdrawal,3000.00,,55120.55\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/accounts/statement.csv",
        "status": 200,
        "headers": {
          "Content-Type": "text/csv; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "date,reference,amount,balance\n2026-09-03,TXN8821,120.00,55000.55\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/settlement/report.csv",
        "status": 200,
        "headers": {
          "Content-Type": "text/csv; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "Settlement Date,Merchant,Total Fees,Net\n2026-09-03,Example Retail,18.20,8810.40\n"
      },
      "match": false
    }
  ],
  "fpNotes": "A merchant settlement report that carries only totals, with no balance column, is not reported.",
  "linkedRules": [
    "DPK-DAST-518"
  ],
  "origin": "original-authored",
  "cell": "dast:bank-statement-csv:bank-statement-csv",
  "validationStatus": "VALIDATED"
}
