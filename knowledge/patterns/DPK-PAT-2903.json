{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2903",
  "title": "Signal: Composer root-package install hook",
  "targets": [
    "composer"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "scripts.post-root-package-install[]",
      "valuePattern": "^.+$"
    }
  },
  "scope": "A composer.json file that declares a `post-root-package-install` script that runs during project creation.",
  "limitations": "It matches a `post-root-package-install` script that runs during project creation in the parsed composer.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {
          "post-root-package-install": [
            "php ./scripts/init.php"
          ]
        }
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {
          "post-root-package-install": [
            "@php artisan key:generate"
          ]
        }
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {
          "test": [
            "phpunit"
          ]
        }
      },
      "match": false
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A composer.json that mentions a `post-root-package-install` script that runs during project creation in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0766"
  ],
  "origin": "original-authored",
  "cell": "sca:composer-script-post-root",
  "validationStatus": "VALIDATED"
}
