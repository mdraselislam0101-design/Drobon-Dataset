{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0255",
  "title": "Signal: File access built from input (swift) — review required",
  "targets": [
    "swift"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:contentsOfFile\\s*:[^)]*\\+)"
  },
  "scope": "Single-line lexical match on input-built paths in swift code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "String(contentsOfFile: dir + f)",
      "match": true
    },
    {
      "line": "# audit: String(contentsOfFile: dir + f) present",
      "match": true
    },
    {
      "line": "String(contentsOfFile: fixed)",
      "match": false
    },
    {
      "line": "# verified: String(contentsOfFile: fixed)",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-216"
  ],
  "origin": "original-authored",
  "cell": "sast:path-langs:swift",
  "validationStatus": "VALIDATED"
}
