{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0649",
  "title": "Signal: Legacy digest via Digest::SHA1.hexdigest (crystal) — review required",
  "targets": [
    "crystal"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Digest::SHA1\\.hexdigest)\\s*\\("
  },
  "scope": "Single-line lexical match on the Digest::SHA1.hexdigest call in crystal code.",
  "limitations": "Lexical, line-based: matches any Digest::SHA1.hexdigest call.",
  "examples": [
    {
      "line": "Digest::SHA1.hexdigest(payload)",
      "match": true
    },
    {
      "line": "out = Digest::SHA1.hexdigest(data)",
      "match": true
    },
    {
      "line": "myDigestSHA1hexdigest(x)",
      "match": false
    },
    {
      "line": "Digest::SHA1.hexdigest_safe()",
      "match": false
    }
  ],
  "fpNotes": "Checksums are the common false positive.",
  "linkedRules": [
    "DPK-SAST-532"
  ],
  "origin": "original-authored",
  "cell": "sast:hash-call-3:crystal:sha1",
  "validationStatus": "VALIDATED"
}
