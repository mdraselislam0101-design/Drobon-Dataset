{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1456",
  "title": "Signal: poetry.lock dependency lockfile served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*(?:^|\\n)\\[\\[package\\]\\])(?=[\\s\\S]*\\nname = \"[a-z0-9-]{2,40}\")"
    }
  },
  "scope": "One response body containing Poetry package tables with resolved names.",
  "limitations": "One response body. The rule reads the table shape; it does not resolve the versions.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "[[package]]\nname = \"requests\"\nversion = \"2.31.0\"\ndescription = \"Python HTTP for Humans.\"\n\n[[package]]\nname = \"urllib3\"\nversion = \"2.2.1\"\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "[[package]]\nname = \"shop-client\"\nversion = \"0.9.1\"\nsource = {type = \"legacy\", url = \"https://pypi.internal/simple\"}\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "[tool.poetry]\nname = \"shop\"\nversion = \"1.4.0\"\n"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/deploy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Deployment guide</title></head><body><p>Run poetry install --no-root in the image.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A pyproject.toml manifest is not reported, because the lockfile table marker is required.",
  "linkedRules": [
    "DPK-DAST-387"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-artefact-poetry-lock:poetry-lock-served",
  "validationStatus": "VALIDATED"
}
