{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2817",
  "title": "Signal: Restore writes packages into a shared machine location",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "config.globalPackagesFolder",
      "valuePattern": "^(?:/|~|[A-Za-z]:)"
    }
  },
  "scope": "A nuget.config file that declares a `globalPackagesFolder` outside the workspace.",
  "limitations": "It matches a `globalPackagesFolder` outside the workspace in the parsed nuget.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {
          "globalPackagesFolder": "/var/cache/nuget/packages"
        },
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {
          "globalPackagesFolder": "C:\\nuget\\packages"
        },
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {
          "globalPackagesFolder": ".packages"
        },
        "settings": {}
      },
      "match": false
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A nuget.config that mentions a `globalPackagesFolder` outside the workspace in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0680"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-global-packages-folder-outside",
  "validationStatus": "VALIDATED"
}
