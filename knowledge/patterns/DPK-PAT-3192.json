{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3192",
  "title": "Signal: Possible a Sentry DSN with its client key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "https://[a-f0-9]{32}@o[0-9]{6,9}\\.ingest\\.sentry\\.io/[0-9]{6,9}"
  },
  "scope": "Single-line shape match for a Sentry DSN with its client key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "dsn = \"https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@o1234567.ingest.sentry.io/1234567\"",
      "match": true
    },
    {
      "line": "# audit: dsn = \"https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@o1234567.ingest.sentry.io/1234567\" present",
      "match": true
    },
    {
      "line": "dsn = \"xy\"",
      "match": false
    },
    {
      "line": "dsn = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-132"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-4:sentry-dsn",
  "validationStatus": "VALIDATED"
}
