{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0294",
  "title": "Signal: auth left open — review required",
  "targets": [
    "cassandra"
  ],
  "signal": {
    "kind": "regex",
    "source": "authenticator:\\s*AllowAllAuthenticator"
  },
  "scope": "Single-line lexical match on open settings for auth.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "authenticator: AllowAllAuthenticator",
      "match": true
    },
    {
      "line": "# audit: authenticator: AllowAllAuthenticator present",
      "match": true
    },
    {
      "line": "authenticator: PasswordAuthenticator",
      "match": false
    },
    {
      "line": "# verified: authenticator: PasswordAuthenticator",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-255"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:cassandra:auth",
  "validationStatus": "VALIDATED"
}
