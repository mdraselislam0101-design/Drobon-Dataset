{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2152",
  "title": "Signal: Dependency resolved from a local path",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^file:"
    }
  },
  "scope": "A package.json file that declares a `file:` dependency that points at a path on the build machine.",
  "limitations": "It matches a `file:` dependency that points at a path on the build machine in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-shared": "file:../acme-shared"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-assets": "file:./packages/assets"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-shared": "1.2.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-shared": "link:../acme-shared"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A monorepo workspace that intentionally links its own packages is still reported; treat it as an accepted policy exception.",
  "linkedRules": [
    "DPK-SCA-0015"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-file-protocol",
  "validationStatus": "VALIDATED"
}
