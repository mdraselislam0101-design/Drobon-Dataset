{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1166",
  "title": "Signal: CORS allows every request header",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Allow-Headers",
      "valuePattern": "^\\s*\\*\\s*$"
    }
  },
  "scope": "One Access-Control-Allow-Headers value whose entire entry is the wildcard.",
  "limitations": "One header value. The rule does not read Access-Control-Allow-Origin, so it reports the permissive allow-list without showing which origins may use it, and it cannot tell a credentialed from a non-credentialed policy.",
  "examples": [
    {
      "observation": {
        "url": "https://api.example/",
        "status": 204,
        "headers": {
          "Access-Control-Allow-Headers": "*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/",
        "status": 204,
        "headers": {
          "Access-Control-Allow-Headers": "   *   "
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/",
        "status": 204,
        "headers": {
          "Access-Control-Allow-Headers": "Content-Type, Authorization"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://api.example/",
        "status": 204,
        "headers": {
          "Access-Control-Allow-Headers": "X-*"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://api.example/",
        "status": 204,
        "headers": {
          "Access-Control-Allow-Headers": ""
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://api.example/",
        "status": 204,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately open, unauthenticated API can answer every origin and header by design; the observation cannot show whether any decision rides on a request header.",
  "linkedRules": [
    "DPK-DAST-097"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-allow-headers-wildcard:any-header",
  "validationStatus": "VALIDATED"
}
