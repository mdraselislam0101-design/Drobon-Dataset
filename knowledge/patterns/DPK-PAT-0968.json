{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0968",
  "title": "Signal: Possible Docker registry auth value in config.json in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "\"auth\"\\s*:\\s*\"[A-Za-z0-9+/]{24,}={0,2}\""
  },
  "scope": "Single-line shape match for Docker registry auth value in config.json.",
  "limitations": "Shape-only: matches the documented syntax of this configuration form. It cannot prove the value is a live credential.",
  "examples": [
    {
      "line": "config = \"\"auth\" : \"AAAAAAAAAAAAAAAAAAAAAAAA\"\"",
      "match": true
    },
    {
      "line": "# audit: config = \"\"auth\" : \"AAAAAAAAAAAAAAAAAAAAAAAA\"\" present",
      "match": true
    },
    {
      "line": "config = \"xy\"",
      "match": false
    },
    {
      "line": "config = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    },
    {
      "line": "config = \"auth\": \"none\"",
      "match": false
    },
    {
      "line": "config = \"authority\": \"https://login.internal\"",
      "match": false
    }
  ],
  "fpNotes": "Placeholders and documentation that reuse the same syntax are the common false positives.",
  "linkedRules": [
    "DPK-SEC-102"
  ],
  "origin": "original-authored",
  "cell": "secrets:protocol-config:docker-config-auth",
  "validationStatus": "VALIDATED"
}
