{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2884",
  "title": "Signal: Plugin repository declared over cleartext",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.pluginRepositories[].url",
      "valuePattern": "^http://"
    }
  },
  "scope": "A pom.xml file that declares a `<pluginRepository>` URL over cleartext.",
  "limitations": "It matches a `<pluginRepository>` URL over cleartext in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ],
          "pluginRepositories": [
            {
              "id": "acme",
              "url": "http://plugins.acme.example/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
