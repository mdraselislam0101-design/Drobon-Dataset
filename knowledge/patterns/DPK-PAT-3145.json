{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3145",
  "title": "Signal: Individual gem source over cleartext",
  "targets": [
    "rubygems"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "gems[].source",
      "valuePattern": "^http://"
    }
  },
  "scope": "A Gemfile file that declares a per-gem `source` URL over cleartext.",
  "limitations": "It matches a per-gem `source` URL over cleartext in the parsed Gemfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "acme-core",
            "source": "http://gems.acme.example"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "acme-sdk",
            "source": "http://10.24.8.9/gems"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "source": "https://rubygems.org"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "puma",
            "requirement": "~> 6.4"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Gemfile that mentions a per-gem `source` URL over cleartext in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1008"
  ],
  "origin": "original-authored",
  "cell": "sca:gemfile-gem-source-cleartext",
  "validationStatus": "VALIDATED"
}
