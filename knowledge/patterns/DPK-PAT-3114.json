{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3114",
  "title": "Signal: Pod built with warnings suppressed",
  "targets": [
    "cocoapods"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "pods[].inhibit_warnings",
      "valuePattern": "^true$"
    }
  },
  "scope": "A Podfile file that declares a pod that hides compiler warnings.",
  "limitations": "It matches a pod that hides compiler warnings in the parsed Podfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "AcmeCore",
            "inhibit_warnings": true
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "AcmeSDK",
            "inhibit_warnings": "true"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "inhibit_warnings": false
          }
        ]
      },
      "match": false
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "SnapKit"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Podfile that mentions a pod that hides compiler warnings in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0977"
  ],
  "origin": "original-authored",
  "cell": "sca:podfile-inhibit-warnings",
  "validationStatus": "VALIDATED"
}
