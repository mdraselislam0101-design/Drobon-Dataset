{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1261",
  "title": "Signal: Access-Control-Allow-Credentials carries an unrecognised token",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Allow-Credentials",
      "valuePattern": "^\\s*(?!true\\s*$)(?!false\\s*$)\\S"
    }
  },
  "scope": "One response whose Access-Control-Allow-Credentials value is not the literal token true.",
  "limitations": "One header value. Comparison is case-insensitive like every other header value pattern in this pack, so a capitalised True is not reported even though the protocol is case-sensitive; the rule reports values that are not a true/false spelling at all.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Credentials": "yes"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Credentials": "1"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Credentials": "true"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Credentials": "false"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A literal false is not reported, because it is a deliberate denial rather than a malformed grant.",
  "linkedRules": [
    "DPK-DAST-192"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-credentials-invalid-token:credentials-invalid-token",
  "validationStatus": "VALIDATED"
}
