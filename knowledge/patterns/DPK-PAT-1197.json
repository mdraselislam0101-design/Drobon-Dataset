{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1197",
  "title": "Signal: Environment file contents disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*\\bAPP_KEY\\s*=)(?=[\\s\\S]*\\bAPP_ENV\\s*=)"
    }
  },
  "scope": "One response whose body contains APP_KEY and APP_ENV assignments.",
  "limitations": "Two body markers. A documentation page that shows a redacted .env example is reported only if both assignments appear unredacted in the body.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/.env",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "APP_NAME=shop\nAPP_ENV=production\nAPP_KEY=base64:Q2hhbmdlTWU=\nDB_PASSWORD=example\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/.env.production",
        "status": 200,
        "headers": {
          "Content-Type": "application/octet-stream"
        },
        "body": "APP_ENV = prod\nAPP_KEY = base64:AAAA\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/.env",
        "status": 403,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>Forbidden</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/env",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Set APP_KEY in your environment file before deploying.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deployment that intentionally publishes a redacted sample is reported if the two assignments are present; the rule cannot judge redaction.",
  "linkedRules": [
    "DPK-DAST-128"
  ],
  "origin": "original-authored",
  "cell": "dast:body-dotenv-file-served:body-dotenv-file-served",
  "validationStatus": "VALIDATED"
}
