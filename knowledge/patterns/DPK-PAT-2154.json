{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2154",
  "title": "Signal: Dependency resolved through the portal protocol",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^portal:"
    }
  },
  "scope": "A package.json file that declares a `portal:` dependency, a Yarn protocol that resolves a live directory.",
  "limitations": "It matches a `portal:` dependency, a Yarn protocol that resolves a live directory in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-ui": "portal:../acme-ui"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-ui": "portal:./packages/ui"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-ui": "link:../acme-ui"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-ui": "2.3.1"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "The sibling `link:` protocol is a different resolver and is not reported here.",
  "linkedRules": [
    "DPK-SCA-0017"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-portal-protocol",
  "validationStatus": "VALIDATED"
}
