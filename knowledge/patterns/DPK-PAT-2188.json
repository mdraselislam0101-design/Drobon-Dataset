{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2188",
  "title": "Signal: Lockfile resolved a prerelease build",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.version",
      "valuePattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}-(?:alpha|beta|rc|next|canary|dev)"
    }
  },
  "scope": "A package-lock.json file that declares a resolved version that is a prerelease build.",
  "limitations": "It matches a resolved version that is a prerelease build in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0-rc.1",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.4.0-beta.7",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.4.0",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A project that ships prereleases on purpose is still reported; the version shape is the finding.",
  "linkedRules": [
    "DPK-SCA-0051"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-version-prerelease",
  "validationStatus": "VALIDATED"
}
