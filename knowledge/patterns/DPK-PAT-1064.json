{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1064",
  "title": "Signal: Legacy cipher selected by name in ruby — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:OpenSSL::Cipher\\.new\\s*\\(\\s*[\"'](?:des|des3|rc4|bf|cast5))"
  },
  "scope": "Single-line match on a legacy cipher name in ruby.",
  "limitations": "Lexical: matches literal cipher names at the call site; names resolved from configuration are out of scope.",
  "examples": [
    {
      "line": "cipher = OpenSSL::Cipher.new(\"des-cbc\")",
      "match": true
    },
    {
      "line": "# audit: cipher = OpenSSL::Cipher.new(\"des-cbc\") present",
      "match": true
    },
    {
      "line": "cipher = OpenSSL::Cipher.new(\"aes-256-gcm\")",
      "match": false
    },
    {
      "line": "# verified: cipher = OpenSSL::Cipher.new(\"aes-256-gcm\")",
      "match": false
    }
  ],
  "fpNotes": "Interoperability shims that only decrypt archived data are the accepted, time-boxed exception.",
  "linkedRules": [
    "DPK-SAST-881"
  ],
  "origin": "original-authored",
  "cell": "sast:ruby-weak-cipher-select:ruby",
  "validationStatus": "VALIDATED"
}
