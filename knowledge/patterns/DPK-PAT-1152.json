{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1152",
  "title": "Signal: Werkzeug interactive debugger page disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "Werkzeug Debugger"
    }
  },
  "scope": "One response body: confirm the Werkzeug debugger page.",
  "limitations": "Observation-level: matches the debugger's identifying page text. It does not determine whether the console PIN is guessable or whether code execution is possible.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/orders/42",
        "status": 500,
        "headers": {
          "Content-Type": "text/html; charset=utf-8"
        },
        "body": "<html><head><title>ZeroDivisionError // Werkzeug Debugger</title></head><body><h1>Werkzeug Debugger</h1></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/console",
        "status": 500,
        "headers": {},
        "body": "<div id=\"debugger\">The Werkzeug Debugger is active</div>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/orders/42",
        "status": 500,
        "headers": {},
        "body": "<h1>Internal Server Error</h1><p>Reference 4c9d.</p>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<h1>Orders</h1><p>Your recent orders.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately exposed debugger on an isolated development host is reported by design; the limitation states this.",
  "linkedRules": [
    "DPK-DAST-083"
  ],
  "origin": "original-authored",
  "cell": "dast:werkzeug-debugger:console",
  "validationStatus": "VALIDATED"
}
