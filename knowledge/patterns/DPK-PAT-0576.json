{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0576",
  "title": "Signal: Weak response control (wildcard Timing-Allow-Origin)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Timing-Allow-Origin",
      "valuePattern": "^\\*$"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Header check: it cannot confirm exploitability.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Timing-Allow-Origin": "*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/x",
        "status": 200,
        "headers": {
          "Timing-Allow-Origin": "*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Timing-Allow-Origin": "https://app.example/"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "CDN behaviors are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-051"
  ],
  "origin": "original-authored",
  "cell": "dast:response-weak-2:timing-star",
  "validationStatus": "VALIDATED"
}
