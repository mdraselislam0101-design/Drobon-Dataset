{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0180",
  "title": "Signal: Wildcard IAM in cfnres — review required",
  "targets": [
    "yaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "\"Resource\"\\s*:\\s*\"\\*\""
  },
  "scope": "Single-line lexical match on wildcard IAM (cfnres).",
  "limitations": "Lexical, line-based: matches the wildcard regardless of trust policy.",
  "examples": [
    {
      "line": "\"Resource\": \"*\"",
      "match": true
    },
    {
      "line": "# audit: \"Resource\": \"*\" present",
      "match": true
    },
    {
      "line": "\"Resource\": \"arn:...\"",
      "match": false
    },
    {
      "line": "# verified: \"Resource\": \"arn:...\"",
      "match": false
    }
  ],
  "fpNotes": "Break-glass roles are the rare accepted case — confirm controls.",
  "linkedRules": [
    "DPK-SAST-141"
  ],
  "origin": "original-authored",
  "cell": "sast:iac-iam-star:yaml:cfnres",
  "validationStatus": "VALIDATED"
}
