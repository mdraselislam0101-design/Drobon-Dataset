{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1188",
  "title": "Signal: Report-To names a plaintext endpoint",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Report-To",
      "valuePattern": "\"url\"\\s*:\\s*\"http://"
    }
  },
  "scope": "One Report-To header whose endpoint url value begins with http://.",
  "limitations": "One header value, matched on the endpoint URL form. The rule does not parse the JSON, so it cannot rank groups or max_age, and it does not cover the Reporting-Endpoints header syntax.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Report-To": "{\"group\":\"default\",\"max_age\":60,\"endpoints\":[{\"url\":\"http://collector.example/r\"}]}"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Report-To": "{\"group\":\"default\",\"endpoints\":[{\"url\":\"HTTP://collector.example/r\"}]}"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Report-To": "{\"group\":\"default\",\"endpoints\":[{\"url\":\"https://collector.example/r\"}]}"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Report-To": "{\"group\":\"default\",\"max_age\":60}"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Reporting-Endpoints": "default=\"http://collector.example/r\""
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A local-only collector is reported; the observation cannot show whether the endpoint is reachable from the internet.",
  "linkedRules": [
    "DPK-DAST-119"
  ],
  "origin": "original-authored",
  "cell": "dast:report-to-plaintext:endpoint",
  "validationStatus": "VALIDATED"
}
