{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2207",
  "title": "Signal: Lockfile nests duplicate copies of a package",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-key-matches",
      "path": "packages",
      "keyPattern": "^node_modules/[^/]+/node_modules/|^node_modules/node_modules/"
    }
  },
  "scope": "A package-lock.json file that declares a lockfile that nests a second copy of a package inside another dependency.",
  "limitations": "It matches a lockfile that nests a second copy of a package inside another dependency in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/a/node_modules/b": {
            "version": "1.0.0",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/x/node_modules/y/node_modules/z": {
            "version": "2.0.0",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/a": {
            "version": "1.0.0",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/b": {
            "version": "2.0.0",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberate dual-version tree for a compatibility window is still reported; the duplicate is the finding.",
  "linkedRules": [
    "DPK-SCA-0070"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-nested-duplicate",
  "validationStatus": "VALIDATED"
}
