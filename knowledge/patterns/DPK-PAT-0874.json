{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0874",
  "title": "Signal: Possible an OpenAI admin key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "sk-admin-[A-Za-z0-9]{32,}"
  },
  "scope": "Single-line shape match for an OpenAI admin key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"sk-admin-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: key = \"sk-admin-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-086"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-2:openai-admin",
  "validationStatus": "VALIDATED"
}
