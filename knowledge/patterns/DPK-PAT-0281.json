{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0281",
  "title": "Signal: Berkeley r-command use (shell) — review required",
  "targets": [
    "shell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\brlogin\\b|\\brsh\\b"
  },
  "scope": "Single-line lexical match on r-command use.",
  "limitations": "Lexical, line-based: matches the command name.",
  "examples": [
    {
      "line": "rsh host uptime",
      "match": true
    },
    {
      "line": "# audit: rsh host uptime present",
      "match": true
    },
    {
      "line": "ssh host uptime",
      "match": false
    },
    {
      "line": "# verified: ssh host uptime",
      "match": false
    }
  ],
  "fpNotes": "None common.",
  "linkedRules": [
    "DPK-SAST-242"
  ],
  "origin": "original-authored",
  "cell": "sast:rsh-use:shell:rsh",
  "validationStatus": "VALIDATED"
}
