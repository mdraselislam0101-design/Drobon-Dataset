{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0573",
  "title": "Signal: Weak response control (CSP without frame-ancestors)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-missing-directive",
      "header": "Content-Security-Policy",
      "directive": "frame-ancestors"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Header check: it cannot confirm exploitability.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; frame-ancestors 'none'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors 'self'"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "CDN behaviors are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-048"
  ],
  "origin": "original-authored",
  "cell": "dast:response-weak-2:csp-noframe",
  "validationStatus": "VALIDATED"
}
