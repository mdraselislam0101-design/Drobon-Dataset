{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0477",
  "title": "Signal: Possible a bearer token header in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "Bearer [A-Za-z0-9._~+/-]{24,}"
  },
  "scope": "Single-line shape match for a bearer token header.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "header = \"Bearer AAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: header = \"Bearer AAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "header = \"xy\"",
      "match": false
    },
    {
      "line": "header = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-011"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:bearer-token",
  "validationStatus": "VALIDATED"
}
