{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1237",
  "title": "Signal: Jaeger tracing UI disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*jaeger\\-ui)(?=[\\s\\S]*Jaeger)"
    }
  },
  "scope": "One response whose body contains both the jaeger-ui bundle and the product name.",
  "limitations": "One response body. The rule reports the UI shell; it does not fetch a trace and cannot show which attributes a span carries.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Jaeger</title></head><body><div id=\"jaeger-ui\"></div><script src=\"/static/jaeger-ui.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div class=\"jaeger-ui\"></div><span>Jaeger</span></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><div id=\"\"></div><script src=\"/static/.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published tracing UI is still reported; the finding is reachability.",
  "linkedRules": [
    "DPK-DAST-168"
  ],
  "origin": "original-authored",
  "cell": "dast:body-jaeger-ui:jaeger-ui",
  "validationStatus": "VALIDATED"
}
