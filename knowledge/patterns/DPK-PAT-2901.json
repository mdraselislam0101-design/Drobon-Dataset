{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2901",
  "title": "Signal: Repository declared non-canonical",
  "targets": [
    "composer"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "repositories[].canonical",
      "valuePattern": "^false$"
    }
  },
  "scope": "A composer.json file that declares a repository that load-balances with the default one.",
  "limitations": "It matches a repository that load-balances with the default one in the parsed composer.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "composer",
            "url": "https://mirror.acme.example",
            "canonical": false
          }
        ]
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "composer",
            "url": "https://mirror2.acme.example",
            "canonical": "false"
          }
        ]
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "composer",
            "url": "https://packagist.org",
            "canonical": true
          }
        ]
      },
      "match": false
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": []
      },
      "match": false
    }
  ],
  "fpNotes": "A composer.json that mentions a repository that load-balances with the default one in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0764"
  ],
  "origin": "original-authored",
  "cell": "sca:composer-repository-canonical-false",
  "validationStatus": "VALIDATED"
}
