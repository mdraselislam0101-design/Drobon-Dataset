{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0153",
  "title": "Signal: Framework SQL built from input (dapper) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.Query\\w*\\s*\\([^)]*(?:\\+|\\$)"
  },
  "scope": "Single-line lexical match on assembled SQL (dapper).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "db.Query(\"SELECT \" + q)",
      "match": true
    },
    {
      "line": "# audit: db.Query(\"SELECT \" + q) present",
      "match": true
    },
    {
      "line": "db.Query(FIXED)",
      "match": false
    },
    {
      "line": "# verified: db.Query(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-114"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli-extra:csharp:dapper",
  "validationStatus": "VALIDATED"
}
