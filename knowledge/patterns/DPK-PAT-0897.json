{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0897",
  "title": "Signal: SQL built by concatenation (ocaml) — review required",
  "targets": [
    "ocaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "exec\\s+[^\\n]*\\^"
  },
  "scope": "Single-line lexical match on assembled SQL in ocaml code.",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "exec c (\"SELECT \" ^ q)",
      "match": true
    },
    {
      "line": "# audit: exec c (\"SELECT \" ^ q) present",
      "match": true
    },
    {
      "line": "exec c FIXED",
      "match": false
    },
    {
      "line": "# verified: exec c FIXED",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-746"
  ],
  "origin": "original-authored",
