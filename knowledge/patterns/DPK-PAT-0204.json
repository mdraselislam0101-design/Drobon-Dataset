{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0204",
  "title": "Signal: Sensitive value in log call (swift) — review required",
  "targets": [
    "swift"
  ],
  "signal": {
    "kind": "regex",
    "source": "print\\s*\\([^)]*(?:password|passwd|secret|token)"
  },
  "scope": "Single-line lexical match on credential-named log values in swift code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "print(\"password=\\(pw)\")",
      "match": true
    },
    {
      "line": "# audit: print(\"password=\\(pw)\") present",
      "match": true
    },
    {
      "line": "print(\"user=\\(u)\")",
      "match": false
    },
    {
      "line": "# verified: print(\"user=\\(u)\")",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-165"
  ],
  "origin": "original-authored",
  "cell": "sast:log-langs:swift",
  "validationStatus": "VALIDATED"
}
