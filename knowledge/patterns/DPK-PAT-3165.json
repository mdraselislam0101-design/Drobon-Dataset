{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3165",
  "title": "Signal: Workspace dependency resolved from a local path",
  "targets": [
    "cargo"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "workspace.dependencies.*.path",
      "valuePattern": "^.+$"
    }
  },
  "scope": "A Cargo.toml file that declares a `path` key inside a `[workspace.dependencies]` entry.",
  "limitations": "It matches a `path` key inside a `[workspace.dependencies]` entry in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210",
            "acme-core": {
              "path": "../acme-core"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210",
            "acme-sdk": {
              "path": "crates/sdk"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210",
            "acme-core": {
              "version": "4.2.0"
            }
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Cargo.toml that mentions a `path` key inside a `[workspace.dependencies]` entry in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1028"
  ],
  "origin": "original-authored",
  "cell": "sca:cargo-workspace-dependency-path",
  "validationStatus": "VALIDATED"
}
