{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3158",
  "title": "Signal: Flutter package with no Flutter SDK constraint",
  "targets": [
    "pub"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "environment.flutter"
    }
  },
  "scope": "A pubspec.yaml file that declares an `environment` block that names no Flutter version.",
  "limitations": "It matches an `environment` block that names no Flutter version in the parsed pubspec.yaml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": true
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": true
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0",
          "flutter": ">=3.22.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": false
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0",
          "flutter": ">=3.24.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A pubspec.yaml that mentions an `environment` block that names no Flutter version in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1021"
  ],
  "origin": "original-authored",
  "cell": "sca:pub-flutter-constraint-absent",
  "validationStatus": "VALIDATED"
}
