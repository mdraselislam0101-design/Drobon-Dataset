{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0702",
  "title": "Signal: Sensitive value in log call (basic) — review required",
  "targets": [
    "basic"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:PRINT\\s+[^\\n]*(?:password|passwd|secret|token))"
  },
  "scope": "Single-line lexical match on credential-named log values in basic code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "PRINT \"password=\"; p",
      "match": true
    },
    {
      "line": "# audit: PRINT \"password=\"; p present",
      "match": true
    },
    {
      "line": "PRINT \"user=\"; u",
      "match": false
    },
    {
      "line": "# verified: PRINT \"user=\"; u",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-585"
  ],
  "origin": "original-authored",
  "cell": "sast:log-4:basic",
  "validationStatus": "VALIDATED"
}
