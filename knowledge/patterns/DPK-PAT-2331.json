{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2331",
  "title": "Signal: Cargo lockfile entry without a checksum",
  "targets": [
    "cargo"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "packages",
      "field": "checksum"
    }
  },
  "scope": "A Cargo.lock file that declares a locked crate that records no checksum.",
  "limitations": "It matches a locked crate that records no checksum in the parsed Cargo.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Cargo.lock",
      "document": {
        "version": 4,
        "packages": [
          {
            "name": "serde",
            "version": "1.0.210"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Cargo.lock",
      "document": {
        "version": 4,
        "packages": [
          {
            "name": "tokio",
            "version": "1.40.0"
          },
          {
            "name": "demo-service",
            "version": "0.1.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Cargo.lock",
      "document": {
        "version": 4,
        "packages": [
          {
            "name": "serde",
            "version": "1.0.210",
            "checksum": "aaaa"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Cargo.lock",
      "document": {
        "version": 4,
        "packages": [
          {
            "name": "tokio",
            "version": "1.40.0",
            "checksum": "bbbb"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Cargo.lock that mentions a locked crate that records no checksum in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0194"
  ],
  "origin": "original-authored",
  "cell": "sca:cargo-lock-checksum-absent",
  "validationStatus": "VALIDATED"
}
