{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0201",
  "title": "Signal: Sensitive value in log call (r) — review required",
  "targets": [
    "r"
  ],
  "signal": {
    "kind": "regex",
    "source": "(?:message|cat)\\s*\\([^)]*(?:password|passwd|secret|token)"
  },
  "scope": "Single-line lexical match on credential-named log values in r code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "message(\"password=\", pw)",
      "match": true
    },
    {
      "line": "# audit: message(\"password=\", pw) present",
      "match": true
    },
    {
      "line": "message(\"user=\", u)",
      "match": false
    },
    {
      "line": "# verified: message(\"user=\", u)",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-162"
  ],
  "origin": "original-authored",
  "cell": "sast:log-langs:r",
  "validationStatus": "VALIDATED"
}
