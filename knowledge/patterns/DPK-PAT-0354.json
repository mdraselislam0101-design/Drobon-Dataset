{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0354",
  "title": "Signal: Weak service hardening (all) — review required",
  "targets": [
    "squid"
  ],
  "signal": {
    "kind": "regex",
    "source": "http_access\\s+allow\\s+all"
  },
  "scope": "Single-line lexical match on weak settings (all).",
  "limitations": "Lexical, line-based: matches the setting regardless of host trust.",
  "examples": [
    {
      "line": "http_access allow all",
      "match": true
    },
    {
      "line": "# audit: http_access allow all present",
      "match": true
    },
    {
      "line": "http_access deny all",
      "match": false
    },
    {
      "line": "# verified: http_access deny all",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-315"
  ],
  "origin": "original-authored",
  "cell": "sast:sys-services:squid:all",
  "validationStatus": "VALIDATED"
}
