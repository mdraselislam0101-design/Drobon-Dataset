{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2909",
  "title": "Signal: Podfile.lock with no `SPEC CHECKSUMS` block",
  "targets": [
    "cocoapods"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "spec_checksums"
    }
  },
  "scope": "A Podfile.lock file that declares a lockfile that records no pod checksums.",
  "limitations": "It matches a lockfile that records no pod checksums in the parsed Podfile.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Podfile.lock",
      "document": {
        "pods": [
          {
            "name": "Alamofire",
            "version": "5.9.1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile.lock",
      "document": {
        "pods": []
      },
      "match": true
    },
    {
      "file": "Podfile.lock",
      "document": {
        "pods": [
          {
            "name": "Alamofire",
            "version": "5.9.1"
          }
        ],
        "spec_checksums": {
          "Alamofire": "a1b2c3d4e5f60718293a4b5c6d7e8f9012345678"
        }
      },
      "match": false
    },
    {
      "file": "Podfile.lock",
      "document": {
        "pods": [
          {
            "name": "Alamofire",
            "version": "5.9.1"
          }
        ],
        "spec_checksums": {
          "Alamofire": "a1b2c3d4e5f60718293a4b5c6d7e8f9012345678",
          "SnapKit": "9f2c3d4e5f60718293a4b5c6d7e8f90123456789"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Podfile.lock that mentions a lockfile that records no pod checksums in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0772"
  ],
  "origin": "original-authored",
  "cell": "sca:podfile-lock-checksum-absent",
  "validationStatus": "VALIDATED"
}
