{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0366",
  "title": "Signal: Risky Terraform setting (delprot) — review required",
  "targets": [
    "hcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "deletion_protection\\s*=\\s*false"
  },
  "scope": "Single-line lexical match on risky Terraform settings (delprot).",
  "limitations": "Lexical, line-based: matches the setting regardless of account scope.",
  "examples": [
    {
      "line": "deletion_protection = false",
      "match": true
    },
    {
      "line": "# audit: deletion_protection = false present",
      "match": true
    },
    {
      "line": "deletion_protection = true",
      "match": false
    },
    {
      "line": "# verified: deletion_protection = true",
      "match": false
    }
  ],
  "fpNotes": "Sandbox accounts are the common false positive — confirm account scope.",
  "linkedRules": [
    "DPK-SAST-327"
  ],
  "origin": "original-authored",
  "cell": "sast:terraform-strict:hcl:delprot",
  "validationStatus": "VALIDATED"
}
