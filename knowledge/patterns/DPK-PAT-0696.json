{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0696",
  "title": "Signal: Permissive Kubernetes pod (latest) — review required",
  "targets": [
    "k8s"
  ],
  "signal": {
    "kind": "regex",
    "source": "image\\s*:[^\\n]*:latest"
  },
  "scope": "Single-line lexical match on Kubernetes manifests.",
  "limitations": "Lexical, line-based: matches the grant.",
  "examples": [
    {
      "line": "image: app:latest",
      "match": true
    },
    {
      "line": "# audit: image: app:latest present",
      "match": true
    },
    {
      "line": "image: app:1.2.3",
      "match": false
    },
    {
      "line": "# verified: image: app:1.2.3",
      "match": false
    }
  ],
  "fpNotes": "Node agents are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-579"
  ],
  "origin": "original-authored",
  "cell": "sast:k8s-more:k8s:latest",
  "validationStatus": "VALIDATED"
}
