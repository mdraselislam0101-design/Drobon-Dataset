{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1470",
  "title": "Signal: Astro development toolbar served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*astro-dev-toolbar)(?=[\\s\\S]*astro)"
    }
  },
  "scope": "One response body containing the Astro toolbar element with the Astro marker.",
  "limitations": "One response body. The rule reports the toolbar element; it does not inspect the island data.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><main><h1>Home</h1></main><astro-dev-toolbar><template shadowrootmode=\"open\"></template></astro-dev-toolbar></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/pricing",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<astro-dev-toolbar data-islands=\"2\"></astro-dev-toolbar><script type=\"module\" src=\"/@id/astro:scripts/page.js\"></script><p>astro</p>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><main><h1>Home</h1></main><script type=\"module\" src=\"/_astro/index.abc123.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Astro guide</title></head><body><p>The toolbar appears only in the dev server.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that mentions the toolbar in prose is not reported, because the element is required.",
  "linkedRules": [
    "DPK-DAST-401"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-debug-astro-dev-toolbar:astro-dev-toolbar",
  "validationStatus": "VALIDATED"
}
