{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2911",
  "title": "Signal: R package that depends on a non-CRAN remote",
  "targets": [
    "cran"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "Remotes[]",
      "valuePattern": "^.+$"
    }
  },
  "scope": "A DESCRIPTION file that declares a `Remotes` entry that points outside CRAN.",
  "limitations": "It matches a `Remotes` entry that points outside CRAN in the parsed DESCRIPTION; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT",
        "Remotes": [
          "acme/core"
        ]
      },
      "match": true
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT",
        "Remotes": [
          "github::acme/sdk"
        ]
      },
      "match": true
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT",
        "Remotes": []
      },
      "match": false
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT"
      },
      "match": false
    }
  ],
  "fpNotes": "A DESCRIPTION that mentions a `Remotes` entry that points outside CRAN in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0774"
  ],
  "origin": "original-authored",
  "cell": "sca:cran-remotes-present",
  "validationStatus": "VALIDATED"
}
