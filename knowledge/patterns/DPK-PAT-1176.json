{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1176",
  "title": "Signal: Content-Security-Policy style-src allows every origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "^(?:(?!style-src(?=[\\s;]|$))[^;]*;\\s*)*style-src(?=[\\s;]|$)[^;]*?(?<=\\s)(?:\\*|(?:https?|wss?)://\\*)(?=\\s|;|$)"
    }
  },
  "scope": "One Content-Security-Policy value whose first style-src declaration contains the wildcard or a scheme wildcard host.",
  "limitations": "One header value, first declaration of the directive only. It reports the wildcard permission, not whether an attacker can influence the style sources a page loads.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "style-src *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; style-src 'self' https://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "style-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "style-src https://*.example.com"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "style-src 'self'; style-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "Pages that intentionally load styles from a content delivery network on every request can be reported; the observation cannot tell a curated list from an open one.",
  "linkedRules": [
    "DPK-DAST-107"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-style-src-wildcard:style-src",
  "validationStatus": "VALIDATED"
}
