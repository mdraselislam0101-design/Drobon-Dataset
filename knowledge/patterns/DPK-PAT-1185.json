{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1185",
  "title": "Signal: Link header points at a plaintext origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Link",
      "valuePattern": "<http://",
      "requireScheme": "https"
    }
  },
  "scope": "One https response whose Link header names an http:// target.",
  "limitations": "Header value check on one https response. The rule reads Link targets only, not resource hints expressed in markup or CSS, and it cannot prove the browser acted on the hint.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Link": "<http://cdn.example/app.css>; rel=preload; as=style"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Link": "<http://api.example>; rel=preconnect"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Link": "<https://cdn.example/app.css>; rel=preload"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Link": "<//cdn.example/app.css>; rel=preload"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Link": "<http://cdn.example/app.css>; rel=preload"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "An http:// target that immediately redirects to https is still reported; the first request already crossed the network in cleartext.",
  "linkedRules": [
    "DPK-DAST-116"
  ],
  "origin": "original-authored",
  "cell": "dast:link-header-plaintext:http-target",
  "validationStatus": "VALIDATED"
}
