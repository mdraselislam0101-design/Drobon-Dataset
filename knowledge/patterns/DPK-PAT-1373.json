{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1373",
  "title": "Signal: iframe sandbox combines allow-scripts with allow-same-origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<iframe[^>]{0,400}sandbox\\s*=\\s*[\"'][^\"']{0,200}allow-scripts[^\"']{0,200}allow-same-origin|<iframe[^>]{0,400}sandbox\\s*=\\s*[\"'][^\"']{0,200}allow-same-origin[^\"']{0,200}allow-scripts"
    }
  },
  "scope": "One iframe element whose sandbox attribute carries both allow-scripts and allow-same-origin.",
  "limitations": "One response body. The check reads the sandbox attribute; it does not execute the frame and cannot see attributes added at runtime.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/embed",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><iframe src=\"https://widget.example/w\" sandbox=\"allow-scripts allow-same-origin\"></iframe></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/embed",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<iframe width='600' height='400' src='/preview' sandbox='allow-same-origin allow-scripts allow-forms'></iframe>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/embed",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<iframe src=\"https://widget.example/w\" sandbox=\"allow-scripts\"></iframe>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/embed",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<iframe src=\"/preview\" title=\"preview\"></iframe>"
      },
      "match": false
    }
  ],
  "fpNotes": "A frame with only allow-scripts or only allow-same-origin is not reported; documentation that quotes the dangerous pair inside a code block is reported, which is stated as a known false positive.",
  "linkedRules": [
    "DPK-DAST-304"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-iframe-sandbox-escape:iframe-sandbox-both-tokens",
  "validationStatus": "VALIDATED"
}
