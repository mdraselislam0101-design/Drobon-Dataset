{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2908",
  "title": "Signal: Pod spec referenced over cleartext",
  "targets": [
    "cocoapods"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "pods[].podspec",
      "valuePattern": "^http://"
    }
  },
  "scope": "A Podfile file that declares a `podspec` URL over cleartext.",
  "limitations": "It matches a `podspec` URL over cleartext in the parsed Podfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "AcmeCore",
            "podspec": "http://specs.acme.example/AcmeCore.podspec"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "AcmeSDK",
            "podspec": "http://10.24.8.9/AcmeSDK.podspec"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "AcmeCore",
            "podspec": "https://specs.acme.example/AcmeCore.podspec"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": "~> 5.9"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Podfile that mentions a `podspec` URL over cleartext in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0771"
  ],
  "origin": "original-authored",
  "cell": "sca:podfile-podspec-cleartext",
  "validationStatus": "VALIDATED"
}
