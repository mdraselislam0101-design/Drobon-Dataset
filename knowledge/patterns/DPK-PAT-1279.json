{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1279",
  "title": "Signal: Location header names a script or data scheme",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Location",
      "valuePattern": "^\\s*(?:javascript|vbscript|data)\\s*:"
    }
  },
  "scope": "One response whose Location value begins with a script or data scheme.",
  "limitations": "One header value. The rule reports the scheme the header names; it cannot prove the value is attacker-influenced, and browsers differ in how they treat script schemes in a redirect.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 302,
        "headers": {
          "Location": "javascript:alert(document.domain)"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 302,
        "headers": {
          "Location": "data:text/html;base64,PHNjcmlwdD4="
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 302,
        "headers": {
          "Location": "https://app.example/login"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 302,
        "headers": {
          "Location": "/login"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "The rule judges the declared scheme only; a redirect to an attacker host over https is a different finding with its own rule.",
  "linkedRules": [
    "DPK-DAST-210"
  ],
  "origin": "original-authored",
  "cell": "dast:location-non-web-scheme:non-web-scheme",
  "validationStatus": "VALIDATED"
}
