{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0730",
  "title": "Signal: Dangerous PHP construct (assert) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "assert\\s*\\(\\s*\""
  },
  "scope": "Single-line lexical match on dangerous constructs (assert).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "assert(\"$x == 1\")",
      "match": true
    },
    {
      "line": "# audit: assert(\"$x == 1\") present",
      "match": true
    },
    {
      "line": "assert($x == 1)",
      "match": false
    },
    {
      "line": "# verified: assert($x == 1)",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-613"
  ],
  "origin": "original-authored",
  "cell": "sast:php-flag:php:assert",
  "validationStatus": "VALIDATED"
}
