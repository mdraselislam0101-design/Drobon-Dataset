{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0334",
  "title": "Signal: Weak SSH daemon setting (root) — review required",
  "targets": [
    "sshd"
  ],
  "signal": {
    "kind": "regex",
    "source": "PermitRootLogin\\s+yes"
  },
  "scope": "Single-line lexical match on sshd settings (root).",
  "limitations": "Lexical, line-based: matches the setting regardless of network exposure.",
  "examples": [
    {
      "line": "PermitRootLogin yes",
      "match": true
    },
    {
      "line": "# audit: PermitRootLogin yes present",
      "match": true
    },
    {
      "line": "PermitRootLogin no",
      "match": false
    },
    {
      "line": "# verified: PermitRootLogin no",
      "match": false
    }
  ],
  "fpNotes": "Isolated lab hosts are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-295"
  ],
  "origin": "original-authored",
  "cell": "sast:ssh-strict:sshd:root",
  "validationStatus": "VALIDATED"
}
