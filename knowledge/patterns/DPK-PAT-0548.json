{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0548",
  "title": "Signal: PBKDF2 with low iteration count (java) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "PBEKeySpec\\s*\\([^,]+,[^,]+,\\s*[0-9]{1,5}\\b"
  },
  "scope": "Single-line lexical match on PBKDF2 iteration counts in java code.",
  "limitations": "Lexical, line-based: matches small numeric counts; variable-driven counts are missed.",
  "examples": [
    {
      "line": "new PBEKeySpec(pw, salt, 1000, 256)",
      "match": true
    },
    {
      "line": "# audit: new PBEKeySpec(pw, salt, 1000, 256) present",
      "match": true
    },
    {
      "line": "new PBEKeySpec(pw, salt, 210000, 256)",
      "match": false
    },
    {
      "line": "# verified: new PBEKeySpec(pw, salt, 210000, 256)",
      "match": false
    }
  ],
  "fpNotes": "Test-only hashes are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-451"
  ],
  "origin": "original-authored",
  "cell": "sast:pbkdf2-low-iter:java",
  "validationStatus": "VALIDATED"
}
