{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1285",
  "title": "Signal: Argo CD GitOps console disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Argo\\ CD)(?=[\\s\\S]*Applications)"
    }
  },
  "scope": "One response whose body renders the Argo CD console.",
  "limitations": "One response body. The rule reports the UI; it does not trigger a sync and cannot show whether one would be accepted.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Argo CD</title></head><body><div id=\"argocd-ui\"></div><h1>Applications</h1><script src=\"/static/argocd.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><span>Argo CD</span><nav>Applications</nav><div class=\"argo-app\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><div id=\"argocd-ui\"></div><h1></h1><script src=\"/static/argocd.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A job scheduler UI is a different product and a different rule.",
  "linkedRules": [
    "DPK-DAST-216"
  ],
  "origin": "original-authored",
  "cell": "dast:body-argocd-ui:argocd-ui",
  "validationStatus": "VALIDATED"
}
