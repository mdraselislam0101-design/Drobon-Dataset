{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2141",
  "title": "Signal: Dependency declared with an x-range major",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^\\d{1,3}\\.x$"
    }
  },
  "scope": "A package.json file that declares an `N.x` major range, which accepts every minor and patch release of that major.",
  "limitations": "It matches an `N.x` major range, which accepts every minor and patch release of that major in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "webpack": "5.x"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "jest": "29.x"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "webpack": "5.93.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "jest": "^29.7.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A manifest that pins a caret range on the same major is not reported by this rule.",
  "linkedRules": [
    "DPK-SCA-0004"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-major-x-range",
  "validationStatus": "VALIDATED"
}
