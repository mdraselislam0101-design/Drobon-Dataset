{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0312",
  "title": "Signal: guest left open (samba) — review required",
  "targets": [
    "samba"
  ],
  "signal": {
    "kind": "regex",
    "source": "guest\\s+ok\\s*=\\s*yes"
  },
  "scope": "Single-line lexical match on open settings for guest.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "guest ok = yes",
      "match": true
    },
    {
      "line": "# audit: guest ok = yes present",
      "match": true
    },
    {
      "line": "guest ok = no",
      "match": false
    },
    {
      "line": "# verified: guest ok = no",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-273"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:samba:guest",
  "validationStatus": "VALIDATED"
}
