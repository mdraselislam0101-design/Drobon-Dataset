{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0102",
  "title": "Signal: Credential noted in a work comment (universal) — review required",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "(?:TODO|FIXME|XXX|HACK)\\b[^#\\n]*(?:password|passwd|secret|token)\\s*[:=]"
  },
  "scope": "Single-line lexical match on credential notes in comments.",
  "limitations": "Lexical, line-based: matches credential-adjacent notes regardless of value liveness.",
  "examples": [
    {
      "line": "// TODO: password = hunter2-x",
      "match": true
    },
    {
      "line": "# audit: // TODO: password = hunter2-x present",
      "match": true
    },
    {
      "line": "// TODO: refactor this",
      "match": false
    },
    {
      "line": "# verified: // TODO: refactor this",
      "match": false
    }
  ],
  "fpNotes": "Placeholder-shaped notes (changeme, xxx) are the common false positive.",
  "linkedRules": [
    "DPK-SAST-063"
  ],
  "origin": "original-authored",
  "cell": "sast:comment-secret:universal",
  "validationStatus": "VALIDATED"
}
