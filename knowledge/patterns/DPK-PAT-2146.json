{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2146",
  "title": "Signal: Dependency declared with the GitHub shorthand",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^github:"
    }
  },
  "scope": "A package.json file that declares the `github:` dependency shorthand, which resolves a repository default branch.",
  "limitations": "It matches the `github:` dependency shorthand, which resolves a repository default branch in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "github:acme/sdk"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-ui": "github:acme/ui#main"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "^4.2.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "https://github.com/acme/sdk"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A shorthand naming a commit sha is still reported as a non-registry source; the rule reports the source kind.",
  "linkedRules": [
    "DPK-SCA-0009"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-github-shorthand",
  "validationStatus": "VALIDATED"
}
