{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1339",
  "title": "Signal: Permissions-Policy grants a device-access feature to every origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Permissions-Policy",
      "valuePattern": "(?:^|[,;])\\s*(?:usb|serial|hid|bluetooth|midi|nfc|idle-detection|screen-wake-lock|display-capture)\\s*=\\s*\\(?\\s*\\*"
    }
  },
  "scope": "One response whose Permissions-Policy grants a device-access feature to *.",
  "limitations": "One header value. The rule reports the declared allow-list and cannot observe whether an embedded frame exists or whether the user would grant the prompt.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "usb=*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "camera=(), usb=(*)"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "usb=()"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "camera=*"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "usb=(self \"https://app.example\")"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "camera=(), serial=*"
        }
      },
      "match": true
    }
  ],
  "fpNotes": "The camera, microphone and geolocation grant is a separate rule with its own wording.",
  "linkedRules": [
    "DPK-DAST-270"
  ],
  "origin": "original-authored",
  "cell": "dast:permissions-policy-device-feature-wildcard:policy-device-feature-wildcard",
  "validationStatus": "VALIDATED"
}
