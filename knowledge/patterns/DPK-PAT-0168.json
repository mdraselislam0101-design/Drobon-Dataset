{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0168",
  "title": "Signal: Framework SQL built from input (djangoraw) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.raw\\s*\\([^)]*(?:\\+|%|\\{)"
  },
  "scope": "Single-line lexical match on assembled framework SQL (djangoraw).",
  "limitations": "Lexical, line-based: any assembled query matches, including trusted ones.",
  "examples": [
    {
      "line": "M.objects.raw(\"SELECT \" + c)",
      "match": true
    },
    {
      "line": "# audit: M.objects.raw(\"SELECT \" + c) present",
      "match": true
    },
    {
      "line": "M.objects.raw(FIXED)",
      "match": false
    },
    {
      "line": "# verified: M.objects.raw(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-129"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli:python:djangoraw",
  "validationStatus": "VALIDATED"
}
