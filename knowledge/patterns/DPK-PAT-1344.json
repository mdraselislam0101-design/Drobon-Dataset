{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1344",
  "title": "Signal: Meta refresh navigates an HTTPS page to a plaintext URL",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<meta\\b[^>]*http-equiv\\s*=\\s*[\"']?refresh[\"']?[^>]*url\\s*=\\s*[\"']?\\s*http://",
      "requireScheme": "https"
    }
  },
  "scope": "One HTTPS response body containing a meta refresh element whose target URL starts with http.",
  "limitations": "One response body. The check reports a meta refresh element whose URL starts with http on a page fetched over https; it does not follow redirect chains, so an https target that later redirects to http is not reported.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<meta http-equiv=\"refresh\" content=\"0; url=http://app.example/dashboard\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<META HTTP-EQUIV=\"Refresh\" CONTENT=\"5;URL=http://legacy.example/portal\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<meta http-equiv=\"refresh\" content=\"0; url=https://app.example/dashboard\">"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<meta http-equiv=\"refresh\" content=\"30\">"
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {},
        "body": "<meta http-equiv=\"refresh\" content=\"0; url=http://app.example/dashboard\">"
      },
      "match": false
    }
  ],
  "fpNotes": "A template with a commented-out meta refresh is reported; the finding is the markup, and the owner should confirm the element is not rendered.",
  "linkedRules": [
    "DPK-DAST-275"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-meta-refresh-http:meta-refresh-http",
  "validationStatus": "VALIDATED"
}
