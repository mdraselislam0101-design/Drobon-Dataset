{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2932",
  "title": "Signal: Yarn immutable installs disabled",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "enableImmutableInstalls",
      "valuePattern": "^false$"
    }
  },
  "scope": "A .yarnrc.yml file that declares an `enableImmutableInstalls=false` setting.",
  "limitations": "It matches an `enableImmutableInstalls=false` setting in the parsed .yarnrc.yml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": ".yarnrc.yml",
      "document": {
        "npmRegistryServer": "https://registry.yarnpkg.com",
        "enableStrictSsl": "true",
        "enableImmutableInstalls": "false",
        "nodeLinker": "node-modules"
      },
      "match": true
    },
    {
      "file": ".yarnrc.yml",
      "document": {
        "npmRegistryServer": "https://registry.yarnpkg.com",
        "enableStrictSsl": "true",
        "enableImmutableInstalls": false,
        "nodeLinker": "node-modules"
      },
      "match": true
    },
    {
      "file": ".yarnrc.yml",
      "document": {
        "npmRegistryServer": "https://registry.yarnpkg.com",
        "enableStrictSsl": "true",
        "enableImmutableInstalls": "true",
        "nodeLinker": "node-modules"
      },
      "match": false
    },
    {
      "file": ".yarnrc.yml",
      "document": {
        "npmRegistryServer": "https://registry.yarnpkg.com",
        "enableStrictSsl": "true",
        "enableImmutableInstalls": true,
        "nodeLinker": "node-modules"
      },
      "match": false
    }
  ],
  "fpNotes": "A .yarnrc.yml that mentions an `enableImmutableInstalls=false` setting in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0795"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-yarn-immutable-off",
  "validationStatus": "VALIDATED"
}
