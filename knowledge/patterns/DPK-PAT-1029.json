{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1029",
  "title": "Signal: JWT signature verification disabled in python — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "[\"']?verify_signature[\"']?\\s*[:=]\\s*(?:False|false)"
  },
  "scope": "Single-line match on verify_signature disabled in python.",
  "limitations": "Lexical: matches the explicit option assignment on one line; custom verifier wrappers are out of scope.",
  "examples": [
    {
      "line": "jwt.decode(token, options={\"verify_signature\": False})",
      "match": true
    },
    {
      "line": "# audit: jwt.decode(token, options={\"verify_signature\": False}) present",
      "match": true
    },
    {
      "line": "jwt.decode(token, options={\"verify_signature\": True})",
      "match": false
    },
    {
      "line": "# verified: jwt.decode(token, options={\"verify_signature\": True})",
      "match": false
    }
  ],
  "fpNotes": "Decoders used only to read an already-verified token’s claims are the accepted exception and must say so.",
  "linkedRules": [
    "DPK-SAST-848"
  ],
  "origin": "original-authored",
  "cell": "sast:jwt-verify-disabled:python",
  "validationStatus": "VALIDATED"
}
