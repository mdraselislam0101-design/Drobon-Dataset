{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0695",
  "title": "Signal: Permissive Kubernetes pod (hostpid) — review required",
  "targets": [
    "k8s"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:hostPID\\s*:\\s*true)"
  },
  "scope": "Single-line lexical match on Kubernetes manifests.",
  "limitations": "Lexical, line-based: matches the grant.",
  "examples": [
    {
      "line": "hostPID: true",
      "match": true
    },
    {
      "line": "# audit: hostPID: true present",
      "match": true
    },
    {
      "line": "hostPID: false",
      "match": false
    },
    {
      "line": "# verified: hostPID: false",
      "match": false
    }
  ],
  "fpNotes": "Node agents are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-578"
  ],
  "origin": "original-authored",
  "cell": "sast:k8s-more:k8s:hostpid",
  "validationStatus": "VALIDATED"
}
