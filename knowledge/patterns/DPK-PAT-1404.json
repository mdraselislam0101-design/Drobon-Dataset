{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1404",
  "title": "Signal: Apache access log served as a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?:^|\\n)\\d{1,3}(?:\\.\\d{1,3}){3}\\s+\\S{1,40}\\s+\\S{1,40}\\s+\\[[^\\]\\n]{8,40}\\]\\s+\"(?:GET|POST|HEAD|PUT|DELETE) [^\"\\n]{0,200} HTTP/1\\.[01]\"\\s+[1-5]\\d{2}\\s"
    }
  },
  "scope": "One response body containing combined-format access log lines.",
  "limitations": "One response body. The rule recognises the combined log format; a custom log format is not reported.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/logs/access.log",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "203.0.113.7 - - [11/May/2024:09:14:02 +0000] \"GET /login HTTP/1.1\" 200 5123 \"-\" \"Mozilla/5.0\"\n203.0.113.9 - - [11/May/2024:09:14:09 +0000] \"POST /api/orders?token=abc HTTP/1.1\" 201 88 \"-\" \"curl/8.4.0\"\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/access.log",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "10.1.2.3 - alice [11/May/2024:10:02:44 +0000] \"GET /admin/users HTTP/1.1\" 403 240 \"-\" \"Mozilla/5.0\"\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/admin/metrics",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "requests_total 18422\nrequests_failed 91\n"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/logging",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Logs use the combined format and live in /var/log.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that shows a single sample log line is reported when it is a complete combined line; a table of metrics derived from logs is not reported.",
  "linkedRules": [
    "DPK-DAST-335"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-artefact-access-log-served:access-log-served",
  "validationStatus": "VALIDATED"
}
