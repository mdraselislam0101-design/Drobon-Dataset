{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2354",
  "title": "Signal: mix.lock entry without a checksum",
  "targets": [
    "hex"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "packages",
      "field": "hash"
    }
  },
  "scope": "A mix.lock file that declares a locked package that records no hash.",
  "limitations": "It matches a locked package that records no hash in the parsed mix.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "mix.lock",
      "document": {
        "packages": {
          "phoenix": {
            "version": "1.7.10"
          }
        }
      },
      "match": true
    },
    {
      "file": "mix.lock",
      "document": {
        "packages": {
          "ecto": {
            "version": "3.11.2"
          },
          "phoenix": {
            "version": "1.7.10",
            "hash": "sha256:aaaa"
          }
        }
      },
      "match": true
    },
    {
      "file": "mix.lock",
      "document": {
        "packages": {
          "phoenix": {
            "version": "1.7.10",
            "hash": "sha256:aaaa"
          }
        }
      },
      "match": false
    },
    {
      "file": "mix.lock",
      "document": {
        "packages": {
          "ecto": {
            "version": "3.11.2",
            "hash": "sha256:bbbb"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A mix.lock that mentions a locked package that records no hash in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0217"
  ],
  "origin": "original-authored",
  "cell": "sca:hex-lock-hash-absent",
  "validationStatus": "VALIDATED"
}
