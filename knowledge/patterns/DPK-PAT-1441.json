{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1441",
  "title": "Signal: Laravel Horizon dashboard disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*<title>Horizon)(?=[\\s\\S]*horizon)"
    }
  },
  "scope": "One response body containing the Horizon dashboard shell and its metrics label.",
  "limitations": "One response body. The rule reports the dashboard shell; it does not retry a job.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/horizon",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Horizon</title></head><body><div id=\"horizon\"><span>Jobs per minute 142</span><a href=\"/horizon/failed\">Failed jobs</a></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/horizon/failed",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Horizon · Failed</title></head><body><div class=\"horizon-failed\"><pre>{\"uuid\":\"9b1\",\"payload\":\"orders.sync\"}</pre></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/queue",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Queue</title></head><body><p>All workers are healthy.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/queue",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Horizon requires a gate before it is mounted in production.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that names Horizon in prose is not reported, because the shell markup is required.",
  "linkedRules": [
    "DPK-DAST-372"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-page-laravel-horizon:laravel-horizon",
  "validationStatus": "VALIDATED"
}
