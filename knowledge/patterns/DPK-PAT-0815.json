{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0815",
  "title": "Signal: Weak SSH daemon setting (tcpfwd) — review required",
  "targets": [
    "sshd"
  ],
  "signal": {
    "kind": "regex",
    "source": "AllowTcpForwarding\\s+yes"
  },
  "scope": "Single-line lexical match on sshd settings.",
  "limitations": "Lexical, line-based: matches the setting regardless of Match blocks.",
  "examples": [
    {
      "line": "AllowTcpForwarding yes",
      "match": true
    },
    {
      "line": "# audit: AllowTcpForwarding yes present",
      "match": true
    },
    {
      "line": "AllowTcpForwarding no",
      "match": false
    },
    {
      "line": "# verified: AllowTcpForwarding no",
      "match": false
    }
  ],
  "fpNotes": "Bastion-specific needs are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-698"
  ],
  "origin": "original-authored",
  "cell": "sast:sshd-strict:sshd:tcpfwd",
  "validationStatus": "VALIDATED"
}
