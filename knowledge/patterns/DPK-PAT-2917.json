{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2917",
  "title": "Signal: Conda environment that installs a pip dependency from git",
  "targets": [
    "conda"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies[].pip[]",
      "valuePattern": "^git\\+"
    }
  },
  "scope": "A environment.yml file that declares a `pip:` entry with a `git+` URL.",
  "limitations": "It matches a `pip:` entry with a `git+` URL in the parsed environment.yml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "environment.yml",
      "document": {
        "name": "demo",
        "channels": [
          "conda-forge",
          "defaults"
        ],
        "dependencies": [
          {
            "pip": [
              "git+https://github.com/acme/sdk"
            ]
          }
        ]
      },
      "match": true
    },
    {
      "file": "environment.yml",
      "document": {
        "name": "demo",
        "channels": [
          "conda-forge",
          "defaults"
        ],
        "dependencies": [
          {
            "pip": [
              "git+ssh://git@github.com/acme/core"
            ]
          }
        ]
      },
      "match": true
    },
    {
      "file": "environment.yml",
      "document": {
        "name": "demo",
        "channels": [
          "conda-forge",
          "defaults"
        ],
        "dependencies": [
          {
            "pip": [
              "requests==2.32.3"
            ]
          }
        ]
      },
      "match": false
    },
    {
      "file": "environment.yml",
      "document": {
        "name": "demo",
        "channels": [
          "conda-forge",
          "defaults"
        ],
        "dependencies": [
          "numpy=1.26.4"
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A environment.yml that mentions a `pip:` entry with a `git+` URL in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0780"
  ],
  "origin": "original-authored",
  "cell": "sca:conda-environment-pip-git",
  "validationStatus": "VALIDATED"
}
