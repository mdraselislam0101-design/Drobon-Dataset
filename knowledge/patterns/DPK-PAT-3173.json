{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3173",
  "title": "Signal: Possible a Braintree access token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "access_token\\$production\\$[a-z0-9]{6,16}\\$[a-f0-9]{32}"
  },
  "scope": "Single-line shape match for a Braintree access token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"access_token$production$acme12$aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"",
      "match": true
    },
    {
      "line": "# audit: token = \"access_token$production$acme12$aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-113"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-4:braintree-access-token",
  "validationStatus": "VALIDATED"
}
