{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0349",
  "title": "Signal: Weak service hardening (runnerpriv) — review required",
  "targets": [
    "gitlab"
  ],
  "signal": {
    "kind": "regex",
    "source": "privileged\\s*=\\s*true"
  },
  "scope": "Single-line lexical match on weak settings (runnerpriv).",
  "limitations": "Lexical, line-based: matches the setting regardless of host trust.",
  "examples": [
    {
      "line": "privileged = true",
      "match": true
    },
    {
      "line": "# audit: privileged = true present",
      "match": true
    },
    {
      "line": "privileged = false",
      "match": false
    },
    {
      "line": "# verified: privileged = false",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-310"
  ],
  "origin": "original-authored",
  "cell": "sast:sys-services:gitlab:runnerpriv",
  "validationStatus": "VALIDATED"
}
