{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0731",
  "title": "Signal: Dangerous PHP construct (backtick) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "`[^`]*\\$"
  },
  "scope": "Single-line lexical match on dangerous constructs (backtick).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "`$cmd`",
      "match": true
    },
    {
      "line": "# audit: `$cmd` present",
      "match": true
    },
    {
      "line": "`ls`",
      "match": false
    },
    {
      "line": "# verified: `ls`",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-614"
  ],
  "origin": "original-authored",
  "cell": "sast:php-flag:php:backtick",
  "validationStatus": "VALIDATED"
}
