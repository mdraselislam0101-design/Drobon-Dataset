{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1284",
  "title": "Signal: Prometheus Alertmanager UI disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Alertmanager)(?=[\\s\\S]*Silences)"
    }
  },
  "scope": "One response whose body renders the Alertmanager console.",
  "limitations": "One response body. The rule reports the UI; it does not create a silence and cannot show whether the request would be accepted.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Alertmanager</title></head><body><nav><a href=\"/alerts\">Alerts</a><a href=\"/silences\">Silences</a></nav></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h1>Alertmanager</h1><ul><li>Alerts</li><li>Silences</li><li>Status</li></ul></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><nav><a href=\"/alerts\">Alerts</a><a href=\"/\"></a></nav></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "The Prometheus metrics rule is a different product and a different page.",
  "linkedRules": [
    "DPK-DAST-215"
  ],
  "origin": "original-authored",
  "cell": "dast:body-alertmanager-ui:alertmanager-ui",
  "validationStatus": "VALIDATED"
}
