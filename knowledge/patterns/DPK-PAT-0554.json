{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0554",
  "title": "Signal: TLS verification disabled (dart) — review required",
  "targets": [
    "dart"
  ],
  "signal": {
    "kind": "regex",
    "source": "badCertificateCallback\\s*=\\s*[^;]*=>\\s*true"
  },
  "scope": "Single-line lexical match on TLS-disabling settings in dart code.",
  "limitations": "Lexical, line-based: matches the switch regardless of environment.",
  "examples": [
    {
      "line": "badCertificateCallback = (_) => true;",
      "match": true
    },
    {
      "line": "# audit: badCertificateCallback = (_) => true; present",
      "match": true
    },
    {
      "line": "badCertificateCallback = check;",
      "match": false
    },
    {
      "line": "# verified: badCertificateCallback = check;",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive.",
  "linkedRules": [
    "DPK-SAST-457"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-langs:dart",
  "validationStatus": "VALIDATED"
}
