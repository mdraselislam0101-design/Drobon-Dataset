{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1424",
  "title": "Signal: Nagios Core console is reachable without authentication",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*<title>[^<]{0,40}Nagios)(?=[\\s\\S]*Service Status Details)"
    }
  },
  "scope": "One response body whose title names Nagios and whose legend identifies the Core interface.",
  "limitations": "One response body. The rule recognises the Nagios Core shell from its title and legend; it does not read the status data behind it.",
  "examples": [
    {
      "observation": {
        "url": "https://ops.example/nagios/cgi-bin/status.cgi",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Nagios Core 4.4.6</title></head><body><h1>Service Status Details</h1><table><tr><td>db01</td><td>Disk Usage</td></tr></table></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://ops.example/nagios/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Nagios</title></head><body><h2>Tactical Overview</h2><p>Service Status Details for all hosts</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://docs.example/nagios",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Monitoring guide</title></head><body><h1>Nagios checks</h1></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://ops.example/ui",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Grafana</title></head><body><div id=\"app\"></div></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A documentation page that names Nagios is not reported, because the interface legend is required alongside the title.",
  "linkedRules": [
    "DPK-DAST-355"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-console-nagios:nagios-console",
  "validationStatus": "VALIDATED"
}
