{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2295",
  "title": "Signal: Maven dependency without a version",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "project.dependencies",
      "field": "version"
    }
  },
  "scope": "A pom.xml file that declares a dependency that declares no version and no import scope.",
  "limitations": "It matches a dependency that declares no version and no import scope in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "internal-core"
            },
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api",
              "version": "2.0.13"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "internal-util"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "internal-core",
              "version": "1.2.0"
            },
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api",
              "version": "2.0.13"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "internal-util",
              "version": "2.0.0"
            },
            {
              "groupId": "com.zaxxer",
              "artifactId": "HikariCP",
              "version": "5.1.0"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pom.xml that mentions a dependency that declares no version and no import scope in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0158"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-dependency-version-absent",
  "validationStatus": "VALIDATED"
}
