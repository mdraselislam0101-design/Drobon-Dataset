{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0827",
  "title": "Signal: Server-side fetch of assembled URL (tcl) — review required",
  "targets": [
    "tcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:http::geturl\\s+\\$)"
  },
  "scope": "Single-line lexical match on assembled fetch URLs in tcl code.",
  "limitations": "Lexical, line-based: any assembled fetch URL matches.",
  "examples": [
    {
      "line": "http::geturl $u",
      "match": true
    },
    {
      "line": "# audit: http::geturl $u present",
      "match": true
    },
    {
      "line": "http::geturl http://fixed/",
      "match": false
    },
    {
      "line": "# verified: http::geturl http://fixed/",
      "match": false
    }
  ],
  "fpNotes": "Fixed hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-710"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-4:tcl",
  "validationStatus": "VALIDATED"
}
