{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1218",
  "title": "Signal: Content-Security-Policy carries an obsolete or removed directive",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "(?:^|;)\\s*(?:plugin-types|reflected-xss|referrer|disown-opener)\\s*(?:[;]|\\s|$)"
    }
  },
  "scope": "One response whose Content-Security-Policy contains a removed directive name.",
  "limitations": "One header value. The rule matches the directive names that are documented as removed or non-implemented; it does not evaluate whether the policy still achieves the intended control through another directive.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; plugin-types application/pdf"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "reflected-xss block; default-src 'self'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; referrer no-referrer"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; disown-opener"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; referrer-policy no-referrer"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; script-src 'nonce-abc'"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Policies generated by older frameworks often carry these tokens; the finding is that the control is inert, not that the site is unprotected overall.",
  "linkedRules": [
    "DPK-DAST-149"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-obsolete-directive:obsolete-directive",
  "validationStatus": "VALIDATED"
}
