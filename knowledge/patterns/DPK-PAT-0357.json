{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0357",
  "title": "Signal: Weak service hardening (protectsys) — review required",
  "targets": [
    "systemd"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:ProtectSystem\\s*=\\s*no)"
  },
  "scope": "Single-line lexical match on weak settings (protectsys).",
  "limitations": "Lexical, line-based: matches the setting regardless of host trust.",
  "examples": [
    {
      "line": "ProtectSystem=no",
      "match": true
    },
    {
      "line": "# audit: ProtectSystem=no present",
      "match": true
    },
    {
      "line": "ProtectSystem=strict",
      "match": false
    },
    {
      "line": "# verified: ProtectSystem=strict",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-318"
  ],
  "origin": "original-authored",
  "cell": "sast:sys-services:systemd:protectsys",
  "validationStatus": "VALIDATED"
}
