{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0545",
  "title": "Signal: Cleartext legacy protocol (ftp, universal) — review required",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "(?:^|[^a-zA-Z])(?:tftp|ftp)://[A-Za-z0-9]"
  },
  "scope": "Single-line lexical match on legacy protocol use (ftp).",
  "limitations": "Lexical, line-based: matches the use regardless of network isolation.",
  "examples": [
    {
      "line": "url = \"ftp://h/f\"",
      "match": true
    },
    {
      "line": "# audit: url = \"ftp://h/f\" present",
      "match": true
    },
    {
      "line": "url = \"sftp://h/f\"",
      "match": false
    },
    {
      "line": "# verified: url = \"sftp://h/f\"",
      "match": false
    }
  ],
  "fpNotes": "Isolated legacy segments are the common accepted case — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-448"
  ],
  "origin": "original-authored",
  "cell": "sast:legacy-proto:universal:ftp",
  "validationStatus": "VALIDATED"
}
