{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2910",
  "title": "Signal: R package that declares no licence restriction",
  "targets": [
    "cran"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "License",
      "valuePattern": "^Unlimited$"
    }
  },
  "scope": "A DESCRIPTION file that declares a `License: Unlimited` field.",
  "limitations": "It matches a `License: Unlimited` field in the parsed DESCRIPTION; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "Unlimited"
      },
      "match": true
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.2.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "Unlimited"
      },
      "match": true
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT + file LICENSE"
      },
      "match": false
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "GPL-3"
      },
      "match": false
    }
  ],
  "fpNotes": "A DESCRIPTION that mentions a `License: Unlimited` field in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0773"
  ],
  "origin": "original-authored",
  "cell": "sca:cran-license-unlimited",
  "validationStatus": "VALIDATED"
}
