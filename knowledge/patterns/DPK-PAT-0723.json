{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0723",
  "title": "Signal: File access built from input (ocaml) — review required",
  "targets": [
    "ocaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:open_in\\s*\\([^)]*\\^)"
  },
  "scope": "Single-line lexical match on input-built paths in ocaml code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "open_in (dir ^ f)",
      "match": true
    },
    {
      "line": "# audit: open_in (dir ^ f) present",
      "match": true
    },
    {
      "line": "open_in fixed",
      "match": false
    },
    {
      "line": "# verified: open_in fixed",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-606"
  ],
  "origin": "original-authored",
  "cell": "sast:path-3:ocaml",
  "validationStatus": "VALIDATED"
}
