{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2068",
  "title": "Signal: Impersonated session recorded in the response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "\"(?:impersonatedBy|actingAs|onBehalfOf)\"\\s*:\\s*\"[A-Za-z0-9._-]{2,40}\""
    }
  },
  "scope": "A response body that carries a session that names the staff member who is impersonating the customer.",
  "limitations": "One response body, first 32,768 bytes. It matches an impersonation marker with an actor; it cannot tell whether the value behind the marker is live or whether the page needs authentication.",
  "examples": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"session\":{\"impersonatedBy\":\"officer.rahman\",\"customerId\":\"C-8841\"}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"actingAs\": \"ops.desk2\", \"scope\":\"read\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"session\":{\"customerId\":\"C-8841\",\"channel\":\"APP\"}}"
      },
      "match": false
    }
  ],
  "fpNotes": "A support page that explains the process is not reported.",
  "linkedRules": [
    "DPK-DAST-949"
  ],
  "origin": "original-authored",
  "cell": "dast:body-impersonation-session:body-impersonation-session",
  "validationStatus": "VALIDATED"
}
