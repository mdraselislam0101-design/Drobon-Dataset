{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0590",
  "title": "Signal: OS command execution via exec (tcl) — review required",
  "targets": [
    "tcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:exec)\\s*\\("
  },
  "scope": "Single-line lexical match on the exec call in tcl code.",
  "limitations": "Lexical, line-based: any exec call matches.",
  "examples": [
    {
      "line": "exec(payload)",
      "match": true
    },
    {
      "line": "out = exec(data)",
      "match": true
    },
    {
      "line": "myexec(x)",
      "match": false
    },
    {
      "line": "exec_safe()",
      "match": false
    }
  ],
  "fpNotes": "Fixed maintenance commands are the common false positive.",
  "linkedRules": [
    "DPK-SAST-473"
  ],
  "origin": "original-authored",
  "cell": "sast:cmd-exec-3:tcl",
  "validationStatus": "VALIDATED"
}
