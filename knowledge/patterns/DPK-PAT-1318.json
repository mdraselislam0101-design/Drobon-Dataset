{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1318",
  "title": "Signal: ASP.NET web.config served with settings",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*<system\\.webServer>)(?=[\\s\\S]*</configuration>)"
    }
  },
  "scope": "One response whose body is an ASP.NET configuration document with a system.webServer section.",
  "limitations": "One response body. The rule reports the configuration schema; it does not enumerate the values and cannot tell whether the credentials are still valid.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?><configuration><connectionStrings><add name=\"shop\" connectionString=\"Server=db;Database=shop;User Id=sa;Password=Pa55w0rd!\"/></connectionStrings><system.webServer><handlers><add name=\"x\" path=\"*.x\" verb=\"*\"/></handlers></system.webServer></configuration>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?xml version=\"1.0\"?><configuration><appSettings><add key=\"ApiKey\" value=\"abc123\"/></appSettings><system.webServer><httpErrors mode=\"Detailed\"/></system.webServer></configuration>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?><configuration><connectionStrings><add name=\"shop\" connectionString=\"Server=db;Database=shop;User Id=sa;Password=Pa55w0rd!\"/></connectionStrings><handlers><add name=\"x\" path=\"*.x\" verb=\"*\"/></handlers></system.webServer>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A documentation page that quotes a configuration fragment is reported only when the full document shape appears.",
  "linkedRules": [
    "DPK-DAST-249"
  ],
  "origin": "original-authored",
  "cell": "dast:body-webconfig-served:webconfig-served",
  "validationStatus": "VALIDATED"
}
