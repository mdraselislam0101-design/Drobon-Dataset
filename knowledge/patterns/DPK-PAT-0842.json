{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0842",
  "title": "Signal: Umask cleared to zero (perl) — review required",
  "targets": [
    "perl"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:umask\\s+0\\b)"
  },
  "scope": "Single-line lexical match on umask clearing in perl code.",
  "limitations": "Lexical, line-based: matches the clearing.",
  "examples": [
    {
      "line": "umask 0",
      "match": true
    },
    {
      "line": "# audit: umask 0 present",
      "match": true
    },
    {
      "line": "umask 022",
      "match": false
    },
    {
      "line": "# verified: umask 022",
      "match": false
    }
  ],
  "fpNotes": "Brief scoped clearing is the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-725"
  ],
  "origin": "original-authored",
  "cell": "sast:umask-zero:perl",
  "validationStatus": "VALIDATED"
}
