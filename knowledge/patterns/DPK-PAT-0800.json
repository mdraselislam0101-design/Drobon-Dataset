{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0800",
  "title": "Signal: Risky Spring setting (health) — review required",
  "targets": [
    "properties"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:endpoints\\.health\\.sensitive\\s*=\\s*false)"
  },
  "scope": "Single-line lexical match on Spring config.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "endpoints.health.sensitive=false",
      "match": true
    },
    {
      "line": "# audit: endpoints.health.sensitive=false present",
      "match": true
    },
    {
      "line": "endpoints.health.sensitive=true",
      "match": false
    },
    {
      "line": "# verified: endpoints.health.sensitive=true",
      "match": false
    }
  ],
  "fpNotes": "Local development is the common false positive.",
  "linkedRules": [
    "DPK-SAST-683"
  ],
  "origin": "original-authored",
  "cell": "sast:spring-risk:properties:health",
  "validationStatus": "VALIDATED"
}
