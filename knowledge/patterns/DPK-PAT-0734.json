{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0734",
  "title": "Signal: Dangerous PHP construct (pregee) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "preg_replace\\s*\\(\\s*[\"'][^\"']*/e"
  },
  "scope": "Single-line lexical match on dangerous constructs (pregee).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "preg_replace(\"/x/e\", $r, $s)",
      "match": true
    },
    {
      "line": "# audit: preg_replace(\"/x/e\", $r, $s) present",
      "match": true
    },
    {
      "line": "preg_replace(\"/x/\", $r, $s)",
      "match": false
    },
    {
      "line": "# verified: preg_replace(\"/x/\", $r, $s)",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-617"
  ],
  "origin": "original-authored",
  "cell": "sast:php-flag:php:pregee",
  "validationStatus": "VALIDATED"
}
