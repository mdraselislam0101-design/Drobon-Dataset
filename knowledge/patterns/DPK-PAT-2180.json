{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2180",
  "title": "Signal: Lockfile integrity recorded with SHA-1",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.integrity",
      "valuePattern": "^sha1-"
    }
  },
  "scope": "A package-lock.json file that declares a lockfile whose integrity value is a SHA-1 digest.",
  "limitations": "It matches a lockfile whose integrity value is a SHA-1 digest in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "integrity": "sha1-AAAABBBBCCCCDDDDEEEEFFFF"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "3.1.0",
            "integrity": "sha1-QQQQWWWWEEEERRRRTTTTYYYY"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org/x/-/x-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "3.1.0",
            "integrity": "sha512-ZZZZXXXXCCCCVVVV"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A package that genuinely publishes only sha1 is still reported; the digest strength is the finding.",
  "linkedRules": [
    "DPK-SCA-0043"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-integrity-sha1",
  "validationStatus": "VALIDATED"
}
