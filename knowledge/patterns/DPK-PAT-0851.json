{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0851",
  "title": "Signal: Unescaped output (echo) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "echo\\s+\\$"
  },
  "scope": "Single-line lexical match on unescaped output (echo).",
  "limitations": "Lexical, line-based: matches the output regardless of value trust.",
  "examples": [
    {
      "line": "echo $q",
      "match": true
    },
    {
      "line": "# audit: echo $q present",
      "match": true
    },
    {
      "line": "echo e($q)",
      "match": false
    },
    {
      "line": "# verified: echo e($q)",
      "match": false
    }
  ],
  "fpNotes": "Trusted constants are the common false positive.",
  "linkedRules": [
    "DPK-SAST-734"
  ],
  "origin": "original-authored",
  "cell": "sast:xss-flag-3:php:echo",
  "validationStatus": "VALIDATED"
}
