{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0790",
  "title": "Signal: ActiveRecord SQL from input (render) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:render\\s+inline:)"
  },
  "scope": "Single-line lexical match on assembled SQL (render).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "render inline: t",
      "match": true
    },
    {
      "line": "# audit: render inline: t present",
      "match": true
    },
    {
      "line": "render :show",
      "match": false
    },
    {
      "line": "# verified: render :show",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-673"
  ],
  "origin": "original-authored",
  "cell": "sast:ruby-flag:ruby:render",
  "validationStatus": "VALIDATED"
}
