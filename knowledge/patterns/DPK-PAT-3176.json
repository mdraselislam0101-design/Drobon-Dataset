{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3176",
  "title": "Signal: Possible a Dropbox access token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "sl.[A-Za-z0-9_-]{100,}"
  },
  "scope": "Single-line shape match for a Dropbox access token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"sl.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"sl.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-116"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-4:dropbox-access-token",
  "validationStatus": "VALIDATED"
}
