{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2174",
  "title": "Signal: Dependency declared as a direct registry URL",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^https://[a-z0-9.-]{3,60}/@"
    }
  },
  "scope": "A package.json file that declares a dependency written as a registry URL rather than a version.",
  "limitations": "It matches a dependency written as a registry URL rather than a version in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "https://npm.acme.example/@acme/sdk"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "https://artifacts.acme.example/@acme/cli"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "https://registry.npmjs.org/acme-sdk"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "@acme/sdk": "4.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A tarball URL is reported by the tarball rule; this rule covers registry-style paths.",
  "linkedRules": [
    "DPK-SCA-0037"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-scoped-registry-url",
  "validationStatus": "VALIDATED"
}
