{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1250",
  "title": "Signal: SonarQube interface disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*sonarqube)(?=[\\s\\S]*SonarQube)"
    }
  },
  "scope": "One response whose body contains both the sonarqube bundle and the product name.",
  "limitations": "One response body. The rule reports the SonarQube shell; it does not read a project or an analysis result.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>SonarQube</title></head><body><script src=\"/js/sonarqube.js\"></script><div id=\"sonarqube-app\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><script>window.sonarqube = {\"version\":\"10.3.0\"};</script><span>SonarQube</span></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><script src=\"/js/.js\"></script><div id=\"-app\"></div></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published instance is still reported; the finding is reachability.",
  "linkedRules": [
    "DPK-DAST-181"
  ],
  "origin": "original-authored",
  "cell": "dast:body-sonarqube:sonarqube",
  "validationStatus": "VALIDATED"
}
