{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0321",
  "title": "Signal: SQL built by concatenation (java) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:executeQuery\\s*\\((?:[^()]|\\([^()]*\\))*\\+)"
  },
  "scope": "Single-line lexical match on concatenated SQL in java code.",
  "limitations": "Lexical, line-based: any concatenated query matches, including trusted assembly. Input trust needs human review.",
  "examples": [
    {
      "line": "stmt.executeQuery(\"SELECT \" + id)",
      "match": true
    },
    {
      "line": "# audit: stmt.executeQuery(\"SELECT \" + id) present",
      "match": true
    },
    {
      "line": "stmt.executeQuery(FIXED)",
      "match": false
    },
    {
      "line": "# verified: stmt.executeQuery(FIXED)",
      "match": false
    },
    {
      "line": "stmt.executeQuery(buildSql(name) + \" -- x\");",
      "match": true
    },
    {
      "line": "stmt.executeQuery(FIXED);",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed column lists or trusted fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-282"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-concat:java",
  "validationStatus": "VALIDATED"
}
