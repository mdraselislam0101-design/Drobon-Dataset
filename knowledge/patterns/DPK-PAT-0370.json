{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0370",
  "title": "Signal: Risky Terraform setting (kmsrot) — review required",
  "targets": [
    "hcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "enable_key_rotation\\s*=\\s*false"
  },
  "scope": "Single-line lexical match on risky Terraform settings (kmsrot).",
  "limitations": "Lexical, line-based: matches the setting regardless of account scope.",
  "examples": [
    {
      "line": "enable_key_rotation = false",
      "match": true
    },
    {
      "line": "# audit: enable_key_rotation = false present",
      "match": true
    },
    {
      "line": "enable_key_rotation = true",
      "match": false
    },
    {
      "line": "# verified: enable_key_rotation = true",
      "match": false
    }
  ],
  "fpNotes": "Sandbox accounts are the common false positive — confirm account scope.",
  "linkedRules": [
    "DPK-SAST-331"
  ],
  "origin": "original-authored",
  "cell": "sast:terraform-strict:hcl:kmsrot",
  "validationStatus": "VALIDATED"
}
