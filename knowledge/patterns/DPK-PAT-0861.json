{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0861",
  "title": "Signal: Possible a Discord bot token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "M[A-Za-z0-9_-]{23,}\\.[A-Za-z0-9_-]{6,}\\.[A-Za-z0-9_-]{27,}"
  },
  "scope": "Single-line shape match for a Discord bot token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"MAAAAAAAAAAAAAAAAAAAAAAA.AAAAAA.AAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"MAAAAAAAAAAAAAAAAAAAAAAA.AAAAAA.AAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-073"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-2:discord-bot",
  "validationStatus": "VALIDATED"
}
