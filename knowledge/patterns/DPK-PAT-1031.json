{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1031",
  "title": "Signal: Object injection via Marshal.load in ruby — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bMarshal\\.(?:load|restore)\\b"
  },
  "scope": "Single-line match on Marshal.load in ruby.",
  "limitations": "Lexical call match; reachable gadget classes depend on the loaded application.",
  "examples": [
    {
      "line": "data = Marshal.load(params[:state])",
      "match": true
    },
    {
      "line": "# audit: data = Marshal.load(params[:state]) present",
      "match": true
    },
    {
      "line": "data = JSON.parse(params[:state])",
      "match": false
    },
    {
      "line": "# verified: data = JSON.parse(params[:state])",
      "match": false
    }
  ],
  "fpNotes": "Cache entries produced and consumed inside one trusted process are the accepted false positives.",
  "linkedRules": [
    "DPK-SAST-850"
  ],
  "origin": "original-authored",
  "cell": "sast:ruby-marshal-load:ruby",
  "validationStatus": "VALIDATED"
}
