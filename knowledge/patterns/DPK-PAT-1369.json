{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1369",
  "title": "Signal: Location header carries an encoded line break",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Location",
      "valuePattern": "(?:%0[dD]|%0[aA])"
    }
  },
  "scope": "One Location header whose value contains %0d, %0a or both.",
  "limitations": "One Location header value. The check proves an encoded line break reached the header; it does not prove the client or an intermediary decodes it, and no header split is attempted.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/login?next=%2Fhome%0d%0aSet-Cookie:%20a=b",
        "status": 302,
        "headers": {
          "Location": "/home%0d%0aSet-Cookie:%20a=b"
        },
        "body": ""
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login?next=%2Fhome%0a",
        "status": 302,
        "headers": {
          "Location": "/home%0aX-Injected: 1"
        },
        "body": ""
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login?next=%2Fhome",
        "status": 302,
        "headers": {
          "Location": "/home"
        },
        "body": ""
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/login?next=%2Fa%20b",
        "status": 302,
        "headers": {
          "Location": "/a%20b"
        },
        "body": ""
      },
      "match": false
    }
  ],
  "fpNotes": "A legitimate Location that carries %0d or %0a as part of a signed payload is reported; a redirect to a clean path is not.",
  "linkedRules": [
    "DPK-DAST-300"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-header-location-encoded-crlf:location-crlf",
  "validationStatus": "VALIDATED"
}
