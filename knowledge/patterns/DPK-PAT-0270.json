{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0270",
  "title": "Signal: Rails force_ssl disabled (ruby) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:force_ssl\\s*=\\s*false)"
  },
  "scope": "Single-line lexical match on the Rails setting.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "config.force_ssl = false",
      "match": true
    },
    {
      "line": "# audit: config.force_ssl = false present",
      "match": true
    },
    {
      "line": "config.force_ssl = true",
      "match": false
    },
    {
      "line": "# verified: config.force_ssl = true",
      "match": false
    }
  ],
  "fpNotes": "Terminated-TLS frontends are the common accepted case — confirm headers.",
  "linkedRules": [
    "DPK-SAST-231"
  ],
  "origin": "original-authored",
  "cell": "sast:rails-ssl:ruby:forcessl",
  "validationStatus": "VALIDATED"
}
