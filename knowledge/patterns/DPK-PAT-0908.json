{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0908",
  "title": "Signal: HTTP subresource on an HTTPS page",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<(?:script|img|link|iframe|audio|video|source)\\b[^>]*\\s(?:src|href)\\s*=\\s*[\"']http://",
      "requireScheme": "https"
    }
  },
  "scope": "Single HTTPS response body: confirm no cleartext subresource reference.",
  "limitations": "Body text check on one response: it matches common markup tags only, not CSS url() or script-built URLs, and it does not prove the browser fetched the resource.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "content-type": "text/html"
        },
        "body": "<script src=\"http://cdn.example/app.js\"></script>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "content-type": "text/html"
        },
        "body": "<script src=\"https://cdn.example/app.js\"></script>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "content-type": "text/html"
        },
        "body": "<script src=\"http://cdn.example/app.js\"></script>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "content-type": "text/html"
        },
        "body": "<html xmlns=\"http://www.w3.org/1999/xhtml\"></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "Markup inside comments or documentation text can match the same tag shape.",
  "linkedRules": [
    "DPK-DAST-055"
  ],
  "origin": "original-authored",
  "cell": "dast:mixed-content:http-subresource",
  "validationStatus": "VALIDATED"
}
