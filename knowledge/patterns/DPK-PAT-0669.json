{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0669",
  "title": "Signal: TLS trust weakened (changeit) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:load\\s*\\([^)]*\"changeit\")"
  },
  "scope": "Single-line lexical match on TLS trust code (changeit).",
  "limitations": "Lexical, line-based: matches the weakness.",
  "examples": [
    {
      "line": "ks.load(in, \"changeit\".toCharArray())",
      "match": true
    },
    {
      "line": "# audit: ks.load(in, \"changeit\".toCharArray()) present",
      "match": true
    },
    {
      "line": "ks.load(in, pw)",
      "match": false
    },
    {
      "line": "# verified: ks.load(in, pw)",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive.",
  "linkedRules": [
    "DPK-SAST-552"
  ],
  "origin": "original-authored",
  "cell": "sast:java-tls-more:java:changeit",
  "validationStatus": "VALIDATED"
}
