{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1253",
  "title": "Signal: Zabbix interface disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*zabbix)(?=[\\s\\S]*Zabbix)"
    }
  },
  "scope": "One response whose body contains both the zabbix bundle and the product name.",
  "limitations": "One response body. The rule reports the Zabbix shell; it does not read a host or a trigger.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Zabbix</title></head><body><script src=\"/js/zabbix.js\"></script><span>Zabbix SIA</span></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div id=\"zabbix-app\"></div><footer>Zabbix</footer></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><script src=\"/js/.js\"></script><span> SIA</span></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published instance is still reported; the finding is reachability.",
  "linkedRules": [
    "DPK-DAST-184"
  ],
  "origin": "original-authored",
  "cell": "dast:body-zabbix-ui:zabbix-ui",
  "validationStatus": "VALIDATED"
}
