{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3217",
  "title": "Signal: Possible a LangSmith service key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "lsv2_sk_[A-Za-z0-9]{32,}"
  },
  "scope": "Single-line shape match for a LangSmith service key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"lsv2_sk_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: key = \"lsv2_sk_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-157"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-5:langsmith-service-key",
  "validationStatus": "VALIDATED"
}
