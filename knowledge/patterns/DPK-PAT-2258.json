{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2258",
  "title": "Signal: Python index configured over cleartext",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "options.index_url",
      "valuePattern": "^http://"
    }
  },
  "scope": "A requirements.txt file that declares an index URL that uses cleartext http.",
  "limitations": "It matches an index URL that uses cleartext http in the parsed requirements.txt; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [],
        "options": {
          "index_url": "http://pypi.acme.example/simple"
        }
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "requests",
            "specifier": "==2.32.3"
          }
        ],
        "options": {
          "index_url": "http://10.24.8.9:8081/simple"
        }
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [],
        "options": {
          "index_url": "https://pypi.org/simple"
        }
      },
      "match": false
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "requests",
            "specifier": "==2.32.3"
          }
        ],
        "options": {
          "index_url": "https://pypi.acme.example/simple"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A requirements.txt that mentions an index URL that uses cleartext http in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0121"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-index-url-cleartext",
  "validationStatus": "VALIDATED"
}
