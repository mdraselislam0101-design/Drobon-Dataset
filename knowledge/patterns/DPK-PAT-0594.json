{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0594",
  "title": "Signal: Privileged Compose service (pid) — review required",
  "targets": [
    "compose"
  ],
  "signal": {
    "kind": "regex",
    "source": "pid\\s*:\\s*[\"']?host"
  },
  "scope": "Single-line lexical match on Compose files.",
  "limitations": "Lexical, line-based: matches the grant.",
  "examples": [
    {
      "line": "pid: host",
      "match": true
    },
    {
      "line": "# audit: pid: host present",
      "match": true
    },
    {
      "line": "pid: service:x",
      "match": false
    },
    {
      "line": "# verified: pid: service:x",
      "match": false
    }
  ],
  "fpNotes": "Node agents are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-477"
  ],
  "origin": "original-authored",
  "cell": "sast:compose-risk:compose:pid",
  "validationStatus": "VALIDATED"
}
