{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1008",
  "title": "Signal: Outbound request to a computed URL in javascript — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:(?:fetch|axios\\.(?:get|post|put|delete|patch|request)|got\\.(?:get|post|put|delete))\\(\\s*(?:`[^`\\n]*\\$\\{|[A-Za-z_$][\\w$]*\\s*\\+|(?:req|request)\\.(?:query|body|params)))"
  },
  "scope": "Single-line match on an HTTP client call whose URL argument is computed in javascript.",
  "limitations": "Lexical match on common client call shapes; taint, redirects, and DNS rebinding are out of scope.",
  "examples": [
    {
      "line": "fetch(`https://api.example.com/users/${userId}`)",
      "match": true
    },
    {
      "line": "# audit: fetch(`https://api.example.com/users/${userId}`) present",
      "match": true
    },
    {
      "line": "fetch(\"https://api.example.com/v1/users\")",
      "match": false
    },
    {
      "line": "# verified: fetch(\"https://api.example.com/v1/users\")",
      "match": false
    }
  ],
  "fpNotes": "Requests to a fixed host that interpolate only a validated identifier are the accepted false positives.",
  "linkedRules": [
    "DPK-SAST-830"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-computed-js:javascript",
  "validationStatus": "VALIDATED"
}
