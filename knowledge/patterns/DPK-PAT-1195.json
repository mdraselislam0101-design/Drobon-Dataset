{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1195",
  "title": "Signal: Apache mod_status page disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Apache Server Status for)"
    }
  },
  "scope": "One response whose body contains the Apache server status heading.",
  "limitations": "One body marker. The heading is specific to mod_status; a page that links to server-status is not matched.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/server-status",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Apache Server Status for app.example</title></head></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/server-status?auto",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "Total Accesses: 41\n# Apache Server Status for app.example (via 10.0.0.4)"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/docs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Enable mod_status and visit /server-status for load details.</p>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>Home</body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "An operations runbook that quotes the heading is reported only if the response reproduces it as page content.",
  "linkedRules": [
    "DPK-DAST-126"
  ],
  "origin": "original-authored",
  "cell": "dast:body-apache-server-status:body-apache-server-status",
  "validationStatus": "VALIDATED"
}
