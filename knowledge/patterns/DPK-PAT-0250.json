{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0250",
  "title": "Signal: File access built from input (lua) — review required",
  "targets": [
    "lua"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:io\\.open\\s*\\([^)]*\\.\\.)"
  },
  "scope": "Single-line lexical match on input-built paths in lua code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "io.open(dir .. f)",
      "match": true
    },
    {
      "line": "# audit: io.open(dir .. f) present",
      "match": true
    },
    {
      "line": "io.open(fixed)",
      "match": false
    },
    {
      "line": "# verified: io.open(fixed)",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-211"
  ],
  "origin": "original-authored",
  "cell": "sast:path-langs:lua",
  "validationStatus": "VALIDATED"
}
