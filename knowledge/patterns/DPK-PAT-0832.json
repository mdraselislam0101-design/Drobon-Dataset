{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0832",
  "title": "Signal: Weak Terraform setting (masterpw) — review required",
  "targets": [
    "terraform"
  ],
  "signal": {
    "kind": "regex",
    "source": "master_password\\s*=\\s*\"[^\"]+\""
  },
  "scope": "Single-line lexical match on Terraform files.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "master_password = \"x\"",
      "match": true
    },
    {
      "line": "# audit: master_password = \"x\" present",
      "match": true
    },
    {
      "line": "master_password = var.pw",
      "match": false
    },
    {
      "line": "# verified: master_password = var.pw",
      "match": false
    }
  ],
  "fpNotes": "Ephemeral environments are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-715"
  ],
  "origin": "original-authored",
  "cell": "sast:tf-more:hcl:masterpw",
  "validationStatus": "VALIDATED"
}
