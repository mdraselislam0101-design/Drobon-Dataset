{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2158",
  "title": "Signal: Git dependency pinned to a short commit fragment",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "#[0-9a-fA-F]{7,40}$"
    }
  },
  "scope": "A package.json file that declares a git dependency pinned to a commit fragment rather than a registry version.",
  "limitations": "It matches a git dependency pinned to a commit fragment rather than a registry version in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "github:acme/sdk#9f2c4a1"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "git+https://github.com/acme/cli.git#0a1b2c3d4e5f60718293a4b5c6d7e8f901234567"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "github:acme/sdk#main"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A fragment naming a branch or tag is reported by the branch rule, not this one.",
  "linkedRules": [
    "DPK-SCA-0021"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-commit-sha-fragment",
  "validationStatus": "VALIDATED"
}
