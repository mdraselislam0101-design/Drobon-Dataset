{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0665",
  "title": "Signal: Script evaluation (groovyshell) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:new GroovyShell\\s*\\(\\s*\\)\\s*\\.evaluate\\s*\\()"
  },
  "scope": "Single-line lexical match on script evaluation (groovyshell).",
  "limitations": "Lexical, line-based: matches the evaluation.",
  "examples": [
    {
      "line": "new GroovyShell().evaluate(expr)",
      "match": true
    },
    {
      "line": "# audit: new GroovyShell().evaluate(expr) present",
      "match": true
    },
    {
      "line": "new GroovyShell(binding)",
      "match": false
    },
    {
      "line": "# verified: new GroovyShell(binding)",
      "match": false
    }
  ],
  "fpNotes": "Fixed scripts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-548"
  ],
  "origin": "original-authored",
  "cell": "sast:java-inject-flag:java:groovyshell",
  "validationStatus": "VALIDATED"
}
