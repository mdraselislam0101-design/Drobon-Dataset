{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0966",
  "title": "Signal: Source map reference in a served script",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "//# sourceMappingURL="
    }
  },
  "scope": "Single script body: confirm no sourceMappingURL comment is returned.",
  "limitations": "Marker on one body: it only applies to script bodies the scanner captured. It does not prove the map is reachable.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "content-type": "application/javascript"
        },
        "body": "console.log(1);\n//# sourceMappingURL=app.js.map"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "content-type": "application/javascript"
        },
        "body": "console.log(1);"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/app.js",
        "status": 200,
        "headers": {},
        "body": "//# sourceMappingURL=app.js.map"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/app.js",
        "status": 200,
        "headers": {},
        "body": "// sourceMappingURL=app.js.map"
      },
      "match": false
    }
  ],
  "fpNotes": "Internal builds that publish maps behind access control are the accepted case.",
  "linkedRules": [
    "DPK-DAST-069"
  ],
  "origin": "original-authored",
  "cell": "dast:sourcemap-reference:source-map",
  "validationStatus": "VALIDATED"
}
