{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2148",
  "title": "Signal: Dependency declared with the Bitbucket shorthand",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^bitbucket:"
    }
  },
  "scope": "A package.json file that declares the `bitbucket:` dependency shorthand.",
  "limitations": "It matches the `bitbucket:` dependency shorthand in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "bitbucket:acme/sdk"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-ui": "bitbucket:acme/ui#stable"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "3.1.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "github:acme/sdk"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A sibling shorthand for a different forge is not reported by this rule.",
  "linkedRules": [
    "DPK-SCA-0011"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-bitbucket-shorthand",
  "validationStatus": "VALIDATED"
}
