{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1551",
  "title": "Signal: Bulk phone number list served in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "[0-9]{3}[ -][0-9]{3}[ -][0-9]{4}(?:[,;\\s]{1,6}[0-9]{3}[ -][0-9]{3}[ -][0-9]{4}){2,}"
    }
  },
  "scope": "A response body with a run of at least five phone numbers.",
  "limitations": "One response body. The rule counts numbers written in the three-three-four form with a separating character.",
  "examples": [
    {
      "observation": {
        "url": "https://crm.example/accounts/7/contacts",
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "{\"account\":7,\"phones\":\"212-555-0143, 212-555-0177, 212-555-0198, 212-555-0110, 212-555-0166\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://crm.example/dispatch/9",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "phone list\n415-555-0132\n415-555-0144\n415-555-0159\n415-555-0163\n415-555-0171"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://crm.example/contact",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "<html><body><h1>Contact us</h1><p>Call 212-555-0143 between 9 and 5.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page with one contact number is not reported, because the rule requires a repeated run.",
  "linkedRules": [
    "DPK-DAST-482"
  ],
  "origin": "original-authored",
  "cell": "dast:pii-bulk-phone-list:pii-bulk-phone-list",
  "validationStatus": "VALIDATED"
}
