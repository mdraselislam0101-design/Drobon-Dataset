{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0161",
  "title": "Signal: Framework SQL built from input (gorm) — review required",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.Where\\s*\\([^)]*\\+"
  },
  "scope": "Single-line lexical match on assembled framework SQL (gorm).",
  "limitations": "Lexical, line-based: any assembled query matches, including trusted ones.",
  "examples": [
    {
      "line": "db.Where(\"a = \" + b)",
      "match": true
    },
    {
      "line": "# audit: db.Where(\"a = \" + b) present",
      "match": true
    },
    {
      "line": "db.Where(\"a = ?\", b)",
      "match": false
    },
    {
      "line": "# verified: db.Where(\"a = ?\", b)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-122"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli:go:gorm",
  "validationStatus": "VALIDATED"
}
