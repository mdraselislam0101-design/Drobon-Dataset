{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0822",
  "title": "Signal: Server-side fetch of assembled URL (erlang) — review required",
  "targets": [
    "erlang"
  ],
  "signal": {
    "kind": "regex",
    "source": "httpc:request\\s*\\([^)]*\\+\\+"
  },
  "scope": "Single-line lexical match on assembled fetch URLs in erlang code.",
  "limitations": "Lexical, line-based: any assembled fetch URL matches.",
  "examples": [
    {
      "line": "httpc:request(base ++ p)",
      "match": true
    },
    {
      "line": "# audit: httpc:request(base ++ p) present",
      "match": true
    },
    {
      "line": "httpc:request(fixed)",
      "match": false
    },
    {
      "line": "# verified: httpc:request(fixed)",
      "match": false
    }
  ],
  "fpNotes": "Fixed hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-705"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-4:erlang",
  "validationStatus": "VALIDATED"
}
