{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1371",
  "title": "Signal: Classic ASP.NET error page disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "Server Error in '/' Application"
    }
  },
  "scope": "One response body containing the classic ASP.NET error heading.",
  "limitations": "One response body. The check reads the page heading; it does not decide whether the stack below it names internal paths.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/orders",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<h1>Server Error in '/' Application.</h1><h2>Runtime Error</h2>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/orders",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<title>Server Error in '/' Application.</title><p>Description: An unhandled exception occurred.</p>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/orders",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Something went wrong</h1><p>Reference 1a2b3c</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/orders",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "An unhandled exception occurred while processing the request. Microsoft.AspNetCore.Diagnostics.DeveloperExceptionPageMiddleware"
      },
      "match": false
    }
  ],
  "fpNotes": "A documentation page that quotes the heading is reported; an ASP.NET Core developer page is handled by DPK-DAST-127 instead and does not contain this heading.",
  "linkedRules": [
    "DPK-DAST-302"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-aspnet-classic-error:aspnet-classic-error",
  "validationStatus": "VALIDATED"
}
