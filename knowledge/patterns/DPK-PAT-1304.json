{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1304",
  "title": "Signal: nginx stub_status page disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Active\\ connections:)(?=[\\s\\S]*server\\ accepts\\ handled\\ requests)"
    }
  },
  "scope": "One response whose body renders the nginx stub_status template.",
  "limitations": "One response body. The rule reports the stub_status template; it cannot identify the proxied services or their configuration.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "Active connections: 291\nserver accepts handled requests\n 16630948 16630948 31070465\nReading: 6 Writing: 179 Waiting: 106"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "Active connections: 12\nserver accepts handled requests\n 8432 8432 12011\nReading: 0 Writing: 1 Waiting: 11"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": " 291\n\n 16630948 16630948 31070465\nReading: 6 Writing: 179 Waiting: 106"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "An nginx default page is not reported; the status template is required.",
  "linkedRules": [
    "DPK-DAST-235"
  ],
  "origin": "original-authored",
  "cell": "dast:body-nginx-stub-status:nginx-stub-status",
  "validationStatus": "VALIDATED"
}
