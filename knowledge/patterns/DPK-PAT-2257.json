{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2257",
  "title": "Signal: Python requirement verified with a SHA-1 hash",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "requirements[].hashes[]",
      "valuePattern": "^sha1:"
    }
  },
  "scope": "A requirements.txt file that declares a `--hash` value that uses SHA-1.",
  "limitations": "It matches a `--hash` value that uses SHA-1 in the parsed requirements.txt; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "requests",
            "specifier": "==2.32.3",
            "hashes": [
              "sha1:aaaabbbbccccddddeeeeffff"
            ]
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "flask",
            "specifier": "==3.0.3",
            "hashes": [
              "sha1:111122223333444455556666"
            ]
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "requests",
            "specifier": "==2.32.3",
            "hashes": [
              "sha256:aaaa"
            ]
          }
        ]
      },
      "match": false
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "flask",
            "specifier": "==3.0.3",
            "hashes": [
              "sha256:bbbb"
            ]
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A requirements.txt that mentions a `--hash` value that uses SHA-1 in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0120"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-requirement-hash-sha1",
  "validationStatus": "VALIDATED"
}
