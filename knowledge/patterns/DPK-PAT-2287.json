{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2287",
  "title": "Signal: Go dependency on a pre-1.0 module",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "require[].version",
      "valuePattern": "^v0\\."
    }
  },
  "scope": "A go.mod file that declares a `v0.x` module version, which carries no compatibility promise.",
  "limitations": "It matches a `v0.x` module version, which carries no compatibility promise in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/experimental",
            "version": "v0.4.2"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/alpha",
            "version": "v0.9.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v1.4.2"
          }
        ]
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.0.0"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A go.mod that mentions a `v0.x` module version, which carries no compatibility promise in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0150"
  ],
  "origin": "original-authored",
  "cell": "sca:go-require-unstable-major-zero",
  "validationStatus": "VALIDATED"
}
