{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0738",
  "title": "Signal: Weak PHP crypto or diagnostics (cost) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "[\"']cost[\"']\\s*=>\\s*[4-9]\\b"
  },
  "scope": "Single-line lexical match on PHP settings (cost).",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "'cost' => 4",
      "match": true
    },
    {
      "line": "# audit: 'cost' => 4 present",
      "match": true
    },
    {
      "line": "'cost' => 12",
      "match": false
    },
    {
      "line": "# verified: 'cost' => 12",
      "match": false
    }
  ],
  "fpNotes": "Legacy interop is the common false positive.",
  "linkedRules": [
    "DPK-SAST-621"
  ],
  "origin": "original-authored",
  "cell": "sast:php-misc:php:cost",
  "validationStatus": "VALIDATED"
}
