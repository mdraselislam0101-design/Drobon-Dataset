{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0750",
  "title": "Signal: Weak proxy or service setting (default) — review required",
  "targets": [
    "minio"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:MINIO_ROOT_PASSWORD\\s*=\\s*minioadmin)"
  },
  "scope": "Single-line lexical match on service settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "MINIO_ROOT_PASSWORD=minioadmin",
      "match": true
    },
    {
      "line": "# audit: MINIO_ROOT_PASSWORD=minioadmin present",
      "match": true
    },
    {
      "line": "MINIO_ROOT_PASSWORD=${MANAGED}",
      "match": false
    },
    {
      "line": "# verified: MINIO_ROOT_PASSWORD=${MANAGED}",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-633"
  ],
  "origin": "original-authored",
  "cell": "sast:proxy-misc:minio:default",
  "validationStatus": "VALIDATED"
}
