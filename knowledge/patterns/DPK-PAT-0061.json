{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0061",
  "title": "Signal: Server version disclosed (X-Powered-By header)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-Powered-By",
      "valuePattern": "[^ ]"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Banner check: version visibility alone is not exploitability.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Powered-By": "PHP/8.2.1"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Powered-By": "Express"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Honeypot banners are the rare false positive.",
  "linkedRules": [
    "DPK-DAST-031"
  ],
  "origin": "original-authored",
  "cell": "dast:server-version:xpoweredby",
  "validationStatus": "VALIDATED"
}
