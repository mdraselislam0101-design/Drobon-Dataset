{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0296",
  "title": "Signal: plain left open (dovecot) — review required",
  "targets": [
    "dovecot"
  ],
  "signal": {
    "kind": "regex",
    "source": "disable_plaintext_auth\\s*=\\s*no"
  },
  "scope": "Single-line lexical match on open settings for plain.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "disable_plaintext_auth = no",
      "match": true
    },
    {
      "line": "# audit: disable_plaintext_auth = no present",
      "match": true
    },
    {
      "line": "disable_plaintext_auth = yes",
      "match": false
    },
    {
      "line": "# verified: disable_plaintext_auth = yes",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-257"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:dovecot:plain",
  "validationStatus": "VALIDATED"
}
