{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1119",
  "title": "Signal: Script loaded over plaintext HTTP in html — review required",
  "targets": [
    "html"
  ],
  "signal": {
    "kind": "regex",
    "source": "<script[^>]*\\bsrc\\s*=\\s*[\"']http://"
  },
  "scope": "Single-line match on an http script source in html.",
  "limitations": "Lexical: matches a literal http script source; script tags injected by JavaScript are out of scope.",
  "examples": [
    {
      "line": "<script src=\"http://cdn.example/lib.js\"></script>",
      "match": true
    },
    {
      "line": "# audit: <script src=\"http://cdn.example/lib.js\"></script> present",
      "match": true
    },
    {
      "line": "<script src=\"https://cdn.example/lib.js\" integrity=\"sha384-abc\"></script>",
      "match": false
    },
    {
      "line": "# verified: <script src=\"https://cdn.example/lib.js\" integrity=\"sha384-abc\"></script>",
      "match": false
    }
  ],
  "fpNotes": "A local development page loading from localhost is the accepted exception.",
  "linkedRules": [
    "DPK-SAST-934"
  ],
  "origin": "original-authored",
  "cell": "sast:html-script-mixed-content:html",
  "validationStatus": "VALIDATED"
}
