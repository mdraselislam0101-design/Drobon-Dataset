{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1128",
  "title": "Signal: XML document declares an external DTD in xml — review required",
  "targets": [
    "xml"
  ],
  "signal": {
    "kind": "regex",
    "source": "<!DOCTYPE[^>\\n]*SYSTEM\\s+[\"']https?://"
  },
  "scope": "Single-line match on a remote external DTD in xml.",
  "limitations": "Lexical: matches a literal http SYSTEM identifier; a file:// or relative SYSTEM id is out of scope.",
  "examples": [
    {
      "line": "<!DOCTYPE note SYSTEM \"http://example.internal/note.dtd\">",
      "match": true
    },
    {
      "line": "# audit: <!DOCTYPE note SYSTEM \"http://example.internal/note.dtd\"> present",
      "match": true
    },
    {
      "line": "<!DOCTYPE note SYSTEM \"note.dtd\">",
      "match": false
    },
    {
      "line": "# verified: <!DOCTYPE note SYSTEM \"note.dtd\">",
      "match": false
    }
  ],
  "fpNotes": "A test fixture that documents the XXE shape is the accepted false positive.",
  "linkedRules": [
    "DPK-SAST-943"
  ],
  "origin": "original-authored",
  "cell": "sast:xml-doctype-external:xml",
  "validationStatus": "VALIDATED"
}
