{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2912",
  "title": "Signal: R package whose project URL is cleartext",
  "targets": [
    "cran"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "URL[]",
      "valuePattern": "^http://"
    }
  },
  "scope": "A DESCRIPTION file that declares a `URL` field over cleartext.",
  "limitations": "It matches a `URL` field over cleartext in the parsed DESCRIPTION; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT",
        "URL": [
          "http://acme.example/demo"
        ]
      },
      "match": true
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT",
        "URL": [
          "http://10.24.8.9/demo"
        ]
      },
      "match": true
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT",
        "URL": [
          "https://acme.example/demo"
        ]
      },
      "match": false
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT",
        "URL": [
          "https://github.com/acme/demo"
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A DESCRIPTION that mentions a `URL` field over cleartext in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0775"
  ],
  "origin": "original-authored",
  "cell": "sca:cran-url-cleartext",
  "validationStatus": "VALIDATED"
}
