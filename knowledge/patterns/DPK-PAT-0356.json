{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0356",
  "title": "Signal: Weak service hardening (notmp) — review required",
  "targets": [
    "systemd"
  ],
  "signal": {
    "kind": "regex",
    "source": "PrivateTmp\\s*=\\s*no"
  },
  "scope": "Single-line lexical match on weak settings (notmp).",
  "limitations": "Lexical, line-based: matches the setting regardless of host trust.",
  "examples": [
    {
      "line": "PrivateTmp=no",
      "match": true
    },
    {
      "line": "# audit: PrivateTmp=no present",
      "match": true
    },
    {
      "line": "PrivateTmp=yes",
      "match": false
    },
    {
      "line": "# verified: PrivateTmp=yes",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-317"
  ],
  "origin": "original-authored",
  "cell": "sast:sys-services:systemd:notmp",
  "validationStatus": "VALIDATED"
}
