{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0699",
  "title": "Signal: Permissive Kubernetes pod (readonly) — review required",
  "targets": [
    "k8s"
  ],
  "signal": {
    "kind": "regex",
    "source": "readOnlyRootFilesystem\\s*:\\s*false"
  },
  "scope": "Single-line lexical match on Kubernetes manifests.",
  "limitations": "Lexical, line-based: matches the grant.",
  "examples": [
    {
      "line": "readOnlyRootFilesystem: false",
      "match": true
    },
    {
      "line": "# audit: readOnlyRootFilesystem: false present",
      "match": true
    },
    {
      "line": "readOnlyRootFilesystem: true",
      "match": false
    },
    {
      "line": "# verified: readOnlyRootFilesystem: true",
      "match": false
    }
  ],
  "fpNotes": "Node agents are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-582"
  ],
  "origin": "original-authored",
  "cell": "sast:k8s-more:k8s:readonly",
  "validationStatus": "VALIDATED"
}
