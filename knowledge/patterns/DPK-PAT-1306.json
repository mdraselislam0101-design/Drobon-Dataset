{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1306",
  "title": "Signal: npm authentication token file served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*_authToken)(?=[\\s\\S]*registry)"
    }
  },
  "scope": "One response whose body contains an _authToken assignment beside a registry setting.",
  "limitations": "One response body. The rule reports the token line and registry setting; it does not use the token and cannot determine its publish scope.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "registry=https://registry.npmjs.org/\n//registry.npmjs.org/:_authToken=npm_AbCdEfGhIjKlMnOpQrStUvWxYz0123456789\nsave-exact=true"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "//npm.pkg.github.com/:_authToken=redacted-for-fixture\nregistry=https://npm.pkg.github.com/\nlegacy-peer-deps=true"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "=https://.npmjs.org/\n//.npmjs.org/:=npm_AbCdEfGhIjKlMnOpQrStUvWxYz0123456789\nsave-exact=true"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A .npmrc that only sets registry and save-exact is not reported; the token assignment is required.",
  "linkedRules": [
    "DPK-DAST-237"
  ],
  "origin": "original-authored",
  "cell": "dast:body-npmrc-token:npmrc-token",
  "validationStatus": "VALIDATED"
}
