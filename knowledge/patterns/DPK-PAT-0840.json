{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0840",
  "title": "Signal: Umask cleared to zero (c) — review required",
  "targets": [
    "c"
  ],
  "signal": {
    "kind": "regex",
    "source": "umask\\s*\\(\\s*0\\s*\\)"
  },
  "scope": "Single-line lexical match on umask clearing in c code.",
  "limitations": "Lexical, line-based: matches the clearing.",
  "examples": [
    {
      "line": "umask(0)",
      "match": true
    },
    {
      "line": "# audit: umask(0) present",
      "match": true
    },
    {
      "line": "umask(022)",
      "match": false
    },
    {
      "line": "# verified: umask(022)",
      "match": false
    }
  ],
  "fpNotes": "Brief scoped clearing is the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-723"
  ],
  "origin": "original-authored",
  "cell": "sast:umask-zero:c",
  "validationStatus": "VALIDATED"
}
