{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0307",
  "title": "Signal: cipher left open — review required",
  "targets": [
    "openvpn"
  ],
  "signal": {
    "kind": "regex",
    "source": "cipher\\s+none"
  },
  "scope": "Single-line lexical match on open settings for cipher.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "cipher none",
      "match": true
    },
    {
      "line": "# audit: cipher none present",
      "match": true
    },
    {
      "line": "cipher AES-256-GCM",
      "match": false
    },
    {
      "line": "# verified: cipher AES-256-GCM",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-268"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:openvpn:cipher",
  "validationStatus": "VALIDATED"
}
