{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1110",
  "title": "Signal: URLSession request target uses plaintext HTTP in swift — review required",
  "targets": [
    "swift"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:URL\\s*\\(\\s*string\\s*:\\s*[\"']http://)"
  },
  "scope": "Single-line match on an http URL request in swift.",
  "limitations": "Lexical: matches a literal http URL in a URLSession request; a scheme held in configuration is out of scope.",
  "examples": [
    {
      "line": "let url = URL(string: \"http://api.example.com/v1/items\")!",
      "match": true
    },
    {
      "line": "# audit: let url = URL(string: \"http://api.example.com/v1/items\")! present",
      "match": true
    },
    {
      "line": "let url = URL(string: \"https://api.example.com/v1/items\")!",
      "match": false
    },
    {
      "line": "# verified: let url = URL(string: \"https://api.example.com/v1/items\")!",
      "match": false
    }
  ],
  "fpNotes": "A localhost development endpoint is the accepted exception.",
  "linkedRules": [
    "DPK-SAST-927"
  ],
  "origin": "original-authored",
  "cell": "sast:swift-urlsession-http:swift",
  "validationStatus": "VALIDATED"
}
