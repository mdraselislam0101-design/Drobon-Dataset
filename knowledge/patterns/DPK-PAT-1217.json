{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1217",
  "title": "Signal: Content-Security-Policy media-src allows a wildcard source",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "(?:^|;)\\s*media-src\\s[^;]*(?<=\\s)(?:\\*|(?:https?|wss?)://\\*)(?=[\\s;]|$)"
    }
  },
  "scope": "One response whose Content-Security-Policy carries an explicit media-src directive whose source list contains `*` or a scheme wildcard.",
  "limitations": "One header value and one directive. The rule judges media-src only when it is written in the policy; when the directive is absent, the default-src or child-src fallback decides the behaviour and other rules report that case. Values are matched lexically, so an origin wildcard such as *.example.com is not treated as a bare wildcard.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "media-src *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "media-src 'self' *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; media-src https://cdn.example.com *; frame-ancestors 'none'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "media-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "media-src *.example.com"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "media-src https://*.example.com"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "media-src 'self'; media-src https://cdn.example.com"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A policy that deliberately allows a wide CDN pool can still be flagged; the finding is the wildcard, not proof that a third-party origin is reachable in the deployment.",
  "linkedRules": [
    "DPK-DAST-148"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-mediasrc-wildcard:wildcard",
  "validationStatus": "VALIDATED"
}
