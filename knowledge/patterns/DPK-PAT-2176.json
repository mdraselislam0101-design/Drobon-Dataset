{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2176",
  "title": "Signal: Dependency declared with a multi-segment wildcard",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^\\*\\.\\*$|^\\*\\.\\*\\.\\*$"
    }
  },
  "scope": "A package.json file that declares a multi-segment wildcard that accepts every version of every major.",
  "limitations": "It matches a multi-segment wildcard that accepts every version of every major in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "*.*"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "*.*.*"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "*"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "1.*"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A single-segment wildcard is a different declaration and is reported by the bare-wildcard rule.",
  "linkedRules": [
    "DPK-SCA-0039"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-double-wildcard",
  "validationStatus": "VALIDATED"
}
