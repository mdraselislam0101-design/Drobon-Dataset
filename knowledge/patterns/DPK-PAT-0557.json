{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0557",
  "title": "Signal: Infrastructure banner disclosed (P3P header)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "P3P",
      "valuePattern": "[^ ]"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Banner check: version visibility alone is not exploitability.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "P3P": "CP=\"NOI\""
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "P3P": "CP=\"IDC\""
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "CDN-added banners are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-032"
  ],
  "origin": "original-authored",
  "cell": "dast:banner-more:p3p",
  "validationStatus": "VALIDATED"
}
