{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0722",
  "title": "Signal: File access built from input (nim) — review required",
  "targets": [
    "nim"
  ],
  "signal": {
    "kind": "regex",
    "source": "readFile\\s*\\([^)]*&"
  },
  "scope": "Single-line lexical match on input-built paths in nim code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "readFile(dir & f)",
      "match": true
    },
    {
      "line": "# audit: readFile(dir & f) present",
      "match": true
    },
    {
      "line": "readFile(fixed)",
      "match": false
    },
    {
      "line": "# verified: readFile(fixed)",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-605"
  ],
  "origin": "original-authored",
  "cell": "sast:path-3:nim",
  "validationStatus": "VALIDATED"
}
