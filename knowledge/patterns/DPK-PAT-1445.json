{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1445",
  "title": "Signal: Yii debugger toolbar disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*yii-debug)(?=[\\s\\S]*Yii Debugger)"
    }
  },
  "scope": "One response body containing the Yii debugger container and its label.",
  "limitations": "One response body. The rule reports the toolbar shell; it does not open the stored request history.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Shop</h1><div id=\"yii-debug-toolbar\"><span>Yii Debugger</span></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/cart",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<div id=\"yii-debug\"><a href=\"/debug/default/index\">Yii Debugger</a><a href=\"/debug/default/view?id=abc\">Last request</a></div>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Shop</h1><p>Free delivery this week.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/debug",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Enable the debug module only on development hosts.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that names the debugger in prose is not reported, because the container id is required.",
  "linkedRules": [
    "DPK-DAST-376"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-page-yii-debugger:yii-debugger",
  "validationStatus": "VALIDATED"
}
