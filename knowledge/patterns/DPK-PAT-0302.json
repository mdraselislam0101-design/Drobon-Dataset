{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0302",
  "title": "Signal: bind left open (mongo) — review required",
  "targets": [
    "mongo"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:bindIp\\s*:\\s*[^\\n]*0\\.0\\.0\\.0)"
  },
  "scope": "Single-line lexical match on open settings for bind.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "bindIp: 0.0.0.0",
      "match": true
    },
    {
      "line": "# audit: bindIp: 0.0.0.0 present",
      "match": true
    },
    {
      "line": "bindIp: 127.0.0.1",
      "match": false
    },
    {
      "line": "# verified: bindIp: 127.0.0.1",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-263"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:mongo:bind",
  "validationStatus": "VALIDATED"
}
