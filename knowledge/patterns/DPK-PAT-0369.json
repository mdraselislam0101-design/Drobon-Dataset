{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0369",
  "title": "Signal: Risky Terraform setting (iamres) — review required",
  "targets": [
    "terraform"
  ],
  "signal": {
    "kind": "regex",
    "source": "\"Resource\"\\s*:\\s*\"\\*\""
  },
  "scope": "Single-line lexical match on risky Terraform settings (iamres).",
  "limitations": "Lexical, line-based: matches the setting regardless of account scope.",
  "examples": [
    {
      "line": "\"Resource\": \"*\"",
      "match": true
    },
    {
      "line": "# audit: \"Resource\": \"*\" present",
      "match": true
    },
    {
      "line": "\"Resource\": \"arn:...:bucket\"",
      "match": false
    },
    {
      "line": "# verified: \"Resource\": \"arn:...:bucket\"",
      "match": false
    }
  ],
  "fpNotes": "Sandbox accounts are the common false positive — confirm account scope.",
  "linkedRules": [
    "DPK-SAST-330"
  ],
  "origin": "original-authored",
  "cell": "sast:terraform-strict:hcl:iamres",
  "validationStatus": "VALIDATED"
}
