{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1198",
  "title": "Signal: Elasticsearch cluster info disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*\"tagline\"\\s*:\\s*\"You Know, for Search\")(?=[\\s\\S]*\"cluster_name\")"
    }
  },
  "scope": "One response whose body contains the Elasticsearch tagline and a cluster_name field.",
  "limitations": "Two body markers. A page that merely mentions Elasticsearch is not matched; the tagline and the cluster-name field must appear together.",
  "examples": [
    {
      "observation": {
        "url": "https://search.example:9200/",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"name\":\"node-1\",\"cluster_name\":\"prod-search\",\"version\":{\"number\":\"8.11.1\",\"build_hash\":\"abc\"},\"tagline\":\"You Know, for Search\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://search.example:9200/",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"cluster_name\":\"logs\",\"tagline\" : \"You Know, for Search\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"cluster_name\":\"frontend\",\"items\":[]}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>We run Elasticsearch 8 behind the search box.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A tutorial page that embeds a captured root document is reported only if both markers are present in the body.",
  "linkedRules": [
    "DPK-DAST-129"
  ],
  "origin": "original-authored",
  "cell": "dast:body-elasticsearch-info:body-elasticsearch-info",
  "validationStatus": "VALIDATED"
}
