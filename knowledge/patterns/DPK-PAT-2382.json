{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2382",
  "title": "Signal: Conan remote configured over cleartext",
  "targets": [
    "conan"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "remotes.*.url",
      "valuePattern": "^http://"
    }
  },
  "scope": "A conanfile.py file that declares a remote URL that uses cleartext http.",
  "limitations": "It matches a remote URL that uses cleartext http in the parsed conanfile.py; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "conanfile.py",
      "document": {
        "remotes": {
          "acme": {
            "url": "http://conan.acme.example",
            "verify_ssl": true
          }
        }
      },
      "match": true
    },
    {
      "file": "conanfile.py",
      "document": {
        "remotes": {
          "mirror": {
            "url": "http://10.24.8.9",
            "verify_ssl": true
          }
        }
      },
      "match": true
    },
    {
      "file": "conanfile.py",
      "document": {
        "remotes": {
          "acme": {
            "url": "https://conan.acme.example",
            "verify_ssl": true
          }
        }
      },
      "match": false
    },
    {
      "file": "conanfile.py",
      "document": {
        "remotes": {
          "conancenter": {
            "url": "https://center.conan.io",
            "verify_ssl": true
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A conanfile.py that mentions a remote URL that uses cleartext http in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0245"
  ],
  "origin": "original-authored",
  "cell": "sca:conan-remote-cleartext",
  "validationStatus": "VALIDATED"
}
