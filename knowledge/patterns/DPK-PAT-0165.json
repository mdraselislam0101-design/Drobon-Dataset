{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0165",
  "title": "Signal: Framework SQL built from input (prisma) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\$queryRaw"
  },
  "scope": "Single-line lexical match on assembled framework SQL (prisma).",
  "limitations": "Lexical, line-based: any assembled query matches, including trusted ones.",
  "examples": [
    {
      "line": "await prisma.$queryRaw`SELECT ${x}`",
      "match": true
    },
    {
      "line": "# audit: await prisma.$queryRaw`SELECT ${x}` present",
      "match": true
    },
    {
      "line": "await prisma.user.findMany()",
      "match": false
    },
    {
      "line": "# verified: await prisma.user.findMany()",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-126"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli:javascript:prisma",
  "validationStatus": "VALIDATED"
}
