{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0742",
  "title": "Signal: Weak PHP crypto or diagnostics (regglobals) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:register_globals\\s*=\\s*(?:On|1))"
  },
  "scope": "Single-line lexical match on PHP settings (regglobals).",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "register_globals = On",
      "match": true
    },
    {
      "line": "# audit: register_globals = On present",
      "match": true
    },
    {
      "line": "register_globals = Off",
      "match": false
    },
    {
      "line": "# verified: register_globals = Off",
      "match": false
    }
  ],
  "fpNotes": "Legacy interop is the common false positive.",
  "linkedRules": [
    "DPK-SAST-625"
  ],
  "origin": "original-authored",
  "cell": "sast:php-misc:php:regglobals",
  "validationStatus": "VALIDATED"
}
