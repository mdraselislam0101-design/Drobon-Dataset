{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0298",
  "title": "Signal: security left open (elastic) — review required",
  "targets": [
    "elastic"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:xpack\\.security\\.enabled\\s*:\\s*false)"
  },
  "scope": "Single-line lexical match on open settings for security.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "xpack.security.enabled: false",
      "match": true
    },
    {
      "line": "# audit: xpack.security.enabled: false present",
      "match": true
    },
    {
      "line": "xpack.security.enabled: true",
      "match": false
    },
    {
      "line": "# verified: xpack.security.enabled: true",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-259"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:elastic:security",
  "validationStatus": "VALIDATED"
}
