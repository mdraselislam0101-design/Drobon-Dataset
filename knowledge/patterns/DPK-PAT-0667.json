{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0667",
  "title": "Signal: Java shell process (java) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "new ProcessBuilder\\s*\\(\\s*\"/bin/sh\""
  },
  "scope": "Single-line lexical match on process launches in java code.",
  "limitations": "Lexical, line-based: matches the launch.",
  "examples": [
    {
      "line": "new ProcessBuilder(\"/bin/sh\", c)",
      "match": true
    },
    {
      "line": "# audit: new ProcessBuilder(\"/bin/sh\", c) present",
      "match": true
    },
    {
      "line": "new ProcessBuilder(cmd)",
      "match": false
    },
    {
      "line": "# verified: new ProcessBuilder(cmd)",
      "match": false
    }
  ],
  "fpNotes": "Fixed commands are the common false positive.",
  "linkedRules": [
    "DPK-SAST-550"
  ],
  "origin": "original-authored",
  "cell": "sast:java-proc-flag:java",
  "validationStatus": "VALIDATED"
}
