{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0306",
  "title": "Signal: noroot left open (nfs) — review required",
  "targets": [
    "nfs"
  ],
  "signal": {
    "kind": "regex",
    "source": "no_root_squash"
  },
  "scope": "Single-line lexical match on open settings for noroot.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "/data *(rw,no_root_squash)",
      "match": true
    },
    {
      "line": "# audit: /data *(rw,no_root_squash) present",
      "match": true
    },
    {
      "line": "/data *(rw,root_squash)",
      "match": false
    },
    {
      "line": "# verified: /data *(rw,root_squash)",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-267"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:nfs:noroot",
  "validationStatus": "VALIDATED"
}
