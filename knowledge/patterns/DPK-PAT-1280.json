{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1280",
  "title": "Signal: Permissions-Policy allow-list is not closed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Permissions-Policy",
      "valuePattern": "=\\s*\\([^)]*$"
    }
  },
  "scope": "One response whose Permissions-Policy value contains an opening parenthesis that is never closed.",
  "limitations": "One header value. The rule detects the unclosed parenthesis only; it does not evaluate which feature ends up enabled by the browser default.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "camera=(self"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "geolocation=(self), microphone=(self"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "camera=(self)"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "camera=()"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A policy that closes every list is not reported even when it grants a feature; the grant rules cover that separately.",
  "linkedRules": [
    "DPK-DAST-211"
  ],
  "origin": "original-authored",
  "cell": "dast:permissions-policy-unclosed-allowlist:policy-unclosed-allowlist",
  "validationStatus": "VALIDATED"
}
