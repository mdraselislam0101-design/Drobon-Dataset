{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0200",
  "title": "Signal: Sensitive value in log call (matlab) — review required",
  "targets": [
    "matlab"
  ],
  "signal": {
    "kind": "regex",
    "source": "fprintf\\s*\\([^)]*(?:password|passwd|secret|token)"
  },
  "scope": "Single-line lexical match on credential-named log values in matlab code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "fprintf(\"password=%s\", pw)",
      "match": true
    },
    {
      "line": "# audit: fprintf(\"password=%s\", pw) present",
      "match": true
    },
    {
      "line": "fprintf(\"user=%s\", u)",
      "match": false
    },
    {
      "line": "# verified: fprintf(\"user=%s\", u)",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-161"
  ],
  "origin": "original-authored",
  "cell": "sast:log-langs:matlab",
  "validationStatus": "VALIDATED"
}
