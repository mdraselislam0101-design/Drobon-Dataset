{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1230",
  "title": "Signal: Apache Airflow interface disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*<title>Airflow)(?=[\\s\\S]*airflow)"
    }
  },
  "scope": "One response whose body contains both an Airflow page title and an Airflow bundle or boot object.",
  "limitations": "One response body. The rule reports the Airflow shell; it does not trigger a DAG and cannot show which connections are configured.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Airflow</title></head><body><div id=\"react-container\" data-airflow=\"webserver\"></div><script src=\"/static/airflow.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><head><title>Airflow - DAGs</title></head><body><script>window.airflow = {\"version\":\"2.7.1\"};</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head></title></head><body><div id=\"react-container\" data-=\"webserver\"></div><script src=\"/static/.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published Airflow instance is still reported; the finding is the exposed console.",
  "linkedRules": [
    "DPK-DAST-161"
  ],
  "origin": "original-authored",
  "cell": "dast:body-airflow-ui:airflow-ui",
  "validationStatus": "VALIDATED"
}
