{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0579",
  "title": "Signal: Unbounded buffer call getwd (c) — review required",
  "targets": [
    "c"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:getwd)\\s*\\("
  },
  "scope": "Single-line lexical match on the getwd call in c code.",
  "limitations": "Lexical, line-based: any getwd call matches.",
  "examples": [
    {
      "line": "getwd(payload)",
      "match": true
    },
    {
      "line": "out = getwd(data)",
      "match": true
    },
    {
      "line": "mygetwd(x)",
      "match": false
    },
    {
      "line": "getwd_safe()",
      "match": false
    }
  ],
  "fpNotes": "Fixed small inputs are the common false positive.",
  "linkedRules": [
    "DPK-SAST-462"
  ],
  "origin": "original-authored",
  "cell": "sast:buffer-call:c:getwd",
