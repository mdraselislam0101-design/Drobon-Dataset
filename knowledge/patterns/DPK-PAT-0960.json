{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0960",
  "title": "Signal: Debug profiler header exposed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-Debug-Token",
      "valuePattern": "\\S"
    }
  },
  "scope": "Single response header: confirm no debug token header is returned.",
  "limitations": "Header presence check: the profiler may be protected by a firewall that the scanner cannot see.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Debug-Token": "a1b2c3"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Debug-Token": ""
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Debug-Token": "   "
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Debug-Token": [
            "",
            "a1b2c3"
          ]
        }
      },
      "match": true
    }
  ],
  "fpNotes": "Development and staging hosts that run the profiler on purpose are the accepted case.",
  "linkedRules": [
    "DPK-DAST-063"
  ],
  "origin": "original-authored",
  "cell": "dast:debug-token-header:x-debug-token",
  "validationStatus": "VALIDATED"
}
