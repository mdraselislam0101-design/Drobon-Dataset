{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1236",
  "title": "Signal: Hadoop NameNode UI disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*NameNode)(?=[\\s\\S]*hdfs)"
    }
  },
  "scope": "One response whose body carries the NameNode heading and an hdfs:// address.",
  "limitations": "One response body. The rule reports the NameNode UI; it does not browse the filesystem and cannot show whether file access is open.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>NameNode</title></head><body><h3>NameNode Information</h3><div>hdfs://namenode:8020</div><table><tr><td>Live Nodes</td><td>6</td></tr></table></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h1>NameNode</h1><p>hdfs://cluster-nn:8020</p><a href=\"dfshealth.html\">Overview</a></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><h3> Information</h3><div>://:8020</div><table><tr><td>Live Nodes</td><td>6</td></tr></table></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published UI is still reported; the finding is reachability.",
  "linkedRules": [
    "DPK-DAST-167"
  ],
  "origin": "original-authored",
  "cell": "dast:body-hadoop-namenode-ui:hadoop-namenode-ui",
  "validationStatus": "VALIDATED"
}
