{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0047",
  "title": "Signal: Missing Permissions-Policy response header",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "missing-response-header",
      "header": "Permissions-Policy"
    }
  },
  "scope": "Single response: confirm the header is absent.",
  "limitations": "Header-name check on one response. It cannot see which features the page uses, and default allowlists differ per feature, so absence is a policy gap rather than an observed exposure.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "camera=()"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "Permissions-Policy": "camera=()"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Non-browser endpoints are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-017"
  ],
  "origin": "original-authored",
  "cell": "dast:header-missing:permissions",
  "validationStatus": "VALIDATED"
}
