      "match": true
    },
    {
      "line": "out = pty.spawn(data)",
      "match": true
    },
    {
      "line": "myptyspawn(x)",
      "match": false
    },
    {
      "line": "pty.spawn_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted tooling is the common false positive.",
