  "signal": {
    "kind": "regex",
    "source": "\\b(?:pty\\.spawn)\\s*\\("
  },
  "scope": "Single-line lexical match on the pty.spawn call in python code.",
  "limitations": "Lexical, line-based: any pty.spawn call matches.",
  "examples": [
