{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0572",
  "title": "Signal: Cross-Origin-Opener-Policy value without cross-origin isolation",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Cross-Origin-Opener-Policy",
      "valuePattern": "^(?=.*\\S)(?![\\s\\S]*?(?:^|[\\s,;])(?:same-origin|noopener-allow-popups)(?=[\\s,;]|$))[\\s\\S]*$"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Value check on the COOP token. `same-origin` and `noopener-allow-popups` are isolation modes and are not reported; an empty value is not reported here because a missing or empty header is DPK-DAST-012. The explicit `unsafe-none` token is also reported by DPK-DAST-076, which asks the narrower question \"is the default opt-out spelled out?\"; both fire on that value by design, so read them together. The rule reads one response and cannot confirm that an opener relationship exists.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": "unsafe-none"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": "noopener-allow-popups"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": ""
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": "bogus-value"
        }
      },
      "match": true
    }
  ],
  "fpNotes": "CDN behaviors are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-047"
  ],
  "origin": "original-authored",
  "cell": "dast:response-weak-2:coop-lax",
  "validationStatus": "VALIDATED"
}
