{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0741",
  "title": "Signal: Weak PHP crypto or diagnostics (pdo) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "->query\\s*\\([^)]*(?:\"[^\"\\n]*\\$|\\.\\s*\\$)"
  },
  "scope": "Single-line lexical match on PHP settings (pdo).",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "$pdo->query(\"SELECT $q\")",
      "match": true
    },
    {
      "line": "# audit: $pdo->query(\"SELECT $q\") present",
      "match": true
    },
    {
      "line": "$pdo->query($fixed)",
      "match": false
    },
    {
      "line": "# verified: $pdo->query($fixed)",
      "match": false
    }
  ],
  "fpNotes": "Legacy interop is the common false positive.",
  "linkedRules": [
    "DPK-SAST-624"
  ],
  "origin": "original-authored",
  "cell": "sast:php-misc:php:pdo",
  "validationStatus": "VALIDATED"
}
