{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0537",
  "title": "Signal: Framework SQL built from input (codeigniter) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\$this->db->query\\s*\\([^)]*(?:\"[^\"\\n]*\\$|\\.\\s*\\$)"
  },
  "scope": "Single-line lexical match on assembled SQL (codeigniter).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "$this->db->query(\"SELECT $q\")",
      "match": true
    },
    {
      "line": "# audit: $this->db->query(\"SELECT $q\") present",
      "match": true
    },
    {
      "line": "$this->db->query($fixed)",
      "match": false
    },
    {
      "line": "# verified: $this->db->query($fixed)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-440"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli-extra:php:codeigniter",
  "validationStatus": "VALIDATED"
}
