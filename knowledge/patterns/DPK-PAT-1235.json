{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1235",
  "title": "Signal: Grafana interface disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*grafanaBootData)(?=[\\s\\S]*\"buildInfo\")"
    }
  },
  "scope": "One response whose body contains both grafanaBootData and a buildInfo object.",
  "limitations": "One response body. The rule reports the Grafana shell; it does not prove that a dashboard or data source is readable without credentials.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Grafana</title></head><body><script>window.grafanaBootData = {\"user\":{\"isSignedIn\":false},\"settings\":{\"buildInfo\":{\"version\":\"10.2.0\"}}};</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><script>window.grafanaBootData={\"settings\":{\"buildInfo\":{\"version\":\"9.5.2\",\"commit\":\"abc\"}}};</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Grafana</title></head><body><script>window. = {\"user\":{\"isSignedIn\":false},\"settings\":{:{\"version\":\"10.2.0\"}}};</script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A Grafana instance published to a deliberate audience is still reported; the finding is the exposed console, not a proven data read.",
  "linkedRules": [
    "DPK-DAST-166"
  ],
  "origin": "original-authored",
  "cell": "dast:body-grafana-ui:grafana-ui",
  "validationStatus": "VALIDATED"
}
