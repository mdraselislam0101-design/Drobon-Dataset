{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1155",
  "title": "Signal: Content-Security-Policy connect-src allows every origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "^(?:(?!connect-src)[^;]*;\\s*)*connect-src(?=\\s)[^;]*?(?<=\\s)(?:\\*|(?:https?|wss?)://\\*)(?=\\s|;|$)"
    }
  },
  "scope": "One response: connect-src contains a standalone wildcard source.",
  "limitations": "Observation-level: matches a standalone * source in connect-src. Host wildcards such as *.example.com and other directives are separate checks.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src 'self' *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src 'self'; connect-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src 'self' https://api.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src https://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src wss://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src https://*.api.example"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "An API that genuinely calls arbitrary customer-supplied endpoints is reported by design.",
  "linkedRules": [
    "DPK-DAST-086"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-connect-src-wildcard:connect-src",
  "validationStatus": "VALIDATED"
}
