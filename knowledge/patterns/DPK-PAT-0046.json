{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0046",
  "title": "Signal: Missing Strict-Transport-Security response header",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "missing-response-header",
      "header": "Strict-Transport-Security"
    }
  },
  "scope": "Single response: confirm the header is absent.",
  "limitations": "Header-name check on one response. It cannot tell whether the host is ever reached over plaintext, and it reports the missing policy rather than an observed downgrade.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "Strict-Transport-Security": "max-age=1"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Non-browser endpoints are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-016"
  ],
  "origin": "original-authored",
  "cell": "dast:header-missing:hsts",
  "validationStatus": "VALIDATED"
}
