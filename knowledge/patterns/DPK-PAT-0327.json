{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0327",
  "title": "Signal: SQL built by concatenation (lua) — review required",
  "targets": [
    "lua"
  ],
  "signal": {
    "kind": "regex",
    "source": ":execute\\s*\\([^)]*\\.\\."
  },
  "scope": "Single-line lexical match on assembled SQL in lua code.",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "cur:execute(\"SELECT \" .. q)",
      "match": true
    },
    {
      "line": "# audit: cur:execute(\"SELECT \" .. q) present",
      "match": true
    },
    {
      "line": "cur:execute(FIXED)",
      "match": false
    },
    {
      "line": "# verified: cur:execute(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-288"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-langs:lua",
  "validationStatus": "VALIDATED"
}
