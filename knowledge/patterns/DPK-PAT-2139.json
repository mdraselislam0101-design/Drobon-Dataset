{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2139",
  "title": "Signal: Dependency declared with an empty version specifier",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^$"
    }
  },
  "scope": "A package.json file that declares an empty dependency specifier, which npm reads as `*`.",
  "limitations": "It matches an empty dependency specifier, which npm reads as `*` in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "axios": ""
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "express": ""
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "axios": "1.7.2"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "express": "4.19.2"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A generated manifest that writes an empty string for an optional peer is not reported when the dependency is absent.",
  "linkedRules": [
    "DPK-SCA-0002"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-empty-specifier",
  "validationStatus": "VALIDATED"
}
