{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1224",
  "title": "Signal: Strict-Transport-Security delivered over plaintext HTTP",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Strict-Transport-Security",
      "valuePattern": "^\\s*\\S",
      "requireScheme": "http"
    }
  },
  "scope": "One response fetched over http:// that carries a non-empty Strict-Transport-Security header.",
  "limitations": "One response and its scheme. The rule judges the secured-ness of the response that carried the header; it cannot see whether the HTTPS listener sets the header correctly.",
  "examples": [
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "http://app.example/login",
        "status": 301,
        "headers": {
          "Strict-Transport-Security": "max-age=63072000"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "   "
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A test listener that mirrors production headers over plaintext is reported; browsers ignore the header there, which is the finding.",
  "linkedRules": [
    "DPK-DAST-155"
  ],
  "origin": "original-authored",
  "cell": "dast:hsts-over-plaintext:plaintext",
  "validationStatus": "VALIDATED"
}
