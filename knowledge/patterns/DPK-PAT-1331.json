{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1331",
  "title": "Signal: Content-Type declares the UTF-7 charset",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Type",
      "valuePattern": "charset\\s*=\\s*[\"\\']?\\s*(?:utf|unicode)-?7\\b"
    }
  },
  "scope": "One response whose Content-Type declares the utf-7 charset.",
  "limitations": "One header value. The rule reports the declared charset and cannot show that a filter would pass a payload it decodes.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-7"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=\"UTF-7\""
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain; charset=utf7"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-7x"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Current browsers ignore utf-7 in most contexts; the finding is the declaration, and legacy clients are the exposure.",
  "linkedRules": [
    "DPK-DAST-262"
  ],
  "origin": "original-authored",
  "cell": "dast:content-type-utf7-charset:type-utf7-charset",
  "validationStatus": "VALIDATED"
}
