{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2875",
  "title": "Signal: Pub dependency pinned to a moving git reference",
  "targets": [
    "pub"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*.git.ref",
      "valuePattern": "^(?:main|master|develop|HEAD)$"
    }
  },
  "scope": "A pubspec.yaml file that declares a git dependency whose ref is a branch name.",
  "limitations": "It matches a git dependency whose ref is a branch name in the parsed pubspec.yaml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0",
          "acme_sdk": {
            "git": {
              "url": "https://github.com/acme/sdk",
              "ref": "main"
            }
          }
        },
        "dependency_overrides": {}
      },
      "match": true
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0",
          "acme_core": {
            "git": {
              "url": "https://github.com/acme/core",
              "ref": "develop"
            }
          }
        },
        "dependency_overrides": {}
      },
      "match": true
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0",
          "acme_sdk": {
            "git": {
              "url": "https://github.com/acme/sdk",
              "ref": "9f2c3d4e5f60"
            }
          }
        },
        "dependency_overrides": {}
      },
      "match": false
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A pubspec.yaml that mentions a git dependency whose ref is a branch name in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0738"
  ],
  "origin": "original-authored",
  "cell": "sca:pub-git-ref-mutable",
  "validationStatus": "VALIDATED"
}
