{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1347",
  "title": "Signal: Selenium Grid status endpoint disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*[\"\\']ready[\"\\']\\s*:\\s*(?:true|false))(?=[\\s\\S]*[\"\\']nodes[\"\\'])"
    }
  },
  "scope": "One response body containing Selenium Grid status JSON with a node list.",
  "limitations": "One response body. The marker identifies a Grid status document; the check does not attempt to create a session, so it proves disclosure and not command execution.",
  "examples": [
    {
      "observation": {
        "url": "https://ci.example/wd/hub/status",
        "status": 200,
        "headers": {},
        "body": "{\"value\":{\"ready\":true,\"message\":\"Selenium Grid ready.\",\"nodes\":[{\"id\":\"node-1\",\"uri\":\"http://10.0.0.5:5555\"}]}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://ci.example/status",
        "status": 200,
        "headers": {},
        "body": "{\"value\": {\"ready\": false, \"nodes\": []}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://ci.example/",
        "status": 200,
        "headers": {},
        "body": "{\"status\":\"ok\"}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://ci.example/api/workers",
        "status": 200,
        "headers": {},
        "body": "{\"workers\":1,\"state\":\"ok\"}"
      },
      "match": false
    }
  ],
  "fpNotes": "A mocked Grid status fixture served by a test double is reported; the fixture is still a reachable endpoint and should be treated as one.",
  "linkedRules": [
    "DPK-DAST-278"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-selenium-grid:selenium-grid",
  "validationStatus": "VALIDATED"
}
