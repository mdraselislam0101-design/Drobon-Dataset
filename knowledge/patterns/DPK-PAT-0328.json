{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0328",
  "title": "Signal: SQL built by concatenation (matlab) — review required",
  "targets": [
    "matlab"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:fetch\\s*\\([^)]*\\+)"
  },
  "scope": "Single-line lexical match on assembled SQL in matlab code.",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "fetch(c, \"SELECT \" + q)",
      "match": true
    },
    {
      "line": "# audit: fetch(c, \"SELECT \" + q) present",
      "match": true
    },
    {
      "line": "fetch(c, FIXED)",
      "match": false
    },
    {
      "line": "# verified: fetch(c, FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-289"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-langs:matlab",
  "validationStatus": "VALIDATED"
}
