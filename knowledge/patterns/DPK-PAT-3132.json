{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3132",
  "title": "Signal: uv index configured over cleartext",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "tool.uv.index[].url",
      "valuePattern": "^http://"
    }
  },
  "scope": "A pyproject.toml file that declares a `tool.uv.index` URL over cleartext.",
  "limitations": "It matches a `tool.uv.index` URL over cleartext in the parsed pyproject.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "requests==2.32.3"
          ],
          "license": {
            "text": "MIT"
          }
        },
        "build-system": {
          "requires": [
            "setuptools==75.1.0"
          ],
          "build-backend": "setuptools.build_meta"
        },
        "tool": {
          "uv": {
            "index": [
              {
                "name": "acme",
                "url": "http://pypi.acme.example/simple"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "requests==2.32.3"
          ],
          "license": {
            "text": "MIT"
          }
        },
        "build-system": {
          "requires": [
            "setuptools==75.1.0"
          ],
          "build-backend": "setuptools.build_meta"
        },
        "tool": {
          "uv": {
            "index": [
              {
                "name": "internal",
                "url": "http://10.24.8.9/simple"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "requests==2.32.3"
          ],
          "license": {
            "text": "MIT"
          }
        },
        "build-system": {
          "requires": [
            "setuptools==75.1.0"
          ],
          "build-backend": "setuptools.build_meta"
        },
        "tool": {
          "uv": {
            "index": [
              {
                "name": "pypi",
                "url": "https://pypi.org/simple"
              }
            ]
          }
        }
      },
      "match": false
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "requests==2.32.3"
          ],
          "license": {
            "text": "MIT"
          }
        },
        "build-system": {
          "requires": [
            "setuptools==75.1.0"
          ],
          "build-backend": "setuptools.build_meta"
        },
        "tool": {
          "uv": {}
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pyproject.toml that mentions a `tool.uv.index` URL over cleartext in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0995"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-uv-index-cleartext",
  "validationStatus": "VALIDATED"
}
