{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0754",
  "title": "Signal: Dynamic execution via commands.getoutput (python) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:commands\\.getoutput)\\s*\\("
  },
  "scope": "Single-line lexical match on the commands.getoutput call in python code.",
  "limitations": "Lexical, line-based: any commands.getoutput call matches.",
  "examples": [
    {
      "line": "commands.getoutput(payload)",
      "match": true
    },
    {
      "line": "out = commands.getoutput(data)",
      "match": true
    },
    {
      "line": "mycommandsgetoutput(x)",
      "match": false
    },
    {
      "line": "commands.getoutput_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted tooling is the common false positive.",
  "linkedRules": [
    "DPK-SAST-637"
  ],
  "origin": "original-authored",
  "cell": "sast:python-dyn-more:python",
