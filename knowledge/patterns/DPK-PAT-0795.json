{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0795",
  "title": "Signal: Shell runs a variable (amp, powershell) — review required",
  "targets": [
    "powershell"
  ],
  "signal": {
    "kind": "regex",
    "source": "&\\s+\\$"
  },
  "scope": "Single-line lexical match on shell execution (amp).",
  "limitations": "Lexical, line-based: matches the execution.",
  "examples": [
    {
      "line": "& $cmd",
      "match": true
    },
    {
      "line": "# audit: & $cmd present",
      "match": true
    },
    {
      "line": "& \"fixed\"",
      "match": false
    },
    {
      "line": "# verified: & \"fixed\"",
      "match": false
    }
  ],
  "fpNotes": "Trusted variables are the common false positive.",
  "linkedRules": [
    "DPK-SAST-678"
  ],
  "origin": "original-authored",
  "cell": "sast:shell-risk:powershell:amp",
  "validationStatus": "VALIDATED"
}
