{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2189",
  "title": "Signal: Lockfile records git or path dependencies as version 0.0.0",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.version",
      "valuePattern": "^0\\.0\\.0$"
    }
  },
  "scope": "A package-lock.json file that declares a package entry whose version is the git/path placeholder `0.0.0`.",
  "limitations": "It matches a package entry whose version is the git/path placeholder `0.0.0` in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "0.0.0",
            "resolved": "git+https://github.com/acme/sdk.git#9f2c4a1"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "0.0.0",
            "resolved": "file:../acme-lib"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "0.0.1",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published `0.0.0` bootstrap package is still reported; the placeholder is the finding.",
  "linkedRules": [
    "DPK-SCA-0052"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-version-git-placeholder",
  "validationStatus": "VALIDATED"
}
