    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "Decided from the observed URL scheme only. HTTPS targets with broken certificates are out of scope for this check.",
