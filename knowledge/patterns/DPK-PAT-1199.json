{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1199",
  "title": "Signal: etcd version endpoint disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*\"etcdserver\")(?=[\\s\\S]*\"etcdcluster\")"
    }
  },
  "scope": "One response whose body contains both etcdserver and etcdcluster version fields.",
  "limitations": "Two body markers. A generic JSON document with one version field is not reported.",
  "examples": [
    {
      "observation": {
        "url": "https://etcd.example:2379/version",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"etcdserver\":\"3.5.9\",\"etcdcluster\":\"3.5.0\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://etcd.example:2379/version",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"etcdserver\": \"3.4.27\", \"etcdcluster\": \"3.4.0\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api/version",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"etcdserver\":\"3.5.9\"}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>Home</body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A monitoring dashboard that embeds the version JSON is reported only if both fields appear in the body.",
  "linkedRules": [
    "DPK-DAST-130"
  ],
  "origin": "original-authored",
  "cell": "dast:body-etcd-version:body-etcd-version",
  "validationStatus": "VALIDATED"
}
