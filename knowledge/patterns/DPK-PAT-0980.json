{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0980",
  "title": "Signal: Possible short alphanumeric password in a URL in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "[A-Za-z][A-Za-z0-9+.\\-]*://[^\\s:@/]{1,64}:(?!(?:[eE][xX][aA][mM][pP][lL][eE]|[cC][hH][aA][nN][gG][eE][mM][eE]|[pP][lL][aA][cC][eE][hH][oO][lL][dD][eE][rR]))(?=[A-Za-z0-9]{8,11}@)(?=[A-Za-z0-9]*[A-Z])(?=[A-Za-z0-9]*[a-z])(?=[A-Za-z0-9]*[0-9])[A-Za-z0-9]{8,11}@"
  },
  "scope": "URL userinfo passwords of 8-11 alphanumeric characters with mixed case and at least one digit.",
  "limitations": "Shape-only heuristic over URL userinfo syntax. 8-11 alphanumeric characters with mixed case and a digit, placeholder-vetoed. Pure lowercase words, pure numbers, symbols (see the symbol variant), and values shorter than 8 or longer than 11 alphanumeric characters are out of scope. Cannot prove the value is live.",
  "examples": [
    {
      "line": "url = \"postgresql://svc:zzzzzzz9Z@\"",
      "match": true
    },
    {
      "line": "# audit: url = \"postgresql://svc:zzzzzzz9Z@\" present",
      "match": true
    },
    {
      "line": "url = \"xy\"",
      "match": false
    },
    {
      "line": "url = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    },
    {
      "line": "url = \"postgresql://svc:Ab3xK9mQ@db.internal/app\"",
      "match": true
    },
    {
      "line": "url = \"https://api:xY9mP2wQ@host.internal/\"",
      "match": true
    },
    {
      "line": "url = \"https://u:Ab3xK9mQzW2@h\"",
      "match": true
    },
    {
      "line": "url = \"https://deploy:production@host/\"",
      "match": false
    },
    {
      "line": "url = \"https://api:2026101717@host/\"",
      "match": false
    },
    {
      "line": "url = \"https://user:Changeme1@host/\"",
      "match": false
    },
    {
      "line": "url = \"https://user:Ab3xK9m@host/\"",
      "match": false
    },
    {
      "line": "url = \"https://user:Ab3xK9mQzW2p@host/\"",
      "match": false
    },
    {
      "line": "url = \"https://host.internal:8443/path\"",
      "match": false
    },
    {
      "line": "url = \"https://u:zzzz!z9@h\"",
      "match": false
    },
    {
      "line": "url = \"postgresql://user:${DB_PASSWORD}@db.internal/app\"",
      "match": false
    },
    {
      "line": "url = \"https://user:EXAMPLE-NOT-A-REAL@host/\"",
      "match": false
    }
  ],
  "fpNotes": "Values that are product names with digits, version-like tokens, or other mixed alphanumeric identifiers placed in the password slot of a URL. The placeholder veto removes common documentation values.",
  "linkedRules": [
    "DPK-SEC-108"
  ],
  "origin": "original-authored",
  "cell": "secrets:url-userinfo-short-alnum-password:userinfo-short-alnum",
  "validationStatus": "VALIDATED"
}
