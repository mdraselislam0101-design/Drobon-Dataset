{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1579",
  "title": "Signal: Account number carried in a link URL",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "href\\s*=\\s*[\\\"'][^\\\"']{0,300}[?&](?:account|acct|acc)(?:_?(?:number|no|id))?=[0-9]{8,17}[^\\\"']{0,100}[\\\"']"
    }
  },
  "scope": "An href whose query string carries an account, acct or acc parameter with eight or more digits.",
  "limitations": "One response body. It matches the link parameter shape, not whether the linked page is authorised.",
  "examples": [
    {
      "observation": {
        "url": "https://bank.example/accounts",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<a href=\"/statement/download?account=0123456789012&period=2026-09\">Download</a>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<a href=\"/cards/manage?acct_no=55100488291177\">Manage card</a>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/accounts",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<a href=\"/statement/download?account=9f2c71ba&period=2026-09\">Download</a>"
      },
      "match": false
    }
  ],
  "fpNotes": "A link that carries an opaque reference such as acc=9f2c does not match, because the pattern requires digits.",
  "linkedRules": [
    "DPK-DAST-510"
  ],
  "origin": "original-authored",
  "cell": "dast:bank-account-in-link:bank-account-in-link",
  "validationStatus": "VALIDATED"
}
