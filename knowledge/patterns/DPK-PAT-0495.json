{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0495",
  "title": "Signal: Possible a compact JWT in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "eyJ[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}"
  },
  "scope": "Single-line shape match for a compact JWT.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"eyJAAAAAAAAAAAAAAAAAAAA.AAAAAAAAAAAAAAAAAAAA.AAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"eyJAAAAAAAAAAAAAAAAAAAA.AAAAAAAAAAAAAAAAAAAA.AAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-029"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:jwt-compact",
  "validationStatus": "VALIDATED"
}
