{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0686",
  "title": "Signal: JWT verification skipped (claimsjwt) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:parseClaimsJwt\\s*\\()"
  },
  "scope": "Single-line lexical match on JWT verification (claimsjwt).",
  "limitations": "Lexical, line-based: matches the skip.",
  "examples": [
    {
      "line": "parser.parseClaimsJwt(t)",
      "match": true
    },
    {
      "line": "# audit: parser.parseClaimsJwt(t) present",
      "match": true
    },
    {
      "line": "parser.parseClaimsJws(t)",
      "match": false
    },
    {
      "line": "# verified: parser.parseClaimsJws(t)",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive.",
  "linkedRules": [
    "DPK-SAST-569"
  ],
  "origin": "original-authored",
  "cell": "sast:jwt-verify-off:java:claimsjwt",
  "validationStatus": "VALIDATED"
}
