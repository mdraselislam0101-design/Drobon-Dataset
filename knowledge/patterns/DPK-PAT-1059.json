{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1059",
  "title": "Signal: Eloquent mass assignment left fully open in php — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\$(?:guarded)\\s*=\\s*\\[\\s*\\]"
  },
  "scope": "Single-line match on $guarded = [] in php.",
  "limitations": "Lexical: matches an empty $guarded assignment; a guarded list with entries is not reported.",
  "examples": [
    {
      "line": "protected $guarded = [];",
      "match": true
    },
    {
      "line": "# audit: protected $guarded = []; present",
      "match": true
    },
    {
      "line": "protected $fillable = ['name', 'email'];",
      "match": false
    },
    {
      "line": "# verified: protected $fillable = ['name', 'email'];",
      "match": false
    }
  ],
  "fpNotes": "Models whose controller always passes a validated, closed attribute set are the accepted, documented exception.",
  "linkedRules": [
    "DPK-SAST-876"
  ],
  "origin": "original-authored",
  "cell": "sast:php-laravel-guarded-empty:php",
  "validationStatus": "VALIDATED"
}
