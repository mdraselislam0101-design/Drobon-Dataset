{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0007",
  "title": "Signal: X-Frame-Options header missing",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "missing-response-header",
      "header": "x-frame-options"
    }
  },
  "scope": "Legacy signal mirrored from DPK-DAST-007.",
  "limitations": "Header presence only: the value is not validated, so ALLOW-FROM quirks and meta-tag equivalents are out of scope.",
  "examples": [
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "server": "example"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "X-Frame-Options": "DENY"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Header presence only: the value is not validated, so ALLOW-FROM quirks and meta-tag equivalents are out of scope.",
  "linkedRules": [
    "DPK-DAST-007"
  ],
  "origin": "original-authored",
  "cell": "legacy:DPK-DAST-007",
  "validationStatus": "VALIDATED"
}
