{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2887",
  "title": "Signal: Dependency with transitives switched off",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies[].transitive",
      "valuePattern": "^false$"
    }
  },
  "scope": "A build.gradle file that declares a dependency declared `transitive = false`, hiding its graph.",
  "limitations": "It matches a dependency declared `transitive = false`, hiding its graph in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "com.acme",
            "name": "sdk",
            "version": "4.2.0",
            "transitive": false
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "com.acme",
            "name": "core",
            "version": "1.4.2",
            "transitive": "false"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "com.acme",
            "name": "sdk",
            "version": "4.2.0",
            "transitive": true
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A build.gradle that mentions a dependency declared `transitive = false`, hiding its graph in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0750"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-transitive-disabled",
  "validationStatus": "VALIDATED"
}
