{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0833",
  "title": "Signal: Weak Terraform setting (nobackup) — review required",
  "targets": [
    "terraform"
  ],
  "signal": {
    "kind": "regex",
    "source": "backup_retention_period\\s*=\\s*0\\b"
  },
  "scope": "Single-line lexical match on Terraform files.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "backup_retention_period = 0",
      "match": true
    },
    {
      "line": "# audit: backup_retention_period = 0 present",
      "match": true
    },
    {
      "line": "backup_retention_period = 7",
      "match": false
    },
    {
      "line": "# verified: backup_retention_period = 7",
      "match": false
    }
  ],
  "fpNotes": "Ephemeral environments are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-716"
  ],
  "origin": "original-authored",
  "cell": "sast:tf-more:hcl:nobackup",
  "validationStatus": "VALIDATED"
}
