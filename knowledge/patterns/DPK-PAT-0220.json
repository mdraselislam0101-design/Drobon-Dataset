{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0220",
  "title": "Signal: MD5 use via getMD5 (nim) — review required",
  "targets": [
    "nim"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:getMD5)\\s*\\("
  },
  "scope": "Single-line lexical match on the getMD5 call in nim code.",
  "limitations": "Lexical, line-based: matches any getMD5 call.",
  "examples": [
    {
      "line": "getMD5(payload)",
      "match": true
    },
    {
      "line": "out = getMD5(data)",
      "match": true
    },
    {
      "line": "mygetMD5(x)",
      "match": false
    },
    {
      "line": "getMD5_safe()",
      "match": false
    }
  ],
  "fpNotes": "Checksums are the common false positive.",
  "linkedRules": [
    "DPK-SAST-181"
  ],
  "origin": "original-authored",
  "cell": "sast:md5-call-extra:nim",
  "validationStatus": "VALIDATED"
}
