{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0333",
  "title": "Signal: Weak SSH daemon setting (pwauth) — review required",
  "targets": [
    "sshd"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:PasswordAuthentication\\s+yes)"
  },
  "scope": "Single-line lexical match on sshd settings (pwauth).",
  "limitations": "Lexical, line-based: matches the setting regardless of network exposure.",
  "examples": [
    {
      "line": "PasswordAuthentication yes",
      "match": true
    },
    {
      "line": "# audit: PasswordAuthentication yes present",
      "match": true
    },
    {
      "line": "PasswordAuthentication no",
      "match": false
    },
    {
      "line": "# verified: PasswordAuthentication no",
      "match": false
    }
  ],
  "fpNotes": "Isolated lab hosts are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-294"
  ],
  "origin": "original-authored",
  "cell": "sast:ssh-strict:sshd:pwauth",
  "validationStatus": "VALIDATED"
}
