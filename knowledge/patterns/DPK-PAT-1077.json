{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1077",
  "title": "Signal: Third-party action referenced by a mutable tag in gha — review required",
  "targets": [
    "gha"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\buses\\s*:\\s*[^:\\s]+@(?:v\\d+(?:\\.\\d+){0,3}|main|master)\\b"
  },
  "scope": "Single-line match on a mutable action reference in gha.",
  "limitations": "Lexical: matches branch and major-version refs; digest pins and local actions are not reported.",
  "examples": [
    {
      "line": "      - uses: actions/checkout@v4",
      "match": true
    },
    {
      "line": "# audit:       - uses: actions/checkout@v4 present",
      "match": true
    },
    {
      "line": "      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683",
      "match": false
    },
    {
      "line": "# verified:       - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683",
      "match": false
    }
  ],
  "fpNotes": "A first-party action in the same organisation referenced by a protected tag is the accepted exception.",
  "linkedRules": [
    "DPK-SAST-894"
  ],
  "origin": "original-authored",
  "cell": "sast:gha-unpinned-action-ref:gha",
  "validationStatus": "VALIDATED"
}
