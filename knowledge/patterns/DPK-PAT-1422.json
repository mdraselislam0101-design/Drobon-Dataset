{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1422",
  "title": "Signal: Kiali console is reachable without authentication",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<title>[^<]{0,40}Kiali"
    }
  },
  "scope": "One response body containing the Kiali console shell.",
  "limitations": "One response body. The rule recognises the Kiali shell; it does not read the mesh graph.",
  "examples": [
    {
      "observation": {
        "url": "https://mesh.example/kiali/console",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Kiali</title><script>window.KIALI_CONFIG={version:\"1.84\"}</script></head><body><div id=\"root\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://mesh.example/kiali/console/graph/namespaces",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Kiali · Graph</title></head><body><div class=\"kiali-graph\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Shop</title></head><body><p>Shop home</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/mesh",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Mesh guide</title></head><body><p>Kiali shows the traffic graph.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that names Kiali in an operations guide is not reported, because the shell markup is required.",
  "linkedRules": [
    "DPK-DAST-353"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-console-kiali:kiali-console",
  "validationStatus": "VALIDATED"
}
