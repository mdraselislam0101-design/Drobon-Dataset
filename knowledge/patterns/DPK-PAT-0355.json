{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0355",
  "title": "Signal: Weak service hardening (nonewprivs) — review required",
  "targets": [
    "systemd"
  ],
  "signal": {
    "kind": "regex",
    "source": "NoNewPrivileges\\s*=\\s*no"
  },
  "scope": "Single-line lexical match on weak settings (nonewprivs).",
  "limitations": "Lexical, line-based: matches the setting regardless of host trust.",
  "examples": [
    {
      "line": "NoNewPrivileges=no",
      "match": true
    },
    {
      "line": "# audit: NoNewPrivileges=no present",
      "match": true
    },
    {
      "line": "NoNewPrivileges=yes",
      "match": false
    },
    {
      "line": "# verified: NoNewPrivileges=yes",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-316"
  ],
  "origin": "original-authored",
  "cell": "sast:sys-services:systemd:nonewprivs",
  "validationStatus": "VALIDATED"
}
