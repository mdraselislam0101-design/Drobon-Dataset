{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1212",
  "title": "Signal: Access-Control-Allow-Origin is not a bare origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Allow-Origin",
      "valuePattern": "^\\s*https?://[^\\s/]+/"
    }
  },
  "scope": "One response whose Access-Control-Allow-Origin value has a path component or trailing slash.",
  "limitations": "One header value. The rule reports the shape of the declared origin and cannot observe whether the browser rejected the response.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://example.com/"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://example.com/app"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://example.com"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://example.com:8443"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A policy file kept in source control that is not served on the wire is out of scope; the finding is the header the browser receives.",
  "linkedRules": [
    "DPK-DAST-143"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-origin-with-path:with-path",
  "validationStatus": "VALIDATED"
}
