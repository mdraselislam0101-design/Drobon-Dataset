{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1417",
  "title": "Signal: Drone CI console is reachable without authentication",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*drone-ui)(?=[\\s\\S]*Drone)"
    }
  },
  "scope": "One response body containing the Drone console shell.",
  "limitations": "One response body. The rule recognises the Drone shell; it does not read a build log.",
  "examples": [
    {
      "observation": {
        "url": "https://ci.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Drone</title><script>window.DRONE={version:\"2.20.0\"}</script></head><body><div id=\"drone-ui\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://ci.example/user/repos",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Drone · Repositories</title></head><body><div class=\"drone-ui builds\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Shop</title></head><body><p>Shop home</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/ci",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>CI guide</title></head><body><p>Pipelines are declared in .drone.yml.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that names Drone in an integration guide is not reported, because the shell markup is required.",
  "linkedRules": [
    "DPK-DAST-348"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-console-drone:drone-console",
  "validationStatus": "VALIDATED"
}
