{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1130",
  "title": "Signal: WebView remote debugging enabled in java — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:setWebContentsDebuggingEnabled\\s*\\(\\s*true\\b)"
  },
  "scope": "Single-line match on enabled WebView debugging in java.",
  "limitations": "Lexical: matches the call with a literal true; a build-config expression is out of scope.",
  "examples": [
    {
      "line": "WebView.setWebContentsDebuggingEnabled(true);",
      "match": true
    },
    {
      "line": "# audit: WebView.setWebContentsDebuggingEnabled(true); present",
      "match": true
    },
    {
      "line": "WebView.setWebContentsDebuggingEnabled(BuildConfig.DEBUG);",
      "match": false
    },
    {
      "line": "# verified: WebView.setWebContentsDebuggingEnabled(BuildConfig.DEBUG);",
      "match": false
    }
  ],
  "fpNotes": "A debug-only build that never ships is the accepted exception.",
  "linkedRules": [
    "DPK-SAST-945"
  ],
  "origin": "original-authored",
  "cell": "sast:android-webview-debug:java",
  "validationStatus": "VALIDATED"
}
