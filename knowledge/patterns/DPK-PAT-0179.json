{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0179",
  "title": "Signal: Wildcard IAM in cfnact — review required",
  "targets": [
    "yaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "\"Action\"\\s*:\\s*\"\\*\""
  },
  "scope": "Single-line lexical match on wildcard IAM (cfnact).",
  "limitations": "Lexical, line-based: matches the wildcard regardless of trust policy.",
  "examples": [
    {
      "line": "\"Action\": \"*\"",
      "match": true
    },
    {
      "line": "# audit: \"Action\": \"*\" present",
      "match": true
    },
    {
      "line": "\"Action\": \"s3:GetObject\"",
      "match": false
    },
    {
      "line": "# verified: \"Action\": \"s3:GetObject\"",
      "match": false
    }
  ],
  "fpNotes": "Break-glass roles are the rare accepted case — confirm controls.",
  "linkedRules": [
    "DPK-SAST-140"
  ],
  "origin": "original-authored",
  "cell": "sast:iac-iam-star:yaml:cfnact",
  "validationStatus": "VALIDATED"
}
