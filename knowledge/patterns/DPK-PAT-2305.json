{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2305",
  "title": "Signal: Maven mirror takes over every repository",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "settings.mirrors[].mirrorOf",
      "valuePattern": "^\\*$"
    }
  },
  "scope": "A settings.xml file that declares a mirror with `mirrorOf` set to `*`.",
  "limitations": "It matches a mirror with `mirrorOf` set to `*` in the parsed settings.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "corp",
              "mirrorOf": "*",
              "url": "https://nexus.acme.example/repository/maven-public"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "single",
              "mirrorOf": "*",
              "url": "https://mirror.acme.example/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "central",
              "mirrorOf": "central",
              "url": "https://nexus.acme.example/repository/maven-public"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "internal",
              "mirrorOf": "*,!internal-releases",
              "url": "https://nexus.acme.example/repository/maven-public"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A settings.xml that mentions a mirror with `mirrorOf` set to `*` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0168"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-settings-mirror-wildcard",
  "validationStatus": "VALIDATED"
}
