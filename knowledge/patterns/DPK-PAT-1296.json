{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1296",
  "title": "Signal: Jenkins script console disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Groovy\\ script)(?=[\\s\\S]*Jenkins)"
    }
  },
  "scope": "One response whose body renders the Jenkins script console.",
  "limitations": "One response body. The rule reports the console page; it does not submit the form and cannot show whether the request was authorised.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Jenkins</title></head><body><h1>Jenkins</h1><form action=\"/script\"><textarea name=\"script\">println \"hello\"</textarea><p>Groovy script</p></form></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h2>Jenkins</h2><div id=\"script-console\">Groovy script</div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><h1></h1><form action=\"/script\"><textarea name=\"script\">println \"hello\"</textarea><p></p></form></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A documentation page describing the console is reported too when it carries the editor and the Jenkins chrome; the reviewer confirms which page it is.",
  "linkedRules": [
    "DPK-DAST-227"
  ],
  "origin": "original-authored",
  "cell": "dast:body-jenkins-script-console:jenkins-script-console",
  "validationStatus": "VALIDATED"
}
