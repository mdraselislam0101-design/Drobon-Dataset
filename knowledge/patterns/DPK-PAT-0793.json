{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0793",
  "title": "Signal: Guest share access (mapguest) — review required",
  "targets": [
    "samba"
  ],
  "signal": {
    "kind": "regex",
    "source": "map to guest\\s*="
  },
  "scope": "Single-line lexical match on Samba settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "map to guest = Bad User",
      "match": true
    },
    {
      "line": "# audit: map to guest = Bad User present",
      "match": true
    },
    {
      "line": "# map to guest unset",
      "match": false
    },
    {
      "line": "# verified: # map to guest unset",
      "match": false
    }
  ],
  "fpNotes": "Public drop shares are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-676"
  ],
  "origin": "original-authored",
  "cell": "sast:samba-share:samba:mapguest",
  "validationStatus": "VALIDATED"
}
