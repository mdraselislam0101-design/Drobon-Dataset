{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0593",
  "title": "Signal: Privileged Compose service (net) — review required",
  "targets": [
    "compose"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:network_mode\\s*:\\s*[\"']?host)"
  },
  "scope": "Single-line lexical match on Compose files.",
  "limitations": "Lexical, line-based: matches the grant.",
  "examples": [
    {
      "line": "network_mode: host",
      "match": true
    },
    {
      "line": "# audit: network_mode: host present",
      "match": true
    },
    {
      "line": "network_mode: bridge",
      "match": false
    },
    {
      "line": "# verified: network_mode: bridge",
      "match": false
    }
  ],
  "fpNotes": "Node agents are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-476"
  ],
  "origin": "original-authored",
  "cell": "sast:compose-risk:compose:net",
  "validationStatus": "VALIDATED"
}
