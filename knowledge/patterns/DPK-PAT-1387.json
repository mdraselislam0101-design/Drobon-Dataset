{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1387",
  "title": "Signal: macOS .DS_Store metadata served from the web root",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "Bud1\\x00{0,8}"
    }
  },
  "scope": "One response body carrying the .DS_Store container header.",
  "limitations": "One response body. The check recognises the file container; it does not parse the entry names it holds.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/.DS_Store",
        "status": 200,
        "headers": {
          "Content-Type": "application/octet-stream"
        },
        "body": "Bud1\u0000\u0000\u0000\u0000\u0002\u0000\u0000\u0000"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/assets/.DS_Store",
        "status": 200,
        "headers": {
          "Content-Type": "application/octet-stream"
        },
        "body": "\u0000\u0000\u0000\u0001Bud1\u0000\u0000\u0000\b"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/.DS_Store",
        "status": 404,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>Not found</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/deploy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Our deploy step deletes .DS_Store before uploading.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that discusses .DS_Store is not reported unless the binary container header is present.",
  "linkedRules": [
    "DPK-DAST-318"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-ds-store-served:ds-store-header",
  "validationStatus": "VALIDATED"
}
