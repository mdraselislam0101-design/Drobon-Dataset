{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3152",
  "title": "Signal: Dependency expected from the container",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.dependencies[].scope",
      "valuePattern": "^provided$"
    }
  },
  "scope": "A pom.xml file that declares a dependency with `scope` `provided`.",
  "limitations": "It matches a dependency with `scope` `provided` in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "properties": {
            "maven.compiler.release": "21",
            "project.build.sourceEncoding": "UTF-8"
          },
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "jakarta.servlet",
              "artifactId": "jakarta.servlet-api",
              "version": "6.0.0",
              "scope": "provided"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
