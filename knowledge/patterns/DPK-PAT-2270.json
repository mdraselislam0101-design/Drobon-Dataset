{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2270",
  "title": "Signal: poetry.lock entry resolved from git",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "package[].source.type",
      "valuePattern": "^git$"
    }
  },
  "scope": "A poetry.lock file that declares a locked package whose source type is `git`.",
  "limitations": "It matches a locked package whose source type is `git` in the parsed poetry.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "acme-sdk",
            "version": "4.2.0",
            "files": [
              {
                "file": "acme-sdk-4.2.0.tar.gz",
                "hash": "sha256:aaaa"
              }
            ],
            "source": {
              "type": "git",
              "url": "https://github.com/acme/sdk.git",
              "resolved_reference": "9f2c4a1"
            }
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "acme-cli",
            "version": "2.1.0",
            "files": [
              {
                "file": "acme-cli-2.1.0.tar.gz",
                "hash": "sha256:aaaa"
              }
            ],
            "source": {
              "type": "git",
              "url": "https://github.com/acme/cli.git",
              "reference": "main"
            }
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "version": "2.32.3",
            "files": [
              {
                "file": "requests-2.32.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": false
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "acme-sdk",
            "version": "4.2.0",
            "files": [
              {
                "file": "acme-sdk-4.2.0.tar.gz",
                "hash": "sha256:aaaa"
              }
            ],
            "source": {
              "type": "legacy",
              "url": "https://pypi.acme.example/simple"
            }
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A poetry.lock that mentions a locked package whose source type is `git` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0133"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-poetry-lock-git-source",
  "validationStatus": "VALIDATED"
}
