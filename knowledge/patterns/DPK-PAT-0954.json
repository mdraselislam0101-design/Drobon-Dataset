{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0954",
  "title": "Signal: Cache-Control lacks the no-store directive",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-missing-directive",
      "header": "Cache-Control",
      "directive": "no-store"
    }
  },
  "scope": "Single response header: confirm no-store appears in Cache-Control.",
  "limitations": "Header check on every observed response: a page with no sensitive data fails it, and so does a response with no Cache-Control header at all. The scanner cannot tell which pages are sensitive.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cache-Control": "public, max-age=3600"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cache-Control": "no-store, max-age=0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Public static assets that are safe to cache are the common false positive.",
  "linkedRules": [
    "DPK-DAST-057"
  ],
  "origin": "original-authored",
  "cell": "dast:cache-no-store:no-store",
  "validationStatus": "VALIDATED"
}
