{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1430",
  "title": "Signal: Sentry console is reachable without authentication",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*__SENTRY__)(?=[\\s\\S]*sentry)"
    }
  },
  "scope": "One response body containing the Sentry application shell.",
  "limitations": "One response body. The rule recognises the Sentry shell; it does not read an event or a project.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/sentry/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Sentry</title><script>window.__SENTRY__={version:\"24.1.0\"}</script></head><body><div id=\"blk_1\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/sentry/organizations/shop/issues/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Issues · Sentry</title><script>window.__SENTRY__={}</script></head><body><div class=\"sentry-app\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Shop</title></head><body><p>Shop home</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/errors",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Error tracking</title></head><body><p>Events are grouped per issue.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that mentions Sentry in an integration guide is not reported, because the shell markup is required.",
  "linkedRules": [
    "DPK-DAST-361"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-console-sentry:sentry-console",
  "validationStatus": "VALIDATED"
}
