{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0380",
  "title": "Signal: TLS checks disabled (psql) — review required",
  "targets": [
    "shell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:sslmode\\s*=\\s*disable)"
  },
  "scope": "Single-line lexical match on TLS-disabling flags for psql.",
  "limitations": "Lexical, line-based: matches the flag regardless of environment.",
  "examples": [
    {
      "line": "sslmode=disable",
      "match": true
    },
    {
      "line": "# audit: sslmode=disable present",
      "match": true
    },
    {
      "line": "sslmode=require",
      "match": false
    },
    {
      "line": "# verified: sslmode=require",
      "match": false
    }
  ],
  "fpNotes": "Local bootstrap scripts are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-341"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-cli:shell:psql",
  "validationStatus": "VALIDATED"
}
