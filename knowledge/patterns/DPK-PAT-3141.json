{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3141",
  "title": "Signal: Package source backed by a folder",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "sources[].value",
      "valuePattern": "^file:"
    }
  },
  "scope": "A nuget.config file that declares a source value of the `file:` scheme.",
  "limitations": "It matches a source value of the `file:` scheme in the parsed nuget.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "local",
            "value": "file:///opt/nuget/packages"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "vendor",
            "value": "file:///mnt/vendor/feed"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": false
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "acme",
            "value": "https://nuget.acme.example/v3/index.json"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A nuget.config that mentions a source value of the `file:` scheme in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1004"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-file-source",
  "validationStatus": "VALIDATED"
}
