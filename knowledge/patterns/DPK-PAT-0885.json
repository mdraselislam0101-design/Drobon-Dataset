{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0885",
  "title": "Signal: Possible a Slack app token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "xapp-[A-Za-z0-9-]{20,}"
  },
  "scope": "Single-line shape match for a Slack app token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"xapp-AAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"xapp-AAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-097"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-2:slack-app",
  "validationStatus": "VALIDATED"
}
