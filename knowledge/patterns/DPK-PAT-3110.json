{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3110",
  "title": "Signal: Platform package faked for resolution",
  "targets": [
    "composer"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "config.platform.*",
      "valuePattern": "^false$"
    }
  },
  "scope": "A composer.json file that declares a `config.platform` entry that pretends an extension is absent.",
  "limitations": "It matches a `config.platform` entry that pretends an extension is absent in the parsed composer.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0",
            "ext-gd": false
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0",
            "ext-intl": "false"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": false
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A composer.json that mentions a `config.platform` entry that pretends an extension is absent in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0973"
  ],
  "origin": "original-authored",
  "cell": "sca:composer-platform-overrides",
  "validationStatus": "VALIDATED"
}
