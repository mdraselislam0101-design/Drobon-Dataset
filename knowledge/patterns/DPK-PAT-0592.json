{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0592",
  "title": "Signal: Shell expansion of a variable (varbash) — review required",
  "targets": [
    "shell"
  ],
  "signal": {
    "kind": "regex",
    "source": "bash\\s+-c\\s+\"\\$"
  },
  "scope": "Single-line lexical match on shell expansion (varbash).",
  "limitations": "Lexical, line-based: matches the expansion.",
  "examples": [
    {
      "line": "bash -c \"$CMD\"",
      "match": true
    },
    {
      "line": "# audit: bash -c \"$CMD\" present",
      "match": true
    },
    {
      "line": "bash -c \"ls\"",
      "match": false
    },
    {
      "line": "# verified: bash -c \"ls\"",
      "match": false
    }
  ],
  "fpNotes": "Trusted variables are the common false positive.",
  "linkedRules": [
    "DPK-SAST-475"
  ],
  "origin": "original-authored",
  "cell": "sast:cmd-var-expand:shell:varbash",
  "validationStatus": "VALIDATED"
}
