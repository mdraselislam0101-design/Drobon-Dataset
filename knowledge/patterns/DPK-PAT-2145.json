{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2145",
  "title": "Signal: Dependency installed over SSH from a git remote",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^git\\+ssh://"
    }
  },
  "scope": "A package.json file that declares a dependency installed from a git remote over SSH.",
  "limitations": "It matches a dependency installed from a git remote over SSH in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "git+ssh://git@github.com/acme/sdk.git"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-internal": "git+ssh://git@git.acme.internal/lib.git"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "git+https://github.com/acme/sdk.git"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "2.1.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A private registry that itself speaks SSH internally is out of scope: the rule looks at the manifest specifier only.",
  "linkedRules": [
    "DPK-SCA-0008"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-git-plus-ssh",
  "validationStatus": "VALIDATED"
}
