{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2302",
  "title": "Signal: Maven parent declared with a version range",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.parent.version",
      "valuePattern": "^\\["
    }
  },
  "scope": "A pom.xml file that declares a parent POM version written as a range.",
  "limitations": "It matches a parent POM version written as a range in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "parent": {
            "groupId": "com.acme",
            "artifactId": "platform-parent",
            "version": "[1.0,2.0)"
          }
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "parent": {
            "groupId": "com.acme",
            "artifactId": "service-parent",
            "version": "[4.0,)"
          }
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "parent": {
            "groupId": "com.acme",
            "artifactId": "platform-parent",
            "version": "1.4.0"
          }
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "parent": {
            "groupId": "com.acme",
            "artifactId": "service-parent",
            "version": "4.2.0"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pom.xml that mentions a parent POM version written as a range in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0165"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-parent-version-range",
  "validationStatus": "VALIDATED"
}
