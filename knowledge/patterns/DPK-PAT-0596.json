{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0596",
  "title": "Signal: Privileged Compose service (rootvol) — review required",
  "targets": [
    "compose"
  ],
  "signal": {
    "kind": "regex",
    "source": "-\\s+/:"
  },
  "scope": "Single-line lexical match on Compose files.",
  "limitations": "Lexical, line-based: matches the grant.",
  "examples": [
    {
      "line": "- /:/host",
      "match": true
    },
    {
      "line": "# audit: - /:/host present",
      "match": true
    },
    {
      "line": "- ./data:/data",
      "match": false
    },
    {
      "line": "# verified: - ./data:/data",
      "match": false
    }
  ],
  "fpNotes": "Node agents are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-479"
  ],
  "origin": "original-authored",
  "cell": "sast:compose-risk:compose:rootvol",
  "validationStatus": "VALIDATED"
}
