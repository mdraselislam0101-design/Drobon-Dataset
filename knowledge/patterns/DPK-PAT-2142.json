{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2142",
  "title": "Signal: Dependency declared with a wildcard minor",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^\\d{1,3}\\.\\*$"
    }
  },
  "scope": "A package.json file that declares an `N.*` minor wildcard, which accepts every minor and patch release of that major.",
  "limitations": "It matches an `N.*` minor wildcard, which accepts every minor and patch release of that major in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "d3": "7.*"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "three": "0.*"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "d3": "7.9.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "three": "0.168.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A caret range on the same major is a different declaration and is not reported.",
  "linkedRules": [
    "DPK-SCA-0005"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-wildcard-major-dot",
  "validationStatus": "VALIDATED"
}
