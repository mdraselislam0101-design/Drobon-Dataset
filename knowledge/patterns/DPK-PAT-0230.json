{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0230",
  "title": "Signal: Observability service left open (adminpass) — review required",
  "targets": [
    "grafana"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:admin_password\\s*=\\s*admin\\b)"
  },
  "scope": "Single-line lexical match on open settings (adminpass).",
  "limitations": "Lexical, line-based: matches the setting regardless of network scope.",
  "examples": [
    {
      "line": "admin_password = admin",
      "match": true
    },
    {
      "line": "# audit: admin_password = admin present",
      "match": true
    },
    {
      "line": "admin_password = $SECRET",
      "match": false
    },
    {
      "line": "# verified: admin_password = $SECRET",
      "match": false
    }
  ],
  "fpNotes": "Loopback-only instances are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-191"
  ],
  "origin": "original-authored",
  "cell": "sast:obs-services:grafana:adminpass",
  "validationStatus": "VALIDATED"
}
