{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2365",
  "title": "Signal: CocoaPods spec source declared over cleartext",
  "targets": [
    "cocoapods"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "sources[]",
      "valuePattern": "^http://"
    }
  },
  "scope": "A Podfile file that declares a Podfile source URL that uses cleartext http.",
  "limitations": "It matches a Podfile source URL that uses cleartext http in the parsed Podfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "http://cdn.cocoapods.acme.example/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": "~> 5.9"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "http://10.24.8.9/specs/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": "~> 5.9"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": "~> 5.9"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://specs.acme.example/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": "~> 5.9"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Podfile that mentions a Podfile source URL that uses cleartext http in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0228"
  ],
  "origin": "original-authored",
  "cell": "sca:podfile-cleartext-source",
  "validationStatus": "VALIDATED"
}
