{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0446",
  "title": "Signal: Debug or management exposure (graphql) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "introspection\\s*:\\s*true"
  },
  "scope": "Single-line lexical match on exposure settings (graphql).",
  "limitations": "Lexical, line-based: matches the exposure.",
  "examples": [
    {
      "line": "introspection: true",
      "match": true
    },
    {
      "line": "# audit: introspection: true present",
      "match": true
    },
    {
      "line": "introspection: false",
      "match": false
    },
    {
      "line": "# verified: introspection: false",
      "match": false
    }
  ],
  "fpNotes": "Internal-only services are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-407"
  ],
  "origin": "original-authored",
  "cell": "sast:web-exposure:javascript:graphql",
  "validationStatus": "VALIDATED"
}
