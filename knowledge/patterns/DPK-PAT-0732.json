{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0732",
  "title": "Signal: Dangerous PHP construct (extract) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "extract\\s*\\(\\s*\\$_"
  },
  "scope": "Single-line lexical match on dangerous constructs (extract).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "extract($_GET)",
      "match": true
    },
    {
      "line": "# audit: extract($_GET) present",
      "match": true
    },
    {
      "line": "extract($safe)",
      "match": false
    },
    {
      "line": "# verified: extract($safe)",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-615"
  ],
  "origin": "original-authored",
  "cell": "sast:php-flag:php:extract",
  "validationStatus": "VALIDATED"
}
