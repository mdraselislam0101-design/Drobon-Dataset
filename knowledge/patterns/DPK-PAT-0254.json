{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0254",
  "title": "Signal: File access built from input (scala) — review required",
  "targets": [
    "scala"
  ],
  "signal": {
    "kind": "regex",
    "source": "fromFile\\s*\\([^)]*\\+"
  },
  "scope": "Single-line lexical match on input-built paths in scala code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "Source.fromFile(dir + f)",
      "match": true
    },
    {
      "line": "# audit: Source.fromFile(dir + f) present",
      "match": true
    },
    {
      "line": "Source.fromFile(fixed)",
      "match": false
    },
    {
      "line": "# verified: Source.fromFile(fixed)",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-215"
  ],
  "origin": "original-authored",
  "cell": "sast:path-langs:scala",
  "validationStatus": "VALIDATED"
}
