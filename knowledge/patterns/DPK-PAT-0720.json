{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0720",
  "title": "Signal: File access built from input (fortran) — review required",
  "targets": [
    "fortran"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:FILE\\s*=\\s*[a-zA-Z])"
  },
  "scope": "Single-line lexical match on input-built paths in fortran code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "OPEN(1, FILE=fname)",
      "match": true
    },
    {
      "line": "# audit: OPEN(1, FILE=fname) present",
      "match": true
    },
    {
      "line": "OPEN(1, FILE=\"fixed\")",
      "match": false
    },
    {
      "line": "# verified: OPEN(1, FILE=\"fixed\")",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-603"
  ],
  "origin": "original-authored",
  "cell": "sast:path-3:fortran",
  "validationStatus": "VALIDATED"
}
