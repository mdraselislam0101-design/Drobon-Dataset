{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2351",
  "title": "Signal: Hex dependency declared without a requirement",
  "targets": [
    "hex"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "deps[].requirement",
      "valuePattern": "^$"
    }
  },
  "scope": "A mix.exs file that declares a `mix.exs` dependency with no version requirement.",
  "limitations": "It matches a `mix.exs` dependency with no version requirement in the parsed mix.exs; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "phoenix",
            "requirement": ""
          }
        ]
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "ecto",
            "requirement": ""
          },
          {
            "name": "phoenix",
            "requirement": "~> 1.7"
          }
        ]
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "phoenix",
            "requirement": "~> 1.7.10"
          }
        ]
      },
      "match": false
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "ecto",
            "requirement": "~> 3.11"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A mix.exs that mentions a `mix.exs` dependency with no version requirement in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0214"
  ],
  "origin": "original-authored",
  "cell": "sca:hex-dependency-unpinned",
  "validationStatus": "VALIDATED"
}
