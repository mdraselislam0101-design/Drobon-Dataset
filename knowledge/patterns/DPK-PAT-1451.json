{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1451",
  "title": "Signal: Gemfile.lock dependency lockfile served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*(?:^|\\n)GEM\\n)(?=[\\s\\S]*(?:^|\\n)  remote:)"
    }
  },
  "scope": "One response body containing a Bundler lockfile with its remote and resolved gems.",
  "limitations": "One response body. The rule reads the lockfile shape; it does not query a vulnerability database for the versions.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "GEM\n  remote: https://rubygems.org/\n  specs:\n    rails (7.1.3)\n    puma (6.4.2)\n\nPLATFORMS\n  ruby\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "GEM\n  remote: https://gems.internal/\n  specs:\n    shop-core (1.2.0)\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "source 'https://rubygems.org'\ngem 'rails', '7.1.3'\n"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/deploy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Deployment guide</title></head><body><p>Commit the lockfile and install with bundle install.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that quotes a lockfile fragment is reported when it reproduces the section header and the remote line.",
  "linkedRules": [
    "DPK-DAST-382"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-artefact-gemfile-lock:gemfile-lock-served",
  "validationStatus": "VALIDATED"
}
