{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1116",
  "title": "Signal: Operating-system command executed through :os.cmd in elixir — review required",
  "targets": [
    "elixir"
  ],
  "signal": {
    "kind": "regex",
    "source": ":os\\.cmd\\s*\\("
  },
  "scope": "Single-line match on :os.cmd in elixir.",
  "limitations": "Lexical: matches :os.cmd calls; System.cmd with separate arguments is out of scope and is the safer form.",
  "examples": [
    {
      "line": "result = :os.cmd(~c\"convert #{file} out.png\")",
      "match": true
    },
    {
      "line": "# audit: result = :os.cmd(~c\"convert #{file} out.png\") present",
      "match": true
    },
    {
      "line": "result = System.cmd(\"convert\", [file, \"out.png\"])",
      "match": false
    },
    {
      "line": "# verified: result = System.cmd(\"convert\", [file, \"out.png\"])",
      "match": false
    }
  ],
  "fpNotes": "Constant commands in release tooling are the accepted false positives.",
  "linkedRules": [
    "DPK-SAST-931"
  ],
  "origin": "original-authored",
  "cell": "sast:elixir-os-cmd:elixir",
  "validationStatus": "VALIDATED"
}
