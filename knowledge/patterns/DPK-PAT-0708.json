{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0708",
  "title": "Signal: Sensitive value in log call (nim) — review required",
  "targets": [
    "nim"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:echo\\s+[^\\n]*(?:password|passwd|secret|token))"
  },
  "scope": "Single-line lexical match on credential-named log values in nim code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "echo \"password=\", p",
      "match": true
    },
    {
      "line": "# audit: echo \"password=\", p present",
      "match": true
    },
    {
      "line": "echo \"user=\", u",
      "match": false
    },
    {
      "line": "# verified: echo \"user=\", u",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-591"
  ],
  "origin": "original-authored",
  "cell": "sast:log-4:nim",
  "validationStatus": "VALIDATED"
}
