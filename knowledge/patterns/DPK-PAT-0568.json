{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0568",
  "title": "Signal: Missing Report-To response header",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "missing-response-header",
      "header": "Report-To"
    }
  },
  "scope": "Single response: confirm the header is absent.",
  "limitations": "Header-name check on one response. It cannot tell whether reporting is configured by another mechanism, and it does not validate the endpoint.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Report-To": "{\"group\":\"x\"}"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "Report-To": "{\"group\":\"x\"}"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Non-browser endpoints are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-043"
  ],
  "origin": "original-authored",
  "cell": "dast:header-missing-2:reportto",
  "validationStatus": "VALIDATED"
}
