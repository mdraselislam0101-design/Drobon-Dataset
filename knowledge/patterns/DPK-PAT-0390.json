{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0390",
  "title": "Signal: TLS verification weakened (chef) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "ssl_verify_mode\\s+:verify_none"
  },
  "scope": "Single-line lexical match on TLS-weakening settings for chef.",
  "limitations": "Lexical, line-based: matches the setting regardless of environment.",
  "examples": [
    {
      "line": "ssl_verify_mode :verify_none",
      "match": true
    },
    {
      "line": "# audit: ssl_verify_mode :verify_none present",
      "match": true
    },
    {
      "line": "ssl_verify_mode :verify_peer",
      "match": false
    },
    {
      "line": "# verified: ssl_verify_mode :verify_peer",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-351"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-verify-off-extra:ruby:chef",
  "validationStatus": "VALIDATED"
}
