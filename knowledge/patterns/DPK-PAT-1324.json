{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1324",
  "title": "Signal: Expires header is not a valid HTTP date",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Expires",
      "valuePattern": "^\\s*(?![A-Za-z]{3}, \\d{2} [A-Za-z]{3} \\d{4} \\d{2}:\\d{2}:\\d{2} GMT\\s*$)\\S"
    }
  },
  "scope": "One response whose Expires value is not an HTTP date.",
  "limitations": "One header value. The rule validates the date shape only; it does not compute the freshness lifetime a cache would derive.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Expires": "0"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Expires": "-1"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Expires": "Thu, 01 Jan 1970 00:00:00 GMT"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cache-Control": "no-store"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A response with no Expires header is not reported; the rule needs the malformed value.",
  "linkedRules": [
    "DPK-DAST-255"
  ],
  "origin": "original-authored",
  "cell": "dast:expires-invalid-date:invalid-date",
  "validationStatus": "VALIDATED"
}
