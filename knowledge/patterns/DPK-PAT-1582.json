{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1582",
  "title": "Signal: Card verification value rendered into a form field",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<input(?=[^>]{0,200}(?:name|id)\\s*=\\s*[\\\"'][^\\\"']{0,40}(?:cvv|cvc|security[_-]?code)[^\\\"']{0,40}[\\\"'])(?=[^>]{0,200}value\\s*=\\s*[\\\"'][0-9]{3,4}[\\\"'])"
    }
  },
  "scope": "An input whose name or id is cvv, cvc or security code and whose value is three or four digits.",
  "limitations": "One response body and the input value shape only. A CVV typed by the customer into an empty field is not a finding.",
  "examples": [
    {
      "observation": {
        "url": "https://bank.example/cards/8842/edit",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<label>CVV</label><input type=\"text\" name=\"cvv\" value=\"812\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/cards/retry",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<input id=\"security_code\" value=\"4412\" type=\"tel\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/cards/8842/edit",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<label>CVV</label><input type=\"text\" name=\"cvv\" value=\"\" autocomplete=\"off\">"
      },
      "match": false
    }
  ],
  "fpNotes": "A masked placeholder such as value=\"***\" is not reported, because the pattern requires digits.",
  "linkedRules": [
    "DPK-DAST-513"
  ],
  "origin": "original-authored",
  "cell": "dast:bank-cvv-field-with-value:bank-cvv-field-with-value",
  "validationStatus": "VALIDATED"
}
