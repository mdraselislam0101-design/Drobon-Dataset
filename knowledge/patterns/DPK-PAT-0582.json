{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0582",
  "title": "Signal: OS command execution via SHELL (basic) — review required",
  "targets": [
    "basic"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:SHELL)\\s*\\("
  },
  "scope": "Single-line lexical match on the SHELL call in basic code.",
  "limitations": "Lexical, line-based: any SHELL call matches.",
  "examples": [
    {
      "line": "SHELL(payload)",
      "match": true
    },
    {
      "line": "out = SHELL(data)",
      "match": true
    },
    {
      "line": "mySHELL(x)",
      "match": false
    },
    {
      "line": "SHELL_safe()",
      "match": false
    }
  ],
  "fpNotes": "Fixed maintenance commands are the common false positive.",
  "linkedRules": [
    "DPK-SAST-465"
  ],
  "origin": "original-authored",
  "cell": "sast:cmd-exec-3:basic",
  "validationStatus": "VALIDATED"
}
