{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0578",
  "title": "Signal: Unbounded buffer call alloca (c) — review required",
  "targets": [
    "c"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:alloca)\\s*\\("
  },
  "scope": "Single-line lexical match on the alloca call in c code.",
  "limitations": "Lexical, line-based: any alloca call matches.",
  "examples": [
    {
      "line": "alloca(payload)",
      "match": true
    },
    {
      "line": "out = alloca(data)",
      "match": true
    },
    {
      "line": "myalloca(x)",
      "match": false
    },
    {
      "line": "alloca_safe()",
      "match": false
    }
  ],
  "fpNotes": "Fixed small inputs are the common false positive.",
  "linkedRules": [
    "DPK-SAST-461"
  ],
  "origin": "original-authored",
  "cell": "sast:buffer-call:c:alloca",
  "validationStatus": "VALIDATED"
}
