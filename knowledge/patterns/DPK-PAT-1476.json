{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1476",
  "title": "Signal: Rails web-console rendered in a page",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*web-console)(?=[\\s\\S]*data-console-bindings)"
    }
  },
  "scope": "One response body containing the Rails web-console container and its binding marker.",
  "limitations": "One response body. The rule reports the console container; it does not send an expression to it.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/orders/1",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h2>NoMethodError</h2><div id=\"console\" data-console-bindings=\"{&quot;session_id&quot;:&quot;abc&quot;}\"><pre>web-console</pre></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/checkout",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<div class=\"console\" data-console-bindings=\"{}\"><span>web-console</span></div>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/orders/1",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Something went wrong</h1></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Rails guide</title></head><body><p>web-console is installed for the development group only.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that names web-console in prose is not reported, because the container and binding markers are both required.",
  "linkedRules": [
    "DPK-DAST-407"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-debug-rails-web-console:rails-web-console",
  "validationStatus": "VALIDATED"
}
