{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0816",
  "title": "Signal: Weak SSH daemon setting (tunnel) — review required",
  "targets": [
    "sshd"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:PermitTunnel\\s+yes)"
  },
  "scope": "Single-line lexical match on sshd settings.",
  "limitations": "Lexical, line-based: matches the setting regardless of Match blocks.",
  "examples": [
    {
      "line": "PermitTunnel yes",
      "match": true
    },
    {
      "line": "# audit: PermitTunnel yes present",
      "match": true
    },
    {
      "line": "PermitTunnel no",
      "match": false
    },
    {
      "line": "# verified: PermitTunnel no",
      "match": false
    }
  ],
  "fpNotes": "Bastion-specific needs are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-699"
  ],
  "origin": "original-authored",
  "cell": "sast:sshd-strict:sshd:tunnel",
  "validationStatus": "VALIDATED"
}
