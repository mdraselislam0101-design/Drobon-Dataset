{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2931",
  "title": "Signal: Lockfile generation switched off",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "package-lock",
      "valuePattern": "^false$"
    }
  },
  "scope": "A .npmrc file that declares a `package-lock=false` setting.",
  "limitations": "It matches a `package-lock=false` setting in the parsed .npmrc; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true",
        "package-lock": "false"
      },
      "match": true
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true",
        "package-lock": false
      },
      "match": true
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true",
        "package-lock": "true"
      },
      "match": false
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true",
        "package-lock": true
      },
      "match": false
    }
  ],
  "fpNotes": "A .npmrc that mentions a `package-lock=false` setting in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0794"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-config-package-lock-off",
  "validationStatus": "VALIDATED"
}
