{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1278",
  "title": "Signal: Link header names a script or data URL",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Link",
      "valuePattern": "<\\s*(?:javascript|data):"
    }
  },
  "scope": "One response whose Link header contains a target beginning with a script or data scheme.",
  "limitations": "One header value. The rule reports the scheme in the Link target; it does not prove the browser acted on the hint or that the target is attacker-controlled.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Link": "<javascript:alert(1)>; rel=preload"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Link": "<data:text/html;base64,PHNjcmlwdD4=>; rel=preload; as=document"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Link": "<https://cdn.example/app.js>; rel=preload; as=script"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Link": "<http://cdn.example/app.css>; rel=stylesheet"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "The rule reads the target scheme only; whether the resource was actually fetched is not observable.",
  "linkedRules": [
    "DPK-DAST-209"
  ],
  "origin": "original-authored",
  "cell": "dast:link-non-web-scheme:non-web-scheme",
  "validationStatus": "VALIDATED"
}
