{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0387",
  "title": "Signal: TLS verification weakened (proxy) — review required",
  "targets": [
    "nginx"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:proxy_ssl_verify\\s+off)"
  },
  "scope": "Single-line lexical match on TLS-weakening settings for proxy.",
  "limitations": "Lexical, line-based: matches the setting regardless of environment.",
  "examples": [
    {
      "line": "proxy_ssl_verify off;",
      "match": true
    },
    {
      "line": "# audit: proxy_ssl_verify off; present",
      "match": true
    },
    {
      "line": "proxy_ssl_verify on;",
      "match": false
    },
    {
      "line": "# verified: proxy_ssl_verify on;",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-348"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-verify-off-extra:nginx:proxy",
  "validationStatus": "VALIDATED"
}
