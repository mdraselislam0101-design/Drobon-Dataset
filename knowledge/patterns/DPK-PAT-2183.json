{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2183",
  "title": "Signal: Lockfile resolves packages from a third-party registry host",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.resolved",
      "valuePattern": "^https://(?!registry\\.npmjs\\.org)[a-z0-9.-]{3,80}/"
    }
  },
  "scope": "A package-lock.json file that declares a lockfile entry served by a host other than the configured public registry.",
  "limitations": "It matches a lockfile entry served by a host other than the configured public registry in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://artifacts.acme.example/x/-/x-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "resolved": "https://npm-mirror.thirdparty.example/y/-/y-2.0.0.tgz"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org/x/-/x-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "resolved": "https://registry.npmjs.org/y/-/y-2.0.0.tgz"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "An internal Artifactory mirror is a deliberate configuration; record it as an accepted exception with its integrity policy.",
  "linkedRules": [
    "DPK-SCA-0046"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-resolved-non-registry-host",
  "validationStatus": "VALIDATED"
}
