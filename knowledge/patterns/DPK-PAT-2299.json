{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2299",
  "title": "Signal: Maven repository declared over cleartext",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.repositories[].url",
      "valuePattern": "^http://"
    }
  },
  "scope": "A pom.xml file that declares a repository URL that uses cleartext http.",
  "limitations": "It matches a repository URL that uses cleartext http in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "repositories": [
            {
              "id": "acme",
              "url": "http://repo.acme.example/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "repositories": [
            {
              "id": "mirror",
              "url": "http://10.24.8.9/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "repositories": [
            {
              "id": "acme",
              "url": "https://repo.acme.example/maven2"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo.maven.apache.org/maven2"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pom.xml that mentions a repository URL that uses cleartext http in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0162"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-repository-cleartext",
  "validationStatus": "VALIDATED"
}
