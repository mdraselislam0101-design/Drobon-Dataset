{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2310",
  "title": "Signal: Gradle dependency declared with a latest-version selector",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies[].notation",
      "valuePattern": ":latest\\.\\w+$"
    }
  },
  "scope": "A build.gradle file that declares a `latest.release` or `latest.integration` selector.",
  "limitations": "It matches a `latest.release` or `latest.integration` selector in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mavenCentral",
            "url": "https://repo.maven.apache.org/maven2"
          }
        ],
        "dependencies": [
          {
            "configuration": "implementation",
            "notation": "com.acme:internal-core:latest.release"
          }
        ]
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mavenCentral",
            "url": "https://repo.maven.apache.org/maven2"
          }
        ],
        "dependencies": [
          {
            "configuration": "testImplementation",
            "notation": "org.example:lib:latest.integration"
          }
        ]
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mavenCentral",
            "url": "https://repo.maven.apache.org/maven2"
          }
        ],
        "dependencies": [
          {
            "configuration": "implementation",
            "notation": "com.acme:internal-core:1.4.2"
          }
        ]
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mavenCentral",
            "url": "https://repo.maven.apache.org/maven2"
          }
        ],
        "dependencies": [
          {
            "configuration": "implementation",
            "notation": "org.example:lib:2.0.1"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A build.gradle that mentions a `latest.release` or `latest.integration` selector in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0173"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-latest-version",
  "validationStatus": "VALIDATED"
}
