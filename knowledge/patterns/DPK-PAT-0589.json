{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0589",
  "title": "Signal: OS command execution via Process (scala) — review required",
  "targets": [
    "scala"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Process)\\s*\\("
  },
  "scope": "Single-line lexical match on the Process call in scala code.",
  "limitations": "Lexical, line-based: any Process call matches.",
  "examples": [
    {
      "line": "Process(payload)",
      "match": true
    },
    {
      "line": "out = Process(data)",
      "match": true
    },
    {
      "line": "myProcess(x)",
      "match": false
    },
    {
      "line": "Process_safe()",
      "match": false
    }
  ],
  "fpNotes": "Fixed maintenance commands are the common false positive.",
  "linkedRules": [
    "DPK-SAST-472"
  ],
  "origin": "original-authored",
  "cell": "sast:cmd-exec-3:scala",
  "validationStatus": "VALIDATED"
