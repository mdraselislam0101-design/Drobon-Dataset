{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2150",
  "title": "Signal: Dependency declared with a bare owner/repo shorthand",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^[A-Za-z0-9._-]{1,39}/[A-Za-z0-9._-]{1,64}(?:#[^ ]{1,64})?$"
    }
  },
  "scope": "A package.json file that declares a bare `owner/repo` specifier, which npm expands to a GitHub install.",
  "limitations": "It matches a bare `owner/repo` specifier, which npm expands to a GitHub install in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "acme/sdk"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "acme/sdk#v4.2.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "@acme/sdk": "^4.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A scoped registry name such as `@acme/sdk` is a package name, not a shorthand, and is not reported.",
  "linkedRules": [
    "DPK-SCA-0013"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-user-repo-shorthand",
  "validationStatus": "VALIDATED"
}
