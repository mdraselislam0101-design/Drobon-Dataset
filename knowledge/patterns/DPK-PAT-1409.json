{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1409",
  "title": "Signal: Mercurial .hg/hgrc file served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*(?:^|\\n)\\[paths\\]\\s*(?:\\n|$))(?=[\\s\\S]*(?:^|\\n)default\\s*=)"
    }
  },
  "scope": "One response body containing a Mercurial configuration with a paths section.",
  "limitations": "One response body. The rule reads the configuration shape; it does not contact the repository it names.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/.hg/hgrc",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "[paths]\ndefault = ssh://hg.internal/shop\n[web]\nallow_push = *\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/.hg/hgrc",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "[paths]\ndefault = https://hg.internal/shop\n[ui]\nusername = deploy\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/.git/config",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "[core]\n\trepositoryformatversion = 0\n[remote \"origin\"]\n\turl = https://git.internal/shop.git\n"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/deploy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "Set the default path in the [paths] section of your hgrc."
      },
      "match": false
    }
  ],
  "fpNotes": "A page that quotes an hgrc sample is reported when it reproduces the section header and a default path; a git config is covered by its own rule.",
  "linkedRules": [
    "DPK-DAST-340"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-artefact-hg-hgrc:hg-hgrc",
  "validationStatus": "VALIDATED"
}
