{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0784",
  "title": "Signal: Dynamic evaluation via ERB.new (ruby) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:ERB\\.new)\\s*\\("
  },
  "scope": "Single-line lexical match on the ERB.new call in ruby code.",
  "limitations": "Lexical, line-based: any ERB.new call matches.",
  "examples": [
    {
      "line": "ERB.new(payload)",
      "match": true
    },
    {
      "line": "out = ERB.new(data)",
      "match": true
    },
    {
      "line": "myERBnew(x)",
      "match": false
    },
    {
      "line": "ERB.new_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted templates are the common false positive.",
  "linkedRules": [
    "DPK-SAST-667"
  ],
  "origin": "original-authored",
  "cell": "sast:ruby-call:ruby:erb",
  "validationStatus": "VALIDATED"
}
