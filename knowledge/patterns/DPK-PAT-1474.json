{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1474",
  "title": "Signal: Next.js development build served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*/_next/static/development/)(?=[\\s\\S]*__NEXT_DATA__)"
    }
  },
  "scope": "One response body referencing the Next.js development chunk path together with the page data marker.",
  "limitations": "One response body. The rule reports the development chunk path; it does not fetch a source map from it.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"__next\"></div><script src=\"/_next/static/development/_buildManifest.js\"></script><script id=\"__NEXT_DATA__\" type=\"application/json\">{\"page\":\"/shop\"}</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/cart",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<script src=\"/_next/static/development/_ssgManifest.js\"></script><script id=\"__NEXT_DATA__\" type=\"application/json\">{}</script>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"__next\"></div><script src=\"/_next/static/chunks/main-1f2a3b.js\"></script><script id=\"__NEXT_DATA__\" type=\"application/json\">{\"page\":\"/shop\"}</script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Deployment guide</title></head><body><p>Run next build before deploying.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A production page that references hashed production chunks is not reported, because the development path segment is required.",
  "linkedRules": [
    "DPK-DAST-405"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-debug-nextjs-development-build:nextjs-development-build",
  "validationStatus": "VALIDATED"
}
