{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1464",
  "title": "Signal: Prefect UI is reachable without authentication",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<title>[^<]{0,60}Prefect"
    }
  },
  "scope": "One response body containing the Prefect UI shell.",
  "limitations": "One response body. The rule reports the UI shell; it does not start a flow.",
  "examples": [
    {
      "observation": {
        "url": "https://flows.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Prefect</title></head><body><div id=\"app\" data-server=\"prefect\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://flows.example/runs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Prefect · Flow runs</title></head><body><p>12 successful runs</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Orchestration guide</title></head><body><p>Start the server with prefect server start.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/jobs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Jobs</title></head><body><p>All jobs completed.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that names Prefect in prose is not reported, because the shell marker is required.",
  "linkedRules": [
    "DPK-DAST-395"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-console-prefect:prefect-ui",
  "validationStatus": "VALIDATED"
}
