{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0605",
  "title": "Signal: Dangerous .NET construct (customerrors) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "customErrors\\s+mode\\s*=\\s*[\"']?Off"
  },
  "scope": "Single-line lexical match on .NET constructs (customerrors).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "customErrors mode=\"Off\"",
      "match": true
    },
    {
      "line": "# audit: customErrors mode=\"Off\" present",
      "match": true
    },
    {
      "line": "customErrors mode=\"RemoteOnly\"",
      "match": false
    },
    {
      "line": "# verified: customErrors mode=\"RemoteOnly\"",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-488"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-flag:csharp:customerrors",
  "validationStatus": "VALIDATED"
}
