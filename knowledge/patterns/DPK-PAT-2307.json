{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2307",
  "title": "Signal: Gradle repository declared over cleartext",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "repositories[].url",
      "valuePattern": "^http://"
    }
  },
  "scope": "A build.gradle file that declares a repository URL that uses cleartext http.",
  "limitations": "It matches a repository URL that uses cleartext http in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "acme",
            "url": "http://repo.acme.example/maven2"
          }
        ],
        "dependencies": []
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mirror",
            "url": "http://10.24.8.9/maven2"
          }
        ],
        "dependencies": []
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "acme",
            "url": "https://repo.acme.example/maven2"
          }
        ],
        "dependencies": []
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mavenCentral",
            "url": "https://repo.maven.apache.org/maven2"
          }
        ],
        "dependencies": []
      },
      "match": false
    }
  ],
  "fpNotes": "A build.gradle that mentions a repository URL that uses cleartext http in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0170"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-repository-cleartext",
  "validationStatus": "VALIDATED"
}
