{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1193",
  "title": "Signal: Internal backend hostname disclosed (X-Backend-Server header)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-Backend-Server",
      "valuePattern": "^\\s*\\S"
    }
  },
  "scope": "One response that carries a non-empty X-Backend-Server header.",
  "limitations": "One header value. The rule reports the header content; it cannot tell whether the named host is reachable from the internet or what runs on it.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Backend-Server": "app-prod-07.internal"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 502,
        "headers": {
          "X-Backend-Server": "app-prod-07"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Backend-Server": "   "
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Powered-By": "Express"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A load balancer that deliberately publishes a pool name is reported; the value still describes internal topology.",
  "linkedRules": [
    "DPK-DAST-124"
  ],
  "origin": "original-authored",
  "cell": "dast:banner-x-backend-server:x-backend-server",
  "validationStatus": "VALIDATED"
}
