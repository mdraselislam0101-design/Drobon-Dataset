{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2873",
  "title": "Signal: Pubspec that targets a non-default publication endpoint",
  "targets": [
    "pub"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "publish_to",
      "valuePattern": "^(?!none$).+$"
    }
  },
  "scope": "A pubspec.yaml file that declares a `publish_to` value that is not `none`.",
  "limitations": "It matches a `publish_to` value that is not `none` in the parsed pubspec.yaml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "https://pub.acme.example",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": true
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "https://pub.dev",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": true
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": false
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A pubspec.yaml that mentions a `publish_to` value that is not `none` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0736"
  ],
  "origin": "original-authored",
  "cell": "sca:pub-publish-to-set",
  "validationStatus": "VALIDATED"
}
