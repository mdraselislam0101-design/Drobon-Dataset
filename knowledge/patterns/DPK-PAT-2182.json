{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2182",
  "title": "Signal: Lockfile resolves a package over cleartext HTTP",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.resolved",
      "valuePattern": "^http://"
    }
  },
  "scope": "A package-lock.json file that declares a lockfile entry that resolves its tarball over cleartext http.",
  "limitations": "It matches a lockfile entry that resolves its tarball over cleartext http in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "http://registry.acme.example/x/-/x-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "resolved": "http://mirror.acme.example/y/-/y-2.0.0.tgz"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org/x/-/x-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "resolved": "https://registry.npmjs.org/y/-/y-2.0.0.tgz"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A local mirror on loopback is still reported; record it as an accepted exception if that is the policy.",
  "linkedRules": [
    "DPK-SCA-0045"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-resolved-http",
  "validationStatus": "VALIDATED"
}
