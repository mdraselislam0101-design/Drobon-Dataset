{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2192",
  "title": "Signal: Lockfile records a dependency the registry marks deprecated",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.deprecated",
      "valuePattern": "^\\S"
    }
  },
  "scope": "A package-lock.json file that declares a package entry that carries a deprecation notice.",
  "limitations": "It matches a package entry that carries a deprecation notice in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "deprecated": "no longer maintained"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "deprecated": "use the successor package"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A deprecated package kept deliberately for compatibility is still reported; the notice is the finding.",
  "linkedRules": [
    "DPK-SCA-0055"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-deprecated-entry",
  "validationStatus": "VALIDATED"
}
