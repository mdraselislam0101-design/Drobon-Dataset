{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0054",
  "title": "Signal: Weak Strict-Transport-Security max-age header value",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Strict-Transport-Security",
      "valuePattern": "max-age\\s*=\\s*\"[^\"\\n]*\"|max-age\\s*=\\s*(?:[0-9]{1,7}|1[0-9]{7}|2[0-9]{7}|30[0-9]{6}|31[0-4][0-9]{5}|315[0-2][0-9]{4}|3153[0-5][0-9]{3})\\b"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Value check on one header value. It cannot see how the client parsed it: the quoted shape is discarded by a strict parser, which is closer in effect to a missing header (DPK-DAST-016) than to a short duration.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=86400"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=1000; includeSubDomains"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=10000000"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31535999"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=36000000; includeSubDomains"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=\"300\""
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=\"31536000\""
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=\"86400\"; includeSubDomains"
        }
      },
      "match": true
    }
  ],
  "fpNotes": "Transitional deployments are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-024"
  ],
  "origin": "original-authored",
  "cell": "dast:header-weak:hsts-short",
  "validationStatus": "VALIDATED"
}
