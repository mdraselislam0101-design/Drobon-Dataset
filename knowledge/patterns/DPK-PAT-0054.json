{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0054",
  "title": "Signal: Weak Strict-Transport-Security max-age header value",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Strict-Transport-Security",
      "valuePattern": "max-age\\s*=\\s*[0-9]{1,7}\\b"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Value check: it cannot confirm the deployment context.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=86400"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=1000; includeSubDomains"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "Transitional deployments are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-024"
  ],
  "origin": "original-authored",
  "cell": "dast:header-weak:hsts-short",
  "validationStatus": "VALIDATED"
}
