{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0353",
  "title": "Signal: Weak service hardening (imtcp) — review required",
  "targets": [
    "rsyslog"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\$ModLoad\\s+imtcp"
  },
  "scope": "Single-line lexical match on weak settings (imtcp).",
  "limitations": "Lexical, line-based: matches the setting regardless of host trust.",
  "examples": [
    {
      "line": "$ModLoad imtcp",
      "match": true
    },
    {
      "line": "# audit: $ModLoad imtcp present",
      "match": true
    },
    {
      "line": "$ModLoad imptcp",
      "match": false
    },
    {
      "line": "# verified: $ModLoad imptcp",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-314"
  ],
  "origin": "original-authored",
  "cell": "sast:sys-services:rsyslog:imtcp",
  "validationStatus": "VALIDATED"
}
