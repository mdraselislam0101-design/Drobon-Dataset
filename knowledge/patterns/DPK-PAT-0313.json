{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0313",
  "title": "Signal: tls left open (vault) — review required",
  "targets": [
    "vault"
  ],
  "signal": {
    "kind": "regex",
    "source": "tls_disable\\s*=\\s*1"
  },
  "scope": "Single-line lexical match on open settings for tls.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "tls_disable = 1",
      "match": true
    },
    {
      "line": "# audit: tls_disable = 1 present",
      "match": true
    },
    {
      "line": "tls_disable = 0",
      "match": false
    },
    {
      "line": "# verified: tls_disable = 0",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-274"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:vault:tls",
  "validationStatus": "VALIDATED"
}
