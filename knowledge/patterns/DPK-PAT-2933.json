{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2933",
  "title": "Signal: Yarn registry configured over cleartext",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "npmRegistryServer",
      "valuePattern": "^http://"
    }
  },
  "scope": "A .yarnrc.yml file that declares an `npmRegistryServer` URL over cleartext.",
  "limitations": "It matches an `npmRegistryServer` URL over cleartext in the parsed .yarnrc.yml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": ".yarnrc.yml",
      "document": {
        "npmRegistryServer": "http://npm.acme.example",
        "enableStrictSsl": "true",
        "enableImmutableInstalls": "true",
        "nodeLinker": "node-modules"
      },
      "match": true
    },
    {
      "file": ".yarnrc.yml",
      "document": {
        "npmRegistryServer": "http://10.24.8.9",
        "enableStrictSsl": "true",
        "enableImmutableInstalls": "true",
        "nodeLinker": "node-modules"
      },
      "match": true
    },
    {
      "file": ".yarnrc.yml",
      "document": {
        "npmRegistryServer": "https://registry.yarnpkg.com",
        "enableStrictSsl": "true",
        "enableImmutableInstalls": "true",
        "nodeLinker": "node-modules"
      },
      "match": false
    },
    {
      "file": ".yarnrc.yml",
      "document": {
        "npmRegistryServer": "https://npm.acme.example",
        "enableStrictSsl": "true",
        "enableImmutableInstalls": "true",
        "nodeLinker": "node-modules"
      },
      "match": false
    }
  ],
  "fpNotes": "A .yarnrc.yml that mentions an `npmRegistryServer` URL over cleartext in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0796"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-yarn-registry-cleartext",
  "validationStatus": "VALIDATED"
}
