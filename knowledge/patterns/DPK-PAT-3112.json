{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3112",
  "title": "Signal: Gem pinned to a branch",
  "targets": [
    "rubygems"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "gems[].branch",
      "valuePattern": "^.+$"
    }
  },
  "scope": "A Gemfile file that declares a gem from git whose ref is a branch name.",
  "limitations": "It matches a gem from git whose ref is a branch name in the parsed Gemfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "acme-core",
            "git": "https://github.com/acme/core",
            "branch": "main"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "acme-sdk",
            "git": "https://github.com/acme/sdk",
            "branch": "develop"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "acme-core",
            "git": "https://github.com/acme/core",
            "ref": "9f2c3d4e5f60"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "requirement": "~> 7.1"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Gemfile that mentions a gem from git whose ref is a branch name in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0975"
  ],
  "origin": "original-authored",
  "cell": "sca:gemfile-git-stub",
  "validationStatus": "VALIDATED"
}
