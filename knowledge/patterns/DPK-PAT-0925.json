{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0925",
  "title": "Signal: Value-carrying external call (solidity) — review required",
  "targets": [
    "solidity"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.call\\s*\\{\\s*value\\s*:"
  },
  "scope": "Single-line lexical match on value-carrying calls in solidity code.",
  "limitations": "Lexical, line-based: every value-carrying call matches. Re-entry needs control-flow review.",
  "examples": [
    {
      "line": "(bool ok, ) = msg.sender.call{value: amount}(\"\");",
      "match": true
    },
    {
      "line": "# audit: (bool ok, ) = msg.sender.call{value: amount}(\"\"); present",
      "match": true
    },
    {
      "line": "token.transfer(msg.sender, amount);",
      "match": false
    },
    {
      "line": "# verified: token.transfer(msg.sender, amount);",
      "match": false
    }
  ],
  "fpNotes": "Calls to trusted, fixed recipients are the common false positive.",
  "linkedRules": [
    "DPK-SAST-769"
  ],
  "origin": "original-authored",
  "cell": "sast:value-call-reentrancy:solidity",
  "validationStatus": "VALIDATED"
}
