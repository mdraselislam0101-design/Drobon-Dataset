{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0459",
  "title": "Signal: Unescaped template output (angular, javascript) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\[innerHTML\\]"
  },
  "scope": "Single-line lexical match on unescaped output in angular templates.",
  "limitations": "Lexical, line-based: matches the construct regardless of value trust.",
  "examples": [
    {
      "line": "<div [innerHTML]=\"x\">",
      "match": true
    },
    {
      "line": "# audit: <div [innerHTML]=\"x\"> present",
      "match": true
    },
    {
      "line": "<div>{{x}}</div>",
      "match": false
    },
    {
      "line": "# verified: <div>{{x}}</div>",
      "match": false
    }
  ],
  "fpNotes": "Trusted constant markup is the common false positive.",
  "linkedRules": [
    "DPK-SAST-420"
  ],
  "origin": "original-authored",
  "cell": "sast:xss-templates:javascript:angular",
  "validationStatus": "VALIDATED"
}
