{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2164",
  "title": "Signal: Dependency pinned to a prerelease build",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}-(?:alpha|beta|rc|next|canary|preview|dev)\\b"
    }
  },
  "scope": "A package.json file that declares an exact pin to a prerelease build.",
  "limitations": "It matches an exact pin to a prerelease build in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.0.0-rc.1"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "2.1.0-beta.3"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.0.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "^4.0.0-rc.1"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A range that merely permits a prerelease is a different declaration and is not reported here.",
  "linkedRules": [
    "DPK-SCA-0027"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-prerelease-pin",
  "validationStatus": "VALIDATED"
}
