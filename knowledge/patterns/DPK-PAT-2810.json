{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2810",
  "title": "Signal: Centralised dependency repositories include a cleartext endpoint",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencyResolutionManagement.repositories[].url",
      "valuePattern": "^http://"
    }
  },
  "scope": "A settings.gradle file that declares a `dependencyResolutionManagement` repository URL over cleartext.",
  "limitations": "It matches a `dependencyResolutionManagement` repository URL over cleartext in the parsed settings.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "acme",
              "url": "http://repo.acme.example/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "internal",
              "url": "http://10.24.8.9/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": []
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A settings.gradle that mentions a `dependencyResolutionManagement` repository URL over cleartext in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0673"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-dependency-resolution-cleartext",
  "validationStatus": "VALIDATED"
}
