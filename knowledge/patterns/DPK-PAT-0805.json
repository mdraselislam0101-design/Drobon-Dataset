{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0805",
  "title": "Signal: SQL built by concatenation (erlang) — review required",
  "targets": [
    "erlang"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:sql_query\\s*\\([^)]*\\+\\+)"
  },
  "scope": "Single-line lexical match on assembled SQL in erlang code.",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "sql_query(c, \"SELECT \" ++ q)",
      "match": true
    },
    {
      "line": "# audit: sql_query(c, \"SELECT \" ++ q) present",
      "match": true
    },
    {
      "line": "sql_query(c, FIXED)",
      "match": false
    },
    {
      "line": "# verified: sql_query(c, FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-688"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-4:erlang",
  "validationStatus": "VALIDATED"
}
