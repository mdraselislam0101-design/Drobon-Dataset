{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2191",
  "title": "Signal: Lockfile records a bundled dependency",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.inBundle",
      "valuePattern": "^true$"
    }
  },
  "scope": "A package-lock.json file that declares a package entry that ships inside another dependency's tarball.",
  "limitations": "It matches a package entry that ships inside another dependency's tarball in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "inBundle": true
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "inBundle": true,
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "inBundle": false
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A vendored runtime that cannot be published is still reported; the bundle is the finding.",
  "linkedRules": [
    "DPK-SCA-0054"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-bundled-dependency",
  "validationStatus": "VALIDATED"
}
