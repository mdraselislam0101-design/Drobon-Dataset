{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3120",
  "title": "Signal: Repository with no content filter",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "repositories[].content"
    }
  },
  "scope": "A build.gradle file that declares a repository that may serve every group and module.",
  "limitations": "It matches a repository that may serve every group and module in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "acme",
            "url": "https://repo.acme.example/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "acme",
            "url": "https://repo.acme.example/maven2"
          },
          {
            "name": "mirror"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "acme",
            "url": "https://repo.acme.example/maven2",
            "content": {
              "includeGroup": [
                "com.acme"
              ]
            }
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2",
            "content": {
              "includeGroup": [
                "org.slf4j"
              ]
            }
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A build.gradle that mentions a repository that may serve every group and module in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0983"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-repository-content-filter-absent",
  "validationStatus": "VALIDATED"
}
