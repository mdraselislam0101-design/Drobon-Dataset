{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1248",
  "title": "Signal: RabbitMQ management interface disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*RabbitMQ\\ Management)(?=[\\s\\S]*rabbitmq)"
    }
  },
  "scope": "One response whose body contains both the RabbitMQ Management title and a RabbitMQ bundle or version object.",
  "limitations": "One response body. The rule reports the management shell; it does not list a queue or publish a message.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>RabbitMQ Management</title></head><body><script src=\"/js/rabbitmq.js\"></script><div id=\"rabbitmq-management\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><head><title>RabbitMQ Management</title></head><body><script>var rabbitmq = {\"version\":\"3.12.4\"};</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><script src=\"/js/.js\"></script><div id=\"-management\"></div></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published console is still reported; the finding is reachability, not a proven broker action.",
  "linkedRules": [
    "DPK-DAST-179"
  ],
  "origin": "original-authored",
  "cell": "dast:body-rabbitmq-management:rabbitmq-management",
  "validationStatus": "VALIDATED"
}
