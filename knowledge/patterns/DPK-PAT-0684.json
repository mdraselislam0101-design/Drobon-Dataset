{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0684",
  "title": "Signal: Dangerous JS construct (timeout) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "setTimeout\\s*\\(\\s*\""
  },
  "scope": "Single-line lexical match on dangerous constructs (timeout).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "setTimeout(\"run()\", 1)",
      "match": true
    },
    {
      "line": "# audit: setTimeout(\"run()\", 1) present",
      "match": true
    },
    {
      "line": "setTimeout(run, 1)",
      "match": false
    },
    {
      "line": "# verified: setTimeout(run, 1)",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-567"
  ],
  "origin": "original-authored",
  "cell": "sast:js-flag:javascript:timeout",
  "validationStatus": "VALIDATED"
}
