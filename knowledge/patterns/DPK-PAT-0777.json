{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0777",
  "title": "Signal: Predictable randomness via Random.int (ocaml) — review required",
  "targets": [
    "ocaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Random\\.int)\\s*\\("
  },
  "scope": "Single-line lexical match on the Random.int call in ocaml code.",
  "limitations": "Lexical, line-based: matches any Random.int call.",
  "examples": [
    {
      "line": "Random.int(payload)",
      "match": true
    },
    {
      "line": "out = Random.int(data)",
      "match": true
    },
    {
      "line": "myRandomint(x)",
      "match": false
    },
    {
      "line": "Random.int_safe()",
      "match": false
    }
  ],
  "fpNotes": "Simulations are the common false positive.",
  "linkedRules": [
    "DPK-SAST-660"
  ],
  "origin": "original-authored",
  "cell": "sast:random-3:ocaml",
  "validationStatus": "VALIDATED"
}
