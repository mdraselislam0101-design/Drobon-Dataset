{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1293",
  "title": "Signal: Harbor registry UI disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Harbor)(?=[\\s\\S]*Projects)"
    }
  },
  "scope": "One response whose body renders the Harbor console.",
  "limitations": "One response body. The rule reports the UI; it does not pull an image and cannot show whether anonymous pull is enabled.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Harbor</title></head><body><div id=\"harbor-app\"></div><h1>Projects</h1><script src=\"/static/harbor.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><span>Harbor</span><nav>Projects</nav><div class=\"registry-app\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><div id=\"-app\"></div><h1></h1><script src=\"/static/.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "An artefact repository UI is a different product and a different rule.",
  "linkedRules": [
    "DPK-DAST-224"
  ],
  "origin": "original-authored",
  "cell": "dast:body-harbor-ui:harbor-ui",
  "validationStatus": "VALIDATED"
}
