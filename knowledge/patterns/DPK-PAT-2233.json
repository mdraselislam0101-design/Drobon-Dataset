{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2233",
  "title": "Signal: Yarn lockfile pins a SHA-1 integrity value",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "entries[].integrity",
      "valuePattern": "^sha1-"
    }
  },
  "scope": "A yarn.lock file that declares an integrity value that is a SHA-1 digest.",
  "limitations": "It matches an integrity value that is a SHA-1 digest in the parsed yarn.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "left-pad",
            "version": "1.3.0",
            "integrity": "sha1-AAAABBBBCCCCDDDD"
          }
        ]
      },
      "match": true
    },
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "ms",
            "version": "2.1.3",
            "integrity": "sha1-EEEEFFFFGGGGHHHH"
          }
        ]
      },
      "match": true
    },
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "left-pad",
            "version": "1.3.0",
            "integrity": "sha512-AAAA"
          }
        ]
      },
      "match": false
    },
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "ms",
            "version": "2.1.3",
            "integrity": "sha512-BBBB"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A yarn.lock that mentions an integrity value that is a SHA-1 digest in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0096"
  ],
  "origin": "original-authored",
  "cell": "sca:yarn-lock-integrity-sha1",
  "validationStatus": "VALIDATED"
}
