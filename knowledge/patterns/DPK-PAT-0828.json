{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0828",
  "title": "Signal: Weak Terraform setting (authread) — review required",
  "targets": [
    "terraform"
  ],
  "signal": {
    "kind": "regex",
    "source": "acl\\s*=\\s*\"authenticated-read\""
  },
  "scope": "Single-line lexical match on Terraform files.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "acl = \"authenticated-read\"",
      "match": true
    },
    {
      "line": "# audit: acl = \"authenticated-read\" present",
      "match": true
    },
    {
      "line": "acl = \"private\"",
      "match": false
    },
    {
      "line": "# verified: acl = \"private\"",
      "match": false
    }
  ],
  "fpNotes": "Ephemeral environments are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-711"
  ],
  "origin": "original-authored",
  "cell": "sast:tf-more:hcl:authread",
  "validationStatus": "VALIDATED"
}
