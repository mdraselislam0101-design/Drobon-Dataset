{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0450",
  "title": "Signal: XPath built by concatenation (python) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:(?:xpath|findall)\\s*\\([^)]*\\+)"
  },
  "scope": "Single-line lexical match on assembled XPath in python code.",
  "limitations": "Lexical, line-based: any assembled XPath matches, including trusted ones.",
  "examples": [
    {
      "line": "tree.xpath(\"//user[@id='\" + i + \"']\")",
      "match": true
    },
    {
      "line": "# audit: tree.xpath(\"//user[@id='\" + i + \"']\") present",
      "match": true
    },
    {
      "line": "tree.xpath(FIXED)",
      "match": false
    },
    {
      "line": "# verified: tree.xpath(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed element paths is the common false positive.",
  "linkedRules": [
    "DPK-SAST-411"
  ],
  "origin": "original-authored",
  "cell": "sast:xpath-inject:python",
  "validationStatus": "VALIDATED"
}
