{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1343",
  "title": "Signal: Anchor element uses the javascript: scheme",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<a\\b[^>]*\\shref\\s*=\\s*[\"\\']?\\s*javascript:"
    }
  },
  "scope": "One response body containing an anchor element whose href uses the javascript: scheme.",
  "limitations": "One response body. The check reports an anchor whose href begins with javascript:; it cannot see whether the URL carries attacker input, so a benign `javascript:void(0)` placeholder is reported too.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<a href=\"javascript:void(0)\" class=\"menu-toggle\">Menu</a>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<a class='btn' href='javascript:submitForm()'>Send</a>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<a href=\"/menu\">Menu</a>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<a href=\"https://docs.example/js\">Docs</a>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<button type=\"button\" data-action=\"menu\">Menu</button>"
      },
      "match": false
    }
  ],
  "fpNotes": "Framework placeholders such as javascript:void(0) are reported; the finding is the inline-script sink, not proof that it is reachable with untrusted input.",
  "linkedRules": [
    "DPK-DAST-274"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-javascript-link:javascript-scheme-link",
  "validationStatus": "VALIDATED"
}
