{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0595",
  "title": "Signal: Privileged Compose service (priv) — review required",
  "targets": [
    "compose"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:privileged\\s*:\\s*true)"
  },
  "scope": "Single-line lexical match on Compose files.",
  "limitations": "Lexical, line-based: matches the grant.",
  "examples": [
    {
      "line": "privileged: true",
      "match": true
    },
    {
      "line": "# audit: privileged: true present",
      "match": true
    },
    {
      "line": "privileged: false",
      "match": false
    },
    {
      "line": "# verified: privileged: false",
      "match": false
    }
  ],
  "fpNotes": "Node agents are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-478"
  ],
  "origin": "original-authored",
  "cell": "sast:compose-risk:compose:priv",
  "validationStatus": "VALIDATED"
}
