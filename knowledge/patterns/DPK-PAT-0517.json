{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0517",
  "title": "Signal: Possible a SOPS age key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "AGE-SECRET-KEY-1[A-Z0-9]{48,}"
  },
  "scope": "Single-line shape match for a SOPS age key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"AGE-SECRET-KEY-1AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: key = \"AGE-SECRET-KEY-1AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-051"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:sops-age",
  "validationStatus": "VALIDATED"
}
