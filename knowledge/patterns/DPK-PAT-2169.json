{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2169",
  "title": "Signal: Dependency declared with a date-shaped version",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^(?:19|20)\\d{2}[.\\-]\\d{1,2}[.\\-]\\d{1,2}$"
    }
  },
  "scope": "A package.json file that declares a date-shaped version, which carries no compatibility signal.",
  "limitations": "It matches a date-shaped version, which carries no compatibility signal in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "2025.01.04"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "2024-12-31"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "2025.1"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A three-part calendar version such as `2025.1.4` is reported too; the shape is the finding.",
  "linkedRules": [
    "DPK-SCA-0032"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-date-version",
  "validationStatus": "VALIDATED"
}
