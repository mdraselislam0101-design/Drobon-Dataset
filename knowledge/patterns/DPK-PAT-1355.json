{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1355",
  "title": "Signal: Permissions-Policy grants a Privacy Sandbox API to every origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Permissions-Policy",
      "valuePattern": "(?:^|[,;])\\s*(?:browsing-topics|attribution-reporting|join-ad-interest-group|run-ad-auction|private-aggregation|shared-storage|interest-cohort)\\s*=\\s*\\(?\\s*\\*"
    }
  },
  "scope": "One Permissions-Policy value that sets a Privacy Sandbox API to the `*` allowlist token.",
  "limitations": "One header value. The check reads the declared allowlist only; it does not observe interest groups or attribution reports, and browser support for each API differs, so a reported delegation may have no effect in some user agents.",
  "examples": [
    {
      "observation": {
        "url": "https://news.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "browsing-topics=*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://news.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "camera=(), shared-storage=*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://news.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "browsing-topics=()"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://news.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "attribution-reporting=(self)"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://news.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "geolocation=*"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A page that delegates one of these APIs to a first-party measurement frame is reported; the finding is the wildcard, not the presence of the API.",
  "linkedRules": [
    "DPK-DAST-286"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-policy-privacy-sandbox-wildcard:privacy-sandbox-wildcard",
  "validationStatus": "VALIDATED"
}
