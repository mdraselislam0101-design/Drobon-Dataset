{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0299",
  "title": "Signal: authoff left open (jmx) — review required",
  "targets": [
    "jmx"
  ],
  "signal": {
    "kind": "regex",
    "source": "com\\.sun\\.management\\.jmxremote\\.authenticate\\s*=\\s*false"
  },
  "scope": "Single-line lexical match on open settings for authoff.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "com.sun.management.jmxremote.authenticate=false",
      "match": true
    },
    {
      "line": "# audit: com.sun.management.jmxremote.authenticate=false present",
      "match": true
    },
    {
      "line": "# jmx authenticate default true",
      "match": false
    },
    {
      "line": "# verified: # jmx authenticate default true",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-260"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:jmx:authoff",
  "validationStatus": "VALIDATED"
}
