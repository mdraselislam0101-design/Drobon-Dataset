{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1113",
  "title": "Signal: Cross-Origin-Opener-Policy explicitly set to unsafe-none",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Cross-Origin-Opener-Policy",
      "valuePattern": "(?:^|[,;\\s])unsafe-none(?:$|[,;\\s])"
    }
  },
  "scope": "One response: confirm COOP is present with the unsafe-none value.",
  "limitations": "Observation-level: whether the page relies on cross-origin opener access is a design question the header alone cannot answer.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": "unsafe-none"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/popup",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": "same-origin-allow-popups, unsafe-none"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "require-corp"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A page whose documented design requires cross-origin window messaging is the accepted, reviewed exception.",
  "linkedRules": [
    "DPK-DAST-076"
  ],
  "origin": "original-authored",
  "cell": "dast:coop-unsafe-none:coop-unsafe-none",
  "validationStatus": "VALIDATED"
}
