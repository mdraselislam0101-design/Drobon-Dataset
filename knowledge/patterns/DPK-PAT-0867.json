{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0867",
  "title": "Signal: Possible a HubSpot key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "pat-na1-[A-Za-z0-9]{32,}"
  },
  "scope": "Single-line shape match for a HubSpot key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"pat-na1-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: key = \"pat-na1-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-079"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-2:hubspot-key",
  "validationStatus": "VALIDATED"
}
