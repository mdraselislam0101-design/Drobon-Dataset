{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1255",
  "title": "Signal: Cross-Origin-Embedder-Policy value is not a recognised token",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Cross-Origin-Embedder-Policy",
      "valuePattern": "^\\s*(?!require-corp\\s*$)(?!credentialless\\s*$)(?!unsafe-none\\s*$)\\S"
    }
  },
  "scope": "One response whose Cross-Origin-Embedder-Policy value is not a defined token.",
  "limitations": "One header value. The rule validates the token and does not decide whether the page actually needs isolation or whether its subresources would satisfy require-corp.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "same-origin"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "require_corp"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "require-corp"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberate unsafe-none is not reported here; it has its own rule and its own meaning.",
  "linkedRules": [
    "DPK-DAST-186"
  ],
  "origin": "original-authored",
  "cell": "dast:coep-unknown-token:unknown-token",
  "validationStatus": "VALIDATED"
}
