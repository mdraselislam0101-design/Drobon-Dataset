{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2938",
  "title": "Signal: pip cache disabled",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "global.no-cache-dir",
      "valuePattern": "^true$"
    }
  },
  "scope": "A pip.conf file that declares a `no-cache-dir` setting that re-downloads every artifact.",
  "limitations": "It matches a `no-cache-dir` setting that re-downloads every artifact in the parsed pip.conf; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pip.conf",
      "document": {
        "global": {
          "index-url": "https://pypi.org/simple",
          "timeout": "15",
          "no-cache-dir": "true"
        },
        "install": {
          "require-hashes": "true"
        }
      },
      "match": true
    },
    {
      "file": "pip.conf",
      "document": {
        "global": {
          "index-url": "https://pypi.org/simple",
          "timeout": "15",
          "no-cache-dir": true
        },
        "install": {
          "require-hashes": "true"
        }
      },
      "match": true
    },
    {
      "file": "pip.conf",
      "document": {
        "global": {
          "index-url": "https://pypi.org/simple",
          "timeout": "15",
          "no-cache-dir": "false"
        },
        "install": {
          "require-hashes": "true"
        }
      },
      "match": false
    },
    {
      "file": "pip.conf",
      "document": {
        "global": {
          "index-url": "https://pypi.org/simple",
          "timeout": "15"
        },
        "install": {
          "require-hashes": "true"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pip.conf that mentions a `no-cache-dir` setting that re-downloads every artifact in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0801"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-pip-conf-cache-dir-off",
  "validationStatus": "VALIDATED"
}
