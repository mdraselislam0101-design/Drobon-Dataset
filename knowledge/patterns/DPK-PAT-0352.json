{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0352",
  "title": "Signal: Weak service hardening (mynetworks) — review required",
  "targets": [
    "postfix"
  ],
  "signal": {
    "kind": "regex",
    "source": "mynetworks\\s*=[^\\n]*0\\.0\\.0\\.0/0"
  },
  "scope": "Single-line lexical match on weak settings (mynetworks).",
  "limitations": "Lexical, line-based: matches the setting regardless of host trust.",
  "examples": [
    {
      "line": "mynetworks = 0.0.0.0/0",
      "match": true
    },
    {
      "line": "# audit: mynetworks = 0.0.0.0/0 present",
      "match": true
    },
    {
      "line": "mynetworks = 127.0.0.0/8",
      "match": false
    },
    {
      "line": "# verified: mynetworks = 127.0.0.0/8",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-313"
  ],
  "origin": "original-authored",
  "cell": "sast:sys-services:postfix:mynetworks",
  "validationStatus": "VALIDATED"
}
