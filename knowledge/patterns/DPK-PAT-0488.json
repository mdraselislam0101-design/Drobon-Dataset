{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0488",
  "title": "Signal: Possible a Google API key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "AIza[A-Za-z0-9_-]{35,}"
  },
  "scope": "Single-line shape match for a Google API key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"AIzaAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: key = \"AIzaAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-022"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:gcp-apikey",
  "validationStatus": "VALIDATED"
}
