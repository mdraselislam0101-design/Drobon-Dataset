{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0338",
  "title": "Signal: Server-side fetch of assembled URL (rust) — review required",
  "targets": [
    "rust"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.get\\s*\\(\\s*format!"
  },
  "scope": "Single-line lexical match on assembled fetch URLs in rust code.",
  "limitations": "Lexical, line-based: any assembled fetch URL matches.",
  "examples": [
    {
      "line": ".get(format!(\"{}/{}\", b, p))",
      "match": true
    },
    {
      "line": "# audit: .get(format!(\"{}/{}\", b, p)) present",
      "match": true
    },
    {
      "line": ".get(FIXED)",
      "match": false
    },
    {
      "line": "# verified: .get(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-299"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-langs:rust",
  "validationStatus": "VALIDATED"
}
