{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0447",
  "title": "Signal: Debug or management exposure (actuator) — review required",
  "targets": [
    "properties"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:endpoints\\.web\\.exposure\\.include\\s*=\\s*[\"']?\\*)"
  },
  "scope": "Single-line lexical match on exposure settings (actuator).",
  "limitations": "Lexical, line-based: matches the exposure.",
  "examples": [
    {
      "line": "endpoints.web.exposure.include=*",
      "match": true
    },
    {
      "line": "# audit: endpoints.web.exposure.include=* present",
      "match": true
    },
    {
      "line": "endpoints.web.exposure.include=health",
      "match": false
    },
    {
      "line": "# verified: endpoints.web.exposure.include=health",
      "match": false
    }
  ],
  "fpNotes": "Internal-only services are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-408"
  ],
  "origin": "original-authored",
  "cell": "sast:web-exposure:properties:actuator",
  "validationStatus": "VALIDATED"
}
