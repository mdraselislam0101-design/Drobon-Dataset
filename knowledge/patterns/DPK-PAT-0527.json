{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0527",
  "title": "Signal: Possible a Twilio SID in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "AC[a-f0-9]{32,}"
  },
  "scope": "Single-line shape match for a Twilio SID.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "sid = \"ACaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"",
      "match": true
    },
    {
      "line": "# audit: sid = \"ACaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" present",
      "match": true
    },
    {
      "line": "sid = \"xy\"",
      "match": false
    },
    {
      "line": "sid = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-061"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:twilio-sid",
  "validationStatus": "VALIDATED"
}
