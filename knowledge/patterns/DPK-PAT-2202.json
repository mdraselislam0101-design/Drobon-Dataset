{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2202",
  "title": "Signal: Lockfile drops a dependency's own requirements",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "packages",
      "field": "requires"
    }
  },
  "scope": "A package-lock.json file that declares a package entry that records no dependency requirements where the package declares some.",
  "limitations": "It matches a package entry that records no dependency requirements where the package declares some in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "requires": {
              "left-pad": "^1.3.0"
            },
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "requires": {
              "ms": "^2.1.3"
            },
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A package with genuinely no dependencies is still reported; confirm it against the registry metadata.",
  "linkedRules": [
    "DPK-SCA-0065"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-requires-absent",
  "validationStatus": "VALIDATED"
}
