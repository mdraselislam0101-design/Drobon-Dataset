{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1374",
  "title": "Signal: Node.js inspector debugging endpoint disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "webSocketDebuggerUrl"
    }
  },
  "scope": "One response body containing the inspector target list with a webSocketDebuggerUrl field.",
  "limitations": "One response body. The check proves the endpoint answered; it does not attach to the debugger or prove that the socket is still open.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/json/list",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "[{\"description\":\"node.js instance\",\"title\":\"app\",\"webSocketDebuggerUrl\":\"ws://127.0.0.1:9229/abc-123\"}]"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/json",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><pre>{\"webSocketDebuggerUrl\":\"ws://0.0.0.0:9229/uuid\"}</pre></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/json/list",
        "status": 404,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>Cannot GET /json/list</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/debugging",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Start the service with --inspect and attach your editor.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A documentation page that quotes the field name is reported; an application that merely mentions --inspect in a help page is not unless the field name is present.",
  "linkedRules": [
    "DPK-DAST-305"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-node-inspector-endpoint:node-inspector-target",
  "validationStatus": "VALIDATED"
}
