{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1089",
  "title": "Signal: TLS certificate verification bypassed in rust — review required",
  "targets": [
    "rust"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:danger_accept_invalid_certs\\s*\\(\\s*true\\s*\\))"
  },
  "scope": "Single-line match on the insecure certificate option in rust.",
  "limitations": "Lexical: matches the builder call; a rustls verifier that implements custom validation is out of scope.",
  "examples": [
    {
      "line": "let client = reqwest::Client::builder().danger_accept_invalid_certs(true).build()?;",
      "match": true
    },
    {
      "line": "# audit: let client = reqwest::Client::builder().danger_accept_invalid_certs(true).build()?; present",
      "match": true
    },
    {
      "line": "let client = reqwest::Client::builder().build()?;",
      "match": false
    },
    {
      "line": "# verified: let client = reqwest::Client::builder().build()?;",
      "match": false
    }
  ],
  "fpNotes": "A local test harness with a generated CA installed in the trust store is the accepted exception.",
  "linkedRules": [
    "DPK-SAST-906"
  ],
  "origin": "original-authored",
  "cell": "sast:rust-tls-danger-accept:rust",
  "validationStatus": "VALIDATED"
}
