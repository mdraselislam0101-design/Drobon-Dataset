{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0765",
  "title": "Signal: Cleartext protocol client (smtp) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:smtplib\\.SMTP\\s*\\()"
  },
  "scope": "Single-line lexical match on cleartext clients (smtp).",
  "limitations": "Lexical, line-based: matches the client.",
  "examples": [
    {
      "line": "smtplib.SMTP(h)",
      "match": true
    },
    {
      "line": "# audit: smtplib.SMTP(h) present",
      "match": true
    },
    {
      "line": "smtplib.SMTP_SSL(h)",
      "match": false
    },
    {
      "line": "# verified: smtplib.SMTP_SSL(h)",
      "match": false
    }
  ],
  "fpNotes": "Loopback use is the common accepted case.",
  "linkedRules": [
    "DPK-SAST-648"
  ],
  "origin": "original-authored",
  "cell": "sast:python-net-plain:python:smtp",
  "validationStatus": "VALIDATED"
}
