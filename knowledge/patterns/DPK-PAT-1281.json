{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1281",
  "title": "Signal: Refresh header targets a data: URL",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Refresh",
      "valuePattern": "^\\s*[0-9]*\\s*;?\\s*url\\s*=\\s*[\"\\']?\\s*data\\s*:"
    }
  },
  "scope": "One response whose refresh target begins with the data: scheme.",
  "limitations": "One header value. The rule reports the scheme the header names; it cannot prove the value is attacker-influenced, and some browsers block top-level data: navigation outright.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "0; url=data:text/html;base64,PHNjcmlwdD4="
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "5; URL=\"data:text/html,<script>alert(1)</script>\""
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "0; url=https://app.example/"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "30"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Blocked or ignored navigations are not distinguished; the finding is the declared target.",
  "linkedRules": [
    "DPK-DAST-212"
  ],
  "origin": "original-authored",
  "cell": "dast:refresh-data-url:data-url",
  "validationStatus": "VALIDATED"
}
