{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1447",
  "title": "Signal: appsettings.Development.json served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*\"DetailedErrors\"\\s*:\\s*true)(?=[\\s\\S]*\"ConnectionStrings\"\\s*:)"
    }
  },
  "scope": "One response body containing the development settings file with its connection strings.",
  "limitations": "One response body. The rule reads the file shape; it does not connect to the database it names.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/appsettings.Development.json",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\n  \"DetailedErrors\": true,\n  \"ConnectionStrings\": {\n    \"Default\": \"Server=db.internal;Database=shop;User Id=app;\"\n  }\n}\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/appsettings.Development.json",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"DetailedErrors\":true,\"ConnectionStrings\":{\"Redis\":\"cache.internal:6379\"},\"Logging\":{\"LogLevel\":{\"Default\":\"Debug\"}}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/appsettings.json",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"Logging\":{\"LogLevel\":{\"Default\":\"Warning\"}},\"AllowedHosts\":\"*\"}\n"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/deploy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Deployment guide</title></head><body><p>DetailedErrors should stay false outside development.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A production appsettings.json without the development marker is not reported, because the DetailedErrors key is required.",
  "linkedRules": [
    "DPK-DAST-378"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-artefact-appsettings-development:appsettings-development",
  "validationStatus": "VALIDATED"
}
