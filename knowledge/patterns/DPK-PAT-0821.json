{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0821",
  "title": "Signal: Server-side fetch of assembled URL (elixir) — review required",
  "targets": [
    "elixir"
  ],
  "signal": {
    "kind": "regex",
    "source": "HTTPoison\\.get\\s*\\([^)]*<>"
  },
  "scope": "Single-line lexical match on assembled fetch URLs in elixir code.",
  "limitations": "Lexical, line-based: any assembled fetch URL matches.",
  "examples": [
    {
      "line": "HTTPoison.get(base <> p)",
      "match": true
    },
    {
      "line": "# audit: HTTPoison.get(base <> p) present",
      "match": true
    },
    {
      "line": "HTTPoison.get(fixed)",
      "match": false
    },
    {
      "line": "# verified: HTTPoison.get(fixed)",
      "match": false
    }
  ],
  "fpNotes": "Fixed hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-704"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-4:elixir",
  "validationStatus": "VALIDATED"
}
