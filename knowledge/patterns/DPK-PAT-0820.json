{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0820",
  "title": "Signal: Server-side fetch of assembled URL (crystal) — review required",
  "targets": [
    "crystal"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Client\\.get\\s*\\([^)]*\\+)"
  },
  "scope": "Single-line lexical match on assembled fetch URLs in crystal code.",
  "limitations": "Lexical, line-based: any assembled fetch URL matches.",
  "examples": [
    {
      "line": "Client.get(base + p)",
      "match": true
    },
    {
      "line": "# audit: Client.get(base + p) present",
      "match": true
    },
    {
      "line": "Client.get(FIXED)",
      "match": false
    },
    {
      "line": "# verified: Client.get(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-703"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-4:crystal",
  "validationStatus": "VALIDATED"
}
