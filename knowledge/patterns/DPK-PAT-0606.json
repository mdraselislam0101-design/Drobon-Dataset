{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0606",
  "title": "Signal: Dangerous .NET construct (debug) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:compilation\\s+debug\\s*=\\s*[\"']?true)"
  },
  "scope": "Single-line lexical match on .NET constructs (debug).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "<compilation debug=\"true\"",
      "match": true
    },
    {
      "line": "# audit: <compilation debug=\"true\" present",
      "match": true
    },
    {
      "line": "<compilation debug=\"false\"",
      "match": false
    },
    {
      "line": "# verified: <compilation debug=\"false\"",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-489"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-flag:csharp:debug",
  "validationStatus": "VALIDATED"
}
