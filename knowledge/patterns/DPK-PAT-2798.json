{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2798",
  "title": "Signal: Module substituted by an unreleased pseudo-version",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "replace[].new.version",
      "valuePattern": "^v0\\.0\\.0-"
    }
  },
  "scope": "A go.mod file that declares a `replace` directive that pins a pre-release pseudo-version.",
  "limitations": "It matches a `replace` directive that pins a pre-release pseudo-version in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [
          {
            "old": {
              "path": "example.com/acme/core"
            },
            "new": {
              "path": "example.com/acme/core",
              "version": "v0.0.0-20240101120000-9f2c3d4e5f60"
            }
          }
        ],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [
          {
            "old": {
              "path": "example.com/acme/sdk"
            },
            "new": {
              "path": "github.com/acme/sdk",
              "version": "v0.0.0-20240202080000-a1b2c3d4e5f6"
            }
          }
        ],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [
          {
            "old": {
              "path": "example.com/acme/core"
            },
            "new": {
              "path": "example.com/acme/core",
              "version": "v1.4.2"
            }
          }
        ],
        "exclude": []
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": false
    }
  ],
  "fpNotes": "A go.mod that mentions a `replace` directive that pins a pre-release pseudo-version in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0661"
  ],
  "origin": "original-authored",
  "cell": "sca:go-replace-insecure-version",
  "validationStatus": "VALIDATED"
}
