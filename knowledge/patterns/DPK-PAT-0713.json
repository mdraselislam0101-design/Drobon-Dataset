{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0713",
  "title": "Signal: Dangerous NFS export (worldrw) — review required",
  "targets": [
    "nfs"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\*\\s*\\(rw"
  },
  "scope": "Single-line lexical match on NFS exports.",
  "limitations": "Lexical, line-based: matches the export option.",
  "examples": [
    {
      "line": "/data *(rw,sync)",
      "match": true
    },
    {
      "line": "# audit: /data *(rw,sync) present",
      "match": true
    },
    {
      "line": "/data host(ro)",
      "match": false
    },
    {
      "line": "# verified: /data host(ro)",
      "match": false
    }
  ],
  "fpNotes": "Trusted clusters are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-596"
  ],
  "origin": "original-authored",
  "cell": "sast:nfs-export:nfs:worldrw",
  "validationStatus": "VALIDATED"
}
