{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2945",
  "title": "Signal: pnpm lockfile on an older format",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "lockfileVersion",
      "valuePattern": "^[56]\\.[0-9]+$"
    }
  },
  "scope": "A pnpm-lock.yaml file that declares a `lockfileVersion` from the pnpm 5/6 era.",
  "limitations": "It matches a `lockfileVersion` from the pnpm 5/6 era in the parsed pnpm-lock.yaml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "6.0",
        "packages": {
          "/left-pad@1.3.0": {
            "resolution": {
              "tarball": "https://registry.npmjs.org/left-pad-1.3.0.tgz"
            },
            "integrity": "sha512-9f2c3d4e"
          }
        }
      },
      "match": true
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "5.4",
        "packages": {
          "/left-pad@1.3.0": {
            "resolution": {
              "tarball": "https://registry.npmjs.org/left-pad-1.3.0.tgz"
            },
            "integrity": "sha512-9f2c3d4e"
          }
        }
      },
      "match": true
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/left-pad@1.3.0": {
            "resolution": {
              "tarball": "https://registry.npmjs.org/left-pad-1.3.0.tgz"
            },
            "integrity": "sha512-9f2c3d4e"
          }
        }
      },
      "match": false
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "8.0",
        "packages": {
          "/left-pad@1.3.0": {
            "resolution": {
              "tarball": "https://registry.npmjs.org/left-pad-1.3.0.tgz"
            },
            "integrity": "sha512-9f2c3d4e"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pnpm-lock.yaml that mentions a `lockfileVersion` from the pnpm 5/6 era in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0808"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-pnpm-lock-stale-version",
  "validationStatus": "VALIDATED"
}
