{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0491",
  "title": "Signal: Possible a GitHub user token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "ghu_[A-Za-z0-9]{36,}"
  },
  "scope": "Single-line shape match for a GitHub user token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"ghu_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"ghu_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-025"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:github-user",
  "validationStatus": "VALIDATED"
}
