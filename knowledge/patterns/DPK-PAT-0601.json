{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0601",
  "title": "Signal: Unsafe .NET call Response.Write (csharp) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Response\\.Write)\\s*\\("
  },
  "scope": "Single-line lexical match on the Response.Write call in csharp code.",
  "limitations": "Lexical, line-based: any Response.Write call matches.",
  "examples": [
    {
      "line": "Response.Write(payload)",
      "match": true
    },
    {
      "line": "out = Response.Write(data)",
      "match": true
    },
    {
      "line": "myResponseWrite(x)",
      "match": false
    },
    {
      "line": "Response.Write_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted local data is the common false positive.",
  "linkedRules": [
    "DPK-SAST-484"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-call:csharp:response",
  "validationStatus": "VALIDATED"
