{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0965",
  "title": "Signal: Referrer-Policy sends full URLs (unsafe-url)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Referrer-Policy",
      "valuePattern": "(?:^|[,\\s])unsafe-url(?:$|[,\\s])"
    }
  },
  "scope": "Single Referrer-Policy header value: the unsafe-url token appears.",
  "limitations": "Header value check: it cannot see which URLs carry sensitive query strings.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "unsafe-url"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "no-referrer, unsafe-url"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "strict-origin-when-cross-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "Pages with no sensitive query strings are the common false positive.",
  "linkedRules": [
    "DPK-DAST-068"
  ],
  "origin": "original-authored",
  "cell": "dast:referrer-unsafe-url:unsafe-url",
  "validationStatus": "VALIDATED"
}
