{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1375",
  "title": "Signal: Served source map embeds the original source code",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "\"sourcesContent\"\\s*:\\s*\\["
    }
  },
  "scope": "One response body containing a source map with a sourcesContent array.",
  "limitations": "One response body. The check proves the source text is embedded; it does not read the application code or decide whether that code is sensitive.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/assets/app.js.map",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"version\":3,\"sources\":[\"app.js\"],\"sourcesContent\":[\"const api=\\\"https://internal.example/v1\\\";\"],\"mappings\":\"AAAA\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/static/main.js.map",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"version\":3,\"sources\":[\"main.ts\"],\"sourcesContent\": [\"export const key = \\\"x\\\";\"],\"names\":[]}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/assets/app.js.map",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"version\":3,\"sources\":[\"app.js\"],\"names\":[\"a\",\"b\"],\"mappings\":\"AAAA\"}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/build",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Set devtool to hidden-source-map to drop the source reference from the bundle.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A map that lists sources without sourcesContent is not reported; a page that discusses source maps in prose is not reported unless the field name appears as JSON.",
  "linkedRules": [
    "DPK-DAST-306"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-sourcemap-sources-content:sourcemap-sources-content",
  "validationStatus": "VALIDATED"
}
