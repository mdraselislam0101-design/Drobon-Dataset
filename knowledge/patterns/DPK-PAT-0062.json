{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0062",
  "title": "Signal: bcrypt with low cost (go) — review required",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:GenerateFromPassword\\s*\\([^)]*,\\s*[0-9]\\b)"
  },
  "scope": "Single-line lexical match on bcrypt cost in go code.",
  "limitations": "Lexical, line-based: matches small numeric costs; variable-driven costs are missed.",
  "examples": [
    {
      "line": "bcrypt.GenerateFromPassword(pw, 4)",
      "match": true
    },
    {
      "line": "# audit: bcrypt.GenerateFromPassword(pw, 4) present",
      "match": true
    },
    {
      "line": "bcrypt.GenerateFromPassword(pw, 12)",
      "match": false
    },
    {
      "line": "# verified: bcrypt.GenerateFromPassword(pw, 12)",
      "match": false
    }
  ],
  "fpNotes": "Test-only hashes are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-023"
  ],
  "origin": "original-authored",
  "cell": "sast:bcrypt-low-cost:go",
  "validationStatus": "VALIDATED"
}
