{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0847",
  "title": "Signal: Raw HTML marker via Html (scala) — review required",
  "targets": [
    "scala"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Html)\\s*\\("
  },
  "scope": "Single-line lexical match on the Html call in scala code.",
  "limitations": "Lexical, line-based: any Html call matches.",
  "examples": [
    {
      "line": "Html(payload)",
      "match": true
    },
    {
      "line": "out = Html(data)",
      "match": true
    },
    {
      "line": "myHtml(x)",
      "match": false
    },
    {
      "line": "Html_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted markup is the common false positive.",
  "linkedRules": [
    "DPK-SAST-730"
  ],
  "origin": "original-authored",
  "cell": "sast:xss-call-3:scala",
  "validationStatus": "VALIDATED"
