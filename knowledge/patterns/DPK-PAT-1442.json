{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1442",
  "title": "Signal: Laravel Telescope dashboard disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*<title>Telescope)(?=[\\s\\S]*telescope)"
    }
  },
  "scope": "One response body containing the Telescope dashboard shell with its entry navigation.",
  "limitations": "One response body. The rule reports the dashboard shell; it does not open an individual entry.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/telescope",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Telescope</title></head><body><div id=\"telescope\"><a href=\"/telescope/requests\">Requests</a><a href=\"/telescope/mail\">Mail</a></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/telescope/requests",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Telescope · Requests</title></head><body><div class=\"telescope-entries\"><span>POST /login 200</span></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Sign in</title></head><body><form method=\"post\"><input name=\"email\"></form></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/monitoring",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Telescope is installed for local development only.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that mentions Telescope in prose is not reported, because the shell markup is required.",
  "linkedRules": [
    "DPK-DAST-373"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-page-laravel-telescope:laravel-telescope",
  "validationStatus": "VALIDATED"
}
