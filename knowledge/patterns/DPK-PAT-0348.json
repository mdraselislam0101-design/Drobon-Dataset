{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0348",
  "title": "Signal: Setuid bit set (shell) — review required",
  "targets": [
    "shell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:chmod\\s+(?:[0-7]*4[0-7]{3}|u\\+s))"
  },
  "scope": "Single-line lexical match on setuid grants in shell scripts.",
  "limitations": "Lexical, line-based: matches the bit regardless of binary safety.",
  "examples": [
    {
      "line": "chmod 4755 helper",
      "match": true
    },
    {
      "line": "# audit: chmod 4755 helper present",
      "match": true
    },
    {
      "line": "chmod 0755 helper",
      "match": false
    },
    {
      "line": "# verified: chmod 0755 helper",
      "match": false
    }
  ],
  "fpNotes": "System utilities designed for setuid are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-309"
  ],
  "origin": "original-authored",
  "cell": "sast:suid-bit:shell",
  "validationStatus": "VALIDATED"
}
