{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1173",
  "title": "Signal: Content-Security-Policy frame-src allows every origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "^(?:(?!frame-src(?=[\\s;]|$))[^;]*;\\s*)*frame-src(?=[\\s;]|$)[^;]*?(?<=\\s)(?:\\*|(?:https?|wss?)://\\*)(?=\\s|;|$)"
    }
  },
  "scope": "One Content-Security-Policy value whose first frame-src declaration contains the wildcard or a scheme wildcard host.",
  "limitations": "One header value, first declaration of the directive only. The rule cannot see which frames a page actually contains.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-src *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; frame-src 'self' https://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-src https://*.example.com"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-src 'self'; frame-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A page that legitimately embeds arbitrary user-supplied sites (a preview tool) can be reported; the observation cannot distinguish it from an accidental wildcard.",
  "linkedRules": [
    "DPK-DAST-104"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-frame-src-wildcard:frame-src",
  "validationStatus": "VALIDATED"
}
