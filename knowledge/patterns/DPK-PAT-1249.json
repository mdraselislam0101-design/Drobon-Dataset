{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1249",
  "title": "Signal: Apache Solr admin interface disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*solr\\-spec\\-version)(?=[\\s\\S]*lucene)"
    }
  },
  "scope": "One response whose body contains both solr-spec-version and lucene-spec-version fields.",
  "limitations": "One response body. The rule reports the admin page; it does not run a query or read a core.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"solr-admin\"><span>solr-spec-version: 9.4.0</span><span>lucene-spec-version: 9.8.0</span></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><pre>{\"solr-spec-version\":\"8.11.2\",\"lucene-spec-version\":\"8.11.2\"}</pre></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"solr-admin\"><span>: 9.4.0</span><span>-spec-version: 9.8.0</span></div></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published admin interface is still reported; the finding is reachability.",
  "linkedRules": [
    "DPK-DAST-180"
  ],
  "origin": "original-authored",
  "cell": "dast:body-solr-admin:solr-admin",
  "validationStatus": "VALIDATED"
}
