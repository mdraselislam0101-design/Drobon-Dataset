{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1971",
  "title": "Signal: Web font fetched from an external provider",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "fonts\\.googleapis\\.com|fonts\\.gstatic\\.com"
    }
  },
  "scope": "A response body that carries a font stylesheet pulled from a public font host.",
  "limitations": "One response body, first 32,768 bytes. It matches a font host in a stylesheet or link element; it cannot tell whether the value behind the marker is live or whether the page needs authentication.",
  "examples": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "@import url(\"https://fonts.gstatic.com/s/inter/v12/font.css\");"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<link rel=\"stylesheet\" href=\"/assets/fonts.css\">"
      },
      "match": false
    }
  ],
  "fpNotes": "A documentation page that names the provider is not reported.",
  "linkedRules": [
    "DPK-DAST-852"
  ],
  "origin": "original-authored",
  "cell": "dast:body-external-font-host:body-external-font-host",
  "validationStatus": "VALIDATED"
}
