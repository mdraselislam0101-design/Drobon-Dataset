{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0785",
  "title": "Signal: Dynamic evaluation via x.html_safe (ruby) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:html_safe)\\s*\\("
  },
  "scope": "Single-line lexical match on the x.html_safe call in ruby code.",
  "limitations": "Lexical, line-based: any x.html_safe call matches.",
  "examples": [
    {
      "line": "x.html_safe(payload)",
      "match": true
    },
    {
      "line": "out = x.html_safe(data)",
      "match": true
    },
    {
      "line": "myxhtml_safe(x)",
      "match": false
    },
    {
      "line": "x.html_safe_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted templates are the common false positive.",
  "linkedRules": [
    "DPK-SAST-668"
  ],
  "origin": "original-authored",
  "cell": "sast:ruby-call:ruby:htmlsafe",
  "validationStatus": "VALIDATED"
}
