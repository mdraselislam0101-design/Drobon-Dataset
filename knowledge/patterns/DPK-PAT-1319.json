{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1319",
  "title": "Signal: WordPress version in generator meta tag",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*name=[\"\\']generator[\"\\'])(?=[\\s\\S]*WordPress)"
    }
  },
  "scope": "One response whose body publishes a WordPress version in a generator meta tag.",
  "limitations": "One response body. The rule reports the meta tag; it does not look the version up against an advisory source and makes no claim that the release is vulnerable.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta name=\"generator\" content=\"WordPress 6.2.2\"><title>Blog</title></head><body><h1>Blog</h1></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><head><meta name=\"generator\" content=\"WordPress 5.9.8\"></head><body>Home</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta  content=\" 6.2.2\"><title>Blog</title></head><body><h1>Blog</h1></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A plugin that prints the WordPress name without the generator meta tag is not reported.",
  "linkedRules": [
    "DPK-DAST-250"
  ],
  "origin": "original-authored",
  "cell": "dast:body-wordpress-generator-meta:wordpress-generator-meta",
  "validationStatus": "VALIDATED"
}
