  "title": "Signal: Predictable randomness via randomIO (haskell) — review required",
  "targets": [
    "haskell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:randomIO)\\s*\\("
  },
  "scope": "Single-line lexical match on the randomIO call in haskell code.",
  "limitations": "Lexical, line-based: matches any randomIO call.",
  "examples": [
    {
      "line": "randomIO(payload)",
      "match": true
    },
    {
      "line": "out = randomIO(data)",
      "match": true
    },
    {
      "line": "myrandomIO(x)",
      "match": false
    },
    {
      "line": "randomIO_safe()",
      "match": false
    }
  ],
  "fpNotes": "Simulations are the common false positive.",
  "linkedRules": [
    "DPK-SAST-658"
  ],
  "origin": "original-authored",
  "cell": "sast:random-3:haskell",
