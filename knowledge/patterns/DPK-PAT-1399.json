{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1399",
  "title": "Signal: Incoming webhook URL with its secret token served in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "https://hooks\\.slack\\.com/services/[A-Z0-9]{8,}/[A-Z0-9]{8,}/[A-Za-z0-9]{20,}"
    }
  },
  "scope": "One response body containing an incoming webhook URL with a token path segment.",
  "limitations": "One response body. The check recognises the webhook URL shape; it does not post to the endpoint or confirm the token is live.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/admin/notifications",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<input name=\"webhook\" value=\"https://hooks.slack.com/services/A0000000X/C0000000X/EXAMPLEEXAMPLEEXAMPLE1234\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api/alerts",
        "status": 500,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "notify failed for https://hooks.slack.com/services/A1111111X/C2222222X/EXAMPLEEXAMPLEEXAMPLE5678"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/docs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<code>https://hooks.slack.com/services/T00000000/B00000000/****</code>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<a href=\"https://api.slack.com/messaging/webhooks\">Set up a webhook</a>"
      },
      "match": false
    }
  ],
  "fpNotes": "A documentation page that shows a redacted webhook is not reported, because the token segment must have the full length the provider issues. A webhook host without a token path is not reported.",
  "linkedRules": [
    "DPK-DAST-330"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-slack-webhook-url:webhook-url",
  "validationStatus": "VALIDATED"
}
