{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2301",
  "title": "Signal: Maven repository checksum failures ignored",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.repositories[].releases.checksumPolicy",
      "valuePattern": "^ignore$"
    }
  },
  "scope": "A pom.xml file that declares a repository whose checksum policy is `ignore`.",
  "limitations": "It matches a repository whose checksum policy is `ignore` in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "repositories": [
            {
              "id": "acme",
              "url": "https://repo.acme.example/maven2",
              "releases": {
                "checksumPolicy": "ignore"
              }
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "repositories": [
            {
              "id": "mirror",
              "url": "https://repo.acme.example/maven2",
              "releases": {
                "checksumPolicy": "ignore"
              }
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "repositories": [
            {
              "id": "acme",
              "url": "https://repo.acme.example/maven2",
              "releases": {
                "checksumPolicy": "fail"
              }
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo.maven.apache.org/maven2"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pom.xml that mentions a repository whose checksum policy is `ignore` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0164"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-checksum-policy-ignore",
  "validationStatus": "VALIDATED"
}
