{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0786",
  "title": "Signal: Dynamic evaluation via Oj.load (ruby) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Oj\\.load)\\s*\\("
  },
  "scope": "Single-line lexical match on the Oj.load call in ruby code.",
  "limitations": "Lexical, line-based: any Oj.load call matches.",
  "examples": [
    {
      "line": "Oj.load(payload)",
      "match": true
    },
    {
      "line": "out = Oj.load(data)",
      "match": true
    },
    {
      "line": "myOjload(x)",
      "match": false
    },
    {
      "line": "Oj.load_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted templates are the common false positive.",
  "linkedRules": [
    "DPK-SAST-669"
  ],
  "origin": "original-authored",
  "cell": "sast:ruby-call:ruby:oj",
  "validationStatus": "VALIDATED"
}
