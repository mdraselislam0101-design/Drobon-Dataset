{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2238",
  "title": "Signal: pnpm lockfile resolves a package from a git repository",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.resolution.repo",
      "valuePattern": "^git\\+"
    }
  },
  "scope": "A pnpm-lock.yaml file that declares a pnpm resolution that names a git repository instead of a registry tarball.",
  "limitations": "It matches a pnpm resolution that names a git repository instead of a registry tarball in the parsed pnpm-lock.yaml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/acme-sdk@4.2.0": {
            "resolution": {
              "repo": "git+https://github.com/acme/sdk.git",
              "commit": "9f2c4a1"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/acme-cli@2.1.0": {
            "resolution": {
              "repo": "git+ssh://git@github.com/acme/cli.git",
              "commit": "0a1b2c3"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/acme-sdk@4.2.0": {
            "resolution": {
              "integrity": "sha512-AAAA"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/acme-cli@2.1.0": {
            "resolution": {
              "tarball": "https://registry.npmjs.org/acme-cli/-/acme-cli-2.1.0.tgz"
            }
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pnpm-lock.yaml that mentions a pnpm resolution that names a git repository instead of a registry tarball in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0101"
  ],
  "origin": "original-authored",
  "cell": "sca:pnpm-lock-git-resolution",
  "validationStatus": "VALIDATED"
}
