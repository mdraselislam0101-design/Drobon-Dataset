{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0691",
  "title": "Signal: Permissive Kubernetes pod (escalate) — review required",
  "targets": [
    "k8s"
  ],
  "signal": {
    "kind": "regex",
    "source": "allowPrivilegeEscalation\\s*:\\s*true"
  },
  "scope": "Single-line lexical match on Kubernetes manifests.",
  "limitations": "Lexical, line-based: matches the grant.",
  "examples": [
    {
      "line": "allowPrivilegeEscalation: true",
      "match": true
    },
    {
      "line": "# audit: allowPrivilegeEscalation: true present",
      "match": true
    },
    {
      "line": "allowPrivilegeEscalation: false",
      "match": false
    },
    {
      "line": "# verified: allowPrivilegeEscalation: false",
      "match": false
    }
  ],
  "fpNotes": "Node agents are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-574"
  ],
  "origin": "original-authored",
  "cell": "sast:k8s-more:k8s:escalate",
  "validationStatus": "VALIDATED"
}
