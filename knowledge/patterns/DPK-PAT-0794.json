{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0794",
  "title": "Signal: Shell runs a variable (backtick, perl) — review required",
  "targets": [
    "perl"
  ],
  "signal": {
    "kind": "regex",
    "source": "`[^`]*\\$"
  },
  "scope": "Single-line lexical match on shell execution (backtick).",
  "limitations": "Lexical, line-based: matches the execution.",
  "examples": [
    {
      "line": "`$cmd`",
      "match": true
    },
    {
      "line": "# audit: `$cmd` present",
      "match": true
    },
    {
      "line": "`ls`",
      "match": false
    },
    {
      "line": "# verified: `ls`",
      "match": false
    }
  ],
  "fpNotes": "Trusted variables are the common false positive.",
  "linkedRules": [
    "DPK-SAST-677"
  ],
  "origin": "original-authored",
  "cell": "sast:shell-risk:perl:backtick",
  "validationStatus": "VALIDATED"
}
