{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0844",
  "title": "Signal: Umask cleared to zero (ruby) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:File\\.umask\\s*\\(\\s*0\\s*\\))"
  },
  "scope": "Single-line lexical match on umask clearing in ruby code.",
  "limitations": "Lexical, line-based: matches the clearing.",
  "examples": [
    {
      "line": "File.umask(0)",
      "match": true
    },
    {
      "line": "# audit: File.umask(0) present",
      "match": true
    },
    {
      "line": "File.umask(022)",
      "match": false
    },
    {
      "line": "# verified: File.umask(022)",
      "match": false
    }
  ],
  "fpNotes": "Brief scoped clearing is the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-727"
  ],
  "origin": "original-authored",
  "cell": "sast:umask-zero:ruby",
  "validationStatus": "VALIDATED"
}
