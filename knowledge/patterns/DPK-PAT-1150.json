{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1150",
  "title": "Signal: Python http.server directory listing exposed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<title>Directory listing for"
    }
  },
  "scope": "One response body: confirm the Python directory-listing title.",
  "limitations": "Observation-level: matches the generic listing title emitted by the Python standard-library servers. Directory listings from other servers are covered by separate rules.",
  "examples": [
    {
      "observation": {
        "url": "https://files.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8"
        },
        "body": "<!DOCTYPE HTML><html><head><title>Directory listing for /</title></head><body><ul><li><a href=\"backup.zip\">backup.zip</a></li></ul></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://files.example/releases/",
        "status": 200,
        "headers": {},
        "body": "<title>Directory listing for /releases/</title>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://files.example/",
        "status": 200,
        "headers": {},
        "body": "<html><head><title>Public downloads</title></head><body><a href=\"release.txt\">release</a></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://files.example/",
        "status": 403,
        "headers": {},
        "body": "<title>Directory listing disabled</title>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately public file mirror is reported by design; the limitation states this.",
  "linkedRules": [
    "DPK-DAST-081"
  ],
  "origin": "original-authored",
  "cell": "dast:python-http-server-listing:listing",
  "validationStatus": "VALIDATED"
}
