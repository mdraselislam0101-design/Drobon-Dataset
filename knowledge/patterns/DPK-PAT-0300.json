{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0300",
  "title": "Signal: plain left open (kafka) — review required",
  "targets": [
    "kafka"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:listeners\\s*=[^\\n]*PLAINTEXT)"
  },
  "scope": "Single-line lexical match on open settings for plain.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "listeners=PLAINTEXT://:9092",
      "match": true
    },
    {
      "line": "# audit: listeners=PLAINTEXT://:9092 present",
      "match": true
    },
    {
      "line": "listeners=SASL_SSL://:9093",
      "match": false
    },
    {
      "line": "# verified: listeners=SASL_SSL://:9093",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-261"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:kafka:plain",
  "validationStatus": "VALIDATED"
}
