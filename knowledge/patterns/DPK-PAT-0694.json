{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0694",
  "title": "Signal: Permissive Kubernetes pod (hostpath) — review required",
  "targets": [
    "k8s"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:hostPath\\s*:)"
  },
  "scope": "Single-line lexical match on Kubernetes manifests.",
  "limitations": "Lexical, line-based: matches the grant.",
  "examples": [
    {
      "line": "hostPath:",
      "match": true
    },
    {
      "line": "# audit: hostPath: present",
      "match": true
    },
    {
      "line": "emptyDir: {}",
      "match": false
    },
    {
      "line": "# verified: emptyDir: {}",
      "match": false
    }
  ],
  "fpNotes": "Node agents are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-577"
  ],
  "origin": "original-authored",
  "cell": "sast:k8s-more:k8s:hostpath",
  "validationStatus": "VALIDATED"
}
