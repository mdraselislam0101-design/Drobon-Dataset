{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0325",
  "title": "Signal: SQL built by concatenation (julia) — review required",
  "targets": [
    "julia"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.execute\\s*\\([^)]*(?:\\+|\\$)"
  },
  "scope": "Single-line lexical match on assembled SQL in julia code.",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "DB.execute(\"SELECT $q\")",
      "match": true
    },
    {
      "line": "# audit: DB.execute(\"SELECT $q\") present",
      "match": true
    },
    {
      "line": "DB.execute(FIXED)",
      "match": false
    },
    {
      "line": "# verified: DB.execute(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-286"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-langs:julia",
  "validationStatus": "VALIDATED"
}
