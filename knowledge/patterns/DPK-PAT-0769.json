{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0769",
  "title": "Signal: Rails protection weakened (skipverify) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:skip_before_action\\s+:verify_authenticity_token)"
  },
  "scope": "Single-line lexical match on Rails config.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "skip_before_action :verify_authenticity_token",
      "match": true
    },
    {
      "line": "# audit: skip_before_action :verify_authenticity_token present",
      "match": true
    },
    {
      "line": "before_action :verify_authenticity_token",
      "match": false
    },
    {
      "line": "# verified: before_action :verify_authenticity_token",
      "match": false
    }
  ],
  "fpNotes": "Development config is the common false positive.",
  "linkedRules": [
    "DPK-SAST-652"
  ],
  "origin": "original-authored",
  "cell": "sast:rails-secure:ruby:skipverify",
  "validationStatus": "VALIDATED"
}
