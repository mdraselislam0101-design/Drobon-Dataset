{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0810",
  "title": "Signal: Weak SSH daemon setting (alive) — review required",
  "targets": [
    "sshd"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:ClientAliveInterval\\s+0\\b)"
  },
  "scope": "Single-line lexical match on sshd settings.",
  "limitations": "Lexical, line-based: matches the setting regardless of Match blocks.",
  "examples": [
    {
      "line": "ClientAliveInterval 0",
      "match": true
    },
    {
      "line": "# audit: ClientAliveInterval 0 present",
      "match": true
    },
    {
      "line": "ClientAliveInterval 300",
      "match": false
    },
    {
      "line": "# verified: ClientAliveInterval 300",
      "match": false
    }
  ],
  "fpNotes": "Bastion-specific needs are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-693"
  ],
  "origin": "original-authored",
  "cell": "sast:sshd-strict:sshd:alive",
  "validationStatus": "VALIDATED"
}
