{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3097",
  "title": "Signal: Build plugin skipped",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.build.plugins[].configuration.skip",
      "valuePattern": "^true$"
    }
  },
  "scope": "A pom.xml file that declares a plugin whose `skip` configuration is true.",
  "limitations": "It matches a plugin whose `skip` configuration is true in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ],
          "build": {
            "plugins": [
              {
                "groupId": "org.apache.maven.plugins",
                "artifactId": "maven-enforcer-plugin",
                "configuration": {
                  "skip": "true"
                }
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "licenses": [
            {
              "name": "Apache-2.0"
            }
          ],
          "repositories": [
            {
              "id": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ],
          "build": {
            "plugins": [
              {
                "groupId": "org.apache.maven.plugins",
                "artifactId": "maven-dependency-plugin",
                "configuration": {
                  "skip": true
                }
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
