{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2326",
  "title": "Signal: Cargo dependency declared with an open lower bound",
  "targets": [
    "cargo"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*.version",
      "valuePattern": "^>=\\s*\\d{1,3}(?:\\.\\d{1,3}){0,2}$"
    }
  },
  "scope": "A Cargo.toml file that declares a `>=` requirement with no upper bound.",
  "limitations": "It matches a `>=` requirement with no upper bound in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "serde": {
            "version": ">=1.0"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "tokio": {
            "version": ">=1.40.0"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "tokio": {
            "version": ">=1.40, <2"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Cargo.toml that mentions a `>=` requirement with no upper bound in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0189"
  ],
  "origin": "original-authored",
  "cell": "sca:cargo-dependency-open-bound",
  "validationStatus": "VALIDATED"
}
