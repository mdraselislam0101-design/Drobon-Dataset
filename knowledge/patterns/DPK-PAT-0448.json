{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0448",
  "title": "Signal: Cleartext ws:// URL (universal) — review required",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "ws://[A-Za-z0-9]"
  },
  "scope": "Single-line lexical match on ws:// literals.",
  "limitations": "Lexical, line-based: matches the scheme regardless of channel sensitivity.",
  "examples": [
    {
      "line": "sock = \"ws://api.example.com/s\"",
      "match": true
    },
    {
      "line": "# audit: sock = \"ws://api.example.com/s\" present",
      "match": true
    },
    {
      "line": "sock = \"wss://api.example.com/s\"",
      "match": false
    },
    {
      "line": "# verified: sock = \"wss://api.example.com/s\"",
      "match": false
    }
  ],
  "fpNotes": "Local development sockets are the common false positive.",
  "linkedRules": [
    "DPK-SAST-409"
  ],
  "origin": "original-authored",
  "cell": "sast:ws-literal:universal",
  "validationStatus": "VALIDATED"
}
