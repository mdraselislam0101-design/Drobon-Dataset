{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1460",
  "title": "Signal: .yarnrc file served from the web root",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*(?:^|\\n)registry\\s*[= ])(?=[\\s\\S]*(?:^|\\n)@[a-z0-9-]{1,40}:registry)"
    }
  },
  "scope": "One response body containing Yarn configuration settings at line starts.",
  "limitations": "One response body. The rule reads the configuration shape; it does not resolve the registries it names.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "registry \"https://npm.internal/repository/npm-group/\"\n@shop:registry \"https://npm.internal/repository/npm-shop/\"\nnetwork-timeout 600000\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "registry=https://npm.internal/\nproxy=http://proxy.internal:3128\n@platform:registry=https://npm.internal/platform/\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"name\":\"shop\",\"version\":\"1.4.0\",\"dependencies\":{\"express\":\"4.19.2\"}}\n"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/deploy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Deployment guide</title></head><body><p>Point the registry at the internal mirror.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that shows a .yarnrc snippet is reported when it reproduces a registry line; a package.json file is covered by its own rule.",
  "linkedRules": [
    "DPK-DAST-391"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-artefact-yarnrc:yarnrc-served",
  "validationStatus": "VALIDATED"
}
