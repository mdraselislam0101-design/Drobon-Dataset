{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0870",
  "title": "Signal: Possible a Mailchimp key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "[a-f0-9]{32,}-us[0-9]{1,}"
  },
  "scope": "Single-line shape match for a Mailchimp key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-us1\"",
      "match": true
    },
    {
      "line": "# audit: key = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-us1\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-082"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-2:mailchimp-key",
  "validationStatus": "VALIDATED"
}
