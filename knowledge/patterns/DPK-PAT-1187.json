{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1187",
  "title": "Signal: Refresh header uses a protocol-relative target",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Refresh",
      "valuePattern": "(?:^|;)\\s*url\\s*=\\s*['\"]?\\s*//"
    }
  },
  "scope": "One response whose Refresh header contains url= followed by a protocol-relative target.",
  "limitations": "One Refresh value. The rule does not resolve the target, follow the navigation, or judge whether the destination is trusted.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "0; url=//evil.example/x"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "5; URL='//cdn.example/a'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "0; url=/home"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "0; url=https://app.example/home"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "0; url=http://app.example/home"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "30"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberate cross-origin jump to a trusted sibling host is reported; the header cannot express that trust.",
  "linkedRules": [
    "DPK-DAST-118"
  ],
  "origin": "original-authored",
  "cell": "dast:refresh-protocol-relative:url",
  "validationStatus": "VALIDATED"
}
