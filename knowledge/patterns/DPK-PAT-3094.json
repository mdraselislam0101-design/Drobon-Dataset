{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3094",
  "title": "Signal: go.mod with no module path",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "module"
    }
  },
  "scope": "A go.mod file that declares a module file that declares no module path.",
  "limitations": "It matches a module file that declares no module path in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.mod",
      "document": {
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "github.com/acme/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": false
    }
  ],
  "fpNotes": "A go.mod that mentions a module file that declares no module path in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0957"
  ],
  "origin": "original-authored",
  "cell": "sca:go-module-directive-absent",
  "validationStatus": "VALIDATED"
}
