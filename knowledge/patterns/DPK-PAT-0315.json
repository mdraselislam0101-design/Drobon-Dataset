{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0315",
  "title": "Signal: SHA-1 package use (tcl) — review required",
  "targets": [
    "tcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "sha1::sha1"
  },
  "scope": "Single-line lexical match on SHA-1 use in tcl code.",
  "limitations": "Lexical, line-based: matches the package name.",
  "examples": [
    {
      "line": "sha1::sha1 $x",
      "match": true
    },
    {
      "line": "# audit: sha1::sha1 $x present",
      "match": true
    },
    {
      "line": "sha256::sha256 $x",
      "match": false
    },
    {
      "line": "# verified: sha256::sha256 $x",
      "match": false
    }
  ],
  "fpNotes": "Interop is the common false positive.",
  "linkedRules": [
    "DPK-SAST-276"
  ],
  "origin": "original-authored",
  "cell": "sast:sha1-flag-extra:tcl",
  "validationStatus": "VALIDATED"
}
