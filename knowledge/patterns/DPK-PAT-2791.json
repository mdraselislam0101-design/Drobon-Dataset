{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2791",
  "title": "Signal: Pre-release versions are accepted by the resolver",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "pipenv.allow_prereleases",
      "valuePattern": "^true$"
    }
  },
  "scope": "A Pipfile file that declares a Pipfile that allows pre-releases.",
  "limitations": "It matches a Pipfile that allows pre-releases in the parsed Pipfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": true
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": "true"
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": false
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": "false"
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Pipfile that mentions a Pipfile that allows pre-releases in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0654"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-pipfile-prereleases-allowed",
  "validationStatus": "VALIDATED"
}
