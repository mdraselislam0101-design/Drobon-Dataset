{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1308",
  "title": "Signal: package.json manifest served from the web root",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*\"dependencies\")(?=[\\s\\S]*\"name\")"
    }
  },
  "scope": "One response whose body is a package.json manifest with name and dependencies fields.",
  "limitations": "One response body. The rule reports the manifest; it does not look up any version against an advisory source and makes no claim that a pinned version is vulnerable.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"name\":\"shop-web\",\"version\":\"4.2.1\",\"scripts\":{\"build\":\"vite build\"},\"dependencies\":{\"express\":\"4.18.2\",\"axios\":\"0.21.1\",\"lodash\":\"4.17.19\"},\"devDependencies\":{\"vite\":\"4.5.0\"}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"name\":\"internal-api\",\"version\":\"1.3.0\",\"dependencies\":{\"jsonwebtoken\":\"8.5.1\",\"pg\":\"8.11.3\"},\"engines\":{\"node\":\">=18\"}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{:\"shop-web\",\"version\":\"4.2.1\",\"scripts\":{\"build\":\"vite build\"},:{\"express\":\"4.18.2\",\"axios\":\"0.21.1\",\"lodash\":\"4.17.19\"},\"devDependencies\":{\"vite\":\"4.5.0\"}}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A JavaScript bundle that contains the word dependencies but not the manifest fields is not reported.",
  "linkedRules": [
    "DPK-DAST-239"
  ],
  "origin": "original-authored",
  "cell": "dast:body-package-json-served:package-json-served",
  "validationStatus": "VALIDATED"
}
