{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0836",
  "title": "Signal: TLS verification disabled (noop) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:NoopHostnameVerifier)"
  },
  "scope": "Single-line lexical match on TLS-disabling settings (noop).",
  "limitations": "Lexical, line-based: matches the switch regardless of environment.",
  "examples": [
    {
      "line": "NoopHostnameVerifier.INSTANCE",
      "match": true
    },
    {
      "line": "# audit: NoopHostnameVerifier.INSTANCE present",
      "match": true
    },
    {
      "line": "DefaultHostnameVerifier.INSTANCE",
      "match": false
    },
    {
      "line": "# verified: DefaultHostnameVerifier.INSTANCE",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive.",
  "linkedRules": [
    "DPK-SAST-719"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-4:java:noop",
  "validationStatus": "VALIDATED"
}
