{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2181",
  "title": "Signal: Lockfile integrity field present but empty",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.integrity",
      "valuePattern": "^$"
    }
  },
  "scope": "A package-lock.json file that declares an integrity field that is present but empty.",
  "limitations": "It matches an integrity field that is present but empty in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "integrity": ""
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.1.0",
            "integrity": ""
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org/x/-/x-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.1.0",
            "integrity": "sha512-AAAABBBB"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A lockfile written by a tool that emits an empty string deliberately is still reported; the empty value is the finding.",
  "linkedRules": [
    "DPK-SCA-0044"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-integrity-empty",
  "validationStatus": "VALIDATED"
}
