{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0563",
  "title": "Signal: Infrastructure banner disclosed (X-Varnish header)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-Varnish",
      "valuePattern": "[^ ]"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Banner check: version visibility alone is not exploitability.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Varnish": "123 456"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Varnish": "789"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Varnish": ""
        }
      },
      "match": false
    }
  ],
  "fpNotes": "CDN-added banners are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-038"
  ],
  "origin": "original-authored",
  "cell": "dast:banner-more:xvarnish",
  "validationStatus": "VALIDATED"
}
