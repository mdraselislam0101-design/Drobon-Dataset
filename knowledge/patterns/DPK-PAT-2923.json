{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2923",
  "title": "Signal: Conan remote with TLS verification off",
  "targets": [
    "conan"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "remotes.*.verify_ssl",
      "valuePattern": "^false$"
    }
  },
  "scope": "A conanfile.py file that declares a `verify_ssl` switch set to false.",
  "limitations": "It matches a `verify_ssl` switch set to false in the parsed conanfile.py; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "conanfile.py",
      "document": {
        "requires": [
          "zlib/1.3.1"
        ],
        "remotes": {
          "acme": {
            "url": "https://conan.acme.example",
            "verify_ssl": false
          }
        }
      },
      "match": true
    },
    {
      "file": "conanfile.py",
      "document": {
        "requires": [
          "zlib/1.3.1"
        ],
        "remotes": {
          "acme": {
            "url": "https://conan.acme.example",
            "verify_ssl": true
          },
          "internal": {
            "url": "https://10.24.8.9",
            "verify_ssl": "false"
          }
        }
      },
      "match": true
    },
    {
      "file": "conanfile.py",
      "document": {
        "requires": [
          "zlib/1.3.1"
        ],
        "remotes": {
          "acme": {
            "url": "https://conan.acme.example",
            "verify_ssl": true
          }
        }
      },
      "match": false
    },
    {
      "file": "conanfile.py",
      "document": {
        "requires": [
          "zlib/1.3.1"
        ],
        "remotes": {
          "acme": {
            "url": "https://conan.acme.example",
            "verify_ssl": true
          },
          "conancenter": {
            "url": "https://center.conan.io",
            "verify_ssl": true
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A conanfile.py that mentions a `verify_ssl` switch set to false in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0786"
  ],
  "origin": "original-authored",
  "cell": "sca:conan-remote-ssl-disabled",
  "validationStatus": "VALIDATED"
}
