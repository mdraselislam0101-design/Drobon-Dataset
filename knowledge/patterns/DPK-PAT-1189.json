{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1189",
  "title": "Signal: X-Permitted-Cross-Domain-Policies permits every policy file",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-Permitted-Cross-Domain-Policies",
      "valuePattern": "^all$"
    }
  },
  "scope": "One response whose X-Permitted-Cross-Domain-Policies value is all.",
  "limitations": "One header value. It grades the declared policy only, does not fetch the policy file it governs, and does not apply to clients that ignore the header.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Permitted-Cross-Domain-Policies": "all"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Permitted-Cross-Domain-Policies": "ALL"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Permitted-Cross-Domain-Policies": "none"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Permitted-Cross-Domain-Policies": "master-only"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Permitted-Cross-Domain-Policies": "all, none"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A site that does not serve cross-domain policy files at all is still reported; the header expresses intent, not an existing file.",
  "linkedRules": [
    "DPK-DAST-120"
  ],
  "origin": "original-authored",
  "cell": "dast:x-permitted-cross-domain-policies-all:all",
  "validationStatus": "VALIDATED"
}
