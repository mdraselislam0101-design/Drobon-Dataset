{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1585",
  "title": "Signal: Security answer rendered into a form field",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<input(?=[^>]{0,200}(?:name|id)\\s*=\\s*[\\\"'][^\\\"']{0,50}(?:security[ _-]?answer|secret[ _-]?answer|mothers?[ _-]?maiden)[^\\\"']{0,50}[\\\"'])(?=[^>]{0,200}value\\s*=\\s*[\\\"'][^\\\"']{2,80}[\\\"'])"
    }
  },
  "scope": "An input named security answer, secret answer or mother's maiden name that carries a literal value.",
  "limitations": "One response body. It matches the input name and a short literal value, not the answer's correctness.",
  "examples": [
    {
      "observation": {
        "url": "https://bank.example/profile/recovery",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<label>First school</label><input name=\"security_answer\" value=\"Greenfield\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/profile/recovery",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<input id=\"mothers_maiden_name\" value=\"Chowdhury\" type=\"text\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/profile/recovery",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<input name=\"security_answer\" value=\"\" type=\"text\">"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that shows the question with an empty answer field is not reported.",
  "linkedRules": [
    "DPK-DAST-516"
  ],
  "origin": "original-authored",
  "cell": "dast:bank-security-answer-with-value:bank-security-answer-with-value",
  "validationStatus": "VALIDATED"
}
