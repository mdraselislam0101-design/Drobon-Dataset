{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0955",
  "title": "Signal: CORS policy trusts the null origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Allow-Origin",
      "valuePattern": "^null$"
    }
  },
  "scope": "Single response header value: Access-Control-Allow-Origin equals null.",
  "limitations": "Header value check: it cannot confirm that credentials or sensitive data travel with the response.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "null"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://app.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://null.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": " NULL "
        }
      },
      "match": true
    }
  ],
  "fpNotes": "Responses meant for local tooling that intentionally accepts null are the accepted case.",
  "linkedRules": [
    "DPK-DAST-058"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-null-origin:null",
  "validationStatus": "VALIDATED"
}
