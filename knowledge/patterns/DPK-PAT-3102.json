{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3102",
  "title": "Signal: Resolution without metadata source policy",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "dependencyResolutionManagement.metadataSources"
    }
  },
  "scope": "A settings.gradle file that declares a setup that accepts whatever metadata variant a repository serves.",
  "limitations": "It matches a setup that accepts whatever metadata variant a repository serves in the parsed settings.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": []
        }
      },
      "match": true
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "metadataSources": {
            "gradleMetadata": true
          }
        }
      },
      "match": false
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "metadataSources": {
            "mavenPom": true
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A settings.gradle that mentions a setup that accepts whatever metadata variant a repository serves in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0965"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-metadata-source-absent",
  "validationStatus": "VALIDATED"
}
