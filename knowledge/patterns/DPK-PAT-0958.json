{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0958",
  "title": "Signal: Weak Content-Security-Policy (unsafe-eval)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "'unsafe-eval'"
    }
  },
  "scope": "Single Content-Security-Policy header value: unsafe-eval appears in any directive.",
  "limitations": "Header value check on the token. Policies that also set a nonce for every script still list unsafe-eval, and this check flags them.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self' 'unsafe-eval'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "Legacy applications that need eval until a rewrite are the accepted exception.",
  "linkedRules": [
    "DPK-DAST-061"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-unsafe-eval:unsafe-eval",
  "validationStatus": "VALIDATED"
}
