{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0958",
  "title": "Signal: Weak Content-Security-Policy (unsafe-eval)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "(?:^|;)\\s*script-src(?=[\\s;]|$)[^;]*'unsafe-eval'|^(?!.*(?:^|;)\\s*script-src(?=[\\s;]|$)).*(?:^|;)\\s*default-src(?=[\\s;]|$)[^;]*'unsafe-eval'"
    }
  },
  "scope": "Single Content-Security-Policy header value: unsafe-eval appears in any directive.",
  "limitations": "Directive-scoped value check: only script-src, script-src-elem and the default-src fallback are read, because 'unsafe-eval' has no meaning in another directive. A nonce does not neutralise 'unsafe-eval' (only 'unsafe-inline' is neutralised), so policies that nonce every script are still reported.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self' 'unsafe-eval'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'unsafe-eval'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "img-src 'self'; script-src 'unsafe-eval'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "style-src 'unsafe-eval'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src-attr 'unsafe-eval'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'unsafe-eval'; script-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'; default-src 'unsafe-eval'"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Legacy applications that need eval until a rewrite are the accepted exception.",
  "linkedRules": [
    "DPK-DAST-061"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-unsafe-eval:unsafe-eval",
  "validationStatus": "VALIDATED"
}
