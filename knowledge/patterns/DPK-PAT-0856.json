{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0856",
  "title": "Signal: Possible an Asana token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "1/[0-9]{12,}:[a-f0-9]{24,}"
  },
  "scope": "Single-line shape match for an Asana token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"1/111111111111:aaaaaaaaaaaaaaaaaaaaaaaa\"",
      "match": true
    },
    {
      "line": "# audit: token = \"1/111111111111:aaaaaaaaaaaaaaaaaaaaaaaa\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-068"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-2:asana-pat",
  "validationStatus": "VALIDATED"
}
