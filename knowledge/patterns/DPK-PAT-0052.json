{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0052",
  "title": "Signal: Weak Content-Security-Policy default-src wildcard header value",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "default-src(?=\\s)[^;*]*?(?<=\\s)\\*(?=\\s*(?:;|$))"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Value check: it cannot confirm the deployment context.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *; script-src 'self'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self' *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *.example.com"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; script-src *"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Transitional deployments are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-022"
  ],
  "origin": "original-authored",
  "cell": "dast:header-weak:csp-wildcard",
  "validationStatus": "VALIDATED"
}
