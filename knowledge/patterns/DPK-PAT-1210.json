{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1210",
  "title": "Signal: WildFly or JBoss error report disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*(?:WildFly|JBoss Web))(?=[\\s\\S]*Error Report)"
    }
  },
  "scope": "One response whose body contains a WildFly or JBoss Web marker and an Error Report heading.",
  "limitations": "Two body markers. A page that mentions WildFly in documentation is not matched; the error report section must also be present.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/boom",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<h1>Error Report</h1><p>WildFly 31.0.1.Final (WildFly Core 23.0.2.Final)</p><p>java.lang.RuntimeException: boom</p>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api/boom",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<h1>Error Report</h1><address>JBoss Web/7.0</address>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>Home</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>WildFly deployments set the error page in web.xml.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "An internal operations page that quotes an error report is reported only when both markers are reproduced.",
  "linkedRules": [
    "DPK-DAST-141"
  ],
  "origin": "original-authored",
  "cell": "dast:body-wildfly-error-report:body-wildfly-error-report",
  "validationStatus": "VALIDATED"
}
