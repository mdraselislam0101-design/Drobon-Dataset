{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0197",
  "title": "Signal: Sensitive value in log call (awk) — review required",
  "targets": [
    "awk"
  ],
  "signal": {
    "kind": "regex",
    "source": "print\\s+[^;\\n]*(?:password|passwd|secret|token)"
  },
  "scope": "Single-line lexical match on credential-named log values in awk code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "print \"password=\" pw",
      "match": true
    },
    {
      "line": "# audit: print \"password=\" pw present",
      "match": true
    },
    {
      "line": "print \"user=\" u",
      "match": false
    },
    {
      "line": "# verified: print \"user=\" u",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-158"
  ],
  "origin": "original-authored",
  "cell": "sast:log-langs:awk",
  "validationStatus": "VALIDATED"
}
