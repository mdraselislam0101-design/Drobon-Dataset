{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0173",
  "title": "Signal: Framework SQL built from input (mybatis) — review required",
  "targets": [
    "xml"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\$\\{[^}]*\\}"
  },
  "scope": "Single-line lexical match on assembled framework SQL (mybatis).",
  "limitations": "Lexical, line-based: any assembled query matches, including trusted ones.",
  "examples": [
    {
      "line": "SELECT ${col} FROM t",
      "match": true
    },
    {
      "line": "# audit: SELECT ${col} FROM t present",
      "match": true
    },
    {
      "line": "SELECT #{col} FROM t",
      "match": false
    },
    {
      "line": "# verified: SELECT #{col} FROM t",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-134"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli:xml:mybatis",
  "validationStatus": "VALIDATED"
}
