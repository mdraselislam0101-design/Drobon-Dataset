{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1443",
  "title": "Signal: Phoenix LiveDashboard disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*LiveDashboard)(?=[\\s\\S]*phoenix_live_view)"
    }
  },
  "scope": "One response body containing the LiveDashboard shell and the Phoenix runtime marker.",
  "limitations": "One response body. The rule reports the dashboard shell; it does not subscribe to a live view.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/dashboard",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>LiveDashboard · app</title></head><body><div data-phx-main=\"true\" id=\"phx-F1a2\"></div><p>Powered by phoenix_live_view</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/admin/dashboard/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>LiveDashboard</h1><p>Processes 812 · Ports 4</p><p>phoenix_live_view 0.20.14</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Shop</title></head><body><h1>Shop</h1></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/ops",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>The dashboard is available on the admin host.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that links to the dashboard in prose is not reported, because the shell markup is required.",
  "linkedRules": [
    "DPK-DAST-374"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-page-phoenix-live-dashboard:phoenix-live-dashboard",
  "validationStatus": "VALIDATED"
}
