{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1314",
  "title": "Signal: Terraform state file served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*\"terraform_version\")(?=[\\s\\S]*\"resources\")"
    }
  },
  "scope": "One response whose body is a Terraform state document with terraform_version and resources fields.",
  "limitations": "One response body. The rule reports the state schema; it does not parse the stored attributes and cannot enumerate which secrets a particular state holds.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"version\":4,\"terraform_version\":\"1.6.4\",\"serial\":12,\"lineage\":\"abc-123\",\"outputs\":{\"db_password\":{\"value\":\"hunter2\",\"type\":\"string\"}},\"resources\":[{\"mode\":\"managed\",\"type\":\"aws_db_instance\",\"name\":\"main\",\"instances\":[{\"attributes\":{\"password\":\"hunter2\"}}]}]}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"version\":4,\"terraform_version\":\"1.5.7\",\"serial\":3,\"resources\":[{\"mode\":\"managed\",\"type\":\"aws_s3_bucket\",\"name\":\"assets\"}],\"terraform_version_note\":\"legacy\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"version\":4,:\"1.6.4\",\"serial\":12,\"lineage\":\"abc-123\",\"outputs\":{\"db_password\":{\"value\":\"hunter2\",\"type\":\"string\"}},:[{\"mode\":\"managed\",\"type\":\"aws_db_instance\",\"name\":\"main\",\"instances\":[{\"attributes\":{\"password\":\"hunter2\"}}]}]}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A hand-written JSON document that happens to use those two field names is reported as well; the fields together are the state schema.",
  "linkedRules": [
    "DPK-DAST-245"
  ],
  "origin": "original-authored",
  "cell": "dast:body-terraform-state:terraform-state",
  "validationStatus": "VALIDATED"
}
