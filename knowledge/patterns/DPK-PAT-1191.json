{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1191",
  "title": "Signal: Framework version disclosed (X-AspNetMvc-Version header)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-AspNetMvc-Version",
      "valuePattern": "^\\s*\\d"
    }
  },
  "scope": "One response that carries a non-empty X-AspNetMvc-Version header.",
  "limitations": "One header value. The rule reports the advertised version; it does not claim the version is vulnerable.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-AspNetMvc-Version": "5.2"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "X-AspNetMvc-Version": "4.0"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-AspNetMvc-Version": ""
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-AspNet-Version": "4.0.30319"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "An internal staging host with the same defaults is reported; the version is still disclosed on every response.",
  "linkedRules": [
    "DPK-DAST-122"
  ],
  "origin": "original-authored",
  "cell": "dast:banner-aspnetmvc-version:aspnetmvc-version",
  "validationStatus": "VALIDATED"
}
