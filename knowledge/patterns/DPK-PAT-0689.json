  "title": "Signal: Permissive Kubernetes pod (clusteradmin) — review required",
  "targets": [
    "k8s"
  ],
  "signal": {
    "kind": "regex",
    "source": "cluster-admin"
  },
  "scope": "Single-line lexical match on Kubernetes manifests.",
  "limitations": "Lexical, line-based: matches the grant.",
  "examples": [
    {
      "line": "name: cluster-admin",
      "match": true
    },
    {
      "line": "# audit: name: cluster-admin present",
      "match": true
    },
    {
      "line": "name: view",
      "match": false
    },
    {
      "line": "# verified: name: view",
      "match": false
    }
  ],
  "fpNotes": "Node agents are the rare accepted case.",
