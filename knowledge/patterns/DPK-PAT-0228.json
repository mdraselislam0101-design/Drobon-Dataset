{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0228",
  "title": "Signal: Mobile cleartext traffic allowed (nsallows) — review required",
  "targets": [
    "xml"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:NSAllowsArbitraryLoads)"
  },
  "scope": "Single-line lexical match on the manifest flag.",
  "limitations": "Lexical, line-based: matches the flag.",
  "examples": [
    {
      "line": "<key>NSAllowsArbitraryLoads</key>",
      "match": true
    },
    {
      "line": "# audit: <key>NSAllowsArbitraryLoads</key> present",
      "match": true
    },
    {
      "line": "<key>NSAllowsLocalNetworking</key>",
      "match": false
    },
    {
      "line": "# verified: <key>NSAllowsLocalNetworking</key>",
      "match": false
    }
  ],
  "fpNotes": "Local-only endpoints are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-189"
  ],
  "origin": "original-authored",
  "cell": "sast:mobile-transport:xml:nsallows",
  "validationStatus": "VALIDATED"
}
