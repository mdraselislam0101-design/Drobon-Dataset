{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0004",
  "title": "Signal: Cookie set without the Secure flag",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "cookie-missing-flag",
      "flag": "Secure"
    }
  },
  "scope": "Legacy signal mirrored from DPK-DAST-004.",
  "limitations": "One header value counts as one cookie: a folded multi-cookie single value may under-flag. Responses that set no cookies never match.",
  "examples": [
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "set-cookie": "id=1; Path=/"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "set-cookie": "id=1; Path=/; Secure; HttpOnly"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "One header value counts as one cookie: a folded multi-cookie single value may under-flag. Responses that set no cookies never match.",
  "linkedRules": [
    "DPK-DAST-004"
  ],
  "origin": "original-authored",
  "cell": "legacy:DPK-DAST-004",
  "validationStatus": "VALIDATED"
}
