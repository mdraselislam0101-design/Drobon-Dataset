{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0004",
  "title": "Signal: Cookie set without the Secure flag",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "cookie-missing-flag",
      "flag": "Secure"
    }
  },
  "scope": "Legacy signal mirrored from DPK-DAST-004.",
  "limitations": "One header value counts as one cookie: a folded multi-cookie single value may under-flag. A flag attribute ignores its value, so `Secure=0` still enables Secure and is not reported. A header a user agent discards (no name=value pair, or a control character) stores no cookie and is not reported. A `SameSite=None` cookie without `Secure` is refused by browsers and is reported by DPK-DAST-071 instead, so this rule stays silent on it. Responses that set no cookies never match.",
  "examples": [
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "set-cookie": "id=1; Path=/"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "set-cookie": "id=1; Path=/; Secure; HttpOnly"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "set-cookie": "id=1; Path=/; HttpOnly; SameSite=Lax; Secure"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "set-cookie": "id=1; Secure=0"
        },
        "body": ""
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "set-cookie": "no-equals-sign"
        },
        "body": ""
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "set-cookie": "id=1; secure; httponly"
        },
        "body": ""
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "set-cookie": "id=1; SameSite=Lax"
        },
        "body": ""
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "set-cookie": "id=1; SameSite=None"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "set-cookie": "id=1; SameSite=None; Secure"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "set-cookie": [
            "id=1; Path=/; Secure",
            "theme=dark; Path=/"
          ]
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "set-cookie": [
            "id=1; Secure",
            "theme=dark; Secure; HttpOnly"
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "One header value counts as one cookie: a folded multi-cookie single value may under-flag. A flag attribute ignores its value, so `Secure=0` still enables Secure and is not reported. A header a user agent discards (no name=value pair, or a control character) stores no cookie and is not reported. A `SameSite=None` cookie without `Secure` is refused by browsers and is reported by DPK-DAST-071 instead, so this rule stays silent on it. Responses that set no cookies never match.",
  "linkedRules": [
    "DPK-DAST-004"
  ],
  "origin": "original-authored",
  "cell": "legacy:DPK-DAST-004",
  "validationStatus": "VALIDATED"
}
