{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2357",
  "title": "Signal: Dart dependency fetched from a git remote",
  "targets": [
    "pub"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*.git.url",
      "valuePattern": "^https?://"
    }
  },
  "scope": "A pubspec.yaml file that declares a pubspec dependency sourced from git.",
  "limitations": "It matches a pubspec dependency sourced from git in the parsed pubspec.yaml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pubspec.yaml",
      "document": {
        "dependencies": {
          "acme_sdk": {
            "git": {
              "url": "https://github.com/acme/sdk.git",
              "ref": "9f2c4a1"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "dependencies": {
          "acme_cli": {
            "git": {
              "url": "https://github.com/acme/cli.git",
              "path": "packages/cli"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "dependencies": {
          "http": "^1.2.0"
        }
      },
      "match": false
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "dependencies": {
          "acme_sdk": {
            "hosted": "https://pub.acme.example"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pubspec.yaml that mentions a pubspec dependency sourced from git in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0220"
  ],
  "origin": "original-authored",
  "cell": "sca:pub-dependency-git",
  "validationStatus": "VALIDATED"
}
