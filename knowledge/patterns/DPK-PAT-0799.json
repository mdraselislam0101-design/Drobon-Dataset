{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0799",
  "title": "Signal: Risky Spring setting (h2) — review required",
  "targets": [
    "properties"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:spring\\.h2\\.console\\.enabled\\s*=\\s*true)"
  },
  "scope": "Single-line lexical match on Spring config.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "spring.h2.console.enabled=true",
      "match": true
    },
    {
      "line": "# audit: spring.h2.console.enabled=true present",
      "match": true
    },
    {
      "line": "spring.h2.console.enabled=false",
      "match": false
    },
    {
      "line": "# verified: spring.h2.console.enabled=false",
      "match": false
    }
  ],
  "fpNotes": "Local development is the common false positive.",
  "linkedRules": [
    "DPK-SAST-682"
  ],
  "origin": "original-authored",
  "cell": "sast:spring-risk:properties:h2",
  "validationStatus": "VALIDATED"
}
