{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0318",
  "title": "Signal: SQL built by concatenation (csharp) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:ExecuteReader\\s*\\((?:[^()]|\\([^()]*\\))*\\+)|\\$\\\"(?:SELECT|INSERT|UPDATE|DELETE|MERGE|EXEC|WITH)[^\\\"]*\\{"
  },
  "scope": "Single-line lexical match on concatenated SQL in csharp code.",
  "limitations": "Lexical, line-based: any concatenated query matches, including trusted assembly. Input trust needs human review.",
  "examples": [
    {
      "line": "cmd.ExecuteReader(\"SELECT \" + id)",
      "match": true
    },
    {
      "line": "# audit: cmd.ExecuteReader(\"SELECT \" + id) present",
      "match": true
    },
    {
      "line": "cmd.ExecuteReader(FIXED)",
      "match": false
    },
    {
      "line": "# verified: cmd.ExecuteReader(FIXED)",
      "match": false
    },
    {
      "line": "cmd.ExecuteReader(BuildSql(name) + \" -- tail\");",
      "match": true
    },
    {
      "line": "cmd.ExecuteReader($\"INSERT INTO logs VALUES ('{user}')\");",
      "match": true
    },
    {
      "line": "cmd.ExecuteReader(FIXED_QUERY);",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed column lists or trusted fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-279"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-concat:csharp",
  "validationStatus": "VALIDATED"
}
