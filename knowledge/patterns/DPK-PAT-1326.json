{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1326",
  "title": "Signal: Removed Public-Key-Pins header present",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Public-Key-Pins",
      "valuePattern": "\\S"
    }
  },
  "scope": "One response that carries a Public-Key-Pins header.",
  "limitations": "One header value. The rule reports the removed header; it does not evaluate the pin list and cannot say whether any client still honours it.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Public-Key-Pins": "pin-sha256=\"abc=\"; max-age=5184000"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Public-Key-Pins": "max-age=100; pin-sha256=\"def=\""
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=63072000"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A prepared-but-unshipped configuration is not observable; the rule reports the header only when it is sent.",
  "linkedRules": [
    "DPK-DAST-257"
  ],
  "origin": "original-authored",
  "cell": "dast:public-key-pins-obsolete:key-pins-obsolete",
  "validationStatus": "VALIDATED"
}
