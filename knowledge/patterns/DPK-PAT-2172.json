{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2172",
  "title": "Signal: Git dependency that follows a branch name",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "#[A-Za-z][A-Za-z0-9._-]{1,40}$"
    }
  },
  "scope": "A package.json file that declares a git dependency whose fragment names a branch instead of a commit.",
  "limitations": "It matches a git dependency whose fragment names a branch instead of a commit in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "github:acme/sdk#main"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "git+https://github.com/acme/cli.git#develop"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "github:acme/sdk#9f2c4a1"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A fragment naming a tag is also mutable and is reported by the tag rule, not this one.",
  "linkedRules": [
    "DPK-SCA-0035"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-branch-fragment",
  "validationStatus": "VALIDATED"
}
