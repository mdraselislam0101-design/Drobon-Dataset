{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1461",
  "title": "Signal: Dagster UI is reachable without authentication",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<title>[^<]{0,60}Dagster"
    }
  },
  "scope": "One response body containing the Dagster UI shell.",
  "limitations": "One response body. The rule reports the UI shell; it does not launch a run.",
  "examples": [
    {
      "observation": {
        "url": "https://data.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Dagster</title></head><body><div id=\"root\" data-dagster-version=\"1.6\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://data.example/assets",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Dagster · Assets</title></head><body><p>assets: 42</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Data guide</title></head><body><p>The webserver serves the UI on port 3000.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/reports",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Reports</title></head><body><p>Weekly report is ready.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that names Dagster in prose is not reported, because the shell marker is required.",
  "linkedRules": [
    "DPK-DAST-392"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-console-dagster:dagster-ui",
  "validationStatus": "VALIDATED"
}
