{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0156",
  "title": "Signal: Framework SQL built from input (hibernate) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:createQuery\\s*\\([^)]*\\+)"
  },
  "scope": "Single-line lexical match on assembled SQL (hibernate).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "createQuery(\"FROM \" + e)",
      "match": true
    },
    {
      "line": "# audit: createQuery(\"FROM \" + e) present",
      "match": true
    },
    {
      "line": "createQuery(FIXED)",
      "match": false
    },
    {
      "line": "# verified: createQuery(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-117"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli-extra:java:hibernate",
  "validationStatus": "VALIDATED"
}
