{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0577",
  "title": "Signal: Unbounded buffer call vsprintf (c) — review required",
  "targets": [
    "c"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:vsprintf)\\s*\\("
  },
  "scope": "Single-line lexical match on the vsprintf call in c code.",
  "limitations": "Lexical, line-based: any vsprintf call matches.",
  "examples": [
    {
      "line": "vsprintf(payload)",
      "match": true
    },
    {
      "line": "out = vsprintf(data)",
      "match": true
    },
    {
      "line": "myvsprintf(x)",
      "match": false
    },
    {
      "line": "vsprintf_safe()",
      "match": false
    }
  ],
  "fpNotes": "Fixed small inputs are the common false positive.",
  "linkedRules": [
    "DPK-SAST-460"
  ],
  "origin": "original-authored",
  "cell": "sast:buffer-call:c",
  "validationStatus": "VALIDATED"
}
