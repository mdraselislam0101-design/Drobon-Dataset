{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3190",
  "title": "Signal: Possible a Replicate API token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "r8_[A-Za-z0-9]{40,}"
  },
  "scope": "Single-line shape match for a Replicate API token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"r8_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"r8_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-130"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-4:replicate-api-token",
  "validationStatus": "VALIDATED"
}
