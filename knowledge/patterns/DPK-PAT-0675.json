{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0675",
  "title": "Signal: Overly broad browser channel (postmessage) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:postMessage\\s*\\([^)]*\"\\*\")"
  },
  "scope": "Single-line lexical match on browser channels (postmessage).",
  "limitations": "Lexical, line-based: matches the channel.",
  "examples": [
    {
      "line": "w.postMessage(d, \"*\")",
      "match": true
    },
    {
      "line": "# audit: w.postMessage(d, \"*\") present",
      "match": true
    },
    {
      "line": "w.postMessage(d, origin)",
      "match": false
    },
    {
      "line": "# verified: w.postMessage(d, origin)",
      "match": false
    }
  ],
  "fpNotes": "Public broadcasts are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-558"
  ],
  "origin": "original-authored",
  "cell": "sast:js-browser:javascript:postmessage",
  "validationStatus": "VALIDATED"
}
