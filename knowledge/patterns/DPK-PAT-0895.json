{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0895",
  "title": "Signal: SQL built by concatenation (clojure) — review required",
  "targets": [
    "clojure"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\(query\\s+[^)]*str\\s"
  },
  "scope": "Single-line lexical match on assembled SQL in clojure code.",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "(query db [(str \"SELECT \" q)])",
      "match": true
    },
    {
      "line": "# audit: (query db [(str \"SELECT \" q)]) present",
      "match": true
    },
    {
      "line": "(query db [FIXED])",
      "match": false
    },
    {
      "line": "# verified: (query db [FIXED])",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-744"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-4:clojure",
  "validationStatus": "VALIDATED"
}
