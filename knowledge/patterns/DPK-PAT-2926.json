{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2926",
  "title": "Signal: npm audit disabled in the client configuration",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "audit",
      "valuePattern": "^false$"
    }
  },
  "scope": "A .npmrc file that declares an `audit=false` npm client setting.",
  "limitations": "It matches an `audit=false` npm client setting in the parsed .npmrc; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "false",
        "fund": "true",
        "save-exact": "true"
      },
      "match": true
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": false,
        "fund": "true",
        "save-exact": "true"
      },
      "match": true
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true"
      },
      "match": false
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": true,
        "fund": "true",
        "save-exact": "true"
      },
      "match": false
    }
  ],
  "fpNotes": "A .npmrc that mentions an `audit=false` npm client setting in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0789"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-config-audit-off",
  "validationStatus": "VALIDATED"
}
