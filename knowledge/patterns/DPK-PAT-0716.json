{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0716",
  "title": "Signal: Authentication bypass (setenv) — review required",
  "targets": [
    "sudo"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bSETENV\\b"
  },
  "scope": "Single-line lexical match on auth configuration.",
  "limitations": "Lexical, line-based: matches the entry.",
  "examples": [
    {
      "line": "user ALL=(ALL) SETENV: ALL",
      "match": true
    },
    {
      "line": "# audit: user ALL=(ALL) SETENV: ALL present",
      "match": true
    },
    {
      "line": "user ALL=(ALL) ALL",
      "match": false
    },
    {
      "line": "# verified: user ALL=(ALL) ALL",
      "match": false
    }
  ],
  "fpNotes": "Recovery consoles are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-599"
  ],
  "origin": "original-authored",
  "cell": "sast:pam-unsafe:sudo:setenv",
  "validationStatus": "VALIDATED"
}
