{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0893",
  "title": "Signal: Dangerous PHP construct (include) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:(?:include|require)(?:_once)?(?:\\s*\\(\\s*\\$|\\s+\\$))"
  },
  "scope": "Single-line lexical match on dangerous constructs (include).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "include($page)",
      "match": true
    },
    {
      "line": "# audit: include($page) present",
      "match": true
    },
    {
      "line": "include(\"head.php\")",
      "match": false
    },
    {
      "line": "# verified: include(\"head.php\")",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-742"
  ],
  "origin": "original-authored",
  "cell": "sast:php-flag:php:include",
  "validationStatus": "VALIDATED"
}
