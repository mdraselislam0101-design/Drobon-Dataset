{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0671",
  "title": "Signal: TLS trust weakened (httpurl) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "new\\s+URL\\s*\\(\\s*\"http:"
  },
  "scope": "Single-line lexical match on TLS trust code (httpurl).",
  "limitations": "Lexical, line-based: matches the weakness.",
  "examples": [
    {
      "line": "new URL(\"http://h/x\")",
      "match": true
    },
    {
      "line": "# audit: new URL(\"http://h/x\") present",
      "match": true
    },
    {
      "line": "new URL(\"https://h/x\")",
      "match": false
    },
    {
      "line": "# verified: new URL(\"https://h/x\")",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive.",
  "linkedRules": [
    "DPK-SAST-554"
  ],
  "origin": "original-authored",
  "cell": "sast:java-tls-more:java:httpurl",
  "validationStatus": "VALIDATED"
}
