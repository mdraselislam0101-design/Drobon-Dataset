{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2792",
  "title": "Signal: Environment declares no interpreter version",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "requires.python_version"
    }
  },
  "scope": "A Pipfile file that declares a Pipfile that declares no interpreter version.",
  "limitations": "It matches a Pipfile that declares no interpreter version in the parsed Pipfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {}
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_full_version": "3.11.9"
        }
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": false
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.12"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Pipfile that mentions a Pipfile that declares no interpreter version in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0655"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-pipfile-no-python-version",
  "validationStatus": "VALIDATED"
}
