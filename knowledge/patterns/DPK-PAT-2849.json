{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2849",
  "title": "Signal: Dependency pinned to a tilde range below 1.0",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^~0\\.\\d+\\.\\d+$"
    }
  },
  "scope": "A package.json file that declares a dependency ranged with `~` under a zero major version.",
  "limitations": "It matches a dependency ranged with `~` under a zero major version in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "~0.9.2"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21",
          "minimist": "~0.0.8"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "~1.0.2"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21",
          "minimist": "^0.0.8"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A package.json that mentions a dependency ranged with `~` under a zero major version in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0712"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-spec-tilde-zero-minor",
  "validationStatus": "VALIDATED"
}
