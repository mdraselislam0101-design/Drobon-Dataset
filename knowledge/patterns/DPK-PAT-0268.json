{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0268",
  "title": "Signal: PHP version exposure (php) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "expose_php\\s*=\\s*(?:On|1)"
  },
  "scope": "Single-line lexical match on the php.ini switch.",
  "limitations": "Lexical, line-based: matches the switch.",
  "examples": [
    {
      "line": "expose_php = On",
      "match": true
    },
    {
      "line": "# audit: expose_php = On present",
      "match": true
    },
    {
      "line": "expose_php = Off",
      "match": false
    },
    {
      "line": "# verified: expose_php = Off",
      "match": false
    }
  ],
  "fpNotes": "None common.",
  "linkedRules": [
    "DPK-SAST-229"
  ],
  "origin": "original-authored",
  "cell": "sast:php-expose:php:expose",
  "validationStatus": "VALIDATED"
}
