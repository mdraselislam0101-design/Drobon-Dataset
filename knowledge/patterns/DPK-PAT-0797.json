{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0797",
  "title": "Signal: Shell runs a variable (source, shell) — review required",
  "targets": [
    "shell"
  ],
  "signal": {
    "kind": "regex",
    "source": "source\\s+\\$"
  },
  "scope": "Single-line lexical match on shell execution (source).",
  "limitations": "Lexical, line-based: matches the execution.",
  "examples": [
    {
      "line": "source $f",
      "match": true
    },
    {
      "line": "# audit: source $f present",
      "match": true
    },
    {
      "line": "source fixed.sh",
      "match": false
    },
    {
      "line": "# verified: source fixed.sh",
      "match": false
    }
  ],
  "fpNotes": "Trusted variables are the common false positive.",
  "linkedRules": [
    "DPK-SAST-680"
  ],
  "origin": "original-authored",
  "cell": "sast:shell-risk:shell:source",
  "validationStatus": "VALIDATED"
}
