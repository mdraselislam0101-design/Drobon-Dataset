{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1625",
  "title": "Signal: Process replaced from Ruby (ruby)",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Kernel\\.exec)\\s*\\("
  },
  "scope": "Single-line lexical match on exec calls in ruby code.",
  "limitations": "Lexical, line-based: matches the call without inspecting the argument form.",
  "examples": [
    {
      "line": "Kernel.exec(payload)",
      "match": true
    },
    {
      "line": "out = Kernel.exec(data)",
      "match": true
    },
    {
      "line": "myKernelexec(x)",
      "match": false
    },
    {
      "line": "Kernel.exec_safe()",
      "match": false
    }
  ],
  "fpNotes": "A constant command line with no interpolation is the common false positive.",
  "linkedRules": [
    "DPK-SAST-998"
  ],
  "origin": "original-authored",
  "cell": "sast:ruby-kernel-exec:ruby:exec",
  "validationStatus": "VALIDATED"
}
