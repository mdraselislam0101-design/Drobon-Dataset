{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2267",
  "title": "Signal: Poetry source configured over cleartext",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "tool.poetry.source[].url",
      "valuePattern": "^http://"
    }
  },
  "scope": "A pyproject.toml file that declares a Poetry source URL that uses cleartext http.",
  "limitations": "It matches a Poetry source URL that uses cleartext http in the parsed pyproject.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pyproject.toml",
      "document": {
        "tool": {
          "poetry": {
            "source": [
              {
                "name": "acme",
                "url": "http://pypi.acme.example/simple",
                "priority": "primary"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "tool": {
          "poetry": {
            "source": [
              {
                "name": "mirror",
                "url": "http://10.24.8.9/simple"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "tool": {
          "poetry": {
            "source": [
              {
                "name": "acme",
                "url": "https://pypi.acme.example/simple"
              }
            ]
          }
        }
      },
      "match": false
    },
    {
      "file": "pyproject.toml",
      "document": {
        "tool": {
          "poetry": {
            "source": [
              {
                "name": "pypi",
                "url": "https://pypi.org/simple"
              }
            ]
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pyproject.toml that mentions a Poetry source URL that uses cleartext http in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0130"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-poetry-source-cleartext",
  "validationStatus": "VALIDATED"
}
