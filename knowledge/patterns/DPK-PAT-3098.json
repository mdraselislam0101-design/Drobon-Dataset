            }
          ],
          "dependencyManagement": {
            "dependencies": [
              {
                "groupId": "org.slf4j",
                "artifactId": "slf4j-api",
                "version": "2.0.13"
              }
            ]
          },
          "dependencies": [
            {
              "groupId": "org.slf4j",
              "artifactId": "slf4j-api"
            }
          ],
          "profiles": []
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pom.xml that mentions a profile that applies without being requested in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0961"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-profile-active-by-default",
