{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1104",
  "title": "Signal: Remote content fetched from a computed URL in php — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bfile_get_contents\\s*\\(\\s*(?![\"'])"
  },
  "scope": "Single-line match on a computed remote fetch in php.",
  "limitations": "Lexical: matches file_get_contents with a non-literal argument; URL assembly in a helper is out of scope.",
  "examples": [
    {
      "line": "$body = file_get_contents($_GET[\"url\"]);",
      "match": true
    },
    {
      "line": "# audit: $body = file_get_contents($_GET[\"url\"]); present",
      "match": true
    },
    {
      "line": "$body = file_get_contents(\"/var/app/config.json\");",
      "match": false
    },
    {
      "line": "# verified: $body = file_get_contents(\"/var/app/config.json\");",
      "match": false
    }
  ],
  "fpNotes": "A constant URL built from configuration is the accepted false positive.",
  "linkedRules": [
    "DPK-SAST-921"
  ],
  "origin": "original-authored",
  "cell": "sast:php-file-get-contents-url:php",
  "validationStatus": "VALIDATED"
}
