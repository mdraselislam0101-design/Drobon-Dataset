{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1455",
  "title": "Signal: Azure Functions local.settings.json served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*\"IsEncrypted\"\\s*:)(?=[\\s\\S]*\"Values\"\\s*:)"
    }
  },
  "scope": "One response body containing a local settings document with a values block.",
  "limitations": "One response body. The rule reads the file shape; it does not use the values.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/local.settings.json",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\n  \"IsEncrypted\": false,\n  \"Values\": {\n    \"AzureWebJobsStorage\": \"UseDevelopmentStorage=true\",\n    \"FUNCTIONS_WORKER_RUNTIME\": \"node\"\n  }\n}\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api/local.settings.json",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"IsEncrypted\":false,\"Values\":{\"ServiceBusConnection\":\"Endpoint=sb://shop.servicebus.windows.net/;SharedAccessKeyName=send\"}}\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/appsettings.json",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"App\":{\"Name\":\"shop\"},\"Logging\":{\"LogLevel\":{\"Default\":\"Information\"}}}\n"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/deploy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Deployment guide</title></head><body><p>Set IsEncrypted to false for local runs only.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "An appsettings.json file without the IsEncrypted marker is covered by its own rule; a documentation page that shows the schema is reported when a values block is present.",
  "linkedRules": [
    "DPK-DAST-386"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-artefact-local-settings-json:local-settings-json",
  "validationStatus": "VALIDATED"
}
