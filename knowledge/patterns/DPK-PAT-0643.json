{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0643",
  "title": "Signal: Risky GitLab job (shell) — review required",
  "targets": [
    "gitlab"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:tags\\s*:\\s*\\[[^\\]]*shell)"
  },
  "scope": "Single-line lexical match on pipeline files.",
  "limitations": "Lexical, line-based: matches the job setting.",
  "examples": [
    {
      "line": "tags: [shell]",
      "match": true
    },
    {
      "line": "# audit: tags: [shell] present",
      "match": true
    },
    {
      "line": "tags: [docker]",
      "match": false
    },
    {
      "line": "# verified: tags: [docker]",
      "match": false
    }
  ],
  "fpNotes": "Release artifacts are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-526"
  ],
  "origin": "original-authored",
  "cell": "sast:gitlab-more:gitlab:shell",
  "validationStatus": "VALIDATED"
}
