{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2828",
  "title": "Signal: Registry index fetched over cleartext",
  "targets": [
    "cargo"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "registries.*.index",
      "valuePattern": "^http://"
    }
  },
  "scope": "A .cargo/config.toml file that declares a registry `index` over cleartext.",
  "limitations": "It matches a registry `index` over cleartext in the parsed .cargo/config.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": ".cargo/config.toml",
      "document": {
        "source": {
          "crates-io": {
            "replace-with": "acme"
          }
        },
        "registries": {
          "acme": {
            "index": "http://registry.acme.example/index"
          }
        }
      },
      "match": true
    },
    {
      "file": ".cargo/config.toml",
      "document": {
        "source": {
          "crates-io": {
            "replace-with": "acme"
          }
        },
        "registries": {
          "acme": {
            "index": "https://registry.acme.example/index"
          },
          "internal": {
            "index": "http://10.24.8.9/index"
          }
        }
      },
      "match": true
    },
    {
      "file": ".cargo/config.toml",
      "document": {
        "source": {
          "crates-io": {
            "replace-with": "acme"
          }
        },
        "registries": {
          "acme": {
            "index": "https://registry.acme.example/index"
          }
        }
      },
      "match": false
    },
    {
      "file": ".cargo/config.toml",
      "document": {
        "source": {
          "crates-io": {
            "replace-with": "acme"
          }
        },
        "registries": {
          "acme": {
            "index": "https://registry.acme.example/index"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A .cargo/config.toml that mentions a registry `index` over cleartext in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0691"
  ],
  "origin": "original-authored",
  "cell": "sca:cargo-registry-index-cleartext",
  "validationStatus": "VALIDATED"
}
