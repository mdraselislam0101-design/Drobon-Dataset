{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2262",
  "title": "Signal: pyproject dependency declared as a direct URL",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.dependencies[]",
      "valuePattern": "^[A-Za-z0-9._-]{1,80}(?:\\[[^\\]]{0,60}\\])? @ https?://"
    }
  },
  "scope": "A pyproject.toml file that declares a `name @ url` dependency that bypasses the index.",
  "limitations": "It matches a `name @ url` dependency that bypasses the index in the parsed pyproject.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "acme-sdk @ https://downloads.acme.example/acme_sdk-4.2.0-py3-none-any.whl"
          ]
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "acme-cli[fast] @ https://files.acme.example/cli.tar.gz"
          ]
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "acme-sdk==4.2.0"
          ]
        }
      },
      "match": false
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "acme-cli>=2.1,<3"
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pyproject.toml that mentions a `name @ url` dependency that bypasses the index in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0125"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-pyproject-direct-url",
  "validationStatus": "VALIDATED"
}
