{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1025",
  "title": "Signal: X-Content-Type-Options present with a non-nosniff value",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "x-content-type-options",
      "valuePattern": "^(?!\\s*nosniff\\s*$).+"
    }
  },
  "scope": "One response: confirm the header value equals nosniff.",
  "limitations": "Header value only: multiple values and case variants are compared literally apart from letter case.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/upload",
        "status": 200,
        "headers": {
          "X-Content-Type-Options": "sniff"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/upload",
        "status": 200,
        "headers": {
          "X-Content-Type-Options": "nosniff, sniff"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/upload",
        "status": 200,
        "headers": {
          "X-Content-Type-Options": "nosniff"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/upload",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Proxies that append a second header value are the accepted false positive and should be fixed upstream.",
  "linkedRules": [
    "DPK-DAST-073"
  ],
  "origin": "original-authored",
  "cell": "dast:xcto-value-invalid:xcto-value",
  "validationStatus": "VALIDATED"
}
