{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0542",
  "title": "Signal: Framework SQL built from input (laravel) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "DB::raw\\s*\\([^)]*(?:\"[^\"\\n]*\\$|\\.\\s*\\$)"
  },
  "scope": "Single-line lexical match on assembled framework SQL (laravel).",
  "limitations": "Lexical, line-based: any assembled query matches, including trusted ones.",
  "examples": [
    {
      "line": "DB::raw(\"a\" . $b)",
      "match": true
    },
    {
      "line": "# audit: DB::raw(\"a\" . $b) present",
      "match": true
    },
    {
      "line": "DB::raw($fixed)",
      "match": false
    },
    {
      "line": "# verified: DB::raw($fixed)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-445"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli:php:laravel",
  "validationStatus": "VALIDATED"
}
