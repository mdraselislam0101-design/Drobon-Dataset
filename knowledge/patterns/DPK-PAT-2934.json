{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2934",
  "title": "Signal: Yarn plug-n-play linker in use",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "nodeLinker",
      "valuePattern": "^pnp$"
    }
  },
  "scope": "A .yarnrc.yml file that declares a `nodeLinker: pnp` setting.",
  "limitations": "It matches a `nodeLinker: pnp` setting in the parsed .yarnrc.yml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": ".yarnrc.yml",
      "document": {
        "npmRegistryServer": "https://registry.yarnpkg.com",
        "enableStrictSsl": "true",
        "enableImmutableInstalls": "true",
        "nodeLinker": "pnp"
      },
      "match": true
    },
    {
      "file": ".yarnrc.yml",
      "document": {
        "npmRegistryServer": "https://registry.yarnpkg.com",
        "enableStrictSsl": "true",
        "enableImmutableInstalls": "true",
        "nodeLinker": "pnp"
      },
      "match": true
    },
    {
      "file": ".yarnrc.yml",
      "document": {
        "npmRegistryServer": "https://registry.yarnpkg.com",
        "enableStrictSsl": "true",
        "enableImmutableInstalls": "true",
        "nodeLinker": "node-modules"
      },
      "match": false
    },
    {
      "file": ".yarnrc.yml",
      "document": {
        "npmRegistryServer": "https://registry.yarnpkg.com",
        "enableStrictSsl": "true",
        "enableImmutableInstalls": "true",
        "nodeLinker": "pnpm"
      },
      "match": false
    }
  ],
  "fpNotes": "A .yarnrc.yml that mentions a `nodeLinker: pnp` setting in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0797"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-yarn-nodelinker-pnp",
  "validationStatus": "VALIDATED"
}
