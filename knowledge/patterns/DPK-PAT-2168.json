{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2168",
  "title": "Signal: Dependency declared with a four-part version",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$"
    }
  },
  "scope": "A package.json file that declares a four-part version, which is not a semantic version.",
  "limitations": "It matches a four-part version, which is not a semantic version in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0.1"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "1.0.0.12"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "^4.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A four-part version inside a build identifier string is not a specifier and is not reported.",
  "linkedRules": [
    "DPK-SCA-0031"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-four-part-version",
  "validationStatus": "VALIDATED"
}
