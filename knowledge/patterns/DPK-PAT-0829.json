{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0829",
  "title": "Signal: Weak Terraform setting (forcedestroy) — review required",
  "targets": [
    "hcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "force_destroy\\s*=\\s*true"
  },
  "scope": "Single-line lexical match on Terraform files.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "force_destroy = true",
      "match": true
    },
    {
      "line": "# audit: force_destroy = true present",
      "match": true
    },
    {
      "line": "force_destroy = false",
      "match": false
    },
    {
      "line": "# verified: force_destroy = false",
      "match": false
    }
  ],
  "fpNotes": "Ephemeral environments are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-712"
  ],
  "origin": "original-authored",
  "cell": "sast:tf-more:hcl:forcedestroy",
  "validationStatus": "VALIDATED"
}
