{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1194",
  "title": "Signal: Profiler link exposed (X-Debug-Token-Link header)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-Debug-Token-Link",
      "valuePattern": "^\\s*\\S"
    }
  },
  "scope": "One response that carries a non-empty X-Debug-Token-Link header.",
  "limitations": "One header value. The rule reports the profiler link; it cannot tell whether the profiler endpoint still accepts the token or which panels are enabled.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Debug-Token-Link": "/_profiler/8f2c1a"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Debug-Token-Link": "https://app.example/_profiler/8f2c1a"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Debug-Token-Link": ""
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Debug-Token": "8f2c1a"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A staging host that deliberately exposes the profiler to a trusted network is reported; the link is still readable by anyone with the response.",
  "linkedRules": [
    "DPK-DAST-125"
  ],
  "origin": "original-authored",
  "cell": "dast:banner-x-debug-token-link:x-debug-token-link",
  "validationStatus": "VALIDATED"
}
