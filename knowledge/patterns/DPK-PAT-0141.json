{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0141",
  "title": "Signal: Script evaluation of a variable (clojure) — review required",
  "targets": [
    "clojure"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\(eval\\s"
  },
  "scope": "Single-line lexical match on variable evaluation in clojure code.",
  "limitations": "Lexical, line-based: matches variable evaluation.",
  "examples": [
    {
      "line": "(eval x)",
      "match": true
    },
    {
      "line": "# audit: (eval x) present",
      "match": true
    },
    {
      "line": "(apply f x)",
      "match": false
    },
    {
      "line": "# verified: (apply f x)",
      "match": false
    }
  ],
  "fpNotes": "Trusted macro expansion is the common false positive.",
  "linkedRules": [
    "DPK-SAST-102"
  ],
  "origin": "original-authored",
  "cell": "sast:eval-flag-extra:clojure",
  "validationStatus": "VALIDATED"
}
