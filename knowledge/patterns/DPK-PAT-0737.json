{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0737",
  "title": "Signal: PHP session exposure (transsid) — review required",
  "targets": [
    "ini"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:session\\.use_trans_sid\\s*=\\s*1\\b)"
  },
  "scope": "Single-line lexical match on php.ini.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "session.use_trans_sid = 1",
      "match": true
    },
    {
      "line": "# audit: session.use_trans_sid = 1 present",
      "match": true
    },
    {
      "line": "session.use_trans_sid = 0",
      "match": false
    },
    {
      "line": "# verified: session.use_trans_sid = 0",
      "match": false
    }
  ],
  "fpNotes": "Local development is the common false positive.",
  "linkedRules": [
    "DPK-SAST-620"
  ],
  "origin": "original-authored",
  "cell": "sast:php-ini-session:ini:transsid",
  "validationStatus": "VALIDATED"
}
