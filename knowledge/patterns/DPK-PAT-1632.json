{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1632",
  "title": "Signal: Native library loaded by name (java)",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:loadLibrary|System\\.load)\\s*\\("
  },
  "scope": "Single-line lexical match on native library loads in java code.",
  "limitations": "Lexical, line-based: matches the load without resolving the name.",
  "examples": [
    {
      "line": "System.loadLibrary(payload)",
      "match": true
    },
    {
      "line": "out = System.loadLibrary(data)",
      "match": true
    },
    {
      "line": "mySystemloadLibrary(x)",
      "match": false
    },
    {
      "line": "System.loadLibrary_safe()",
      "match": false
    }
  ],
  "fpNotes": "Loads of a bundled library from a read-only directory are the common false positive.",
  "linkedRules": [
    "DPK-SAST-1005"
  ],
  "origin": "original-authored",
  "cell": "sast:native-library-load:java:jni",
  "validationStatus": "VALIDATED"
}
