{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0690",
  "title": "Signal: Permissive Kubernetes pod (defaultsa) — review required",
  "targets": [
    "k8s"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:serviceAccountName\\s*:\\s*default)"
  },
  "scope": "Single-line lexical match on Kubernetes manifests.",
  "limitations": "Lexical, line-based: matches the grant.",
  "examples": [
    {
      "line": "serviceAccountName: default",
      "match": true
    },
    {
      "line": "# audit: serviceAccountName: default present",
      "match": true
    },
    {
      "line": "serviceAccountName: app",
      "match": false
    },
    {
      "line": "# verified: serviceAccountName: app",
      "match": false
    }
  ],
  "fpNotes": "Node agents are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-573"
  ],
  "origin": "original-authored",
  "cell": "sast:k8s-more:k8s:defaultsa",
  "validationStatus": "VALIDATED"
}
