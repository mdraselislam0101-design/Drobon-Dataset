{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0614",
  "title": "Signal: Dangerous .NET construct (xslscript) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "EnableScript\\s*=\\s*true"
  },
  "scope": "Single-line lexical match on .NET constructs (xslscript).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "EnableScript = true",
      "match": true
    },
    {
      "line": "# audit: EnableScript = true present",
      "match": true
    },
    {
      "line": "EnableScript = false",
      "match": false
    },
    {
      "line": "# verified: EnableScript = false",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-497"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-flag:csharp:xslscript",
  "validationStatus": "VALIDATED"
}
