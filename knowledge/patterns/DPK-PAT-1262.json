{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1262",
  "title": "Signal: Access-Control-Max-Age is not a delta-seconds value",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Max-Age",
      "valuePattern": "^\\s*(?![0-9]+\\s*$)\\S"
    }
  },
  "scope": "One response whose Access-Control-Max-Age value is not a run of digits.",
  "limitations": "One header value. The rule validates the token and does not predict the default a particular browser applies when the attribute is discarded.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Max-Age": "600s"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Max-Age": "-1"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Max-Age": "600"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Max-Age": "86400"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A negative value is reported too; the rule does not compute the effective cache lifetime.",
  "linkedRules": [
    "DPK-DAST-193"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-max-age-invalid:max-age-invalid",
  "validationStatus": "VALIDATED"
}
