{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0497",
  "title": "Signal: Possible a Mapbox key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "sk\\.eyJ[A-Za-z0-9]{32,}"
  },
  "scope": "Single-line shape match for a Mapbox key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"sk.eyJAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: key = \"sk.eyJAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-031"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:mapbox",
  "validationStatus": "VALIDATED"
}
