{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1342",
  "title": "Signal: HAProxy statistics report disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "Statistics Report for HAProxy"
    }
  },
  "scope": "One response body containing the HAProxy statistics report heading.",
  "limitations": "One response body. The marker identifies the statistics page; session counts and server names in the output depend on the deployment and are not interpreted by the check.",
  "examples": [
    {
      "observation": {
        "url": "https://lb.example/haproxy?stats",
        "status": 200,
        "headers": {},
        "body": "<html><head><title>Statistics Report for HAProxy 2.9.6</title></head><body><table>…</table></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://lb.example/stats",
        "status": 200,
        "headers": {},
        "body": "Statistics Report for HAProxy"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://lb.example/",
        "status": 200,
        "headers": {},
        "body": "<html><title>Example store</title></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://lb.example/docs",
        "status": 200,
        "headers": {},
        "body": "Load-balancer statistics are published on the management network only."
      },
      "match": false
    }
  ],
  "fpNotes": "An internal wiki page that reproduces the report is reported; confirm the page is not reachable rather than assuming the copy is inert.",
  "linkedRules": [
    "DPK-DAST-273"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-haproxy-stats:haproxy-stats",
  "validationStatus": "VALIDATED"
}
