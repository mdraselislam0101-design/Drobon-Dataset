{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0872",
  "title": "Signal: Possible a Notion secret in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "secret_[A-Za-z0-9]{32,}"
  },
  "scope": "Single-line shape match for a Notion secret.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"secret_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: key = \"secret_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-084"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-2:notion-secret",
  "validationStatus": "VALIDATED"
}
