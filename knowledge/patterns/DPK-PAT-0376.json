{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0376",
  "title": "Signal: TLS checks disabled (mongo) — review required",
  "targets": [
    "shell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:tlsAllowInvalidCertificates)"
  },
  "scope": "Single-line lexical match on TLS-disabling flags for mongo.",
  "limitations": "Lexical, line-based: matches the flag regardless of environment.",
  "examples": [
    {
      "line": "mongosh --tlsAllowInvalidCertificates",
      "match": true
    },
    {
      "line": "# audit: mongosh --tlsAllowInvalidCertificates present",
      "match": true
    },
    {
      "line": "mongosh --tlsCAFile ca",
      "match": false
    },
    {
      "line": "# verified: mongosh --tlsCAFile ca",
      "match": false
    }
  ],
  "fpNotes": "Local bootstrap scripts are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-337"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-cli:shell:mongo",
  "validationStatus": "VALIDATED"
}
