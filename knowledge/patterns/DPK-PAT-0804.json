{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0804",
  "title": "Signal: SQL built by concatenation (crystal) — review required",
  "targets": [
    "crystal"
  ],
  "signal": {
    "kind": "regex",
    "source": "query\\s*\\([^)]*\\+"
  },
  "scope": "Single-line lexical match on assembled SQL in crystal code.",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "query(\"SELECT \" + q)",
      "match": true
    },
    {
      "line": "# audit: query(\"SELECT \" + q) present",
      "match": true
    },
    {
      "line": "query(FIXED)",
      "match": false
    },
    {
      "line": "# verified: query(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-687"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-4:crystal",
  "validationStatus": "VALIDATED"
}
