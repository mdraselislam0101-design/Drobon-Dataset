{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0819",
  "title": "Signal: Server-side fetch of assembled URL (clojure) — review required",
  "targets": [
    "clojure"
  ],
  "signal": {
    "kind": "regex",
    "source": "client/get\\s*\\([^)]*str\\s"
  },
  "scope": "Single-line lexical match on assembled fetch URLs in clojure code.",
  "limitations": "Lexical, line-based: any assembled fetch URL matches.",
  "examples": [
    {
      "line": "(client/get (str base p))",
      "match": true
    },
    {
      "line": "# audit: (client/get (str base p)) present",
      "match": true
    },
    {
      "line": "(client/get FIXED)",
      "match": false
    },
    {
      "line": "# verified: (client/get FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-702"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-4:clojure",
  "validationStatus": "VALIDATED"
}
