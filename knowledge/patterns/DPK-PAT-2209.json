{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2209",
  "title": "Signal: Lockfile without a lockfile format version",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "lockfileVersion"
    }
  },
  "scope": "A package-lock.json file that declares a lockfile that declares no format version.",
  "limitations": "It matches a lockfile that declares no format version in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "packages": {
          "": {
            "name": "demo-service"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "dependencies": {
          "left-pad": {
            "version": "1.3.0"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "": {
            "name": "demo-service"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 2,
        "packages": {
          "": {
            "name": "demo-service"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A lockfile produced by a tool that omits the field is still reported; the missing declaration is the finding.",
  "linkedRules": [
    "DPK-SCA-0072"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-lockfile-version-absent",
  "validationStatus": "VALIDATED"
}
