{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2928",
  "title": "Signal: npm registry configured over cleartext",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "registry",
      "valuePattern": "^http://"
    }
  },
  "scope": "A .npmrc file that declares a `registry` URL over cleartext.",
  "limitations": "It matches a `registry` URL over cleartext in the parsed .npmrc; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": ".npmrc",
      "document": {
        "registry": "http://registry.acme.example",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true"
      },
      "match": true
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "http://10.24.8.9:4873",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true"
      },
      "match": true
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true"
      },
      "match": false
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.acme.example",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true"
      },
      "match": false
    }
  ],
  "fpNotes": "A .npmrc that mentions a `registry` URL over cleartext in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0791"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-config-registry-cleartext",
  "validationStatus": "VALIDATED"
}
