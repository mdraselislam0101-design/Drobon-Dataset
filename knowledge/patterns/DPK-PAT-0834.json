{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0834",
  "title": "Signal: Weak Terraform setting (pg9) — review required",
  "targets": [
    "terraform"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:engine_version\\s*=\\s*\"9\\.)"
  },
  "scope": "Single-line lexical match on Terraform files.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "engine_version = \"9.6\"",
      "match": true
    },
    {
      "line": "# audit: engine_version = \"9.6\" present",
      "match": true
    },
    {
      "line": "engine_version = \"15.4\"",
      "match": false
    },
    {
      "line": "# verified: engine_version = \"15.4\"",
      "match": false
    }
  ],
  "fpNotes": "Ephemeral environments are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-717"
  ],
  "origin": "original-authored",
  "cell": "sast:tf-more:hcl:pg9",
  "validationStatus": "VALIDATED"
}
