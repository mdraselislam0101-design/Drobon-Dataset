{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2890",
  "title": "Signal: a nuget.config whose `<packageSources>` lists no `<add>`",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "packageSources.add"
    }
  },
  "scope": "A nuget.config file that declares a source list that inherits every machine-level feed.",
  "limitations": "It matches a source list that inherits every machine-level feed in the parsed nuget.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "packageSources": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "packageSources": {
          "clear": true
        }
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "packageSources": {
          "add": [
            {
              "key": "nuget.org",
              "value": "https://api.nuget.org/v3/index.json"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "packageSources": {
          "add": [
            {
              "key": "acme",
              "value": "https://nuget.acme.example/v3/index.json"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A nuget.config that mentions a source list that inherits every machine-level feed in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0753"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-clear-on-sources-missing-add",
  "validationStatus": "VALIDATED"
}
