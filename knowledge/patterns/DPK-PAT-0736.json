{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0736",
  "title": "Signal: PHP session exposure (sesssecure) — review required",
  "targets": [
    "ini"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:session\\.cookie_secure\\s*=\\s*0\\b)"
  },
  "scope": "Single-line lexical match on php.ini.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "session.cookie_secure = 0",
      "match": true
    },
    {
      "line": "# audit: session.cookie_secure = 0 present",
      "match": true
    },
    {
      "line": "session.cookie_secure = 1",
      "match": false
    },
    {
      "line": "# verified: session.cookie_secure = 1",
      "match": false
    }
  ],
  "fpNotes": "Local development is the common false positive.",
  "linkedRules": [
    "DPK-SAST-619"
  ],
  "origin": "original-authored",
  "cell": "sast:php-ini-session:ini:sesssecure",
  "validationStatus": "VALIDATED"
}
