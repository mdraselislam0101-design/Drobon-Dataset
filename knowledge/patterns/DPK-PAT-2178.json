{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2178",
  "title": "Signal: Dependency declared with a strict open bound",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^>\\s*\\d{1,4}(?:\\.\\d{1,4}){0,2}$"
    }
  },
  "scope": "A package.json file that declares a `>` specifier that excludes the named version and every version above it.",
  "limitations": "It matches a `>` specifier that excludes the named version and every version above it in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": ">4.2.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "> 2.1.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": ">4.2.0 <5.0.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A `>` combined with an upper bound is a closed range and is not reported.",
  "linkedRules": [
    "DPK-SCA-0041"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-greater-than-only",
  "validationStatus": "VALIDATED"
}
