{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0814",
  "title": "Signal: Weak SSH daemon setting (listen) — review required",
  "targets": [
    "sshd"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:ListeningAddress\\s+0\\.0\\.0\\.0)"
  },
  "scope": "Single-line lexical match on sshd settings.",
  "limitations": "Lexical, line-based: matches the setting regardless of Match blocks.",
  "examples": [
    {
      "line": "ListeningAddress 0.0.0.0",
      "match": true
    },
    {
      "line": "# audit: ListeningAddress 0.0.0.0 present",
      "match": true
    },
    {
      "line": "ListeningAddress 10.0.0.5",
      "match": false
    },
    {
      "line": "# verified: ListeningAddress 10.0.0.5",
      "match": false
    }
  ],
  "fpNotes": "Bastion-specific needs are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-697"
  ],
  "origin": "original-authored",
  "cell": "sast:sshd-strict:sshd:listen",
  "validationStatus": "VALIDATED"
}
