{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1034",
  "title": "Signal: Content-Security-Policy without object-src or default-src",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "^(?![^\\n]*(?:^|[;,])\\s*(?:object-src|default-src)(?=[\\s;,]|$))[^\\n]*$"
    }
  },
  "scope": "One response: confirm that object-src is absent from the policy.",
  "limitations": "Fallback-aware directive check: a policy that sets default-src constrains object loading through the fallback and is not reported. A policy that sets object-src explicitly is out of scope for this check, and a policy delivered by a meta element cannot be seen. Because the check requires both object-src and default-src to be absent, every case it reports is also reported by DPK-DAST-087 (missing default-src); this rule adds the object-loading explanation, not a second condition.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'; frame-ancestors 'self'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "form-action 'self'; base-uri 'none'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "upgrade-insecure-requests"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; script-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'none'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "object-src 'none'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "object-src 'none'; default-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "Policies relying on default-src without explicit object-src are reported even though some browsers fall back; this is intentional defence-in-depth.",
  "linkedRules": [
    "DPK-DAST-075"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-object-src:object-src",
  "validationStatus": "VALIDATED"
}
