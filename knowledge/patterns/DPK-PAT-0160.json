{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0160",
  "title": "Signal: Framework SQL built from input (tortoise) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "execute_query\\s*\\([^)]*(?:\\+|\\{)"
  },
  "scope": "Single-line lexical match on assembled SQL (tortoise).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "execute_query(\"SELECT \" + q)",
      "match": true
    },
    {
      "line": "# audit: execute_query(\"SELECT \" + q) present",
      "match": true
    },
    {
      "line": "execute_query(FIXED)",
      "match": false
    },
    {
      "line": "# verified: execute_query(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-121"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli-extra:python:tortoise",
  "validationStatus": "VALIDATED"
}
