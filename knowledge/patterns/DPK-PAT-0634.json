{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0634",
  "title": "Signal: Open FTP setting (shell) — review required",
  "targets": [
    "proftpd"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:RequireValidShell\\s+off)"
  },
  "scope": "Single-line lexical match on FTP settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "RequireValidShell off",
      "match": true
    },
    {
      "line": "# audit: RequireValidShell off present",
      "match": true
    },
    {
      "line": "RequireValidShell on",
      "match": false
    },
    {
      "line": "# verified: RequireValidShell on",
      "match": false
    }
  ],
  "fpNotes": "Public mirrors are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-517"
  ],
  "origin": "original-authored",
  "cell": "sast:ftp-config:proftpd:shell",
  "validationStatus": "VALIDATED"
}
