{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0274",
  "title": "Signal: Predictable randomness via Random (pascal) — review required",
  "targets": [
    "pascal"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Random)\\s*\\("
  },
  "scope": "Single-line lexical match on the Random call in pascal code.",
  "limitations": "Lexical, line-based: matches any Random call.",
  "examples": [
    {
      "line": "Random(payload)",
      "match": true
    },
    {
      "line": "out = Random(data)",
      "match": true
    },
    {
      "line": "myRandom(x)",
      "match": false
    },
    {
      "line": "Random_safe()",
      "match": false
    }
  ],
  "fpNotes": "Simulations are the common false positive.",
  "linkedRules": [
    "DPK-SAST-235"
  ],
  "origin": "original-authored",
  "cell": "sast:random-extra:pascal",
  "validationStatus": "VALIDATED"
}
