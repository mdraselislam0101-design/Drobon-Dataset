  "title": "Signal: Script evaluation (jsr223) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.eval\\s*\\("
  },
  "scope": "Single-line lexical match on script evaluation (jsr223).",
  "limitations": "Lexical, line-based: matches the evaluation.",
  "examples": [
    {
      "line": "engine.eval(expr)",
      "match": true
    },
    {
      "line": "# audit: engine.eval(expr) present",
      "match": true
    },
    {
      "line": "engine.get(expr)",
      "match": false
    },
    {
      "line": "# verified: engine.get(expr)",
      "match": false
    }
  ],
  "fpNotes": "Fixed scripts are the common false positive.",
