{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0831",
  "title": "Signal: Weak Terraform setting (localexec) — review required",
  "targets": [
    "hcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "provisioner\\s+\"local-exec\""
  },
  "scope": "Single-line lexical match on Terraform files.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "provisioner \"local-exec\"",
      "match": true
    },
    {
      "line": "# audit: provisioner \"local-exec\" present",
      "match": true
    },
    {
      "line": "# provisioner removed",
      "match": false
    },
    {
      "line": "# verified: # provisioner removed",
      "match": false
    }
  ],
  "fpNotes": "Ephemeral environments are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-714"
  ],
  "origin": "original-authored",
  "cell": "sast:tf-more:hcl:localexec",
  "validationStatus": "VALIDATED"
}
