{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0747",
  "title": "Signal: Weak proxy or service setting (verify) — review required",
  "targets": [
    "consul"
  ],
  "signal": {
    "kind": "regex",
    "source": "verify_incoming\\s*=\\s*false"
  },
  "scope": "Single-line lexical match on service settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "verify_incoming = false",
      "match": true
    },
    {
      "line": "# audit: verify_incoming = false present",
      "match": true
    },
    {
      "line": "verify_incoming = true",
      "match": false
    },
    {
      "line": "# verified: verify_incoming = true",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-630"
  ],
  "origin": "original-authored",
  "cell": "sast:proxy-misc:consul:verify",
  "validationStatus": "VALIDATED"
}
