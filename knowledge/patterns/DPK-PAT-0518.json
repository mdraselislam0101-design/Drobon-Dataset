{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0518",
  "title": "Signal: Possible a SOPS ciphertext in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "ENC\\[AES256,[A-Za-z0-9+/=]{40,}"
  },
  "scope": "Single-line shape match for a SOPS ciphertext.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "data = \"ENC[AES256,AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: data = \"ENC[AES256,AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "data = \"xy\"",
      "match": false
    },
    {
      "line": "data = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-052"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:sops-enc",
  "validationStatus": "VALIDATED"
}
