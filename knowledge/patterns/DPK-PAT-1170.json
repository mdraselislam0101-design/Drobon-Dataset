{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1170",
  "title": "Signal: CORS allows a plaintext HTTP origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Allow-Origin",
      "valuePattern": "^http://"
    }
  },
  "scope": "One Access-Control-Allow-Origin value beginning with http://.",
  "limitations": "One header value. The rule reads the origin in this response; it cannot tell whether the browser actually admits the caller.",
  "examples": [
    {
      "observation": {
        "url": "https://api.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "http://app.example"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "http://app.example:8080"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://app.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://api.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://api.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "null"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://api.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A policy that deliberately serves a plaintext intranet application is reported; the observation cannot establish network boundaries.",
  "linkedRules": [
    "DPK-DAST-101"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-plaintext-origin:plaintext-origin",
  "validationStatus": "VALIDATED"
}
