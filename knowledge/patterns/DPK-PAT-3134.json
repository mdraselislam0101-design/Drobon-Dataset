{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3134",
  "title": "Signal: Pipfile source with TLS verification off",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "sources[].verify_ssl",
      "valuePattern": "^false$"
    }
  },
  "scope": "A Pipfile file that declares a `verify_ssl = false` source.",
  "limitations": "It matches a `verify_ssl = false` source in the parsed Pipfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        },
        "sources": [
          {
            "name": "pypi",
            "url": "https://pypi.acme.example/simple",
            "verify_ssl": false
          }
        ]
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        },
        "sources": [
          {
            "name": "internal",
            "url": "https://10.24.8.9/simple",
            "verify_ssl": "false"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        },
        "sources": [
          {
            "name": "pypi",
            "url": "https://pypi.org/simple",
            "verify_ssl": true
          }
        ]
      },
      "match": false
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        },
        "sources": [
          {
            "name": "acme",
            "url": "https://pypi.acme.example/simple",
            "verify_ssl": true
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Pipfile that mentions a `verify_ssl = false` source in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0997"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-pipfile-verify-ssl-off",
  "validationStatus": "VALIDATED"
}
