{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0336",
  "title": "Signal: Server-side fetch of assembled URL (dart) — review required",
  "targets": [
    "dart"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Uri\\.parse\\s*\\([^)]*\\+)"
  },
  "scope": "Single-line lexical match on assembled fetch URLs in dart code.",
  "limitations": "Lexical, line-based: any assembled fetch URL matches.",
  "examples": [
    {
      "line": "Uri.parse(base + p)",
      "match": true
    },
    {
      "line": "# audit: Uri.parse(base + p) present",
      "match": true
    },
    {
      "line": "Uri.parse(FIXED)",
      "match": false
    },
    {
      "line": "# verified: Uri.parse(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-297"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-langs:dart",
  "validationStatus": "VALIDATED"
}
