{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2341",
  "title": "Signal: Gemfile installs a gem from a git remote",
  "targets": [
    "rubygems"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "gems[].git",
      "valuePattern": "^https?://"
    }
  },
  "scope": "A Gemfile file that declares a gem sourced from a git remote rather than rubygems.org.",
  "limitations": "It matches a gem sourced from a git remote rather than rubygems.org in the parsed Gemfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "acme-sdk",
            "git": "https://github.com/acme/sdk.git",
            "ref": "9f2c4a1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "acme-cli",
            "git": "https://github.com/acme/cli.git",
            "branch": "main"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "requirement": "~> 7.1.3"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "puma",
            "requirement": "6.4.2"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Gemfile that mentions a gem sourced from a git remote rather than rubygems.org in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0204"
  ],
  "origin": "original-authored",
  "cell": "sca:gemfile-git-source",
  "validationStatus": "VALIDATED"
}
