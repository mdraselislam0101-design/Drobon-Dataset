{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1610",
  "title": "Signal: Overlapping memory copy (c)",
  "targets": [
    "c"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:memcpy|memmove)\\s*\\("
  },
  "scope": "Single-line lexical match on byte copies in c code.",
  "limitations": "Lexical, line-based: matches every copy, including provably disjoint ones.",
  "examples": [
    {
      "line": "memcpy(payload)",
      "match": true
    },
    {
      "line": "out = memcpy(data)",
      "match": true
    },
    {
      "line": "mymemcpy(x)",
      "match": false
    },
    {
      "line": "memcpy_safe()",
      "match": false
    }
  ],
  "fpNotes": "Copies between separately allocated buffers are the common false positive.",
  "linkedRules": [
    "DPK-SAST-983"
  ],
  "origin": "original-authored",
  "cell": "sast:c-memcpy-overlap:c:memcpy",
  "validationStatus": "VALIDATED"
}
