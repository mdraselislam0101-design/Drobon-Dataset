{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2366",
  "title": "Signal: Podfile entry with no version requirement",
  "targets": [
    "cocoapods"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "pods[].requirement",
      "valuePattern": "^$"
    }
  },
  "scope": "A Podfile file that declares a pod declared without a requirement.",
  "limitations": "It matches a pod declared without a requirement in the parsed Podfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": ""
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "SnapKit",
            "requirement": ""
          },
          {
            "name": "Alamofire",
            "requirement": "~> 5.9"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": "~> 5.9.1"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "SnapKit",
            "requirement": "5.7.1"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Podfile that mentions a pod declared without a requirement in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0229"
  ],
  "origin": "original-authored",
  "cell": "sca:podfile-unpinned-pod",
  "validationStatus": "VALIDATED"
}
