{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2147",
  "title": "Signal: Dependency declared with the GitLab shorthand",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^gitlab:"
    }
  },
  "scope": "A package.json file that declares the `gitlab:` dependency shorthand.",
  "limitations": "It matches the `gitlab:` dependency shorthand in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "gitlab:acme/sdk"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-ui": "gitlab:acme/ui#v2"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "git+https://gitlab.com/acme/sdk.git"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A shorthand naming a commit is reported too; the rule names the resolver, not the pin quality.",
  "linkedRules": [
    "DPK-SCA-0010"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-gitlab-shorthand",
  "validationStatus": "VALIDATED"
}
