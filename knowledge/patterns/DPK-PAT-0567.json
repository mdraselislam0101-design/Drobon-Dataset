{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0567",
  "title": "Signal: Missing Origin-Agent-Cluster response header",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "missing-response-header",
      "header": "Origin-Agent-Cluster"
    }
  },
  "scope": "Single response: confirm the header is absent.",
  "limitations": "Header-name check on one response. It cannot tell whether the page depends on site-keyed synchrony, and browser handling of the hint still varies.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Origin-Agent-Cluster": "?1"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "Origin-Agent-Cluster": "?1"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Non-browser endpoints are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-042"
  ],
  "origin": "original-authored",
  "cell": "dast:header-missing-2:oac",
  "validationStatus": "VALIDATED"
}
