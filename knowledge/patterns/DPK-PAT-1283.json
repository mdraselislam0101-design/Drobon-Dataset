{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1283",
  "title": "Signal: Adminer database console disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Adminer)(?=[\\s\\S]*Log\\ in)"
    }
  },
  "scope": "One response whose body renders the Adminer login form.",
  "limitations": "One response body. The rule reports the login page; it does not attempt a login and cannot show which database privileges would follow.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Login - Adminer</title></head><body><form method=\"post\"><select name=\"auth[driver]\"><option>MySQL</option></select><input name=\"auth[username]\"><input type=\"submit\" value=\"Log in\"></form><p>Adminer 4.8.1</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h1>Adminer</h1><form><select name=\"auth[driver]\"><option>PostgreSQL</option></select><button>Log in</button></form></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Login - </title></head><body><form method=\"post\"><select name=\"auth[driver]\"><option>MySQL</option></select><input name=\"auth[username]\"><input type=\"submit\" value=\"\"></form><p> 4.8.1</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that links to Adminer without the driver selector is not reported.",
  "linkedRules": [
    "DPK-DAST-214"
  ],
  "origin": "original-authored",
  "cell": "dast:body-adminer-login:adminer-login",
  "validationStatus": "VALIDATED"
}
