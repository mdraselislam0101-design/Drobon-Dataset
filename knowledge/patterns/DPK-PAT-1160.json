{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1160",
  "title": "Signal: Git repository metadata served by the web server",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "repositoryformatversion\\s*=\\s*0"
    }
  },
  "scope": "One response body: confirm a Git repository configuration file.",
  "limitations": "Observation-level: matches the Git configuration key that identifies a repository config file. A bare .git/config exposed under another name is out of scope.",
  "examples": [
    {
      "observation": {
        "url": "https://site.example/.git/config",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = false"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://site.example/.git/config",
        "status": 200,
        "headers": {},
        "body": "repositoryformatversion=0\n[remote \"origin\"]\n\turl = https://git.example/app.git"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://site.example/",
        "status": 200,
        "headers": {},
        "body": "<html><body>Welcome</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://site.example/.git/config",
        "status": 404,
        "headers": {},
        "body": "Not Found"
      },
      "match": false
    }
  ],
  "fpNotes": "A service that intentionally publishes a repository mirror is reported by design.",
  "linkedRules": [
    "DPK-DAST-091"
  ],
  "origin": "original-authored",
  "cell": "dast:vcs-metadata-exposed:gitconfig",
  "validationStatus": "VALIDATED"
}
