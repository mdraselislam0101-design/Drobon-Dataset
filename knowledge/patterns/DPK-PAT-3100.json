{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3100",
  "title": "Signal: Transitive group excluded per dependency",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies[].exclude[].group",
      "valuePattern": "^.+$"
    }
  },
  "scope": "A build.gradle file that declares an exclusion that removes a group from the graph.",
  "limitations": "It matches an exclusion that removes a group from the graph in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "com.acme",
            "name": "sdk",
            "version": "4.2.0",
            "exclude": [
              {
                "group": "commons-logging"
              }
            ]
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "com.acme",
            "name": "core",
            "version": "1.4.2",
            "exclude": [
              {
                "group": "log4j"
              }
            ]
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "com.acme",
            "name": "sdk",
            "version": "4.2.0"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A build.gradle that mentions an exclusion that removes a group from the graph in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0963"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-exclude-group",
  "validationStatus": "VALIDATED"
}
