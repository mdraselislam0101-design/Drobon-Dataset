{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0581",
  "title": "Signal: Unbounded scanf conversion (c) — review required",
  "targets": [
    "c"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:sscanf\\s*\\([^)]*%s)"
  },
  "scope": "Single-line lexical match on scanf conversions in c code.",
  "limitations": "Lexical, line-based: matches the conversion.",
  "examples": [
    {
      "line": "sscanf(b, \"%s\", o)",
      "match": true
    },
    {
      "line": "# audit: sscanf(b, \"%s\", o) present",
      "match": true
    },
    {
      "line": "sscanf(b, \"%99s\", o)",
      "match": false
    },
    {
      "line": "# verified: sscanf(b, \"%99s\", o)",
      "match": false
    }
  ],
  "fpNotes": "Fixed-format input is the common false positive.",
  "linkedRules": [
    "DPK-SAST-464"
  ],
  "origin": "original-authored",
  "cell": "sast:buffer-flag:c",
  "validationStatus": "VALIDATED"
}
