{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0346",
  "title": "Signal: Hardcoded IV or nonce (universal) — review required",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "(?:iv|IV|nonce)\\s*[=:]\\s*[\"'][A-Za-z0-9+/=]{8,}[\"']"
  },
  "scope": "Single-line lexical match on literal IV or nonce assignments.",
  "limitations": "Lexical, line-based: matches literal IVs regardless of cipher mode.",
  "examples": [
    {
      "line": "iv = \"1234567890123456\"",
      "match": true
    },
    {
      "line": "# audit: iv = \"1234567890123456\" present",
      "match": true
    },
    {
      "line": "iv = os.urandom(16)",
      "match": false
    },
    {
      "line": "# verified: iv = os.urandom(16)",
      "match": false
    }
  ],
  "fpNotes": "Test vectors with fixed IVs are the common false positive — confirm test-only scope.",
  "linkedRules": [
    "DPK-SAST-307"
  ],
  "origin": "original-authored",
  "cell": "sast:static-iv:universal",
  "validationStatus": "VALIDATED"
}
