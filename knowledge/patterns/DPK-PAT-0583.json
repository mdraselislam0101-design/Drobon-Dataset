{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0583",
  "title": "Signal: OS command execution via shell/sh (clojure) — review required",
  "targets": [
    "clojure"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:shell/sh)\\s*\\("
  },
  "scope": "Single-line lexical match on the shell/sh call in clojure code.",
  "limitations": "Lexical, line-based: any shell/sh call matches.",
  "examples": [
    {
      "line": "shell/sh(payload)",
      "match": true
    },
    {
      "line": "out = shell/sh(data)",
      "match": true
    },
    {
      "line": "myshellsh(x)",
      "match": false
    },
    {
      "line": "shell/sh_safe()",
      "match": false
    }
  ],
  "fpNotes": "Fixed maintenance commands are the common false positive.",
  "linkedRules": [
    "DPK-SAST-466"
  ],
  "origin": "original-authored",
  "cell": "sast:cmd-exec-3:clojure",
  "validationStatus": "VALIDATED"
}
