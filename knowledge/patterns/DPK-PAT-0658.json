{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0658",
  "title": "Signal: Unsafe decoding via x.fromXML (java) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:fromXML)\\s*\\("
  },
  "scope": "Single-line lexical match on the x.fromXML call in java code.",
  "limitations": "Lexical, line-based: any x.fromXML call matches.",
  "examples": [
    {
      "line": "x.fromXML(payload)",
      "match": true
    },
    {
      "line": "out = x.fromXML(data)",
      "match": true
    },
    {
      "line": "myxfromXML(x)",
      "match": false
    },
    {
      "line": "x.fromXML_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted local data is the common false positive.",
  "linkedRules": [
    "DPK-SAST-541"
  ],
  "origin": "original-authored",
  "cell": "sast:java-deser-more:java",
  "validationStatus": "VALIDATED"
}
