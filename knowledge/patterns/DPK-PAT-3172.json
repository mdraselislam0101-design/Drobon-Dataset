{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3172",
  "title": "Signal: Possible a Bitbucket app password in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "ATBB[A-Za-z0-9]{28,}"
  },
  "scope": "Single-line shape match for a Bitbucket app password.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "password = \"ATBBAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: password = \"ATBBAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "password = \"xy\"",
      "match": false
    },
    {
      "line": "password = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-112"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-4:bitbucket-app-password",
  "validationStatus": "VALIDATED"
}
