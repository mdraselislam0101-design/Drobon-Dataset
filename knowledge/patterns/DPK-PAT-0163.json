{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0163",
  "title": "Signal: Framework SQL built from input (knex) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:knex\\.raw\\s*\\([^)]*(?:\\+|\\$\\{))"
  },
  "scope": "Single-line lexical match on assembled framework SQL (knex).",
  "limitations": "Lexical, line-based: any assembled query matches, including trusted ones.",
  "examples": [
    {
      "line": "knex.raw(\"SELECT \" + c)",
      "match": true
    },
    {
      "line": "# audit: knex.raw(\"SELECT \" + c) present",
      "match": true
    },
    {
      "line": "knex.raw(FIXED)",
      "match": false
    },
    {
      "line": "# verified: knex.raw(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-124"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli:javascript:knex",
  "validationStatus": "VALIDATED"
}
