{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1621",
  "title": "Signal: Secret read from the process environment (csharp)",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:GetEnvironmentVariable)\\s*\\("
  },
  "scope": "Single-line lexical match on environment reads in csharp code.",
  "limitations": "Lexical, line-based: matches the read without knowing whether the value is a secret.",
  "examples": [
    {
      "line": "Environment.GetEnvironmentVariable(payload)",
      "match": true
    },
    {
      "line": "out = Environment.GetEnvironmentVariable(data)",
      "match": true
    },
    {
      "line": "myEnvironmentGetEnvironmentVariable(x)",
      "match": false
    },
    {
      "line": "Environment.GetEnvironmentVariable_safe()",
      "match": false
    }
  ],
  "fpNotes": "Reading a non-sensitive setting such as a log level is the common false positive.",
  "linkedRules": [
    "DPK-SAST-994"
  ],
  "origin": "original-authored",
  "cell": "sast:env-secret-read:csharp:env",
  "validationStatus": "VALIDATED"
}
