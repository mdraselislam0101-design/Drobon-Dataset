{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1137",
  "title": "Signal: Certificate validation disabled for a connection in swift — review required",
  "targets": [
    "swift"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:setAllowsAnyHTTPSCertificate\\s*\\(\\s*true\\b)"
  },
  "scope": "Single-line match on disabled certificate validation in swift.",
  "limitations": "Lexical: matches the literal true; a conditional that only runs in debug is still reported.",
  "examples": [
    {
      "line": "connection.setAllowsAnyHTTPSCertificate(true, forHost: host)",
      "match": true
    },
    {
      "line": "# audit: connection.setAllowsAnyHTTPSCertificate(true, forHost: host) present",
      "match": true
    },
    {
      "line": "connection.setAllowsAnyHTTPSCertificate(false, forHost: host)",
      "match": false
    },
    {
      "line": "# verified: connection.setAllowsAnyHTTPSCertificate(false, forHost: host)",
      "match": false
    }
  ],
  "fpNotes": "A debug-only branch is the reviewed exception and should be removed before release.",
  "linkedRules": [
    "DPK-SAST-952"
  ],
  "origin": "original-authored",
  "cell": "sast:ios-allow-any-https:swift",
  "validationStatus": "VALIDATED"
}
