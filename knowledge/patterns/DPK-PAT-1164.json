{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1164",
  "title": "Signal: Content-Security-Policy script-src allows data: scripts",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "^(?:(?!script-src(?=[\\s;]|$))[^;]*;\\s*)*script-src(?=[\\s;]|$)[^;]*?(?<=\\s)data:(?=\\s|;|/|$)"
    }
  },
  "scope": "One response: script-src contains a data: scheme source.",
  "limitations": "Observation-level: reads script-src only. A policy that allows data: through default-src without a script-src override is a separate scope and is not reported by this check.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src data:"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; script-src 'self' data: blob:"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'; script-src data:"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self' https://cdn.example 'nonce-abc123'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "img-src data:"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src data:"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "An application that deliberately ships scripts as data: URLs is reported by design; the pattern is rare and weakens the origin boundary.",
  "linkedRules": [
    "DPK-DAST-095"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-script-src-data-scheme:script-src-data",
  "validationStatus": "VALIDATED"
}
