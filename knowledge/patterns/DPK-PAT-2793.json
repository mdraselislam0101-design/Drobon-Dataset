{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2793",
  "title": "Signal: Distribution declares no interpreter floor",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "options.python_requires"
    }
  },
  "scope": "A setup.cfg file that declares a setup.cfg with no `python_requires`.",
  "limitations": "It matches a setup.cfg with no `python_requires` in the parsed setup.cfg; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ]
        }
      },
      "match": true
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "packages": "demo"
        }
      },
      "match": true
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "python_requires": ">=3.11"
        }
      },
      "match": false
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "python_requires": ">=3.10,<4"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A setup.cfg that mentions a setup.cfg with no `python_requires` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0656"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-setupcfg-python-requires-absent",
  "validationStatus": "VALIDATED"
}
