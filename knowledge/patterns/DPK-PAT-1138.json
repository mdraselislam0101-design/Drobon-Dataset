{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1138",
  "title": "Signal: Keychain item readable while the device is locked in swift — review required",
  "targets": [
    "swift"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:kSecAttrAccessibleAlways\\b)"
  },
  "scope": "Single-line match on the always-accessible keychain class in swift.",
  "limitations": "Lexical: matches the accessibility constant; item contents are not inspected.",
  "examples": [
    {
      "line": "kSecAttrAccessible: kSecAttrAccessibleAlways",
      "match": true
    },
    {
      "line": "# audit: kSecAttrAccessible: kSecAttrAccessibleAlways present",
      "match": true
    },
    {
      "line": "kSecAttrAccessible: kSecAttrAccessibleWhenUnlockedThisDeviceOnly",
      "match": false
    },
    {
      "line": "# verified: kSecAttrAccessible: kSecAttrAccessibleWhenUnlockedThisDeviceOnly",
      "match": false
    }
  ],
  "fpNotes": "A non-sensitive cached identifier with a documented reason is the reviewed exception.",
  "linkedRules": [
    "DPK-SAST-953"
  ],
  "origin": "original-authored",
  "cell": "sast:ios-keychain-always:swift",
  "validationStatus": "VALIDATED"
}
