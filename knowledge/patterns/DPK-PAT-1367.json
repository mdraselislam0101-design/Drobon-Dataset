{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1367",
  "title": "Signal: Symfony exception trace disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?:Symfony\\\\Component\\\\HttpKernel\\\\Exception|Symfony\\\\Component\\\\Debug\\\\Exception)"
    }
  },
  "scope": "One response body containing a Symfony kernel or debug exception class name.",
  "limitations": "One response body. The check recognises the exception class; it does not decide whether the arguments printed were sensitive.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/cart",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "Symfony\\Component\\HttpKernel\\Exception\\NotFoundHttpException: No route found"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/cart",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "Symfony\\Component\\Debug\\Exception\\FatalErrorException in CartController.php line 88"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/cart",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Oops! An Error Occurred</h1><p>Something is broken.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/about",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>This application is built with Symfony components.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A documentation page that quotes the class name is reported; a Symfony-rendered production error page is not, because it names no exception class.",
  "linkedRules": [
    "DPK-DAST-298"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-symfony-exception-trace:symfony-exception",
  "validationStatus": "VALIDATED"
}
