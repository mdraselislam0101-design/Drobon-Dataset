{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0003",
  "title": "Signal: HSTS policy without max-age",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-missing-directive",
      "header": "strict-transport-security",
      "directive": "max-age"
    }
  },
  "scope": "Legacy signal mirrored from DPK-DAST-003.",
  "limitations": "Directive-presence only: max-age=0 (which disables HSTS) still counts as present. Max-age value strength is out of scope. A response with no Strict-Transport-Security header also matches; DPK-DAST-016 reports that absence as the stronger finding.",
  "examples": [
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "includeSubDomains"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {}
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": [
            "includeSubDomains",
            "max-age=31536000"
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Directive-presence only: max-age=0 (which disables HSTS) still counts as present. Max-age value strength is out of scope. A response with no Strict-Transport-Security header also matches; DPK-DAST-016 reports that absence as the stronger finding.",
  "linkedRules": [
    "DPK-DAST-003"
  ],
  "origin": "original-authored",
  "cell": "legacy:DPK-DAST-003",
  "validationStatus": "VALIDATED"
}
