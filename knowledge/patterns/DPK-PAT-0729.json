{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0729",
  "title": "Signal: Dangerous function call_user_func (php) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:call_user_func)\\s*\\("
  },
  "scope": "Single-line lexical match on the call_user_func call in php code.",
  "limitations": "Lexical, line-based: any call_user_func call matches.",
  "examples": [
    {
      "line": "call_user_func(payload)",
      "match": true
    },
    {
      "line": "out = call_user_func(data)",
      "match": true
    },
    {
      "line": "mycall_user_func(x)",
      "match": false
    },
    {
      "line": "call_user_func_safe()",
      "match": false
    }
  ],
  "fpNotes": "Legacy shims are the common false positive.",
  "linkedRules": [
    "DPK-SAST-612"
  ],
  "origin": "original-authored",
  "cell": "sast:php-call:php:userfunc",
  "validationStatus": "VALIDATED"
}
