{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0570",
  "title": "Signal: Weak response control (charset-less Content-Type)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-missing-directive",
      "header": "Content-Type",
      "directive": "charset"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Header check: it cannot confirm exploitability.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "CDN behaviors are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-045"
  ],
  "origin": "original-authored",
  "cell": "dast:response-weak-2:charset-missing",
  "validationStatus": "VALIDATED"
}
