{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0570",
  "title": "Signal: Charset-less text/html or text/plain Content-Type",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Type",
      "valuePattern": "^(?:text/html|text/plain)(?!.*\\bcharset\\b)"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Media-type scoped: only text/html and text/plain need a charset declaration here. application/json (RFC 8259), application/javascript (RFC 9239) and text/css are defined as UTF-8, binary types take no charset parameter, and a wholly missing Content-Type is reported by DPK-DAST-074.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "TEXT/HTML"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html;charset=UTF-8"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/api/orders",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/logo.png",
        "status": 200,
        "headers": {
          "Content-Type": "image/png"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/app.js",
        "status": 200,
        "headers": {
          "Content-Type": "application/javascript"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "CDN behaviors are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-045"
  ],
  "origin": "original-authored",
  "cell": "dast:response-weak-2:charset-missing",
  "validationStatus": "VALIDATED"
}
