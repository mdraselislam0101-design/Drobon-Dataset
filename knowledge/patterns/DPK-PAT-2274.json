{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2274",
  "title": "Signal: Pipfile source configured over cleartext",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "source[].url",
      "valuePattern": "^http://"
    }
  },
  "scope": "A Pipfile file that declares a Pipfile source URL that uses cleartext http.",
  "limitations": "It matches a Pipfile source URL that uses cleartext http in the parsed Pipfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Pipfile",
      "document": {
        "source": [
          {
            "name": "acme",
            "url": "http://pypi.acme.example/simple",
            "verify_ssl": true
          }
        ],
        "packages": {}
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "source": [
          {
            "name": "mirror",
            "url": "http://10.24.8.9/simple",
            "verify_ssl": true
          }
        ],
        "packages": {}
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "source": [
          {
            "name": "pypi",
            "url": "https://pypi.org/simple",
            "verify_ssl": true
          }
        ],
        "packages": {}
      },
      "match": false
    },
    {
      "file": "Pipfile",
      "document": {
        "source": [
          {
            "name": "acme",
            "url": "https://pypi.acme.example/simple"
          }
        ],
        "packages": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A Pipfile that mentions a Pipfile source URL that uses cleartext http in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0137"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-pipfile-source-cleartext",
  "validationStatus": "VALIDATED"
}
