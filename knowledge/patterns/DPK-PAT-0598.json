{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0598",
  "title": "Signal: Unsafe .NET call doc.LoadXml (csharp) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:LoadXml)\\s*\\("
  },
  "scope": "Single-line lexical match on the doc.LoadXml call in csharp code.",
  "limitations": "Lexical, line-based: any doc.LoadXml call matches.",
  "examples": [
    {
      "line": "doc.LoadXml(payload)",
      "match": true
    },
    {
      "line": "out = doc.LoadXml(data)",
      "match": true
    },
    {
      "line": "mydocLoadXml(x)",
      "match": false
    },
    {
      "line": "doc.LoadXml_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted local data is the common false positive.",
  "linkedRules": [
    "DPK-SAST-481"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-call:csharp:loadxml",
  "validationStatus": "VALIDATED"
