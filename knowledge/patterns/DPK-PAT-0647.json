{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0647",
  "title": "Signal: Go Exec built by concatenation (go) — review required",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.Exec\\s*\\([^)]*\\+"
  },
  "scope": "Single-line lexical match on assembled SQL in go code.",
  "limitations": "Lexical, line-based: any assembled statement matches.",
  "examples": [
    {
      "line": "db.Exec(\"INSERT \" + v)",
      "match": true
    },
    {
      "line": "# audit: db.Exec(\"INSERT \" + v) present",
      "match": true
    },
    {
      "line": "db.Exec(FIXED)",
      "match": false
    },
    {
      "line": "# verified: db.Exec(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-530"
  ],
  "origin": "original-authored",
  "cell": "sast:go-flag:go",
  "validationStatus": "VALIDATED"
}
