{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1151",
  "title": "Signal: Ruby or Rails stack frame disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "\\b[\\w./-]+\\.rb:\\d+:in\\s"
    }
  },
  "scope": "One response body: confirm a Ruby stack frame line.",
  "limitations": "Observation-level: matches one Ruby backtrace frame in the captured body. A custom error page that echoes a single file path without the :in marker is not reported.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/orders/42",
        "status": 500,
        "headers": {
          "Content-Type": "text/html; charset=utf-8"
        },
        "body": "<h1>We're sorry, but something went wrong.</h1><pre>app/controllers/orders_controller.rb:42:in `show'</pre>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/reports",
        "status": 500,
        "headers": {},
        "body": "vendor/bundle/ruby/3.2.0/gems/actionpack-7.0.4/lib/action_controller/metal.rb:12:in `dispatch'"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/orders/42",
        "status": 500,
        "headers": {},
        "body": "<p>Request failed. Reference 8f2c1a. Contact support.</p>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/health",
        "status": 200,
        "headers": {},
        "body": "orders.rb loaded successfully"
      },
      "match": false
    }
  ],
  "fpNotes": "A documentation page that shows an example backtrace, or a debug route enabled only for operators, is reported by design; the limitation states this.",
  "linkedRules": [
    "DPK-DAST-082"
  ],
  "origin": "original-authored",
  "cell": "dast:ruby-stack-trace:ruby-frame",
  "validationStatus": "VALIDATED"
}
