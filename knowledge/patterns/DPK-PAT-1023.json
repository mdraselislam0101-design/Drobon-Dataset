{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1023",
  "title": "Signal: Cookie sets SameSite=None without Secure",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Set-Cookie",
      "valuePattern": "^(?![^\\n]*(?:^|;)\\s*secure(?=[\\s;=]|$))(?=[^\\n]*(?:^|;)\\s*samesite\\s*=\\s*none\\s*(?:;|$))"
    }
  },
  "scope": "One response: inspect a Set-Cookie value for SameSite=None without Secure.",
  "limitations": "Value check on the cookie attribute list. A flag attribute ignores its value (RFC 6265 section 5.3), so `Secure=0` counts as Secure and is not reported. Only a cookie that the browser would store is judged: a discarded header sets no cookie. The rule reads one Set-Cookie value and cannot confirm that the cookie is used for a session.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; SameSite=None"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; SameSite=None"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; SameSite=None; Secure"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; SameSite=Lax"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/x",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Secure; SameSite=None"
        },
        "body": ""
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/x",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; HttpOnly; SameSite=None; Secure"
        },
        "body": ""
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "id=1; SameSite=None; Secure=0"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "id=1; SameSite=None; Secure=1; HttpOnly"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "id=1; SameSite=None; HttpOnly"
        }
      },
      "match": true
    }
  ],
  "fpNotes": "Cookies deliberately scoped to a trusted local origin during development are the accepted exception.",
  "linkedRules": [
    "DPK-DAST-071"
  ],
  "origin": "original-authored",
  "cell": "dast:cookie-samesite-none:samesite-none",
  "validationStatus": "VALIDATED"
}
