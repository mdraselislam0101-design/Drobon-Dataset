{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2332",
  "title": "Signal: Cargo lockfile resolves a crate from git",
  "targets": [
    "cargo"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages[].source",
      "valuePattern": "^git\\+"
    }
  },
  "scope": "A Cargo.lock file that declares a locked crate whose source is a git remote.",
  "limitations": "It matches a locked crate whose source is a git remote in the parsed Cargo.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Cargo.lock",
      "document": {
        "version": 4,
        "packages": [
          {
            "name": "acme-sdk",
            "version": "4.2.0",
            "source": "git+https://github.com/acme/sdk?rev=9f2c4a1#9f2c4a1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Cargo.lock",
      "document": {
        "version": 4,
        "packages": [
          {
            "name": "acme-cli",
            "version": "2.1.0",
            "source": "git+ssh://git@github.com/acme/cli#0a1b2c3"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Cargo.lock",
      "document": {
        "version": 4,
        "packages": [
          {
            "name": "acme-sdk",
            "version": "4.2.0",
            "source": "registry+https://github.com/rust-lang/crates.io-index"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Cargo.lock",
      "document": {
        "version": 4,
        "packages": [
          {
            "name": "serde",
            "version": "1.0.210",
            "source": "registry+https://github.com/rust-lang/crates.io-index"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Cargo.lock that mentions a locked crate whose source is a git remote in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0195"
  ],
  "origin": "original-authored",
  "cell": "sca:cargo-lock-git-source",
  "validationStatus": "VALIDATED"
}
