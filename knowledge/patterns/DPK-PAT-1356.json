{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1356",
  "title": "Signal: Server-Timing exposes backend timing to every client",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Server-Timing",
      "valuePattern": "^\\s*\\S"
    }
  },
  "scope": "One Server-Timing response header carrying a non-empty value.",
  "limitations": "One header value. The check reports the presence of Server-Timing; it does not measure the accuracy of the timings or decide whether a named metric reveals a specific internal service.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/api/items",
        "status": 200,
        "headers": {
          "Server-Timing": "db;dur=53.2, cache;desc=\"miss\""
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "server-timing": "edge;dur=12"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server-Timing": ""
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server-Timing": "   "
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A response that intentionally publishes coarse performance marks for a public API is reported; the header is still a side channel and the owner may accept it explicitly.",
  "linkedRules": [
    "DPK-DAST-287"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-server-timing-header:server-timing-present",
  "validationStatus": "VALIDATED"
}
