{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0194",
  "title": "Signal: LDAP filter built by concatenation (python) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.search\\s*\\([^)]*(?:\\+|%|\\{)"
  },
  "scope": "Single-line lexical match on assembled LDAP filters in python code.",
  "limitations": "Lexical, line-based: any assembled filter matches, including trusted ones.",
  "examples": [
    {
      "line": "conn.search(base, f\"(uid={u})\")",
      "match": true
    },
    {
      "line": "# audit: conn.search(base, f\"(uid={u})\") present",
      "match": true
    },
    {
      "line": "conn.search(base, FIXED)",
      "match": false
    },
    {
      "line": "# verified: conn.search(base, FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed organizational units is the common false positive.",
  "linkedRules": [
    "DPK-SAST-155"
  ],
  "origin": "original-authored",
  "cell": "sast:ldap-inject:python",
  "validationStatus": "VALIDATED"
}
