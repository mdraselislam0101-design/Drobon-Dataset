{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2851",
  "title": "Signal: Dependency ranged above the zero release",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^>0\\.0\\.0$"
    }
  },
  "scope": "A package.json file that declares a `>0.0.0` specifier that excludes nothing meaningful.",
  "limitations": "It matches a `>0.0.0` specifier that excludes nothing meaningful in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21",
          "chalk": ">0.0.0"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21",
          "debug": ">0.0.0"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21",
          "chalk": "^5.3.0"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21",
          "debug": ">=4.3.0 <5"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A package.json that mentions a `>0.0.0` specifier that excludes nothing meaningful in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0714"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-spec-greater-than-zero",
  "validationStatus": "VALIDATED"
}
