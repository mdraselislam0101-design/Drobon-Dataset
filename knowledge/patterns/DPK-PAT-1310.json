{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1310",
  "title": "Signal: PHP-FPM status page disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*pool:)(?=[\\s\\S]*process\\ manager)"
    }
  },
  "scope": "One response whose body renders the PHP-FPM status template.",
  "limitations": "One response body. The rule reports the status template; it does not exercise the workers and cannot show the pool configuration beyond what the page prints.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>PHP-FPM Status Page</h1><table><tr><td>pool:</td><td>www</td></tr><tr><td>process manager:</td><td>dynamic</td></tr><tr><td>accepted conn:</td><td>4821</td></tr></table></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "PHP-FPM Status Page\npool: www\nprocess manager: ondemand\naccepted conn: 912\nlisten queue: 0"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>PHP-FPM Status Page</h1><table><tr><td></td><td>www</td></tr><tr><td>:</td><td>dynamic</td></tr><tr><td>accepted conn:</td><td>4821</td></tr></table></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A PHP page that prints the word pool is not reported; the process manager line is required.",
  "linkedRules": [
    "DPK-DAST-241"
  ],
  "origin": "original-authored",
  "cell": "dast:body-php-fpm-status:php-fpm-status",
  "validationStatus": "VALIDATED"
}
