{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3206",
  "title": "Signal: Possible an Adyen API key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "AQE[A-Za-z0-9_-]{28,}"
  },
  "scope": "Single-line shape match for an Adyen API key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"AQEAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: key = \"AQEAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-146"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-5:adyen-api-key",
  "validationStatus": "VALIDATED"
}
