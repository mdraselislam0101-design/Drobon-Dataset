{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0113",
  "title": "Signal: CSRF protection disabled (ruby) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:skip_before_action[^#]*verify_authenticity_token)"
  },
  "scope": "Single-line lexical match on CSRF-disabling settings in ruby code.",
  "limitations": "Lexical, line-based: matches the switch regardless of endpoint sensitivity.",
  "examples": [
    {
      "line": "skip_before_action :verify_authenticity_token",
      "match": true
    },
    {
      "line": "# audit: skip_before_action :verify_authenticity_token present",
      "match": true
    },
    {
      "line": "protect_from_forgery with: :exception",
      "match": false
    },
    {
      "line": "# verified: protect_from_forgery with: :exception",
      "match": false
    }
  ],
  "fpNotes": "Stateless token-authenticated APIs are the common false positive — confirm no cookie session exists.",
  "linkedRules": [
    "DPK-SAST-074"
  ],
  "origin": "original-authored",
  "cell": "sast:csrf-exempt:ruby",
  "validationStatus": "VALIDATED"
}
