{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0002",
  "title": "Signal: Content-Security-Policy header missing",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "missing-response-header",
      "header": "content-security-policy"
    }
  },
  "scope": "Legacy signal mirrored from DPK-DAST-002.",
  "limitations": "Presence-only: a present-but-permissive policy (e.g. unsafe-inline everywhere) still passes this check. Policy strength is out of scope.",
  "examples": [
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "server": "example"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Presence-only: a present-but-permissive policy (e.g. unsafe-inline everywhere) still passes this check. Policy strength is out of scope.",
  "linkedRules": [
    "DPK-DAST-002"
  ],
  "origin": "original-authored",
  "cell": "legacy:DPK-DAST-002",
  "validationStatus": "VALIDATED"
}
