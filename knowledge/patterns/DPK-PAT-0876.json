{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0876",
  "title": "Signal: Possible a Perplexity key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "pplx-[A-Za-z0-9]{32,}"
  },
  "scope": "Single-line shape match for a Perplexity key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"pplx-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: key = \"pplx-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-088"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-2:perplexity-key",
  "validationStatus": "VALIDATED"
}
