{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0539",
  "title": "Signal: Framework SQL built from input (yii) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:createCommand\\s*\\([^)]*(?:\"[^\"\\n]*\\$|\\.\\s*\\$))"
  },
  "scope": "Single-line lexical match on assembled SQL (yii).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "createCommand(\"SELECT $q\")",
      "match": true
    },
    {
      "line": "# audit: createCommand(\"SELECT $q\") present",
      "match": true
    },
    {
      "line": "createCommand($fixed)",
      "match": false
    },
    {
      "line": "# verified: createCommand($fixed)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-442"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli-extra:php:yii",
  "validationStatus": "VALIDATED"
}
