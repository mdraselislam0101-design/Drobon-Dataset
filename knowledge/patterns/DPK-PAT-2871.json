{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2871",
  "title": "Signal: Hex project metadata with no licence list",
  "targets": [
    "hex"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "package.licenses"
    }
  },
  "scope": "A mix.exs file that declares an application that declares no licence for what it ships.",
  "limitations": "It matches an application that declares no licence for what it ships in the parsed mix.exs; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "phoenix",
            "requirement": "~> 1.7"
          }
        ],
        "package": {}
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "phoenix",
            "requirement": "~> 1.7"
          }
        ],
        "package": {
          "links": {}
        }
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "phoenix",
            "requirement": "~> 1.7"
          }
        ],
        "package": {
          "licenses": [
            "MIT"
          ]
        }
      },
      "match": false
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "phoenix",
            "requirement": "~> 1.7"
          }
        ],
        "package": {
          "licenses": [
            "Apache-2.0"
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A mix.exs that mentions an application that declares no licence for what it ships in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0734"
  ],
  "origin": "original-authored",
  "cell": "sca:hex-package-license-absent",
  "validationStatus": "VALIDATED"
}
