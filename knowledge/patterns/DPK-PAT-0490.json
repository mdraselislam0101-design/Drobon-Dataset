{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0490",
  "title": "Signal: Possible a GitHub server token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "ghs_[A-Za-z0-9]{36,}"
  },
  "scope": "Single-line shape match for a GitHub server token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"ghs_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"ghs_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-024"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:github-server",
  "validationStatus": "VALIDATED"
}
