{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2325",
  "title": "Signal: Cargo dependency declared with a wildcard",
  "targets": [
    "cargo"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*.version",
      "valuePattern": "^\\*$"
    }
  },
  "scope": "A Cargo.toml file that declares a `version = \"*\"` dependency.",
  "limitations": "It matches a `version = \"*\"` dependency in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "serde": {
            "version": "*"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "rand": {
            "version": "*"
          },
          "serde": {
            "version": "1.0.210"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "rand": {
            "version": "0.8.5"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Cargo.toml that mentions a `version = \"*\"` dependency in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0188"
  ],
  "origin": "original-authored",
  "cell": "sca:cargo-dependency-wildcard",
  "validationStatus": "VALIDATED"
}
