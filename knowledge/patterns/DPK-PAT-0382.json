{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0382",
  "title": "Signal: TLS checks disabled (k8s) — review required",
  "targets": [
    "yaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "insecure-skip-tls-verify\\s*:\\s*true"
  },
  "scope": "Single-line lexical match on TLS-disabling flags for k8s.",
  "limitations": "Lexical, line-based: matches the flag regardless of environment.",
  "examples": [
    {
      "line": "insecure-skip-tls-verify: true",
      "match": true
    },
    {
      "line": "# audit: insecure-skip-tls-verify: true present",
      "match": true
    },
    {
      "line": "insecure-skip-tls-verify: false",
      "match": false
    },
    {
      "line": "# verified: insecure-skip-tls-verify: false",
      "match": false
    }
  ],
  "fpNotes": "Local bootstrap scripts are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-343"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-cli:yaml:k8s",
  "validationStatus": "VALIDATED"
}
