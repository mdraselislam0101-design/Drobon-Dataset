{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2891",
  "title": "Signal: a nuget.config that disables no inherited source",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "disabledPackageSources"
    }
  },
  "scope": "A nuget.config file that declares a configuration that leaves every inherited source enabled.",
  "limitations": "It matches a configuration that leaves every inherited source enabled in the parsed nuget.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "disabledPackageSources": {
          "add": [
            {
              "key": "machine-feed",
              "value": "true"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "disabledPackageSources": {
          "add": [
            {
              "key": "myget",
              "value": "true"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A nuget.config that mentions a configuration that leaves every inherited source enabled in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0754"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-disabled-source-absent",
  "validationStatus": "VALIDATED"
}
