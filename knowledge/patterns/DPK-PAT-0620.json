{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0620",
  "title": "Signal: Django security setting off (djhsts) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "SECURE_HSTS_SECONDS\\s*=\\s*0\\b"
  },
  "scope": "Single-line lexical match on Django settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "SECURE_HSTS_SECONDS = 0",
      "match": true
    },
    {
      "line": "# audit: SECURE_HSTS_SECONDS = 0 present",
      "match": true
    },
    {
      "line": "SECURE_HSTS_SECONDS = 31536000",
      "match": false
    },
    {
      "line": "# verified: SECURE_HSTS_SECONDS = 31536000",
      "match": false
    }
  ],
  "fpNotes": "Local development is the common false positive.",
  "linkedRules": [
    "DPK-SAST-503"
  ],
  "origin": "original-authored",
  "cell": "sast:django-secure:python:djhsts",
  "validationStatus": "VALIDATED"
}
