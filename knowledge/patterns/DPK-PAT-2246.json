{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2246",
  "title": "Signal: pnpm dependency resolved as a live directory link",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "importers.*.dependencies.*.version",
      "valuePattern": "^link:"
    }
  },
  "scope": "A pnpm-lock.yaml file that declares an importer dependency that resolves to a `link:` path instead of a registry version.",
  "limitations": "It matches an importer dependency that resolves to a `link:` path instead of a registry version in the parsed pnpm-lock.yaml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "importers": {
          ".": {
            "dependencies": {
              "acme-ui": {
                "specifier": "workspace:*",
                "version": "link:packages/ui"
              }
            }
          }
        },
        "packages": {}
      },
      "match": true
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "importers": {
          "apps/web": {
            "dependencies": {
              "acme-shared": {
                "specifier": "workspace:^",
                "version": "link:../../packages/shared"
              }
            }
          }
        },
        "packages": {}
      },
      "match": true
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "importers": {
          ".": {
            "dependencies": {
              "acme-ui": {
                "specifier": "^2.3.1",
                "version": "2.3.1"
              }
            }
          }
        },
        "packages": {}
      },
      "match": false
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "importers": {
          ".": {
            "dependencies": {
              "ms": {
                "specifier": "^2.1.3",
                "version": "2.1.3(react@18.2.0)"
              }
            }
          }
        },
        "packages": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A pnpm-lock.yaml that mentions an importer dependency that resolves to a `link:` path instead of a registry version in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0109"
  ],
  "origin": "original-authored",
  "cell": "sca:pnpm-lock-link-dependency",
  "validationStatus": "VALIDATED"
}
