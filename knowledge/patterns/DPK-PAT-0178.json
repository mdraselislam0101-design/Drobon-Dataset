{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0178",
  "title": "Signal: Wildcard IAM in armactions — review required",
  "targets": [
    "json"
  ],
  "signal": {
    "kind": "regex",
    "source": "\"actions\"\\s*:\\s*\\[\\s*\"\\*\""
  },
  "scope": "Single-line lexical match on wildcard IAM (armactions).",
  "limitations": "Lexical, line-based: matches the wildcard regardless of trust policy.",
  "examples": [
    {
      "line": "\"actions\": [\"*\"]",
      "match": true
    },
    {
      "line": "# audit: \"actions\": [\"*\"] present",
      "match": true
    },
    {
      "line": "\"actions\": [\"read\"]",
      "match": false
    },
    {
      "line": "# verified: \"actions\": [\"read\"]",
      "match": false
    }
  ],
  "fpNotes": "Break-glass roles are the rare accepted case — confirm controls.",
  "linkedRules": [
    "DPK-SAST-139"
  ],
  "origin": "original-authored",
  "cell": "sast:iac-iam-star:json:armactions",
  "validationStatus": "VALIDATED"
}
