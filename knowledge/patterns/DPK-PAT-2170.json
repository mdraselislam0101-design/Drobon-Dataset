{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2170",
  "title": "Signal: Dependency declared only by exclusions",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^!="
    }
  },
  "scope": "A package.json file that declares a specifier that names only versions to exclude.",
  "limitations": "It matches a specifier that names only versions to exclude in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "!=4.1.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "!=2.0.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": ">=4.1.1"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "An exclusion written inside a closed range is bounded and is not reported.",
  "linkedRules": [
    "DPK-SCA-0033"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-not-equal-only",
  "validationStatus": "VALIDATED"
}
