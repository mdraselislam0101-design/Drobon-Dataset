{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1161",
  "title": "Signal: Content-Security-Policy frame-ancestors allows every origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "^(?:(?!frame-ancestors)[^;]*;\\s*)*frame-ancestors(?=\\s)[^;]*?(?<=\\s)(?:\\*|(?:https?|wss?)://\\*)(?=\\s|;|$)"
    }
  },
  "scope": "One response: frame-ancestors contains a standalone wildcard.",
  "limitations": "Observation-level: matches a standalone wildcard in frame-ancestors. A policy that omits the directive entirely is reported by a separate rule.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors 'self' *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors 'self'; frame-ancestors *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *; frame-ancestors 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors https://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors https://*.example.com"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A documented embeddable widget may intentionally allow any parent; it is still reported because the header cannot express that intent.",
  "linkedRules": [
    "DPK-DAST-092"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-frame-ancestors-wildcard:frame-ancestors",
  "validationStatus": "VALIDATED"
}
