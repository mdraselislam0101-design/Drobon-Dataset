{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0727",
  "title": "Signal: Dangerous function mcrypt_encrypt (php) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:mcrypt_encrypt)\\s*\\("
  },
  "scope": "Single-line lexical match on the mcrypt_encrypt call in php code.",
  "limitations": "Lexical, line-based: any mcrypt_encrypt call matches.",
  "examples": [
    {
      "line": "mcrypt_encrypt(payload)",
      "match": true
    },
    {
      "line": "out = mcrypt_encrypt(data)",
      "match": true
    },
    {
      "line": "mymcrypt_encrypt(x)",
      "match": false
    },
    {
      "line": "mcrypt_encrypt_safe()",
      "match": false
    }
  ],
  "fpNotes": "Legacy shims are the common false positive.",
  "linkedRules": [
    "DPK-SAST-610"
  ],
  "origin": "original-authored",
  "cell": "sast:php-call:php:mcrypt",
  "validationStatus": "VALIDATED"
}
