{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0878",
  "title": "Signal: Possible a PlanetScale password in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "pscale_pw_[A-Za-z0-9]{32,}"
  },
  "scope": "Single-line shape match for a PlanetScale password.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "password = \"pscale_pw_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: password = \"pscale_pw_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "password = \"xy\"",
      "match": false
    },
    {
      "line": "password = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-090"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-2:planetscale-pw",
  "validationStatus": "VALIDATED"
}
