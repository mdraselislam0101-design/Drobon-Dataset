{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0229",
  "title": "Signal: OAuth implicit flow (universal) — review required",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:response_type\\s*=\\s*token)"
  },
  "scope": "Single-line lexical match on OAuth response types.",
  "limitations": "Lexical, line-based: matches the response type.",
  "examples": [
    {
      "line": "response_type=token",
      "match": true
    },
    {
      "line": "# audit: response_type=token present",
      "match": true
    },
    {
      "line": "response_type=code",
      "match": false
    },
    {
      "line": "# verified: response_type=code",
      "match": false
    }
  ],
  "fpNotes": "None common.",
  "linkedRules": [
    "DPK-SAST-190"
  ],
  "origin": "original-authored",
  "cell": "sast:oauth-implicit:universal:oauth",
  "validationStatus": "VALIDATED"
}
