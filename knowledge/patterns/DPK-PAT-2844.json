{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2844",
  "title": "Signal: Locked environment records no interpreter version",
  "targets": [
    "rubygems"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "ruby_version"
    }
  },
  "scope": "A Gemfile.lock file that declares a Gemfile.lock with no `RUBY VERSION` section.",
  "limitations": "It matches a Gemfile.lock with no `RUBY VERSION` section in the parsed Gemfile.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "checksums": {
          "rails": "sha256=9f2c3d4e"
        },
        "bundled_with": "BUNDLED WITH 2.5.11"
      },
      "match": true
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "checksums": {
          "rails": "sha256=9f2c3d4e"
        },
        "bundled_with": "BUNDLED WITH 2.5.11"
      },
      "match": true
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "checksums": {
          "rails": "sha256=9f2c3d4e"
        },
        "ruby_version": "ruby 3.3.4p94",
        "bundled_with": "BUNDLED WITH 2.5.11"
      },
      "match": false
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "checksums": {
          "rails": "sha256=9f2c3d4e"
        },
        "ruby_version": "ruby 3.2.5p208",
        "bundled_with": "BUNDLED WITH 2.5.11"
      },
      "match": false
    }
  ],
  "fpNotes": "A Gemfile.lock that mentions a Gemfile.lock with no `RUBY VERSION` section in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0707"
  ],
  "origin": "original-authored",
  "cell": "sca:gemfile-lock-ruby-version-absent",
  "validationStatus": "VALIDATED"
}
