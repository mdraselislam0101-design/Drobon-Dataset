{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0745",
  "title": "Signal: Privilege or root change via setgid (c) — review required",
  "targets": [
    "c"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:setgid)\\s*\\("
  },
  "scope": "Single-line lexical match on the setgid call in c code.",
  "limitations": "Lexical, line-based: any setgid call matches.",
  "examples": [
    {
      "line": "setgid(payload)",
      "match": true
    },
    {
      "line": "out = setgid(data)",
      "match": true
    },
    {
      "line": "mysetgid(x)",
      "match": false
    },
    {
      "line": "setgid_safe()",
      "match": false
    }
  ],
  "fpNotes": "Correct privilege drops are the common false positive.",
  "linkedRules": [
    "DPK-SAST-628"
  ],
  "origin": "original-authored",
  "cell": "sast:priv-call:c:setgid",
  "validationStatus": "VALIDATED"
}
