{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1182",
  "title": "Signal: Alt-Svc advertises a cleartext HTTP/2 alternative",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Alt-Svc",
      "valuePattern": "(?:^|,)\\s*h2c\\s*=\\s*\""
    }
  },
  "scope": "One response whose Alt-Svc value offers an h2c alternative.",
  "limitations": "Header value check on one response. It cannot prove the advertised authority is reachable or that any client selected the alternative, and it does not follow the advertisement.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Alt-Svc": "h2c=\":80\""
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Alt-Svc": "h3=\":443\", h2c=\":8080\"; ma=86400"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Alt-Svc": "h2c=\":443\""
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Alt-Svc": "h3=\":443\"; ma=86400"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Alt-Svc": "h2=\":443\"; ma=60"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Alt-Svc": "clear"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A lab or loopback deployment may advertise h2c deliberately for local testing; the observation still shows a cleartext alternative offered to whoever received the header.",
  "linkedRules": [
    "DPK-DAST-113"
  ],
  "origin": "original-authored",
  "cell": "dast:alt-svc-h2c:h2c",
  "validationStatus": "VALIDATED"
}
