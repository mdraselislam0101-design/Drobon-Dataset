{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0317",
  "title": "Signal: Spring CSRF disabled (java) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "csrf\\s*\\(\\s*\\)\\s*\\.\\s*disable\\s*\\(\\s*\\)"
  },
  "scope": "Single-line lexical match on the Spring call.",
  "limitations": "Lexical, line-based: matches the call.",
  "examples": [
    {
      "line": ".csrf().disable()",
      "match": true
    },
    {
      "line": "# audit: .csrf().disable() present",
      "match": true
    },
    {
      "line": ".csrf().enable()",
      "match": false
    },
    {
      "line": "# verified: .csrf().enable()",
      "match": false
    }
  ],
  "fpNotes": "Stateless token APIs are the common false positive.",
  "linkedRules": [
    "DPK-SAST-278"
  ],
  "origin": "original-authored",
  "cell": "sast:spring-csrf:java:springcsrf",
  "validationStatus": "VALIDATED"
}
