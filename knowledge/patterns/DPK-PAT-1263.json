{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1263",
  "title": "Signal: Access-Control-Allow-Origin carries no host",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Allow-Origin",
      "valuePattern": "^\\s*https?:/*\\s*$"
    }
  },
  "scope": "One response whose Access-Control-Allow-Origin value is a scheme with no host component.",
  "limitations": "One header value. The rule judges the declared value and cannot see which origin asked, so it does not claim the response was ever usable.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "http://"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://app.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A value of `*` is not reported here; the wildcard has its own rule and a different meaning.",
  "linkedRules": [
    "DPK-DAST-194"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-origin-bare-scheme:origin-bare-scheme",
  "validationStatus": "VALIDATED"
}
