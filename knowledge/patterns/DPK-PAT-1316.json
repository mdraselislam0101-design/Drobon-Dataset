{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1316",
  "title": "Signal: Traefik dashboard disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*traefik)(?=[\\s\\S]*Dashboard)"
    }
  },
  "scope": "One response whose body renders the Traefik dashboard.",
  "limitations": "One response body. The rule reports the dashboard; it does not read provider data and cannot show whether the API is enabled insecurely.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Traefik</title></head><body><div id=\"traefik-dashboard\"></div><script src=\"/dashboard/traefik.js\"></script><h1>Dashboard</h1></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h2>Traefik</h2><section id=\"dashboard\"><p>HTTP Routers</p></section></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><div id=\"-\"></div><script src=\"//.js\"></script><h1></h1></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that mentions Traefik without the dashboard container is not reported.",
  "linkedRules": [
    "DPK-DAST-247"
  ],
  "origin": "original-authored",
  "cell": "dast:body-traefik-dashboard:traefik-dashboard",
  "validationStatus": "VALIDATED"
}
