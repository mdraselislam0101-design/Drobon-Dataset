{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1511",
  "title": "Signal: Apache Ranger admin UI is reachable without authentication",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*<title>[^<]{0,40}Ranger)(?=[\\s\\S]*>\\s*Policies\\s*<)"
    }
  },
  "scope": "A response body with the Ranger title and a Policies marker.",
  "limitations": "One response body. The rule reports the policy list; it does not create a policy.",
  "examples": [
    {
      "observation": {
        "url": "https://ranger.example/index.html#!/policies",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "<html><head><title>Ranger</title></head><body><nav><a href=\"#!/policies\">Policies</a></nav></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://ranger.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "<html><head><title>Apache Ranger</title></head><body><h1>Policies</h1></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://ranger.example/docs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "<html><head><title>Governance</title></head><body><p>Ranger evaluates a policy for each access request.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page about data governance is not reported without both markers.",
  "linkedRules": [
    "DPK-DAST-442"
  ],
  "origin": "original-authored",
  "cell": "dast:console-ranger:console-ranger",
  "validationStatus": "VALIDATED"
}
