{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1118",
  "title": "Signal: Shell command executed through callCommand or callShell in haskell — review required",
  "targets": [
    "haskell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bcall(?:Command|Shell)\\s*\\("
  },
  "scope": "Single-line match on shell-based process calls in haskell.",
  "limitations": "Lexical: matches callCommand and callShell; callProcess is out of scope and is the safer form.",
  "examples": [
    {
      "line": "callCommand (\"convert \" ++ userFile ++ \" out.png\")",
      "match": true
    },
    {
      "line": "# audit: callCommand (\"convert \" ++ userFile ++ \" out.png\") present",
      "match": true
    },
    {
      "line": "callProcess \"convert\" [userFile, \"out.png\"]",
      "match": false
    },
    {
      "line": "# verified: callProcess \"convert\" [userFile, \"out.png\"]",
      "match": false
    }
  ],
  "fpNotes": "Constant commands in build tooling are the accepted false positives.",
  "linkedRules": [
    "DPK-SAST-933"
  ],
  "origin": "original-authored",
  "cell": "sast:haskell-callcommand:haskell",
  "validationStatus": "VALIDATED"
}
