{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1228",
  "title": "Signal: Set-Cookie carries an unrecognised SameSite value",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Set-Cookie",
      "valuePattern": ";\\s*samesite\\s*(?:;|$)|;\\s*samesite\\s*=\\s*(?!(?:strict|lax|none)(?:\\s*;|\\s*$))[^;]*"
    }
  },
  "scope": "One response whose Set-Cookie header names SameSite with an undefined value or with no value.",
  "limitations": "One header value. The rule validates the attribute token as written and never infers the browser's fallback for a particular version; a cookie the browser discards is also reported, because the header is still wrong.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; Secure; HttpOnly; SameSite=Strictt"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; Secure; HttpOnly; SameSite="
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; Secure; HttpOnly; SameSite"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; SameSite=Lax"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; SameSite=Strict; Secure"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; SameSite=None; Secure"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A value from a newer specification revision than the scanner knows would be reported; the three values above are the ones browsers implement.",
  "linkedRules": [
    "DPK-DAST-159"
  ],
  "origin": "original-authored",
  "cell": "dast:set-cookie-invalid-samesite:invalid-value",
  "validationStatus": "VALIDATED"
}
