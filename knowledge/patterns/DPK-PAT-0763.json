{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0763",
  "title": "Signal: Cleartext protocol client (imap) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "imaplib\\.IMAP4\\s*\\("
  },
  "scope": "Single-line lexical match on cleartext clients (imap).",
  "limitations": "Lexical, line-based: matches the client.",
  "examples": [
    {
      "line": "imaplib.IMAP4(h)",
      "match": true
    },
    {
      "line": "# audit: imaplib.IMAP4(h) present",
      "match": true
    },
    {
      "line": "imaplib.IMAP4_SSL(h)",
      "match": false
    },
    {
      "line": "# verified: imaplib.IMAP4_SSL(h)",
      "match": false
    }
  ],
  "fpNotes": "Loopback use is the common accepted case.",
  "linkedRules": [
    "DPK-SAST-646"
  ],
  "origin": "original-authored",
  "cell": "sast:python-net-plain:python:imap",
  "validationStatus": "VALIDATED"
}
