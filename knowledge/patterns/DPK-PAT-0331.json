{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0331",
  "title": "Signal: Weak SSH daemon setting (empty) — review required",
  "targets": [
    "sshd"
  ],
  "signal": {
    "kind": "regex",
    "source": "PermitEmptyPasswords\\s+yes"
  },
  "scope": "Single-line lexical match on sshd settings (empty).",
  "limitations": "Lexical, line-based: matches the setting regardless of network exposure.",
  "examples": [
    {
      "line": "PermitEmptyPasswords yes",
      "match": true
    },
    {
      "line": "# audit: PermitEmptyPasswords yes present",
      "match": true
    },
    {
      "line": "PermitEmptyPasswords no",
      "match": false
    },
    {
      "line": "# verified: PermitEmptyPasswords no",
      "match": false
    }
  ],
  "fpNotes": "Isolated lab hosts are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-292"
  ],
  "origin": "original-authored",
  "cell": "sast:ssh-strict:sshd:empty",
  "validationStatus": "VALIDATED"
}
