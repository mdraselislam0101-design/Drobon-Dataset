{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0768",
  "title": "Signal: Rails protection weakened (forgexcept) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:protect_from_forgery\\s+except:)"
  },
  "scope": "Single-line lexical match on Rails config.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "protect_from_forgery except: :create",
      "match": true
    },
    {
      "line": "# audit: protect_from_forgery except: :create present",
      "match": true
    },
    {
      "line": "protect_from_forgery with: :exception",
      "match": false
    },
    {
      "line": "# verified: protect_from_forgery with: :exception",
      "match": false
    }
  ],
  "fpNotes": "Development config is the common false positive.",
  "linkedRules": [
    "DPK-SAST-651"
  ],
  "origin": "original-authored",
  "cell": "sast:rails-secure:ruby:forgexcept",
  "validationStatus": "VALIDATED"
}
