{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1475",
  "title": "Signal: Nuxt DevTools overlay served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*nuxt-devtools)(?=[\\s\\S]*__NUXT_DEVTOOLS__)"
    }
  },
  "scope": "One response body containing the Nuxt DevTools overlay shell.",
  "limitations": "One response body. The rule reports the overlay shell; it does not walk the component tree.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"__nuxt\"></div><iframe class=\"nuxt-devtools-frame\" src=\"/_nuxt/devtools\" title=\"Nuxt DevTools\"></iframe><script>window.__NUXT_DEVTOOLS__ = 1;</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/_nuxt/devtools",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Nuxt DevTools</title><script>window.__NUXT_DEVTOOLS__ = {}</script></head><body><div class=\"nuxt-devtools-panel\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"__nuxt\"><h1>Shop</h1></div></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Nuxt guide</title></head><body><p>Disable devtools before building for production.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that mentions DevTools in prose is not reported, because the overlay marker is required.",
  "linkedRules": [
    "DPK-DAST-406"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-debug-nuxt-devtools:nuxt-devtools",
  "validationStatus": "VALIDATED"
}
