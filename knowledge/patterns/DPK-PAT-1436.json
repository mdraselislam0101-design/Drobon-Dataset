{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1436",
  "title": "Signal: Set-Cookie Domain ends with a dot",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Set-Cookie",
      "valuePattern": "^(?=[^\\n]*;\\s*domain\\s*=\\s*[a-z0-9](?:[a-z0-9.-]{0,60}[a-z0-9])?\\.\\s*(?:;|$))"
    }
  },
  "scope": "One Set-Cookie value whose Domain attribute ends with a dot.",
  "limitations": "One Set-Cookie value. The check reads the attribute text; it does not test the cookie against a specific browser.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Domain=app.example.; Path=/; Secure"
        },
        "body": ""
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Domain=example.com.; Path=/; HttpOnly"
        },
        "body": ""
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Domain=app.example; Path=/; Secure"
        },
        "body": ""
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/v1.; Secure"
        },
        "body": ""
      },
      "match": false
    }
  ],
  "fpNotes": "A domain without the trailing dot is not reported, and an address literal is covered by the Domain-IP rule instead.",
  "linkedRules": [
    "DPK-DAST-367"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-cookie-domain-trailing-dot:cookie-domain-trailing-dot",
  "validationStatus": "VALIDATED"
}
