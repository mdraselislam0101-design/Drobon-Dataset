{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2872",
  "title": "Signal: Pubspec that overrides a dependency",
  "targets": [
    "pub"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependency_overrides.*",
      "valuePattern": "^.+$"
    }
  },
  "scope": "A pubspec.yaml file that declares a `dependency_overrides` entry that replaces the declared constraint.",
  "limitations": "It matches a `dependency_overrides` entry that replaces the declared constraint in the parsed pubspec.yaml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {
          "http": "1.1.0"
        }
      },
      "match": true
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {
          "intl": "0.19.0"
        }
      },
      "match": true
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": false
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pubspec.yaml that mentions a `dependency_overrides` entry that replaces the declared constraint in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0735"
  ],
  "origin": "original-authored",
  "cell": "sca:pub-overrides-present",
  "validationStatus": "VALIDATED"
}
