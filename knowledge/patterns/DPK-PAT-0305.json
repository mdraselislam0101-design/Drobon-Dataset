{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0305",
  "title": "Signal: auth left open (neo4j) — review required",
  "targets": [
    "neo4j"
  ],
  "signal": {
    "kind": "regex",
    "source": "auth_enabled\\s*=\\s*false"
  },
  "scope": "Single-line lexical match on open settings for auth.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "auth_enabled=false",
      "match": true
    },
    {
      "line": "# audit: auth_enabled=false present",
      "match": true
    },
    {
      "line": "auth_enabled=true",
      "match": false
    },
    {
      "line": "# verified: auth_enabled=true",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-266"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:neo4j:auth",
  "validationStatus": "VALIDATED"
}
