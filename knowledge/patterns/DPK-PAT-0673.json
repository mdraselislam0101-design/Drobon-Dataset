{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0673",
  "title": "Signal: TLS trust weakened (rmi) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:RMIClassLoader)"
  },
  "scope": "Single-line lexical match on TLS trust code (rmi).",
  "limitations": "Lexical, line-based: matches the weakness.",
  "examples": [
    {
      "line": "RMIClassLoader.loadClass(url, name)",
      "match": true
    },
    {
      "line": "# audit: RMIClassLoader.loadClass(url, name) present",
      "match": true
    },
    {
      "line": "Class.forName(name)",
      "match": false
    },
    {
      "line": "# verified: Class.forName(name)",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive.",
  "linkedRules": [
    "DPK-SAST-556"
  ],
  "origin": "original-authored",
  "cell": "sast:java-tls-more:java:rmi",
  "validationStatus": "VALIDATED"
}
