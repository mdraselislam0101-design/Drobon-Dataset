{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2206",
  "title": "Signal: Lockfile entries without a SHA-2 integrity value",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "packages",
      "field": "integrity"
    }
  },
  "scope": "A package-lock.json file that declares a package entry that carries no SHA-2 integrity value in the lockfile.",
  "limitations": "It matches a package entry that carries no SHA-2 integrity value in the lockfile in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "name": "left-pad"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "resolved": "https://registry.npmjs.org/a/-/a-2.0.0.tgz"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org/left-pad/-/left-pad-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "integrity": "sha512-QQQQWWWWEEEERRRR"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A lockfile written by an old npm that only emitted sha1 shows up under the sha1 rule, not this one.",
  "linkedRules": [
    "DPK-SCA-0069"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-integrity-absent",
  "validationStatus": "VALIDATED"
}
