{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1234",
  "title": "Signal: Cloud Storage bucket listing disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*<ListBucketResult)(?=[\\s\\S]*storage\\.googleapis\\.com)"
    }
  },
  "scope": "One response whose body is a bucket listing with a ListBucketResult root served from storage.googleapis.com.",
  "limitations": "One response body. The rule reports the listing; it does not download an object and cannot show what the objects contain.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><ListBucketResult xmlns=\"http://doc.s3.amazonaws.com/2006-03-01/\"><Name>assets-prod</Name><Contents><Key>backup.sql.gz</Key></Contents></ListBucketResult><!-- storage.googleapis.com -->"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?xml version=\"1.0\"?><ListBucketResult><Name>media</Name><Contents><Key>video.mp4</Key></Contents></ListBucketResult><!-- storage.googleapis.com/storage/v1 -->"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?> xmlns=\"http://doc.s3.amazonaws.com/2006-03-01/\"><Name>assets-prod</Name><Contents><Key>backup.sql.gz</Key></Contents></ListBucketResult><!--  -->"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A bucket deliberately configured for public listing is still reported; the finding is the anonymous listing, not that the objects are sensitive.",
  "linkedRules": [
    "DPK-DAST-165"
  ],
  "origin": "original-authored",
  "cell": "dast:body-gcs-bucket-listing:gcs-bucket-listing",
  "validationStatus": "VALIDATED"
}
