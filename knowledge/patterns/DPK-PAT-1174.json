{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1174",
  "title": "Signal: Content-Security-Policy object-src allows every origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "^(?:(?!object-src(?=[\\s;]|$))[^;]*;\\s*)*object-src(?=[\\s;]|$)[^;]*?(?<=\\s)(?:\\*|(?:https?|wss?)://\\*)(?=\\s|;|$)"
    }
  },
  "scope": "One Content-Security-Policy value whose first object-src declaration contains the wildcard or a scheme wildcard host.",
  "limitations": "One header value, first declaration of the directive only. It reports the wildcard permission, not whether an object element exists on the page.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "object-src *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; object-src 'self' https://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "object-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "object-src https://*.example.com"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "object-src 'self'; object-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A legacy page that still embeds a same-origin plugin through a wildcard can be reported; the observation cannot tell which object content is intended.",
  "linkedRules": [
    "DPK-DAST-105"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-object-src-wildcard:object-src",
  "validationStatus": "VALIDATED"
}
