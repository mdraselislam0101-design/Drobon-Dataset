{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1144",
  "title": "Signal: File response built from a runtime path in python — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bsend_file\\s*\\(\\s*[A-Za-z_][\\w.]*"
  },
  "scope": "Single-line match on send_file with a runtime argument in python.",
  "limitations": "Lexical: matches a non-literal first argument; a helper that validates the path is not seen.",
  "examples": [
    {
      "line": "return send_file(request.args.get(\"name\"))",
      "match": true
    },
    {
      "line": "# audit: return send_file(request.args.get(\"name\")) present",
      "match": true
    },
    {
      "line": "return send_file(\"static/report.pdf\")",
      "match": false
    },
    {
      "line": "# verified: return send_file(\"static/report.pdf\")",
      "match": false
    }
  ],
  "fpNotes": "A path resolved from an allowlisted map is the reviewed exception.",
  "linkedRules": [
    "DPK-SAST-959"
  ],
  "origin": "original-authored",
  "cell": "sast:python-sendfile-dynamic:python",
  "validationStatus": "VALIDATED"
}
