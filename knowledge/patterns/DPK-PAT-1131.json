{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1131",
  "title": "Signal: App-private file written with world access in java — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:MODE_WORLD_(?:READABLE|WRITEABLE))"
  },
  "scope": "Single-line match on world-accessible file modes in java.",
  "limitations": "Lexical: matches the mode constant; values held in a variable are out of scope.",
  "examples": [
    {
      "line": "openFileOutput(\"session\", MODE_WORLD_READABLE);",
      "match": true
    },
    {
      "line": "# audit: openFileOutput(\"session\", MODE_WORLD_READABLE); present",
      "match": true
    },
    {
      "line": "openFileOutput(\"session\", MODE_PRIVATE);",
      "match": false
    },
    {
      "line": "# verified: openFileOutput(\"session\", MODE_PRIVATE);",
      "match": false
    }
  ],
  "fpNotes": "A legacy migration path with an explicit, reviewed exception is the only accepted use.",
  "linkedRules": [
    "DPK-SAST-946"
  ],
  "origin": "original-authored",
  "cell": "sast:android-world-readable:java",
  "validationStatus": "VALIDATED"
}
