{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1042",
  "title": "Signal: Non-cryptographic random bytes used as a token in javascript — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bpseudoRandomBytes\\s*\\("
  },
  "scope": "Single-line match on pseudoRandomBytes in javascript.",
  "limitations": "Lexical: matches pseudoRandomBytes calls; Math.random and other weak sources are covered by separate rules.",
  "examples": [
    {
      "line": "const token = crypto.pseudoRandomBytes(16).toString(\"hex\");",
      "match": true
    },
    {
      "line": "# audit: const token = crypto.pseudoRandomBytes(16).toString(\"hex\"); present",
      "match": true
    },
    {
      "line": "const token = crypto.randomBytes(16).toString(\"hex\");",
      "match": false
    },
    {
      "line": "# verified: const token = crypto.randomBytes(16).toString(\"hex\");",
      "match": false
    }
  ],
  "fpNotes": "Non-security uses such as test data generation are the accepted false positives.",
  "linkedRules": [
    "DPK-SAST-859"
  ],
  "origin": "original-authored",
  "cell": "sast:js-pseudorandom-bytes:javascript",
  "validationStatus": "VALIDATED"
}
