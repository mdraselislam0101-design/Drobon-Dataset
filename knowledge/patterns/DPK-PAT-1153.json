{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1153",
  "title": "Signal: CORS exposes every response header to any origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Expose-Headers",
      "valuePattern": "^\\*$"
    }
  },
  "scope": "One response: confirm a wildcard exposure declaration.",
  "limitations": "Observation-level: evaluates the Access-Control-Expose-Headers header alone. It does not evaluate whether the origin policy also permits an untrusted origin.",
  "examples": [
    {
      "observation": {
        "url": "https://api.example/v1/orders",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://app.example",
          "Access-Control-Expose-Headers": "*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/v1/orders",
        "status": 200,
        "headers": {
          "Access-Control-Expose-Headers": " * "
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/v1/orders",
        "status": 200,
        "headers": {
          "Access-Control-Expose-Headers": "X-Total-Count, ETag"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://api.example/v1/orders",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://app.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/x",
        "status": 200,
        "headers": {
          "Access-Control-Expose-Headers": "X-*"
        },
        "body": ""
      },
      "match": false
    }
  ],
  "fpNotes": "A public read-only API may expose all headers deliberately; it is still reported because the header cannot express that distinction.",
  "linkedRules": [
    "DPK-DAST-084"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-expose-headers-wildcard:expose",
  "validationStatus": "VALIDATED"
}
