{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2316",
  "title": "Signal: Gradle verification entry with an empty signature field",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "components[].artifacts[].pgp",
      "valuePattern": "^$"
    }
  },
  "scope": "A verification-metadata.xml file that declares an artifact entry whose signature value is empty.",
  "limitations": "It matches an artifact entry whose signature value is empty in the parsed verification-metadata.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "com.acme",
            "name": "internal-core",
            "version": "1.4.2",
            "artifacts": [
              {
                "name": "internal-core-1.4.2.jar",
                "pgp": ""
              }
            ]
          }
        ]
      },
      "match": true
    },
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "org.example",
            "name": "lib",
            "version": "2.0.1",
            "artifacts": [
              {
                "name": "lib-2.0.1.jar",
                "pgp": ""
              }
            ]
          }
        ]
      },
      "match": true
    },
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "com.acme",
            "name": "internal-core",
            "version": "1.4.2",
            "artifacts": [
              {
                "name": "internal-core-1.4.2.jar",
                "pgp": "9F2C4A1B"
              }
            ]
          }
        ]
      },
      "match": false
    },
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "org.example",
            "name": "lib",
            "version": "2.0.1",
            "artifacts": [
              {
                "name": "lib-2.0.1.jar",
                "pgp": "0A1B2C3D"
              }
            ]
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A verification-metadata.xml that mentions an artifact entry whose signature value is empty in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0179"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-verification-signature-absent",
  "validationStatus": "VALIDATED"
}
