{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2944",
  "title": "Signal: Poetry package from a non-index source",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "package[].source.type",
      "valuePattern": "^(?:legacy|url|git)$"
    }
  },
  "scope": "A poetry.lock file that declares a `source.type` other than the default index.",
  "limitations": "It matches a `source.type` other than the default index in the parsed poetry.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "acme-sdk",
            "version": "4.2.0",
            "source": {
              "type": "legacy",
              "url": "https://pypi.acme.example/simple"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "acme-core",
            "version": "1.4.2",
            "source": {
              "type": "git",
              "url": "https://github.com/acme/core"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "version": "2.32.3"
          }
        ]
      },
      "match": false
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "urllib3",
            "version": "2.2.2",
            "source": {
              "type": "file",
              "url": "/opt/vendor"
            }
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A poetry.lock that mentions a `source.type` other than the default index in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0807"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-poetry-legacy-source",
  "validationStatus": "VALIDATED"
}
