{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2813",
  "title": "Signal: Test tooling ships into the runtime environment",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-key-matches",
      "path": "packages",
      "keyPattern": "^pytest"
    }
  },
  "scope": "A Pipfile file that declares a test framework declared in Pipfile `[packages]` instead of `[dev-packages]`.",
  "limitations": "It matches a test framework declared in Pipfile `[packages]` instead of `[dev-packages]` in the parsed Pipfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3",
          "pytest": "==8.3.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3",
          "pytest-cov": "==5.0.0"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": false
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3",
          "pytest-cov": "==5.0.0"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Pipfile that mentions a test framework declared in Pipfile `[packages]` instead of `[dev-packages]` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0676"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-dev-dep-in-pipfile-packages",
  "validationStatus": "VALIDATED"
}
