{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0630",
  "title": "Signal: ECB mode selected (ecb, ruby) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "AES-[0-9]+-ECB"
  },
  "scope": "Single-line lexical match on ECB selection (ecb).",
  "limitations": "Lexical, line-based: matches the mode name.",
  "examples": [
    {
      "line": "OpenSSL::Cipher.new(\"AES-128-ECB\")",
      "match": true
    },
    {
      "line": "# audit: OpenSSL::Cipher.new(\"AES-128-ECB\") present",
      "match": true
    },
    {
      "line": "OpenSSL::Cipher.new(\"AES-128-CBC\")",
      "match": false
    },
    {
      "line": "# verified: OpenSSL::Cipher.new(\"AES-128-CBC\")",
      "match": false
    }
  ],
  "fpNotes": "Single-block uses are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-513"
  ],
  "origin": "original-authored",
  "cell": "sast:ecb-more:ruby:ecb",
  "validationStatus": "VALIDATED"
}
