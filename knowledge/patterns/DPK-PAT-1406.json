{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1406",
  "title": "Signal: crossdomain.xml permits every origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*<cross-domain-policy>)(?=[\\s\\S]*allow-access-from[^>]{0,80}domain\\s*=\\s*\"\\*\")"
    }
  },
  "scope": "One response body containing a cross-domain policy that allows every origin.",
  "limitations": "One response body. The rule reads the policy; it does not test a client against it, and modern browsers no longer load these files.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/crossdomain.xml",
        "status": 200,
        "headers": {
          "Content-Type": "application/xml"
        },
        "body": "<?xml version=\"1.0\"?>\n<cross-domain-policy>\n  <allow-access-from domain=\"*\" />\n</cross-domain-policy>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/crossdomain.xml",
        "status": 200,
        "headers": {
          "Content-Type": "application/xml"
        },
        "body": "<cross-domain-policy>\n  <site-control permitted-cross-domain-policies=\"all\"/>\n  <allow-access-from domain=\"*\" secure=\"false\"/>\n</cross-domain-policy>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/crossdomain.xml",
        "status": 200,
        "headers": {
          "Content-Type": "application/xml"
        },
        "body": "<cross-domain-policy>\n  <allow-access-from domain=\"app.example\" />\n</cross-domain-policy>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/policy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>A cross-domain policy should list explicit domains.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A restrictive policy that lists explicit domains is not reported, and the response header that names which policy files may load is a separate rule.",
  "linkedRules": [
    "DPK-DAST-337"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-artefact-crossdomain-allow-all:crossdomain-allow-all",
  "validationStatus": "VALIDATED"
}
