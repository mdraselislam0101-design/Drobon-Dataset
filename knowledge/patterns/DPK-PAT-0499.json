{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0499",
  "title": "Signal: Possible an npm token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "npm_[A-Za-z0-9]{36,}"
  },
  "scope": "Single-line shape match for an npm token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-033"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:npm-token",
  "validationStatus": "VALIDATED"
}
