{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1321",
  "title": "Signal: Multipart Content-Type omits the boundary parameter",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Type",
      "valuePattern": "^(?![\\s\\S]*\\bboundary\\b)\\s*multipart/[^;\\s]+"
    }
  },
  "scope": "One response whose multipart Content-Type omits the boundary parameter.",
  "limitations": "One header value. The rule validates the parameter only; it does not parse the body and cannot show how a particular client handles the missing parameter.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "multipart/form-data"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "multipart/mixed"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "multipart/form-data; boundary=----abc123"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A missing Content-Type header is a different finding with its own rule.",
  "linkedRules": [
    "DPK-DAST-252"
  ],
  "origin": "original-authored",
  "cell": "dast:content-type-multipart-no-boundary:type-multipart-no-boundary",
  "validationStatus": "VALIDATED"
}
