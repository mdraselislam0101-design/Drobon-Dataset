{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1186",
  "title": "Signal: Referrer-Policy sends full URLs to cross-origin destinations",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Referrer-Policy",
      "valuePattern": "(?:^|[,\\s])no-referrer-when-downgrade(?:$|[,\\s])"
    }
  },
  "scope": "One response whose Referrer-Policy value is no-referrer-when-downgrade.",
  "limitations": "Header value check on one response. It cannot see which URLs carry sensitive query strings or whether a destination is third-party.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "no-referrer-when-downgrade"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "strict-origin-when-cross-origin, no-referrer-when-downgrade"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "strict-origin-when-cross-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "no-referrer"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "unsafe-url"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A site whose URLs are entirely public is still reported; the observation cannot judge the sensitivity of individual paths.",
  "linkedRules": [
    "DPK-DAST-117"
  ],
  "origin": "original-authored",
  "cell": "dast:referrer-policy-nrwd:value",
  "validationStatus": "VALIDATED"
}
