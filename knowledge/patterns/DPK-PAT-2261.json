{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2261",
  "title": "Signal: pyproject dependency with no version constraint",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.dependencies[]",
      "valuePattern": "^[A-Za-z0-9._-]{1,80}$"
    }
  },
  "scope": "A pyproject.toml file that declares a dependency string that names only the package.",
  "limitations": "It matches a dependency string that names only the package in the parsed pyproject.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "requests"
          ]
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "flask",
            "jinja2==3.1.4"
          ]
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "requests==2.32.3"
          ]
        }
      },
      "match": false
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "flask>=3.0,<4"
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pyproject.toml that mentions a dependency string that names only the package in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0124"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-pyproject-unbounded-dependency",
  "validationStatus": "VALIDATED"
}
