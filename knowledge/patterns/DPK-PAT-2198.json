{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2198",
  "title": "Signal: Lockfile pins the public registry to a non-standard port",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.resolved",
      "valuePattern": "^https://registry\\.npmjs\\.org:\\d{2,5}/"
    }
  },
  "scope": "A package-lock.json file that declares a lockfile entry that reaches the public registry on an explicit non-standard port.",
  "limitations": "It matches a lockfile entry that reaches the public registry on an explicit non-standard port in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org:8443/x/-/x-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "resolved": "https://registry.npmjs.org:8080/y/-/y-2.0.0.tgz"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org/x/-/x-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "resolved": "https://registry.npmjs.org/y/-/y-2.0.0.tgz"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A corporate TLS-inspecting proxy is still reported; record it as an accepted exception.",
  "linkedRules": [
    "DPK-SCA-0061"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-registry-port",
  "validationStatus": "VALIDATED"
}
