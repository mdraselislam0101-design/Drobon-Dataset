{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0484",
  "title": "Signal: Possible an npmrc auth token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "_authToken=[A-Za-z0-9]{24,}"
  },
  "scope": "Single-line shape match for an npmrc auth token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "line = \"_authToken=AAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: line = \"_authToken=AAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "line = \"xy\"",
      "match": false
    },
    {
      "line": "line = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-018"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:dotenv-auth",
  "validationStatus": "VALIDATED"
}
