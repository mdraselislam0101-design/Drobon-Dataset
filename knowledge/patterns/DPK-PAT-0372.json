{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0372",
  "title": "Signal: Risky Terraform setting (skipsnap) — review required",
  "targets": [
    "hcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "skip_final_snapshot\\s*=\\s*true"
  },
  "scope": "Single-line lexical match on risky Terraform settings (skipsnap).",
  "limitations": "Lexical, line-based: matches the setting regardless of account scope.",
  "examples": [
    {
      "line": "skip_final_snapshot = true",
      "match": true
    },
    {
      "line": "# audit: skip_final_snapshot = true present",
      "match": true
    },
    {
      "line": "skip_final_snapshot = false",
      "match": false
    },
    {
      "line": "# verified: skip_final_snapshot = false",
      "match": false
    }
  ],
  "fpNotes": "Sandbox accounts are the common false positive — confirm account scope.",
  "linkedRules": [
    "DPK-SAST-333"
  ],
  "origin": "original-authored",
  "cell": "sast:terraform-strict:hcl:skipsnap",
  "validationStatus": "VALIDATED"
}
