{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1179",
  "title": "Signal: Refresh header redirects to a plaintext URL",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Refresh",
      "valuePattern": "\\burl\\s*=\\s*['\"]?http://"
    }
  },
  "scope": "One Refresh value whose url parameter begins with http://.",
  "limitations": "One Refresh value. The rule does not follow the navigation and cannot tell what the target serves.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "0; url=http://app.example/home"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "5; URL='http://app.example/home'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "0; url=https://app.example/home"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "30"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "0; url=/home"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberate navigation to a plaintext internal host is reported; the observation has no network-context evidence.",
  "linkedRules": [
    "DPK-DAST-110"
  ],
  "origin": "original-authored",
  "cell": "dast:refresh-plaintext:refresh-http",
  "validationStatus": "VALIDATED"
}
