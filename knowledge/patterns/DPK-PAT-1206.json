{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1206",
  "title": "Signal: Spring Actuator index disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*\"_links\")(?=[\\s\\S]*/actuator)"
    }
  },
  "scope": "One response whose body contains both an _links map and the token actuator.",
  "limitations": "Two body markers. A generic JSON API response that happens to contain _links is not reported unless it also names actuator.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/actuator",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"_links\":{\"self\":{\"href\":\"http://localhost:8080/actuator\"},\"env\":{\"href\":\"http://localhost:8080/actuator/env\"}}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/actuator/",
        "status": 200,
        "headers": {
          "Content-Type": "application/hal+json"
        },
        "body": "{\"_links\":{\"health\":{\"href\":\"/actuator/health\"}}} <!-- actuator -->"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"_links\":{\"self\":\"/api/items\"}}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>Home</body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A client library page that quotes the actuator index is reported only if it reproduces both markers.",
  "linkedRules": [
    "DPK-DAST-137"
  ],
  "origin": "original-authored",
  "cell": "dast:body-spring-actuator-index:body-spring-actuator-index",
  "validationStatus": "VALIDATED"
}
