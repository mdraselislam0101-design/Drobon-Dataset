{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3191",
  "title": "Signal: Possible a Resend API key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "re_[A-Za-z0-9]{24,}"
  },
  "scope": "Single-line shape match for a Resend API key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"re_AAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: key = \"re_AAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-131"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-4:resend-api-key",
  "validationStatus": "VALIDATED"
}
