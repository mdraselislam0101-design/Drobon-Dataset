{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2318",
  "title": "Signal: NuGet feed configured over cleartext",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "sources[].value",
      "valuePattern": "^http://"
    }
  },
  "scope": "A nuget.config file that declares a package source URL that uses cleartext http.",
  "limitations": "It matches a package source URL that uses cleartext http in the parsed nuget.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "acme",
            "value": "http://nuget.acme.example/v3/index.json"
          }
        ],
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "mirror",
            "value": "http://10.24.8.9/v3/index.json"
          }
        ],
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "acme",
            "value": "https://nuget.acme.example/v3/index.json"
          }
        ],
        "settings": {}
      },
      "match": false
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "settings": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A nuget.config that mentions a package source URL that uses cleartext http in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0181"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-source-cleartext",
  "validationStatus": "VALIDATED"
}
