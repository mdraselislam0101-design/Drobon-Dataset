{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1289",
  "title": "Signal: Drupal version in generator meta tag",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*name=[\"\\']Generator[\"\\'])(?=[\\s\\S]*Drupal)"
    }
  },
  "scope": "One response whose body publishes a Drupal version in a generator meta tag.",
  "limitations": "One response body. The rule reports the meta tag; it does not look up an advisory and makes no claim that the release is vulnerable.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta name=\"Generator\" content=\"Drupal 10 (https://www.drupal.org)\"><title>Portal</title></head><body>Portal</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><head><meta name=\"generator\" content=\"Drupal 9 (https://www.drupal.org)\"></head><body>Home</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta  content=\" 10 (https://www..org)\"><title>Portal</title></head><body>Portal</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "An RSS feed that names Drupal is not reported; the meta tag is required.",
  "linkedRules": [
    "DPK-DAST-220"
  ],
  "origin": "original-authored",
  "cell": "dast:body-drupal-generator-meta:drupal-generator-meta",
  "validationStatus": "VALIDATED"
}
