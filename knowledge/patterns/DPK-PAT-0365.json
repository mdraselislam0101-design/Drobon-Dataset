{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0365",
  "title": "Signal: Risky Terraform setting (dbpublic) — review required",
  "targets": [
    "hcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "publicly_accessible\\s*=\\s*true"
  },
  "scope": "Single-line lexical match on risky Terraform settings (dbpublic).",
  "limitations": "Lexical, line-based: matches the setting regardless of account scope.",
  "examples": [
    {
      "line": "publicly_accessible = true",
      "match": true
    },
    {
      "line": "# audit: publicly_accessible = true present",
      "match": true
    },
    {
      "line": "publicly_accessible = false",
      "match": false
    },
    {
      "line": "# verified: publicly_accessible = false",
      "match": false
    }
  ],
  "fpNotes": "Sandbox accounts are the common false positive — confirm account scope.",
  "linkedRules": [
    "DPK-SAST-326"
  ],
  "origin": "original-authored",
  "cell": "sast:terraform-strict:hcl:dbpublic",
  "validationStatus": "VALIDATED"
}
