{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0529",
  "title": "Signal: Possible credentials in a URL in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "[A-Za-z][A-Za-z0-9+.\\-]*://[^\\s:@/]*:[A-Za-z0-9]{12,}@"
  },
  "scope": "Single-line shape match for credentials in a URL.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "url = \"postgresql://user:AAAAAAAAAAAA@\"",
      "match": true
    },
    {
      "line": "# audit: url = \"postgresql://user:AAAAAAAAAAAA@\" present",
      "match": true
    },
    {
      "line": "url = \"xy\"",
      "match": false
    },
    {
      "line": "url = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    },
    {
      "line": "url = \"POSTGRESQL://root:AAAAAAAAAAAA@db.internal:5432/app\"",
      "match": true
    },
    {
      "line": "url = \"mysql://user:AAAAAAAAAAAA@db.internal/app?ssl=true\"",
      "match": true
    },
    {
      "line": "url = \"postgresql://user:AAAAAAAAAAA@\"",
      "match": false
    },
    {
      "line": "url = \"postgresql://user:AAAAAAAAAAAA\"",
      "match": false
    },
    {
      "line": "url = \"postgresql://user@db.internal/app\"",
      "match": false
    },
    {
      "line": "url = \"https://service.test:8443/path\"",
      "match": false
    },
    {
      "line": "url = \"mongodb+srv://svc:AAAAAAAAAAAA@cluster0.internal/app\"",
      "match": true
    },
    {
      "line": "url = \"redis://:AAAAAAAAAAAA@cache.internal:6379/0\"",
      "match": true
    },
    {
      "line": "url = \"postgresql://user:<password>@db.internal/app\"",
      "match": false
    },
    {
      "line": "url = \"postgresql://user:${DB_PASSWORD}@db.internal/app\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-063"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:url-credentials",
  "validationStatus": "VALIDATED"
}
