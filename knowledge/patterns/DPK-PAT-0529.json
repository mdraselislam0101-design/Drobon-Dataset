{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0529",
  "title": "Signal: Possible credentials in a URL in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "https?://[^\\s:@/]+:[A-Za-z0-9]{12,}@"
  },
  "scope": "Single-line shape match for credentials in a URL.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "url = \"https://user:AAAAAAAAAAAA@\"",
      "match": true
    },
    {
      "line": "# audit: url = \"https://user:AAAAAAAAAAAA@\" present",
      "match": true
    },
    {
      "line": "url = \"xy\"",
      "match": false
    },
    {
      "line": "url = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-063"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:url-credentials",
  "validationStatus": "VALIDATED"
}
