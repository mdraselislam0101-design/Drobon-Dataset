{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1385",
  "title": "Signal: Anchor navigates to a data: URI",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<a\\b[^>]{0,300}href\\s*=\\s*[\"']\\s*data:"
    }
  },
  "scope": "One anchor element whose href is a data: URI.",
  "limitations": "One response body. The check reads static markup; it does not execute the URI and cannot see whether a script inside it would run in this browser.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/invoice",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<a href=\"data:text/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg==\">Open</a>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/invoice",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<a href='data:text/plain,hello'>Open</a>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/invoice",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<a href=\"https://files.example/invoice.pdf\">Download</a>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/invoice",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<img src=\"data:image/png;base64,iVBORw0KGgo=\" alt=\"logo\">"
      },
      "match": false
    }
  ],
  "fpNotes": "An <img src=\"data:...\"> is not reported, because images do not create a navigable document; only anchors are inspected.",
  "linkedRules": [
    "DPK-DAST-316"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-data-uri-anchor:data-anchor",
  "validationStatus": "VALIDATED"
}
