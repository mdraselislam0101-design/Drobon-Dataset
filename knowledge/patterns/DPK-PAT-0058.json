{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0058",
  "title": "Signal: Server version disclosed (X-Generator header)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-Generator",
      "valuePattern": "[^ ]"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Banner check: version visibility alone is not exploitability.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Generator": "Drupal 10"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Generator": "WordPress 6.4"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Honeypot banners are the rare false positive.",
  "linkedRules": [
    "DPK-DAST-028"
  ],
  "origin": "original-authored",
  "cell": "dast:server-version:generator",
  "validationStatus": "VALIDATED"
}
