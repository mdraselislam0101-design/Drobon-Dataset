{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0824",
  "title": "Signal: Server-side fetch of assembled URL (julia) — review required",
  "targets": [
    "julia"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:HTTP\\.get\\s*\\([^)]*\\*)"
  },
  "scope": "Single-line lexical match on assembled fetch URLs in julia code.",
  "limitations": "Lexical, line-based: any assembled fetch URL matches.",
  "examples": [
    {
      "line": "HTTP.get(base * p)",
      "match": true
    },
    {
      "line": "# audit: HTTP.get(base * p) present",
      "match": true
    },
    {
      "line": "HTTP.get(FIXED)",
      "match": false
    },
    {
      "line": "# verified: HTTP.get(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-707"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-4:julia",
  "validationStatus": "VALIDATED"
}
