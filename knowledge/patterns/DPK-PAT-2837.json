{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2837",
  "title": "Signal: Composer runs the script after every dependency update",
  "targets": [
    "composer"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "scripts.post-update-cmd[]",
      "valuePattern": "^.+$"
    }
  },
  "scope": "A composer.json file that declares a `post-update-cmd` script.",
  "limitations": "It matches a `post-update-cmd` script in the parsed composer.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {
          "post-update-cmd": [
            "php ./scripts/migrate.php"
          ]
        }
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {
          "post-update-cmd": [
            "@php artisan migrate"
          ]
        }
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {
          "test": [
            "phpunit"
          ]
        }
      },
      "match": false
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A composer.json that mentions a `post-update-cmd` script in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0700"
  ],
  "origin": "original-authored",
  "cell": "sca:composer-post-update-script",
  "validationStatus": "VALIDATED"
}
