{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0337",
  "title": "Signal: Server-side fetch of assembled URL (kotlin) — review required",
  "targets": [
    "kotlin"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:URL\\s*\\([^)]*\\+)"
  },
  "scope": "Single-line lexical match on assembled fetch URLs in kotlin code.",
  "limitations": "Lexical, line-based: any assembled fetch URL matches.",
  "examples": [
    {
      "line": "URL(base + p)",
      "match": true
    },
    {
      "line": "# audit: URL(base + p) present",
      "match": true
    },
    {
      "line": "URL(FIXED)",
      "match": false
    },
    {
      "line": "# verified: URL(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-298"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-langs:kotlin",
  "validationStatus": "VALIDATED"
}
