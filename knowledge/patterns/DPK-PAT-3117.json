{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3117",
  "title": "Signal: vcpkg manifest with no version constraints",
  "targets": [
    "vcpkg"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "version-constraints"
    }
  },
  "scope": "A vcpkg.json file that declares a manifest that accepts whatever version the baseline resolves.",
  "limitations": "It matches a manifest that accepts whatever version the baseline resolves in the parsed vcpkg.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "vcpkg.json",
      "document": {
        "name": "demo",
        "version": "1.4.0",
        "dependencies": [
          "fmt"
        ],
        "builtin-baseline": "9f2c3d4e5f60718293a4b5c6d7e8f90123456789",
        "overrides": []
      },
      "match": true
    },
    {
      "file": "vcpkg.json",
      "document": {
        "name": "demo",
        "version": "1.4.0",
        "dependencies": [
          "fmt"
        ],
        "builtin-baseline": "9f2c3d4e5f60718293a4b5c6d7e8f90123456789",
        "overrides": []
      },
      "match": true
    },
    {
      "file": "vcpkg.json",
      "document": {
        "name": "demo",
        "version": "1.4.0",
        "dependencies": [
          "fmt"
        ],
        "builtin-baseline": "9f2c3d4e5f60718293a4b5c6d7e8f90123456789",
        "overrides": [],
        "version-constraints": [
          {
            "name": "fmt",
            "version>=": "10.2.1"
          }
        ]
      },
      "match": false
    },
    {
      "file": "vcpkg.json",
      "document": {
        "name": "demo",
        "version": "1.4.0",
        "dependencies": [
          "fmt"
        ],
        "builtin-baseline": "9f2c3d4e5f60718293a4b5c6d7e8f90123456789",
        "overrides": [],
        "version-constraints": [
          {
            "name": "zlib",
            "version>=": "1.3.1"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A vcpkg.json that mentions a manifest that accepts whatever version the baseline resolves in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0980"
  ],
  "origin": "original-authored",
  "cell": "sca:vcpkg-version-constraint-absent",
  "validationStatus": "VALIDATED"
}
