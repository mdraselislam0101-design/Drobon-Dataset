{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1504",
  "title": "Signal: CouchDB Fauxton console is reachable without authentication",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*<title>[^<]{0,40}Fauxton)(?=[\\s\\S]*>\\s*Databases\\s*<)"
    }
  },
  "scope": "A response body with the Fauxton title and a Databases marker.",
  "limitations": "One response body. The rule reports the console shell; it does not open a database.",
  "examples": [
    {
      "observation": {
        "url": "https://couch.example/_utils/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "<html><head><title>Project Fauxton</title></head><body><nav><a href=\"#/_all_dbs\">Databases</a></nav></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://couch.example/_utils/index.html",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "<html><head><title>Fauxton</title></head><body><h1>Databases</h1></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://couch.example/docs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "<html><head><title>Storage</title></head><body><p>CouchDB ships with Fauxton, which lists databases in the browser.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page about CouchDB is not reported without the console markers.",
  "linkedRules": [
    "DPK-DAST-435"
  ],
  "origin": "original-authored",
  "cell": "dast:console-couchdb-fauxton:console-couchdb-fauxton",
  "validationStatus": "VALIDATED"
}
