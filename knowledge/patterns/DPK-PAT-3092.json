{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3092",
  "title": "Signal: Module locked at an incompatible major",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "entries[].version",
      "valuePattern": "\\+incompatible$"
    }
  },
  "scope": "A go.sum file that declares a `+incompatible` version in go.sum.",
  "limitations": "It matches a `+incompatible` version in go.sum in the parsed go.sum; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.sum",
      "document": {
        "entries": [
          {
            "module": "github.com/acme/legacy",
            "version": "v2.1.0+incompatible",
            "hash": "h1:9f2c3d4e5f60"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.sum",
      "document": {
        "entries": [
          {
            "module": "github.com/acme/tool",
            "version": "v3.0.4+incompatible",
            "hash": "h1:a1b2c3d4e5f6"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.sum",
      "document": {
        "entries": [
          {
            "module": "github.com/acme/core/v2",
            "version": "v2.1.0",
            "hash": "h1:9f2c3d4e5f60"
          }
        ]
      },
      "match": false
    },
    {
      "file": "go.sum",
      "document": {
        "entries": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0",
            "hash": "h1:a1b2c3d4e5f6"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A go.sum that mentions a `+incompatible` version in go.sum in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0955"
  ],
  "origin": "original-authored",
  "cell": "sca:go-sum-incompatible-marker",
  "validationStatus": "VALIDATED"
}
