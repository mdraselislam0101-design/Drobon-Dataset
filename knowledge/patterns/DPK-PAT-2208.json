{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2208",
  "title": "Signal: Lockfile entry without a resolved version",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "packages",
      "field": "version"
    }
  },
  "scope": "A package-lock.json file that declares a package entry that carries no version string.",
  "limitations": "It matches a package entry that carries no version string in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "resolved": "https://registry.npmjs.org/a/-/a-1.0.0.tgz",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org/x/-/x-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "resolved": "https://registry.npmjs.org/y/-/y-2.0.0.tgz"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A link or workspace entry without a version is still reported; it cannot be version-checked either.",
  "linkedRules": [
    "DPK-SCA-0071"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-version-absent",
  "validationStatus": "VALIDATED"
}
