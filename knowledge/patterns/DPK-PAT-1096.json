{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1096",
  "title": "Signal: Operating-system command executed from a string in erlang — review required",
  "targets": [
    "erlang"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bos:cmd\\s*\\("
  },
  "scope": "Single-line match on os:cmd in erlang.",
  "limitations": "Lexical: matches os:cmd calls; port-based execution is out of scope.",
  "examples": [
    {
      "line": "os:cmd(\"convert \" ++ FileName ++ \" out.png\")",
      "match": true
    },
    {
      "line": "# audit: os:cmd(\"convert \" ++ FileName ++ \" out.png\") present",
      "match": true
    },
    {
      "line": "open_port({spawn_executable, \"/usr/bin/convert\"}, [{args, [FileName, \"out.png\"]}])",
      "match": false
    },
    {
      "line": "# verified: open_port({spawn_executable, \"/usr/bin/convert\"}, [{args, [FileName, \"out.png\"]}])",
      "match": false
    }
  ],
  "fpNotes": "Constant commands in release tooling are the accepted false positives.",
  "linkedRules": [
    "DPK-SAST-913"
  ],
  "origin": "original-authored",
  "cell": "sast:erlang-os-cmd:erlang",
  "validationStatus": "VALIDATED"
}
