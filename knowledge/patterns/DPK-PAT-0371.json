{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0371",
  "title": "Signal: Risky Terraform setting (rdsenc) — review required",
  "targets": [
    "hcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "storage_encrypted\\s*=\\s*false"
  },
  "scope": "Single-line lexical match on risky Terraform settings (rdsenc).",
  "limitations": "Lexical, line-based: matches the setting regardless of account scope.",
  "examples": [
    {
      "line": "storage_encrypted = false",
      "match": true
    },
    {
      "line": "# audit: storage_encrypted = false present",
      "match": true
    },
    {
      "line": "storage_encrypted = true",
      "match": false
    },
    {
      "line": "# verified: storage_encrypted = true",
      "match": false
    }
  ],
  "fpNotes": "Sandbox accounts are the common false positive — confirm account scope.",
  "linkedRules": [
    "DPK-SAST-332"
  ],
  "origin": "original-authored",
  "cell": "sast:terraform-strict:hcl:rdsenc",
  "validationStatus": "VALIDATED"
}
