{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0853",
  "title": "Signal: XXE-prone XML parsing (rexml) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:REXML::Document\\.new)"
  },
  "scope": "Single-line lexical match on XML parsing (rexml).",
  "limitations": "Lexical, line-based: matches the parser setting.",
  "examples": [
    {
      "line": "REXML::Document.new(xml)",
      "match": true
    },
    {
      "line": "# audit: REXML::Document.new(xml) present",
      "match": true
    },
    {
      "line": "# REXML disabled",
      "match": false
    },
    {
      "line": "# verified: # REXML disabled",
      "match": false
    }
  ],
  "fpNotes": "Trusted documents are the common false positive.",
  "linkedRules": [
    "DPK-SAST-736"
  ],
  "origin": "original-authored",
  "cell": "sast:xxe-more:ruby:rexml",
  "validationStatus": "VALIDATED"
}
