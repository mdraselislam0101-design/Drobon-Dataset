{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0654",
  "title": "Signal: Legacy digest selected (md5m) — review required",
  "targets": [
    "groovy"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.md5\\s*\\(\\s*\\)"
  },
  "scope": "Single-line lexical match on digest selection (md5m).",
  "limitations": "Lexical, line-based: matches the selection.",
  "examples": [
    {
      "line": "\"x\".md5()",
      "match": true
    },
    {
      "line": "# audit: \"x\".md5() present",
      "match": true
    },
    {
      "line": "\"x\".sha256()",
      "match": false
    },
    {
      "line": "# verified: \"x\".sha256()",
      "match": false
    }
  ],
  "fpNotes": "Checksums are the common false positive.",
  "linkedRules": [
    "DPK-SAST-537"
  ],
  "origin": "original-authored",
  "cell": "sast:hash-flag-3:groovy:md5m",
  "validationStatus": "VALIDATED"
}
