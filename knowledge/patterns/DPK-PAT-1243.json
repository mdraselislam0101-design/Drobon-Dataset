{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1243",
  "title": "Signal: Kubernetes Dashboard interface disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*kubernetes\\-dashboard)(?=[\\s\\S]*Kubernetes\\ Dashboard)"
    }
  },
  "scope": "One response whose body contains both the dashboard bundle name and the Kubernetes Dashboard title.",
  "limitations": "One response body. The rule reports the dashboard front end; it does not prove that the login can be bypassed or that a service account token is reachable.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Kubernetes Dashboard</title><script src=\"/dashboard/static/kubernetes-dashboard.js\"></script></head><body><app-root></app-root></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><head><title>Kubernetes Dashboard</title></head><body><div id=\"kubernetes-dashboard-root\"></div><script src=\"kubernetes-dashboard.bundle.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title><script src=\"/dashboard/static/.js\"></script></head><body><app-root></app-root></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A dashboard deliberately published to an authenticated internal audience is still reported; the finding is reachability, not proof of a bypass.",
  "linkedRules": [
    "DPK-DAST-174"
  ],
  "origin": "original-authored",
  "cell": "dast:body-kubernetes-dashboard:kubernetes-dashboard",
  "validationStatus": "VALIDATED"
}
