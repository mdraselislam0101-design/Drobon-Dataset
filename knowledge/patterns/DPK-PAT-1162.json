{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1162",
  "title": "Signal: Content-Security-Policy script-src allows plaintext HTTP origins",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "^(?:(?!script-src(?=[\\s;]|$))[^;]*;\\s*)*script-src(?=[\\s;]|$)[^;]*?(?<=\\s)http:(?=\\s|;|/|$)"
    }
  },
  "scope": "One response: script-src names a plaintext source.",
  "limitations": "Observation-level: matches a plaintext source inside script-src only. Other fetch directives that carry http: sources are separate checks.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self' http://cdn.example"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src http:"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'; script-src http:"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self' https://cdn.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "img-src http:"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A lab page that intentionally loads a plaintext local script is reported by design.",
  "linkedRules": [
    "DPK-DAST-093"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-script-src-plaintext:script-src-http",
  "validationStatus": "VALIDATED"
}
