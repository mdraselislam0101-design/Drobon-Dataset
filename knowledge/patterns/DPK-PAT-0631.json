{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0631",
  "title": "Signal: Dynamic evaluation via eval (shell) — review required",
  "targets": [
    "shell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:eval)\\s*\\("
  },
  "scope": "Single-line lexical match on the eval call in shell code.",
  "limitations": "Lexical, line-based: any eval call matches.",
  "examples": [
    {
      "line": "eval(payload)",
      "match": true
    },
    {
      "line": "out = eval(data)",
      "match": true
    },
    {
      "line": "myeval(x)",
      "match": false
    },
    {
      "line": "eval_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted tooling is the common false positive.",
  "linkedRules": [
    "DPK-SAST-514"
  ],
  "origin": "original-authored",
  "cell": "sast:eval-call-extra:shell",
  "validationStatus": "VALIDATED"
}
