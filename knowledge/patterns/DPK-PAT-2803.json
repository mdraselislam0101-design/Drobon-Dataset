{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2803",
  "title": "Signal: Repository credential stored in a settings file",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "settings.servers[].password",
      "valuePattern": "^(?!\\$\\{)[A-Za-z0-9!@#$%^&*._-]{8,40}$"
    }
  },
  "scope": "A settings.xml file that declares a literal password in `settings.xml`.",
  "limitations": "It matches a literal password in `settings.xml` in the parsed settings.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "central",
              "mirrorOf": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "servers": [
            {
              "id": "acme",
              "username": "ci-bot",
              "password": "EXAMPLESECRETVALUE01"
            }
          ],
          "profiles": []
        }
      },
      "match": true
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "central",
              "mirrorOf": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "servers": [
            {
              "id": "nexus",
              "username": "deploy",
              "password": "EXAMPLESECRETVALUE02"
            }
          ],
          "profiles": []
        }
      },
      "match": true
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "central",
              "mirrorOf": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "servers": [
            {
              "id": "acme",
              "username": "ci-bot",
              "password": "${env.MAVEN_PASSWORD}"
            }
          ],
          "profiles": []
        }
      },
      "match": false
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "central",
              "mirrorOf": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "servers": [],
          "profiles": []
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A settings.xml that mentions a literal password in `settings.xml` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0666"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-settings-server-password-inline",
  "validationStatus": "VALIDATED"
}
