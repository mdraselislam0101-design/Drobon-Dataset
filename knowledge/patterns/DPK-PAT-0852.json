{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0852",
  "title": "Signal: XXE-prone XML parsing (loader) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "libxml_disable_entity_loader\\s*\\(\\s*false"
  },
  "scope": "Single-line lexical match on XML parsing (loader).",
  "limitations": "Lexical, line-based: matches the parser setting.",
  "examples": [
    {
      "line": "libxml_disable_entity_loader(false)",
      "match": true
    },
    {
      "line": "# audit: libxml_disable_entity_loader(false) present",
      "match": true
    },
    {
      "line": "libxml_disable_entity_loader(true)",
      "match": false
    },
    {
      "line": "# verified: libxml_disable_entity_loader(true)",
      "match": false
    }
  ],
  "fpNotes": "Trusted documents are the common false positive.",
  "linkedRules": [
    "DPK-SAST-735"
  ],
  "origin": "original-authored",
  "cell": "sast:xxe-more:php:loader",
  "validationStatus": "VALIDATED"
}
