{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0222",
  "title": "Signal: MD5 package use (tcl) — review required",
  "targets": [
    "tcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:md5::md5)"
  },
  "scope": "Single-line lexical match on MD5 use in tcl code.",
  "limitations": "Lexical, line-based: matches the package name.",
  "examples": [
    {
      "line": "md5::md5 $x",
      "match": true
    },
    {
      "line": "# audit: md5::md5 $x present",
      "match": true
    },
    {
      "line": "sha256::sha256 $x",
      "match": false
    },
    {
      "line": "# verified: sha256::sha256 $x",
      "match": false
    }
  ],
  "fpNotes": "Checksums are the common false positive.",
  "linkedRules": [
    "DPK-SAST-183"
  ],
  "origin": "original-authored",
  "cell": "sast:md5-flag-extra:tcl",
  "validationStatus": "VALIDATED"
}
