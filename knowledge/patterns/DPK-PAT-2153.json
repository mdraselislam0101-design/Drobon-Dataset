{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2153",
  "title": "Signal: Dependency linked as a symlink to a local directory",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^link:"
    }
  },
  "scope": "A package.json file that declares a `link:` dependency, which installs a symlink instead of a package.",
  "limitations": "It matches a `link:` dependency, which installs a symlink instead of a package in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-ui": "link:../acme-ui"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-ui": "link:./packages/ui"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-ui": "file:../acme-ui"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-ui": "2.3.1"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Development overrides outside the shipped manifest are not reported by this rule.",
  "linkedRules": [
    "DPK-SCA-0016"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-link-protocol",
  "validationStatus": "VALIDATED"
}
