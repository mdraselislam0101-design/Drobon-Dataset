{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1471",
  "title": "Signal: Django Debug Toolbar disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*djDebug)(?=[\\s\\S]*djdt)"
    }
  },
  "scope": "One response body containing the Django Debug Toolbar container and its script marker.",
  "limitations": "One response body. The rule reports the toolbar container; it does not open a panel.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/orders",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Orders</h1><div id=\"djDebug\" class=\"djDebugPanelList\"><a href=\"#sql\">SQL</a><a href=\"#settings\">Settings</a></div><script>djdt.init({});</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/report",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<div id=\"djDebug\"><div id=\"djDebugSqlPanel\"><pre>SELECT * FROM orders WHERE user_id = 42</pre></div></div><script src=\"/static/debug_toolbar/js/djdt.js\"></script>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/orders",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Orders</h1><p>3 orders</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Debugging guide</title></head><body><p>Install the toolbar only in development settings.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that mentions the toolbar in prose is not reported, because both the container name and the script marker are required.",
  "linkedRules": [
    "DPK-DAST-402"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-debug-django-toolbar:django-debug-toolbar",
  "validationStatus": "VALIDATED"
}
