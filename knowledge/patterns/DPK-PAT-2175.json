{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2175",
  "title": "Signal: Dependency fetched from a source archive URL",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^https://(?:codeload\\.github\\.com|github\\.com/[^/ ]+/[^/ ]+/archive)/"
    }
  },
  "scope": "A package.json file that declares a dependency pointing at a forge source archive instead of a package.",
  "limitations": "It matches a dependency pointing at a forge source archive instead of a package in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "https://codeload.github.com/acme/sdk/tar.gz/refs/tags/v4.2.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "https://github.com/acme/cli/archive/refs/heads/main.tar.gz"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "https://downloads.acme.example/sdk-4.2.0.tgz"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A source archive with a commit sha is immutable but still outside the registry; it is reported as the same source kind.",
  "linkedRules": [
    "DPK-SCA-0038"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-github-archive-url",
  "validationStatus": "VALIDATED"
}
