{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1573",
  "title": "Signal: JSONP callback endpoint served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "^\\s*[A-Za-z_$][A-Za-z0-9_$.]{1,60}\\s*\\(\\s*\\{[\\s\\S]{0,200}?\\}\\s*\\)"
    }
  },
  "scope": "A body with a function-call wrapper around a JSON object.",
  "limitations": "One response body. The rule reads the callback wrapper; it does not vary the callback name.",
  "examples": [
    {
      "observation": {
        "url": "https://api.example/user?callback=cb",
        "status": 200,
        "headers": {
          "Content-Type": "application/javascript",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "cb({\"id\":44,\"email\":\"rahim@example.com\",\"role\":\"user\"})"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/orders?callback=jQuery123",
        "status": 200,
        "headers": {
          "Content-Type": "application/javascript",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "jQuery123({\"orders\":[{\"id\":1,\"total\":42}]})"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/docs/jsonp",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "<html><body><p>The legacy endpoint accepted a callback parameter and wrapped the JSON in a function call.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that documents a callback parameter without a wrapped payload is not reported.",
  "linkedRules": [
    "DPK-DAST-504"
  ],
  "origin": "original-authored",
  "cell": "dast:resp-jsonp-callback:resp-jsonp-callback",
  "validationStatus": "VALIDATED"
}
