{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3135",
  "title": "Signal: Development requirement declared as a wildcard",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dev-packages.*",
      "valuePattern": "^\\*$"
    }
  },
  "scope": "A Pipfile file that declares a `*` specifier in `[dev-packages]`.",
  "limitations": "It matches a `*` specifier in `[dev-packages]` in the parsed Pipfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "*"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3",
          "black": "*"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": true
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": false
    },
    {
      "file": "Pipfile",
      "document": {
        "packages": {
          "requests": "==2.32.3"
        },
        "dev-packages": {
          "pytest": "==8.3.3",
          "black": "==24.8.0"
        },
        "pipenv": {
          "allow_prereleases": false
        },
        "requires": {
          "python_version": "3.11"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Pipfile that mentions a `*` specifier in `[dev-packages]` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0998"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-pipfile-dev-wildcard",
  "validationStatus": "VALIDATED"
}
