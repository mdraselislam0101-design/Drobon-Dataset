{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2311",
  "title": "Signal: Gradle plugin applied without a version",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "plugins",
      "field": "version"
    }
  },
  "scope": "A build.gradle file that declares a plugin request that names no version.",
  "limitations": "It matches a plugin request that names no version in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "build.gradle",
      "document": {
        "plugins": [
          {
            "id": "com.acme.build-tools"
          }
        ],
        "dependencies": []
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "plugins": [
          {
            "id": "org.example.packaging"
          },
          {
            "id": "java"
          }
        ],
        "dependencies": []
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "plugins": [
          {
            "id": "com.acme.build-tools",
            "version": "2.4.0"
          }
        ],
        "dependencies": []
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "plugins": [
          {
            "id": "com.github.ben-manes.versions",
            "version": "0.51.0"
          }
        ],
        "dependencies": []
      },
      "match": false
    }
  ],
  "fpNotes": "A build.gradle that mentions a plugin request that names no version in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0174"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-plugin-version-absent",
  "validationStatus": "VALIDATED"
}
