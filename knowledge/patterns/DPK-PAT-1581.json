{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1581",
  "title": "Signal: Payment form submits card fields with GET",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<form(?=[^>]{0,300}method\\s*=\\s*[\\\"']?get)(?=[\\s\\S]{0,1500}?name\\s*=\\s*[\\\"'][^\\\"']{0,60}(?:card|cvv|cvc)[^\\\"']{0,60}[\\\"'])"
    }
  },
  "scope": "A form element with method GET that also declares a card, PAN or CVV field.",
  "limitations": "One response body. It detects the form declaration and a card-shaped field name, not the values a user would type.",
  "examples": [
    {
      "observation": {
        "url": "https://bank.example/cards/pay",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<form action=\"/cards/pay\" method=\"get\"><input name=\"card_number\"><input name=\"cvv\"><button>Pay</button></form>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/checkout",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<FORM METHOD=GET ACTION=\"/checkout\"><input name=\"cardholder_cvc\"></FORM>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/search",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<form action=\"/search\" method=\"get\"><input name=\"q\"><button>Search</button></form>"
      },
      "match": false
    }
  ],
  "fpNotes": "A search form that only has a free-text query field is not reported, because no card-shaped field name is present.",
  "linkedRules": [
    "DPK-DAST-512"
  ],
  "origin": "original-authored",
  "cell": "dast:bank-card-form-uses-get:bank-card-form-uses-get",
  "validationStatus": "VALIDATED"
}
