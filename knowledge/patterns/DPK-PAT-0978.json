{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0978",
  "title": "Signal: Possible password value in an unquoted assignment in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "(?:^|[^A-Za-z0-9_])[A-Za-z0-9_]*(?:[pP][aA][sS][sS][wW][oO][rR][dD]|[pP][aA][sS][sS][wW][dD]|[pP][wW][dD])[A-Za-z0-9_]*[ \\t]*[=:][ \\t]*(?![A-Za-z0-9_.]*\\()(?!(?:[eE][xX][aA][mM][pP][lL][eE]|[cC][hH][aA][nN][gG][eE][mM][eE]|[pP][lL][aA][cC][eE][hH][oO][lL][dD][eE][rR]))(?=[^\\s]*[0-9])(?=[^\\s]*[A-Za-z])[A-Za-z0-9!@#^&()+_./~=|-]{10,}"
  },
  "scope": "Single-line shape match for password value in an unquoted assignment.",
  "limitations": "Shape-only heuristic over assignment syntax. Variable references whose names mix letters and digits can match (false positive), and pure letter values without digits are not matched (documented recall boundary). Quoted values are left to DPK-SEC-007.",
  "examples": [
    {
      "line": "assign = \"DB_PASSWORD=zzzzzzzzzzS3cr9t\"",
      "match": true
    },
    {
      "line": "# audit: assign = \"DB_PASSWORD=zzzzzzzzzzS3cr9t\" present",
      "match": true
    },
    {
      "line": "assign = \"xy\"",
      "match": false
    },
    {
      "line": "assign = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    },
    {
      "line": "export DB_PASSWORD=zzzzzzzzzzS3cr9t",
      "match": true
    },
    {
      "line": "password: zzzzzzzzzzS3cr9t",
      "match": true
    },
    {
      "line": "conn = \"Server=db.internal;Password=zzzzzzzzzzS3cr9t;\"",
      "match": true
    },
    {
      "line": "# db_password: zzzzzzzzzzS3cr9t",
      "match": true
    },
    {
      "line": "password = \"zzzzzzzzzzS3cr9t\"",
      "match": false
    },
    {
      "line": "password = os.environ.get(\"DB_PASSWORD\")",
      "match": false
    },
    {
      "line": "password = EXAMPLE-NOT-A-REAL-VALUE",
      "match": false
    },
    {
      "line": "db_password = changeme",
      "match": false
    },
    {
      "line": "DB_PASSWORD=",
      "match": false
    },
    {
      "line": "password = secret_value",
      "match": false
    },
    {
      "line": "password=zzzzzzzz9",
      "match": false
    },
    {
      "line": "password=zzzzzzzzz9",
      "match": true
    }
  ],
  "fpNotes": "Variable references that mix letters and digits, and generated identifiers that look like literal secrets. Placeholder words and call expressions are excluded by guards, and EXAMPLE is vetoed by the runtime denylist.",
  "linkedRules": [
    "DPK-SEC-106"
  ],
  "origin": "original-authored",
  "cell": "secrets:env-config-unquoted-password:env-unquoted",
  "validationStatus": "VALIDATED"
}
