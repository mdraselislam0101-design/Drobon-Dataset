{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1067",
  "title": "Signal: Legacy cipher selected through Cipher.getInstance in scala — review required",
  "targets": [
    "scala"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Cipher\\.getInstance\\s*\\(\\s*[\"'](?:DES|DESede|RC4|Blowfish))"
  },
  "scope": "Single-line match on a legacy cipher name in scala.",
  "limitations": "Lexical: matches literal algorithm names; provider aliases resolved elsewhere are out of scope.",
  "examples": [
    {
      "line": "val cipher = Cipher.getInstance(\"DES/ECB/PKCS5Padding\")",
      "match": true
    },
    {
      "line": "# audit: val cipher = Cipher.getInstance(\"DES/ECB/PKCS5Padding\") present",
      "match": true
    },
    {
      "line": "val cipher = Cipher.getInstance(\"AES/GCM/NoPadding\")",
      "match": false
    },
    {
      "line": "# verified: val cipher = Cipher.getInstance(\"AES/GCM/NoPadding\")",
      "match": false
    }
  ],
  "fpNotes": "Read-only decrypt paths kept for a documented migration window are the accepted exception.",
  "linkedRules": [
    "DPK-SAST-884"
  ],
  "origin": "original-authored",
  "cell": "sast:scala-weak-cipher:scala",
  "validationStatus": "VALIDATED"
}
