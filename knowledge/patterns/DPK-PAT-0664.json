{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0664",
  "title": "Signal: Script evaluation (el) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:ELProcessor\\s*\\(\\s*\\)\\s*\\.eval\\s*\\()"
  },
  "scope": "Single-line lexical match on script evaluation (el).",
  "limitations": "Lexical, line-based: matches the evaluation.",
  "examples": [
    {
      "line": "new ELProcessor().eval(expr)",
      "match": true
    },
    {
      "line": "# audit: new ELProcessor().eval(expr) present",
      "match": true
    },
    {
      "line": "factory.getELProcessor()",
      "match": false
    },
    {
      "line": "# verified: factory.getELProcessor()",
      "match": false
    }
  ],
  "fpNotes": "Fixed scripts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-547"
  ],
  "origin": "original-authored",
  "cell": "sast:java-inject-flag:java:el",
  "validationStatus": "VALIDATED"
}
