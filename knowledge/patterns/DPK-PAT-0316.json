{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0316",
  "title": "Signal: Default SNMP community (community) — review required",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "community\\s+(?:public|private)\\b"
  },
  "scope": "Single-line lexical match on SNMP community defaults.",
  "limitations": "Lexical, line-based: matches the default regardless of ACLs.",
  "examples": [
    {
      "line": "community public",
      "match": true
    },
    {
      "line": "# audit: community public present",
      "match": true
    },
    {
      "line": "community r4nd0m-x7",
      "match": false
    },
    {
      "line": "# verified: community r4nd0m-x7",
      "match": false
    }
  ],
  "fpNotes": "Read-only views behind strict ACLs are the common accepted case — confirm both.",
  "linkedRules": [
    "DPK-SAST-277"
  ],
  "origin": "original-authored",
  "cell": "sast:snmp-default:universal:community",
  "validationStatus": "VALIDATED"
}
