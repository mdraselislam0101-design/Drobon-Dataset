{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1291",
  "title": "Signal: GraphQL IDE interface disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*GraphiQL)(?=[\\s\\S]*graphql)"
    }
  },
  "scope": "One response whose body renders a GraphQL IDE shell.",
  "limitations": "One response body. The rule reports the IDE shell; it does not run a query and cannot show whether introspection is enabled on the endpoint.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><head><title>GraphiQL</title></head><body><div id=\"graphiql\"></div><script>var graphqlEndpoint = \"/graphql\";</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div class=\"graphiql-container\"></div><script>window.GraphQLPlayground = {endpoint: \"/api/graphql\"};</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><head><title></title></head><body><div id=\"\"></div><script>var Endpoint = \"/\";</script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A documentation page that names GraphiQL is not reported; the IDE container element is required.",
  "linkedRules": [
    "DPK-DAST-222"
  ],
  "origin": "original-authored",
  "cell": "dast:body-graphiql-playground:graphiql-playground",
  "validationStatus": "VALIDATED"
}
