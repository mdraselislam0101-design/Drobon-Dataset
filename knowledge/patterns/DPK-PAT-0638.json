{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0638",
  "title": "Signal: Risky GitHub Actions step (selfhosted) — review required",
  "targets": [
    "gha"
  ],
  "signal": {
    "kind": "regex",
    "source": "runs-on\\s*:\\s*\\[self-hosted\\]"
  },
  "scope": "Single-line lexical match on workflow files.",
  "limitations": "Lexical, line-based: matches the step.",
  "examples": [
    {
      "line": "runs-on: [self-hosted]",
      "match": true
    },
    {
      "line": "# audit: runs-on: [self-hosted] present",
      "match": true
    },
    {
      "line": "runs-on: ubuntu-latest",
      "match": false
    },
    {
      "line": "# verified: runs-on: ubuntu-latest",
      "match": false
    }
  ],
  "fpNotes": "Trusted first-party actions are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-521"
  ],
  "origin": "original-authored",
  "cell": "sast:gha-more:gha:selfhosted",
  "validationStatus": "VALIDATED"
}
