{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0674",
  "title": "Signal: TLS trust weakened (setseed) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "setSeed\\s*\\(\\s*[0-9]+"
  },
  "scope": "Single-line lexical match on TLS trust code (setseed).",
  "limitations": "Lexical, line-based: matches the weakness.",
  "examples": [
    {
      "line": "sr.setSeed(12345)",
      "match": true
    },
    {
      "line": "# audit: sr.setSeed(12345) present",
      "match": true
    },
    {
      "line": "sr.setSeed(secureBytes)",
      "match": false
    },
    {
      "line": "# verified: sr.setSeed(secureBytes)",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive.",
  "linkedRules": [
    "DPK-SAST-557"
  ],
  "origin": "original-authored",
  "cell": "sast:java-tls-more:java:setseed",
  "validationStatus": "VALIDATED"
}
