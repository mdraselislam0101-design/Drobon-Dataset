{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1266",
  "title": "Signal: Content-Security-Policy default-src allows data: URLs",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "(?:^|;)\\s*default-src\\s[^;]*(?<=\\s)data:(?=[\\s;]|$)"
    }
  },
  "scope": "One response whose Content-Security-Policy default-src directive contains the `data:` scheme token.",
  "limitations": "One header value and one directive. The rule reports `data:` in default-src; it does not compute which class is actually governed by the fallback in a given policy, because that depends on which other directives are present.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self' data:"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src data: https:"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src data:; default-src 'self'"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A policy that also sets script-src to 'none' is still flagged; the finding is the fallback scheme, not proof that a data: script is reachable.",
  "linkedRules": [
    "DPK-DAST-197"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-defaultsrc-data:defaultsrc-data",
  "validationStatus": "VALIDATED"
}
