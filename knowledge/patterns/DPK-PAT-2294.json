{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2294",
  "title": "Signal: go.mod retracts a published version",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "retract[].version",
      "valuePattern": "^v\\d"
    }
  },
  "scope": "A go.mod file that declares a `retract` directive in the dependency graph, which marks a version as withdrawn.",
  "limitations": "It matches a `retract` directive in the dependency graph, which marks a version as withdrawn in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.3.0"
          }
        ],
        "retract": [
          {
            "version": "v4.2.0",
            "rationale": "broken release"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.2.0"
          }
        ],
        "retract": [
          {
            "version": "v2.1.5"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.3.0"
          }
        ]
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.2.0"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A go.mod that mentions a `retract` directive in the dependency graph, which marks a version as withdrawn in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0157"
  ],
  "origin": "original-authored",
  "cell": "sca:go-retract-directive",
  "validationStatus": "VALIDATED"
}
