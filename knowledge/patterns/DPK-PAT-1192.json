{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1192",
  "title": "Signal: Registry API version disclosed (Docker-Distribution-Api-Version header)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Docker-Distribution-Api-Version",
      "valuePattern": "^\\s*\\S"
    }
  },
  "scope": "One response that carries a non-empty Docker-Distribution-Api-Version header.",
  "limitations": "One header value. The rule reports the advertised registry version; it does not test whether the registry allows anonymous pulls.",
  "examples": [
    {
      "observation": {
        "url": "https://registry.example/v2/",
        "status": 200,
        "headers": {
          "Docker-Distribution-Api-Version": "registry/2.0"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://registry.example/v2/",
        "status": 401,
        "headers": {
          "Docker-Distribution-Api-Version": "registry/2.0"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://registry.example/v2/",
        "status": 200,
        "headers": {
          "Docker-Distribution-Api-Version": ""
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "nginx"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A public registry mirror intended for anonymous pulls is reported; the API surface is still advertised.",
  "linkedRules": [
    "DPK-DAST-123"
  ],
  "origin": "original-authored",
  "cell": "dast:banner-docker-registry-version:docker-registry-version",
  "validationStatus": "VALIDATED"
}
