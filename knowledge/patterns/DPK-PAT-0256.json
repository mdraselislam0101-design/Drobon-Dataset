{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0256",
  "title": "Signal: File access built from input (tcl) — review required",
  "targets": [
    "tcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "open\\s+\\$"
  },
  "scope": "Single-line lexical match on input-built paths in tcl code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "open $f",
      "match": true
    },
    {
      "line": "# audit: open $f present",
      "match": true
    },
    {
      "line": "open fixed.txt",
      "match": false
    },
    {
      "line": "# verified: open fixed.txt",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-217"
  ],
  "origin": "original-authored",
  "cell": "sast:path-langs:tcl",
  "validationStatus": "VALIDATED"
}
