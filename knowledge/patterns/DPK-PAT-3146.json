{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3146",
  "title": "Signal: R dependency floor with two components",
  "targets": [
    "cran"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "Depends[]",
      "valuePattern": "^R \\(>= [0-9]+\\.[0-9]+\\)$"
    }
  },
  "scope": "A DESCRIPTION file that declares an `R (>= X.Y)` floor with no patch level.",
  "limitations": "It matches an `R (>= X.Y)` floor with no patch level in the parsed DESCRIPTION; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT"
      },
      "match": true
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "R (>= 3.6)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT"
      },
      "match": true
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "methods",
          "R (>= 4.1.0)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT"
      },
      "match": false
    },
    {
      "file": "DESCRIPTION",
      "document": {
        "Package": "demo",
        "Version": "0.1.0",
        "Depends": [
          "R (>= 4.2.3)"
        ],
        "Imports": [
          "dplyr"
        ],
        "License": "MIT"
      },
      "match": false
    }
  ],
  "fpNotes": "A DESCRIPTION that mentions an `R (>= X.Y)` floor with no patch level in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1009"
  ],
  "origin": "original-authored",
  "cell": "sca:cran-r-floor-two-part",
  "validationStatus": "VALIDATED"
}
