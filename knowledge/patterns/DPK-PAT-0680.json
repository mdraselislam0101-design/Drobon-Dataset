{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0680",
  "title": "Signal: Dangerous JS construct (interval) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:setInterval\\s*\\(\\s*\")"
  },
  "scope": "Single-line lexical match on dangerous constructs (interval).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "setInterval(\"run()\", 1)",
      "match": true
    },
    {
      "line": "# audit: setInterval(\"run()\", 1) present",
      "match": true
    },
    {
      "line": "setInterval(run, 1)",
      "match": false
    },
    {
      "line": "# verified: setInterval(run, 1)",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-563"
  ],
  "origin": "original-authored",
  "cell": "sast:js-flag:javascript:interval",
  "validationStatus": "VALIDATED"
}
