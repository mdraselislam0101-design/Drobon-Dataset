{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1245",
  "title": "Signal: Nexus Repository interface disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*nexus\\-repository)(?=[\\s\\S]*Nexus\\ Repository)"
    }
  },
  "scope": "One response whose body contains both the nexus-repository bundle and the product name.",
  "limitations": "One response body. The rule reports the Nexus shell; it does not list a repository or download an artefact.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Nexus Repository</title></head><body><script src=\"/static/nexus-repository.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><span>Nexus Repository</span><script src=\"/static/nexus-repository/manifest.js\"></script><script>var v = {\"version\":\"3.61.0\"};</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><script src=\"/static/.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published repository is still reported; the finding is reachability.",
  "linkedRules": [
    "DPK-DAST-176"
  ],
  "origin": "original-authored",
  "cell": "dast:body-nexus-repository:nexus-repository",
  "validationStatus": "VALIDATED"
}
