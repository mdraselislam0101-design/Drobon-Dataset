{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1300",
  "title": "Signal: Laravel Ignition error page disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Ignition)(?=[\\s\\S]*laravel)"
    }
  },
  "scope": "One response whose body renders the Ignition error page.",
  "limitations": "One response body. The rule reports the Ignition page; it does not read every rendered field and cannot show which environment values the page included.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Whoops! There was an error.</title></head><body><div class=\"ignition\"><span>Ignition</span><p>Laravel v10.2.0</p><pre>APP_KEY</pre></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div data-ignition=\"error\"><h1>500</h1><code>laravel/framework 10.1</code></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Whoops! There was an error.</title></head><body><div class=\"\"><span></span><p> v10.2.0</p><pre>APP_KEY</pre></div></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "The Laravel Whoops page is a different renderer with its own rule; a page carrying both markers is reported by both.",
  "linkedRules": [
    "DPK-DAST-231"
  ],
  "origin": "original-authored",
  "cell": "dast:body-laravel-ignition:laravel-ignition",
  "validationStatus": "VALIDATED"
}
