{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0584",
  "title": "Signal: OS command execution via rawSystem (haskell) — review required",
  "targets": [
    "haskell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:rawSystem)\\s*\\("
  },
  "scope": "Single-line lexical match on the rawSystem call in haskell code.",
  "limitations": "Lexical, line-based: any rawSystem call matches.",
  "examples": [
    {
      "line": "rawSystem(payload)",
      "match": true
    },
    {
      "line": "out = rawSystem(data)",
      "match": true
    },
    {
      "line": "myrawSystem(x)",
      "match": false
    },
    {
      "line": "rawSystem_safe()",
      "match": false
    }
  ],
  "fpNotes": "Fixed maintenance commands are the common false positive.",
  "linkedRules": [
    "DPK-SAST-467"
  ],
  "origin": "original-authored",
  "cell": "sast:cmd-exec-3:haskell",
  "validationStatus": "VALIDATED"
}
