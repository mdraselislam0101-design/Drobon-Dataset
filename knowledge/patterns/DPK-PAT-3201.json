{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3201",
  "title": "Signal: Possible an AWS SigV4 credential scope in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "AWS4-HMAC-SHA256 Credential=[A-Za-z0-9/]{20,}"
  },
  "scope": "Single-line shape match for an AWS SigV4 credential scope.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "auth = \"AWS4-HMAC-SHA256 Credential=AAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: auth = \"AWS4-HMAC-SHA256 Credential=AAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "auth = \"xy\"",
      "match": false
    },
    {
      "line": "auth = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-141"
  ],
  "origin": "original-authored",
  "cell": "secrets:credential-bearing-signature:aws-sigv4-authorization-header",
  "validationStatus": "VALIDATED"
}
