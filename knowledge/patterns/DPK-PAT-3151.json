{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3151",
  "title": "Signal: Test extra declared in the distribution metadata",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-key-matches",
      "path": "options.extras_require",
      "keyPattern": "^test$"
    }
  },
  "scope": "A setup.cfg file that declares an `extras_require` entry named `test`.",
  "limitations": "It matches an `extras_require` entry named `test` in the parsed setup.cfg; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "extras_require": {
            "test": [
              "pytest==8.3.3"
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "extras_require": {
            "test": [
              "pytest==8.3.3",
              "coverage==7.6.1"
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "extras_require": {
            "security": [
              "cryptography==43.0.1"
            ]
          }
        }
      },
      "match": false
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "extras_require": {}
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A setup.cfg that mentions an `extras_require` entry named `test` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1014"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-setupcfg-test-extra",
  "validationStatus": "VALIDATED"
}
