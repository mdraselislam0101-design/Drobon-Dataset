{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0650",
  "title": "Signal: Legacy digest via MD5.hash (haskell) — review required",
  "targets": [
    "haskell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:MD5\\.hash)\\s*\\("
  },
  "scope": "Single-line lexical match on the MD5.hash call in haskell code.",
  "limitations": "Lexical, line-based: matches any MD5.hash call.",
  "examples": [
    {
      "line": "MD5.hash(payload)",
      "match": true
    },
    {
      "line": "out = MD5.hash(data)",
      "match": true
    },
    {
      "line": "myMD5hash(x)",
      "match": false
    },
    {
      "line": "MD5.hash_safe()",
      "match": false
    }
  ],
  "fpNotes": "Checksums are the common false positive.",
  "linkedRules": [
    "DPK-SAST-533"
  ],
  "origin": "original-authored",
  "cell": "sast:hash-call-3:haskell",
