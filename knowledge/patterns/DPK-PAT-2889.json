{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2889",
  "title": "Signal: Build plugin resolved from a dynamic version",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "pluginManagement.plugins[].version",
      "valuePattern": "^(?:\\+|latest\\.release)$"
    }
  },
  "scope": "A settings.gradle file that declares a plugin version written as `+` or `latest.release`.",
  "limitations": "It matches a plugin version written as `+` or `latest.release` in the parsed settings.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ],
          "plugins": [
            {
              "id": "com.acme.build",
              "version": "+"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ],
          "plugins": [
            {
              "id": "org.acme.plugin",
              "version": "latest.release"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ],
          "plugins": [
            {
              "id": "com.acme.build",
              "version": "4.2.0"
            }
          ]
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "settings.gradle",
      "document": {
        "pluginManagement": {
          "repositories": [
            {
              "name": "gradlePluginPortal",
              "url": "https://plugins.gradle.org/m2"
            }
          ],
          "plugins": []
        },
        "dependencyResolutionManagement": {
          "repositories": [
            {
              "name": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A settings.gradle that mentions a plugin version written as `+` or `latest.release` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0752"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-plugin-version-dynamic",
  "validationStatus": "VALIDATED"
}
