{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0707",
  "title": "Signal: Sensitive value in log call (julia) — review required",
  "targets": [
    "julia"
  ],
  "signal": {
    "kind": "regex",
    "source": "println\\s*\\([^)]*(?:password|passwd|secret|token)"
  },
  "scope": "Single-line lexical match on credential-named log values in julia code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "println(\"password=\", p)",
      "match": true
    },
    {
      "line": "# audit: println(\"password=\", p) present",
      "match": true
    },
    {
      "line": "println(\"user=\", u)",
      "match": false
    },
    {
      "line": "# verified: println(\"user=\", u)",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-590"
  ],
  "origin": "original-authored",
  "cell": "sast:log-4:julia",
  "validationStatus": "VALIDATED"
}
