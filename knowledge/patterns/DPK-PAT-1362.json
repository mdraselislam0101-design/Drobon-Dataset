{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1362",
  "title": "Signal: JavaScript ORM query exception disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?:SequelizeDatabaseError|PrismaClientKnownRequestError|TypeORMError|KnexTimeoutError)"
    }
  },
  "scope": "One response body containing a JavaScript ORM exception class name.",
  "limitations": "One response body. The check recognises the class name; it does not prove the query succeeded or that the leaked parameters are still sensitive.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/api/users/9",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "PrismaClientKnownRequestError: Invalid `prisma.user.findUnique()` invocation"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api/users",
        "status": 500,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "SequelizeDatabaseError: column \"email_address\" does not exist"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api/users",
        "status": 422,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"field\":\"email\",\"message\":\"must be a valid email\"}]}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/api/users",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>Request failed.</body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A changelog or issue page that quotes an error class is reported; a validation error rendered as field-level JSON is not.",
  "linkedRules": [
    "DPK-DAST-293"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-orm-query-exception-js:orm-js-exception",
  "validationStatus": "VALIDATED"
}
