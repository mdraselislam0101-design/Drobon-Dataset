{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0506",
  "title": "Signal: Possible a PlanetScale token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "pscale_[A-Za-z0-9]{32,}"
  },
  "scope": "Single-line shape match for a PlanetScale token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"pscale_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"pscale_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-040"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:planetscale",
  "validationStatus": "VALIDATED"
}
