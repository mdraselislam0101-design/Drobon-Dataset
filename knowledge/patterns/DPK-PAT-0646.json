{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0646",
  "title": "Signal: Dynamic load via syscall.Exec (go) — review required",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:syscall\\.Exec)\\s*\\("
  },
  "scope": "Single-line lexical match on the syscall.Exec call in go code.",
  "limitations": "Lexical, line-based: any syscall.Exec call matches.",
  "examples": [
    {
      "line": "syscall.Exec(payload)",
      "match": true
    },
    {
      "line": "out = syscall.Exec(data)",
      "match": true
    },
    {
      "line": "mysyscallExec(x)",
      "match": false
    },
    {
      "line": "syscall.Exec_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted plugins are the common false positive.",
  "linkedRules": [
    "DPK-SAST-529"
  ],
  "origin": "original-authored",
  "cell": "sast:go-call:go:syscall",
  "validationStatus": "VALIDATED"
}
