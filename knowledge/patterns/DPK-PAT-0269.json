{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0269",
  "title": "Signal: Remote file inclusion enabled (php) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:allow_url_include\\s*=\\s*(?:On|1))"
  },
  "scope": "Single-line lexical match on the php.ini switch.",
  "limitations": "Lexical, line-based: matches the switch.",
  "examples": [
    {
      "line": "allow_url_include = On",
      "match": true
    },
    {
      "line": "# audit: allow_url_include = On present",
      "match": true
    },
    {
      "line": "allow_url_include = Off",
      "match": false
    },
    {
      "line": "# verified: allow_url_include = Off",
      "match": false
    }
  ],
  "fpNotes": "None common — this switch is rarely justified.",
  "linkedRules": [
    "DPK-SAST-230"
  ],
  "origin": "original-authored",
  "cell": "sast:php-ini-remote:php:allowurl",
  "validationStatus": "VALIDATED"
}
