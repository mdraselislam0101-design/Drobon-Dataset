{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2876",
  "title": "Signal: Locked package hosted over cleartext",
  "targets": [
    "pub"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.description.url",
      "valuePattern": "^http://"
    }
  },
  "scope": "A pubspec.lock file that declares a hosted description URL over cleartext.",
  "limitations": "It matches a hosted description URL over cleartext in the parsed pubspec.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pubspec.lock",
      "document": {
        "packages": {
          "http": {
            "version": "1.2.0",
            "source": "hosted",
            "description": {
              "name": "http",
              "url": "http://pub.acme.example"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pubspec.lock",
      "document": {
        "packages": {
          "http": {
            "version": "1.2.0",
            "source": "hosted",
            "description": {
              "name": "http",
              "url": "https://pub.dev"
            }
          },
          "intl": {
            "version": "0.19.0",
            "source": "hosted",
            "description": {
              "url": "http://10.24.8.9"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pubspec.lock",
      "document": {
        "packages": {
          "http": {
            "version": "1.2.0",
            "source": "hosted",
            "description": {
              "name": "http",
              "url": "https://pub.dev"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "pubspec.lock",
      "document": {
        "packages": {
          "http": {
            "version": "1.2.0",
            "source": "hosted",
            "description": {
              "name": "http",
              "url": "https://pub.dev"
            }
          },
          "intl": {
            "version": "0.19.0",
            "source": "hosted",
            "description": {
              "url": "https://pub.acme.example"
            }
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pubspec.lock that mentions a hosted description URL over cleartext in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0739"
  ],
  "origin": "original-authored",
  "cell": "sca:pub-lock-hosted-url-cleartext",
  "validationStatus": "VALIDATED"
}
