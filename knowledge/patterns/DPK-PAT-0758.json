  "signal": {
    "kind": "regex",
    "source": "\\b(?:importlib\\.import_module)\\s*\\("
  },
  "scope": "Single-line lexical match on the importlib.import_module call in python code.",
  "limitations": "Lexical, line-based: any importlib.import_module call matches.",
  "examples": [
    {
      "line": "importlib.import_module(payload)",
      "match": true
    },
    {
      "line": "out = importlib.import_module(data)",
      "match": true
    },
    {
      "line": "myimportlibimport_module(x)",
      "match": false
    },
    {
      "line": "importlib.import_module_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted tooling is the common false positive.",
