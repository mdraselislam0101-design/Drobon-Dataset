{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0894",
  "title": "Signal: Weak proxy or service setting (rootpw) — review required",
  "targets": [
    "slapd"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:rootpw\\s+\\S+)"
  },
  "scope": "Single-line lexical match on service settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "rootpw secret",
      "match": true
    },
    {
      "line": "# audit: rootpw secret present",
      "match": true
    },
    {
      "line": "# password managed",
      "match": false
    },
    {
      "line": "# verified: # password managed",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-743"
  ],
  "origin": "original-authored",
  "cell": "sast:proxy-misc:slapd:rootpw",
  "validationStatus": "VALIDATED"
}
