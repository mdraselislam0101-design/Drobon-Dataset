{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1358",
  "title": "Signal: X-Runtime exposes per-request processing time",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-Runtime",
      "valuePattern": "^\\s*[0-9]+\\s*$|^\\s*[0-9]+\\.[0-9]+\\s*$"
    }
  },
  "scope": "One X-Runtime response header whose value is a decimal number of seconds.",
  "limitations": "One header value. The check reports a numeric X-Runtime value; it does not attribute the timing to any component and it cannot tell a framework default from a hand-written header.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/orders",
        "status": 200,
        "headers": {
          "X-Runtime": "0.034221"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "x-runtime": "1"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Runtime": "fast"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Request-Id": "0.034221"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A proxy that copies X-Runtime from a staging response is reported; the finding is the exposed timing value, whichever component produced it.",
  "linkedRules": [
    "DPK-DAST-289"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-x-runtime-header:x-runtime-present",
  "validationStatus": "VALIDATED"
}
