{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1336",
  "title": "Signal: Content-Security-Policy manifest-src allows plaintext HTTP sources",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "(?:^|;)\\s*manifest-src\\s[^;]*(?<=\\s)http:(?=[\\s;/]|$)"
    }
  },
  "scope": "One policy whose manifest-src source list contains the `http:` scheme token.",
  "limitations": "One header value and one directive. The rule reports the scheme token in manifest-src only; when the directive is absent the default-src fallback decides, and other rules report that case.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; manifest-src http:"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; manifest-src https://app.example http://legacy.example/app.webmanifest"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "manifest-src 'self' https://app.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "manifest-src 'self'; img-src http:"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "manifest-src http://cdn.example"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src http:; manifest-src https://app.example"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A legacy origin that redirects to HTTPS is still reported; the finding is the scheme in the policy.",
  "linkedRules": [
    "DPK-DAST-267"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-manifestsrc-http:manifestsrc-http",
  "validationStatus": "VALIDATED"
}
