{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2245",
  "title": "Signal: pnpm lockfile records a resolution as a tarball URL only",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.resolution.tarball",
      "valuePattern": "^https?://"
    }
  },
  "scope": "A pnpm-lock.yaml file that declares a pnpm resolution that records a tarball URL with no integrity value.",
  "limitations": "It matches a pnpm resolution that records a tarball URL with no integrity value in the parsed pnpm-lock.yaml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/left-pad@1.3.0": {
            "resolution": {
              "tarball": "https://registry.acme.example/left-pad-1.3.0.tgz"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/ms@2.1.3": {
            "resolution": {
              "tarball": "https://downloads.acme.example/ms-2.1.3.tgz"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/left-pad@1.3.0": {
            "resolution": {
              "integrity": "sha512-AAAA"
            }
          },
          "/ms@2.1.3": {
            "resolution": {
              "integrity": "sha512-BBBB"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/acme-sdk@4.2.0": {
            "resolution": {
              "integrity": "sha512-CCCC"
            }
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pnpm-lock.yaml that mentions a pnpm resolution that records a tarball URL with no integrity value in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0108"
  ],
  "origin": "original-authored",
  "cell": "sca:pnpm-lock-resolution-tarball-only",
  "validationStatus": "VALIDATED"
}
