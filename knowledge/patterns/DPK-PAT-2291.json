{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2291",
  "title": "Signal: go.sum entry without a module hash",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "entries",
      "field": "hash"
    }
  },
  "scope": "A go.sum file that declares a `go.sum` line that records no `h1:` hash.",
  "limitations": "It matches a `go.sum` line that records no `h1:` hash in the parsed go.sum; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.sum",
      "document": {
        "entries": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.sum",
      "document": {
        "entries": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.1.0"
          },
          {
            "module": "github.com/pkg/errors",
            "version": "v0.9.1",
            "hash": "h1:aaaa"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.sum",
      "document": {
        "entries": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0",
            "hash": "h1:aaaa"
          }
        ]
      },
      "match": false
    },
    {
      "file": "go.sum",
      "document": {
        "entries": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.1.0",
            "hash": "h1:bbbb"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A go.sum that mentions a `go.sum` line that records no `h1:` hash in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0154"
  ],
  "origin": "original-authored",
  "cell": "sca:go-sum-hash-absent",
  "validationStatus": "VALIDATED"
}
