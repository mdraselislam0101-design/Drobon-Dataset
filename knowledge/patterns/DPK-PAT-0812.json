{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0812",
  "title": "Signal: Weak SSH daemon setting (banner) — review required",
  "targets": [
    "sshd"
  ],
  "signal": {
    "kind": "regex",
    "source": "Banner\\s+none"
  },
  "scope": "Single-line lexical match on sshd settings.",
  "limitations": "Lexical, line-based: matches the setting regardless of Match blocks.",
  "examples": [
    {
      "line": "Banner none",
      "match": true
    },
    {
      "line": "# audit: Banner none present",
      "match": true
    },
    {
      "line": "Banner /etc/issue",
      "match": false
    },
    {
      "line": "# verified: Banner /etc/issue",
      "match": false
    }
  ],
  "fpNotes": "Bastion-specific needs are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-695"
  ],
  "origin": "original-authored",
  "cell": "sast:sshd-strict:sshd:banner",
  "validationStatus": "VALIDATED"
}
