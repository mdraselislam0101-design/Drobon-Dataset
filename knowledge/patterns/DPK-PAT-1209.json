{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1209",
  "title": "Signal: Oracle WebLogic error page disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*WebLogic)(?=[\\s\\S]*Error 500)"
    }
  },
  "scope": "One response whose body contains a WebLogic marker and an Error 500 heading.",
  "limitations": "Two body markers. A page that discusses WebLogic in documentation is not matched; the server error page must be rendered.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/boom",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<title>Error 500--Internal Server Error</title><h2>WebLogic Server 14.1.1.0</h2>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/app/boom",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<h1>Error 500--Internal Server Error</h1><p>From RFC 2068 WebLogic Server</p>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>Home</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>WebLogic Server deployments should override the error page.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A status page that names WebLogic and quotes the error text is reported only when both markers appear.",
  "linkedRules": [
    "DPK-DAST-140"
  ],
  "origin": "original-authored",
  "cell": "dast:body-weblogic-error:body-weblogic-error",
  "validationStatus": "VALIDATED"
}
