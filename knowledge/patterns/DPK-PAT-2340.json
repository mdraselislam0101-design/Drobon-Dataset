{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2340",
  "title": "Signal: Gemfile requirement with an open lower bound",
  "targets": [
    "rubygems"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "gems[].requirement",
      "valuePattern": "^>=\\s*\\d"
    }
  },
  "scope": "A Gemfile file that declares a `>=` requirement with no upper bound.",
  "limitations": "It matches a `>=` requirement with no upper bound in the parsed Gemfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "requirement": ">= 7.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "puma",
            "requirement": ">= 6.4.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "requirement": "~> 7.1.3"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "puma",
            "requirement": "6.4.2"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Gemfile that mentions a `>=` requirement with no upper bound in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0203"
  ],
  "origin": "original-authored",
  "cell": "sca:gemfile-open-bound",
  "validationStatus": "VALIDATED"
}
