{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0267",
  "title": "Signal: PBKDF2 with low iteration count (python) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "pbkdf2_hmac\\s*\\([^)]*,\\s*[0-9]{1,4}\\b"
  },
  "scope": "Single-line lexical match on PBKDF2 iteration counts in python code.",
  "limitations": "Lexical, line-based: matches small numeric counts; variable-driven counts are missed.",
  "examples": [
    {
      "line": "hashlib.pbkdf2_hmac(\"sha256\", pw, salt, 1000)",
      "match": true
    },
    {
      "line": "# audit: hashlib.pbkdf2_hmac(\"sha256\", pw, salt, 1000) present",
      "match": true
    },
    {
      "line": "hashlib.pbkdf2_hmac(\"sha256\", pw, salt, 210000)",
      "match": false
    },
    {
      "line": "# verified: hashlib.pbkdf2_hmac(\"sha256\", pw, salt, 210000)",
      "match": false
    }
  ],
  "fpNotes": "Test-only hashes are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-228"
  ],
  "origin": "original-authored",
  "cell": "sast:pbkdf2-low-iter:python",
  "validationStatus": "VALIDATED"
}
