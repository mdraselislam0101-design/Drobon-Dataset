{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1298",
  "title": "Signal: Keycloak administration console disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Keycloak)(?=[\\s\\S]*Administration)"
    }
  },
  "scope": "One response whose body renders the Keycloak administration console.",
  "limitations": "One response body. The rule reports the console page; it does not attempt a login and cannot show which realms exist.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Keycloak Administration Console</title></head><body><div id=\"kc-admin\"></div><h1>Administration</h1><script src=\"/resources/keycloak.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><span>Keycloak</span><nav>Administration</nav><div id=\"admin-console\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>  Console</title></head><body><div id=\"kc-admin\"></div><h1></h1><script src=\"/resources/.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A login page without the Administration view is not reported.",
  "linkedRules": [
    "DPK-DAST-229"
  ],
  "origin": "original-authored",
  "cell": "dast:body-keycloak-admin:keycloak-admin",
  "validationStatus": "VALIDATED"
}
