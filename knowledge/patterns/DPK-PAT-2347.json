{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2347",
  "title": "Signal: Gemfile.lock carries a private namespace gem",
  "targets": [
    "rubygems"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "specs[].name",
      "valuePattern": "^acme-"
    }
  },
  "scope": "A Gemfile.lock file that declares a locked spec whose name sits in the private `acme-` namespace.",
  "limitations": "It matches a locked spec whose name sits in the private `acme-` namespace in the parsed Gemfile.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "acme-internal-core",
            "version": "1.4.2"
          },
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "source": {
          "remote": "https://rubygems.org"
        }
      },
      "match": true
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "acme-internal-util",
            "version": "2.0.0"
          }
        ],
        "source": {
          "remote": "https://gems.acme.example"
        }
      },
      "match": true
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          },
          {
            "name": "puma",
            "version": "6.4.2"
          }
        ],
        "source": {
          "remote": "https://rubygems.org"
        }
      },
      "match": false
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "nokogiri",
            "version": "1.16.7"
          },
          {
            "name": "rake",
            "version": "13.2.1"
          }
        ],
        "source": {
          "remote": "https://rubygems.org"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Gemfile.lock that mentions a locked spec whose name sits in the private `acme-` namespace in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0210"
  ],
  "origin": "original-authored",
  "cell": "sca:gemfile-platform-lock",
  "validationStatus": "VALIDATED"
}
