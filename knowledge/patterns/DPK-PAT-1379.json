{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1379",
  "title": "Signal: Set-Cookie Domain is a public suffix",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Set-Cookie",
      "valuePattern": ";\\s*domain\\s*=\\s*\\.?(?:com|net|org|co\\.uk|co\\.jp|co\\.in|com\\.au|com\\.br|github\\.io|herokuapp\\.com|s3\\.amazonaws\\.com|azurewebsites\\.net|cloudfront\\.net)\\s*(?:;|$)"
    }
  },
  "scope": "One Set-Cookie value whose Domain attribute is a public suffix from the built-in list.",
  "limitations": "One Set-Cookie value. The check uses a fixed list of well-known public suffixes; a suffix outside that list is not detected.",
  "examples": [
    {
      "observation": {
        "url": "https://shop.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Domain=com; Path=/; Secure; HttpOnly"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://shop.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Domain=.github.io; Path=/; Secure"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://shop.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Domain=co.uk; Path=/"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://shop.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Domain=example.com; Path=/; Secure; HttpOnly"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://shop.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "__Host-sid=abc; Path=/; Secure; HttpOnly"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A Domain that ends with a listed suffix but has a registrable label before it (example.com) is not reported; a private-company suffix outside the list is not reported and is stated here as a limitation.",
  "linkedRules": [
    "DPK-DAST-310"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-cookie-domain-public-suffix:cookie-domain-public-suffix",
  "validationStatus": "VALIDATED"
}
