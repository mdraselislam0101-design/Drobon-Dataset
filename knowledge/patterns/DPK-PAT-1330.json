{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1330",
  "title": "Signal: WordPress wp-config.php served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*DB_PASSWORD)(?=[\\s\\S]*wp\\-settings\\.php)"
    }
  },
  "scope": "One response that returns the wp-config.php returned document.",
  "limitations": "One response body. The rule reports the configuration shape; it does not enumerate the values and cannot tell whether the credentials are still valid.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?php define('DB_NAME','shop'); define('DB_USER','shop'); define('DB_PASSWORD','redacted-for-fixture'); define('DB_HOST','db'); require_once ABSPATH . 'wp-settings.php';"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?php define('DB_PASSWORD', 'redacted-for-fixture'); $table_prefix = 'wp_'; require_once ABSPATH . 'wp-settings.php';"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<?php define('DB_NAME','shop'); define('DB_USER','shop'); define('','redacted-for-fixture'); define('DB_HOST','db'); require_once ABSPATH . '';"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>A guide: define( 'DB_PASSWORD', ... ) is read by wp-config.php.</p>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "<?php define( 'DB_PASSWORD',  'redacted-for-fixture' ); require_once ABSPATH . 'wp-settings.php';"
      },
      "match": true
    }
  ],
  "fpNotes": "A page that documents or quotes the file without returning it is not reported.",
  "linkedRules": [
    "DPK-DAST-261"
  ],
  "origin": "original-authored",
  "cell": "dast:body-wpconfig-served:wpconfig-served",
  "validationStatus": "VALIDATED"
}
