{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1297",
  "title": "Signal: Joomla version in generator meta tag",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*name=[\"\\']generator[\"\\'])(?=[\\s\\S]*Joomla)"
    }
  },
  "scope": "One response whose body publishes a Joomla identity in a generator meta tag.",
  "limitations": "One response body. The rule reports the meta tag; it does not resolve the version against an advisory source and makes no claim that the site is vulnerable.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta name=\"generator\" content=\"Joomla! - Open Source Content Management\"><title>Site</title></head><body>Site</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><head><meta name=\"generator\" content=\"Joomla! 4.4.1\"></head><body>Home</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta  content=\"! - Open Source Content Management\"><title>Site</title></head><body>Site</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that links to joomla.org without the meta tag is not reported.",
  "linkedRules": [
    "DPK-DAST-228"
  ],
  "origin": "original-authored",
  "cell": "dast:body-joomla-generator-meta:joomla-generator-meta",
  "validationStatus": "VALIDATED"
}
