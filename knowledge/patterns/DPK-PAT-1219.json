{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1219",
  "title": "Signal: Content-Security-Policy sandbox grants both allow-scripts and allow-same-origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "(?:^|;)\\s*sandbox\\s(?=[^;]*allow-scripts)(?=[^;]*allow-same-origin)"
    }
  },
  "scope": "One response whose Content-Security-Policy sandbox directive contains both allow-scripts and allow-same-origin.",
  "limitations": "One header value. The rule reports the token combination in the sandbox directive; it cannot tell which content the policy applies to or whether the frame is same-origin in practice.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "sandbox allow-scripts allow-same-origin"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; sandbox allow-same-origin allow-scripts allow-forms"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "sandbox allow-scripts"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "sandbox allow-same-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "sandbox allow-scripts allow-popups"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A sandbox that deliberately frames same-origin application code is reported; the token pair still removes the isolation the directive exists to give.",
  "linkedRules": [
    "DPK-DAST-150"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-sandbox-scripts-same-origin:escape-combo",
  "validationStatus": "VALIDATED"
}
