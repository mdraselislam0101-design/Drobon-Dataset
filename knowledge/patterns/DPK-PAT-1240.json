{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1240",
  "title": "Signal: Kibana interface disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*kbn\\-injected\\-metadata)(?=[\\s\\S]*kibana)"
    }
  },
  "scope": "One response whose body contains both the kbn-injected-metadata element and the Kibana name.",
  "limitations": "One response body. The rule reports the Kibana shell; it does not query an index and cannot show that documents are readable.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Kibana</title></head><body><kbn-injected-metadata data=\"{\"version\":\"8.11.0\"}\"></kbn-injected-metadata><script src=\"/bundles/kibana.bundle.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><kbn-injected-metadata></kbn-injected-metadata><script src=\"kibana.bundle.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body>< data=\"{\"version\":\"8.11.0\"}\"></><script src=\"/bundles/.bundle.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A Kibana instance published deliberately is still reported; the finding is the exposed console.",
  "linkedRules": [
    "DPK-DAST-171"
  ],
  "origin": "original-authored",
  "cell": "dast:body-kibana-ui:kibana-ui",
  "validationStatus": "VALIDATED"
}
