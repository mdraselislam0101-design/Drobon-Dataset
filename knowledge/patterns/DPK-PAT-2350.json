{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2350",
  "title": "Signal: Composer lockfile entry without a distribution reference",
  "targets": [
    "composer"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "packages[].dist",
      "field": "reference"
    }
  },
  "scope": "A composer.lock file that declares a locked package whose distribution records no commit reference.",
  "limitations": "It matches a locked package whose distribution records no commit reference in the parsed composer.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "composer.lock",
      "document": {
        "packages": [
          {
            "name": "monolog/monolog",
            "version": "3.7.1",
            "dist": {
              "url": "https://packagist.acme.example/monolog.zip"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "composer.lock",
      "document": {
        "packages": [
          {
            "name": "guzzlehttp/guzzle",
            "version": "7.9.2",
            "dist": {
              "url": "https://packagist.acme.example/guzzle.zip"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "composer.lock",
      "document": {
        "packages": [
          {
            "name": "monolog/monolog",
            "version": "3.7.1",
            "dist": {
              "reference": "9f2c4a1b7c3d0a1b2c3d4e5f60718293"
            }
          }
        ]
      },
      "match": false
    },
    {
      "file": "composer.lock",
      "document": {
        "packages": [
          {
            "name": "guzzlehttp/guzzle",
            "version": "7.9.2",
            "dist": {
              "reference": "0a1b2c3d4e5f60718293a4b5c6d7e8f9"
            }
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A composer.lock that mentions a locked package whose distribution records no commit reference in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0213"
  ],
  "origin": "original-authored",
  "cell": "sca:composer-lock-reference-absent",
  "validationStatus": "VALIDATED"
}
