{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0041",
  "title": "Signal: Wildcard CORS (Access-Control-Allow-Origin *)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Allow-Origin",
      "valuePattern": "^\\*$"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Header check: it cannot confirm which callers are legitimate.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://app.example/"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "Public APIs are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-011"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-open:wildcard",
  "validationStatus": "VALIDATED"
}
