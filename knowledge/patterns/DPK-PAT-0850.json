{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0850",
  "title": "Signal: Unescaped output (print) — review required",
  "targets": [
    "perl"
  ],
  "signal": {
    "kind": "regex",
    "source": "print\\s+\\$"
  },
  "scope": "Single-line lexical match on unescaped output (print).",
  "limitations": "Lexical, line-based: matches the output regardless of value trust.",
  "examples": [
    {
      "line": "print $q",
      "match": true
    },
    {
      "line": "# audit: print $q present",
      "match": true
    },
    {
      "line": "print e($q)",
      "match": false
    },
    {
      "line": "# verified: print e($q)",
      "match": false
    }
  ],
  "fpNotes": "Trusted constants are the common false positive.",
  "linkedRules": [
    "DPK-SAST-733"
  ],
  "origin": "original-authored",
  "cell": "sast:xss-flag-3:perl:print",
  "validationStatus": "VALIDATED"
}
