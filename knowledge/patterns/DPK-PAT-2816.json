{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2816",
  "title": "Signal: Machine-level sources stay active beside the repository list",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packageSources.clear",
      "valuePattern": "^false$"
    }
  },
  "scope": "A nuget.config file that declares a nuget.config whose `<packageSources>` block never clears inherited sources.",
  "limitations": "It matches a nuget.config whose `<packageSources>` block never clears inherited sources in the parsed nuget.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "packageSources": {
          "clear": false,
          "add": [
            {
              "key": "nuget.org",
              "value": "https://api.nuget.org/v3/index.json"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "packageSources": {
          "clear": "false",
          "add": []
        }
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "packageSources": {
          "clear": true,
          "add": [
            {
              "key": "nuget.org",
              "value": "https://api.nuget.org/v3/index.json"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "packageSources": {
          "clear": "true",
          "add": []
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A nuget.config that mentions a nuget.config whose `<packageSources>` block never clears inherited sources in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0679"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-sources-no-clear",
  "validationStatus": "VALIDATED"
}
