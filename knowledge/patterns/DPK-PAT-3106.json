{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3106",
  "title": "Signal: Build tooling declared as a runtime crate",
  "targets": [
    "cargo"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-key-matches",
      "path": "dependencies",
      "keyPattern": "^(?:cc|cmake|bindgen|pkg-config)$"
    }
  },
  "scope": "A Cargo.toml file that declares a build-script crate in the runtime dependency table.",
  "limitations": "It matches a build-script crate in the runtime dependency table in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          },
          "cc": {
            "version": "1.1.31"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          },
          "bindgen": {
            "version": "0.70.1"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "build-dependencies": {
          "cc": {
            "version": "1.1.31"
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "build-dependencies": {
          "bindgen": {
            "version": "0.70.1"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Cargo.toml that mentions a build-script crate in the runtime dependency table in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0969"
  ],
  "origin": "original-authored",
  "cell": "sca:cargo-build-dependency-in-dependencies",
  "validationStatus": "VALIDATED"
}
