{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1211",
  "title": "Signal: Access-Control-Allow-Origin uses a wildcard inside an origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Allow-Origin",
      "valuePattern": "^\\s*https?://[^\\s/]*\\*"
    }
  },
  "scope": "One response whose Access-Control-Allow-Origin value contains a wildcard inside a scheme-and-host form.",
  "limitations": "One header value. The rule judges the declared origin pattern; it cannot see the request's Origin header and therefore cannot tell whether the value was reflected from attacker input.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://*.example.com"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://api.*.example.com"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://example.com"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "null"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A deployment that relies on a proxy expanding the pattern is reported; the header as observed is not a valid CORS origin.",
  "linkedRules": [
    "DPK-DAST-142"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-origin-wildcard-in-host:wildcard-host",
  "validationStatus": "VALIDATED"
}
