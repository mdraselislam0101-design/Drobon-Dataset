{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1114",
  "title": "Signal: Permissions-Policy grants a powerful feature to every origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Permissions-Policy",
      "valuePattern": "(?:^|[,;\\s])(?:camera|microphone|geolocation)\\s*=\\s*\\(?\\s*\\*"
    }
  },
  "scope": "One response: confirm a wildcard grant for a powerful feature.",
  "limitations": "Observation-level: the check reads the declared header text and does not evaluate how a browser applies the policy to a specific frame.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "camera=*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/embed",
        "status": 200,
        "headers": {
          "Permissions-Policy": "geolocation=*, microphone=()"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "camera=(self), microphone=()"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A deployment that intentionally delegates one feature to a trusted origin is reported only when the grant is a wildcard.",
  "linkedRules": [
    "DPK-DAST-077"
  ],
  "origin": "original-authored",
  "cell": "dast:permissions-policy-wildcard-feature:permissions-wildcard",
  "validationStatus": "VALIDATED"
}
