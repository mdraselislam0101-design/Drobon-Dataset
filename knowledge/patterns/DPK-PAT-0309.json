{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0309",
  "title": "Signal: loopback left open (rabbitmq) — review required",
  "targets": [
    "rabbitmq"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:loopback_users\\.guest\\s*=\\s*false)"
  },
  "scope": "Single-line lexical match on open settings for loopback.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "loopback_users.guest = false",
      "match": true
    },
    {
      "line": "# audit: loopback_users.guest = false present",
      "match": true
    },
    {
      "line": "# loopback_users default",
      "match": false
    },
    {
      "line": "# verified: # loopback_users default",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-270"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:rabbitmq:loopback",
  "validationStatus": "VALIDATED"
}
