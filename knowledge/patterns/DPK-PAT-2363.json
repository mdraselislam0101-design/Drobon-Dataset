{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2363",
  "title": "Signal: Swift package fetched over cleartext",
  "targets": [
    "swift"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies[].url",
      "valuePattern": "^http://"
    }
  },
  "scope": "A Package.swift file that declares a package URL that uses cleartext http.",
  "limitations": "It matches a package URL that uses cleartext http in the parsed Package.swift; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Package.swift",
      "document": {
        "dependencies": [
          {
            "url": "http://git.acme.example/sdk.git",
            "requirement": {
              "from": "4.2.0"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "Package.swift",
      "document": {
        "dependencies": [
          {
            "url": "http://10.24.8.9/sdk.git",
            "requirement": {
              "exact": "4.2.0"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "Package.swift",
      "document": {
        "dependencies": [
          {
            "url": "https://github.com/acme/sdk",
            "requirement": {
              "from": "4.2.0"
            }
          }
        ]
      },
      "match": false
    },
    {
      "file": "Package.swift",
      "document": {
        "dependencies": [
          {
            "url": "https://github.com/acme/cli",
            "requirement": {
              "exact": "2.1.0"
            }
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Package.swift that mentions a package URL that uses cleartext http in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0226"
  ],
  "origin": "original-authored",
  "cell": "sca:swift-dependency-cleartext",
  "validationStatus": "VALIDATED"
}
