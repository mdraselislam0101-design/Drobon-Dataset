{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1169",
  "title": "Signal: HTTPS response redirects to a plaintext URL",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Location",
      "valuePattern": "^http://",
      "requireScheme": "https"
    }
  },
  "scope": "One https response whose Location target begins with http://.",
  "limitations": "One Location value on one https observation. It does not follow the redirect chain, so it cannot tell whether the plaintext target redirects back to https before any credential is sent, and it does not grade the target's certificate or availability.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/start",
        "status": 302,
        "headers": {
          "Location": "http://app.example/home"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/start",
        "status": 301,
        "headers": {
          "Location": "HTTP://APP.EXAMPLE/home"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/start",
        "status": 302,
        "headers": {
          "Location": "http://user:pass@app.example/home"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/start",
        "status": 302,
        "headers": {
          "Location": "https://app.example/home"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/start",
        "status": 302,
        "headers": {
          "Location": "/home"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/start",
        "status": 302,
        "headers": {
          "Location": "//app.example/home"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/start",
        "status": 302,
        "headers": {
          "Location": "http://app.example/home"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/start",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberate redirect to a separate plaintext host (a captive portal or an internal appliance) is reported; the observation cannot show what is sent there.",
  "linkedRules": [
    "DPK-DAST-100"
  ],
  "origin": "original-authored",
  "cell": "dast:redirect-to-plaintext:location-http",
  "validationStatus": "VALIDATED"
}
