{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3200",
  "title": "Signal: Possible an xAI API key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "xai-[A-Za-z0-9]{40,}"
  },
  "scope": "Single-line shape match for an xAI API key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"xai-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: key = \"xai-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-140"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-4:xai-api-key",
  "validationStatus": "VALIDATED"
}
