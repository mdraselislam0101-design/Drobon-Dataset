{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1465",
  "title": "Signal: Quarkus Dev UI served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*/q/dev)(?=[\\s\\S]*quarkus)"
    }
  },
  "scope": "One response body containing the Quarkus Dev UI shell.",
  "limitations": "One response body. The rule reports the Dev UI shell; it does not read a configuration page.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/q/dev-ui/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Dev UI</title></head><body><div id=\"quarkus-devui\"></div><a href=\"/q/dev-ui/extensions\">Extensions</a></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/q/dev-ui/configuration-form",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Configuration</h1><p>quarkus.datasource.jdbc.url=jdbc:postgresql://db.internal:5432/app</p><a href=\"/q/dev-ui/io.quarkus.quarkus-datasource\">datasource</a></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api/items",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Items</h1></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Framework guide</title></head><body><p>Development-mode extensions are listed under the dev UI.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that names Quarkus in prose is not reported, because the Dev UI marker is required.",
  "linkedRules": [
    "DPK-DAST-396"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-console-quarkus-dev-ui:quarkus-dev-ui",
  "validationStatus": "VALIDATED"
}
