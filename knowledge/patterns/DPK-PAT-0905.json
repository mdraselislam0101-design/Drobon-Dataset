{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0905",
  "title": "Signal: Django debug page disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "DEBUG\\s*=\\s*True"
    }
  },
  "scope": "Single response body: confirm no debug marker is returned.",
  "limitations": "Marker text check on one body: it cannot tell development output from production exposure, and a quoted marker in documentation can match.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "content-type": "text/html"
        },
        "body": "You're seeing this error because you have <code>DEBUG = True</code>."
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "content-type": "text/html"
        },
        "body": "<code>DEBUG = False</code> in production."
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/debug",
        "status": 200,
        "headers": {},
        "body": "<p>settings: DEBUG=True</p>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/debug",
        "status": 200,
        "headers": {},
        "body": "DEBUG = False"
      },
      "match": false
    }
  ],
  "fpNotes": "Quoted examples in documentation or log excerpts can match the marker.",
  "linkedRules": [
    "DPK-DAST-052"
  ],
  "origin": "original-authored",
  "cell": "dast:debug-exposure:django-debug",
  "validationStatus": "VALIDATED"
}
