{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1258",
  "title": "Signal: Set-Cookie Path attribute is not absolute",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Set-Cookie",
      "valuePattern": ";\\s*path\\s*=\\s*(?!/)[^;]*"
    }
  },
  "scope": "One Set-Cookie header whose Path attribute value does not begin with a slash.",
  "limitations": "One header value. The rule validates the attribute against its grammar and does not compute the default path a particular browser would derive from the request URL.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=app; Secure; HttpOnly; SameSite=Lax"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=; Secure; HttpOnly; SameSite=Lax"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/app; Secure; HttpOnly; SameSite=Lax"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; Secure; HttpOnly; SameSite=Lax"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "An empty Path value is reported too, and a browser that ignores the attribute is not distinguished from one that stores the default path.",
  "linkedRules": [
    "DPK-DAST-189"
  ],
  "origin": "original-authored",
  "cell": "dast:cookie-path-not-absolute:path-not-absolute",
  "validationStatus": "VALIDATED"
}
