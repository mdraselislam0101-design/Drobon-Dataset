{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2184",
  "title": "Signal: Lockfile resolves a dependency from a local path",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.resolved",
      "valuePattern": "^file:"
    }
  },
  "scope": "A package-lock.json file that declares a lockfile entry resolved from a path on the build machine.",
  "limitations": "It matches a lockfile entry resolved from a path on the build machine in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "file:../packages/shared",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "file:vendor/legacy-lib"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org/x/-/x-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org/y/-/y-1.0.0.tgz"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A workspace link is a deliberate monorepo pattern; it is still reported because the lockfile cannot reproduce it elsewhere.",
  "linkedRules": [
    "DPK-SCA-0047"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-resolved-file-path",
  "validationStatus": "VALIDATED"
}
