{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2317",
  "title": "Signal: Gradle build resolves from a snapshot repository",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "repositories[].url",
      "valuePattern": "snapshots?/?$"
    }
  },
  "scope": "A build.gradle file that declares a repository whose URL is the snapshot channel.",
  "limitations": "It matches a repository whose URL is the snapshot channel in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "acmeSnapshots",
            "url": "https://nexus.acme.example/repository/snapshots"
          }
        ],
        "dependencies": []
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "acme",
            "url": "https://nexus.acme.example/snapshot/"
          }
        ],
        "dependencies": []
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "acmeReleases",
            "url": "https://nexus.acme.example/repository/releases"
          }
        ],
        "dependencies": []
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mavenCentral",
            "url": "https://repo.maven.apache.org/maven2"
          }
        ],
        "dependencies": []
      },
      "match": false
    }
  ],
  "fpNotes": "A build.gradle that mentions a repository whose URL is the snapshot channel in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0180"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-snapshot-repository",
  "validationStatus": "VALIDATED"
}
