{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0154",
  "title": "Signal: Framework SQL built from input (efraw) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:FromSqlRaw\\s*\\([^)]*(?:\\+|\\$))"
  },
  "scope": "Single-line lexical match on assembled SQL (efraw).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "FromSqlRaw(\"SELECT \" + q)",
      "match": true
    },
    {
      "line": "# audit: FromSqlRaw(\"SELECT \" + q) present",
      "match": true
    },
    {
      "line": "FromSqlRaw(FIXED)",
      "match": false
    },
    {
      "line": "# verified: FromSqlRaw(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-115"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli-extra:csharp:efraw",
  "validationStatus": "VALIDATED"
}
