{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1167",
  "title": "Signal: Content-Security-Policy base-uri allows every origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "^(?:(?!base-uri(?=[\\s;]|$))[^;]*;\\s*)*base-uri(?=[\\s;]|$)[^;]*?(?<=\\s)(?:\\*|(?:https?|wss?)://\\*)(?=\\s|;|$)"
    }
  },
  "scope": "One Content-Security-Policy value whose first base-uri declaration contains the wildcard or a scheme wildcard host.",
  "limitations": "One header value, first declaration of the directive only. It reports the wildcard permission, not whether a base element can actually be injected into any page.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "base-uri *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; base-uri 'self' *"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "base-uri https://*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "base-uri 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "base-uri 'none'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "base-uri 'self'; base-uri *"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "Pages that never contain a base element can still carry this permission; the finding is the permission, not a demonstrated injection.",
  "linkedRules": [
    "DPK-DAST-098"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-base-uri-wildcard:base-uri",
  "validationStatus": "VALIDATED"
}
