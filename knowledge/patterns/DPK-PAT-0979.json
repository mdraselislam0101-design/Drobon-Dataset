{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0979",
  "title": "Signal: Possible password containing symbols in a URL in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "[A-Za-z][A-Za-z0-9+.\\-]*://[^\\s:@/]{1,64}:(?!(?:[eE][xX][aA][mM][pP][lL][eE]|[cC][hH][aA][nN][gG][eE][mM][eE]|[pP][lL][aA][cC][eE][hH][oO][lL][dD][eE][rR]))(?=[A-Za-z0-9\\-._~!$&'()*+,;=:%]*[\\-._~!$&'()*+,;=:%])[A-Za-z0-9\\-._~!$&'()*+,;=:%]{6,64}@"
  },
  "scope": "Single-line URL userinfo shape match for password containing symbols in a URL.",
  "limitations": "Matches URL userinfo passwords of 6 to 64 characters that contain at least one symbol character. Pure alphanumeric userinfo passwords of 12 or more characters belong to DPK-SEC-063 instead; pure alphanumeric passwords shorter than 12 characters are matched by neither rule (documented recall boundary).",
  "examples": [
    {
      "line": "url = \"postgresql://svc:zzzzzzzz!z9@\"",
      "match": true
    },
    {
      "line": "# audit: url = \"postgresql://svc:zzzzzzzz!z9@\" present",
      "match": true
    },
    {
      "line": "url = \"xy\"",
      "match": false
    },
    {
      "line": "url = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    },
    {
      "line": "url = \"https://admin:P%40ssw0rd-x@host.internal/\"",
      "match": true
    },
    {
      "line": "url = \"postgres://svc@db.internal/app\"",
      "match": false
    },
    {
      "line": "url = \"https://user:short@host/\"",
      "match": false
    },
    {
      "line": "url = \"https://user:zzzzzzzzzzzz@host/\"",
      "match": false
    },
    {
      "line": "url = \"https://user:EXAMPLE-NOT-A-REAL@host/\"",
      "match": false
    },
    {
      "line": "url = \"jdbc:postgresql://db.internal/app?ssl=true&password=zzzzzzzz\"",
      "match": false
    },
    {
      "line": "url = \"postgresql://svc:zzz!z9\"",
      "match": false
    },
    {
      "line": "url = \"mailto:someone@mail.internal\"",
      "match": false
    },
    {
      "line": "url = \"https://u:zzz!z@h\"",
      "match": false
    },
    {
      "line": "url = \"https://u:zzzz!z@h\"",
      "match": true
    },
    {
      "line": "url = \"https://user:Changeme1@host/\"",
      "match": false
    },
    {
      "line": "url = \"https://user:changeme1@host/\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation URLs that spell userinfo for illustration, and test fixtures that embed punctuation in userinfo. Query-parameter credentials (password=...) are outside this shape and belong to DPK-SEC-103.",
  "linkedRules": [
    "DPK-SEC-107"
  ],
  "origin": "original-authored",
  "cell": "secrets:url-userinfo-symbol-password:userinfo-symbol",
  "validationStatus": "VALIDATED"
}
