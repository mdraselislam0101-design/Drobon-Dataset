{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2818",
  "title": "Signal: Every source may serve every package id",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "packageSourceMapping"
    }
  },
  "scope": "A nuget.config file that declares a nuget.config with no `<packageSourceMapping>`.",
  "limitations": "It matches a nuget.config with no `<packageSourceMapping>` in the parsed nuget.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [],
        "config": {},
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "packageSourceMapping": {
          "packageSource": [
            {
              "key": "nuget.org",
              "package": [
                {
                  "pattern": "*"
                }
              ]
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "packageSourceMapping": {
          "packageSource": [
            {
              "key": "acme",
              "package": [
                {
                  "pattern": "Acme.*"
                }
              ]
            }
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A nuget.config that mentions a nuget.config with no `<packageSourceMapping>` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0681"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-source-mapping-absent",
  "validationStatus": "VALIDATED"
}
