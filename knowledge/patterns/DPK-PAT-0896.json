  "id": "DPK-PAT-0896",
  "title": "Signal: SQL built by concatenation (haskell) — review required",
  "targets": [
    "haskell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:query\\s+[^\\n]*\\+\\+)"
  },
  "scope": "Single-line lexical match on assembled SQL in haskell code.",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "query c (\"SELECT \" ++ q)",
      "match": true
    },
    {
      "line": "# audit: query c (\"SELECT \" ++ q) present",
      "match": true
    },
    {
      "line": "query c FIXED",
      "match": false
    },
    {
      "line": "# verified: query c FIXED",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-745"
  ],
