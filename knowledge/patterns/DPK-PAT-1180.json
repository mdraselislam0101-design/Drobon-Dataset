{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1180",
  "title": "Signal: Spring Boot Whitelabel error page disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "Whitelabel Error Page"
    }
  },
  "scope": "One response body containing the Spring Boot default error heading.",
  "limitations": "Body marker check on one response. A custom page that reuses the default heading text can be reported; the rule cannot prove that the exception details are reachable.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/missing",
        "status": 404,
        "headers": {
          "Content-Type": "text/html; charset=utf-8"
        },
        "body": "<html><body><h1>Whitelabel Error Page</h1><p>There was an unexpected error (type=Not Found, status=404).</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api/missing",
        "status": 404,
        "headers": {},
        "body": "{\"timestamp\":\"2026-01-01T00:00:00.000+00:00\",\"status\":404,\"error\":\"Not Found\",\"path\":\"/api/missing\"}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 404,
        "headers": {},
        "body": "<html><body><h1>404</h1><p>The page you requested could not be found.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {},
        "body": "Internal Server Error"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A documentation page that quotes the heading can be reported; the rule cannot tell a rendered error page from quoted text.",
  "linkedRules": [
    "DPK-DAST-111"
  ],
  "origin": "original-authored",
  "cell": "dast:spring-whitelabel:whitelabel",
  "validationStatus": "VALIDATED"
}
