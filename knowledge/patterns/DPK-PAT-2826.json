{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2826",
  "title": "Signal: Package source declared over cleartext",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packageSources.add[].value",
      "valuePattern": "^http://"
    }
  },
  "scope": "A nuget.config file that declares a `<packageSources><add>` entry over cleartext.",
  "limitations": "It matches a `<packageSources><add>` entry over cleartext in the parsed nuget.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "packageSources": {
          "add": [
            {
              "key": "acme",
              "value": "http://nuget.acme.example/v3/index.json"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "packageSources": {
          "add": [
            {
              "key": "internal",
              "value": "http://10.24.8.9/v3/index.json"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "packageSources": {
          "add": [
            {
              "key": "nuget.org",
              "value": "https://api.nuget.org/v3/index.json"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {},
        "packageSources": {
          "add": [
            {
              "key": "acme",
              "value": "https://nuget.acme.example/v3/index.json"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A nuget.config that mentions a `<packageSources><add>` entry over cleartext in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0689"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-source-http-in-package-source",
  "validationStatus": "VALIDATED"
}
