{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0639",
  "title": "Signal: Risky GitHub Actions step (setoutput) — review required",
  "targets": [
    "gha"
  ],
  "signal": {
    "kind": "regex",
    "source": "::set-output"
  },
  "scope": "Single-line lexical match on workflow files.",
  "limitations": "Lexical, line-based: matches the step.",
  "examples": [
    {
      "line": "echo \"::set-output name=x::1\"",
      "match": true
    },
    {
      "line": "# audit: echo \"::set-output name=x::1\" present",
      "match": true
    },
    {
      "line": "echo \"x=1\" >> $GITHUB_OUTPUT",
      "match": false
    },
    {
      "line": "# verified: echo \"x=1\" >> $GITHUB_OUTPUT",
      "match": false
    }
  ],
  "fpNotes": "Trusted first-party actions are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-522"
  ],
  "origin": "original-authored",
  "cell": "sast:gha-more:gha:setoutput",
  "validationStatus": "VALIDATED"
}
