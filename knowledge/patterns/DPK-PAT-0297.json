{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0297",
  "title": "Signal: network left open (elastic) — review required",
  "targets": [
    "elastic"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:network\\.host\\s*:\\s*0\\.0\\.0\\.0)"
  },
  "scope": "Single-line lexical match on open settings for network.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "network.host: 0.0.0.0",
      "match": true
    },
    {
      "line": "# audit: network.host: 0.0.0.0 present",
      "match": true
    },
    {
      "line": "network.host: 127.0.0.1",
      "match": false
    },
    {
      "line": "# verified: network.host: 127.0.0.1",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-258"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:elastic:network",
  "validationStatus": "VALIDATED"
}
