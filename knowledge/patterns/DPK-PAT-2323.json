{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2323",
  "title": "Signal: Central package version entry without a version",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "project.itemGroup.PackageVersion",
      "field": "Version"
    }
  },
  "scope": "A Directory.Packages.props file that declares a `PackageVersion` entry that declares no version.",
  "limitations": "It matches a `PackageVersion` entry that declares no version in the parsed Directory.Packages.props; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Serilog"
              },
              {
                "Include": "Dapper",
                "Version": "2.1.35"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          }
        }
      },
      "match": false
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Dapper",
                "Version": "2.1.35"
              }
            ]
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Directory.Packages.props that mentions a `PackageVersion` entry that declares no version in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0186"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-central-version-absent",
  "validationStatus": "VALIDATED"
}
