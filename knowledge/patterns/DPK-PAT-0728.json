{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0728",
  "title": "Signal: Dangerous function mysql_query (php) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:mysql_query)\\s*\\("
  },
  "scope": "Single-line lexical match on the mysql_query call in php code.",
  "limitations": "Lexical, line-based: any mysql_query call matches.",
  "examples": [
    {
      "line": "mysql_query(payload)",
      "match": true
    },
    {
      "line": "out = mysql_query(data)",
      "match": true
    },
    {
      "line": "mymysql_query(x)",
      "match": false
    },
    {
      "line": "mysql_query_safe()",
      "match": false
    }
  ],
  "fpNotes": "Legacy shims are the common false positive.",
  "linkedRules": [
    "DPK-SAST-611"
  ],
  "origin": "original-authored",
  "cell": "sast:php-call:php:mysql",
  "validationStatus": "VALIDATED"
}
