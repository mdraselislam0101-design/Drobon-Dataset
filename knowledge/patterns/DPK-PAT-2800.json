{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2800",
  "title": "Signal: Requirement resolves to an untagged commit",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "require[].version",
      "valuePattern": "^v0\\.0\\.0-"
    }
  },
  "scope": "A go.mod file that declares a requirement pinned to a pseudo-version.",
  "limitations": "It matches a requirement pinned to a pseudo-version in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v0.0.0-20240101120000-9f2c3d4e5f60"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/core",
            "version": "v0.0.0-20240304050000-a1b2c3d4e5f6"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": false
    }
  ],
  "fpNotes": "A go.mod that mentions a requirement pinned to a pseudo-version in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0663"
  ],
  "origin": "original-authored",
  "cell": "sca:go-require-version-pseudo",
  "validationStatus": "VALIDATED"
}
