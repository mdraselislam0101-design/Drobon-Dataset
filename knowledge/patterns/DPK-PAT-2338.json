{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2338",
  "title": "Signal: Composer lockfile downloads a distribution over cleartext",
  "targets": [
    "composer"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages[].dist.url",
      "valuePattern": "^http://"
    }
  },
  "scope": "A composer.lock file that declares a `dist.url` that uses cleartext http.",
  "limitations": "It matches a `dist.url` that uses cleartext http in the parsed composer.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "composer.lock",
      "document": {
        "packages": [
          {
            "name": "monolog/monolog",
            "version": "3.7.1",
            "dist": {
              "type": "zip",
              "url": "http://packagist.acme.example/monolog.zip"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "composer.lock",
      "document": {
        "packages": [
          {
            "name": "guzzlehttp/guzzle",
            "version": "7.9.2",
            "dist": {
              "type": "zip",
              "url": "http://10.24.8.9/guzzle.zip"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "composer.lock",
      "document": {
        "packages": [
          {
            "name": "monolog/monolog",
            "version": "3.7.1",
            "dist": {
              "type": "zip",
              "url": "https://api.github.com/repos/Seldaek/monolog/zipball/9f2c4a1"
            }
          }
        ]
      },
      "match": false
    },
    {
      "file": "composer.lock",
      "document": {
        "packages": [
          {
            "name": "guzzlehttp/guzzle",
            "version": "7.9.2",
            "dist": {
              "type": "zip",
              "url": "https://api.github.com/repos/guzzle/guzzle/zipball/0a1b2c3"
            }
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A composer.lock that mentions a `dist.url` that uses cleartext http in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0201"
  ],
  "origin": "original-authored",
  "cell": "sca:composer-lock-dist-cleartext",
  "validationStatus": "VALIDATED"
}
