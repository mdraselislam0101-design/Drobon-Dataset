{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0766",
  "title": "Signal: Cleartext protocol client (telnet) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:telnetlib\\.Telnet\\s*\\()"
  },
  "scope": "Single-line lexical match on cleartext clients (telnet).",
  "limitations": "Lexical, line-based: matches the client.",
  "examples": [
    {
      "line": "telnetlib.Telnet(h)",
      "match": true
    },
    {
      "line": "# audit: telnetlib.Telnet(h) present",
      "match": true
    },
    {
      "line": "paramiko.SSHClient()",
      "match": false
    },
    {
      "line": "# verified: paramiko.SSHClient()",
      "match": false
    }
  ],
  "fpNotes": "Loopback use is the common accepted case.",
  "linkedRules": [
    "DPK-SAST-649"
  ],
  "origin": "original-authored",
  "cell": "sast:python-net-plain:python:telnet",
  "validationStatus": "VALIDATED"
