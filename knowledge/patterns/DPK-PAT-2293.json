{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2293",
  "title": "Signal: go.mod excludes a published module version",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "exclude[].version",
      "valuePattern": "^v\\d"
    }
  },
  "scope": "A go.mod file that declares an `exclude` directive that keeps a specific version out of the build.",
  "limitations": "It matches an `exclude` directive that keeps a specific version out of the build in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0"
          }
        ],
        "exclude": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.1.9"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.1.0"
          }
        ],
        "exclude": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.1.1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0"
          }
        ]
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.1.0"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A go.mod that mentions an `exclude` directive that keeps a specific version out of the build in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0156"
  ],
  "origin": "original-authored",
  "cell": "sca:go-exclude-directive",
  "validationStatus": "VALIDATED"
}
