{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1097",
  "title": "Signal: Shell invoked explicitly from exec.Command in go — review required",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:exec\\.Command\\s*\\(\\s*[\"'](?:sh|bash)[\"']\\s*,\\s*[\"']-c[\"'])"
  },
  "scope": "Single-line match on sh -c in go.",
  "limitations": "Lexical: matches literal sh/bash -c pairs on one line; a shell name held in a variable is out of scope.",
  "examples": [
    {
      "line": "cmd := exec.Command(\"sh\", \"-c\", userCommand)",
      "match": true
    },
    {
      "line": "# audit: cmd := exec.Command(\"sh\", \"-c\", userCommand) present",
      "match": true
    },
    {
      "line": "cmd := exec.Command(\"ls\", \"-l\", userDir)",
      "match": false
    },
    {
      "line": "# verified: cmd := exec.Command(\"ls\", \"-l\", userDir)",
      "match": false
    }
  ],
  "fpNotes": "A constant one-line command with no interpolation is the accepted false positive.",
  "linkedRules": [
    "DPK-SAST-914"
  ],
  "origin": "original-authored",
  "cell": "sast:go-shell-c:go",
  "validationStatus": "VALIDATED"
}
