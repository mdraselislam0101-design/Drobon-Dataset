{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1207",
  "title": "Signal: Swagger UI documentation exposed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*id=[\"']?swagger-ui)(?=[\\s\\S]*SwaggerUIBundle)"
    }
  },
  "scope": "One response whose body contains the swagger-ui element and the SwaggerUIBundle script.",
  "limitations": "Two body markers. A page that links to a documentation site is not matched; the UI assets must be rendered in the response.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/docs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<div id=\"swagger-ui\"></div><script src=\"/swagger-ui-bundle.js\"></script><script>window.ui = SwaggerUIBundle({url: \"/openapi.json\"});</script>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api/docs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<div id=swagger-ui></div><script>const ui = SwaggerUIBundle({spec: {}})</script>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/docs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Our API documentation is published at developer.example.</p>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>Home</body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A developer portal that embeds Swagger UI on an internal host is reported; the documentation is still publicly rendered there.",
  "linkedRules": [
    "DPK-DAST-138"
  ],
  "origin": "original-authored",
  "cell": "dast:body-swagger-ui:body-swagger-ui",
  "validationStatus": "VALIDATED"
}
