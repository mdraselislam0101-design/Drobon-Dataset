{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0311",
  "title": "Signal: protected left open (redis) — review required",
  "targets": [
    "redis"
  ],
  "signal": {
    "kind": "regex",
    "source": "protected-mode\\s+no"
  },
  "scope": "Single-line lexical match on open settings for protected.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "protected-mode no",
      "match": true
    },
    {
      "line": "# audit: protected-mode no present",
      "match": true
    },
    {
      "line": "protected-mode yes",
      "match": false
    },
    {
      "line": "# verified: protected-mode yes",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-272"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:redis:protected",
  "validationStatus": "VALIDATED"
}
