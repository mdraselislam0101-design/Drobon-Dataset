{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0619",
  "title": "Signal: Django security setting off (djcsrf) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "CSRF_COOKIE_SECURE\\s*=\\s*False"
  },
  "scope": "Single-line lexical match on Django settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "CSRF_COOKIE_SECURE = False",
      "match": true
    },
    {
      "line": "# audit: CSRF_COOKIE_SECURE = False present",
      "match": true
    },
    {
      "line": "CSRF_COOKIE_SECURE = True",
      "match": false
    },
    {
      "line": "# verified: CSRF_COOKIE_SECURE = True",
      "match": false
    }
  ],
  "fpNotes": "Local development is the common false positive.",
  "linkedRules": [
    "DPK-SAST-502"
  ],
  "origin": "original-authored",
  "cell": "sast:django-secure:python:djcsrf",
  "validationStatus": "VALIDATED"
}
