{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0252",
  "title": "Signal: File access built from input (r) — review required",
  "targets": [
    "r"
  ],
  "signal": {
    "kind": "regex",
    "source": "readLines\\s*\\([^)]*paste0?\\s*\\("
  },
  "scope": "Single-line lexical match on input-built paths in r code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "readLines(paste0(dir, f))",
      "match": true
    },
    {
      "line": "# audit: readLines(paste0(dir, f)) present",
      "match": true
    },
    {
      "line": "readLines(fixed)",
      "match": false
    },
    {
      "line": "# verified: readLines(fixed)",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-213"
  ],
  "origin": "original-authored",
  "cell": "sast:path-langs:r",
  "validationStatus": "VALIDATED"
}
