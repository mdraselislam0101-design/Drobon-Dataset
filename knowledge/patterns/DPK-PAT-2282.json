{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2282",
  "title": "Signal: Poetry resolves every package against an extra supplemental index",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "tool.poetry.source[].priority",
      "valuePattern": "^supplemental$"
    }
  },
  "scope": "A pyproject.toml file that declares a Poetry source marked `priority = \"supplemental\"`, which is searched for every package name.",
  "limitations": "It matches a Poetry source marked `priority = \"supplemental\"`, which is searched for every package name in the parsed pyproject.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pyproject.toml",
      "document": {
        "tool": {
          "poetry": {
            "source": [
              {
                "name": "acme",
                "url": "https://pypi.acme.example/simple",
                "priority": "supplemental"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "tool": {
          "poetry": {
            "source": [
              {
                "name": "pypi",
                "url": "https://pypi.org/simple",
                "priority": "primary"
              },
              {
                "name": "acme",
                "url": "https://pypi.acme.example/simple",
                "priority": "supplemental"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "tool": {
          "poetry": {
            "source": [
              {
                "name": "pypi",
                "url": "https://pypi.org/simple",
                "priority": "primary"
              }
            ]
          }
        }
      },
      "match": false
    },
    {
      "file": "pyproject.toml",
      "document": {
        "tool": {
          "poetry": {
            "source": [
              {
                "name": "acme",
                "url": "https://pypi.acme.example/simple",
                "priority": "explicit"
              }
            ]
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pyproject.toml that mentions a Poetry source marked `priority = \"supplemental\"`, which is searched for every package name in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0145"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-poetry-supplemental-source",
  "validationStatus": "VALIDATED"
}
