{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2165",
  "title": "Signal: Dependency pinned with build metadata",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}\\+"
    }
  },
  "scope": "A package.json file that declares a version carrying `+build` metadata.",
  "limitations": "It matches a version carrying `+build` metadata in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0+build.20250104"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "2.1.0+sha.9f2c4a1"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "^4.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A version whose metadata mirrors a registry-published artifact is still reported; the rule reads the declaration.",
  "linkedRules": [
    "DPK-SCA-0028"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-build-metadata",
  "validationStatus": "VALIDATED"
}
