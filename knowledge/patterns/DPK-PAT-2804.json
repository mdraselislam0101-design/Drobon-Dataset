{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2804",
  "title": "Signal: Profile adds a cleartext repository",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "settings.profiles[].repositories[].url",
      "valuePattern": "^http://"
    }
  },
  "scope": "A settings.xml file that declares a profile repository URL over cleartext.",
  "limitations": "It matches a profile repository URL over cleartext in the parsed settings.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "central",
              "mirrorOf": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "servers": [],
          "profiles": [
            {
              "id": "acme",
              "repositories": [
                {
                  "id": "acme",
                  "url": "http://repo.acme.example/maven2"
                }
              ]
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "central",
              "mirrorOf": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "servers": [],
          "profiles": [
            {
              "id": "internal",
              "repositories": [
                {
                  "id": "internal",
                  "url": "http://10.24.8.9/maven2"
                }
              ]
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "central",
              "mirrorOf": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "servers": [],
          "profiles": [
            {
              "id": "acme",
              "repositories": [
                {
                  "id": "acme",
                  "url": "https://repo.acme.example/maven2"
                }
              ]
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "central",
              "mirrorOf": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "servers": [],
          "profiles": []
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A settings.xml that mentions a profile repository URL over cleartext in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0667"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-settings-profile-repository-cleartext",
  "validationStatus": "VALIDATED"
}
