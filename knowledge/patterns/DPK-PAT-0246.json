{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0246",
  "title": "Signal: File access built from input (elixir) — review required",
  "targets": [
    "elixir"
  ],
  "signal": {
    "kind": "regex",
    "source": "File\\.read!?\\s*\\([^)]*<>"
  },
  "scope": "Single-line lexical match on input-built paths in elixir code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "File.read(dir <> f)",
      "match": true
    },
    {
      "line": "# audit: File.read(dir <> f) present",
      "match": true
    },
    {
      "line": "File.read(fixed)",
      "match": false
    },
    {
      "line": "# verified: File.read(fixed)",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-207"
  ],
  "origin": "original-authored",
  "cell": "sast:path-langs:elixir",
  "validationStatus": "VALIDATED"
}
