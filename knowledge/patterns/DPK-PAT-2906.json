{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2906",
  "title": "Signal: Package.resolved pin that follows a branch",
  "targets": [
    "swift"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "pins[].state.branch",
      "valuePattern": "^.+$"
    }
  },
  "scope": "A Package.resolved file that declares a resolved pin whose state keeps a branch name.",
  "limitations": "It matches a resolved pin whose state keeps a branch name in the parsed Package.resolved; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "sdk",
            "location": "https://github.com/acme/sdk",
            "state": {
              "branch": "main",
              "revision": "9f2c3d4e5f60"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "core",
            "location": "https://github.com/acme/core",
            "state": {
              "branch": "develop",
              "revision": "a1b2c3d4e5f6"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "sdk",
            "location": "https://github.com/acme/sdk",
            "state": {
              "branch": null,
              "version": "4.2.0"
            }
          }
        ]
      },
      "match": false
    },
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "core",
            "location": "https://github.com/acme/core",
            "state": {
              "version": "1.4.2"
            }
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Package.resolved that mentions a resolved pin whose state keeps a branch name in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0769"
  ],
  "origin": "original-authored",
  "cell": "sca:swift-resolved-pin-branch",
  "validationStatus": "VALIDATED"
}
