{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0324",
  "title": "Signal: SQL built by concatenation (scala) — review required",
  "targets": [
    "scala"
  ],
  "signal": {
    "kind": "regex",
    "source": "SQL\\s*\\((?:[^()]|\\([^()]*\\))*(?:\\+|\\$\\{)"
  },
  "scope": "Single-line lexical match on concatenated SQL in scala code.",
  "limitations": "Lexical, line-based: any concatenated query matches, including trusted assembly. Input trust needs human review.",
  "examples": [
    {
      "line": "SQL(\"SELECT \" + id)",
      "match": true
    },
    {
      "line": "# audit: SQL(\"SELECT \" + id) present",
      "match": true
    },
    {
      "line": "SQL(FIXED)",
      "match": false
    },
    {
      "line": "# verified: SQL(FIXED)",
      "match": false
    },
    {
      "line": "SQL(buildSql(name) + \" -- x\")",
      "match": true
    },
    {
      "line": "SQL(s\"SELECT * FROM users WHERE name = '${name}'\")",
      "match": true
    },
    {
      "line": "SQL(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed column lists or trusted fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-285"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-concat:scala",
  "validationStatus": "VALIDATED"
}
