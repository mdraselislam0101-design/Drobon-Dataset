{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1402",
  "title": "Signal: webpack development client served in production",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "/__webpack_hmr|webpack-dev-server/client|sockjs-node"
    }
  },
  "scope": "One response body referencing the webpack dev-server client.",
  "limitations": "One response body. The check reads the served markup; it does not connect to the hot-reload socket.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<script src=\"/__webpack_hmr\"></script><div id=\"root\"></div>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/app",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<script src=\"/assets/webpack-dev-server/client/index.js\"></script>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<script src=\"/assets/app.4f2c1d.js\" defer></script><div id=\"root\"></div>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/about",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>We build the front end with webpack and serve the hashed bundle.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A production bundle that mentions webpack in a comment is not reported; the client path or the sockjs endpoint must appear.",
  "linkedRules": [
    "DPK-DAST-333"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-webpack-dev-client:webpack-hmr-client",
  "validationStatus": "VALIDATED"
}
