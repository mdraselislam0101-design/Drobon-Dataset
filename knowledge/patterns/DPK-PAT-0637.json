{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0637",
  "title": "Signal: Risky GitHub Actions step (addpath) — review required",
  "targets": [
    "gha"
  ],
  "signal": {
    "kind": "regex",
    "source": "::add-path"
  },
  "scope": "Single-line lexical match on workflow files.",
  "limitations": "Lexical, line-based: matches the step.",
  "examples": [
    {
      "line": "echo \"::add-path::/x\"",
      "match": true
    },
    {
      "line": "# audit: echo \"::add-path::/x\" present",
      "match": true
    },
    {
      "line": "echo \"/x\" >> $GITHUB_PATH",
      "match": false
    },
    {
      "line": "# verified: echo \"/x\" >> $GITHUB_PATH",
      "match": false
    }
  ],
  "fpNotes": "Trusted first-party actions are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-520"
  ],
  "origin": "original-authored",
  "cell": "sast:gha-more:gha:addpath",
  "validationStatus": "VALIDATED"
}
