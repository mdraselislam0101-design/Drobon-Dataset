{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0114",
  "title": "Signal: Download piped to shell (shell) — review required",
  "targets": [
    "shell"
  ],
  "signal": {
    "kind": "regex",
    "source": "curl\\s+[^|]*\\|\\s*(?:ba|z|k|fi|da)?sh\\b"
  },
  "scope": "Single-line lexical match on download-to-shell pipes in shell scripts.",
  "limitations": "Lexical, line-based: matches the pipe regardless of transport or verification.",
  "examples": [
    {
      "line": "curl https://x.io/i.sh | sh",
      "match": true
    },
    {
      "line": "# audit: curl https://x.io/i.sh | sh present",
      "match": true
    },
    {
      "line": "curl -o i.sh https://x.io/i.sh",
      "match": false
    },
    {
      "line": "# verified: curl -o i.sh https://x.io/i.sh",
      "match": false
    },
    {
      "line": "curl https://x.internal.test/i.sh | zsh",
      "match": true
    },
    {
      "line": "curl https://x.internal.test/i.sh | dash",
      "match": true
    },
    {
      "line": "curl -o i.sh https://x.internal.test/i.sh",
      "match": false
    }
  ],
  "fpNotes": "Pipes over verified local files (not network) are the common false positive — confirm the source.",
  "linkedRules": [
    "DPK-SAST-075"
  ],
  "origin": "original-authored",
  "cell": "sast:curl-pipe-shell:shell",
  "validationStatus": "VALIDATED"
}
