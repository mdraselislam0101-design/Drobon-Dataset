{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1092",
  "title": "Signal: Shell execution from VBA or VB in vbnet — review required",
  "targets": [
    "vbnet"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bShell(?:Execute)?\\s*(?:\\(|\\\")"
  },
  "scope": "Single-line match on shell execution in vbnet.",
  "limitations": "Lexical: matches Shell and ShellExecute calls; WMI-based execution is out of scope.",
  "examples": [
    {
      "line": "Shell \"cmd.exe /c \" & userCommand",
      "match": true
    },
    {
      "line": "# audit: Shell \"cmd.exe /c \" & userCommand present",
      "match": true
    },
    {
      "line": "Process.Start(New ProcessStartInfo(\"notepad.exe\"))",
      "match": false
    },
    {
      "line": "# verified: Process.Start(New ProcessStartInfo(\"notepad.exe\"))",
      "match": false
    }
  ],
  "fpNotes": "A signed installer invoking a fixed executable is the accepted, reviewed exception.",
  "linkedRules": [
    "DPK-SAST-909"
  ],
  "origin": "original-authored",
  "cell": "sast:vba-shell-run:vbnet",
  "validationStatus": "VALIDATED"
}
