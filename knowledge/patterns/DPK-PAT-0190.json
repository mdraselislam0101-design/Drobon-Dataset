{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0190",
  "title": "Signal: Risky Kubernetes pod security (rofs) — review required",
  "targets": [
    "yaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "readOnlyRootFilesystem\\s*:\\s*false"
  },
  "scope": "Single-line lexical match on risky pod settings (rofs).",
  "limitations": "Lexical, line-based: matches the setting regardless of namespace trust.",
  "examples": [
    {
      "line": "readOnlyRootFilesystem: false",
      "match": true
    },
    {
      "line": "# audit: readOnlyRootFilesystem: false present",
      "match": true
    },
    {
      "line": "readOnlyRootFilesystem: true",
      "match": false
    },
    {
      "line": "# verified: readOnlyRootFilesystem: true",
      "match": false
    }
  ],
  "fpNotes": "System daemons needing host access are the common accepted case — confirm scope.",
  "linkedRules": [
    "DPK-SAST-151"
  ],
  "origin": "original-authored",
  "cell": "sast:k8s-strict:yaml:rofs",
  "validationStatus": "VALIDATED"
}
