{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1466",
  "title": "Signal: Spring Boot Admin console is reachable without authentication",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*spring-boot-admin)(?=[\\s\\S]*Spring Boot Admin)"
    }
  },
  "scope": "One response body containing the Spring Boot Admin shell.",
  "limitations": "One response body. The rule reports the admin shell; it does not read an actuator endpoint.",
  "examples": [
    {
      "observation": {
        "url": "https://ops.example/admin/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Spring Boot Admin</title></head><body><div id=\"spring-boot-admin-root\"></div><script src=\"/assets/index.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://ops.example/admin/#/applications",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Applications · Spring Boot Admin</title></head><body><div class=\"spring-boot-admin-app\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/actuator/health",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"status\":\"UP\"}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Operations guide</title></head><body><p>The admin server aggregates registered applications.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that names the project in prose is not reported, because the shell marker is required.",
  "linkedRules": [
    "DPK-DAST-397"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-console-spring-boot-admin:spring-boot-admin",
  "validationStatus": "VALIDATED"
}
