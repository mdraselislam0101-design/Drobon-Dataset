{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0733",
  "title": "Signal: Dangerous PHP construct (parsestr) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:parse_str\\s*\\(\\s*\\$_(?:GET|POST|REQUEST)\\s*\\))"
  },
  "scope": "Single-line lexical match on dangerous constructs (parsestr).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "parse_str($_GET)",
      "match": true
    },
    {
      "line": "# audit: parse_str($_GET) present",
      "match": true
    },
    {
      "line": "parse_str($s, $out)",
      "match": false
    },
    {
      "line": "# verified: parse_str($s, $out)",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-616"
  ],
  "origin": "original-authored",
  "cell": "sast:php-flag:php:parsestr",
  "validationStatus": "VALIDATED"
}
