{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3126",
  "title": "Signal: Pack-time hook in the manifest",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "scripts.prepack",
      "valuePattern": "^.+$"
    }
  },
  "scope": "A package.json file that declares a `prepack` script that runs while building the tarball.",
  "limitations": "It matches a `prepack` script that runs while building the tarball in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p .",
          "prepack": "node ./scripts/bundle.js"
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p .",
          "prepack": "npm run build"
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "license": "MIT",
        "private": true,
        "engines": {
          "node": ">=20"
        },
        "dependencies": {
          "lodash": "^4.17.21"
        },
        "devDependencies": {
          "jest": "^29.7.0"
        },
        "scripts": {
          "test": "node --test",
          "build": "tsc -p ."
        },
        "publishConfig": {
          "registry": "https://registry.npmjs.org"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A package.json that mentions a `prepack` script that runs while building the tarball in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0989"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-prepack-hook",
  "validationStatus": "VALIDATED"
}
