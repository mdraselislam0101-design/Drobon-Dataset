{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2160",
  "title": "Signal: Dependency declared with a caret on a zero-zero version",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^\\^0\\.0\\.\\d{1,3}$"
    }
  },
  "scope": "A package.json file that declares a caret range on a `0.0.x` version, which npm treats as an exact patch lock.",
  "limitations": "It matches a caret range on a `0.0.x` version, which npm treats as an exact patch lock in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "^0.0.3"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "^0.0.12"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "^0.3.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "0.0.3"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A caret on `0.x.y` where the minor is non-zero has different semantics and is not reported here.",
  "linkedRules": [
    "DPK-SCA-0023"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-caret-zero-major",
  "validationStatus": "VALIDATED"
}
