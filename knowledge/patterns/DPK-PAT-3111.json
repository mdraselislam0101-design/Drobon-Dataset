{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3111",
  "title": "Signal: Gemfile.lock with no PLATFORMS section",
  "targets": [
    "rubygems"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "platforms"
    }
  },
  "scope": "A Gemfile.lock file that declares a lockfile that records no target platforms.",
  "limitations": "It matches a lockfile that records no target platforms in the parsed Gemfile.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "checksums": {
          "rails": "sha256=9f2c3d4e"
        },
        "ruby_version": "ruby 3.3.4p94",
        "bundled_with": "BUNDLED WITH 2.5.11"
      },
      "match": true
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [],
        "checksums": {
          "rails": "sha256=9f2c3d4e"
        },
        "ruby_version": "ruby 3.3.4p94",
        "bundled_with": "BUNDLED WITH 2.5.11"
      },
      "match": true
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "checksums": {
          "rails": "sha256=9f2c3d4e"
        },
        "ruby_version": "ruby 3.3.4p94",
        "bundled_with": "BUNDLED WITH 2.5.11",
        "platforms": [
          "ruby",
          "x86_64-linux"
        ]
      },
      "match": false
    },
    {
      "file": "Gemfile.lock",
      "document": {
        "specs": [
          {
            "name": "rails",
            "version": "7.1.3"
          }
        ],
        "checksums": {
          "rails": "sha256=9f2c3d4e"
        },
        "ruby_version": "ruby 3.3.4p94",
        "bundled_with": "BUNDLED WITH 2.5.11",
        "platforms": [
          "arm64-darwin-23"
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Gemfile.lock that mentions a lockfile that records no target platforms in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0974"
  ],
  "origin": "original-authored",
  "cell": "sca:gemfile-lock-platforms-absent",
  "validationStatus": "VALIDATED"
}
