{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2904",
  "title": "Signal: Swift package ranged to a whole major version",
  "targets": [
    "swift"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies[].requirement.range.upperBound",
      "valuePattern": "^\\d+\\.0\\.0$"
    }
  },
  "scope": "A Package.swift file that declares a range whose upper bound is a whole major release.",
  "limitations": "It matches a range whose upper bound is a whole major release in the parsed Package.swift; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Package.swift",
      "document": {
        "dependencies": [
          {
            "url": "https://github.com/acme/sdk",
            "requirement": {
              "range": {
                "lowerBound": "4.0.0",
                "upperBound": "5.0.0"
              }
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "Package.swift",
      "document": {
        "dependencies": [
          {
            "url": "https://github.com/acme/core",
            "requirement": {
              "range": {
                "lowerBound": "1.0.0",
                "upperBound": "2.0.0"
              }
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "Package.swift",
      "document": {
        "dependencies": [
          {
            "url": "https://github.com/acme/sdk",
            "requirement": {
              "range": {
                "lowerBound": "4.2.0",
                "upperBound": "4.3.0"
              }
            }
          }
        ]
      },
      "match": false
    },
    {
      "file": "Package.swift",
      "document": {
        "dependencies": []
      },
      "match": false
    }
  ],
  "fpNotes": "A Package.swift that mentions a range whose upper bound is a whole major release in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0767"
  ],
  "origin": "original-authored",
  "cell": "sca:swift-dependency-open-range",
  "validationStatus": "VALIDATED"
}
