{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0159",
  "title": "Signal: Framework SQL built from input (peewee) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:execute_sql\\s*\\([^)]*(?:\\+|\\{))"
  },
  "scope": "Single-line lexical match on assembled SQL (peewee).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "execute_sql(\"SELECT \" + q)",
      "match": true
    },
    {
      "line": "# audit: execute_sql(\"SELECT \" + q) present",
      "match": true
    },
    {
      "line": "execute_sql(FIXED)",
      "match": false
    },
    {
      "line": "# verified: execute_sql(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-120"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli-extra:python:peewee",
  "validationStatus": "VALIDATED"
}
