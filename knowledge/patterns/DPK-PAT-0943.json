{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0943",
  "title": "Signal: Expression parsing (java)",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:parseExpression)\\s*\\("
  },
  "scope": "Single-line lexical match on expression-parser calls in Java code.",
  "limitations": "Lexical, line-based: matches the parse call regardless of where the string came from.",
  "examples": [
    {
      "line": "parser.parseExpression(payload)",
      "match": true
    },
    {
      "line": "out = parser.parseExpression(data)",
      "match": true
    },
    {
      "line": "myparserparseExpression(x)",
      "match": false
    },
    {
      "line": "parser.parseExpression_safe()",
      "match": false
    }
  ],
  "fpNotes": "Fixed expressions defined in code are the common false positive.",
  "linkedRules": [
    "DPK-SAST-787"
  ],
