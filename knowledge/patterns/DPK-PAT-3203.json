{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3203",
  "title": "Signal: Possible a GCS signed-URL signature in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "X-Goog-Signature=[a-f0-9]{32,}"
  },
  "scope": "Single-line shape match for a GCS signed-URL signature.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "url = \"X-Goog-Signature=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"",
      "match": true
    },
    {
      "line": "# audit: url = \"X-Goog-Signature=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" present",
      "match": true
    },
    {
      "line": "url = \"xy\"",
      "match": false
    },
    {
      "line": "url = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-143"
  ],
  "origin": "original-authored",
  "cell": "secrets:credential-bearing-signature:gcs-signed-url-signature",
  "validationStatus": "VALIDATED"
}
