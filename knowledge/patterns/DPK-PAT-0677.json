{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0677",
  "title": "Signal: Sandbox escape via runInContext (javascript) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:runInContext)\\s*\\("
  },
  "scope": "Single-line lexical match on the runInContext call in javascript code.",
  "limitations": "Lexical, line-based: any runInContext call matches.",
  "examples": [
    {
      "line": "runInContext(payload)",
      "match": true
    },
    {
      "line": "out = runInContext(data)",
      "match": true
    },
    {
      "line": "myrunInContext(x)",
      "match": false
    },
    {
      "line": "runInContext_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted plugins are the common false positive.",
  "linkedRules": [
    "DPK-SAST-560"
  ],
  "origin": "original-authored",
  "cell": "sast:js-call:javascript",
  "validationStatus": "VALIDATED"
}
