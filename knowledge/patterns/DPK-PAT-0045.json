{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0045",
  "title": "Signal: Missing Content-Security-Policy response header",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "missing-response-header",
      "header": "Content-Security-Policy"
    }
  },
  "scope": "Single response: confirm the header is absent.",
  "limitations": "Header-name check: it cannot judge whether the header value is correct.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "Content-Security-Policy": "default-src 'none'"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Non-browser endpoints are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-015"
  ],
  "origin": "original-authored",
  "cell": "dast:header-missing:csp",
  "validationStatus": "VALIDATED"
}
