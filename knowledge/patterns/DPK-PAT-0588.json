  "title": "Signal: OS command execution via IO.popen (ruby) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:IO\\.popen)\\s*\\("
  },
  "scope": "Single-line lexical match on the IO.popen call in ruby code.",
  "limitations": "Lexical, line-based: any IO.popen call matches.",
  "examples": [
    {
      "line": "IO.popen(payload)",
      "match": true
    },
    {
      "line": "out = IO.popen(data)",
      "match": true
    },
    {
      "line": "myIOpopen(x)",
      "match": false
    },
    {
      "line": "IO.popen_safe()",
      "match": false
    }
  ],
  "fpNotes": "Fixed maintenance commands are the common false positive.",
  "linkedRules": [
    "DPK-SAST-471"
  ],
