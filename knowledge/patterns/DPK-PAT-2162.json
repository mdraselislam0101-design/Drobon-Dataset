{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2162",
  "title": "Signal: Dependency declared with a hyphen range",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}\\s+-\\s+\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$"
    }
  },
  "scope": "A package.json file that declares a hyphen range that spans several minor or major releases.",
  "limitations": "It matches a hyphen range that spans several minor or major releases in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "1.2.3 - 2.3.4"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "0.9.0 - 1.0.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "1.2.3"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "^1.2.3"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A hyphen range inside a single patch line is still a range and is reported; narrow it to an exact version.",
  "linkedRules": [
    "DPK-SCA-0025"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-hyphen-range",
  "validationStatus": "VALIDATED"
}
