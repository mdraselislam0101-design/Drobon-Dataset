{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0802",
  "title": "Signal: Risky Spring setting (ssl) — review required",
  "targets": [
    "properties"
  ],
  "signal": {
    "kind": "regex",
    "source": "server\\.ssl\\.enabled\\s*=\\s*false"
  },
  "scope": "Single-line lexical match on Spring config.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "server.ssl.enabled=false",
      "match": true
    },
    {
      "line": "# audit: server.ssl.enabled=false present",
      "match": true
    },
    {
      "line": "server.ssl.enabled=true",
      "match": false
    },
    {
      "line": "# verified: server.ssl.enabled=true",
      "match": false
    }
  ],
  "fpNotes": "Local development is the common false positive.",
  "linkedRules": [
    "DPK-SAST-685"
  ],
  "origin": "original-authored",
  "cell": "sast:spring-risk:properties:ssl",
  "validationStatus": "VALIDATED"
}
