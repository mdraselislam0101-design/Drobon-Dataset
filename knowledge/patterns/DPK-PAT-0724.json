{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0724",
  "title": "Signal: File access built from input (pascal) — review required",
  "targets": [
    "pascal"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:AssignFile\\s*\\([^,]+,\\s*[a-zA-Z])"
  },
  "scope": "Single-line lexical match on input-built paths in pascal code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "AssignFile(f, name)",
      "match": true
    },
    {
      "line": "# audit: AssignFile(f, name) present",
      "match": true
    },
    {
      "line": "AssignFile(f, 'fixed')",
      "match": false
    },
    {
      "line": "# verified: AssignFile(f, 'fixed')",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-607"
  ],
  "origin": "original-authored",
  "cell": "sast:path-3:pascal",
  "validationStatus": "VALIDATED"
}
