{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2312",
  "title": "Signal: Gradle verification entry without an artifact hash",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "components[].artifacts",
      "field": "sha256"
    }
  },
  "scope": "A verification-metadata.xml file that declares a dependency verification entry whose artifact records no checksum.",
  "limitations": "It matches a dependency verification entry whose artifact records no checksum in the parsed verification-metadata.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "com.acme",
            "name": "internal-core",
            "version": "1.4.2",
            "artifacts": [
              {
                "name": "internal-core-1.4.2.jar"
              }
            ]
          }
        ]
      },
      "match": true
    },
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "org.example",
            "name": "lib",
            "version": "2.0.1",
            "artifacts": [
              {
                "name": "lib-2.0.1.jar"
              }
            ]
          }
        ]
      },
      "match": true
    },
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "com.acme",
            "name": "internal-core",
            "version": "1.4.2",
            "artifacts": [
              {
                "name": "internal-core-1.4.2.jar",
                "sha256": "aaaabbbb"
              }
            ]
          }
        ]
      },
      "match": false
    },
    {
      "file": "verification-metadata.xml",
      "document": {
        "components": [
          {
            "group": "org.example",
            "name": "lib",
            "version": "2.0.1",
            "artifacts": [
              {
                "name": "lib-2.0.1.jar",
                "sha256": "ccccdddd"
              }
            ]
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A verification-metadata.xml that mentions a dependency verification entry whose artifact records no checksum in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0175"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-verification-artifact-hash-absent",
  "validationStatus": "VALIDATED"
}
