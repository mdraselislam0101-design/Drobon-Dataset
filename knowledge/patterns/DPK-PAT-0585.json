{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0585",
  "title": "Signal: OS command execution via run (julia) — review required",
  "targets": [
    "julia"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:run)\\s*\\("
  },
  "scope": "Single-line lexical match on the run call in julia code.",
  "limitations": "Lexical, line-based: any run call matches.",
  "examples": [
    {
      "line": "run(payload)",
      "match": true
    },
    {
      "line": "out = run(data)",
      "match": true
    },
    {
      "line": "myrun(x)",
      "match": false
    },
    {
      "line": "run_safe()",
      "match": false
    }
  ],
  "fpNotes": "Fixed maintenance commands are the common false positive.",
  "linkedRules": [
    "DPK-SAST-468"
  ],
  "origin": "original-authored",
  "cell": "sast:cmd-exec-3:julia",
  "validationStatus": "VALIDATED"
}
