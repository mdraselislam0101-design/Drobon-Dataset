{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1384",
  "title": "Signal: Meta referrer tag sends full URLs to every destination",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<meta[^>]{0,300}name\\s*=\\s*[\"']?referrer[^>]{0,300}content\\s*=\\s*[\"']\\s*unsafe-url"
    }
  },
  "scope": "One meta referrer element whose content is unsafe-url.",
  "limitations": "One response body. The check reads the meta element; it does not observe the Referer header the browser later sends.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/invite?token=abc",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta name=\"referrer\" content=\"unsafe-url\"></head><body>ok</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/invite?token=abc",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<meta name='referrer' content='unsafe-url'/>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/invite?token=abc",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<meta name=\"referrer\" content=\"strict-origin-when-cross-origin\">"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/invite?token=abc",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Invite</title></head><body>ok</body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A meta referrer tag with a stricter policy is not reported; an unsafe-url value in a response header is covered by DPK-DAST-068 instead.",
  "linkedRules": [
    "DPK-DAST-315"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-meta-referrer-unsafe-url:meta-referrer-unsafe-url",
  "validationStatus": "VALIDATED"
}
