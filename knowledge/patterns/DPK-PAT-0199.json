{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0199",
  "title": "Signal: Sensitive value in log call (elixir) — review required",
  "targets": [
    "elixir"
  ],
  "signal": {
    "kind": "regex",
    "source": "Logger\\.(?:info|debug)\\s*\\(?[^#\\n]*(?:password|passwd|secret|token)"
  },
  "scope": "Single-line lexical match on credential-named log values in elixir code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "Logger.info(\"password=#{p}\")",
      "match": true
    },
    {
      "line": "# audit: Logger.info(\"password=#{p}\") present",
      "match": true
    },
    {
      "line": "Logger.info(\"user=#{u}\")",
      "match": false
    },
    {
      "line": "# verified: Logger.info(\"user=#{u}\")",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-160"
  ],
  "origin": "original-authored",
  "cell": "sast:log-langs:elixir",
  "validationStatus": "VALIDATED"
}
