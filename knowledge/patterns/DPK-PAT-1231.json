{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1231",
  "title": "Signal: HashiCorp Consul UI disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*consul\\-ui)(?=[\\s\\S]*Consul\\ by\\ HashiCorp)"
    }
  },
  "scope": "One response whose body contains both the consul-ui element and the Consul attribution.",
  "limitations": "One response body. The rule reports the UI shell; it does not query the catalogue or the key-value store.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Consul</title></head><body><div id=\"consul-ui\"></div><script src=\"/ui/consul-ui.js\"></script><footer>Consul by HashiCorp</footer></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div id=\"consul-ui\" data-version=\"1.17.1\"></div><span>Consul by HashiCorp</span></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Consul</title></head><body><div id=\"\"></div><script src=\"/ui/.js\"></script><footer></footer></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published UI is still reported; the finding is the exposed console.",
  "linkedRules": [
    "DPK-DAST-162"
  ],
  "origin": "original-authored",
  "cell": "dast:body-consul-ui:consul-ui",
  "validationStatus": "VALIDATED"
}
