{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1327",
  "title": "Signal: X-UA-Compatible forces a legacy document mode",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-UA-Compatible",
      "valuePattern": "(?:^|,)\\s*IE\\s*=\\s*(?:EmulateIE\\d+|5|7|8|9|10)\\b"
    }
  },
  "scope": "One response whose X-UA-Compatible value selects a legacy document mode.",
  "limitations": "One header value. The rule reports the header; it cannot tell which engine a given client selects or whether the page depends on legacy behaviour.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-UA-Compatible": "IE=edge"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-UA-Compatible": "IE=EmulateIE7"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-UA-Compatible": "IE=8"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A deployment that needs the header for a scoped intranet client is still reported; the finding is that it applies to this response.",
  "linkedRules": [
    "DPK-DAST-258"
  ],
  "origin": "original-authored",
  "cell": "dast:x-ua-compatible-ie:ua-compatible-ie",
  "validationStatus": "VALIDATED"
}
