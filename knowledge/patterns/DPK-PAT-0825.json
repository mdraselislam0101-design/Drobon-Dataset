{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0825",
  "title": "Signal: Server-side fetch of assembled URL (nim) — review required",
  "targets": [
    "nim"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:request\\s*\\([^)]*&)"
  },
  "scope": "Single-line lexical match on assembled fetch URLs in nim code.",
  "limitations": "Lexical, line-based: any assembled fetch URL matches.",
  "examples": [
    {
      "line": "c.request(base & p)",
      "match": true
    },
    {
      "line": "# audit: c.request(base & p) present",
      "match": true
    },
    {
      "line": "c.request(fixed)",
      "match": false
    },
    {
      "line": "# verified: c.request(fixed)",
      "match": false
    }
  ],
  "fpNotes": "Fixed hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-708"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-4:nim",
  "validationStatus": "VALIDATED"
}
