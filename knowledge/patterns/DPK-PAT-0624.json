{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0624",
  "title": "Signal: Open DNS resolver (allowquery) — review required",
  "targets": [
    "bind"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:allow-query\\s*\\{\\s*any)"
  },
  "scope": "Single-line lexical match on DNS settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "allow-query { any; };",
      "match": true
    },
    {
      "line": "# audit: allow-query { any; }; present",
      "match": true
    },
    {
      "line": "allow-query { local; };",
      "match": false
    },
    {
      "line": "# verified: allow-query { local; };",
      "match": false
    }
  ],
  "fpNotes": "Public resolvers are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-507"
  ],
  "origin": "original-authored",
  "cell": "sast:dns-open:bind:allowquery",
  "validationStatus": "VALIDATED"
}
