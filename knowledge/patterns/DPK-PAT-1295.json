{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1295",
  "title": "Signal: Jenkins dashboard disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Jenkins)(?=[\\s\\S]*Manage\\ Jenkins)"
    }
  },
  "scope": "One response whose body renders the Jenkins dashboard with a management link.",
  "limitations": "One response body. The rule reports the dashboard; it does not open a job and cannot show whether builds or credentials are reachable.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Dashboard [Jenkins]</title></head><body><div id=\"jenkins-head\"><a href=\"/manage\">Manage Jenkins</a></div><div id=\"job_shop\"><a href=\"/job/shop/\">shop</a></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div id=\"jenkins\"><span>Jenkins</span><a href=\"manage\">Manage Jenkins</a></div><table id=\"projectstatus\"><tr><td>deploy-prod</td></tr></table></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Dashboard []</title></head><body><div id=\"-head\"><a href=\"/manage\">Manage </a></div><div id=\"job_shop\"><a href=\"/job/shop/\">shop</a></div></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A login page that carries the Jenkins chrome but no job list is not reported.",
  "linkedRules": [
    "DPK-DAST-226"
  ],
  "origin": "original-authored",
  "cell": "dast:body-jenkins-dashboard:jenkins-dashboard",
  "validationStatus": "VALIDATED"
}
