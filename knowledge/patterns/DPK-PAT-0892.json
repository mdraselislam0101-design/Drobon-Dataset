{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0892",
  "title": "Signal: Sensitive value in log call (fortran) — review required",
  "targets": [
    "fortran"
  ],
  "signal": {
    "kind": "regex",
    "source": "WRITE\\s*\\(\\s*\\*\\s*,\\s*\\*\\s*\\)[^\\n]{0,80}(?:password|passwd|secret|token)"
  },
  "scope": "Single-line lexical match on credential-named log values in fortran code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "WRITE(*,*) \"password\", p",
      "match": true
    },
    {
      "line": "# audit: WRITE(*,*) \"password\", p present",
      "match": true
    },
    {
      "line": "WRITE(*,*) \"user\", u",
      "match": false
    },
    {
      "line": "# verified: WRITE(*,*) \"user\", u",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-741"
  ],
  "origin": "original-authored",
  "cell": "sast:log-4:fortran",
  "validationStatus": "VALIDATED"
}
