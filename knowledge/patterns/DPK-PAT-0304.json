{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0304",
  "title": "Signal: skipgrant left open (mysql) — review required",
  "targets": [
    "mysql"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:skip-grant-tables)"
  },
  "scope": "Single-line lexical match on open settings for skipgrant.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "skip-grant-tables",
      "match": true
    },
    {
      "line": "# audit: skip-grant-tables present",
      "match": true
    },
    {
      "line": "# grant tables enforced",
      "match": false
    },
    {
      "line": "# verified: # grant tables enforced",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-265"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:mysql:skipgrant",
  "validationStatus": "VALIDATED"
}
