{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0672",
  "title": "Signal: TLS trust weakened (jndi) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "lookup\\s*\\(\\s*\"ldap:"
  },
  "scope": "Single-line lexical match on TLS trust code (jndi).",
  "limitations": "Lexical, line-based: matches the weakness.",
  "examples": [
    {
      "line": "ctx.lookup(\"ldap://h/o\")",
      "match": true
    },
    {
      "line": "# audit: ctx.lookup(\"ldap://h/o\") present",
      "match": true
    },
    {
      "line": "ctx.lookup(\"java:comp/env/x\")",
      "match": false
    },
    {
      "line": "# verified: ctx.lookup(\"java:comp/env/x\")",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive.",
  "linkedRules": [
    "DPK-SAST-555"
  ],
  "origin": "original-authored",
  "cell": "sast:java-tls-more:java:jndi",
  "validationStatus": "VALIDATED"
}
