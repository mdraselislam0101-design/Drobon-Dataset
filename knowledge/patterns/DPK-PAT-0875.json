{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0875",
  "title": "Signal: Possible a PayPal access token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "A21AA[A-Za-z0-9_.-]{40,}"
  },
  "scope": "Single-line shape match for a PayPal access token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"A21AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"A21AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-087"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-2:paypal-bearer",
  "validationStatus": "VALIDATED"
}
