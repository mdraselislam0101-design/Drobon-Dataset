{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2883",
  "title": "Signal: Profile repository that allows snapshot updates",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "settings.profiles[].repositories[].snapshots.enabled",
      "valuePattern": "^true$"
    }
  },
  "scope": "A settings.xml file that declares a profile repository with snapshots enabled.",
  "limitations": "It matches a profile repository with snapshots enabled in the parsed settings.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "central",
              "mirrorOf": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "servers": [],
          "profiles": [
            {
              "id": "internal",
              "repositories": [
                {
                  "id": "internal",
                  "url": "https://nexus.acme.example/releases",
                  "snapshots": {
                    "enabled": "true"
                  }
                }
              ]
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "central",
              "mirrorOf": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "servers": [],
          "profiles": [
            {
              "id": "acme",
              "repositories": [
                {
                  "id": "acme",
                  "url": "https://repo.acme.example",
                  "snapshots": {
                    "enabled": "true"
                  }
                }
              ]
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "central",
              "mirrorOf": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "servers": [],
          "profiles": [
            {
              "id": "internal",
              "repositories": [
                {
                  "id": "internal",
                  "url": "https://nexus.acme.example/releases",
                  "snapshots": {
                    "enabled": "false"
                  }
                }
              ]
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "central",
              "mirrorOf": "central",
              "url": "https://repo1.maven.org/maven2"
            }
          ],
          "servers": [],
          "profiles": []
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A settings.xml that mentions a profile repository with snapshots enabled in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0746"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-permissive-snapshot-updates",
  "validationStatus": "VALIDATED"
}
