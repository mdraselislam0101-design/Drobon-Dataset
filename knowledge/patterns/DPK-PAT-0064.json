{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0064",
  "title": "Signal: Risky CI setting (writeall) — review required",
  "targets": [
    "yaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:permissions\\s*:\\s*write-all)"
  },
  "scope": "Single-line lexical match on risky CI settings (writeall).",
  "limitations": "Lexical, line-based: matches the setting regardless of repository trust.",
  "examples": [
    {
      "line": "permissions: write-all",
      "match": true
    },
    {
      "line": "# audit: permissions: write-all present",
      "match": true
    },
    {
      "line": "permissions: read-all",
      "match": false
    },
    {
      "line": "# verified: permissions: read-all",
      "match": false
    }
  ],
  "fpNotes": "Trusted private repositories are the common accepted case — confirm trust.",
  "linkedRules": [
    "DPK-SAST-025"
  ],
  "origin": "original-authored",
  "cell": "sast:ci-risky:yaml:writeall",
  "validationStatus": "VALIDATED"
}
