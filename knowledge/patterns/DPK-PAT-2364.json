{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2364",
  "title": "Signal: Package.resolved pin records no version",
  "targets": [
    "swift"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "pins[].state",
      "field": "version"
    }
  },
  "scope": "A Package.resolved file that declares a resolved pin whose state carries only a revision.",
  "limitations": "It matches a resolved pin whose state carries only a revision in the parsed Package.resolved; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "sdk",
            "location": "https://github.com/acme/sdk",
            "state": {
              "branch": null,
              "revision": "9f2c4a1b7c3d0a1b2c3d4e5f60718293"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "cli",
            "location": "https://github.com/acme/cli",
            "state": {
              "revision": "0a1b2c3d4e5f60718293a4b5c6d7e8f9"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "sdk",
            "location": "https://github.com/acme/sdk",
            "state": {
              "version": "4.2.0",
              "revision": "9f2c4a1"
            }
          }
        ]
      },
      "match": false
    },
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "cli",
            "location": "https://github.com/acme/cli",
            "state": {
              "version": "2.1.0",
              "revision": "0a1b2c3"
            }
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Package.resolved that mentions a resolved pin whose state carries only a revision in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0227"
  ],
  "origin": "original-authored",
  "cell": "sca:swift-pin-version-absent",
  "validationStatus": "VALIDATED"
}
