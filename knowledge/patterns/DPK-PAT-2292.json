{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2292",
  "title": "Signal: go.mod without a language version directive",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "go"
    }
  },
  "scope": "A go.mod file that declares a `go.mod` that declares no `go` version.",
  "limitations": "It matches a `go.mod` that declares no `go` version in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "require": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.1.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0"
          }
        ]
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.21",
        "require": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.1.0"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A go.mod that mentions a `go.mod` that declares no `go` version in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0155"
  ],
  "origin": "original-authored",
  "cell": "sca:go-directive-absent",
  "validationStatus": "VALIDATED"
}
