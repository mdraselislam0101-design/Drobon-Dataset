{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0609",
  "title": "Signal: Dangerous .NET construct (sqlinterp) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "new SqlCommand\\s*\\(\\s*\\$\""
  },
  "scope": "Single-line lexical match on .NET constructs (sqlinterp).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "new SqlCommand($\"SELECT {q}\")",
      "match": true
    },
    {
      "line": "# audit: new SqlCommand($\"SELECT {q}\") present",
      "match": true
    },
    {
      "line": "new SqlCommand(FIXED)",
      "match": false
    },
    {
      "line": "# verified: new SqlCommand(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-492"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-flag:csharp:sqlinterp",
  "validationStatus": "VALIDATED"
}
