{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0203",
  "title": "Signal: Sensitive value in log call (scala) — review required",
  "targets": [
    "scala"
  ],
  "signal": {
    "kind": "regex",
    "source": "println\\s*\\([^)]*(?:password|passwd|secret|token)"
  },
  "scope": "Single-line lexical match on credential-named log values in scala code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "println(\"password=\" + pw)",
      "match": true
    },
    {
      "line": "# audit: println(\"password=\" + pw) present",
      "match": true
    },
    {
      "line": "println(\"user=\" + u)",
      "match": false
    },
    {
      "line": "# verified: println(\"user=\" + u)",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-164"
  ],
  "origin": "original-authored",
  "cell": "sast:log-langs:scala",
  "validationStatus": "VALIDATED"
}
