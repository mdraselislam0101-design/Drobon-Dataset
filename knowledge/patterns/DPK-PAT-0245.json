{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0245",
  "title": "Signal: File access built from input (dart) — review required",
  "targets": [
    "dart"
  ],
  "signal": {
    "kind": "regex",
    "source": "File\\s*\\([^)]*\\+"
  },
  "scope": "Single-line lexical match on input-built paths in dart code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "File(dir + f)",
      "match": true
    },
    {
      "line": "# audit: File(dir + f) present",
      "match": true
    },
    {
      "line": "File(fixed)",
      "match": false
    },
    {
      "line": "# verified: File(fixed)",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-206"
  ],
  "origin": "original-authored",
  "cell": "sast:path-langs:dart",
  "validationStatus": "VALIDATED"
}
