{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0749",
  "title": "Signal: Weak proxy or service setting (disable) — review required",
  "targets": [
    "istio"
  ],
  "signal": {
    "kind": "regex",
    "source": "mode\\s*:\\s*DISABLE"
  },
  "scope": "Single-line lexical match on service settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "mode: DISABLE",
      "match": true
    },
    {
      "line": "# audit: mode: DISABLE present",
      "match": true
    },
    {
      "line": "mode: STRICT",
      "match": false
    },
    {
      "line": "# verified: mode: STRICT",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-632"
  ],
  "origin": "original-authored",
  "cell": "sast:proxy-misc:istio:disable",
  "validationStatus": "VALIDATED"
}
