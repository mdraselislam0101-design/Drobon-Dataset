{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0150",
  "title": "Signal: Flask session cookie without Secure (python) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:SESSION_COOKIE_SECURE[\"']?\\s*\\]\\s*=\\s*False)"
  },
  "scope": "Single-line lexical match on the Flask setting.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "app.config[\"SESSION_COOKIE_SECURE\"] = False",
      "match": true
    },
    {
      "line": "# audit: app.config[\"SESSION_COOKIE_SECURE\"] = False present",
      "match": true
    },
    {
      "line": "app.config[\"SESSION_COOKIE_SECURE\"] = True",
      "match": false
    },
    {
      "line": "# verified: app.config[\"SESSION_COOKIE_SECURE\"] = True",
      "match": false
    }
  ],
  "fpNotes": "Local development is the common false positive.",
  "linkedRules": [
    "DPK-SAST-111"
  ],
  "origin": "original-authored",
  "cell": "sast:flask-cookie:python:flasksess",
  "validationStatus": "VALIDATED"
}
