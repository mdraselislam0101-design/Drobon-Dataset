{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2825",
  "title": "Signal: Locked graph mixes a local project into a package restore",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*.*.type",
      "valuePattern": "^Project$"
    }
  },
  "scope": "A packages.lock.json file that declares a locked dependency that resolves to a project reference.",
  "limitations": "It matches a locked dependency that resolves to a project reference in the parsed packages.lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            },
            "Acme.Core": {
              "type": "Project",
              "resolved": "1.4.2"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            },
            "Acme.Sdk": {
              "type": "Project",
              "resolved": "4.2.0"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            },
            "Dapper": {
              "type": "Transitive",
              "resolved": "2.1.35"
            }
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A packages.lock.json that mentions a locked dependency that resolves to a project reference in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0688"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-lock-type-project",
  "validationStatus": "VALIDATED"
}
