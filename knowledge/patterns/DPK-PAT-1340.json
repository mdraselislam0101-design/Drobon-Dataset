{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1340",
  "title": "Signal: Base element points relative URLs at a plaintext origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<base\\b[^>]*\\shref\\s*=\\s*[\"\\']?\\s*http://",
      "requireScheme": "https"
    }
  },
  "scope": "One HTTPS response body whose base element href starts with http.",
  "limitations": "One response body. The check reports a base href whose scheme is http on an HTTPS response; it does not follow the resolved URLs and it does not compare hosts.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<base href=\"http://app.example/\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<base href='http://static.example/assets/'>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<base href=\"https://app.example/\">"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<base href=\"/assets/\">"
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {},
        "body": "<base href=\"http://app.example/\">"
      },
      "match": false
    }
  ],
  "fpNotes": "A base element that is present but overridden later in the document is reported; the finding is the declared scheme, not the effective base.",
  "linkedRules": [
    "DPK-DAST-271"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-base-href-http:base-href-http",
  "validationStatus": "VALIDATED"
}
