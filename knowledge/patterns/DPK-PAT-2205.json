{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2205",
  "title": "Signal: Lockfile resolves a bare tarball URL",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.resolved",
      "valuePattern": "^(?!.*/-/)[^ ]{0,160}\\.tgz$"
    }
  },
  "scope": "A package-lock.json file that declares a lockfile entry pointing straight at a `.tgz` file rather than a registry path.",
  "limitations": "It matches a lockfile entry pointing straight at a `.tgz` file rather than a registry path in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://downloads.acme.example/sdk-4.2.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "resolved": "https://cdn.thirdparty.example/cli-2.0.0.tgz"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org/x/-/x-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "resolved": "https://artifacts.acme.example/y/-/y-2.0.0.tgz"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A registry mirror that serves the same layout is still reported when the host is not the configured registry.",
  "linkedRules": [
    "DPK-SCA-0068"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-tarball-without-registry",
  "validationStatus": "VALIDATED"
}
