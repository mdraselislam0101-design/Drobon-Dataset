{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3103",
  "title": "Signal: Package source on the legacy V2 protocol",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "sources[].protocolVersion",
      "valuePattern": "^2$"
    }
  },
  "scope": "A nuget.config file that declares a source pinned to protocol version 2.",
  "limitations": "It matches a source pinned to protocol version 2 in the parsed nuget.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "acme",
            "value": "https://nuget.acme.example/v2",
            "protocolVersion": "2"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "internal",
            "value": "https://10.24.8.9/v2",
            "protocolVersion": 2
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json",
            "protocolVersion": "3"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": false
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [],
        "config": {},
        "settings": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A nuget.config that mentions a source pinned to protocol version 2 in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0966"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-source-protocol-version",
  "validationStatus": "VALIDATED"
}
