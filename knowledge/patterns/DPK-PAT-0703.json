{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0703",
  "title": "Signal: Sensitive value in log call (clojure) — review required",
  "targets": [
    "clojure"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:println\\s+[^\\n]*(?:password|passwd|secret|token))"
  },
  "scope": "Single-line lexical match on credential-named log values in clojure code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "(println \"password\" p)",
      "match": true
    },
    {
      "line": "# audit: (println \"password\" p) present",
      "match": true
    },
    {
      "line": "(println \"user\" u)",
      "match": false
    },
    {
      "line": "# verified: (println \"user\" u)",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-586"
  ],
  "origin": "original-authored",
  "cell": "sast:log-4:clojure",
  "validationStatus": "VALIDATED"
}
