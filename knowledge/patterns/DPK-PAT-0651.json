  "title": "Signal: Legacy digest via SHA1.hash (haskell) — review required",
  "targets": [
    "haskell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:SHA1\\.hash)\\s*\\("
  },
  "scope": "Single-line lexical match on the SHA1.hash call in haskell code.",
  "limitations": "Lexical, line-based: matches any SHA1.hash call.",
  "examples": [
    {
      "line": "SHA1.hash(payload)",
      "match": true
    },
    {
      "line": "out = SHA1.hash(data)",
      "match": true
    },
    {
      "line": "mySHA1hash(x)",
      "match": false
    },
    {
      "line": "SHA1.hash_safe()",
      "match": false
    }
  ],
  "fpNotes": "Checksums are the common false positive.",
  "linkedRules": [
    "DPK-SAST-534"
  ],
