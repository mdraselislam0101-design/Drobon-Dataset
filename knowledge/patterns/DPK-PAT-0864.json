{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0864",
  "title": "Signal: Possible a GitLab runner token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "GR[0-9]{10,}[A-Za-z0-9_-]{20,}"
  },
  "scope": "Single-line shape match for a GitLab runner token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"GR1111111111AAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"GR1111111111AAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-076"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-2:gitlab-runner",
  "validationStatus": "VALIDATED"
}
