{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0683",
  "title": "Signal: Dangerous JS construct (shell) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "spawnSync\\s*\\([^)]*shell\\s*:\\s*true"
  },
  "scope": "Single-line lexical match on dangerous constructs (shell).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "spawnSync(c, { shell: true })",
      "match": true
    },
    {
      "line": "# audit: spawnSync(c, { shell: true }) present",
      "match": true
    },
    {
      "line": "spawnSync(c, { shell: false })",
      "match": false
    },
    {
      "line": "# verified: spawnSync(c, { shell: false })",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-566"
  ],
  "origin": "original-authored",
  "cell": "sast:js-flag:javascript:shell",
  "validationStatus": "VALIDATED"
}
