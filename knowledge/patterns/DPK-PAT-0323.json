{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0323",
  "title": "Signal: SQL built by concatenation (ruby) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.execute\\s*\\((?:[^()]|\\([^()]*\\))*(?:\\+|#\\{)"
  },
  "scope": "Single-line lexical match on concatenated SQL in ruby code.",
  "limitations": "Lexical, line-based: any concatenated query matches, including trusted assembly. Input trust needs human review.",
  "examples": [
    {
      "line": "db.execute(\"SELECT #{id}\")",
      "match": true
    },
    {
      "line": "# audit: db.execute(\"SELECT #{id}\") present",
      "match": true
    },
    {
      "line": "db.execute(FIXED)",
      "match": false
    },
    {
      "line": "# verified: db.execute(FIXED)",
      "match": false
    },
    {
      "line": "db.execute(build_sql(name) + \" -- x\")",
      "match": true
    },
    {
      "line": "db.execute(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed column lists or trusted fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-284"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-concat:ruby",
  "validationStatus": "VALIDATED"
}
