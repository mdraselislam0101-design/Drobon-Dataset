{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0843",
  "title": "Signal: Umask cleared to zero (python) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:os\\.umask\\s*\\(\\s*0\\s*\\))"
  },
  "scope": "Single-line lexical match on umask clearing in python code.",
  "limitations": "Lexical, line-based: matches the clearing.",
  "examples": [
    {
      "line": "os.umask(0)",
      "match": true
    },
    {
      "line": "# audit: os.umask(0) present",
      "match": true
    },
    {
      "line": "os.umask(0o022)",
      "match": false
    },
    {
      "line": "# verified: os.umask(0o022)",
      "match": false
    }
  ],
  "fpNotes": "Brief scoped clearing is the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-726"
  ],
  "origin": "original-authored",
  "cell": "sast:umask-zero:python",
  "validationStatus": "VALIDATED"
}
