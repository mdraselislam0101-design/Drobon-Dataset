{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1290",
  "title": "Signal: ELMAH error log disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Error\\ Log\\ for)(?=[\\s\\S]*ELMAH)"
    }
  },
  "scope": "One response whose body renders the ELMAH error log index.",
  "limitations": "One response body. The rule reports the log index; it does not open an entry and cannot show which values an exception recorded.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>ELMAH</title></head><body><h1>Error Log for application</h1><table><tr><td>System.NullReferenceException</td><td>/Orders/Edit</td></tr></table><p>Powered by ELMAH</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h2>Error Log for shop</h2><span>ELMAH</span><ul><li>SqlException at /api/items</li></ul></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><h1> application</h1><table><tr><td>System.NullReferenceException</td><td>/Orders/Edit</td></tr></table><p>Powered by </p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A generic ASP.NET error page is a different finding with its own rule.",
  "linkedRules": [
    "DPK-DAST-221"
  ],
  "origin": "original-authored",
  "cell": "dast:body-elmah-error-log:elmah-error-log",
  "validationStatus": "VALIDATED"
}
