{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3142",
  "title": "Signal: Source that allows insecure connections",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "sources[].allowInsecureConnections",
      "valuePattern": "^true$"
    }
  },
  "scope": "A nuget.config file that declares an `allowInsecureConnections` switch set to true.",
  "limitations": "It matches an `allowInsecureConnections` switch set to true in the parsed nuget.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "acme",
            "value": "http://nuget.acme.example/v3/index.json",
            "allowInsecureConnections": "true"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "internal",
            "value": "http://10.24.8.9/v3/index.json",
            "allowInsecureConnections": true
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json",
            "allowInsecureConnections": "false"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": false
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [],
        "config": {},
        "settings": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A nuget.config that mentions an `allowInsecureConnections` switch set to true in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1005"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-insecure-connections-allowed",
  "validationStatus": "VALIDATED"
}
