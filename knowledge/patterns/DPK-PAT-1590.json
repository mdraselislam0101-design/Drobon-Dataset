{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1590",
  "title": "Signal: TLS hostname verifier replaced (java)",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:setHostnameVerifier|setDefaultHostnameVerifier)\\s*\\("
  },
  "scope": "Single-line lexical match on hostname-verifier installation in java TLS clients.",
  "limitations": "Lexical, line-based: cannot tell a permissive verifier from a strict custom one.",
  "examples": [
    {
      "line": "connection.setHostnameVerifier(payload)",
      "match": true
    },
    {
      "line": "out = connection.setHostnameVerifier(data)",
      "match": true
    },
    {
      "line": "myconnectionsetHostnameVerifier(x)",
      "match": false
    },
    {
      "line": "connection.setHostnameVerifier_safe()",
      "match": false
    }
  ],
  "fpNotes": "Strict custom verifiers that pin a certificate are the common false positive.",
  "linkedRules": [
    "DPK-SAST-963"
  ],
  "origin": "original-authored",
  "cell": "sast:hostname-verifier-off:java:tls",
  "validationStatus": "VALIDATED"
}
