{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0177",
  "title": "Signal: Cleartext http:// URL (universal) — review required",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "http://[A-Za-z0-9]"
  },
  "scope": "Single-line lexical match on http:// literals.",
  "limitations": "Lexical, line-based: matches the scheme regardless of endpoint sensitivity.",
  "examples": [
    {
      "line": "url = \"http://api.example.com/v1\"",
      "match": true
    },
    {
      "line": "# audit: url = \"http://api.example.com/v1\" present",
      "match": true
    },
    {
      "line": "url = \"https://api.example.com/v1\"",
      "match": false
    },
    {
      "line": "# verified: url = \"https://api.example.com/v1\"",
      "match": false
    }
  ],
  "fpNotes": "Localhost, documentation links, and legacy device endpoints are the common false positives.",
  "linkedRules": [
    "DPK-SAST-138"
  ],
  "origin": "original-authored",
  "cell": "sast:http-literal:universal",
  "validationStatus": "VALIDATED"
}
