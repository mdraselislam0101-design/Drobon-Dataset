{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1134",
  "title": "Signal: Content Security Policy permits inline script in html — review required",
  "targets": [
    "html"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Content-Security-Policy[^\\n]*'unsafe-inline')|\\b(?:Content-Security-Policy[^\\n]*unsafe-inline)"
  },
  "scope": "Single-line match on an unsafe-inline CSP in html.",
  "limitations": "Lexical: matches a meta-tag policy on one line; a policy delivered as an HTTP header is out of scope.",
  "examples": [
    {
      "line": "<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'; script-src 'unsafe-inline'\">",
      "match": true
    },
    {
      "line": "# audit: <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'; script-src 'unsafe-inline'\"> present",
      "match": true
    },
    {
      "line": "<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'\">",
      "match": false
    },
    {
      "line": "# verified: <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'\">",
      "match": false
    }
  ],
  "fpNotes": "A static documentation page with no user-controlled markup is the reviewed exception.",
  "linkedRules": [
    "DPK-SAST-949"
  ],
  "origin": "original-authored",
  "cell": "sast:csp-unsafe-inline:html",
  "validationStatus": "VALIDATED"
}
