{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0571",
  "title": "Signal: Weak response control (COEP without require-corp)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-missing-directive",
      "header": "Cross-Origin-Embedder-Policy",
      "directive": "require-corp"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Header check: it cannot confirm exploitability.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "unsafe-none"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "require-corp"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "require-corp"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "CDN behaviors are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-046"
  ],
  "origin": "original-authored",
  "cell": "dast:response-weak-2:coep-lax",
  "validationStatus": "VALIDATED"
}
