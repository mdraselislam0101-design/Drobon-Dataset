{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0571",
  "title": "Signal: Cross-Origin-Embedder-Policy explicitly disables cross-origin isolation",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Cross-Origin-Embedder-Policy",
      "valuePattern": "^unsafe-none$"
    }
  },
  "scope": "One response: Cross-Origin-Embedder-Policy is exactly unsafe-none.",
  "limitations": "Value check: flags the explicit unsafe-none value only. A missing header is a separate finding (DPK-DAST-012); credentialless is a valid isolation mode and is not reported.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "unsafe-none"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "UNSAFE-NONE"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Embedder-Policy": "require-corp"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "An application that intentionally opts out of isolation is reported by design; the exposure is the opt-out itself.",
  "linkedRules": [
    "DPK-DAST-046"
  ],
  "origin": "original-authored",
  "cell": "dast:response-weak-2:coep-lax",
  "validationStatus": "VALIDATED"
}
