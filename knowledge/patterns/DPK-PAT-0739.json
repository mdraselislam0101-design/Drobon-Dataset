{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0739",
  "title": "Signal: Weak PHP crypto or diagnostics (ecb) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "openssl_encrypt\\s*\\([^)]*AES[^)]*-ECB"
  },
  "scope": "Single-line lexical match on PHP settings (ecb).",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "openssl_encrypt($d, \"AES-128-ECB\", $k)",
      "match": true
    },
    {
      "line": "# audit: openssl_encrypt($d, \"AES-128-ECB\", $k) present",
      "match": true
    },
    {
      "line": "openssl_encrypt($d, \"AES-128-CBC\", $k)",
      "match": false
    },
    {
      "line": "# verified: openssl_encrypt($d, \"AES-128-CBC\", $k)",
      "match": false
    }
  ],
  "fpNotes": "Legacy interop is the common false positive.",
  "linkedRules": [
    "DPK-SAST-622"
  ],
  "origin": "original-authored",
  "cell": "sast:php-misc:php:ecb",
  "validationStatus": "VALIDATED"
}
