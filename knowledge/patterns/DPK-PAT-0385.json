{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0385",
  "title": "Signal: TLS verification disabled (rust) — review required",
  "targets": [
    "rust"
  ],
  "signal": {
    "kind": "regex",
    "source": "danger_accept_invalid_certs\\s*\\(\\s*true"
  },
  "scope": "Single-line lexical match on TLS-disabling settings in rust code.",
  "limitations": "Lexical, line-based: matches the switch regardless of environment.",
  "examples": [
    {
      "line": "danger_accept_invalid_certs(true)",
      "match": true
    },
    {
      "line": "# audit: danger_accept_invalid_certs(true) present",
      "match": true
    },
    {
      "line": "WebPkiVerifier",
      "match": false
    },
    {
      "line": "# verified: WebPkiVerifier",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive.",
  "linkedRules": [
    "DPK-SAST-346"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-langs:rust",
  "validationStatus": "VALIDATED"
}
