{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0193",
  "title": "Signal: LDAP filter built by concatenation (java) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.search\\s*\\([^)]*\\+"
  },
  "scope": "Single-line lexical match on assembled LDAP filters in java code.",
  "limitations": "Lexical, line-based: any assembled filter matches, including trusted ones.",
  "examples": [
    {
      "line": "ctx.search(base, \"(uid=\" + id + \")\")",
      "match": true
    },
    {
      "line": "# audit: ctx.search(base, \"(uid=\" + id + \")\") present",
      "match": true
    },
    {
      "line": "ctx.search(base, FIXED)",
      "match": false
    },
    {
      "line": "# verified: ctx.search(base, FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed organizational units is the common false positive.",
  "linkedRules": [
    "DPK-SAST-154"
  ],
  "origin": "original-authored",
  "cell": "sast:ldap-inject:java",
  "validationStatus": "VALIDATED"
}
