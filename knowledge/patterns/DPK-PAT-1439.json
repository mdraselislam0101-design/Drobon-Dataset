{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1439",
  "title": "Signal: IIS detailed error page disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Detailed Error Information)(?=[\\s\\S]*Microsoft-IIS)"
    }
  },
  "scope": "One response body containing the IIS detailed error table and the server product marker.",
  "limitations": "One response body. The rule recognises the detail table; it does not show whether the same detail is logged.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/app/missing.aspx",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h2>HTTP Error 404.0 - Not Found</h2><h3>Detailed Error Information</h3><table><tr><th>Module</th><td>IIS Web Core</td></tr><tr><th>Physical Path</th><td>C:\\inetpub\\wwwroot\\app\\missing.aspx</td></tr></table><p>Microsoft-IIS/10.0</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api/x",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h2>HTTP Error 500.19 - Internal Server Error</h2><h3>Detailed Error Information</h3><table><tr><th>Module</th><td>WebDAVModule</td></tr></table><hr>Microsoft-IIS/10.0</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/app/missing",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Not found</h1></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/iis",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Disable the detailed error table on production sites.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A generic IIS 404 page without the detail table is not reported. A documentation page that reproduces the table is reported, because the rule reads the table rather than its origin.",
  "linkedRules": [
    "DPK-DAST-370"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-page-iis-detailed-error:iis-detailed-error",
  "validationStatus": "VALIDATED"
}
