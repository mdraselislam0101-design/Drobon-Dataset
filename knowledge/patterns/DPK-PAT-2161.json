{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2161",
  "title": "Signal: Dependency declared with a caret inside a zero major line",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^\\^0\\.[1-9]\\d{0,2}\\.\\d{1,3}$"
    }
  },
  "scope": "A package.json file that declares a caret range inside a `0.x` line, where npm only allows patch-level movement.",
  "limitations": "It matches a caret range inside a `0.x` line, where npm only allows patch-level movement in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "^0.4.2"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "^0.12.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "^0.0.2"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "^1.4.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A caret on a stable major (`^1.x`) follows different rules and is not reported.",
  "linkedRules": [
    "DPK-SCA-0024"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-caret-zero-minor",
  "validationStatus": "VALIDATED"
}
