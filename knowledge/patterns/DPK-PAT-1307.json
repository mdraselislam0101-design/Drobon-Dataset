{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1307",
  "title": "Signal: OpenAPI specification served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*\"openapi\"\\s*:\\s*\"3\\.)(?=[\\s\\S]*\"paths\")"
    }
  },
  "scope": "One response whose body is an OpenAPI 3 document with a paths object.",
  "limitations": "One response body. The rule reports the description document; it does not call the routes it lists and cannot show which of them authorize correctly.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Shop API\",\"version\":\"1.0.0\"},\"paths\":{\"/admin/users\":{\"get\":{\"responses\":{\"200\":{\"description\":\"ok\"}}}},\"/internal/config\":{\"get\":{}}}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"openapi\":\"3.1.0\",\"info\":{\"title\":\"Internal\",\"version\":\"2\"},\"paths\":{\"/v2/tenants\":{\"post\":{}},\"/v2/tenants/{id}/keys\":{\"get\":{}}}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{0.3\",\"info\":{\"title\":\"Shop API\",\"version\":\"1.0.0\"},:{\"/admin/users\":{\"get\":{\"responses\":{\"200\":{\"description\":\"ok\"}}}},\"/internal/config\":{\"get\":{}}}}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "An API that deliberately publishes its description is still reported; the finding is that internal operations are listed, which the reviewer must confirm.",
  "linkedRules": [
    "DPK-DAST-238"
  ],
  "origin": "original-authored",
  "cell": "dast:body-openapi-spec:openapi-spec",
  "validationStatus": "VALIDATED"
}
