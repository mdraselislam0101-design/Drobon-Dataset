{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1208",
  "title": "Signal: Apache Tomcat error report disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Apache Tomcat/)(?=[\\s\\S]*Exception Report)"
    }
  },
  "scope": "One response whose body contains the Tomcat version banner and an Exception Report heading.",
  "limitations": "Two body markers. The version banner alone is reported by the server-banner rule; this rule requires the exception report section too.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/boom",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<h1>HTTP Status 500 - Internal Server Error</h1><hr><p><b>type</b> Exception report</p><p><b>message</b> boom</p><address>Apache Tomcat/9.0.82</address>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api/boom",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "Exception Report<br>java.lang.IllegalStateException at com.example.Api.handle(Api.java:41)<br>Apache Tomcat/10.1.18"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>Home</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/boom",
        "status": 500,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"status\":500,\"error\":\"Internal Server Error\"}"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that documents the Tomcat error format is reported only if it reproduces both markers as content.",
  "linkedRules": [
    "DPK-DAST-139"
  ],
  "origin": "original-authored",
  "cell": "dast:body-tomcat-error-report:body-tomcat-error-report",
  "validationStatus": "VALIDATED"
}
