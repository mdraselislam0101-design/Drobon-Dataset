{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0332",
  "title": "Signal: Weak SSH daemon setting (hostkey) — review required",
  "targets": [
    "sshd"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:StrictHostKeyChecking\\s+no)"
  },
  "scope": "Single-line lexical match on sshd settings (hostkey).",
  "limitations": "Lexical, line-based: matches the setting regardless of network exposure.",
  "examples": [
    {
      "line": "StrictHostKeyChecking no",
      "match": true
    },
    {
      "line": "# audit: StrictHostKeyChecking no present",
      "match": true
    },
    {
      "line": "StrictHostKeyChecking yes",
      "match": false
    },
    {
      "line": "# verified: StrictHostKeyChecking yes",
      "match": false
    }
  ],
  "fpNotes": "Isolated lab hosts are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-293"
  ],
  "origin": "original-authored",
  "cell": "sast:ssh-strict:sshd:hostkey",
  "validationStatus": "VALIDATED"
}
