{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0339",
  "title": "Signal: Server-side fetch of assembled URL (swift) — review required",
  "targets": [
    "swift"
  ],
  "signal": {
    "kind": "regex",
    "source": "URL\\s*\\(\\s*string\\s*:[^)]*\\+"
  },
  "scope": "Single-line lexical match on assembled fetch URLs in swift code.",
  "limitations": "Lexical, line-based: any assembled fetch URL matches.",
  "examples": [
    {
      "line": "URL(string: base + p)",
      "match": true
    },
    {
      "line": "# audit: URL(string: base + p) present",
      "match": true
    },
    {
      "line": "URL(string: FIXED)",
      "match": false
    },
    {
      "line": "# verified: URL(string: FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-300"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-langs:swift",
  "validationStatus": "VALIDATED"
}
