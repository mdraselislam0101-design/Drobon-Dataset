{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0848",
  "title": "Signal: Unescaped output (expr) — review required",
  "targets": [
    "asp"
  ],
  "signal": {
    "kind": "regex",
    "source": "<%="
  },
  "scope": "Single-line lexical match on unescaped output (expr).",
  "limitations": "Lexical, line-based: matches the output regardless of value trust.",
  "examples": [
    {
      "line": "<%= q %>",
      "match": true
    },
    {
      "line": "# audit: <%= q %> present",
      "match": true
    },
    {
      "line": "<%: q %>",
      "match": false
    },
    {
      "line": "# verified: <%: q %>",
      "match": false
    }
  ],
  "fpNotes": "Trusted constants are the common false positive.",
  "linkedRules": [
    "DPK-SAST-731"
  ],
  "origin": "original-authored",
  "cell": "sast:xss-flag-3:asp:expr",
