{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0367",
  "title": "Signal: Risky Terraform setting (ebsenc) — review required",
  "targets": [
    "terraform"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:encrypted\\s*=\\s*false)"
  },
  "scope": "Single-line lexical match on risky Terraform settings (ebsenc).",
  "limitations": "Lexical, line-based: matches the setting regardless of account scope.",
  "examples": [
    {
      "line": "encrypted = false",
      "match": true
    },
    {
      "line": "# audit: encrypted = false present",
      "match": true
    },
    {
      "line": "encrypted = true",
      "match": false
    },
    {
      "line": "# verified: encrypted = true",
      "match": false
    }
  ],
  "fpNotes": "Sandbox accounts are the common false positive — confirm account scope.",
  "linkedRules": [
    "DPK-SAST-328"
  ],
  "origin": "original-authored",
  "cell": "sast:terraform-strict:hcl:ebsenc",
  "validationStatus": "VALIDATED"
}
