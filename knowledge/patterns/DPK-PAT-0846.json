      "line": "preEscapedToHtml(payload)",
      "match": true
    },
    {
      "line": "out = preEscapedToHtml(data)",
      "match": true
    },
    {
      "line": "mypreEscapedToHtml(x)",
      "match": false
    },
    {
      "line": "preEscapedToHtml_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted markup is the common false positive.",
