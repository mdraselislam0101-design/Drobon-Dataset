{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2144",
  "title": "Signal: Dependency installed from a git checkout",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^git\\+https://"
    }
  },
  "scope": "A package.json file that declares a dependency installed from a git remote rather than the registry.",
  "limitations": "It matches a dependency installed from a git remote rather than the registry in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "git+https://github.com/acme/sdk.git#v4.2.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "git+https://github.com/acme/cli.git"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "https://registry.npmjs.org/acme-sdk/-/acme-sdk-4.2.0.tgz"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A git dependency whose commit is pinned and whose build verifies the checkout is still reported: the rule names the source kind, not its safety.",
  "linkedRules": [
    "DPK-SCA-0007"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-git-plus-https",
  "validationStatus": "VALIDATED"
}
