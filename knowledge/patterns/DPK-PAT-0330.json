{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0330",
  "title": "Signal: SQL built by concatenation (vba) — review required",
  "targets": [
    "vba"
  ],
  "signal": {
    "kind": "regex",
    "source": "OpenRecordset\\s*\\([^)]*&"
  },
  "scope": "Single-line lexical match on assembled SQL in vba code.",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "OpenRecordset(\"SELECT \" & q)",
      "match": true
    },
    {
      "line": "# audit: OpenRecordset(\"SELECT \" & q) present",
      "match": true
    },
    {
      "line": "OpenRecordset(FIXED)",
      "match": false
    },
    {
      "line": "# verified: OpenRecordset(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-291"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-langs:vba",
  "validationStatus": "VALIDATED"
}
