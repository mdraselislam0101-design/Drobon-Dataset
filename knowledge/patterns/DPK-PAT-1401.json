{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1401",
  "title": "Signal: Anchor opens a new tab without rel=noopener",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<a\\b(?![^>]{0,400}noopener)(?![^>]{0,400}noreferrer)[^>]{0,300}target\\s*=\\s*[\"']_blank[\"']"
    }
  },
  "scope": "One anchor element carrying target=\"_blank\" whose rel attribute is absent or lacks noopener and noreferrer.",
  "limitations": "One response body. The check reads static markup; anchors created by script at runtime are invisible, and a rel value added by a framework helper is only seen if it is rendered into the HTML.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/help",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<a href=\"https://docs.vendor.example\" target=\"_blank\">Vendor docs</a>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/help",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<a target='_blank' rel='nofollow' href='/terms'>Terms</a>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/help",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<a href=\"https://docs.vendor.example\" target=\"_blank\" rel=\"noopener noreferrer\">Vendor docs</a>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/help",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<a href=\"/terms\">Terms</a>"
      },
      "match": false
    }
  ],
  "fpNotes": "An anchor whose rel contains noopener or noreferrer is not reported. Modern browsers imply noopener for target=\"_blank\", so the finding is hardening, not an exploitable state — the rule says so in its own text.",
  "linkedRules": [
    "DPK-DAST-332"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-target-blank-noopener:blank-no-noopener",
  "validationStatus": "VALIDATED"
}
