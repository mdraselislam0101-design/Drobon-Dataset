{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0384",
  "title": "Signal: TLS verification disabled (erlang) — review required",
  "targets": [
    "erlang"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:verify\\s*,\\s*verify_none)"
  },
  "scope": "Single-line lexical match on TLS-disabling settings in erlang code.",
  "limitations": "Lexical, line-based: matches the switch regardless of environment.",
  "examples": [
    {
      "line": "{verify, verify_none}",
      "match": true
    },
    {
      "line": "# audit: {verify, verify_none} present",
      "match": true
    },
    {
      "line": "{verify, verify_peer}",
      "match": false
    },
    {
      "line": "# verified: {verify, verify_peer}",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive.",
  "linkedRules": [
    "DPK-SAST-345"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-langs:erlang",
  "validationStatus": "VALIDATED"
}
