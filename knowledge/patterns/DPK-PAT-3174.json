{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3174",
  "title": "Signal: Possible a Cloudinary API credential in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "cloudinary://[0-9]{15}:[A-Za-z0-9_-]{27}"
  },
  "scope": "Single-line shape match for a Cloudinary API credential.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "url = \"cloudinary://123456789012345:AAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: url = \"cloudinary://123456789012345:AAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "url = \"xy\"",
      "match": false
    },
    {
      "line": "url = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-114"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-4:cloudinary-credential-url",
  "validationStatus": "VALIDATED"
}
