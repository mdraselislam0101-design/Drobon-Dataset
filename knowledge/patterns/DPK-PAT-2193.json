{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2193",
  "title": "Signal: Lockfile records an optional dependency that fetches at install time",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.optional",
      "valuePattern": "^true$"
    }
  },
  "scope": "A package-lock.json file that declares a package entry marked optional, which npm may fetch from the network during install.",
  "limitations": "It matches a package entry marked optional, which npm may fetch from the network during install in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "optional": true
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "optional": true,
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "optional": false
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "An optional package used for platform binaries is still reported; record the accepted exception and its integrity policy.",
  "linkedRules": [
    "DPK-SCA-0056"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-optional-dependency",
  "validationStatus": "VALIDATED"
}
