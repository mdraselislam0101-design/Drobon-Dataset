{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0807",
  "title": "Signal: SQL built by concatenation (tcl) — review required",
  "targets": [
    "tcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:db\\s+eval\\s+[^\\n]*\\$[a-zA-Z_])"
  },
  "scope": "Single-line lexical match on assembled SQL in tcl code.",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "db eval \"SELECT $q\"",
      "match": true
    },
    {
      "line": "# audit: db eval \"SELECT $q\" present",
      "match": true
    },
    {
      "line": "db eval {SELECT 1}",
      "match": false
    },
    {
      "line": "# verified: db eval {SELECT 1}",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-690"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-4:tcl",
  "validationStatus": "VALIDATED"
}
