{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1462",
  "title": "Signal: Apache Flink dashboard is reachable without authentication",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<title>[^<]{0,80}Flink"
    }
  },
  "scope": "One response body containing the Flink dashboard shell.",
  "limitations": "One response body. The rule reports the dashboard shell; it does not submit a job.",
  "examples": [
    {
      "observation": {
        "url": "https://flink.example:8081/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Apache Flink Dashboard</title></head><body><h1>Flink Dashboard</h1><p>Available Task Managers: 3</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://flink.example:8081/#/overview",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Flink Dashboard</title></head><body><p>Running Jobs 2 · flink-1.18</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Streaming guide</title></head><body><p>The dashboard is served on port 8081.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/stream",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Stream</title></head><body><p>Streaming is healthy.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that names Flink in prose is not reported, because the dashboard marker is required.",
  "linkedRules": [
    "DPK-DAST-393"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-console-flink-dashboard:flink-dashboard",
  "validationStatus": "VALIDATED"
}
