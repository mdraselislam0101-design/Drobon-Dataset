{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2328",
  "title": "Signal: Cargo dependency resolved from a local path",
  "targets": [
    "cargo"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*.path",
      "valuePattern": "^(?:\\.{1,2}/|/)"
    }
  },
  "scope": "A Cargo.toml file that declares a dependency that points at a directory on the build machine.",
  "limitations": "It matches a dependency that points at a directory on the build machine in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_shared": {
            "path": "../acme-shared"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_lib": {
            "path": "/opt/vendor/acme-lib"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_shared": {
            "version": "1.2.0"
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_lib": {
            "version": "2.0.1"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Cargo.toml that mentions a dependency that points at a directory on the build machine in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0191"
  ],
  "origin": "original-authored",
  "cell": "sca:cargo-dependency-path",
  "validationStatus": "VALIDATED"
}
