{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1328",
  "title": "Signal: Obsolete X-XSS-Protection auditor enabled",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-XSS-Protection",
      "valuePattern": "^\\s*1\\s*$|^\\s*1\\s*;\\s*mode\\s*=\\s*block\\s*$"
    }
  },
  "scope": "One response whose X-XSS-Protection value enables the auditor.",
  "limitations": "One header value. The rule reports the enabling value; it does not evaluate whether a legacy engine is in use and cannot show the auditor acting on a page.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-XSS-Protection": "1"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-XSS-Protection": "1; mode=block"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-XSS-Protection": "0"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A value of 0 is not reported; it is the recommended setting.",
  "linkedRules": [
    "DPK-DAST-259"
  ],
  "origin": "original-authored",
  "cell": "dast:x-xss-protection-enabled:xss-protection-enabled",
  "validationStatus": "VALIDATED"
}
