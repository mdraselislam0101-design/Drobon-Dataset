{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2368",
  "title": "Signal: Podfile.lock spec without a checksum",
  "targets": [
    "cocoapods"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "pods",
      "field": "checksum"
    }
  },
  "scope": "A Podfile.lock file that declares a locked pod that records no checksum.",
  "limitations": "It matches a locked pod that records no checksum in the parsed Podfile.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Podfile.lock",
      "document": {
        "pods": [
          {
            "name": "Alamofire",
            "version": "5.9.1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile.lock",
      "document": {
        "pods": [
          {
            "name": "SnapKit",
            "version": "5.7.1"
          },
          {
            "name": "Alamofire",
            "version": "5.9.1",
            "checksum": "aaaa"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile.lock",
      "document": {
        "pods": [
          {
            "name": "Alamofire",
            "version": "5.9.1",
            "checksum": "aaaabbbb"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Podfile.lock",
      "document": {
        "pods": [
          {
            "name": "SnapKit",
            "version": "5.7.1",
            "checksum": "ccccdddd"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Podfile.lock that mentions a locked pod that records no checksum in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0231"
  ],
  "origin": "original-authored",
  "cell": "sca:podlock-checksum-absent",
  "validationStatus": "VALIDATED"
}
