{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1238",
  "title": "Signal: JFrog Artifactory interface disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*artifactory)(?=[\\s\\S]*JFrog)"
    }
  },
  "scope": "One response whose body contains both the artifactory bundle and the JFrog attribution.",
  "limitations": "One response body. The rule reports the Artifactory shell; it does not list a repository or download an artefact.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Artifactory</title></head><body><script src=\"/ui/artifactory.js\"></script><span>JFrog</span></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div id=\"artifactory-app\"></div><footer>JFrog Artifactory</footer></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><script src=\"/ui/.js\"></script><span></span></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published repository is still reported; the finding is reachability.",
  "linkedRules": [
    "DPK-DAST-169"
  ],
  "origin": "original-authored",
  "cell": "dast:body-jfrog-artifactory:jfrog-artifactory",
  "validationStatus": "VALIDATED"
}
