{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0914",
  "title": "Signal: delegatecall to a variable target (solidity) — review required",
  "targets": [
    "solidity"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.delegatecall\\s*\\("
  },
  "scope": "Single-line lexical match on delegatecall in solidity code.",
  "limitations": "Lexical, line-based: every delegatecall matches, including fixed proxy targets.",
  "examples": [
    {
      "line": "(bool ok, ) = target.delegatecall(data);",
      "match": true
    },
    {
      "line": "# audit: (bool ok, ) = target.delegatecall(data); present",
      "match": true
    },
    {
      "line": "(bool ok, ) = target.call(data);",
      "match": false
    },
    {
      "line": "# verified: (bool ok, ) = target.call(data);",
      "match": false
    }
  ],
  "fpNotes": "Fixed library or proxy implementations are the common false positive.",
  "linkedRules": [
    "DPK-SAST-758"
  ],
  "origin": "original-authored",
  "cell": "sast:delegatecall-untrusted:solidity",
  "validationStatus": "VALIDATED"
}
