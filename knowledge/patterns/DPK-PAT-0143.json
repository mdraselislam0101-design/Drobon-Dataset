{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0143",
  "title": "Signal: Overly broad file permissions (c) — review required",
  "targets": [
    "c"
  ],
  "signal": {
    "kind": "regex",
    "source": "[^0-9A-Za-z]0777"
  },
  "scope": "Single-line lexical match on broad permission grants in c code or scripts.",
  "limitations": "Lexical, line-based: matches the mode regardless of file sensitivity.",
  "examples": [
    {
      "line": "fd = open(p, O_CREAT, 0777)",
      "match": true
    },
    {
      "line": "# audit: fd = open(p, O_CREAT, 0777) present",
      "match": true
    },
    {
      "line": "fd = open(p, O_CREAT, 0644)",
      "match": false
    },
    {
      "line": "# verified: fd = open(p, O_CREAT, 0644)",
      "match": false
    }
  ],
  "fpNotes": "Intentionally public data files are the common false positive.",
  "linkedRules": [
    "DPK-SAST-104"
  ],
  "origin": "original-authored",
  "cell": "sast:file-chmod-open:c",
  "validationStatus": "VALIDATED"
}
