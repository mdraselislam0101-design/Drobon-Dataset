{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0841",
  "title": "Signal: Umask cleared to zero (go) — review required",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "regex",
    "source": "syscall\\.Umask\\s*\\(\\s*0\\b"
  },
  "scope": "Single-line lexical match on umask clearing in go code.",
  "limitations": "Lexical, line-based: matches the clearing.",
  "examples": [
    {
      "line": "syscall.Umask(0)",
      "match": true
    },
    {
      "line": "# audit: syscall.Umask(0) present",
      "match": true
    },
    {
      "line": "syscall.Umask(022)",
      "match": false
    },
    {
      "line": "# verified: syscall.Umask(022)",
      "match": false
    }
  ],
  "fpNotes": "Brief scoped clearing is the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-724"
  ],
  "origin": "original-authored",
  "cell": "sast:umask-zero:go",
  "validationStatus": "VALIDATED"
}
