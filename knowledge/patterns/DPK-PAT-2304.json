{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2304",
  "title": "Signal: Maven mirror configured over cleartext",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "settings.mirrors[].url",
      "valuePattern": "^http://"
    }
  },
  "scope": "A settings.xml file that declares a mirror URL that uses cleartext http.",
  "limitations": "It matches a mirror URL that uses cleartext http in the parsed settings.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "acme",
              "mirrorOf": "central",
              "url": "http://repo.acme.example/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "mirror",
              "mirrorOf": "*",
              "url": "http://10.24.8.9/maven2"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "acme",
              "mirrorOf": "central",
              "url": "https://repo.acme.example/maven2"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "mirrors": [
            {
              "id": "corp",
              "mirrorOf": "central",
              "url": "https://nexus.acme.example/repository/maven-public"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A settings.xml that mentions a mirror URL that uses cleartext http in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0167"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-settings-mirror-cleartext",
  "validationStatus": "VALIDATED"
}
