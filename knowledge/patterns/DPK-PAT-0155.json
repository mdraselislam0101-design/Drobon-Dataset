{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0155",
  "title": "Signal: Framework SQL built from input (nhib) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:CreateQuery\\s*\\([^)]*(?:\\+|\\$))"
  },
  "scope": "Single-line lexical match on assembled SQL (nhib).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "CreateQuery(\"FROM \" + q)",
      "match": true
    },
    {
      "line": "# audit: CreateQuery(\"FROM \" + q) present",
      "match": true
    },
    {
      "line": "CreateQuery(FIXED)",
      "match": false
    },
    {
      "line": "# verified: CreateQuery(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-116"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli-extra:csharp:nhib",
  "validationStatus": "VALIDATED"
}
