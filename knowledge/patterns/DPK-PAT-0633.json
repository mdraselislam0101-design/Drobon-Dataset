{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0633",
  "title": "Signal: Risky Express setting (trustproxy) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "app\\.set\\s*\\(\\s*[\"']trust proxy[\"']"
  },
  "scope": "Single-line lexical match on Express config.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "app.set(\"trust proxy\", true)",
      "match": true
    },
    {
      "line": "# audit: app.set(\"trust proxy\", true) present",
      "match": true
    },
    {
      "line": "app.set(\"port\", 3000)",
      "match": false
    },
    {
      "line": "# verified: app.set(\"port\", 3000)",
      "match": false
    }
  ],
  "fpNotes": "Internal apps are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-516"
  ],
  "origin": "original-authored",
  "cell": "sast:express-risk:javascript:trustproxy",
  "validationStatus": "VALIDATED"
}
