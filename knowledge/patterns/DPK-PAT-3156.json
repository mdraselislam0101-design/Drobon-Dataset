{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3156",
  "title": "Signal: Target-specific dependency declared as a wildcard",
  "targets": [
    "cargo"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "target.*.dependencies.*.version",
      "valuePattern": "^\\*$"
    }
  },
  "scope": "A Cargo.toml file that declares a `*` version under a `[target.*.dependencies]` table.",
  "limitations": "It matches a `*` version under a `[target.*.dependencies]` table in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "target": {
          "cfg(unix)": {
            "dependencies": {
              "nix": {
                "version": "*"
              }
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "target": {
          "cfg(windows)": {
            "dependencies": {
              "winapi": {
                "version": "*"
              }
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "target": {
          "cfg(unix)": {
            "dependencies": {
              "nix": {
                "version": "0.29.0"
              }
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        },
        "target": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A Cargo.toml that mentions a `*` version under a `[target.*.dependencies]` table in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1019"
  ],
  "origin": "original-authored",
  "cell": "sca:cargo-target-dependency-wildcard",
  "validationStatus": "VALIDATED"
}
