{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0055",
  "title": "Signal: Weak X-Frame-Options (ALLOW-FROM) header value",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-Frame-Options",
      "valuePattern": "ALLOW-FROM"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Value check: it cannot confirm the deployment context.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Frame-Options": "ALLOW-FROM https://a.example/"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Frame-Options": "ALLOW-FROM https://b.example/"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Frame-Options": "DENY"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "Transitional deployments are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-025"
  ],
  "origin": "original-authored",
  "cell": "dast:header-weak:xfo-allowfrom",
  "validationStatus": "VALIDATED"
}
