{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3181",
  "title": "Signal: Possible a GitLab OAuth application secret in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "gloas-[A-Za-z0-9]{64,}"
  },
  "scope": "Single-line shape match for a GitLab OAuth application secret.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "secret = \"gloas-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: secret = \"gloas-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "secret = \"xy\"",
      "match": false
    },
    {
      "line": "secret = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-121"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-4:gitlab-oauth-application-secret",
  "validationStatus": "VALIDATED"
}
