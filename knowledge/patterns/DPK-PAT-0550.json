{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0550",
  "title": "Signal: SQL built by concatenation (perl) — review required",
  "targets": [
    "perl"
  ],
  "signal": {
    "kind": "regex",
    "source": "->do\\s*\\((?:[^()]|\\([^()]*\\))*(?:\\\"[^\\\"\\n]*\\$|\\.\\s*\\$)"
  },
  "scope": "Single-line lexical match on concatenated SQL in perl code.",
  "limitations": "Lexical, line-based: any concatenated query matches, including trusted assembly. Input trust needs human review.",
  "examples": [
    {
      "line": "$dbh->do(\"SELECT $q\")",
      "match": true
    },
    {
      "line": "# audit: $dbh->do(\"SELECT $q\") present",
      "match": true
    },
    {
      "line": "$dbh->do($fixed)",
      "match": false
    },
    {
      "line": "# verified: $dbh->do($fixed)",
      "match": false
    },
    {
      "line": "$dbh->do(build_sql($name) . $tail);",
      "match": true
    },
    {
      "line": "$dbh->do($fixed);",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed column lists or trusted fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-453"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-concat:perl",
  "validationStatus": "VALIDATED"
}
