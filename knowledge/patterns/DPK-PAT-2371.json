{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2371",
  "title": "Signal: renv lockfile entry without a hash",
  "targets": [
    "cran"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "Packages",
      "field": "Hash"
    }
  },
  "scope": "A renv.lock file that declares a locked R package that records no `Hash`.",
  "limitations": "It matches a locked R package that records no `Hash` in the parsed renv.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1"
        },
        "Packages": {
          "dplyr": {
            "Package": "dplyr",
            "Version": "1.1.4"
          }
        }
      },
      "match": true
    },
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1"
        },
        "Packages": {
          "ggplot2": {
            "Package": "ggplot2",
            "Version": "3.5.1"
          },
          "dplyr": {
            "Package": "dplyr",
            "Version": "1.1.4",
            "Hash": "aaaa"
          }
        }
      },
      "match": true
    },
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1"
        },
        "Packages": {
          "dplyr": {
            "Package": "dplyr",
            "Version": "1.1.4",
            "Hash": "aaaa"
          }
        }
      },
      "match": false
    },
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1"
        },
        "Packages": {
          "ggplot2": {
            "Package": "ggplot2",
            "Version": "3.5.1",
            "Hash": "bbbb"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A renv.lock that mentions a locked R package that records no `Hash` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0234"
  ],
  "origin": "original-authored",
  "cell": "sca:renv-hash-absent",
  "validationStatus": "VALIDATED"
}
