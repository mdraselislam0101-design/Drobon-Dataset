{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1351",
  "title": "Signal: Content-Security-Policy frame-ancestors allows a plaintext HTTP parent",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "(?:^|;)\\s*frame-ancestors\\s[^;]*(?<=\\s)http:(?=[\\s;/]|$)"
    }
  },
  "scope": "One Content-Security-Policy value whose frame-ancestors directive contains an http: source.",
  "limitations": "One header value and one directive. The check reads scheme sources in frame-ancestors only; it cannot see whether the named parent is reachable over TLS, and it does not evaluate clickjacking beyond the framing permission.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; frame-ancestors http://legacy.example"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors http:"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors https://partner.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "connect-src http://api.example"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A staging parent that only exists over HTTP is reported; the finding is the permitted plaintext parent, and the owner may record it as accepted for an isolated environment.",
  "linkedRules": [
    "DPK-DAST-282"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-csp-frame-ancestors-http:frame-ancestors-http",
  "validationStatus": "VALIDATED"
}
