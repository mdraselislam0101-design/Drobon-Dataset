{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3150",
  "title": "Signal: Project dependency pulls a named extra",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.dependencies[]",
      "valuePattern": "\\[\\s*[a-z-]+"
    }
  },
  "scope": "A pyproject.toml file that declares a requirement with an `[extra]` selector.",
  "limitations": "It matches a requirement with an `[extra]` selector in the parsed pyproject.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "acme-sdk[dev]==4.2.0"
          ],
          "license": {
            "text": "MIT"
          }
        },
        "build-system": {
          "requires": [
            "setuptools==75.1.0"
          ],
          "build-backend": "setuptools.build_meta"
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "acme-core[security]==1.4.2"
          ],
          "license": {
            "text": "MIT"
          }
        },
        "build-system": {
          "requires": [
            "setuptools==75.1.0"
          ],
          "build-backend": "setuptools.build_meta"
        }
      },
      "match": true
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "acme-sdk==4.2.0"
          ],
          "license": {
            "text": "MIT"
          }
        },
        "build-system": {
          "requires": [
            "setuptools==75.1.0"
          ],
          "build-backend": "setuptools.build_meta"
        }
      },
      "match": false
    },
    {
      "file": "pyproject.toml",
      "document": {
        "project": {
          "name": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            "requests==2.32.3"
          ],
          "license": {
            "text": "MIT"
          }
        },
        "build-system": {
          "requires": [
            "setuptools==75.1.0"
          ],
          "build-backend": "setuptools.build_meta"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pyproject.toml that mentions a requirement with an `[extra]` selector in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1013"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-project-extra-in-dependency",
  "validationStatus": "VALIDATED"
}
