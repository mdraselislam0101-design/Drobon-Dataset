{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0202",
  "title": "Signal: Sensitive value in log call (rust) — review required",
  "targets": [
    "rust"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:info!\\s*\\([^)]*(?:password|passwd|secret|token))"
  },
  "scope": "Single-line lexical match on credential-named log values in rust code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "info!(\"token={}\", t)",
      "match": true
    },
    {
      "line": "# audit: info!(\"token={}\", t) present",
      "match": true
    },
    {
      "line": "info!(\"user={}\", u)",
      "match": false
    },
    {
      "line": "# verified: info!(\"user={}\", u)",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-163"
  ],
  "origin": "original-authored",
  "cell": "sast:log-langs:rust",
  "validationStatus": "VALIDATED"
}
