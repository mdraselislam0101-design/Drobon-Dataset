{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2306",
  "title": "Signal: Maven server password stored in settings.xml",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "settings.servers[].password",
      "valuePattern": "^[A-Za-z0-9!@#$%^&*._-]{8,40}$"
    }
  },
  "scope": "A settings.xml file that declares a repository password written directly into the checked-in Maven settings.",
  "limitations": "It matches a repository password written directly into the checked-in Maven settings in the parsed settings.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "servers": [
            {
              "id": "acme-releases",
              "username": "ci",
              "password": "EXAMPLESECRETPASSWORD01"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "servers": [
            {
              "id": "acme-snapshots",
              "username": "ci",
              "password": "EXAMPLESECONDPASSWORD1234"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "servers": [
            {
              "id": "acme-releases",
              "username": "ci",
              "password": "${env.MAVEN_PASSWORD}"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "settings.xml",
      "document": {
        "settings": {
          "servers": [
            {
              "id": "acme-releases",
              "username": "ci"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A settings.xml that mentions a repository password written directly into the checked-in Maven settings in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0169"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-settings-password-inline",
  "validationStatus": "VALIDATED"
}
