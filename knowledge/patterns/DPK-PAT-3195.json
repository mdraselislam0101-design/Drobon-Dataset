{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3195",
  "title": "Signal: Possible a Microsoft Teams incoming-webhook URL in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "https://[A-Za-z0-9.-]+\\.webhook\\.office\\.com/webhookb2/[A-Za-z0-9@-]+/IncomingWebhook/[A-Za-z0-9]+/[A-Za-z0-9-]+"
  },
  "scope": "Single-line shape match for a Microsoft Teams incoming-webhook URL.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "url = \"https://acme.webhook.office.com/webhookb2/abcdef@12345678/IncomingWebhook/1234567890/abcdef-1234\"",
      "match": true
    },
    {
      "line": "# audit: url = \"https://acme.webhook.office.com/webhookb2/abcdef@12345678/IncomingWebhook/1234567890/abcdef-1234\" present",
      "match": true
    },
    {
      "line": "url = \"xy\"",
      "match": false
    },
    {
      "line": "url = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-135"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-4:teams-incoming-webhook",
  "validationStatus": "VALIDATED"
}
