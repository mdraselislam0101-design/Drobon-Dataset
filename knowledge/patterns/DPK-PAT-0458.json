{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0458",
  "title": "Signal: Unescaped template output (thymeleaf, html) — review required",
  "targets": [
    "html"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:th:utext)"
  },
  "scope": "Single-line lexical match on unescaped output in thymeleaf templates.",
  "limitations": "Lexical, line-based: matches the construct regardless of value trust.",
  "examples": [
    {
      "line": "<div th:utext=\"${q}\">",
      "match": true
    },
    {
      "line": "# audit: <div th:utext=\"${q}\"> present",
      "match": true
    },
    {
      "line": "<div th:text=\"${q}\">",
      "match": false
    },
    {
      "line": "# verified: <div th:text=\"${q}\">",
      "match": false
    }
  ],
  "fpNotes": "Trusted constant markup is the common false positive.",
  "linkedRules": [
    "DPK-SAST-419"
  ],
  "origin": "original-authored",
  "cell": "sast:xss-templates:html:thymeleaf",
  "validationStatus": "VALIDATED"
}
