{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2820",
  "title": "Signal: Transitive versions escape central management",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.propertyGroup.CentralPackageTransitivePinningEnabled",
      "valuePattern": "^false$"
    }
  },
  "scope": "A Directory.Packages.props file that declares a central-package-management build that does not pin transitive versions.",
  "limitations": "It matches a central-package-management build that does not pin transitive versions in the parsed Directory.Packages.props; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          },
          "propertyGroup": {
            "CentralPackageTransitivePinningEnabled": "false"
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          },
          "propertyGroup": {
            "CentralPackageTransitivePinningEnabled": false
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          },
          "propertyGroup": {
            "CentralPackageTransitivePinningEnabled": "true"
          }
        }
      },
      "match": false
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          },
          "propertyGroup": {
            "CentralPackageTransitivePinningEnabled": true
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Directory.Packages.props that mentions a central-package-management build that does not pin transitive versions in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0683"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-transitive-pinning-disabled",
  "validationStatus": "VALIDATED"
}
