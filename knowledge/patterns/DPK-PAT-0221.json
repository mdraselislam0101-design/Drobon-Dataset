{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0221",
  "title": "Signal: MD5 use via Digest.string (ocaml) — review required",
  "targets": [
    "ocaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Digest\\.(?:string|file))\\s*\\("
  },
  "scope": "Single-line lexical match on the Digest.string call in ocaml code.",
  "limitations": "Lexical, line-based: matches any Digest.string call.",
  "examples": [
    {
      "line": "Digest.string(payload)",
      "match": true
    },
    {
      "line": "out = Digest.string(data)",
      "match": true
    },
    {
      "line": "myDigeststring(x)",
      "match": false
    },
    {
      "line": "Digest.string_safe()",
      "match": false
    }
  ],
  "fpNotes": "Checksums are the common false positive.",
  "linkedRules": [
    "DPK-SAST-182"
  ],
  "origin": "original-authored",
  "cell": "sast:md5-call-extra:ocaml",
  "validationStatus": "VALIDATED"
}
