{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2285",
  "title": "Signal: Go dependency pinned to a pseudo-version",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "require[].version",
      "valuePattern": "^v\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}-(?:0\\.)?\\d{14}-[0-9a-f]{12}$"
    }
  },
  "scope": "A go.mod file that declares a pseudo-version, which names a commit that carries no release tag.",
  "limitations": "It matches a pseudo-version, which names a commit that carries no release tag in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v0.0.0-20240612120000-9f2c4a1b7c3d"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/cli",
            "version": "v1.4.2-0.20240101000000-0a1b2c3d4e5f"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0"
          }
        ]
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/cli",
            "version": "v2.1.0"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A go.mod that mentions a pseudo-version, which names a commit that carries no release tag in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0148"
  ],
  "origin": "original-authored",
  "cell": "sca:go-require-pseudo-version",
  "validationStatus": "VALIDATED"
}
