{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1222",
  "title": "Signal: Content-Security-Policy strict-dynamic without a nonce or hash",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "^(?=[\\s\\S]*?(?:^|;)\\s*script-src\\s[^;]*'strict-dynamic')(?![\\s\\S]*'nonce-)(?![\\s\\S]*'sha256-)(?![\\s\\S]*'sha384-)(?![\\s\\S]*'sha512-)"
    }
  },
  "scope": "One response whose Content-Security-Policy script-src directive contains 'strict-dynamic' and no nonce or hash source.",
  "limitations": "One header value. The rule reports the keyword combination the policy states; it does not test browser behaviour and cannot see whether the application intended a nonce that failed to render.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'strict-dynamic'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self' 'strict-dynamic'; object-src 'none'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'nonce-r4nd0m' 'strict-dynamic'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'sha256-abc=' 'strict-dynamic'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A policy staged for a browser-support rollout may carry strict-dynamic before the nonce wiring lands; the combination is still the reportable fact.",
  "linkedRules": [
    "DPK-DAST-153"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-strict-dynamic-without-nonce:no-nonce",
  "validationStatus": "VALIDATED"
}
