{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0462",
  "title": "Signal: Unescaped template output (expr) — review required",
  "targets": [
    "jsp"
  ],
  "signal": {
    "kind": "regex",
    "source": "<%="
  },
  "scope": "Single-line lexical match on unescaped output in expr templates.",
  "limitations": "Lexical, line-based: matches the construct regardless of value trust.",
  "examples": [
    {
      "line": "<%= q %>",
      "match": true
    },
    {
      "line": "# audit: <%= q %> present",
      "match": true
    },
    {
      "line": "<c:out value=\"${q}\" />",
      "match": false
    },
    {
      "line": "# verified: <c:out value=\"${q}\" />",
      "match": false
    }
  ],
  "fpNotes": "Trusted constant markup is the common false positive.",
  "linkedRules": [
    "DPK-SAST-423"
  ],
  "origin": "original-authored",
  "cell": "sast:xss-templates:jsp:expr",
  "validationStatus": "VALIDATED"
}
