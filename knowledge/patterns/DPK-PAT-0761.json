{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0761",
  "title": "Signal: Cleartext protocol client (ftp) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:ftplib\\.FTP\\s*\\()"
  },
  "scope": "Single-line lexical match on cleartext clients (ftp).",
  "limitations": "Lexical, line-based: matches the client.",
  "examples": [
    {
      "line": "ftplib.FTP(h)",
      "match": true
    },
    {
      "line": "# audit: ftplib.FTP(h) present",
      "match": true
    },
    {
      "line": "ftplib.FTP_TLS(h)",
      "match": false
    },
    {
      "line": "# verified: ftplib.FTP_TLS(h)",
      "match": false
    }
  ],
  "fpNotes": "Loopback use is the common accepted case.",
  "linkedRules": [
    "DPK-SAST-644"
  ],
  "origin": "original-authored",
  "cell": "sast:python-net-plain:python:ftp",
  "validationStatus": "VALIDATED"
}
