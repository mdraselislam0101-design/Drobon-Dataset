{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0166",
  "title": "Signal: Framework SQL built from input (eloquent) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:whereRaw\\s*\\([^)]*(?:\"[^\"\\n]*\\$|\\.\\s*\\$))"
  },
  "scope": "Single-line lexical match on assembled framework SQL (eloquent).",
  "limitations": "Lexical, line-based: any assembled query matches, including trusted ones.",
  "examples": [
    {
      "line": "whereRaw(\"a = $b\")",
      "match": true
    },
    {
      "line": "# audit: whereRaw(\"a = $b\") present",
      "match": true
    },
    {
      "line": "where($fixed)",
      "match": false
    },
    {
      "line": "# verified: where($fixed)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-127"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli:php:eloquent",
  "validationStatus": "VALIDATED"
}
