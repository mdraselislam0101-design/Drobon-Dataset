{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0561",
  "title": "Signal: Infrastructure banner disclosed (X-Redirect-By header)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-Redirect-By",
      "valuePattern": "[^ ]"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Banner check: version visibility alone is not exploitability.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Redirect-By": "WordPress"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Redirect-By": "Drupal"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Redirect-By": ""
        }
      },
      "match": false
    }
  ],
  "fpNotes": "CDN-added banners are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-036"
  ],
  "origin": "original-authored",
  "cell": "dast:banner-more:xredirectby",
  "validationStatus": "VALIDATED"
}
