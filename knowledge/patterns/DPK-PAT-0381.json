{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0381",
  "title": "Signal: TLS checks disabled (wget) — review required",
  "targets": [
    "shell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:wget\\s+[^|]*--no-check-certificate)"
  },
  "scope": "Single-line lexical match on TLS-disabling flags for wget.",
  "limitations": "Lexical, line-based: matches the flag regardless of environment.",
  "examples": [
    {
      "line": "wget --no-check-certificate https://x",
      "match": true
    },
    {
      "line": "# audit: wget --no-check-certificate https://x present",
      "match": true
    },
    {
      "line": "wget https://x",
      "match": false
    },
    {
      "line": "# verified: wget https://x",
      "match": false
    }
  ],
  "fpNotes": "Local bootstrap scripts are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-342"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-cli:shell:wget",
  "validationStatus": "VALIDATED"
}
