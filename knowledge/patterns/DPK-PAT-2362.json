{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2362",
  "title": "Signal: Swift package dependency follows a branch",
  "targets": [
    "swift"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies[].requirement.branch",
      "valuePattern": "^[A-Za-z][A-Za-z0-9._/-]{0,60}$"
    }
  },
  "scope": "A Package.swift file that declares a package dependency whose requirement is a branch.",
  "limitations": "It matches a package dependency whose requirement is a branch in the parsed Package.swift; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Package.swift",
      "document": {
        "dependencies": [
          {
            "url": "https://github.com/acme/sdk",
            "requirement": {
              "branch": "main"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "Package.swift",
      "document": {
        "dependencies": [
          {
            "url": "https://github.com/acme/cli",
            "requirement": {
              "branch": "develop"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "Package.swift",
      "document": {
        "dependencies": [
          {
            "url": "https://github.com/acme/sdk",
            "requirement": {
              "from": "4.2.0"
            }
          }
        ]
      },
      "match": false
    },
    {
      "file": "Package.swift",
      "document": {
        "dependencies": [
          {
            "url": "https://github.com/acme/cli",
            "requirement": {
              "exact": "2.1.0"
            }
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Package.swift that mentions a package dependency whose requirement is a branch in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0225"
  ],
  "origin": "original-authored",
  "cell": "sca:swift-dependency-branch",
  "validationStatus": "VALIDATED"
}
