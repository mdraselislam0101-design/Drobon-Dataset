{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1446",
  "title": "Signal: Apache server-info page served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Apache Server Information)(?=[\\s\\S]*Server Settings)"
    }
  },
  "scope": "One response body containing the Apache server-info headings.",
  "limitations": "One response body. The rule reports the handler output; it does not read the configuration files it names.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/server-info",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Apache Server Information</title></head><body><h1>Apache Server Information</h1><h2>Server Settings</h2><p>Server Version: Apache/2.4.58</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/server-info?list",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<h1>Apache Server Information</h1><h2>Server Settings</h2><h3>Loaded Modules</h3><p>mod_ssl (shared)</p>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/server-status",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Apache Server Status for app.example</h1><p>Server uptime: 4 days</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/deploy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Deployment guide</title></head><body><p>The server-info handler is disabled by default.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "The mod_status page is covered by its own rule; a page that mentions server-info in prose is not reported.",
  "linkedRules": [
    "DPK-DAST-377"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-artefact-apache-server-info:apache-server-info",
  "validationStatus": "VALIDATED"
}
