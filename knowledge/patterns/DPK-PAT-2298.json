{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2298",
  "title": "Signal: Maven dependency resolved from the local system path",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.dependencies[].scope",
      "valuePattern": "^system$"
    }
  },
  "scope": "A pom.xml file that declares a dependency with `system` scope, which reads a jar straight from the build machine.",
  "limitations": "It matches a dependency with `system` scope, which reads a jar straight from the build machine in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "legacy-driver",
              "version": "1.0.0",
              "scope": "system"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "legacy-native",
              "version": "2.1.0",
              "scope": "system"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "legacy-driver",
              "version": "1.0.0",
              "scope": "compile"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "legacy-native",
              "version": "2.1.0"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pom.xml that mentions a dependency with `system` scope, which reads a jar straight from the build machine in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0161"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-system-scope",
  "validationStatus": "VALIDATED"
}
