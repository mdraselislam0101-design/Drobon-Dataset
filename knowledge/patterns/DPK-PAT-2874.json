{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2874",
  "title": "Signal: Pubspec with an unconstrained SDK range",
  "targets": [
    "pub"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "environment.sdk",
      "valuePattern": "^any$"
    }
  },
  "scope": "A pubspec.yaml file that declares an `environment.sdk` value of `any`.",
  "limitations": "It matches an `environment.sdk` value of `any` in the parsed pubspec.yaml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": "any"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": true
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": "any",
          "flutter": "any"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": true
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": ">=3.4.0 <4.0.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": false
    },
    {
      "file": "pubspec.yaml",
      "document": {
        "name": "demo_app",
        "publish_to": "none",
        "environment": {
          "sdk": "^3.5.0"
        },
        "dependencies": {
          "http": "^1.2.0"
        },
        "dependency_overrides": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A pubspec.yaml that mentions an `environment.sdk` value of `any` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0737"
  ],
  "origin": "original-authored",
  "cell": "sca:pub-sdk-any",
  "validationStatus": "VALIDATED"
}
