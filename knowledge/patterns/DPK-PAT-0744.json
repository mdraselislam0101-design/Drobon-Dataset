{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0744",
  "title": "Signal: Privilege or root change via chroot (c) — review required",
  "targets": [
    "c"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:chroot)\\s*\\("
  },
  "scope": "Single-line lexical match on the chroot call in c code.",
  "limitations": "Lexical, line-based: any chroot call matches.",
  "examples": [
    {
      "line": "chroot(payload)",
      "match": true
    },
    {
      "line": "out = chroot(data)",
      "match": true
    },
    {
      "line": "mychroot(x)",
      "match": false
    },
    {
      "line": "chroot_safe()",
      "match": false
    }
  ],
  "fpNotes": "Correct privilege drops are the common false positive.",
  "linkedRules": [
    "DPK-SAST-627"
  ],
  "origin": "original-authored",
  "cell": "sast:priv-call:c:chroot",
  "validationStatus": "VALIDATED"
}
