{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0303",
  "title": "Signal: anon left open — review required",
  "targets": [
    "mosquitto"
  ],
  "signal": {
    "kind": "regex",
    "source": "allow_anonymous\\s+true"
  },
  "scope": "Single-line lexical match on open settings for anon.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "allow_anonymous true",
      "match": true
    },
    {
      "line": "# audit: allow_anonymous true present",
      "match": true
    },
    {
      "line": "allow_anonymous false",
      "match": false
    },
    {
      "line": "# verified: allow_anonymous false",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-264"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:mosquitto:anon",
  "validationStatus": "VALIDATED"
}
