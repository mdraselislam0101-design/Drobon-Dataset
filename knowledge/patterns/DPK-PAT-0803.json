{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0803",
  "title": "Signal: SQL built by concatenation (basic) — review required",
  "targets": [
    "basic"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.Execute\\s*\\([^)]*&"
  },
  "scope": "Single-line lexical match on assembled SQL in basic code.",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "conn.Execute(\"SELECT \" & q)",
      "match": true
    },
    {
      "line": "# audit: conn.Execute(\"SELECT \" & q) present",
      "match": true
    },
    {
      "line": "conn.Execute(FIXED)",
      "match": false
    },
    {
      "line": "# verified: conn.Execute(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-686"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-4:basic",
  "validationStatus": "VALIDATED"
}
