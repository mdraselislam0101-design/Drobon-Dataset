{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2892",
  "title": "Signal: Dependency audit narrowed to direct packages",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "config.auditMode",
      "valuePattern": "^direct$"
    }
  },
  "scope": "A nuget.config file that declares an `auditMode` that stops at direct dependencies.",
  "limitations": "It matches an `auditMode` that stops at direct dependencies in the parsed nuget.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {
          "auditMode": "direct"
        },
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {
          "auditMode": "direct",
          "globalPackagesFolder": ".packages"
        },
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {
          "auditMode": "all"
        },
        "settings": {}
      },
      "match": false
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A nuget.config that mentions an `auditMode` that stops at direct dependencies in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0755"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-audit-disabled",
  "validationStatus": "VALIDATED"
}
