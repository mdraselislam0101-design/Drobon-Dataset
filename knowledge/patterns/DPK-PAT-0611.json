{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0611",
  "title": "Signal: Dangerous .NET construct (typenames) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "TypeNameHandling\\.(?:All|Auto|Objects)"
  },
  "scope": "Single-line lexical match on .NET constructs (typenames).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "TypeNameHandling.All",
      "match": true
    },
    {
      "line": "# audit: TypeNameHandling.All present",
      "match": true
    },
    {
      "line": "TypeNameHandling.None",
      "match": false
    },
    {
      "line": "# verified: TypeNameHandling.None",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-494"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-flag:csharp:typenames",
  "validationStatus": "VALIDATED"
}
