{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2799",
  "title": "Signal: Module path cannot be resolved by any proxy",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "module",
      "valuePattern": "^[a-z0-9-]+$"
    }
  },
  "scope": "A go.mod file that declares a module path with no domain component.",
  "limitations": "It matches a module path with no domain component in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.mod",
      "document": {
        "module": "demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "demoservice",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "github.com/acme/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": false
    }
  ],
  "fpNotes": "A go.mod that mentions a module path with no domain component in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0662"
  ],
  "origin": "original-authored",
  "cell": "sca:go-module-path-missing-host",
  "validationStatus": "VALIDATED"
}
