{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1584",
  "title": "Signal: Card PIN value served in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]{0,1500}(?:debit card|credit card|atm|cardholder|card))[\\s\\S]{0,1500}?\\bpin\\b[\\\"']?\\s*[:=]\\s*[\\\"']?[0-9]{4,6}\\b"
    }
  },
  "scope": "A response naming a pin field with a four to six digit value beside a card, ATM or debit marker.",
  "limitations": "One response body. It requires a card or ATM marker in the same payload as the PIN field.",
  "examples": [
    {
      "observation": {
        "url": "https://bank.example/api/cards/8842/pin",
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"card\":\"**** 4242\",\"pin\":\"4917\",\"channel\":\"branch\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/cards/issues",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<p>Debit card issued.</p><p>PIN: 550218</p>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/pin",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<h2>Debit card PIN</h2><p>Change your PIN at any ATM using the card and your current PIN.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that explains how to change the PIN, with no numeric value, is not reported.",
  "linkedRules": [
    "DPK-DAST-515"
  ],
  "origin": "original-authored",
  "cell": "dast:bank-pin-in-response:bank-pin-in-response",
  "validationStatus": "VALIDATED"
}
