{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3139",
  "title": "Signal: Repository backed by a filesystem path",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "repositories[].url",
      "valuePattern": "^file:"
    }
  },
  "scope": "A build.gradle file that declares a repository URL of the `file:` scheme.",
  "limitations": "It matches a repository URL of the `file:` scheme in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "libs",
            "url": "file:../libs"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "vendor",
            "url": "file:/opt/vendor/m2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "google"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A build.gradle that mentions a repository URL of the `file:` scheme in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1002"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-file-repository",
  "validationStatus": "VALIDATED"
}
