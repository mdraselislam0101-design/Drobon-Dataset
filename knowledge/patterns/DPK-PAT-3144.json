{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3144",
  "title": "Signal: Gem requirement with no upper bound",
  "targets": [
    "rubygems"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "gems[].requirement",
      "valuePattern": "^>=\\s*[\\d.]+$"
    }
  },
  "scope": "A Gemfile file that declares a `>=` gem requirement.",
  "limitations": "It matches a `>=` gem requirement in the parsed Gemfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "requirement": ">= 7.0.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "puma",
            "requirement": ">= 6.0.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "rails",
            "requirement": "~> 7.1"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Gemfile",
      "document": {
        "source": "https://rubygems.org",
        "gems": [
          {
            "name": "puma",
            "requirement": "~> 6.4"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Gemfile that mentions a `>=` gem requirement in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1007"
  ],
  "origin": "original-authored",
  "cell": "sca:gemfile-requirement-open",
  "validationStatus": "VALIDATED"
}
