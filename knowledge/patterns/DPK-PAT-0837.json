{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0837",
  "title": "Signal: TLS verification disabled (verify) — review required",
  "targets": [
    "julia"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:require_ssl_verification\\s*=\\s*false)"
  },
  "scope": "Single-line lexical match on TLS-disabling settings (verify).",
  "limitations": "Lexical, line-based: matches the switch regardless of environment.",
  "examples": [
    {
      "line": "HTTP.get(u; require_ssl_verification=false)",
      "match": true
    },
    {
      "line": "# audit: HTTP.get(u; require_ssl_verification=false) present",
      "match": true
    },
    {
      "line": "HTTP.get(u; require_ssl_verification=true)",
      "match": false
    },
    {
      "line": "# verified: HTTP.get(u; require_ssl_verification=true)",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive.",
  "linkedRules": [
    "DPK-SAST-720"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-4:julia:verify",
  "validationStatus": "VALIDATED"
}
