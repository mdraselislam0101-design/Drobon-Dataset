{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0676",
  "title": "Signal: Overly broad browser channel (ws) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "new\\s+WebSocket\\s*\\(\\s*\"ws:"
  },
  "scope": "Single-line lexical match on browser channels (ws).",
  "limitations": "Lexical, line-based: matches the channel.",
  "examples": [
    {
      "line": "new WebSocket(\"ws://h/s\")",
      "match": true
    },
    {
      "line": "# audit: new WebSocket(\"ws://h/s\") present",
      "match": true
    },
    {
      "line": "new WebSocket(\"wss://h/s\")",
      "match": false
    },
    {
      "line": "# verified: new WebSocket(\"wss://h/s\")",
      "match": false
    }
  ],
  "fpNotes": "Public broadcasts are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-559"
  ],
  "origin": "original-authored",
  "cell": "sast:js-browser:javascript:ws",
  "validationStatus": "VALIDATED"
}
