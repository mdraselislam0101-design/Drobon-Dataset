{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0253",
  "title": "Signal: File access built from input (rust) — review required",
  "targets": [
    "rust"
  ],
  "signal": {
    "kind": "regex",
    "source": "File::open\\s*\\(\\s*format!"
  },
  "scope": "Single-line lexical match on input-built paths in rust code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "File::open(format!(\"{}/{}\", d, f))",
      "match": true
    },
    {
      "line": "# audit: File::open(format!(\"{}/{}\", d, f)) present",
      "match": true
    },
    {
      "line": "File::open(fixed)",
      "match": false
    },
    {
      "line": "# verified: File::open(fixed)",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-214"
  ],
  "origin": "original-authored",
  "cell": "sast:path-langs:rust",
  "validationStatus": "VALIDATED"
}
