{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1435",
  "title": "Signal: Set-Cookie Domain is an IP address",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Set-Cookie",
      "valuePattern": "^(?=[^\\n]*;\\s*domain\\s*=\\s*\\d{1,3}(?:\\.\\d{1,3}){3}\\s*(?:;|$))"
    }
  },
  "scope": "One Set-Cookie value whose Domain attribute is an IPv4 literal.",
  "limitations": "One Set-Cookie value. The check reads the attribute; it does not test the cookie in a browser.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Domain=10.2.3.4; Path=/; Secure"
        },
        "body": ""
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Domain=203.0.113.10; Path=/; HttpOnly"
        },
        "body": ""
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; Secure; HttpOnly"
        },
        "body": ""
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Domain=app.example; Path=/; Secure"
        },
        "body": ""
      },
      "match": false
    }
  ],
  "fpNotes": "A host-only cookie (no Domain) and a cookie scoped to a host name are not reported.",
  "linkedRules": [
    "DPK-DAST-366"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-cookie-domain-is-ip:cookie-domain-is-ip",
  "validationStatus": "VALIDATED"
}
