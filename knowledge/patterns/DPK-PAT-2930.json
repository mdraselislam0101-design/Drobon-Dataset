{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2930",
  "title": "Signal: npm auth token stored in the client file",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "_authToken",
      "valuePattern": "^(?!\\$\\{)[A-Za-z0-9+/=._-]{16,80}$"
    }
  },
  "scope": "A .npmrc file that declares a literal `_authToken` value.",
  "limitations": "It matches a literal `_authToken` value in the parsed .npmrc; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true",
        "_authToken": "EXAMPLESECRETTOKEN0001"
      },
      "match": true
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true",
        "_authToken": "EXAMPLESECRETTOKEN0002"
      },
      "match": true
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true",
        "_authToken": "${NPM_TOKEN}"
      },
      "match": false
    },
    {
      "file": ".npmrc",
      "document": {
        "registry": "https://registry.npmjs.org",
        "strict-ssl": "true",
        "audit": "true",
        "fund": "true",
        "save-exact": "true"
      },
      "match": false
    }
  ],
  "fpNotes": "A .npmrc that mentions a literal `_authToken` value in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0793"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-config-auth-token-inline",
  "validationStatus": "VALIDATED"
}
