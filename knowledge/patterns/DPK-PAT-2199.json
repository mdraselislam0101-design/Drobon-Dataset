{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2199",
  "title": "Signal: Lockfile resolves a package over SSH",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.resolved",
      "valuePattern": "^git\\+ssh://"
    }
  },
  "scope": "A package-lock.json file that declares a lockfile entry that fetches over SSH from a git remote.",
  "limitations": "It matches a lockfile entry that fetches over SSH from a git remote in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "git+ssh://git@github.com/acme/sdk.git#9f2c4a1",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "git+ssh://git@git.acme.internal/lib.git#0a1b2c3"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "git+https://github.com/acme/sdk.git#9f2c4a1",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org/y/-/y-1.0.0.tgz"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A private registry that speaks SSH internally is still reported; the entry names an SSH remote.",
  "linkedRules": [
    "DPK-SCA-0062"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-resolved-ssh",
  "validationStatus": "VALIDATED"
}
