{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2156",
  "title": "Signal: Dependency installed under an alias of another package",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^npm:"
    }
  },
  "scope": "A package.json file that declares an `npm:` alias that installs a differently named package under this dependency name.",
  "limitations": "It matches an `npm:` alias that installs a differently named package under this dependency name in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "lodash": "npm:lodash-es@^4.17.21"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "npm:@acme/sdk@4.2.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "lodash": "^4.17.21"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "@acme/sdk": "4.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "An alias used by a tooling shim with a documented owner is an accepted exception.",
  "linkedRules": [
    "DPK-SCA-0019"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-alias",
  "validationStatus": "VALIDATED"
}
