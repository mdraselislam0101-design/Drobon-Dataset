{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0362",
  "title": "Signal: Template compiled from input (python) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "render_template_string\\s*\\([^)]*(?:\\+|%|\\bf['\"])|Template\\s*\\([^)]*(?:\\+|%|\\bf['\"])"
  },
  "scope": "Single-line lexical match on assembled templates in python code.",
  "limitations": "Lexical, line-based: any assembled template matches, including trusted ones.",
  "examples": [
    {
      "line": "render_template_string(tpl + name)",
      "match": true
    },
    {
      "line": "# audit: render_template_string(tpl + name) present",
      "match": true
    },
    {
      "line": "render_template_string(FIXED)",
      "match": false
    },
    {
      "line": "# verified: render_template_string(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed template names (not source) is the common false positive — confirm which is assembled.",
  "linkedRules": [
    "DPK-SAST-323"
  ],
  "origin": "original-authored",
  "cell": "sast:template-inject:python",
  "validationStatus": "VALIDATED"
}
