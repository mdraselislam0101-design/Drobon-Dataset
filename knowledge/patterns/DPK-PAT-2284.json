{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2284",
  "title": "Signal: Go module required with no version",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "require[].version",
      "valuePattern": "^$"
    }
  },
  "scope": "A go.mod file that declares a `require` line whose version is empty.",
  "limitations": "It matches a `require` line whose version is empty in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": ""
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "golang.org/x/text",
            "version": ""
          },
          {
            "module": "github.com/pkg/errors",
            "version": "v0.9.1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ]
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "golang.org/x/text",
            "version": "v0.16.0"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A go.mod that mentions a `require` line whose version is empty in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0147"
  ],
  "origin": "original-authored",
  "cell": "sca:go-require-empty-version",
  "validationStatus": "VALIDATED"
}
