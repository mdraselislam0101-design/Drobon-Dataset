{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0553",
  "title": "Signal: Weak service hardening (chmod) — review required",
  "targets": [
    "supervisor"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:chmod\\s*=\\s*07(?:[0-7][1-7]|[1-7][0-7]))"
  },
  "scope": "Single-line lexical match on weak settings (chmod).",
  "limitations": "Lexical, line-based: matches the setting regardless of host trust.",
  "examples": [
    {
      "line": "chmod=0777",
      "match": true
    },
    {
      "line": "# audit: chmod=0777 present",
      "match": true
    },
    {
      "line": "chmod=0700",
      "match": false
    },
    {
      "line": "# verified: chmod=0700",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-456"
  ],
  "origin": "original-authored",
  "cell": "sast:sys-services:supervisor:chmod",
  "validationStatus": "VALIDATED"
}
