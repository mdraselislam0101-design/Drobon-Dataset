{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0540",
  "title": "Signal: Framework SQL built from input (doctrine) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "createQuery\\s*\\([^)]*(?:\"[^\"\\n]*\\$|\\.\\s*\\$)"
  },
  "scope": "Single-line lexical match on assembled framework SQL (doctrine).",
  "limitations": "Lexical, line-based: any assembled query matches, including trusted ones.",
  "examples": [
    {
      "line": "createQuery(\"SELECT $q\")",
      "match": true
    },
    {
      "line": "# audit: createQuery(\"SELECT $q\") present",
      "match": true
    },
    {
      "line": "createQuery($fixed)",
      "match": false
    },
    {
      "line": "# verified: createQuery($fixed)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-443"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli:php:doctrine",
  "validationStatus": "VALIDATED"
}
