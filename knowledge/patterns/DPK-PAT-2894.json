{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2894",
  "title": "Signal: Central package version declared as a floating wildcard",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.itemGroup.PackageVersion[].Version",
      "valuePattern": "^\\d+\\.\\*$"
    }
  },
  "scope": "A Directory.Packages.props file that declares a `<PackageVersion>` value of `X.*`.",
  "limitations": "It matches a `<PackageVersion>` value of `X.*` in the parsed Directory.Packages.props; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.*"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Dapper",
                "Version": "2.*"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          }
        }
      },
      "match": false
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Dapper",
                "Version": "2.1.35"
              }
            ]
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Directory.Packages.props that mentions a `<PackageVersion>` value of `X.*` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0757"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-package-reference-wildcard",
  "validationStatus": "VALIDATED"
}
