{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1381",
  "title": "Signal: Server header names an internal host",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Server",
      "valuePattern": "\\b[\\w-]+\\.(?:internal|local|lan|corp|home\\.arpa|localdomain)\\b|localhost"
    }
  },
  "scope": "One Server header whose value contains a private-suffix hostname.",
  "limitations": "One Server header value. The check reads the name; it does not resolve it and cannot confirm the host exists.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "orders-api.prod.internal"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "web01.corp:8080"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "localhost"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "nginx"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "cloudflare"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A product token such as nginx or cloudflare is not reported, and a version disclosure is covered by DPK-DAST-030 instead.",
  "linkedRules": [
    "DPK-DAST-312"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-header-server-internal-host:server-internal-host",
  "validationStatus": "VALIDATED"
}
