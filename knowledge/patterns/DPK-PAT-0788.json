{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0788",
  "title": "Signal: ActiveRecord SQL from input (findbysql) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "find_by_sql\\s*\\([^)]*#\\{"
  },
  "scope": "Single-line lexical match on assembled SQL (findbysql).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "find_by_sql(\"SELECT #{q}\")",
      "match": true
    },
    {
      "line": "# audit: find_by_sql(\"SELECT #{q}\") present",
      "match": true
    },
    {
      "line": "find_by_sql(FIXED)",
      "match": false
    },
    {
      "line": "# verified: find_by_sql(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-671"
  ],
  "origin": "original-authored",
  "cell": "sast:ruby-flag:ruby:findbysql",
  "validationStatus": "VALIDATED"
}
