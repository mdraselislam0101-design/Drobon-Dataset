{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1232",
  "title": "Signal: CouchDB HTTP API root disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*\"couchdb\"\\s*:\\s*\"Welcome\")(?=[\\s\\S]*\"version\")"
    }
  },
  "scope": "One response whose body is a CouchDB welcome document with couchdb and version fields.",
  "limitations": "One response body. The rule reports the root document; it does not enumerate a database or read a document.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"couchdb\":\"Welcome\",\"version\":\"3.3.2\",\"git_sha\":\"abc123\",\"features\":[\"access-ready\",\"partitioned\"],\"vendor\":{\"name\":\"The Apache Software Foundation\"}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{\"couchdb\":\"Welcome\",\"version\":\"3.2.2\",\"uuid\":\"a1b2c3\",\"features\":[\"pluggable-storage-engines\"]}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "{,:\"3.3.2\",\"git_sha\":\"abc123\",\"features\":[\"access-ready\",\"partitioned\"],\"vendor\":{\"name\":\"The Apache Software Foundation\"}}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately public CouchDB root is still reported; the finding is the reachable API, not a proven document read.",
  "linkedRules": [
    "DPK-DAST-163"
  ],
  "origin": "original-authored",
  "cell": "dast:body-couchdb-welcome:couchdb-welcome",
  "validationStatus": "VALIDATED"
}
