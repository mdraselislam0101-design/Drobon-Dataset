{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2842",
  "title": "Signal: Test tooling is installed into the production dependency tree",
  "targets": [
    "composer"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-key-matches",
      "path": "require",
      "keyPattern": "^(?:phpunit/phpunit|mockery/mockery|phpstan/phpstan)$"
    }
  },
  "scope": "A composer.json file that declares a test-only package declared in `require`.",
  "limitations": "It matches a test-only package declared in `require` in the parsed composer.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7",
          "phpunit/phpunit": "^11.3"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7",
          "mockery/mockery": "^1.6"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {}
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "require-dev": {
          "phpunit/phpunit": "^11.3"
        }
      },
      "match": false
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "require-dev": {
          "phpstan/phpstan": "^1.12"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A composer.json that mentions a test-only package declared in `require` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0705"
  ],
  "origin": "original-authored",
  "cell": "sca:composer-require-dev-in-require",
  "validationStatus": "VALIDATED"
}
