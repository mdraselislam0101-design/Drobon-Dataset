{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0375",
  "title": "Signal: TLS checks disabled (ldap) — review required",
  "targets": [
    "shell"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:TLS_REQCERT\\s+never)"
  },
  "scope": "Single-line lexical match on TLS-disabling flags for ldap.",
  "limitations": "Lexical, line-based: matches the flag regardless of environment.",
  "examples": [
    {
      "line": "TLS_REQCERT never",
      "match": true
    },
    {
      "line": "# audit: TLS_REQCERT never present",
      "match": true
    },
    {
      "line": "TLS_REQCERT demand",
      "match": false
    },
    {
      "line": "# verified: TLS_REQCERT demand",
      "match": false
    }
  ],
  "fpNotes": "Local bootstrap scripts are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-336"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-cli:shell:ldap",
  "validationStatus": "VALIDATED"
}
