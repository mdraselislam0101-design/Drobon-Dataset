{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0227",
  "title": "Signal: Mobile cleartext traffic allowed (cleartext) — review required",
  "targets": [
    "xml"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:android:usesCleartextTraffic\\s*=\\s*[\"']true[\"'])"
  },
  "scope": "Single-line lexical match on the manifest flag.",
  "limitations": "Lexical, line-based: matches the flag.",
  "examples": [
    {
      "line": "android:usesCleartextTraffic=\"true\"",
      "match": true
    },
    {
      "line": "# audit: android:usesCleartextTraffic=\"true\" present",
      "match": true
    },
    {
      "line": "android:usesCleartextTraffic=\"false\"",
      "match": false
    },
    {
      "line": "# verified: android:usesCleartextTraffic=\"false\"",
      "match": false
    }
  ],
  "fpNotes": "Local-only endpoints are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-188"
  ],
  "origin": "original-authored",
  "cell": "sast:mobile-transport:xml:cleartext",
  "validationStatus": "VALIDATED"
}
