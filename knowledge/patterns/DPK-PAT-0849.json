{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0849",
  "title": "Signal: Unescaped output (output) — review required",
  "targets": [
    "coldfusion"
  ],
  "signal": {
    "kind": "regex",
    "source": "#[a-zA-Z_$][\\w$]*#"
  },
  "scope": "Single-line lexical match on unescaped output (output).",
  "limitations": "Lexical, line-based: matches the output regardless of value trust.",
  "examples": [
    {
      "line": "<cfoutput>#q#</cfoutput>",
      "match": true
    },
    {
      "line": "# audit: <cfoutput>#q#</cfoutput> present",
      "match": true
    },
    {
      "line": "<cfoutput>#encodeForHtml(q)#</cfoutput>",
      "match": false
    },
    {
      "line": "# verified: <cfoutput>#encodeForHtml(q)#</cfoutput>",
      "match": false
    }
  ],
  "fpNotes": "Trusted constants are the common false positive.",
  "linkedRules": [
    "DPK-SAST-732"
  ],
  "origin": "original-authored",
  "cell": "sast:xss-flag-3:coldfusion:output",
  "validationStatus": "VALIDATED"
}
