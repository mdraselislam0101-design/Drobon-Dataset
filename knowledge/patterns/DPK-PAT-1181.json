{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1181",
  "title": "Signal: X-Frame-Options value is ignored by browsers",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-Frame-Options",
      "valuePattern": "^(?!\\s*$)(?!(?:deny|sameorigin)\\s*$)(?!allow-from\\s+\\S+\\s*$).+$"
    }
  },
  "scope": "One X-Frame-Options value that is non-empty and does not match a defined value.",
  "limitations": "One header value. The rule reports the ignored value; it does not read frame-ancestors, so a page that is protected by CSP is still reported here.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Frame-Options": "ALLOWALL"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Frame-Options": "DENY, SAMEORIGIN"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Frame-Options": "sameorigin "
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Frame-Options": "ALLOW-FROM https://partner.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "X-Frame-Options": ""
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A page protected by a correct frame-ancestors policy is reported; the finding is the misleading header, not a demonstrated framing.",
  "linkedRules": [
    "DPK-DAST-112"
  ],
  "origin": "original-authored",
  "cell": "dast:xfo-invalid-value:xfo",
  "validationStatus": "VALIDATED"
}
