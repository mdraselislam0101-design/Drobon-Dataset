{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1317",
  "title": "Signal: HashiCorp Vault UI disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Vault)(?=[\\s\\S]*Seal)"
    }
  },
  "scope": "One response whose body renders the Vault UI.",
  "limitations": "One response body. The rule reports the UI; it does not authenticate and cannot read a secret.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Vault</title></head><body><div id=\"vault-ui\"></div><p>Seal status</p><script src=\"/ui/vault.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h1>Vault</h1><section><h2>Seal</h2><p>Vault is sealed</p></section></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><div id=\"-ui\"></div><p> status</p><script src=\"/ui/.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that mentions Vault without the seal panel is not reported.",
  "linkedRules": [
    "DPK-DAST-248"
  ],
  "origin": "original-authored",
  "cell": "dast:body-vault-ui:vault-ui",
  "validationStatus": "VALIDATED"
}
