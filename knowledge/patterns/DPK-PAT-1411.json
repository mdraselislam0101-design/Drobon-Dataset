{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1411",
  "title": "Signal: Subversion .svn/entries file served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*(?:^|\\n)12\\n(?:dir|file)\\n)(?=[\\s\\S]*svn://)"
    }
  },
  "scope": "One response body containing the Subversion entries file with its repository URL.",
  "limitations": "One response body. The rule reads the entries format; it does not list the rest of the directory.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/.svn/entries",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "12\ndir\n3831\nsvn://repo.internal/shop/trunk\n2024-05-11T09:14:02.000000Z\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/assets/.svn/entries",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "12\ndir\n1180\nsvn://repo.internal/shop/trunk/assets\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/docs/deploy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "Export the tree with svn export so the metadata stays out of production."
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/.git/config",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "[core]\n\trepositoryformatversion = 0\n[remote \"origin\"]\n\turl = https://git.internal/shop.git\n"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that mentions Subversion is not reported, because the entries-file structure is required. A modern working copy (format 31) uses a database file instead and is not covered by this rule.",
  "linkedRules": [
    "DPK-DAST-342"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-artefact-svn-entries:svn-entries",
  "validationStatus": "VALIDATED"
}
