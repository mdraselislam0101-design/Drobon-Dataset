{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0198",
  "title": "Signal: Sensitive value in log call (dart) — review required",
  "targets": [
    "dart"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:print\\s*\\([^)]*(?:password|passwd|secret|token))"
  },
  "scope": "Single-line lexical match on credential-named log values in dart code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "print(\"password=$pw\")",
      "match": true
    },
    {
      "line": "# audit: print(\"password=$pw\") present",
      "match": true
    },
    {
      "line": "print(\"user=$u\")",
      "match": false
    },
    {
      "line": "# verified: print(\"user=$u\")",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-159"
  ],
  "origin": "original-authored",
  "cell": "sast:log-langs:dart",
  "validationStatus": "VALIDATED"
}
