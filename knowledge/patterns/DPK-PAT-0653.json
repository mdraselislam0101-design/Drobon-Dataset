{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0653",
  "title": "Signal: Legacy digest selected (sha) — review required",
  "targets": [
    "elixir"
  ],
  "signal": {
    "kind": "regex",
    "source": ":crypto\\.hash\\s*\\(\\s*:sha\\b"
  },
  "scope": "Single-line lexical match on digest selection (sha).",
  "limitations": "Lexical, line-based: matches the selection.",
  "examples": [
    {
      "line": ":crypto.hash(:sha, x)",
      "match": true
    },
    {
      "line": "# audit: :crypto.hash(:sha, x) present",
      "match": true
    },
    {
      "line": ":crypto.hash(:sha256, x)",
      "match": false
    },
    {
      "line": "# verified: :crypto.hash(:sha256, x)",
      "match": false
    }
  ],
  "fpNotes": "Checksums are the common false positive.",
  "linkedRules": [
    "DPK-SAST-536"
  ],
  "origin": "original-authored",
  "cell": "sast:hash-flag-3:elixir:sha",
  "validationStatus": "VALIDATED"
}
