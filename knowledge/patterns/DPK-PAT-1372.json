{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1372",
  "title": "Signal: ASP.NET trace application disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*trace\\.axd)(?=[\\s\\S]*Application Trace)"
    }
  },
  "scope": "One response body containing both the trace.axd reference and the Application Trace table.",
  "limitations": "One response body. The check recognises the trace viewer; it does not enumerate the recorded requests.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/trace.axd",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Application Trace</title></head><body><a href=\"trace.axd\">trace.axd</a><table><tr><td>Request Details</td></tr></table></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/trace.axd?clear=1",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "Application Trace &mdash; Physical Directory: /app <!-- http://host/trace.axd -->"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/trace.axd",
        "status": 404,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>404 - File or directory not found.</h1></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Disable trace.axd before going live.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that merely links to trace.axd is reported only when the Application Trace table is also present; a tutorial page discussing ASP.NET tracing is not.",
  "linkedRules": [
    "DPK-DAST-303"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-aspnet-trace-axd:trace-axd-viewer",
  "validationStatus": "VALIDATED"
}
