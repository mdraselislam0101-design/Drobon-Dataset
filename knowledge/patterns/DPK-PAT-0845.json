{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0845",
  "title": "Signal: Raw HTML marker via raw (clojure) — review required",
  "targets": [
    "clojure"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:raw)\\s*\\("
  },
  "scope": "Single-line lexical match on the raw call in clojure code.",
  "limitations": "Lexical, line-based: any raw call matches.",
  "examples": [
    {
      "line": "raw(payload)",
      "match": true
    },
    {
      "line": "out = raw(data)",
      "match": true
    },
    {
      "line": "myraw(x)",
      "match": false
    },
    {
      "line": "raw_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted markup is the common false positive.",
  "linkedRules": [
    "DPK-SAST-728"
  ],
  "origin": "original-authored",
  "cell": "sast:xss-call-3:clojure",
  "validationStatus": "VALIDATED"
}
