{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0783",
  "title": "Signal: Dynamic evaluation via DRb.start_service (ruby) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:DRb\\.start_service)\\s*\\("
  },
  "scope": "Single-line lexical match on the DRb.start_service call in ruby code.",
  "limitations": "Lexical, line-based: any DRb.start_service call matches.",
  "examples": [
    {
      "line": "DRb.start_service(payload)",
      "match": true
    },
    {
      "line": "out = DRb.start_service(data)",
      "match": true
    },
    {
      "line": "myDRbstart_service(x)",
      "match": false
    },
    {
      "line": "DRb.start_service_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted templates are the common false positive.",
  "linkedRules": [
    "DPK-SAST-666"
  ],
  "origin": "original-authored",
  "cell": "sast:ruby-call:ruby:drb",
  "validationStatus": "VALIDATED"
}
