{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2071",
  "title": "Signal: Second factor disabled on a privileged account",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "\"mfaEnabled\"\\s*:\\s*false[\\s\\S]{0,200}?\"role\"\\s*:\\s*\"(?:ADMIN|admin|SUPERUSER|BACKOFFICE)\"|\"role\"\\s*:\\s*\"(?:ADMIN|admin|SUPERUSER|BACKOFFICE)\"[\\s\\S]{0,200}?\"mfaEnabled\"\\s*:\\s*false"
    }
  },
  "scope": "A response body that carries an mfaEnabled flag set to false beside an administrative role.",
  "limitations": "One response body, first 32,768 bytes. It matches the disabled flag beside a privileged role; it cannot tell whether the value behind the marker is live or whether the page needs authentication.",
  "examples": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"userId\":\"ops.777\",\"role\":\"ADMIN\",\"mfaEnabled\":false}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"role\": \"BACKOFFICE\", \"mfaEnabled\": false}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "{\"userId\":\"C-8841\",\"role\":\"CUSTOMER\",\"mfaEnabled\":false}"
      },
      "match": false
    }
  ],
  "fpNotes": "A flag for a customer who never had a second factor is not reported here.",
  "linkedRules": [
    "DPK-DAST-952"
  ],
  "origin": "original-authored",
  "cell": "dast:body-mfa-disabled-privileged:body-mfa-disabled-privileged",
  "validationStatus": "VALIDATED"
}
