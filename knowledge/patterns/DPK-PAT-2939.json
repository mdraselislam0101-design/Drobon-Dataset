{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2939",
  "title": "Signal: Requirement pointing at a local path",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "options.install_requires[]",
      "valuePattern": "^(?:file|link):|^\\.{1,2}/"
    }
  },
  "scope": "A setup.cfg file that declares an `install_requires` entry that resolves from disk.",
  "limitations": "It matches an `install_requires` entry that resolves from disk in the parsed setup.cfg; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "file:../acme-core"
          ]
        }
      },
      "match": true
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "./vendor/acme-sdk"
          ]
        }
      },
      "match": true
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ]
        }
      },
      "match": false
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "urllib3==2.2.2"
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A setup.cfg that mentions an `install_requires` entry that resolves from disk in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0802"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-setupcfg-cfg-absolute-path",
  "validationStatus": "VALIDATED"
}
