{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1467",
  "title": "Signal: Apache Storm UI is reachable without authentication",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Storm UI)(?=[\\s\\S]*topology summary)"
    }
  },
  "scope": "One response body containing the Storm UI cluster summary.",
  "limitations": "One response body. The rule reports the UI summary; it does not open a topology.",
  "examples": [
    {
      "observation": {
        "url": "https://storm.example:8080/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Storm UI</title></head><body><h2>Cluster Summary</h2><h2>Topology summary</h2><p>Nimbus uptime 4d</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://storm.example:8080/topology.html?id=web",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Storm UI</h1><h2>Topology summary</h2><p>Supervisors 4</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Streaming guide</title></head><body><p>The UI lists the topology summary for the cluster.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/stream",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Stream</title></head><body><p>Streaming is healthy.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that names Storm in prose is not reported, because the summary heading is required.",
  "linkedRules": [
    "DPK-DAST-398"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-console-storm-ui:storm-ui",
  "validationStatus": "VALIDATED"
}
