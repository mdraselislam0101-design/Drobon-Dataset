{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0549",
  "title": "Signal: Open web-server access (indexes) — review required",
  "targets": [
    "apache"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Options\\s+\\+?Indexes)"
  },
  "scope": "Single-line lexical match on open access settings (indexes).",
  "limitations": "Lexical, line-based: matches the setting regardless of content sensitivity.",
  "examples": [
    {
      "line": "Options Indexes FollowSymLinks",
      "match": true
    },
    {
      "line": "# audit: Options Indexes FollowSymLinks present",
      "match": true
    },
    {
      "line": "Options -Indexes",
      "match": false
    },
    {
      "line": "# verified: Options -Indexes",
      "match": false
    }
  ],
  "fpNotes": "Public file mirrors are the common accepted case — confirm intent.",
  "linkedRules": [
    "DPK-SAST-452"
  ],
  "origin": "original-authored",
  "cell": "sast:server-access:apache:indexes",
  "validationStatus": "VALIDATED"
}
