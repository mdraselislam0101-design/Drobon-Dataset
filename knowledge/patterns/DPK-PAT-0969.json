{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0969",
  "title": "Signal: Possible password in a JDBC URL in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "jdbc:[a-z0-9]+:[^\\s\"']{0,200}[?&;]password=[^\\s\"'&;]{8,}"
  },
  "scope": "Single-line shape match for password in a JDBC URL.",
  "limitations": "Shape-only: matches the documented syntax of this configuration form. It cannot prove the value is a live credential.",
  "examples": [
    {
      "line": "url = \"jdbc:postgresql://db.internal/app?ssl=true&password=AAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: url = \"jdbc:postgresql://db.internal/app?ssl=true&password=AAAAAAAA\" present",
      "match": true
    },
    {
      "line": "url = \"xy\"",
      "match": false
    },
    {
      "line": "url = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    },
    {
      "line": "url = \"jdbc:postgresql://db.internal/app?ssl=true\"",
      "match": false
    },
    {
      "line": "url = \"jdbc:postgresql://db.internal/app?password=\"",
      "match": false
    }
  ],
  "fpNotes": "Placeholders and documentation that reuse the same syntax are the common false positives.",
  "linkedRules": [
    "DPK-SEC-103"
  ],
  "origin": "original-authored",
  "cell": "secrets:protocol-config:jdbc-url-password",
  "validationStatus": "VALIDATED"
}
