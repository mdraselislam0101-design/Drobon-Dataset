{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0280",
  "title": "Signal: Unsafe referrer policy (html) — review required",
  "targets": [
    "html"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:referrerpolicy\\s*=\\s*[\"']unsafe-url)"
  },
  "scope": "Single-line lexical match on referrer policy in html markup.",
  "limitations": "Lexical, line-based: matches the policy regardless of URL sensitivity.",
  "examples": [
    {
      "line": "<a referrerpolicy=\"unsafe-url\">",
      "match": true
    },
    {
      "line": "# audit: <a referrerpolicy=\"unsafe-url\"> present",
      "match": true
    },
    {
      "line": "<a referrerpolicy=\"strict-origin\">",
      "match": false
    },
    {
      "line": "# verified: <a referrerpolicy=\"strict-origin\">",
      "match": false
    }
  ],
  "fpNotes": "Pages with no sensitive query data are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-241"
  ],
  "origin": "original-authored",
  "cell": "sast:referrer-unsafe:html",
  "validationStatus": "VALIDATED"
}
