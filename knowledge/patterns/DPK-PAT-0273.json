{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0273",
  "title": "Signal: Predictable randomness via rand (matlab) — review required",
  "targets": [
    "matlab"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:rand)\\s*\\("
  },
  "scope": "Single-line lexical match on the rand call in matlab code.",
  "limitations": "Lexical, line-based: matches any rand call.",
  "examples": [
    {
      "line": "rand(payload)",
      "match": true
    },
    {
      "line": "out = rand(data)",
      "match": true
    },
    {
      "line": "myrand(x)",
      "match": false
    },
    {
      "line": "rand_safe()",
      "match": false
    }
  ],
  "fpNotes": "Simulations are the common false positive.",
  "linkedRules": [
    "DPK-SAST-234"
  ],
  "origin": "original-authored",
  "cell": "sast:random-extra:matlab",
  "validationStatus": "VALIDATED"
}
