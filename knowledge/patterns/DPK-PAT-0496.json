{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0496",
  "title": "Signal: Possible a Mailgun key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "key-[a-f0-9]{32,}"
  },
  "scope": "Single-line shape match for a Mailgun key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"key-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"",
      "match": true
    },
    {
      "line": "# audit: key = \"key-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-030"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:mailgun",
  "validationStatus": "VALIDATED"
}
