{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1287",
  "title": "Signal: Clockwork debug toolbar disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*clockwork)(?=[\\s\\S]*Clockwork)"
    }
  },
  "scope": "One response whose body injects the Clockwork toolbar.",
  "limitations": "One response body. The rule reports the toolbar; it does not request a profile and cannot show what one contains.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"clockwork\"></div><script>window.Clockwork = {version: \"5.1\"};</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div class=\"clockwork-toolbar\" data-clockwork=\"1\"><span>Clockwork</span></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"\"></div><script>window. = {version: \"5.1\"};</script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A different debug toolbar is a different package and a different rule.",
  "linkedRules": [
    "DPK-DAST-218"
  ],
  "origin": "original-authored",
  "cell": "dast:body-clockwork-debugbar:clockwork-debugbar",
  "validationStatus": "VALIDATED"
}
