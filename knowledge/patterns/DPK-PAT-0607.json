{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0607",
  "title": "Signal: Dangerous .NET construct (smtp) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "EnableSsl\\s*=\\s*false"
  },
  "scope": "Single-line lexical match on .NET constructs (smtp).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "EnableSsl = false",
      "match": true
    },
    {
      "line": "# audit: EnableSsl = false present",
      "match": true
    },
    {
      "line": "EnableSsl = true",
      "match": false
    },
    {
      "line": "# verified: EnableSsl = true",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-490"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-flag:csharp:smtp",
  "validationStatus": "VALIDATED"
}
