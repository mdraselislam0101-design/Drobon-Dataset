{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0753",
  "title": "Signal: Weak proxy or service setting (mlock) — review required",
  "targets": [
    "vault"
  ],
  "signal": {
    "kind": "regex",
    "source": "disable_mlock\\s*=\\s*true"
  },
  "scope": "Single-line lexical match on service settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "disable_mlock = true",
      "match": true
    },
    {
      "line": "# audit: disable_mlock = true present",
      "match": true
    },
    {
      "line": "disable_mlock = false",
      "match": false
    },
    {
      "line": "# verified: disable_mlock = false",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-636"
  ],
  "origin": "original-authored",
  "cell": "sast:proxy-misc:vault:mlock",
  "validationStatus": "VALIDATED"
}
