{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0926",
  "title": "Signal: Block values used as randomness (solidity) — review required",
  "targets": [
    "solidity"
  ],
  "signal": {
    "kind": "regex",
    "source": "keccak256\\s*\\(\\s*abi\\.encodePacked\\s*\\([^)]*\\bblock\\.(?:timestamp|number)"
  },
  "scope": "Single-line lexical match on block values hashed into a result in solidity code.",
  "limitations": "Lexical, line-based: any hash over a block value matches, including non-random uses such as cache keys.",
  "examples": [
    {
      "line": "keccak256(abi.encodePacked(block.timestamp, msg.sender))",
      "match": true
    },
    {
      "line": "# audit: keccak256(abi.encodePacked(block.timestamp, msg.sender)) present",
      "match": true
    },
    {
      "line": "keccak256(abi.encodePacked(seed, msg.sender))",
      "match": false
    },
    {
      "line": "# verified: keccak256(abi.encodePacked(seed, msg.sender))",
      "match": false
    }
  ],
  "fpNotes": "Hashing block values for cache keys or deduplication is the common false positive.",
  "linkedRules": [
    "DPK-SAST-770"
  ],
  "origin": "original-authored",
  "cell": "sast:weak-randomness-block:solidity",
  "validationStatus": "VALIDATED"
}
