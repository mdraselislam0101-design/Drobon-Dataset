{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2918",
  "title": "Signal: vcpkg version override",
  "targets": [
    "vcpkg"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "overrides[].version",
      "valuePattern": "^.+$"
    }
  },
  "scope": "A vcpkg.json file that declares an `overrides` entry that forces one port version.",
  "limitations": "It matches an `overrides` entry that forces one port version in the parsed vcpkg.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "vcpkg.json",
      "document": {
        "name": "demo",
        "version": "1.4.0",
        "dependencies": [
          "fmt"
        ],
        "builtin-baseline": "9f2c3d4e5f60718293a4b5c6d7e8f90123456789",
        "overrides": [
          {
            "name": "fmt",
            "version": "10.2.1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "vcpkg.json",
      "document": {
        "name": "demo",
        "version": "1.4.0",
        "dependencies": [
          "fmt"
        ],
        "builtin-baseline": "9f2c3d4e5f60718293a4b5c6d7e8f90123456789",
        "overrides": [
          {
            "name": "zlib",
            "version": "1.3.1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "vcpkg.json",
      "document": {
        "name": "demo",
        "version": "1.4.0",
        "dependencies": [
          "fmt"
        ],
        "builtin-baseline": "9f2c3d4e5f60718293a4b5c6d7e8f90123456789",
        "overrides": []
      },
      "match": false
    },
    {
      "file": "vcpkg.json",
      "document": {
        "name": "demo",
        "version": "1.4.0",
        "dependencies": [
          "fmt"
        ],
        "builtin-baseline": "9f2c3d4e5f60718293a4b5c6d7e8f90123456789"
      },
      "match": false
    }
  ],
  "fpNotes": "A vcpkg.json that mentions an `overrides` entry that forces one port version in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0781"
  ],
  "origin": "original-authored",
  "cell": "sca:vcpkg-overrides-present",
  "validationStatus": "VALIDATED"
}
