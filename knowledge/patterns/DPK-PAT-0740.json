{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0740",
  "title": "Signal: Weak PHP crypto or diagnostics (erroff) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:error_reporting\\s*\\(\\s*0\\s*\\))"
  },
  "scope": "Single-line lexical match on PHP settings (erroff).",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "error_reporting(0)",
      "match": true
    },
    {
      "line": "# audit: error_reporting(0) present",
      "match": true
    },
    {
      "line": "error_reporting(E_ALL)",
      "match": false
    },
    {
      "line": "# verified: error_reporting(E_ALL)",
      "match": false
    }
  ],
  "fpNotes": "Legacy interop is the common false positive.",
  "linkedRules": [
    "DPK-SAST-623"
  ],
  "origin": "original-authored",
  "cell": "sast:php-misc:php:erroff",
  "validationStatus": "VALIDATED"
}
