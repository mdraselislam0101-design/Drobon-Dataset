{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1076",
  "title": "Signal: Erlang term decoded from untrusted bytes in elixir — review required",
  "targets": [
    "elixir"
  ],
  "signal": {
    "kind": "regex",
    "source": ":erlang\\.binary_to_term\\s*\\((?![^)\\n]*:safe)"
  },
  "scope": "Single-line match on binary_to_term without :safe in elixir.",
  "limitations": "Lexical: matches binary_to_term calls and reports whether :safe is present on the same line.",
  "examples": [
    {
      "line": "term = :erlang.binary_to_term(payload)",
      "match": true
    },
    {
      "line": "# audit: term = :erlang.binary_to_term(payload) present",
      "match": true
    },
    {
      "line": "term = :erlang.binary_to_term(payload, [:safe])",
      "match": false
    },
    {
      "line": "# verified: term = :erlang.binary_to_term(payload, [:safe])",
      "match": false
    }
  ],
  "fpNotes": "Cluster-internal distribution payloads from a trusted node are the accepted exception.",
  "linkedRules": [
    "DPK-SAST-893"
  ],
  "origin": "original-authored",
  "cell": "sast:elixir-erlang-binary-to-term:elixir",
  "validationStatus": "VALIDATED"
}
