{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0718",
  "title": "Signal: File access built from input (clojure) — review required",
  "targets": [
    "clojure"
  ],
  "signal": {
    "kind": "regex",
    "source": "slurp\\s*\\([^)]*str\\s"
  },
  "scope": "Single-line lexical match on input-built paths in clojure code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "(slurp (str dir f))",
      "match": true
    },
    {
      "line": "# audit: (slurp (str dir f)) present",
      "match": true
    },
    {
      "line": "(slurp fixed)",
      "match": false
    },
    {
      "line": "# verified: (slurp fixed)",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-601"
  ],
  "origin": "original-authored",
  "cell": "sast:path-3:clojure",
  "validationStatus": "VALIDATED"
}
