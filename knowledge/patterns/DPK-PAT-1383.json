{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1383",
  "title": "Signal: Meta tag delivers a CSP that permits inline script",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<meta[^>]{0,400}http-equiv\\s*=\\s*[\"']?content-security-policy[^>]{0,400}content\\s*=\\s*(?:\"[^\"]{0,300}unsafe-inline|'[^']{0,300}unsafe-inline)"
    }
  },
  "scope": "One meta element declaring a CSP whose content carries unsafe-inline.",
  "limitations": "One response body. The check reads the meta element; it does not evaluate whether other directives would still block a specific payload.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/app",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'; script-src 'self' 'unsafe-inline'\"></head></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/app",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<meta http-equiv='Content-Security-Policy' content=\"style-src 'unsafe-inline'\">"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/app",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<meta http-equiv=\"Content-Security-Policy\" content=\"script-src 'nonce-abc123'\">"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/app",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>ok</body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A meta CSP without unsafe-inline is not reported; a header-delivered policy is covered by the header rules instead.",
  "linkedRules": [
    "DPK-DAST-314"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-meta-csp-unsafe-inline:meta-csp-unsafe-inline",
  "validationStatus": "VALIDATED"
}
