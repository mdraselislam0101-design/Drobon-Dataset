{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1309",
  "title": "Signal: PHP Debug Bar toolbar disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*phpdebugbar)(?=[\\s\\S]*PhpDebugBar)"
    }
  },
  "scope": "One response whose body injects the PHP Debug Bar.",
  "limitations": "One response body. The rule reports the toolbar; it does not enumerate the collected panels and cannot show which values the collector captured.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"phpdebugbar\"></div><script>var PhpDebugBar = {version: \"1.18\"};</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div class=\"phpdebugbar\" data-phpdebugbar=\"1\"><span>PhpDebugBar</span></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"\"></div><script>var  = {version: \"1.18\"};</script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that mentions the package without the toolbar element is not reported.",
  "linkedRules": [
    "DPK-DAST-240"
  ],
  "origin": "original-authored",
  "cell": "dast:body-php-debugbar:php-debugbar",
  "validationStatus": "VALIDATED"
}
