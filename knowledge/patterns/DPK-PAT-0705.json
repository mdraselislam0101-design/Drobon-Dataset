{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0705",
  "title": "Signal: Sensitive value in log call (crystal) — review required",
  "targets": [
    "crystal"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:puts\\s+[^\\n]*(?:password|passwd|secret|token))"
  },
  "scope": "Single-line lexical match on credential-named log values in crystal code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "puts \"password=#{p}\"",
      "match": true
    },
    {
      "line": "# audit: puts \"password=#{p}\" present",
      "match": true
    },
    {
      "line": "puts \"user=#{u}\"",
      "match": false
    },
    {
      "line": "# verified: puts \"user=#{u}\"",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-588"
  ],
  "origin": "original-authored",
  "cell": "sast:log-4:crystal",
  "validationStatus": "VALIDATED"
}
