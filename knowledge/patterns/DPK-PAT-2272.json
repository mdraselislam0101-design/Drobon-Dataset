{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2272",
  "title": "Signal: poetry.lock in the legacy format",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "metadata.lock-version",
      "valuePattern": "^1\\."
    }
  },
  "scope": "A poetry.lock file that declares a lockfile whose `lock-version` is 1.x.",
  "limitations": "It matches a lockfile whose `lock-version` is 1.x in the parsed poetry.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "version": "2.32.3",
            "files": [
              {
                "file": "requests-2.32.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "1.1"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "flask",
            "version": "3.0.3",
            "files": [
              {
                "file": "flask-3.0.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "1.0"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "version": "2.32.3",
            "files": [
              {
                "file": "requests-2.32.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": false
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "flask",
            "version": "3.0.3",
            "files": [
              {
                "file": "flask-3.0.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A poetry.lock that mentions a lockfile whose `lock-version` is 1.x in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0135"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-poetry-lock-legacy-version",
  "validationStatus": "VALIDATED"
}
