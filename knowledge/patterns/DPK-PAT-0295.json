{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0295",
  "title": "Signal: users left open (couchdb) — review required",
  "targets": [
    "couchdb"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:require_valid_user\\s*=\\s*false)"
  },
  "scope": "Single-line lexical match on open settings for users.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "require_valid_user = false",
      "match": true
    },
    {
      "line": "# audit: require_valid_user = false present",
      "match": true
    },
    {
      "line": "require_valid_user = true",
      "match": false
    },
    {
      "line": "# verified: require_valid_user = true",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-256"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:couchdb:users",
  "validationStatus": "VALIDATED"
}
