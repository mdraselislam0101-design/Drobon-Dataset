{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0701",
  "title": "Signal: Permissive Kubernetes pod (root) — review required",
  "targets": [
    "k8s"
  ],
  "signal": {
    "kind": "regex",
    "source": "runAsUser\\s*:\\s*0\\b"
  },
  "scope": "Single-line lexical match on Kubernetes manifests.",
  "limitations": "Lexical, line-based: matches the grant.",
  "examples": [
    {
      "line": "runAsUser: 0",
      "match": true
    },
    {
      "line": "# audit: runAsUser: 0 present",
      "match": true
    },
    {
      "line": "runAsUser: 1000",
      "match": false
    },
    {
      "line": "# verified: runAsUser: 1000",
      "match": false
    }
  ],
  "fpNotes": "Node agents are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-584"
  ],
  "origin": "original-authored",
  "cell": "sast:k8s-more:k8s:root",
  "validationStatus": "VALIDATED"
}
