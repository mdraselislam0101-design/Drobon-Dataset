{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0641",
  "title": "Signal: Risky GitHub Actions step (writeall) — review required",
  "targets": [
    "gha"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:permissions\\s*:\\s*write-all)"
  },
  "scope": "Single-line lexical match on workflow files.",
  "limitations": "Lexical, line-based: matches the step.",
  "examples": [
    {
      "line": "permissions: write-all",
      "match": true
    },
    {
      "line": "# audit: permissions: write-all present",
      "match": true
    },
    {
      "line": "permissions: read-all",
      "match": false
    },
    {
      "line": "# verified: permissions: read-all",
      "match": false
    }
  ],
  "fpNotes": "Trusted first-party actions are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-524"
  ],
  "origin": "original-authored",
  "cell": "sast:gha-more:gha:writeall",
  "validationStatus": "VALIDATED"
}
