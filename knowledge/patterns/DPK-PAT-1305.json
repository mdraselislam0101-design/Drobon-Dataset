{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1305",
  "title": "Signal: HashiCorp Nomad UI disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Nomad)(?=[\\s\\S]*Jobs)"
    }
  },
  "scope": "One response whose body renders the Nomad console.",
  "limitations": "One response body. The rule reports the UI; it does not stop a job and cannot show whether the request would be authorised.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Nomad</title></head><body><div id=\"nomad-ui\"></div><nav><a href=\"/ui/jobs\">Jobs</a><a href=\"/ui/nodes\">Clients</a></nav></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h1>Nomad</h1><ul><li>Jobs</li><li>Clients</li><li>Servers</li></ul></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><div id=\"-ui\"></div><nav><a href=\"/ui/\"></a><a href=\"/ui/nodes\">Clients</a></nav></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A Consul UI is a different product and a different rule.",
  "linkedRules": [
    "DPK-DAST-236"
  ],
  "origin": "original-authored",
  "cell": "dast:body-nomad-ui:nomad-ui",
  "validationStatus": "VALIDATED"
}
