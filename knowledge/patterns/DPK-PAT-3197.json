{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3197",
  "title": "Signal: Possible a Terraform Cloud API token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "team-atlas.atlasv1.[A-Za-z0-9_=-]{60,}"
  },
  "scope": "Single-line shape match for a Terraform Cloud API token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"team-atlas.atlasv1.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"team-atlas.atlasv1.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-137"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-4:terraform-cloud-token",
  "validationStatus": "VALIDATED"
}
