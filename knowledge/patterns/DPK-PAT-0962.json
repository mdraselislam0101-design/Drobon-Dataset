{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0962",
  "title": "Signal: Server file path disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?:[A-Za-z]:\\\\(?:inetpub|Windows|Users)\\\\|/(?:var/www|home/[\\w.-]+|srv|opt)/[\\w./-]+\\.(?:php|py|rb|js|java|cs|go)\\b)"
    }
  },
  "scope": "Single response body: confirm no absolute server path to a source file appears.",
  "limitations": "Pattern on one body: a Windows or Unix path in a download link or log excerpt can match.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "content-type": "text/html"
        },
        "body": "Failed to load C:\\inetpub\\wwwroot\\app.aspx"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "content-type": "text/html"
        },
        "body": "Failed at /home/deploy/app/server.py line 9"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "content-type": "text/html"
        },
        "body": "Download the file from /home/deploy/README.md"
      },
      "match": false
    }
  ],
  "fpNotes": "Paths that the page displays on purpose, such as a download location, are the common false positive.",
  "linkedRules": [
    "DPK-DAST-065"
  ],
  "origin": "original-authored",
  "cell": "dast:filesystem-path-disclosed:source-path",
  "validationStatus": "VALIDATED"
}
