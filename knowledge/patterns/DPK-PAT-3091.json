{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3091",
  "title": "Signal: Module with no toolchain directive",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "toolchain"
    }
  },
  "scope": "A go.mod file that declares a go.mod that names no toolchain, so the local one decides.",
  "limitations": "It matches a go.mod that names no toolchain, so the local one decides in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": [],
        "toolchain": "go1.22.7"
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": [],
        "toolchain": "go1.23.1"
      },
      "match": false
    }
  ],
  "fpNotes": "A go.mod that mentions a go.mod that names no toolchain, so the local one decides in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0954"
  ],
  "origin": "original-authored",
  "cell": "sca:go-toolchain-directive-absent",
  "validationStatus": "VALIDATED"
}
