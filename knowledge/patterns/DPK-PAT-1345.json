{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1345",
  "title": "Signal: Plugin object or embed loads over plaintext HTTP on an HTTPS page",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<(?:object|embed)\\b[^>]*\\s(?:data|src)\\s*=\\s*[\"\\']?\\s*http://",
      "requireScheme": "https"
    }
  },
  "scope": "One HTTPS response body containing an object or embed element whose data or src URL starts with http.",
  "limitations": "One response body. The check reports an object or embed element whose URL scheme is http on a page fetched over https; it does not resolve redirects, so an https URL that redirects to http is not reported.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<object data=\"http://media.example/report.pdf\" type=\"application/pdf\"></object>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<embed src='http://media.example/player.swf'>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<object data=\"https://media.example/report.pdf\"></object>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<img src=\"http://cdn.example/a.png\">"
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {},
        "body": "<object data=\"http://media.example/report.pdf\"></object>"
      },
      "match": false
    }
  ],
  "fpNotes": "A template that ships a commented-out element is reported; the finding is the markup, and the owner should confirm the element is not rendered.",
  "linkedRules": [
    "DPK-DAST-276"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-object-http-on-https:object-http-on-https",
  "validationStatus": "VALIDATED"
}
