{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2179",
  "title": "Signal: Dependency declared with an implausibly large major",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^\\d{4,6}\\."
    }
  },
  "scope": "A package.json file that declares a major version far larger than any the project has published.",
  "limitations": "It matches a major version far larger than any the project has published in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "9999.0.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "10000.2.1"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "^4.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A project that legitimately uses date-based majors is still reported; record the exception.",
  "linkedRules": [
    "DPK-SCA-0042"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-huge-major",
  "validationStatus": "VALIDATED"
}
