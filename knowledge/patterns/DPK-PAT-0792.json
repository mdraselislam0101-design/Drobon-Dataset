{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0792",
  "title": "Signal: Guest share access (guest) — review required",
  "targets": [
    "samba"
  ],
  "signal": {
    "kind": "regex",
    "source": "guest ok\\s*=\\s*yes"
  },
  "scope": "Single-line lexical match on Samba settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "guest ok = yes",
      "match": true
    },
    {
      "line": "# audit: guest ok = yes present",
      "match": true
    },
    {
      "line": "guest ok = no",
      "match": false
    },
    {
      "line": "# verified: guest ok = no",
      "match": false
    }
  ],
  "fpNotes": "Public drop shares are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-675"
  ],
  "origin": "original-authored",
  "cell": "sast:samba-share:samba:guest",
  "validationStatus": "VALIDATED"
}
