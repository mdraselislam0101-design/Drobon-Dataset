{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2269",
  "title": "Signal: poetry.lock hash recorded as SHA-1",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "package[].files[].hash",
      "valuePattern": "^sha1:"
    }
  },
  "scope": "A poetry.lock file that declares a locked file hash that uses SHA-1.",
  "limitations": "It matches a locked file hash that uses SHA-1 in the parsed poetry.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "version": "2.32.3",
            "files": [
              {
                "file": "requests-2.32.3.tar.gz",
                "hash": "sha1:aaaabbbbcccc"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "flask",
            "version": "3.0.3",
            "files": [
              {
                "file": "flask-3.0.3-py3-none-any.whl",
                "hash": "sha1:111122223333"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": true
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "requests",
            "version": "2.32.3",
            "files": [
              {
                "file": "requests-2.32.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": false
    },
    {
      "file": "poetry.lock",
      "document": {
        "package": [
          {
            "name": "flask",
            "version": "3.0.3",
            "files": [
              {
                "file": "flask-3.0.3.tar.gz",
                "hash": "sha256:aaaa"
              }
            ]
          }
        ],
        "metadata": {
          "lock-version": "2.0",
          "python-versions": "^3.11"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A poetry.lock that mentions a locked file hash that uses SHA-1 in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0132"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-poetry-lock-sha1",
  "validationStatus": "VALIDATED"
}
