{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3171",
  "title": "Signal: Possible an Astra DB application token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "AstraCS:[A-Za-z0-9+/=]{64,}"
  },
  "scope": "Single-line shape match for an Astra DB application token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"AstraCS:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"AstraCS:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-111"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-4:astra-db-application-token",
  "validationStatus": "VALIDATED"
}
