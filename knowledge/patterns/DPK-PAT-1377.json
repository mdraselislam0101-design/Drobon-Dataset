{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1377",
  "title": "Signal: Xdebug variable dump disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "class='xdebug-var-dump'"
    }
  },
  "scope": "One response body containing the Xdebug dump block.",
  "limitations": "One response body. The check recognises the dump markup; it does not read the dumped values.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/search",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<pre class='xdebug-var-dump' dir='ltr'><b>string</b> 'secret-token' <i>(12)</i></pre>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/search",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<div class='xdebug-var-dump'><small>/var/www/search.php:42:</small><b>int</b> 200</div>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/search",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Search</h1><p>No results.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/search",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "Warning: Undefined array key \"q\" in /var/www/search.php on line 12"
      },
      "match": false
    }
  ],
  "fpNotes": "A PHP tutorial that shows the markup is reported; the plain PHP var_dump() output without Xdebug is not matched by this rule and is covered by DPK-DAST-067 when it carries a source path.",
  "linkedRules": [
    "DPK-DAST-308"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-xdebug-var-dump:xdebug-dump",
  "validationStatus": "VALIDATED"
}
