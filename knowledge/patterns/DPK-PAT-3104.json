{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3104",
  "title": "Signal: Locked dependency with an empty content hash",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*.*.contentHash",
      "valuePattern": "^$"
    }
  },
  "scope": "A packages.lock.json file that declares a `contentHash` field that is present but empty.",
  "limitations": "It matches a `contentHash` field that is present but empty in the parsed packages.lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3",
              "contentHash": ""
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            },
            "Dapper": {
              "type": "Direct",
              "resolved": "2.1.35",
              "contentHash": ""
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3",
              "contentHash": "9f2c3d4e"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            },
            "Dapper": {
              "type": "Direct",
              "resolved": "2.1.35",
              "contentHash": "a1b2c3d4"
            }
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A packages.lock.json that mentions a `contentHash` field that is present but empty in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0967"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-lock-content-hash-missing-target",
  "validationStatus": "VALIDATED"
}
