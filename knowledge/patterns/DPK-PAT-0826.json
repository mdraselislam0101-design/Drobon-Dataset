{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0826",
  "title": "Signal: Server-side fetch of assembled URL (ocaml) — review required",
  "targets": [
    "ocaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "Client\\.get\\s*\\([^)]*\\^"
  },
  "scope": "Single-line lexical match on assembled fetch URLs in ocaml code.",
  "limitations": "Lexical, line-based: any assembled fetch URL matches.",
  "examples": [
    {
      "line": "Client.get (u ^ p)",
      "match": true
    },
    {
      "line": "# audit: Client.get (u ^ p) present",
      "match": true
    },
    {
      "line": "Client.get fixed",
      "match": false
    },
    {
      "line": "# verified: Client.get fixed",
      "match": false
    }
  ],
  "fpNotes": "Fixed hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-709"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-4:ocaml",
  "validationStatus": "VALIDATED"
}
