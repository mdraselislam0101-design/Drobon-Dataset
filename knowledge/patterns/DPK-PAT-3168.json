{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3168",
  "title": "Signal: Hex dependency overrides the resolved version",
  "targets": [
    "hex"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "deps[].override",
      "valuePattern": "^true$"
    }
  },
  "scope": "A mix.exs file that declares an `override: true` flag that pins a version across the tree.",
  "limitations": "It matches an `override: true` flag that pins a version across the tree in the parsed mix.exs; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "jason",
            "requirement": "~> 1.4",
            "override": true
          }
        ]
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "plug",
            "requirement": "~> 1.16",
            "override": "true"
          }
        ]
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "phoenix",
            "requirement": "~> 1.7"
          }
        ]
      },
      "match": false
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "ecto",
            "requirement": "~> 3.12",
            "override": false
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A mix.exs that mentions an `override: true` flag that pins a version across the tree in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1031"
  ],
  "origin": "original-authored",
  "cell": "sca:hex-dependency-override",
  "validationStatus": "VALIDATED"
}
