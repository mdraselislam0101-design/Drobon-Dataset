{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0644",
  "title": "Signal: Dynamic load via plugin.Open (go) — review required",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:plugin\\.Open)\\s*\\("
  },
  "scope": "Single-line lexical match on the plugin.Open call in go code.",
  "limitations": "Lexical, line-based: any plugin.Open call matches.",
  "examples": [
    {
      "line": "plugin.Open(payload)",
      "match": true
    },
    {
      "line": "out = plugin.Open(data)",
      "match": true
    },
    {
      "line": "mypluginOpen(x)",
      "match": false
    },
    {
      "line": "plugin.Open_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted plugins are the common false positive.",
  "linkedRules": [
    "DPK-SAST-527"
  ],
  "origin": "original-authored",
  "cell": "sast:go-call:go",
  "validationStatus": "VALIDATED"
}
