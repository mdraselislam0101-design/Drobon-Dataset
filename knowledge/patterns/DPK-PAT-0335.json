{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0335",
  "title": "Signal: Weak SSH daemon setting (x11) — review required",
  "targets": [
    "sshd"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:X11Forwarding\\s+yes)"
  },
  "scope": "Single-line lexical match on sshd settings (x11).",
  "limitations": "Lexical, line-based: matches the setting regardless of network exposure.",
  "examples": [
    {
      "line": "X11Forwarding yes",
      "match": true
    },
    {
      "line": "# audit: X11Forwarding yes present",
      "match": true
    },
    {
      "line": "X11Forwarding no",
      "match": false
    },
    {
      "line": "# verified: X11Forwarding no",
      "match": false
    }
  ],
  "fpNotes": "Isolated lab hosts are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-296"
  ],
  "origin": "original-authored",
  "cell": "sast:ssh-strict:sshd:x11",
  "validationStatus": "VALIDATED"
}
