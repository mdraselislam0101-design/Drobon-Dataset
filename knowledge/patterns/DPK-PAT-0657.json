{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0657",
  "title": "Signal: SnakeYAML unsafe load (java) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:new Yaml\\s*\\(\\s*\\)\\s*\\.load\\s*\\()"
  },
  "scope": "Single-line lexical match on YAML loads in java code.",
  "limitations": "Lexical, line-based: matches the load.",
  "examples": [
    {
      "line": "new Yaml().load(doc)",
      "match": true
    },
    {
      "line": "# audit: new Yaml().load(doc) present",
      "match": true
    },
    {
      "line": "new Yaml(safe).load(doc)",
      "match": false
    },
    {
      "line": "# verified: new Yaml(safe).load(doc)",
      "match": false
    }
  ],
  "fpNotes": "Trusted config is the common false positive.",
  "linkedRules": [
    "DPK-SAST-540"
  ],
  "origin": "original-authored",
  "cell": "sast:java-deser-flag:java",
  "validationStatus": "VALIDATED"
}
