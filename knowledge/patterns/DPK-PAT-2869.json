{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2869",
  "title": "Signal: Hex dependency declared from a local path",
  "targets": [
    "hex"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "deps[].path",
      "valuePattern": "^\\.{0,2}/"
    }
  },
  "scope": "A mix.exs file that declares a dependency resolved from a directory on the build machine.",
  "limitations": "It matches a dependency resolved from a directory on the build machine in the parsed mix.exs; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "acme_core",
            "path": "../acme_core"
          }
        ]
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "acme_sdk",
            "path": "/opt/vendor/acme_sdk"
          }
        ]
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "phoenix",
            "requirement": "~> 1.7"
          }
        ]
      },
      "match": false
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "jason",
            "requirement": "~> 1.4"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A mix.exs that mentions a dependency resolved from a directory on the build machine in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0732"
  ],
  "origin": "original-authored",
  "cell": "sca:hex-dependency-path",
  "validationStatus": "VALIDATED"
}
