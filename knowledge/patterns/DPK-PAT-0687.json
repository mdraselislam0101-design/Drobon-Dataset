{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0687",
  "title": "Signal: JWT verification skipped (ignoreexp) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:verify\\s*\\([^)]*ignoreExpiration\\s*:\\s*true)"
  },
  "scope": "Single-line lexical match on JWT verification (ignoreexp).",
  "limitations": "Lexical, line-based: matches the skip.",
  "examples": [
    {
      "line": "jwt.verify(t, k, {ignoreExpiration: true})",
      "match": true
    },
    {
      "line": "# audit: jwt.verify(t, k, {ignoreExpiration: true}) present",
      "match": true
    },
    {
      "line": "jwt.verify(t, k, {})",
      "match": false
    },
    {
      "line": "# verified: jwt.verify(t, k, {})",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive.",
  "linkedRules": [
    "DPK-SAST-570"
  ],
  "origin": "original-authored",
  "cell": "sast:jwt-verify-off:javascript:ignoreexp",
  "validationStatus": "VALIDATED"
}
