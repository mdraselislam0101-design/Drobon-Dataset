{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1226",
  "title": "Signal: Referrer-Policy names no policy a browser recognises",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Referrer-Policy",
      "valuePattern": "^(?!\\s*(?:no-referrer|no-referrer-when-downgrade|origin|origin-when-cross-origin|same-origin|strict-origin|strict-origin-when-cross-origin|unsafe-url)\\s*(?:,|$))(?![\\s\\S]*,\\s*(?:no-referrer|no-referrer-when-downgrade|origin|origin-when-cross-origin|same-origin|strict-origin|strict-origin-when-cross-origin|unsafe-url)\\s*(?:,|$))\\s*\\S"
    }
  },
  "scope": "One response whose Referrer-Policy header contains tokens but none of them is a defined policy.",
  "limitations": "One header value. The rule reports that no token is recognised; it does not evaluate which default the deployed browser then applies, and a header with at least one recognised token is left to the value rules.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "same-orign"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "no-referrer, bogus"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "bogus, no-referrer"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "strict-origin-when-cross-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "   "
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A future policy token would be reported until the rule list is updated; the eight tokens above are the ones the specification defines.",
  "linkedRules": [
    "DPK-DAST-157"
  ],
  "origin": "original-authored",
  "cell": "dast:referrer-policy-unrecognised-token:unrecognised-token",
  "validationStatus": "VALIDATED"
}
