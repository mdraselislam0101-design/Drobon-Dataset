{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0541",
  "title": "Signal: Framework SQL built from input (drupal) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "db_query\\s*\\([^)]*(?:\"[^\"\\n]*\\$|\\.\\s*\\$)"
  },
  "scope": "Single-line lexical match on assembled framework SQL (drupal).",
  "limitations": "Lexical, line-based: any assembled query matches, including trusted ones.",
  "examples": [
    {
      "line": "db_query(\"SELECT $q\")",
      "match": true
    },
    {
      "line": "# audit: db_query(\"SELECT $q\") present",
      "match": true
    },
    {
      "line": "db_query($fixed)",
      "match": false
    },
    {
      "line": "# verified: db_query($fixed)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-444"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli:php:drupal",
  "validationStatus": "VALIDATED"
}
