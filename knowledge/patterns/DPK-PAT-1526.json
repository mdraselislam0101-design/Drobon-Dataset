{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1526",
  "title": "Signal: Secret field served in a JSON response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "\"(?:secret|app_secret)\"\\s*:\\s*\"[^\"]{8,}\""
    }
  },
  "scope": "A JSON body with a secret-named key and a quoted value.",
  "limitations": "One response body. The rule reads the field name and a quoted value of at least eight characters.",
  "examples": [
    {
      "observation": {
        "url": "https://api.example/tenants/3/settings",
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "{\"tenant\":3,\"app_secret\":\"abcdef0123456789-example\",\"scope\":\"read\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/integrations/9",
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "{\"integration\":9,\"secret\":\"tenant-shared-example\"}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/docs/tenant",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "<html><body><h1>Tenant settings</h1><p>The secret is stored in the vault and never returned by this endpoint.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A configuration reference page without a value is not reported.",
  "linkedRules": [
    "DPK-DAST-457"
  ],
  "origin": "original-authored",
  "cell": "dast:cred-json-secret-field:cred-json-secret-field",
  "validationStatus": "VALIDATED"
}
