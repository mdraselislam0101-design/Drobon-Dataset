{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0752",
  "title": "Signal: Weak proxy or service setting (tlsonly) — review required",
  "targets": [
    "postfix"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:smtpd_tls_auth_only\\s*=\\s*no)"
  },
  "scope": "Single-line lexical match on service settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "smtpd_tls_auth_only = no",
      "match": true
    },
    {
      "line": "# audit: smtpd_tls_auth_only = no present",
      "match": true
    },
    {
      "line": "smtpd_tls_auth_only = yes",
      "match": false
    },
    {
      "line": "# verified: smtpd_tls_auth_only = yes",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-635"
  ],
  "origin": "original-authored",
  "cell": "sast:proxy-misc:postfix:tlsonly",
  "validationStatus": "VALIDATED"
}
