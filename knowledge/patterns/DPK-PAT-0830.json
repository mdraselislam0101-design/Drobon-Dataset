{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0830",
  "title": "Signal: Weak Terraform setting (ignoreall) — review required",
  "targets": [
    "terraform"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:ignore_changes\\s*=\\s*all)"
  },
  "scope": "Single-line lexical match on Terraform files.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "ignore_changes = all",
      "match": true
    },
    {
      "line": "# audit: ignore_changes = all present",
      "match": true
    },
    {
      "line": "ignore_changes = [tags]",
      "match": false
    },
    {
      "line": "# verified: ignore_changes = [tags]",
      "match": false
    }
  ],
  "fpNotes": "Ephemeral environments are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-713"
  ],
  "origin": "original-authored",
  "cell": "sast:tf-more:hcl:ignoreall",
  "validationStatus": "VALIDATED"
}
