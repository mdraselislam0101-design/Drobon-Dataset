{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0574",
  "title": "Signal: Weak response control (HSTS without includeSubDomains)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-missing-directive",
      "header": "Strict-Transport-Security",
      "directive": "includeSubDomains"
    }
  },
  "scope": "Single response header value.",
  "limitations": "One header value. It does not enumerate subdomains or prove that a plaintext subdomain exists; the finding is the policy gap, not an observed downgrade. A response with no Strict-Transport-Security header also matches; DPK-DAST-016 reports that absence.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=1000"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Strict-Transport-Security": "max-age=1; includeSubDomains"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "CDN behaviors are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-049"
  ],
  "origin": "original-authored",
  "cell": "dast:response-weak-2:hsts-nosub",
  "validationStatus": "VALIDATED"
}
