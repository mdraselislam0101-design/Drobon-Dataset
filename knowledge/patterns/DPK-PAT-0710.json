{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0710",
  "title": "Signal: Sensitive value in log call (pascal) — review required",
  "targets": [
    "pascal"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:WriteLn\\s*\\([^)]*(?:password|passwd|secret|token))"
  },
  "scope": "Single-line lexical match on credential-named log values in pascal code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "WriteLn('password=', p)",
      "match": true
    },
    {
      "line": "# audit: WriteLn('password=', p) present",
      "match": true
    },
    {
      "line": "WriteLn('user=', u)",
      "match": false
    },
    {
      "line": "# verified: WriteLn('user=', u)",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-593"
  ],
  "origin": "original-authored",
  "cell": "sast:log-4:pascal",
  "validationStatus": "VALIDATED"
}
