{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1463",
  "title": "Signal: MLflow tracking UI is reachable without authentication",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<title>[^<]{0,60}MLflow"
    }
  },
  "scope": "One response body containing the MLflow UI shell.",
  "limitations": "One response body. The rule reports the UI shell; it does not download an artefact.",
  "examples": [
    {
      "observation": {
        "url": "https://ml.example/mlflow/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>MLflow</title></head><body><div id=\"root\" data-mlflow-version=\"2.11\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://ml.example/mlflow/#/experiments/1",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>MLflow · experiments</title></head><body><p>3 runs</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>ML guide</title></head><body><p>Start the server with mlflow server.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/predict",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"label\":\"ok\"}"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that names MLflow in prose is not reported, because the shell marker is required.",
  "linkedRules": [
    "DPK-DAST-394"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-console-mlflow:mlflow-ui",
  "validationStatus": "VALIDATED"
}
