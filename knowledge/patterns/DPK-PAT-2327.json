{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2327",
  "title": "Signal: Cargo dependency installed from a git remote",
  "targets": [
    "cargo"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*.git",
      "valuePattern": "^https?://"
    }
  },
  "scope": "A Cargo.toml file that declares a dependency sourced from a git remote rather than crates.io.",
  "limitations": "It matches a dependency sourced from a git remote rather than crates.io in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_sdk": {
            "git": "https://github.com/acme/sdk",
            "tag": "v4.2.0"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_cli": {
            "git": "https://github.com/acme/cli"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_sdk": {
            "version": "4.2.0"
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_cli": {
            "version": "2.1.0"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Cargo.toml that mentions a dependency sourced from a git remote rather than crates.io in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0190"
  ],
  "origin": "original-authored",
  "cell": "sca:cargo-dependency-git",
  "validationStatus": "VALIDATED"
}
