{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1120",
  "title": "Signal: Cross-origin credentials enabled in javascript — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Access-Control-Allow-Credentials['\"]?\\s*,\\s*['\"]true['\"])"
  },
  "scope": "Single-line match on credentials-enabled CORS in javascript.",
  "limitations": "Lexical: matches the literal header value; the origin decision in another middleware is out of scope.",
  "examples": [
    {
      "line": "res.setHeader('Access-Control-Allow-Credentials', 'true');",
      "match": true
    },
    {
      "line": "# audit: res.setHeader('Access-Control-Allow-Credentials', 'true'); present",
      "match": true
    },
    {
      "line": "res.setHeader('Access-Control-Allow-Credentials', 'false');",
      "match": false
    },
    {
      "line": "# verified: res.setHeader('Access-Control-Allow-Credentials', 'false');",
      "match": false
    }
  ],
  "fpNotes": "An API that deliberately serves a fixed first-party frontend is the accepted exception.",
  "linkedRules": [
    "DPK-SAST-935"
  ],
  "origin": "original-authored",
  "cell": "sast:js-cors-credentials:javascript",
  "validationStatus": "VALIDATED"
}
