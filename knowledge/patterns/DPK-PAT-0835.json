{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0835",
  "title": "Signal: TLS verification disabled (insecure) — review required",
  "targets": [
    "clojure"
  ],
  "signal": {
    "kind": "regex",
    "source": ":insecure\\?\\s+true"
  },
  "scope": "Single-line lexical match on TLS-disabling settings (insecure).",
  "limitations": "Lexical, line-based: matches the switch regardless of environment.",
  "examples": [
    {
      "line": "{:insecure? true}",
      "match": true
    },
    {
      "line": "# audit: {:insecure? true} present",
      "match": true
    },
    {
      "line": "{:insecure? false}",
      "match": false
    },
    {
      "line": "# verified: {:insecure? false}",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive.",
  "linkedRules": [
    "DPK-SAST-718"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-4:clojure:insecure",
  "validationStatus": "VALIDATED"
}
