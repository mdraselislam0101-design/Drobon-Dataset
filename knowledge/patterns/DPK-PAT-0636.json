{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0636",
  "title": "Signal: Open FTP setting (write) — review required",
  "targets": [
    "vsftpd"
  ],
  "signal": {
    "kind": "regex",
    "source": "write_enable\\s*=\\s*YES"
  },
  "scope": "Single-line lexical match on FTP settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "write_enable=YES",
      "match": true
    },
    {
      "line": "# audit: write_enable=YES present",
      "match": true
    },
    {
      "line": "write_enable=NO",
      "match": false
    },
    {
      "line": "# verified: write_enable=NO",
      "match": false
    }
  ],
  "fpNotes": "Public mirrors are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-519"
  ],
  "origin": "original-authored",
  "cell": "sast:ftp-config:vsftpd:write",
  "validationStatus": "VALIDATED"
}
