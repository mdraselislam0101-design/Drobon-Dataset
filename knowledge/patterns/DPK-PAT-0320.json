{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0320",
  "title": "Signal: SQL built by concatenation (groovy) — review required",
  "targets": [
    "groovy"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.execute\\s*\\((?:[^()]|\\([^()]*\\))*(?:\\+|\\$\\{)"
  },
  "scope": "Single-line lexical match on concatenated SQL in groovy code.",
  "limitations": "Lexical, line-based: any concatenated query matches, including trusted assembly. Input trust needs human review.",
  "examples": [
    {
      "line": "sql.execute(\"SELECT \" + id)",
      "match": true
    },
    {
      "line": "# audit: sql.execute(\"SELECT \" + id) present",
      "match": true
    },
    {
      "line": "sql.execute(FIXED)",
      "match": false
    },
    {
      "line": "# verified: sql.execute(FIXED)",
      "match": false
    },
    {
      "line": "sql.execute(buildStmt(name) + \" -- x\")",
      "match": true
    },
    {
      "line": "sql.execute(\"SELECT * FROM users WHERE name = '${name}'\")",
      "match": true
    },
    {
      "line": "sql.execute(\"SELECT COUNT(*) FROM users\")",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed column lists or trusted fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-281"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-concat:groovy",
  "validationStatus": "VALIDATED"
}
