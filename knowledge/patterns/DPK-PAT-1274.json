{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1274",
  "title": "Signal: Content-Security-Policy script-src allows wasm-unsafe-eval",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "(?:^|;)\\s*script-src\\s[^;]*(?<=\\s)'wasm-unsafe-eval'(?=[\\s;]|$)"
    }
  },
  "scope": "One response whose Content-Security-Policy script-src directive contains the `'wasm-unsafe-eval'` keyword.",
  "limitations": "One header value and one directive. The rule reports the keyword in script-src; it does not inspect which module the page loads or whether compilation is reachable from an injection point.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self' 'wasm-unsafe-eval'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; script-src 'wasm-unsafe-eval'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self' 'unsafe-eval'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "The keyword permits compilation; the rule does not prove that any WebAssembly module is served or reachable.",
  "linkedRules": [
    "DPK-DAST-205"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-scriptsrc-wasm-unsafe-eval:scriptsrc-wasm-unsafe-eval",
  "validationStatus": "VALIDATED"
}
