{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3090",
  "title": "Signal: Indirect requirement written by hand",
  "targets": [
    "go"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "require[].indirect",
      "valuePattern": "^true$"
    }
  },
  "scope": "A go.mod file that declares a `require` entry marked `// indirect` in the module file.",
  "limitations": "It matches a `require` entry marked `// indirect` in the module file in the parsed go.mod; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0",
            "indirect": true
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0",
            "indirect": "true"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": true
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/acme/sdk",
            "version": "v4.2.0",
            "indirect": false
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": false
    },
    {
      "file": "go.mod",
      "document": {
        "module": "example.com/demo-service",
        "go": "1.22",
        "require": [
          {
            "module": "github.com/stretchr/testify",
            "version": "v1.9.0"
          }
        ],
        "replace": [],
        "exclude": []
      },
      "match": false
    }
  ],
  "fpNotes": "A go.mod that mentions a `require` entry marked `// indirect` in the module file in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0953"
  ],
  "origin": "original-authored",
  "cell": "sca:go-require-indirect-marker",
  "validationStatus": "VALIDATED"
}
