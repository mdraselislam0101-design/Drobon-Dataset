{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0543",
  "title": "Signal: Framework SQL built from input (wordpress) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\$wpdb->query\\s*\\([^)]*(?:\"[^\"\\n]*\\$|\\.\\s*\\$)"
  },
  "scope": "Single-line lexical match on assembled framework SQL (wordpress).",
  "limitations": "Lexical, line-based: any assembled query matches, including trusted ones.",
  "examples": [
    {
      "line": "$wpdb->query(\"SELECT $q\")",
      "match": true
    },
    {
      "line": "# audit: $wpdb->query(\"SELECT $q\") present",
      "match": true
    },
    {
      "line": "$wpdb->query($fixed)",
      "match": false
    },
    {
      "line": "# verified: $wpdb->query($fixed)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-446"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli:php:wordpress",
  "validationStatus": "VALIDATED"
}
