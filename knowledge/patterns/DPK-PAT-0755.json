  "title": "Signal: Dynamic execution via compile (python) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:compile)\\s*\\("
  },
  "scope": "Single-line lexical match on the compile call in python code.",
  "limitations": "Lexical, line-based: any compile call matches.",
  "examples": [
    {
      "line": "compile(payload)",
      "match": true
    },
    {
      "line": "out = compile(data)",
      "match": true
    },
    {
      "line": "mycompile(x)",
      "match": false
    },
    {
      "line": "compile_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted tooling is the common false positive.",
  "linkedRules": [
    "DPK-SAST-638"
  ],
