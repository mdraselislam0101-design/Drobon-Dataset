{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1437",
  "title": "Signal: CakePHP Debug Kit toolbar disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*debug-kit-toolbar)(?=[\\s\\S]*CakePHP)"
    }
  },
  "scope": "One response body containing the Debug Kit toolbar container alongside the framework name.",
  "limitations": "One response body. The rule reports the toolbar container; it does not follow its panel links.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/invoices",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Invoices</h1><div id=\"debug-kit-toolbar\" class=\"cakephp-debug-kit\"><span>CakePHP 4.4.10</span></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/reports",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<div id=\"debug-kit-toolbar\"><a href=\"/debug-kit/panels/view/sql-log\">Sql log</a><a href=\"/debug-kit/panels/view/variables\">Variables</a><small>CakePHP</small></div>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/invoices",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Invoices</h1><p>3 open invoices.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/debug",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Install the Debug Kit plugin only in development.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that mentions DebugKit in prose is not reported, because the toolbar container id is required.",
  "linkedRules": [
    "DPK-DAST-368"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-page-cakephp-debugkit:cakephp-debugkit",
  "validationStatus": "VALIDATED"
}
