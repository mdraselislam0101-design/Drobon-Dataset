{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1106",
  "title": "Signal: Operating-system command executed from an R string in r — review required",
  "targets": [
    "r"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bsystem2?\\s*\\(\\s*(?:paste|paste0|sprintf|str_c)\\s*\\("
  },
  "scope": "Single-line match on system execution in r.",
  "limitations": "Lexical: matches system and system2 calls; a constant command in a notebook is still reported.",
  "examples": [
    {
      "line": "system(paste(\"convert\", user_file, \"out.png\"))",
      "match": true
    },
    {
      "line": "# audit: system(paste(\"convert\", user_file, \"out.png\")) present",
      "match": true
    },
    {
      "line": "system2(\"convert\", args = c(user_file, \"out.png\"))",
      "match": false
    },
    {
      "line": "# verified: system2(\"convert\", args = c(user_file, \"out.png\"))",
      "match": false
    }
  ],
  "fpNotes": "Constant commands in analysis scripts are the accepted false positives.",
  "linkedRules": [
    "DPK-SAST-923"
  ],
  "origin": "original-authored",
  "cell": "sast:r-system-call:r",
  "validationStatus": "VALIDATED"
}
