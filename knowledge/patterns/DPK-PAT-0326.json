{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0326",
  "title": "Signal: SQL built by concatenation (kotlin) — review required",
  "targets": [
    "kotlin"
  ],
  "signal": {
    "kind": "regex",
    "source": "exec\\s*\\([^)]*\\+"
  },
  "scope": "Single-line lexical match on assembled SQL in kotlin code.",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "exec(\"SELECT \" + q)",
      "match": true
    },
    {
      "line": "# audit: exec(\"SELECT \" + q) present",
      "match": true
    },
    {
      "line": "exec(FIXED)",
      "match": false
    },
    {
      "line": "# verified: exec(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-287"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-langs:kotlin",
  "validationStatus": "VALIDATED"
}
