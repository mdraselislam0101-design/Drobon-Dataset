{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0063",
  "title": "Signal: Risky CI setting (prtarget) — review required",
  "targets": [
    "yaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "pull_request_target"
  },
  "scope": "Single-line lexical match on risky CI settings (prtarget).",
  "limitations": "Lexical, line-based: matches the setting regardless of repository trust.",
  "examples": [
    {
      "line": "on: [pull_request_target]",
      "match": true
    },
    {
      "line": "# audit: on: [pull_request_target] present",
      "match": true
    },
    {
      "line": "on: [pull_request]",
      "match": false
    },
    {
      "line": "# verified: on: [pull_request]",
      "match": false
    }
  ],
  "fpNotes": "Trusted private repositories are the common accepted case — confirm trust.",
  "linkedRules": [
    "DPK-SAST-024"
  ],
  "origin": "original-authored",
  "cell": "sast:ci-risky:yaml:prtarget",
  "validationStatus": "VALIDATED"
}
