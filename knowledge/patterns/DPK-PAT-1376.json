{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1376",
  "title": "Signal: Symfony VarDumper output disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "class=\"sf-dump"
    }
  },
  "scope": "One response body containing the VarDumper block markup.",
  "limitations": "One response body. The check recognises the dump markup; it does not enumerate which values were printed.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/cart",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><pre class=\"sf-dump sf-dump-1234\"><span class=\"sf-dump-note\">Cart</span></pre></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/cart/9",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<td><div class=\"sf-dump sf-dump-77\">array:1 [ 0 =&gt; \"x\" ]</div></td>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/cart",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Your cart</h1><p>2 items</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/cart",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"sf-toolbar\" class=\"sf-toolbar\">Symfony Profiler</div></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A Symfony documentation page that shows the markup is reported; the profiler toolbar (DPK-DAST-244) and a plain debug print are not, because they carry different markers.",
  "linkedRules": [
    "DPK-DAST-307"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-symfony-var-dumper:symfony-var-dumper",
  "validationStatus": "VALIDATED"
}
