{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2201",
  "title": "Signal: Lockfile entry without licence metadata",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "packages",
      "field": "license"
    }
  },
  "scope": "A package-lock.json file that declares a package entry that records no licence.",
  "limitations": "It matches a package entry that records no licence in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "license": "MIT"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "license": "Apache-2.0"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A package whose licence file exists but is not in the registry metadata is still reported; the lockfile is the evidence.",
  "linkedRules": [
    "DPK-SCA-0064"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-license-absent",
  "validationStatus": "VALIDATED"
}
