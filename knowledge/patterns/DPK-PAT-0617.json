{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0617",
  "title": "Signal: Unsafe decoding via Marshal.from_string (ocaml) — review required",
  "targets": [
    "ocaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Marshal\\.from_string)\\s*\\("
  },
  "scope": "Single-line lexical match on the Marshal.from_string call in ocaml code.",
  "limitations": "Lexical, line-based: any Marshal.from_string call matches.",
  "examples": [
    {
      "line": "Marshal.from_string(payload)",
      "match": true
    },
    {
      "line": "out = Marshal.from_string(data)",
      "match": true
    },
    {
      "line": "myMarshalfrom_string(x)",
      "match": false
    },
    {
      "line": "Marshal.from_string_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted local data is the common false positive.",
  "linkedRules": [
    "DPK-SAST-500"
  ],
  "origin": "original-authored",
  "cell": "sast:deser-3:ocaml",
  "validationStatus": "VALIDATED"
}
