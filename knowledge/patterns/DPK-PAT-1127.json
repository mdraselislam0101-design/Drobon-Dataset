{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1127",
  "title": "Signal: Operating-system command executed from a runtime string in v — review required",
  "targets": [
    "v"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bos\\.exec\\s*\\("
  },
  "scope": "Single-line match on os.exec in v.",
  "limitations": "Lexical: matches os.exec calls; a constant command in tooling is still reported.",
  "examples": [
    {
      "line": "os.exec(\"convert ${user_file} out.png\")",
      "match": true
    },
    {
      "line": "# audit: os.exec(\"convert ${user_file} out.png\") present",
      "match": true
    },
    {
      "line": "run_validated(\"convert\", [user_file, \"out.png\"])",
      "match": false
    },
    {
      "line": "# verified: run_validated(\"convert\", [user_file, \"out.png\"])",
      "match": false
    }
  ],
  "fpNotes": "Constant commands in build scripts are the accepted false positives.",
  "linkedRules": [
    "DPK-SAST-942"
  ],
  "origin": "original-authored",
  "cell": "sast:v-os-exec:v",
  "validationStatus": "VALIDATED"
}
