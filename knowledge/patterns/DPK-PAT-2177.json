{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2177",
  "title": "Signal: Dependency installed from a plain tarball URL",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^https?://(?!registry\\.npmjs\\.org)[^ ]{1,200}\\.(?:tgz|tar\\.gz)$"
    }
  },
  "scope": "A package.json file that declares a dependency URL that points at a tarball outside the configured registry.",
  "limitations": "It matches a dependency URL that points at a tarball outside the configured registry in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "https://downloads.acme.example/sdk-4.2.0.tgz"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "http://mirror.acme.example/cli.tar.gz"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "https://registry.npmjs.org/acme-sdk/-/acme-sdk-4.2.0.tgz"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A registry tarball URL written by a mirror configuration is a separate finding; this rule reports deployment-owned URLs.",
  "linkedRules": [
    "DPK-SCA-0040"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-tarball-url",
  "validationStatus": "VALIDATED"
}
