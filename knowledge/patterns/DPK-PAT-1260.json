{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1260",
  "title": "Signal: Cross-Origin-Resource-Policy value is not a recognised token",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Cross-Origin-Resource-Policy",
      "valuePattern": "^\\s*(?!same-origin\\s*$)(?!same-site\\s*$)(?!cross-origin\\s*$)\\S"
    }
  },
  "scope": "One response whose Cross-Origin-Resource-Policy value is not a defined token.",
  "limitations": "One header value. The rule validates the token and does not observe whether any other origin actually embeds the resource.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Resource-Policy": "same_origin"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Resource-Policy": "sameorigin"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Resource-Policy": "same-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Resource-Policy": "cross-origin"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "The token is validated as written; no claim is made about which origin would embed the resource.",
  "linkedRules": [
    "DPK-DAST-191"
  ],
  "origin": "original-authored",
  "cell": "dast:corp-unknown-token:unknown-token",
  "validationStatus": "VALIDATED"
}
