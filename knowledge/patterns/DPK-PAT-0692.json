{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0692",
  "title": "Signal: Permissive Kubernetes pod (hostipc) — review required",
  "targets": [
    "k8s"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:hostIPC\\s*:\\s*true)"
  },
  "scope": "Single-line lexical match on Kubernetes manifests.",
  "limitations": "Lexical, line-based: matches the grant.",
  "examples": [
    {
      "line": "hostIPC: true",
      "match": true
    },
    {
      "line": "# audit: hostIPC: true present",
      "match": true
    },
    {
      "line": "hostIPC: false",
      "match": false
    },
    {
      "line": "# verified: hostIPC: false",
      "match": false
    }
  ],
  "fpNotes": "Node agents are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-575"
  ],
  "origin": "original-authored",
  "cell": "sast:k8s-more:k8s:hostipc",
  "validationStatus": "VALIDATED"
}
