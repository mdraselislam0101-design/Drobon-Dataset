{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0711",
  "title": "Signal: Password never expires (logindefs) — review required",
  "targets": [
    "logindefs"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:PASS_MAX_DAYS\\s+99999)"
  },
  "scope": "Single-line lexical match on login.defs.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "PASS_MAX_DAYS 99999",
      "match": true
    },
    {
      "line": "# audit: PASS_MAX_DAYS 99999 present",
      "match": true
    },
    {
      "line": "PASS_MAX_DAYS 90",
      "match": false
    },
    {
      "line": "# verified: PASS_MAX_DAYS 90",
      "match": false
    }
  ],
  "fpNotes": "Service accounts with rotation elsewhere are the accepted case.",
  "linkedRules": [
    "DPK-SAST-594"
  ],
  "origin": "original-authored",
  "cell": "sast:login-defs:logindefs:maxdays",
  "validationStatus": "VALIDATED"
}
