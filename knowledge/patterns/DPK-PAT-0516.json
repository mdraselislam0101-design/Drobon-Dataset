{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0516",
  "title": "Signal: Possible a Slack webhook URL in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "hooks\\.slack\\.com/services/T[A-Z0-9]{8,}/B[A-Z0-9]{8,}/[A-Za-z0-9]{24,}"
  },
  "scope": "Single-line shape match for a Slack webhook URL.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "url = \"hooks.slack.com/services/TAAAAAAAA/BAAAAAAAA/AAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: url = \"hooks.slack.com/services/TAAAAAAAA/BAAAAAAAA/AAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "url = \"xy\"",
      "match": false
    },
    {
      "line": "url = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-050"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:slack-webhook",
  "validationStatus": "VALIDATED"
}
