{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0640",
  "title": "Signal: Risky GitHub Actions step (unpinned) — review required",
  "targets": [
    "gha"
  ],
  "signal": {
    "kind": "regex",
    "source": "uses\\s*:\\s*[^:\\n]+@(?:main|master|v[0-9]+)\\b"
  },
  "scope": "Single-line lexical match on workflow files.",
  "limitations": "Lexical, line-based: matches the step.",
  "examples": [
    {
      "line": "uses: actions/checkout@v4",
      "match": true
    },
    {
      "line": "# audit: uses: actions/checkout@v4 present",
      "match": true
    },
    {
      "line": "uses: actions/checkout@a5ac7e51b41094c92402da3b243769053744a45e2",
      "match": false
    },
    {
      "line": "# verified: uses: actions/checkout@a5ac7e51b41094c92402da3b243769053744a45e2",
      "match": false
    }
  ],
  "fpNotes": "Trusted first-party actions are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-523"
  ],
  "origin": "original-authored",
  "cell": "sast:gha-more:gha:unpinned",
  "validationStatus": "VALIDATED"
}
