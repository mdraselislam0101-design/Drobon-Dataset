{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1201",
  "title": "Signal: GraphQL introspection result disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*\"__schema\")(?=[\\s\\S]*\"queryType\")"
    }
  },
  "scope": "One response whose body contains a __schema object and a queryType entry.",
  "limitations": "Two body markers. A GraphQL error response or a page that quotes a schema fragment is not reported unless both markers appear.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/graphql",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"data\":{\"__schema\":{\"queryType\":{\"name\":\"Query\"},\"types\":[{\"name\":\"User\"}]}}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/graphql",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"data\":{\"__schema\":{\"queryType\":{\"name\":\"RootQuery\"},\"mutationType\":{\"name\":\"Mutation\"}}}}"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/graphql",
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"message\":\"introspection is disabled\"}]}"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/graphql",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Use __schema to explore the API during development.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A GraphQL client library page that reproduces an introspection payload is reported only when both markers are in the body.",
  "linkedRules": [
    "DPK-DAST-132"
  ],
  "origin": "original-authored",
  "cell": "dast:body-graphql-introspection:body-graphql-introspection",
  "validationStatus": "VALIDATED"
}
