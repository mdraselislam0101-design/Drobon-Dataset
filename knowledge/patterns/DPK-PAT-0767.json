{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0767",
  "title": "Signal: Cleartext protocol client (xmlrpc) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:ServerProxy\\s*\\(\\s*\"http:)"
  },
  "scope": "Single-line lexical match on cleartext clients (xmlrpc).",
  "limitations": "Lexical, line-based: matches the client.",
  "examples": [
    {
      "line": "ServerProxy(\"http://h/x\")",
      "match": true
    },
    {
      "line": "# audit: ServerProxy(\"http://h/x\") present",
      "match": true
    },
    {
      "line": "ServerProxy(\"https://h/x\")",
      "match": false
    },
    {
      "line": "# verified: ServerProxy(\"https://h/x\")",
      "match": false
    }
  ],
  "fpNotes": "Loopback use is the common accepted case.",
  "linkedRules": [
    "DPK-SAST-650"
  ],
  "origin": "original-authored",
  "cell": "sast:python-net-plain:python:xmlrpc",
  "validationStatus": "VALIDATED"
}
