{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0449",
  "title": "Signal: XPath built by concatenation (java) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "(?:xpath|evaluate)\\s*\\([^)]*\\+"
  },
  "scope": "Single-line lexical match on assembled XPath in java code.",
  "limitations": "Lexical, line-based: any assembled XPath matches, including trusted ones.",
  "examples": [
    {
      "line": "xp.evaluate(\"//u[@id='\" + i + \"']\", d)",
      "match": true
    },
    {
      "line": "# audit: xp.evaluate(\"//u[@id='\" + i + \"']\", d) present",
      "match": true
    },
    {
      "line": "xp.evaluate(FIXED, d)",
      "match": false
    },
    {
      "line": "# verified: xp.evaluate(FIXED, d)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed element paths is the common false positive.",
  "linkedRules": [
    "DPK-SAST-410"
  ],
  "origin": "original-authored",
  "cell": "sast:xpath-inject:java",
  "validationStatus": "VALIDATED"
}
