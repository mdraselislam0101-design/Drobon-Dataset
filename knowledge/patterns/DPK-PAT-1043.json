{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1043",
  "title": "Signal: WebView loads a computed URL in kotlin — review required",
  "targets": [
    "kotlin"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b\\w*[Ww]eb[Vv]iew\\w*\\.loadUrl\\s*\\(\\s*(?![\"'])"
  },
  "scope": "Single-line match on a computed WebView.loadUrl in kotlin.",
  "limitations": "Lexical: matches a non-literal argument on one line; URLs assembled in helpers are out of scope.",
  "examples": [
    {
      "line": "webView.loadUrl(intent.getStringExtra(\"url\"))",
      "match": true
    },
    {
      "line": "# audit: webView.loadUrl(intent.getStringExtra(\"url\")) present",
      "match": true
    },
    {
      "line": "webView.loadUrl(\"https://app.example/help\")",
      "match": false
    },
    {
      "line": "# verified: webView.loadUrl(\"https://app.example/help\")",
      "match": false
    }
  ],
  "fpNotes": "A constant base URL concatenated with a fixed path segment is the accepted false positive.",
  "linkedRules": [
    "DPK-SAST-860"
  ],
  "origin": "original-authored",
  "cell": "sast:kotlin-webview-loadurl:kotlin",
  "validationStatus": "VALIDATED"
}
