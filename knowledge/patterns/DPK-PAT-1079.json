{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1079",
  "title": "Signal: OS command executed from a string in groovy — review required",
  "targets": [
    "groovy"
  ],
  "signal": {
    "kind": "regex",
    "source": "[\"'][^\"'\\n]*[\"']\\.execute\\s*\\("
  },
  "scope": "Single-line match on String.execute in groovy.",
  "limitations": "Lexical: matches .execute() on a string; ProcessBuilder usage is out of scope and is the safer form.",
  "examples": [
    {
      "line": "\"ls ${params.dir}\".execute()",
      "match": true
    },
    {
      "line": "# audit: \"ls ${params.dir}\".execute() present",
      "match": true
    },
    {
      "line": "new ProcessBuilder(\"ls\", params.dir).start()",
      "match": false
    },
    {
      "line": "# verified: new ProcessBuilder(\"ls\", params.dir).start()",
      "match": false
    }
  ],
  "fpNotes": "Constant commands assembled from literals are the accepted false positives.",
  "linkedRules": [
    "DPK-SAST-896"
  ],
  "origin": "original-authored",
  "cell": "sast:groovy-runtime-exec:groovy",
  "validationStatus": "VALIDATED"
}
