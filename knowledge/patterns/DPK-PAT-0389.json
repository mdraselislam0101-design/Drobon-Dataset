{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0389",
  "title": "Signal: TLS verification weakened (unverified) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "_create_unverified_context"
  },
  "scope": "Single-line lexical match on TLS-weakening settings for unverified.",
  "limitations": "Lexical, line-based: matches the setting regardless of environment.",
  "examples": [
    {
      "line": "ssl._create_unverified_context()",
      "match": true
    },
    {
      "line": "# audit: ssl._create_unverified_context() present",
      "match": true
    },
    {
      "line": "ssl.create_default_context()",
      "match": false
    },
    {
      "line": "# verified: ssl.create_default_context()",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-350"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-verify-off-extra:python:unverified",
  "validationStatus": "VALIDATED"
