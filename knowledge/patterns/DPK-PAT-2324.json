{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2324",
  "title": "Signal: NuGet package pinned with a wildcard",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages[].version",
      "valuePattern": "^\\d{1,3}\\.\\d{1,3}\\.\\*$"
    }
  },
  "scope": "A packages.config file that declares a `N.N.*` wildcard pin.",
  "limitations": "It matches a `N.N.*` wildcard pin in the parsed packages.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "packages.config",
      "document": {
        "packages": [
          {
            "id": "Newtonsoft.Json",
            "version": "13.0.*"
          }
        ]
      },
      "match": true
    },
    {
      "file": "packages.config",
      "document": {
        "packages": [
          {
            "id": "Serilog",
            "version": "4.0.*"
          }
        ]
      },
      "match": true
    },
    {
      "file": "packages.config",
      "document": {
        "packages": [
          {
            "id": "Newtonsoft.Json",
            "version": "13.0.3"
          }
        ]
      },
      "match": false
    },
    {
      "file": "packages.config",
      "document": {
        "packages": [
          {
            "id": "Serilog",
            "version": "4.0.1"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A packages.config that mentions a `N.N.*` wildcard pin in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0187"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-dependency-version-wildcard",
  "validationStatus": "VALIDATED"
}
