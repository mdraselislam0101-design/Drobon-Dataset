{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1440",
  "title": "Signal: Jetty default error page disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*HTTP ERROR)(?=[\\s\\S]*Powered by Jetty)"
    }
  },
  "scope": "One response body containing the Jetty default error template and its footer.",
  "limitations": "One response body. The rule recognises the container template; the version it prints may be older than the running build.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/missing",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Error 404 Not Found</title></head><body><h2>HTTP ERROR 404 Not Found</h2><hr><i>Powered by Jetty:// 11.0.15</i></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/boom",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h2>HTTP ERROR 500 Server Error</h2><hr><i>Powered by Jetty:// 9.4.51</i></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/missing",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Page not found</h1><a href=\"/\">Back to the shop</a></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/errors",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Set a custom error handler so the container does not render its default page.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "An application error page that mentions Jetty in a comment is not reported, because both the error heading and the footer are required.",
  "linkedRules": [
    "DPK-DAST-371"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-page-jetty-error:jetty-error-page",
  "validationStatus": "VALIDATED"
}
