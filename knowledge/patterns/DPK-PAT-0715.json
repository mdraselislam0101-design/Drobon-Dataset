{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0715",
  "title": "Signal: Authentication bypass (noauth) — review required",
  "targets": [
    "sudo"
  ],
  "signal": {
    "kind": "regex",
    "source": "!authenticate"
  },
  "scope": "Single-line lexical match on auth configuration.",
  "limitations": "Lexical, line-based: matches the entry.",
  "examples": [
    {
      "line": "Defaults !authenticate",
      "match": true
    },
    {
      "line": "# audit: Defaults !authenticate present",
      "match": true
    },
    {
      "line": "Defaults authenticate",
      "match": false
    },
    {
      "line": "# verified: Defaults authenticate",
      "match": false
    }
  ],
  "fpNotes": "Recovery consoles are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-598"
  ],
  "origin": "original-authored",
  "cell": "sast:pam-unsafe:sudo:noauth",
  "validationStatus": "VALIDATED"
}
