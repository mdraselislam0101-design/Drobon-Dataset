{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2835",
  "title": "Signal: Package repository credential stored in a committed file",
  "targets": [
    "composer"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "http-basic.*.password",
      "valuePattern": "^(?!\\$\\{)[A-Za-z0-9!@#$%^&*._-]{8,40}$"
    }
  },
  "scope": "A auth.json file that declares a literal repository password in `auth.json`.",
  "limitations": "It matches a literal repository password in `auth.json` in the parsed auth.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "auth.json",
      "document": {
        "http-basic": {
          "repo.acme.example": {
            "username": "ci-bot",
            "password": "EXAMPLESECRETVALUE03"
          }
        },
        "github-oauth": {}
      },
      "match": true
    },
    {
      "file": "auth.json",
      "document": {
        "http-basic": {
          "nexus.acme.example": {
            "username": "deploy",
            "password": "EXAMPLESECRETVALUE04"
          }
        },
        "github-oauth": {}
      },
      "match": true
    },
    {
      "file": "auth.json",
      "document": {
        "http-basic": {
          "repo.acme.example": {
            "username": "ci-bot",
            "password": "${COMPOSER_AUTH_PASSWORD}"
          }
        },
        "github-oauth": {}
      },
      "match": false
    },
    {
      "file": "auth.json",
      "document": {
        "http-basic": {},
        "github-oauth": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A auth.json that mentions a literal repository password in `auth.json` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0698"
  ],
  "origin": "original-authored",
  "cell": "sca:composer-auth-password-inline",
  "validationStatus": "VALIDATED"
}
