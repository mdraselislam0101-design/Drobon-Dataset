{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2379",
  "title": "Signal: vcpkg registry without a baseline",
  "targets": [
    "vcpkg"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "registries",
      "field": "baseline"
    }
  },
  "scope": "A vcpkg-configuration.json file that declares a registry entry that records no baseline commit.",
  "limitations": "It matches a registry entry that records no baseline commit in the parsed vcpkg-configuration.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "vcpkg-configuration.json",
      "document": {
        "registries": [
          {
            "kind": "git",
            "repository": "https://git.acme.example/vcpkg-registry"
          }
        ]
      },
      "match": true
    },
    {
      "file": "vcpkg-configuration.json",
      "document": {
        "registries": [
          {
            "kind": "git",
            "repository": "https://git.acme.example/ports"
          }
        ]
      },
      "match": true
    },
    {
      "file": "vcpkg-configuration.json",
      "document": {
        "registries": [
          {
            "kind": "git",
            "repository": "https://git.acme.example/vcpkg-registry",
            "baseline": "9f2c4a1"
          }
        ]
      },
      "match": false
    },
    {
      "file": "vcpkg-configuration.json",
      "document": {
        "registries": [
          {
            "kind": "git",
            "repository": "https://git.acme.example/ports",
            "baseline": "0a1b2c3"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A vcpkg-configuration.json that mentions a registry entry that records no baseline commit in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0242"
  ],
  "origin": "original-authored",
  "cell": "sca:vcpkg-registry-baseline-absent",
  "validationStatus": "VALIDATED"
}
