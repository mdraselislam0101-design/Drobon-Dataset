{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0838",
  "title": "Signal: Pre-check file access via access (c) — review required",
  "targets": [
    "c"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:access)\\s*\\("
  },
  "scope": "Single-line lexical match on the access call in c code.",
  "limitations": "Lexical, line-based: any access call matches.",
  "examples": [
    {
      "line": "access(payload)",
      "match": true
    },
    {
      "line": "out = access(data)",
      "match": true
    },
    {
      "line": "myaccess(x)",
      "match": false
    },
    {
      "line": "access_safe()",
      "match": false
    }
  ],
  "fpNotes": "Display-only checks are the common false positive.",
  "linkedRules": [
    "DPK-SAST-721"
  ],
  "origin": "original-authored",
  "cell": "sast:toctou:c",
  "validationStatus": "VALIDATED"
}
