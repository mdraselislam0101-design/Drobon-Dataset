{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1045",
  "title": "Signal: Subprocess invoked with shell=True in python — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bsubprocess\\.(?:run|call|check_output|check_call|Popen)\\(.*shell\\s*=\\s*True"
  },
  "scope": "Single-line match on shell=True in a subprocess call in python.",
  "limitations": "Lexical: matches shell=True on the same line as a subprocess call.",
  "examples": [
    {
      "line": "subprocess.run(user_cmd, shell=True)",
      "match": true
    },
    {
      "line": "# audit: subprocess.run(user_cmd, shell=True) present",
      "match": true
    },
    {
      "line": "subprocess.run([\"ls\", \"-l\"], shell=False)",
      "match": false
    },
    {
      "line": "# verified: subprocess.run([\"ls\", \"-l\"], shell=False)",
      "match": false
    }
  ],
  "fpNotes": "Constant commands with no external input are the accepted false positives.",
  "linkedRules": [
    "DPK-SAST-862"
  ],
  "origin": "original-authored",
  "cell": "sast:python-subprocess-shell:python",
  "validationStatus": "VALIDATED"
}
