{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0314",
  "title": "Signal: anon left open — review required",
  "targets": [
    "vsftpd"
  ],
  "signal": {
    "kind": "regex",
    "source": "anonymous_enable\\s*=\\s*YES"
  },
  "scope": "Single-line lexical match on open settings for anon.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "anonymous_enable=YES",
      "match": true
    },
    {
      "line": "# audit: anonymous_enable=YES present",
      "match": true
    },
    {
      "line": "anonymous_enable=NO",
      "match": false
    },
    {
      "line": "# verified: anonymous_enable=NO",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-275"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:vsftpd:anon",
  "validationStatus": "VALIDATED"
}
