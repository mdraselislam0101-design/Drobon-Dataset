{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1158",
  "title": "Signal: phpinfo() configuration page disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<title>phpinfo\\(\\)|PHP Version [0-9]+\\.[0-9]+"
    }
  },
  "scope": "One response body: confirm a phpinfo() page.",
  "limitations": "Observation-level: matches the phpinfo title or the version banner it prints. A custom diagnostics page that does not carry those markers is out of scope.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/info.php",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8"
        },
        "body": "<html><head><title>phpinfo()</title></head><body><h1>PHP Version 8.2.4</h1></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/phpinfo.php",
        "status": 200,
        "headers": {},
        "body": "<h1>PHP Version 7.4.33</h1><table><tr><td>DOCUMENT_ROOT</td>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {},
        "body": "<html><head><title>Orders</title></head><body>Your orders</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/info.php",
        "status": 404,
        "headers": {},
        "body": "Not Found"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published environment report is reported by design.",
  "linkedRules": [
    "DPK-DAST-089"
  ],
  "origin": "original-authored",
  "cell": "dast:phpinfo-page:phpinfo",
  "validationStatus": "VALIDATED"
}
