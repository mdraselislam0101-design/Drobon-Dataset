{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2322",
  "title": "Signal: NuGet lockfile recorded a floating version",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*.*.resolved",
      "valuePattern": "^\\d{1,3}\\.\\*$"
    }
  },
  "scope": "A packages.lock.json file that declares a resolved version that is a floating `N.*` selector.",
  "limitations": "It matches a resolved version that is a floating `N.*` selector in the parsed packages.lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.*",
              "contentHash": "aaaa"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Serilog": {
              "type": "Direct",
              "resolved": "4.*",
              "contentHash": "bbbb"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3",
              "contentHash": "aaaa"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Serilog": {
              "type": "Direct",
              "resolved": "4.0.1",
              "contentHash": "bbbb"
            }
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A packages.lock.json that mentions a resolved version that is a floating `N.*` selector in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0185"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-lock-floating-version",
  "validationStatus": "VALIDATED"
}
