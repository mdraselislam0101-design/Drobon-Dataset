{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0379",
  "title": "Signal: TLS checks disabled (pip) — review required",
  "targets": [
    "shell"
  ],
  "signal": {
    "kind": "regex",
    "source": "--trusted-host\\s+\\S+"
  },
  "scope": "Single-line lexical match on TLS-disabling flags for pip.",
  "limitations": "Lexical, line-based: matches the flag regardless of environment.",
  "examples": [
    {
      "line": "pip install --trusted-host x",
      "match": true
    },
    {
      "line": "# audit: pip install --trusted-host x present",
      "match": true
    },
    {
      "line": "pip install pkg",
      "match": false
    },
    {
      "line": "# verified: pip install pkg",
      "match": false
    }
  ],
  "fpNotes": "Local bootstrap scripts are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-340"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-cli:shell:pip",
  "validationStatus": "VALIDATED"
}
