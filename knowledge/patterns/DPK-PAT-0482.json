{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0482",
  "title": "Signal: Possible a Discord webhook URL in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "discord\\.com/api/webhooks/[0-9]{18,}/[A-Za-z0-9_-]{60,}"
  },
  "scope": "Single-line shape match for a Discord webhook URL.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "url = \"discord.com/api/webhooks/111111111111111111/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: url = \"discord.com/api/webhooks/111111111111111111/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "url = \"xy\"",
      "match": false
    },
    {
      "line": "url = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-016"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:discord-webhook",
  "validationStatus": "VALIDATED"
}
