{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2278",
  "title": "Signal: pip certificate path configured but empty",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "config.global.cert",
      "valuePattern": "^$"
    }
  },
  "scope": "A pip.conf file that declares an empty `cert` setting.",
  "limitations": "It matches an empty `cert` setting in the parsed pip.conf; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pip.conf",
      "document": {
        "config": {
          "global": {
            "cert": ""
          }
        }
      },
      "match": true
    },
    {
      "file": "pip.conf",
      "document": {
        "config": {
          "global": {
            "cert": "",
            "index-url": "https://pypi.acme.example/simple"
          }
        }
      },
      "match": true
    },
    {
      "file": "pip.conf",
      "document": {
        "config": {
          "global": {
            "cert": "/etc/ssl/certs/acme-root.pem"
          }
        }
      },
      "match": false
    },
    {
      "file": "pip.conf",
      "document": {
        "config": {
          "global": {
            "index-url": "https://pypi.org/simple"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pip.conf that mentions an empty `cert` setting in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0141"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-pip-conf-cert-empty",
  "validationStatus": "VALIDATED"
}
