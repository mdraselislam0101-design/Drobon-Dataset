{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3186",
  "title": "Signal: Possible a Mercado Pago access token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "APP_USR-[A-Za-z0-9-]{32,}"
  },
  "scope": "Single-line shape match for a Mercado Pago access token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"APP_USR-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"APP_USR-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-126"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-4:mercadopago-access-token",
  "validationStatus": "VALIDATED"
}
