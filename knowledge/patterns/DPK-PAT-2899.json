{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2899",
  "title": "Signal: Composer repository of type vcs or git",
  "targets": [
    "composer"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "repositories[].type",
      "valuePattern": "^(?:vcs|git)$"
    }
  },
  "scope": "A composer.json file that declares a repository that clones code instead of reading a package index.",
  "limitations": "It matches a repository that clones code instead of reading a package index in the parsed composer.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "vcs",
            "url": "https://github.com/acme/core"
          }
        ]
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "git",
            "url": "https://git.acme.example/sdk.git"
          }
        ]
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "composer",
            "url": "https://packagist.org"
          }
        ]
      },
      "match": false
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": []
      },
      "match": false
    }
  ],
  "fpNotes": "A composer.json that mentions a repository that clones code instead of reading a package index in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0762"
  ],
  "origin": "original-authored",
  "cell": "sca:composer-vcs-repository",
  "validationStatus": "VALIDATED"
}
