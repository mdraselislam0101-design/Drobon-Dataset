{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0157",
  "title": "Signal: Framework SQL built from input (mybatisann) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "@Select\\s*\\([^)]*\\+"
  },
  "scope": "Single-line lexical match on assembled SQL (mybatisann).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "@Select(\"SELECT \" + c)",
      "match": true
    },
    {
      "line": "# audit: @Select(\"SELECT \" + c) present",
      "match": true
    },
    {
      "line": "@Select(FIXED)",
      "match": false
    },
    {
      "line": "# verified: @Select(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-118"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli-extra:java:mybatisann",
  "validationStatus": "VALIDATED"
}
