{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1066",
  "title": "Signal: Server-side fetch through Source.fromURL in scala — review required",
  "targets": [
    "scala"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bSource\\.fromURL\\s*\\("
  },
  "scope": "Single-line match on Source.fromURL in scala.",
  "limitations": "Lexical: matches Source.fromURL calls; URLs built by helpers are out of scope.",
  "examples": [
    {
      "line": "val body = Source.fromURL(userUrl).mkString",
      "match": true
    },
    {
      "line": "# audit: val body = Source.fromURL(userUrl).mkString present",
      "match": true
    },
    {
      "line": "val body = Source.fromFile(\"config.json\").mkString",
      "match": false
    },
    {
      "line": "# verified: val body = Source.fromFile(\"config.json\").mkString",
      "match": false
    }
  ],
  "fpNotes": "Fetches of a constant URL are the accepted false positives.",
  "linkedRules": [
    "DPK-SAST-883"
  ],
  "origin": "original-authored",
  "cell": "sast:scala-source-fromurl:scala",
  "validationStatus": "VALIDATED"
}
