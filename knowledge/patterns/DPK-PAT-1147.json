{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1147",
  "title": "Signal: CORS allows every HTTP method from any origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Allow-Methods",
      "valuePattern": "(?:^|,)\\s*\\*\\s*(?:,|$)"
    }
  },
  "scope": "One response: confirm a wildcard method declaration.",
  "limitations": "Observation-level: evaluates the Access-Control-Allow-Methods header alone. Whether a dangerous method is implemented, and whether credentials are allowed, requires separate evidence.",
  "examples": [
    {
      "observation": {
        "url": "https://api.example/v1/orders",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://app.example",
          "Access-Control-Allow-Methods": "*"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/v1/orders",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Methods": "GET, *, POST"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/v1/orders",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Methods": "GET, POST, OPTIONS"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://api.example/v1/orders",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://app.example"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A public, unauthenticated read-only API may accept every method by design; it is still reported because the header cannot express that distinction.",
  "linkedRules": [
    "DPK-DAST-078"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-wildcard-methods:methods",
  "validationStatus": "VALIDATED"
}
