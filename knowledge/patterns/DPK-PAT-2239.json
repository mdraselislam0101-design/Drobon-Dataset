{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2239",
  "title": "Signal: pnpm lockfile fetches a tarball over cleartext",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.resolution.tarball",
      "valuePattern": "^http://"
    }
  },
  "scope": "A pnpm-lock.yaml file that declares a pnpm tarball URL that uses cleartext http.",
  "limitations": "It matches a pnpm tarball URL that uses cleartext http in the parsed pnpm-lock.yaml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/left-pad@1.3.0": {
            "resolution": {
              "tarball": "http://registry.acme.example/left-pad-1.3.0.tgz"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/ms@2.1.3": {
            "resolution": {
              "tarball": "http://10.24.8.9/ms-2.1.3.tgz"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/left-pad@1.3.0": {
            "resolution": {
              "tarball": "https://registry.npmjs.org/left-pad/-/left-pad-1.3.0.tgz"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "pnpm-lock.yaml",
      "document": {
        "lockfileVersion": "9.0",
        "packages": {
          "/ms@2.1.3": {
            "resolution": {
              "integrity": "sha512-BBBB"
            }
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pnpm-lock.yaml that mentions a pnpm tarball URL that uses cleartext http in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0102"
  ],
  "origin": "original-authored",
  "cell": "sca:pnpm-lock-cleartext-tarball",
  "validationStatus": "VALIDATED"
}
