{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1227",
  "title": "Signal: Refresh header targets a script scheme",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Refresh",
      "valuePattern": "^\\s*[0-9]*\\s*;?\\s*url\\s*=\\s*[\"\\']?\\s*(?:javascript|vbscript)\\s*:"
    }
  },
  "scope": "One response whose Refresh header names a javascript: or vbscript: URL.",
  "limitations": "One header value. The rule reports the scheme the header names; it cannot prove the value is attacker-influenced, and some browsers block Refresh navigation to script schemes outright, so impact depends on the client.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "0; url=javascript:alert(document.cookie)"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "5;URL=\"vbscript:msgbox(1)\""
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "0; url=https://example.com/"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "0; url=//example.com/"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Refresh": "30"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A static page that deliberately uses a script-scheme refresh is reported; the construct is unsafe wherever the value can change.",
  "linkedRules": [
    "DPK-DAST-158"
  ],
  "origin": "original-authored",
  "cell": "dast:refresh-script-scheme:script-scheme",
  "validationStatus": "VALIDATED"
}
