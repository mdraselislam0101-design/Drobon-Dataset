{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0961",
  "title": "Signal: Directory listing enabled",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<title>Index of /"
    }
  },
  "scope": "Single response body: confirm no automatic directory index is returned.",
  "limitations": "Title marker on one body: a page that quotes an index title can match.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "content-type": "text/html"
        },
        "body": "<html><head><title>Index of /backup</title></head><body>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "content-type": "text/html"
        },
        "body": "<html><head><title>Backup policy</title></head>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/backup/",
        "status": 200,
        "headers": {},
        "body": "<title>Index of /backup</title>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/toc",
        "status": 200,
        "headers": {},
        "body": "<title>Index of contents</title>"
      },
      "match": false
    }
  ],
  "fpNotes": "Public download folders that are meant to be browsed are the accepted case.",
  "linkedRules": [
    "DPK-DAST-064"
  ],
  "origin": "original-authored",
  "cell": "dast:directory-listing:index-of",
  "validationStatus": "VALIDATED"
}
