{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2940",
  "title": "Signal: Interpreter floor with no upper bound",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "options.python_requires",
      "valuePattern": "^>=\\d+\\.\\d+$"
    }
  },
  "scope": "A setup.cfg file that declares a `python_requires` of `>=X.Y` only.",
  "limitations": "It matches a `python_requires` of `>=X.Y` only in the parsed setup.cfg; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "python_requires": ">=3.9"
        }
      },
      "match": true
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "python_requires": ">=3.10"
        }
      },
      "match": true
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "python_requires": ">=3.10,<4"
        }
      },
      "match": false
    },
    {
      "file": "setup.cfg",
      "document": {
        "metadata": {
          "name": "demo-service",
          "version": "1.4.0"
        },
        "options": {
          "install_requires": [
            "requests==2.32.3"
          ],
          "python_requires": ">=3.11,<3.14"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A setup.cfg that mentions a `python_requires` of `>=X.Y` only in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0803"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-setupcfg-python-requires-open",
  "validationStatus": "VALIDATED"
}
