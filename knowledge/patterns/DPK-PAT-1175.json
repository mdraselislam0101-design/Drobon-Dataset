{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1175",
  "title": "Signal: Content-Security-Policy sandbox can remove itself",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "(?:^|;)\\s*sandbox(?=[\\s;]|$)[^;]*?\\ballow-scripts\\b[^;]*?\\ballow-same-origin\\b|(?:^|;)\\s*sandbox(?=[\\s;]|$)[^;]*?\\ballow-same-origin\\b[^;]*?\\ballow-scripts\\b"
    }
  },
  "scope": "One Content-Security-Policy value whose sandbox directive carries both allow-scripts and allow-same-origin in any order.",
  "limitations": "One header value, first declaration of the directive only. The rule reports the token combination; it does not model what the framed document does with the escape.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "sandbox allow-scripts allow-same-origin"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; sandbox allow-same-origin allow-scripts"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "sandbox allow-scripts"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "sandbox allow-same-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "sandbox allow-forms allow-scripts"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "sandbox allow-scripts; sandbox allow-same-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A page that sandboxes only its own static markup can be reported; the combination is still unsafe as a boundary between untrusted content and the origin.",
  "linkedRules": [
    "DPK-DAST-106"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-sandbox-escape:sandbox",
  "validationStatus": "VALIDATED"
}
