{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2937",
  "title": "Signal: pip hash checking switched off",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "install.require-hashes",
      "valuePattern": "^false$"
    }
  },
  "scope": "A pip.conf file that declares a `require-hashes=false` installer setting.",
  "limitations": "It matches a `require-hashes=false` installer setting in the parsed pip.conf; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pip.conf",
      "document": {
        "global": {
          "index-url": "https://pypi.org/simple",
          "timeout": "15"
        },
        "install": {
          "require-hashes": "false"
        }
      },
      "match": true
    },
    {
      "file": "pip.conf",
      "document": {
        "global": {
          "index-url": "https://pypi.org/simple",
          "timeout": "15"
        },
        "install": {
          "require-hashes": false
        }
      },
      "match": true
    },
    {
      "file": "pip.conf",
      "document": {
        "global": {
          "index-url": "https://pypi.org/simple",
          "timeout": "15"
        },
        "install": {
          "require-hashes": "true"
        }
      },
      "match": false
    },
    {
      "file": "pip.conf",
      "document": {
        "global": {
          "index-url": "https://pypi.org/simple",
          "timeout": "15"
        },
        "install": {
          "require-hashes": true
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pip.conf that mentions a `require-hashes=false` installer setting in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0800"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-pip-conf-require-hashes-off",
  "validationStatus": "VALIDATED"
}
