{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3187",
  "title": "Signal: Possible an NVIDIA NGC API key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "nvapi-[A-Za-z0-9_-]{64,}"
  },
  "scope": "Single-line shape match for an NVIDIA NGC API key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"nvapi-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: key = \"nvapi-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-127"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-4:nvidia-ngc-api-key",
  "validationStatus": "VALIDATED"
}
