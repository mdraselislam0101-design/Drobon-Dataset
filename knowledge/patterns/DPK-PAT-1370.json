{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1370",
  "title": "Signal: Set-Cookie header carries an encoded line break",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Set-Cookie",
      "valuePattern": "%0[dD]%0[aA]"
    }
  },
  "scope": "One Set-Cookie value containing the full encoded CRLF pair.",
  "limitations": "One Set-Cookie header value. The check proves the encoded break reached the header; it does not attempt to make a client decode it.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/prefs?theme=dark%0d%0aX-Injected:%201",
        "status": 200,
        "headers": {
          "Set-Cookie": "theme=dark%0d%0aX-Injected:%201; Path=/; Secure; HttpOnly"
        },
        "body": "<html><body>Saved</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/prefs",
        "status": 200,
        "headers": {
          "Set-Cookie": "prefs=\"a=1%0d%0a\"; Path=/; Secure"
        },
        "body": "<html><body>Saved</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/prefs",
        "status": 200,
        "headers": {
          "Set-Cookie": "__Host-sid=abc123; Path=/; Secure; HttpOnly; SameSite=Strict"
        },
        "body": "<html><body>Saved</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/prefs",
        "status": 200,
        "headers": {
          "Set-Cookie": "theme=dark%20mode; Path=/; Secure"
        },
        "body": "<html><body>Saved</body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A cookie that stores a signed blob containing %0d%0a by design is reported; a normal session cookie is not.",
  "linkedRules": [
    "DPK-DAST-301"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-header-setcookie-encoded-crlf:setcookie-crlf",
  "validationStatus": "VALIDATED"
}
