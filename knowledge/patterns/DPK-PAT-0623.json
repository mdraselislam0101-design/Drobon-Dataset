{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0623",
  "title": "Signal: Django security setting off (djssl) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "SECURE_SSL_REDIRECT\\s*=\\s*False"
  },
  "scope": "Single-line lexical match on Django settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "SECURE_SSL_REDIRECT = False",
      "match": true
    },
    {
      "line": "# audit: SECURE_SSL_REDIRECT = False present",
      "match": true
    },
    {
      "line": "SECURE_SSL_REDIRECT = True",
      "match": false
    },
    {
      "line": "# verified: SECURE_SSL_REDIRECT = True",
      "match": false
    }
  ],
  "fpNotes": "Local development is the common false positive.",
  "linkedRules": [
    "DPK-SAST-506"
  ],
  "origin": "original-authored",
  "cell": "sast:django-secure:python:djssl",
  "validationStatus": "VALIDATED"
}
