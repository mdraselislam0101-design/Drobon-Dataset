{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1315",
  "title": "Signal: Tomcat manager application disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Tomcat\\ Web\\ Application\\ Manager)(?=[\\s\\S]*Server\\ Information)"
    }
  },
  "scope": "One response whose body renders the Tomcat manager console.",
  "limitations": "One response body. The rule reports the manager page; it does not submit the deploy form and cannot show whether the request would be authorised.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Tomcat Web Application Manager</title></head><body><h1>/manager/html</h1><table><tr><td>Server Information</td><td>Apache Tomcat/9.0.82</td></tr></table><form action=\"/manager/html/deploy\"><input name=\"deployPath\"></form></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h2>Tomcat Web Application Manager</h2><p>Server Information</p><a href=\"deploy\">Deploy directory or WAR file located on server</a></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><h1>/manager/html</h1><table><tr><td></td><td>Apache Tomcat/9.0.82</td></tr></table><form action=\"/manager/html/deploy\"><input name=\"deployPath\"></form></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A Tomcat error page is a different finding with its own rule and is not reported here.",
  "linkedRules": [
    "DPK-DAST-246"
  ],
  "origin": "original-authored",
  "cell": "dast:body-tomcat-manager:tomcat-manager",
  "validationStatus": "VALIDATED"
}
