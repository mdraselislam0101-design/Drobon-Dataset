{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2197",
  "title": "Signal: Lockfile written in the legacy v1 format",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "lockfileVersion",
      "valuePattern": "^1$"
    }
  },
  "scope": "A package-lock.json file that declares a lockfile in the legacy v1 format, which records a weaker per-package provenance shape.",
  "limitations": "It matches a lockfile in the legacy v1 format, which records a weaker per-package provenance shape in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 1,
        "dependencies": {
          "left-pad": {
            "version": "1.3.0"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 1,
        "dependencies": {
          "ms": {
            "version": "2.1.3"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "": {
            "name": "demo-service"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 2,
        "packages": {
          "": {
            "name": "demo-service"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A repository that must support an old npm is still reported; the format is the finding.",
  "linkedRules": [
    "DPK-SCA-0060"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-lockfile-version-legacy",
  "validationStatus": "VALIDATED"
}
