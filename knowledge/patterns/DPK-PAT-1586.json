{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1586",
  "title": "Signal: Session identifier carried in a URL",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "[?;&](?:jsessionid|phpsessid|sessionid|session_id|sid)=[A-Za-z0-9._-]{8,64}"
    }
  },
  "scope": "A response body containing a URL with a jsessionid, phpsessid, sessionid or sid parameter.",
  "limitations": "One response body. It reports the identifier appearing in a URL, not whether the session is currently valid.",
  "examples": [
    {
      "observation": {
        "url": "https://bank.example/accounts",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<a href=\"/accounts/summary;jsessionid=8F2A91CD44E7B1A0?lang=en\">Summary</a>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/redirect",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<meta http-equiv=\"refresh\" content=\"0;url=/portal/home?sessionid=Qk7dP2mZ91xLw4\"><p>Loading.</p>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/docs/session",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "<h1>Session handling</h1><p>The session cookie must be Secure and HttpOnly. Do not enable URL rewriting.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A documentation page that shows the parameter name without a value is not reported, because the pattern requires at least eight identifier characters.",
  "linkedRules": [
    "DPK-DAST-517"
  ],
  "origin": "original-authored",
  "cell": "dast:bank-session-id-in-url:bank-session-id-in-url",
  "validationStatus": "VALIDATED"
}
