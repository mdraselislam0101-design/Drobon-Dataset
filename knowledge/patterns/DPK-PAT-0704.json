{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0704",
  "title": "Signal: Sensitive value in log call (cobol) — review required",
  "targets": [
    "cobol"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:DISPLAY\\s+[^\\n]*(?:password|passwd|secret|token))"
  },
  "scope": "Single-line lexical match on credential-named log values in cobol code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "DISPLAY \"password: \" p",
      "match": true
    },
    {
      "line": "# audit: DISPLAY \"password: \" p present",
      "match": true
    },
    {
      "line": "DISPLAY \"user: \" u",
      "match": false
    },
    {
      "line": "# verified: DISPLAY \"user: \" u",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-587"
  ],
  "origin": "original-authored",
  "cell": "sast:log-4:cobol",
  "validationStatus": "VALIDATED"
}
