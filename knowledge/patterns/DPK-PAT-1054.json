{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1054",
  "title": "Signal: MD5 selected through MessageDigest in kotlin — review required",
  "targets": [
    "kotlin"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:MessageDigest\\.getInstance\\s*\\(\\s*[\"'](?:MD5|md5)[\"'])"
  },
  "scope": "Single-line match on MD5 via MessageDigest in kotlin.",
  "limitations": "Lexical: matches the literal algorithm name; a name resolved from configuration is out of scope.",
  "examples": [
    {
      "line": "val md = MessageDigest.getInstance(\"MD5\")",
      "match": true
    },
    {
      "line": "# audit: val md = MessageDigest.getInstance(\"MD5\") present",
      "match": true
    },
    {
      "line": "val md = MessageDigest.getInstance(\"SHA-256\")",
      "match": false
    },
    {
      "line": "# verified: val md = MessageDigest.getInstance(\"SHA-256\")",
      "match": false
    }
  ],
  "fpNotes": "Non-security checksums over non-adversarial data are the accepted false positives.",
  "linkedRules": [
    "DPK-SAST-871"
  ],
  "origin": "original-authored",
  "cell": "sast:kotlin-md5:kotlin",
  "validationStatus": "VALIDATED"
}
