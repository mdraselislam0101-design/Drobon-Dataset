{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2372",
  "title": "Signal: renv lockfile records a cleartext package source",
  "targets": [
    "cran"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "Packages.*.Source",
      "valuePattern": "^http://"
    }
  },
  "scope": "A renv.lock file that declares a package whose recorded source is a cleartext http location.",
  "limitations": "It matches a package whose recorded source is a cleartext http location in the parsed renv.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1"
        },
        "Packages": {
          "acme.internal": {
            "Package": "acme.internal",
            "Version": "1.0.0",
            "Source": "http://cran.acme.example",
            "Hash": "aaaa"
          }
        }
      },
      "match": true
    },
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1"
        },
        "Packages": {
          "acme.utils": {
            "Package": "acme.utils",
            "Version": "2.1.0",
            "Source": "http://10.24.8.9",
            "Hash": "bbbb"
          }
        }
      },
      "match": true
    },
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1"
        },
        "Packages": {
          "dplyr": {
            "Package": "dplyr",
            "Version": "1.1.4",
            "Source": "Repository",
            "Hash": "aaaa"
          }
        }
      },
      "match": false
    },
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1"
        },
        "Packages": {
          "acme.utils": {
            "Package": "acme.utils",
            "Version": "2.1.0",
            "Source": "https://cran.acme.example",
            "Hash": "bbbb"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A renv.lock that mentions a package whose recorded source is a cleartext http location in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0235"
  ],
  "origin": "original-authored",
  "cell": "sca:renv-repository-cleartext",
  "validationStatus": "VALIDATED"
}
