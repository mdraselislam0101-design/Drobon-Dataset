{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3155",
  "title": "Signal: Central package version declared as a range",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.itemGroup.PackageVersion[].Version",
      "valuePattern": "^\\["
    }
  },
  "scope": "A Directory.Packages.props file that declares a `<PackageVersion>` value in `[a,b)` form.",
  "limitations": "It matches a `<PackageVersion>` value in `[a,b)` form in the parsed Directory.Packages.props; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "[13.0.1,14.0.0)"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Dapper",
                "Version": "[2.1,3.0)"
              }
            ]
          }
        }
      },
      "match": true
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Newtonsoft.Json",
                "Version": "13.0.3"
              }
            ]
          }
        }
      },
      "match": false
    },
    {
      "file": "Directory.Packages.props",
      "document": {
        "project": {
          "itemGroup": {
            "PackageVersion": [
              {
                "Include": "Dapper",
                "Version": "2.1.35"
              }
            ]
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Directory.Packages.props that mentions a `<PackageVersion>` value in `[a,b)` form in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1018"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-central-version-range",
  "validationStatus": "VALIDATED"
}
