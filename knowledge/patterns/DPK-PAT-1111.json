{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1111",
  "title": "Signal: WKWebView loads a computed URL request in swift — review required",
  "targets": [
    "swift"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.load\\s*\\(\\s*URLRequest\\s*\\(\\s*url\\s*:\\s*URL\\s*\\(\\s*string\\s*:\\s*(?![\"'])\\w"
  },
  "scope": "Single-line match on a computed WKWebView load in swift.",
  "limitations": "Lexical: matches load(URLRequest(...)) calls whose argument is not a literal host.",
  "examples": [
    {
      "line": "webView.load(URLRequest(url: URL(string: deepLink)!))",
      "match": true
    },
    {
      "line": "# audit: webView.load(URLRequest(url: URL(string: deepLink)!)) present",
      "match": true
    },
    {
      "line": "webView.load(URLRequest(url: URL(string: \"https://app.example/help\")!))",
      "match": false
    },
    {
      "line": "# verified: webView.load(URLRequest(url: URL(string: \"https://app.example/help\")!))",
      "match": false
    }
  ],
  "fpNotes": "A constant base URL with a fixed path is the accepted false positive.",
  "linkedRules": [
    "DPK-SAST-928"
  ],
  "origin": "original-authored",
  "cell": "sast:swift-wkwebview-computed:swift",
  "validationStatus": "VALIDATED"
}
