{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0890",
  "title": "Signal: Dangerous .NET construct (machineval) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "validationKey\\s*=\\s*\"[0-9A-Fa-f]{16,}"
  },
  "scope": "Single-line lexical match on .NET constructs (machineval).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "validationKey=\"AB12CD34EF560189\"",
      "match": true
    },
    {
      "line": "# audit: validationKey=\"AB12CD34EF560189\" present",
      "match": true
    },
    {
      "line": "validationKey=\"AutoGenerate,IsolateApps\"",
      "match": false
    },
    {
      "line": "# verified: validationKey=\"AutoGenerate,IsolateApps\"",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-739"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-flag:csharp:machineval",
  "validationStatus": "VALIDATED"
}
