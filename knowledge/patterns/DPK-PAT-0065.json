{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0065",
  "title": "Signal: Weak cipher named (universal) — review required",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:RC4|3DES|DES-CBC|Blowfish)\\b"
  },
  "scope": "Single-line lexical match on weak cipher names.",
  "limitations": "Lexical, line-based: matches the name regardless of context.",
  "examples": [
    {
      "line": "cipher = \"RC4\"",
      "match": true
    },
    {
      "line": "# audit: cipher = \"RC4\" present",
      "match": true
    },
    {
      "line": "cipher = \"AES-256-GCM\"",
      "match": false
    },
    {
      "line": "# verified: cipher = \"AES-256-GCM\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and compatibility lists are the common false positive.",
  "linkedRules": [
    "DPK-SAST-026"
  ],
  "origin": "original-authored",
  "cell": "sast:cipher-weak-name:universal",
  "validationStatus": "VALIDATED"
}
