{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0811",
  "title": "Signal: Weak SSH daemon setting (authtries) — review required",
  "targets": [
    "sshd"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:MaxAuthTries\\s+[1-9][0-9]+)"
  },
  "scope": "Single-line lexical match on sshd settings.",
  "limitations": "Lexical, line-based: matches the setting regardless of Match blocks.",
  "examples": [
    {
      "line": "MaxAuthTries 10",
      "match": true
    },
    {
      "line": "# audit: MaxAuthTries 10 present",
      "match": true
    },
    {
      "line": "MaxAuthTries 3",
      "match": false
    },
    {
      "line": "# verified: MaxAuthTries 3",
      "match": false
    }
  ],
  "fpNotes": "Bastion-specific needs are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-694"
  ],
  "origin": "original-authored",
  "cell": "sast:sshd-strict:sshd:authtries",
  "validationStatus": "VALIDATED"
}
