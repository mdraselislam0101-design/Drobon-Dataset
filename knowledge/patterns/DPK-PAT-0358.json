{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0358",
  "title": "Signal: Weak service hardening (skipverify) — review required",
  "targets": [
    "traefik"
  ],
  "signal": {
    "kind": "regex",
    "source": "insecureSkipVerify\\s*=\\s*true"
  },
  "scope": "Single-line lexical match on weak settings (skipverify).",
  "limitations": "Lexical, line-based: matches the setting regardless of host trust.",
  "examples": [
    {
      "line": "insecureSkipVerify = true",
      "match": true
    },
    {
      "line": "# audit: insecureSkipVerify = true present",
      "match": true
    },
    {
      "line": "insecureSkipVerify = false",
      "match": false
    },
    {
      "line": "# verified: insecureSkipVerify = false",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-319"
  ],
  "origin": "original-authored",
  "cell": "sast:sys-services:traefik:skipverify",
  "validationStatus": "VALIDATED"
}
