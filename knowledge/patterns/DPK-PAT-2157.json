{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2157",
  "title": "Signal: Git dependency pinned through a semver fragment",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "#semver:"
    }
  },
  "scope": "A package.json file that declares a git dependency whose fragment asks npm to resolve a semver range instead of committing to one tree.",
  "limitations": "It matches a git dependency whose fragment asks npm to resolve a semver range instead of committing to one tree in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "github:acme/sdk#semver:^4.2.0"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "git+https://github.com/acme/cli.git#semver:~2.1"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "github:acme/sdk#a1b2c3d"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A fragment naming a full commit sha is a different declaration and is not reported.",
  "linkedRules": [
    "DPK-SCA-0020"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-semver-fragment",
  "validationStatus": "VALIDATED"
}
