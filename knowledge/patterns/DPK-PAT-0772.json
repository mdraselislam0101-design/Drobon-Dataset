{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0772",
  "title": "Signal: Predictable randomness via :rand.uniform (elixir) — review required",
  "targets": [
    "elixir"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:rand\\.uniform)\\s*\\("
  },
  "scope": "Single-line lexical match on the :rand.uniform call in elixir code.",
  "limitations": "Lexical, line-based: matches any :rand.uniform call.",
  "examples": [
    {
      "line": ":rand.uniform(payload)",
      "match": true
    },
    {
      "line": "out = :rand.uniform(data)",
      "match": true
    },
    {
      "line": "myranduniform(x)",
      "match": false
    },
    {
      "line": ":rand.uniform_safe()",
      "match": false
    }
  ],
  "fpNotes": "Simulations are the common false positive.",
  "linkedRules": [
    "DPK-SAST-655"
  ],
  "origin": "original-authored",
  "cell": "sast:random-3:elixir",
  "validationStatus": "VALIDATED"
}
