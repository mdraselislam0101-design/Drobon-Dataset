{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1412",
  "title": "Signal: Base element points at another origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<base\\b[^>]{0,120}href\\s*=\\s*[\"']?https://(?!(?:www\\.)?app\\.example)"
    }
  },
  "scope": "One response body containing a base element that points at another origin.",
  "limitations": "One response body. The rule reads the base target; it does not resolve the links that follow it.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><base href=\"https://cdn.partner.example/shop/\"><title>Shop</title></head><body><a href=\"cart\">Cart</a></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><base href='https://assets.example:8443/'></head><body><img src='logo.png'></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><base href=\"/shop/\"></head><body><a href=\"cart\">Cart</a></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/shop",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><link rel=\"canonical\" href=\"https://www.example.com/shop\"></head><body></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A same-origin base href is not reported. The plaintext http:// form is DPK-DAST-271, so this rule reads only a secure cross-origin target; a canonical link element with a foreign host is a different signal and is not covered here.",
  "linkedRules": [
    "DPK-DAST-343"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-base-href-cross-origin:base-href-cross-origin",
  "validationStatus": "VALIDATED"
}
