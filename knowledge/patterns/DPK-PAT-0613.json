{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0613",
  "title": "Signal: Dangerous .NET construct (webclient) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "DownloadString\\s*\\(\\s*\"http:"
  },
  "scope": "Single-line lexical match on .NET constructs (webclient).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "c.DownloadString(\"http://h/x\")",
      "match": true
    },
    {
      "line": "# audit: c.DownloadString(\"http://h/x\") present",
      "match": true
    },
    {
      "line": "c.DownloadString(\"https://h/x\")",
      "match": false
    },
    {
      "line": "# verified: c.DownloadString(\"https://h/x\")",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-496"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-flag:csharp:webclient",
  "validationStatus": "VALIDATED"
}
