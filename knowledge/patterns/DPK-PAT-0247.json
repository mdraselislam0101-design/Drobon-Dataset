{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0247",
  "title": "Signal: File access built from input (erlang) — review required",
  "targets": [
    "erlang"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:read_file\\s*\\([^)]*\\+\\+)"
  },
  "scope": "Single-line lexical match on input-built paths in erlang code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "file:read_file(dir ++ f)",
      "match": true
    },
    {
      "line": "# audit: file:read_file(dir ++ f) present",
      "match": true
    },
    {
      "line": "file:read_file(fixed)",
      "match": false
    },
    {
      "line": "# verified: file:read_file(fixed)",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-208"
  ],
  "origin": "original-authored",
  "cell": "sast:path-langs:erlang",
  "validationStatus": "VALIDATED"
}
