{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0293",
  "title": "Signal: transfer left open (bind) — review required",
  "targets": [
    "bind"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:allow-transfer\\s*\\{\\s*any)"
  },
  "scope": "Single-line lexical match on open settings for transfer.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "allow-transfer { any; };",
      "match": true
    },
    {
      "line": "# audit: allow-transfer { any; }; present",
      "match": true
    },
    {
      "line": "allow-transfer { none; };",
      "match": false
    },
    {
      "line": "# verified: allow-transfer { none; };",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-254"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:bind:transfer",
  "validationStatus": "VALIDATED"
}
