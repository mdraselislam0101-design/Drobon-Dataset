{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0787",
  "title": "Signal: Dynamic evaluation via raw (ruby) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:raw)\\s*\\("
  },
  "scope": "Single-line lexical match on the raw call in ruby code.",
  "limitations": "Lexical, line-based: any raw call matches.",
  "examples": [
    {
      "line": "raw(payload)",
      "match": true
    },
    {
      "line": "out = raw(data)",
      "match": true
    },
    {
      "line": "myraw(x)",
      "match": false
    },
    {
      "line": "raw_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted templates are the common false positive.",
  "linkedRules": [
    "DPK-SAST-670"
  ],
  "origin": "original-authored",
  "cell": "sast:ruby-call:ruby:raw",
  "validationStatus": "VALIDATED"
}
