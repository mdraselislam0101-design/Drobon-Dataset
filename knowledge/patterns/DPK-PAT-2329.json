{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2329",
  "title": "Signal: Cargo dependency follows a git branch",
  "targets": [
    "cargo"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*.branch",
      "valuePattern": "^[A-Za-z]"
    }
  },
  "scope": "A Cargo.toml file that declares a git dependency pinned to a branch instead of a revision.",
  "limitations": "It matches a git dependency pinned to a branch instead of a revision in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_sdk": {
            "git": "https://github.com/acme/sdk",
            "branch": "main"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_cli": {
            "git": "https://github.com/acme/cli",
            "branch": "develop"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_sdk": {
            "git": "https://github.com/acme/sdk",
            "rev": "9f2c4a1b7c3d"
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0"
        },
        "dependencies": {
          "acme_sdk": {
            "version": "4.2.0"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Cargo.toml that mentions a git dependency pinned to a branch instead of a revision in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0192"
  ],
  "origin": "original-authored",
  "cell": "sca:cargo-dependency-branch",
  "validationStatus": "VALIDATED"
}
