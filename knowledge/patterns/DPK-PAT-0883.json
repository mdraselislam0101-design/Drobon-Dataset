{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0883",
  "title": "Signal: Possible a Pulumi token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "pul-[A-Za-z0-9]{32,}"
  },
  "scope": "Single-line shape match for a Pulumi token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"pul-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"pul-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-095"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes-2:pulumi-token",
  "validationStatus": "VALIDATED"
}
