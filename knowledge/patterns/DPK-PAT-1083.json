{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1083",
  "title": "Signal: Operating-system command executed from a MATLAB string in matlab — review required",
  "targets": [
    "matlab"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bsystem\\s*\\(\\s*[^)\\n]*\\+|\\bsystem\\s*\\(\\s*[a-zA-Z_]\\w*\\s*\\)"
  },
  "scope": "Single-line match on system in matlab.",
  "limitations": "Lexical: matches system calls; a wrapper that builds commands from constants is out of scope.",
  "examples": [
    {
      "line": "system([\"convert \" + filename + \" out.png\"]);",
      "match": true
    },
    {
      "line": "# audit: system([\"convert \" + filename + \" out.png\"]); present",
      "match": true
    },
    {
      "line": "system(\"convert input.png out.png\");",
      "match": false
    },
    {
      "line": "# verified: system(\"convert input.png out.png\");",
      "match": false
    }
  ],
  "fpNotes": "Constant commands in analysis scripts are the accepted false positives.",
  "linkedRules": [
    "DPK-SAST-900"
  ],
  "origin": "original-authored",
  "cell": "sast:matlab-system-call:matlab",
  "validationStatus": "VALIDATED"
}
