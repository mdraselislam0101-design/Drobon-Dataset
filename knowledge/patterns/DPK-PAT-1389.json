{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1389",
  "title": "Signal: Password form submits with GET, placing the secret in the URL",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<form\\b(?![^>]{0,300}\\bmethod\\s*=\\s*[\"']?post)[^>]{0,300}>[\\s\\S]{0,400}type\\s*=\\s*[\"']password|<form\\b[^>]{0,300}\\bmethod\\s*=\\s*[\"']?get[^>]{0,300}>[\\s\\S]{0,400}type\\s*=\\s*[\"']password"
    }
  },
  "scope": "One form element that contains a password input and whose method is absent or get.",
  "limitations": "One response body. The check reads the form markup; it does not observe the resulting request or the logs that keep the URL.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<form action=\"/login\"><input type=\"password\" name=\"pw\"></form>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<form method=\"get\" action=\"/login\"><label>Password</label><input name=\"pw\" type=\"password\"></form>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<form method=\"post\" action=\"/login\"><input type=\"password\" name=\"pw\"></form>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/search",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<form method=\"get\" action=\"/search\"><input type=\"search\" name=\"q\"></form>"
      },
      "match": false
    }
  ],
  "fpNotes": "A form with method=\"post\" is not reported. A password field inside a form that is submitted by script is reported when no method is declared, because the markup still defaults to GET.",
  "linkedRules": [
    "DPK-DAST-320"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-form-get-password:password-form-get",
  "validationStatus": "VALIDATED"
}
