{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1453",
  "title": "Signal: go.mod module manifest served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*(?:^|\\n)module\\s+[a-z0-9._/-]{3,80}(?:\\n|$))(?=[\\s\\S]*(?:^|\\n)require\\s)"
    }
  },
  "scope": "One response body containing a Go module declaration with its requirements.",
  "limitations": "One response body. The rule reads the module declaration; it does not resolve the dependency versions.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "module git.internal/shop/api\n\ngo 1.22\n\nrequire (\n\tgithub.com/gin-gonic/gin v1.9.1\n)\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "module github.com/shop/service\n\ngo 1.21\n\nrequire github.com/lib/pq v1.10.9\n\nreplace github.com/shop/core => ../core\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "github.com/gin-gonic/gin v1.9.1 h1:4idE4kt1qBfFKf0VMsrOYw4qJYQaM6bGkFQ1kC1h0h0=\n"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/deploy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Deployment guide</title></head><body><p>Declare the module path at the top of go.mod.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that quotes a go.mod snippet is reported when it reproduces the module line and a requirement block; a go.sum checksum file is not reported.",
  "linkedRules": [
    "DPK-DAST-384"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-artefact-go-mod:go-mod-served",
  "validationStatus": "VALIDATED"
}
