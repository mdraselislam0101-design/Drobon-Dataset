{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1247",
  "title": "Signal: Portainer interface disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*portainer)(?=[\\s\\S]*Portainer)"
    }
  },
  "scope": "One response whose body contains both the portainer root element and the product name.",
  "limitations": "One response body. The rule reports the Portainer shell; it does not list a container or a stack.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Portainer</title></head><body><div id=\"portainer-root\"></div><script src=\"/js/portainer.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><script>window.portainer = {\"version\":\"2.19.1\"};</script><span>Portainer</span></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><div id=\"-root\"></div><script src=\"/js/.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published console is still reported; the finding is reachability.",
  "linkedRules": [
    "DPK-DAST-178"
  ],
  "origin": "original-authored",
  "cell": "dast:body-portainer:portainer",
  "validationStatus": "VALIDATED"
}
