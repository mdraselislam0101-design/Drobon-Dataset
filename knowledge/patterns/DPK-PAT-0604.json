{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0604",
  "title": "Signal: Dangerous .NET construct (certcb) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "ServerCertificateValidationCallback.{0,80}=>\\s*true"
  },
  "scope": "Single-line lexical match on .NET constructs (certcb).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "ServerCertificateValidationCallback += (s,c,ch,e) => true;",
      "match": true
    },
    {
      "line": "# audit: ServerCertificateValidationCallback += (s,c,ch,e) => true; present",
      "match": true
    },
    {
      "line": "ServerCertificateValidationCallback += DefaultValidation;",
      "match": false
    },
    {
      "line": "# verified: ServerCertificateValidationCallback += DefaultValidation;",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-487"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-flag:csharp:certcb",
  "validationStatus": "VALIDATED"
}
