{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0538",
  "title": "Signal: Framework SQL built from input (kohana) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:DB::query\\s*\\([^)]*(?:\"[^\"\\n]*\\$|\\.\\s*\\$))"
  },
  "scope": "Single-line lexical match on assembled SQL (kohana).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "DB::query(\"SELECT $q\")",
      "match": true
    },
    {
      "line": "# audit: DB::query(\"SELECT $q\") present",
      "match": true
    },
    {
      "line": "DB::query($fixed)",
      "match": false
    },
    {
      "line": "# verified: DB::query($fixed)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-441"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli-extra:php:kohana",
  "validationStatus": "VALIDATED"
}
