{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0808",
  "title": "Signal: Framework SQL splice (sqlx) — review required",
  "targets": [
    "rust"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:sqlx::query!\\s*\\([^)]*format!)"
  },
  "scope": "Single-line lexical match on SQL splices (sqlx).",
  "limitations": "Lexical, line-based: matches the splice.",
  "examples": [
    {
      "line": "sqlx::query!(format!(\"SELECT {}\", q))",
      "match": true
    },
    {
      "line": "# audit: sqlx::query!(format!(\"SELECT {}\", q)) present",
      "match": true
    },
    {
      "line": "sqlx::query!(\"SELECT 1\")",
      "match": false
    },
    {
      "line": "# verified: sqlx::query!(\"SELECT 1\")",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-691"
  ],
  "origin": "original-authored",
  "cell": "sast:sqli-extra-2:rust:sqlx",
  "validationStatus": "VALIDATED"
}
