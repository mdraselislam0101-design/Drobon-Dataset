{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0232",
  "title": "Signal: Observability service left open (auth) — review required",
  "targets": [
    "influx"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:auth-enabled\\s*=\\s*false)"
  },
  "scope": "Single-line lexical match on open settings (auth).",
  "limitations": "Lexical, line-based: matches the setting regardless of network scope.",
  "examples": [
    {
      "line": "auth-enabled = false",
      "match": true
    },
    {
      "line": "# audit: auth-enabled = false present",
      "match": true
    },
    {
      "line": "auth-enabled = true",
      "match": false
    },
    {
      "line": "# verified: auth-enabled = true",
      "match": false
    }
  ],
  "fpNotes": "Loopback-only instances are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-193"
  ],
  "origin": "original-authored",
  "cell": "sast:obs-services:influx:auth",
  "validationStatus": "VALIDATED"
}
