{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1410",
  "title": "Signal: phpunit.xml test configuration served",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*<phpunit\\b)(?=[\\s\\S]*<testsuite\\b)"
    }
  },
  "scope": "One response body containing a PHPUnit configuration with a testsuite definition.",
  "limitations": "One response body. The rule reads the configuration shape; it does not show whether the test suite itself is reachable.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/phpunit.xml",
        "status": 200,
        "headers": {
          "Content-Type": "application/xml"
        },
        "body": "<?xml version=\"1.0\"?>\n<phpunit bootstrap=\"vendor/autoload.php\" colors=\"true\">\n  <testsuites>\n    <testsuite name=\"unit\"><directory>tests/Unit</directory></testsuite>\n  </testsuites>\n</phpunit>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/phpunit.xml.dist",
        "status": 200,
        "headers": {
          "Content-Type": "application/xml"
        },
        "body": "<phpunit>\n  <testsuite name=\"feature\"><directory>tests/Feature</directory></testsuite>\n  <php><env name=\"APP_ENV\" value=\"testing\"/></php>\n</phpunit>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/phpunit.xml",
        "status": 200,
        "headers": {
          "Content-Type": "application/xml"
        },
        "body": "<?xml version=\"1.0\"?>\n<coverage><report><html outputDirectory=\"build/coverage\"/></report></coverage>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/tests",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Define the test directories in the testsuites element.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that shows a phpunit.xml sample is reported when it reproduces both the root element and a testsuite; a coverage or PHPStan configuration is not reported.",
  "linkedRules": [
    "DPK-DAST-341"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-artefact-phpunit-config:phpunit-xml",
  "validationStatus": "VALIDATED"
}
