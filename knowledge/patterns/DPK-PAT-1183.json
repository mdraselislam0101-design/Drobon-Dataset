{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1183",
  "title": "Signal: Cross-Origin-Resource-Policy explicitly allows every origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Cross-Origin-Resource-Policy",
      "valuePattern": "^cross-origin$"
    }
  },
  "scope": "One response whose Cross-Origin-Resource-Policy value is cross-origin.",
  "limitations": "One header value. It does not classify the resource (public image versus authenticated document), so a deliberate public asset and an accidental application response look identical.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/doc/1",
        "status": 200,
        "headers": {
          "Cross-Origin-Resource-Policy": "cross-origin"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/doc/1",
        "status": 200,
        "headers": {
          "Cross-Origin-Resource-Policy": "CROSS-ORIGIN"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/doc/1",
        "status": 200,
        "headers": {
          "Cross-Origin-Resource-Policy": "same-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/doc/1",
        "status": 200,
        "headers": {
          "Cross-Origin-Resource-Policy": "same-site"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/doc/1",
        "status": 200,
        "headers": {
          "Cross-Origin-Resource-Policy": "cross-origin; same-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/doc/1",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "Public assets (fonts, images, CDN payloads) that are meant to be embedded by any site are reported; the observation cannot distinguish design intent.",
  "linkedRules": [
    "DPK-DAST-114"
  ],
  "origin": "original-authored",
  "cell": "dast:corp-cross-origin:cross-origin",
  "validationStatus": "VALIDATED"
}
