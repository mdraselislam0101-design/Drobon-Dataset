{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1591",
  "title": "Signal: Credential stored in user defaults (swift)",
  "targets": [
    "swift"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:UserDefaults\\.standard\\.set|UserDefaults\\.standard\\.setValue)\\s*\\("
  },
  "scope": "Single-line lexical match on user-defaults writes in swift app code.",
  "limitations": "Lexical, line-based: flags every write to the defaults store, including harmless preferences.",
  "examples": [
    {
      "line": "UserDefaults.standard.set(payload)",
      "match": true
    },
    {
      "line": "out = UserDefaults.standard.set(data)",
      "match": true
    },
    {
      "line": "myUserDefaultsstandardset(x)",
      "match": false
    },
    {
      "line": "UserDefaults.standard.set_safe()",
      "match": false
    }
  ],
  "fpNotes": "Storing a display preference or a last-used tab is the common false positive.",
  "linkedRules": [
    "DPK-SAST-964"
  ],
  "origin": "original-authored",
  "cell": "sast:ios-userdefaults-secret:swift:storage",
  "validationStatus": "VALIDATED"
}
