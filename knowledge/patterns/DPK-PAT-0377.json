{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0377",
  "title": "Signal: TLS checks disabled (mysql) — review required",
  "targets": [
    "shell"
  ],
  "signal": {
    "kind": "regex",
    "source": "--ssl-mode\\s*=\\s*DISABLED"
  },
  "scope": "Single-line lexical match on TLS-disabling flags for mysql.",
  "limitations": "Lexical, line-based: matches the flag regardless of environment.",
  "examples": [
    {
      "line": "mysql --ssl-mode=DISABLED",
      "match": true
    },
    {
      "line": "# audit: mysql --ssl-mode=DISABLED present",
      "match": true
    },
    {
      "line": "mysql --ssl-mode=REQUIRED",
      "match": false
    },
    {
      "line": "# verified: mysql --ssl-mode=REQUIRED",
      "match": false
    }
  ],
  "fpNotes": "Local bootstrap scripts are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-338"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-cli:shell:mysql",
  "validationStatus": "VALIDATED"
}
