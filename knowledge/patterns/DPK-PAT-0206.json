{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0206",
  "title": "Signal: Sensitive value in log call (vba) — review required",
  "targets": [
    "vba"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Debug\\.Print\\s+[^:\\n]*(?:password|passwd|secret|token))"
  },
  "scope": "Single-line lexical match on credential-named log values in vba code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "Debug.Print \"password=\" & pw",
      "match": true
    },
    {
      "line": "# audit: Debug.Print \"password=\" & pw present",
      "match": true
    },
    {
      "line": "Debug.Print \"user=\" & u",
      "match": false
    },
    {
      "line": "# verified: Debug.Print \"user=\" & u",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-167"
  ],
  "origin": "original-authored",
  "cell": "sast:log-langs:vba",
  "validationStatus": "VALIDATED"
}
