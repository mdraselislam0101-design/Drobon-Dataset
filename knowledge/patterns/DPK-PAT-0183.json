{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0183",
  "title": "Signal: JWT 'none' algorithm (python) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "algorithms\\s*[=:]\\s*\\[[^\\]]*[\"']none[\"']"
  },
  "scope": "Single-line lexical match on the JWT 'none' name in python code or config.",
  "limitations": "Lexical, line-based: matches the name regardless of context.",
  "examples": [
    {
      "line": "algorithms=[\"none\"]",
      "match": true
    },
    {
      "line": "# audit: algorithms=[\"none\"] present",
      "match": true
    },
    {
      "line": "algorithms=[\"HS256\"]",
      "match": false
    },
    {
      "line": "# verified: algorithms=[\"HS256\"]",
      "match": false
    }
  ],
  "fpNotes": "Test vectors demonstrating rejection of 'none' are the common false positive.",
  "linkedRules": [
    "DPK-SAST-144"
  ],
  "origin": "original-authored",
  "cell": "sast:jwt-alg-none:python",
  "validationStatus": "VALIDATED"
}
