{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3143",
  "title": "Signal: Default push source over cleartext",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "config.defaultPushSource",
      "valuePattern": "^http://"
    }
  },
  "scope": "A nuget.config file that declares a `defaultPushSource` over cleartext.",
  "limitations": "It matches a `defaultPushSource` over cleartext in the parsed nuget.config; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {
          "defaultPushSource": "http://nuget.acme.example/v3/index.json"
        },
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {
          "defaultPushSource": "http://10.24.8.9/v3/index.json"
        },
        "settings": {}
      },
      "match": true
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {
          "defaultPushSource": "https://nuget.acme.example/v3/index.json"
        },
        "settings": {}
      },
      "match": false
    },
    {
      "file": "nuget.config",
      "document": {
        "sources": [
          {
            "key": "nuget.org",
            "value": "https://api.nuget.org/v3/index.json"
          }
        ],
        "config": {},
        "settings": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A nuget.config that mentions a `defaultPushSource` over cleartext in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1006"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-default-push-source-cleartext",
  "validationStatus": "VALIDATED"
}
