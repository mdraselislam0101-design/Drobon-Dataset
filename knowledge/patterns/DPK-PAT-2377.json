{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2377",
  "title": "Signal: vcpkg manifest without a builtin baseline",
  "targets": [
    "vcpkg"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-absent",
      "path": "builtin-baseline"
    }
  },
  "scope": "A vcpkg.json file that declares a manifest that records no `builtin-baseline`.",
  "limitations": "It matches a manifest that records no `builtin-baseline` in the parsed vcpkg.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "vcpkg.json",
      "document": {
        "name": "demo",
        "dependencies": [
          {
            "name": "fmt",
            "version>=": "10.2.1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "vcpkg.json",
      "document": {
        "name": "demo",
        "dependencies": [
          {
            "name": "zlib",
            "version>=": "1.3.1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "vcpkg.json",
      "document": {
        "name": "demo",
        "builtin-baseline": "9f2c4a1b7c3d0a1b2c3d4e5f60718293",
        "dependencies": [
          {
            "name": "fmt",
            "version>=": "10.2.1"
          }
        ]
      },
      "match": false
    },
    {
      "file": "vcpkg.json",
      "document": {
        "name": "demo",
        "builtin-baseline": "0a1b2c3d4e5f60718293a4b5c6d7e8f9",
        "dependencies": [
          {
            "name": "zlib",
            "version>=": "1.3.1"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A vcpkg.json that mentions a manifest that records no `builtin-baseline` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0240"
  ],
  "origin": "original-authored",
  "cell": "sca:vcpkg-baseline-absent",
  "validationStatus": "VALIDATED"
}
