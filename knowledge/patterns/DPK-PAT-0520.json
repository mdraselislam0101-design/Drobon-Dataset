{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0520",
  "title": "Signal: Possible a Square token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "sq0atp-[A-Za-z0-9]{22,}"
  },
  "scope": "Single-line shape match for a Square token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"sq0atp-AAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"sq0atp-AAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-054"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:square-token",
  "validationStatus": "VALIDATED"
}
