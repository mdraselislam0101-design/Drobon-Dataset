{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0709",
  "title": "Signal: Sensitive value in log call (ocaml) — review required",
  "targets": [
    "ocaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Printf\\.printf\\s+[^\\n]*(?:password|passwd|secret|token))"
  },
  "scope": "Single-line lexical match on credential-named log values in ocaml code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "Printf.printf \"password=%s\" p",
      "match": true
    },
    {
      "line": "# audit: Printf.printf \"password=%s\" p present",
      "match": true
    },
    {
      "line": "Printf.printf \"user=%s\" u",
      "match": false
    },
    {
      "line": "# verified: Printf.printf \"user=%s\" u",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-592"
  ],
  "origin": "original-authored",
  "cell": "sast:log-4:ocaml",
  "validationStatus": "VALIDATED"
}
