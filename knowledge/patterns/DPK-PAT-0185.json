{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0185",
  "title": "Signal: Risky Kubernetes pod security (escalate) — review required",
  "targets": [
    "yaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "allowPrivilegeEscalation\\s*:\\s*true"
  },
  "scope": "Single-line lexical match on risky pod settings (escalate).",
  "limitations": "Lexical, line-based: matches the setting regardless of namespace trust.",
  "examples": [
    {
      "line": "allowPrivilegeEscalation: true",
      "match": true
    },
    {
      "line": "# audit: allowPrivilegeEscalation: true present",
      "match": true
    },
    {
      "line": "allowPrivilegeEscalation: false",
      "match": false
    },
    {
      "line": "# verified: allowPrivilegeEscalation: false",
      "match": false
    }
  ],
  "fpNotes": "System daemons needing host access are the common accepted case — confirm scope.",
  "linkedRules": [
    "DPK-SAST-146"
  ],
  "origin": "original-authored",
  "cell": "sast:k8s-strict:yaml:escalate",
  "validationStatus": "VALIDATED"
}
