{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1156",
  "title": "Signal: Content-Security-Policy without default-src",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-missing-directive",
      "header": "Content-Security-Policy",
      "directive": "default-src"
    }
  },
  "scope": "One response: the policy has no default-src directive.",
  "limitations": "Observation-level: the same check also fires when the header is entirely absent, which DPK-DAST-002 separately reports as the stronger finding. Read both rows together.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'; object-src 'none'; frame-ancestors 'self'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/checkout",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self' https://cdn.example; img-src 'self'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; script-src 'self'; object-src 'none'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "img-src 'self'; default-src 'none'"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A policy that lists every fetch directive explicitly needs no fallback and is a documented false positive of this check.",
  "linkedRules": [
    "DPK-DAST-087"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-no-default-src:default-src",
  "validationStatus": "VALIDATED"
}
