{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1087",
  "title": "Signal: Two-argument open in perl — review required",
  "targets": [
    "perl"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bopen\\s*\\(\\s*[^,()\\n]+,\\s*(?:my )?\\$"
  },
  "scope": "Single-line match on two-argument open in perl.",
  "limitations": "Lexical: matches open with exactly two arguments on one line; a filehandle passed separately is out of scope.",
  "examples": [
    {
      "line": "open(FH, $filename);",
      "match": true
    },
    {
      "line": "# audit: open(FH, $filename); present",
      "match": true
    },
    {
      "line": "open(my $fh, \"<\", $filename);",
      "match": false
    },
    {
      "line": "# verified: open(my $fh, \"<\", $filename);",
      "match": false
    }
  ],
  "fpNotes": "A literal filename constant is the accepted false positive.",
  "linkedRules": [
    "DPK-SAST-904"
  ],
  "origin": "original-authored",
  "cell": "sast:perl-two-arg-open:perl",
  "validationStatus": "VALIDATED"
}
