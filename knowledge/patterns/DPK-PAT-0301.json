{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0301",
  "title": "Signal: listen left open (memcached) — review required",
  "targets": [
    "memcached"
  ],
  "signal": {
    "kind": "regex",
    "source": "-l\\s+0\\.0\\.0\\.0"
  },
  "scope": "Single-line lexical match on open settings for listen.",
  "limitations": "Lexical, line-based: matches the setting regardless of network isolation.",
  "examples": [
    {
      "line": "memcached -l 0.0.0.0",
      "match": true
    },
    {
      "line": "# audit: memcached -l 0.0.0.0 present",
      "match": true
    },
    {
      "line": "memcached -l 127.0.0.1",
      "match": false
    },
    {
      "line": "# verified: memcached -l 127.0.0.1",
      "match": false
    }
  ],
  "fpNotes": "Isolated test instances are the common false positive — confirm isolation.",
  "linkedRules": [
    "DPK-SAST-262"
  ],
  "origin": "original-authored",
  "cell": "sast:service-open:memcached:listen",
  "validationStatus": "VALIDATED"
}
