{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2353",
  "title": "Signal: Hex dependency fetched from a git remote",
  "targets": [
    "hex"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "deps[].git",
      "valuePattern": "^https?://"
    }
  },
  "scope": "A mix.exs file that declares a dependency sourced from git rather than hex.pm.",
  "limitations": "It matches a dependency sourced from git rather than hex.pm in the parsed mix.exs; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "acme_sdk",
            "git": "https://github.com/acme/sdk.git",
            "tag": "v4.2.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "acme_cli",
            "git": "https://github.com/acme/cli.git",
            "branch": "main"
          }
        ]
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "phoenix",
            "requirement": "~> 1.7.10"
          }
        ]
      },
      "match": false
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "ecto",
            "requirement": "~> 3.11"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A mix.exs that mentions a dependency sourced from git rather than hex.pm in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0216"
  ],
  "origin": "original-authored",
  "cell": "sca:hex-dependency-git",
  "validationStatus": "VALIDATED"
}
