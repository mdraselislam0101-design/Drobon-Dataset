{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1024",
  "title": "Signal: Content-Security-Policy delivered in report-only mode",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy-Report-Only",
      "valuePattern": "\\S"
    }
  },
  "scope": "One response: confirm whether policy enforcement is report-only.",
  "limitations": "Header observation only: the policy contents and the violation reports are not evaluated.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy-Report-Only": "default-src 'self'; report-uri /csp"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/account",
        "status": 200,
        "headers": {
          "Content-Security-Policy-Report-Only": "script-src 'self'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy-Report-Only": ""
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A short, documented rollout window is the accepted exception and must have an owner and an end date.",
  "linkedRules": [
    "DPK-DAST-072"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-report-only:csp-report-only",
  "validationStatus": "VALIDATED"
}
