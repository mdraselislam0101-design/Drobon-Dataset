{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1239",
  "title": "Signal: Jupyter notebook server disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*Jupyter\\ Notebook)(?=[\\s\\S]*notebook_path)"
    }
  },
  "scope": "One response whose body contains both the Jupyter Notebook title and a notebook_path attribute.",
  "limitations": "One response body. The rule reports the tree page; it does not attempt to start a kernel or read a notebook, and a token-protected server is indistinguishable from an open one at this layer.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Jupyter Notebook</title></head><body><div id=\"notebook\" data-notebook_path=\"/tree\"></div><script src=\"/static/tree.js\"></script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><head><title>Home Page - Jupyter Notebook</title></head><body><div data-notebook_path=\"/lab\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><div id=\"notebook\" data-=\"/tree\"></div><script src=\"/static/tree.js\"></script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published notebook server is still reported; the finding is reachability, not proof that a kernel can be started.",
  "linkedRules": [
    "DPK-DAST-170"
  ],
  "origin": "original-authored",
  "cell": "dast:body-jupyter-notebook:jupyter-notebook",
  "validationStatus": "VALIDATED"
}
