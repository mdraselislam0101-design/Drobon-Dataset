{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0056",
  "title": "Signal: Dangerous HTTP method allowed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Allow",
      "valuePattern": "\\b(?:PUT|DELETE|TRACE|CONNECT)\\b"
    }
  },
  "scope": "Single Allow header value.",
  "limitations": "Header check: it cannot exercise the method.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Allow": "GET, PUT"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Allow": "GET, HEAD, OPTIONS, TRACE"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Allow": "GET, POST"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "APIs needing PUT or DELETE are the common accepted case — confirm auth.",
  "linkedRules": [
    "DPK-DAST-026"
  ],
  "origin": "original-authored",
  "cell": "dast:http-methods:allow-danger",
  "validationStatus": "VALIDATED"
}
