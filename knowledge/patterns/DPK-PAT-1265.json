{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1265",
  "title": "Signal: Access-Control-Allow-Origin carries userinfo",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Allow-Origin",
      "valuePattern": "^\\s*https?://[^\\s/@]+@"
    }
  },
  "scope": "One response whose Access-Control-Allow-Origin value carries a userinfo component.",
  "limitations": "One header value. The rule reports the userinfo form and cannot see whether the value was derived from the request Origin.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://user@app.example"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://user:pass@app.example"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://app.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://app.example/path@x"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A path that contains `@` after the first slash is not reported; only userinfo before the host counts.",
  "linkedRules": [
    "DPK-DAST-196"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-origin-userinfo:origin-userinfo",
  "validationStatus": "VALIDATED"
}
