{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2151",
  "title": "Signal: Dependency fetched over cleartext HTTP",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^http://"
    }
  },
  "scope": "A package.json file that declares a dependency URL that uses cleartext `http://`.",
  "limitations": "It matches a dependency URL that uses cleartext `http://` in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "http://downloads.acme.example/sdk-4.2.0.tgz"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "http://registry.acme.example/sdk"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "https://downloads.acme.example/sdk-4.2.0.tgz"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A local `http://127.0.0.1` mirror inside an isolated build is reported as well; record it as an accepted exception if that is the policy.",
  "linkedRules": [
    "DPK-SCA-0014"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-http-url",
  "validationStatus": "VALIDATED"
}
