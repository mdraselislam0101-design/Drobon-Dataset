{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0225",
  "title": "Signal: Android backup allowed (xml) — review required",
  "targets": [
    "xml"
  ],
  "signal": {
    "kind": "regex",
    "source": "android:allowBackup\\s*=\\s*[\"']true[\"']"
  },
  "scope": "Single-line lexical match on the manifest flag.",
  "limitations": "Lexical, line-based: matches the flag.",
  "examples": [
    {
      "line": "android:allowBackup=\"true\"",
      "match": true
    },
    {
      "line": "# audit: android:allowBackup=\"true\" present",
      "match": true
    },
    {
      "line": "android:allowBackup=\"false\"",
      "match": false
    },
    {
      "line": "# verified: android:allowBackup=\"false\"",
      "match": false
    }
  ],
  "fpNotes": "Apps without sensitive data are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-186"
  ],
  "origin": "original-authored",
  "cell": "sast:mobile-backup:xml:backup",
  "validationStatus": "VALIDATED"
}
