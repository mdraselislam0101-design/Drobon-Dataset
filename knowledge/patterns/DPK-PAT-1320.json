{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1320",
  "title": "Signal: Cache-Control declares public and no-store together",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Cache-Control",
      "valuePattern": "^(?=[\\s\\S]*\\bpublic\\b)(?=[\\s\\S]*\\bno-store\\b)"
    }
  },
  "scope": "One response whose Cache-Control value contains public and no-store.",
  "limitations": "One header value. The rule reports the contradictory pair and does not decide which directive an intermediary applies.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cache-Control": "public, no-store"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cache-Control": "public, max-age=3600, no-store"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cache-Control": "public, max-age=3600"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cache-Control": "no-store, private"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A response that uses private with no-store is not reported; the contradiction requires public.",
  "linkedRules": [
    "DPK-DAST-251"
  ],
  "origin": "original-authored",
  "cell": "dast:cache-control-contradictory:control-contradictory",
  "validationStatus": "VALIDATED"
}
