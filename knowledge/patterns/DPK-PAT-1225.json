{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1225",
  "title": "Signal: Origin-Agent-Cluster explicitly disables origin-keyed agent clustering",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Origin-Agent-Cluster",
      "valuePattern": "^\\s*\\?0\\s*$"
    }
  },
  "scope": "One response whose Origin-Agent-Cluster value is ?0.",
  "limitations": "One header value. The rule reports the explicit opt-out; it cannot determine whether any same-site document actually shares the cluster in a deployment.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Origin-Agent-Cluster": "?0"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Origin-Agent-Cluster": "?0 "
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Origin-Agent-Cluster": "?1"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Origin-Agent-Cluster": ""
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A deployment that needs agent-cluster sharing for a documented reason is reported; the opt-out is still the observable fact.",
  "linkedRules": [
    "DPK-DAST-156"
  ],
  "origin": "original-authored",
  "cell": "dast:origin-agent-cluster-disabled:disabled",
  "validationStatus": "VALIDATED"
}
