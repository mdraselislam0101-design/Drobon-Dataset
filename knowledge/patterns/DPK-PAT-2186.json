{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2186",
  "title": "Signal: Lockfile resolves a source archive instead of a package",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.resolved",
      "valuePattern": "^https://codeload\\.github\\.com/"
    }
  },
  "scope": "A package-lock.json file that declares a lockfile entry that points at a forge source archive.",
  "limitations": "It matches a lockfile entry that points at a forge source archive in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://codeload.github.com/acme/sdk/tar.gz/9f2c4a1",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://codeload.github.com/acme/cli/tar.gz/refs/tags/v2"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org/x/-/x-1.0.0.tgz",
            "integrity": "sha512-AAAABBBBCCCCDDDD"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "resolved": "https://registry.npmjs.org/y/-/y-1.0.0.tgz"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "An archive URL pinned to a commit sha is immutable but still outside the registry; it is reported as the same source kind.",
  "linkedRules": [
    "DPK-SCA-0049"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-resolved-github-archive",
  "validationStatus": "VALIDATED"
}
