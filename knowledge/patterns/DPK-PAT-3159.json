{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3159",
  "title": "Signal: Hex dependency limited to one environment",
  "targets": [
    "hex"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "deps[].only",
      "valuePattern": "^(?:dev|test)$"
    }
  },
  "scope": "A mix.exs file that declares a dependency that is compiled only in `dev` or `test`.",
  "limitations": "It matches a dependency that is compiled only in `dev` or `test` in the parsed mix.exs; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "credo",
            "requirement": "~> 1.7",
            "only": "dev"
          }
        ]
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "ex_machina",
            "requirement": "~> 2.7",
            "only": "test"
          }
        ]
      },
      "match": true
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "phoenix",
            "requirement": "~> 1.7",
            "only": "prod"
          }
        ]
      },
      "match": false
    },
    {
      "file": "mix.exs",
      "document": {
        "project": {
          "app": "demo_service"
        },
        "deps": [
          {
            "name": "ecto",
            "requirement": "~> 3.12"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A mix.exs that mentions a dependency that is compiled only in `dev` or `test` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-1022"
  ],
  "origin": "original-authored",
  "cell": "sca:hex-dev-only-dependency",
  "validationStatus": "VALIDATED"
}
