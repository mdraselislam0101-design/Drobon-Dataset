{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2946",
  "title": "Signal: Test environment forwards secrets",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "testenv.passenv[]",
      "valuePattern": "^(?:\\*|AWS_.+|[A-Z_]*_TOKEN|[A-Z_]*_PASSWORD)$"
    }
  },
  "scope": "A tox.ini file that declares a `passenv` entry that hands credentials to the test process.",
  "limitations": "It matches a `passenv` entry that hands credentials to the test process in the parsed tox.ini; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "tox.ini",
      "document": {
        "tox": {
          "envlist": "py311"
        },
        "testenv": {
          "deps": [
            "pytest==8.3.3"
          ],
          "passenv": [
            "*"
          ]
        }
      },
      "match": true
    },
    {
      "file": "tox.ini",
      "document": {
        "tox": {
          "envlist": "py311"
        },
        "testenv": {
          "deps": [
            "pytest==8.3.3"
          ],
          "passenv": [
            "AWS_SECRET_ACCESS_KEY"
          ]
        }
      },
      "match": true
    },
    {
      "file": "tox.ini",
      "document": {
        "tox": {
          "envlist": "py311"
        },
        "testenv": {
          "deps": [
            "pytest==8.3.3"
          ],
          "passenv": []
        }
      },
      "match": false
    },
    {
      "file": "tox.ini",
      "document": {
        "tox": {
          "envlist": "py311"
        },
        "testenv": {
          "deps": [
            "pytest==8.3.3"
          ],
          "passenv": [
            "CI"
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A tox.ini that mentions a `passenv` entry that hands credentials to the test process in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0809"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-tox-env-passes-env",
  "validationStatus": "VALIDATED"
}
