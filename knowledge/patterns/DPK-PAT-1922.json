{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1922",
  "title": "Signal: Bulk customer records in a single response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "\\[\\s*\\{[^{}]{0,400}?\"(?:nid|nationalId|customerId)\"[\\s\\S]{0,400}?\\},\\s*\\{[^{}]{0,400}?\"(?:nid|nationalId|customerId)\""
    }
  },
  "scope": "A response body that carries a response array with many customer records carrying identity fields.",
  "limitations": "One response body, first 32,768 bytes. It matches an array of several customer records with identity fields; it cannot tell whether the value behind the marker is live or whether the page needs authentication.",
  "examples": [
    {
      "observation": {
        "url": "https://bank.example/portal/home",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "[{\"customerId\":\"C-8841\",\"nid\":\"1990123456789\"},{\"customerId\":\"C-8842\",\"nid\":\"1991023456781\"}]"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/api/detail",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "[{\"customerId\":\"C-1180\",\"nid\":\"1988112233445\"},{\"customerId\":\"C-1181\",\"nid\":\"1989011223344\"},{\"customerId\":\"C-1182\",\"nid\":\"1990030412345\"}]"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://bank.example/help/security",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "Cache-Control": "no-store"
        },
        "body": "[{\"customerId\":\"C-8841\",\"maskedNid\":\"1990*****89\"}]"
      },
      "match": false
    }
  ],
  "fpNotes": "A single customer record is not reported.",
  "linkedRules": [
    "DPK-DAST-803"
  ],
  "origin": "original-authored",
  "cell": "dast:body-bulk-customer-export:body-bulk-customer-export",
  "validationStatus": "VALIDATED"
}
