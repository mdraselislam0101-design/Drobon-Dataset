{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1200",
  "title": "Signal: Go pprof profiling index disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*<title>\\s*/debug/pprof/)"
    }
  },
  "scope": "One response whose body contains the pprof index title.",
  "limitations": "One body marker. The title string is specific to the pprof handler; a page that merely mentions /debug/pprof is not matched unless it reproduces the title.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/debug/pprof/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>/debug/pprof/</title></head><body>profiles:</body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/debug/pprof",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title> /debug/pprof/ </title></head></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/debug",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>The profiler lives at /debug/pprof/ on the internal port.</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Home</title></head></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A documentation page that shows the pprof title inside an escaped code block is not matched.",
  "linkedRules": [
    "DPK-DAST-131"
  ],
  "origin": "original-authored",
  "cell": "dast:body-go-pprof-index:body-go-pprof-index",
  "validationStatus": "VALIDATED"
}
