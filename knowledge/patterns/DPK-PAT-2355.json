{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2355",
  "title": "Signal: mix.lock records a weak hash algorithm",
  "targets": [
    "hex"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.hash",
      "valuePattern": "^(?!sha256:)"
    }
  },
  "scope": "A mix.lock file that declares a lockfile hash that is not SHA-256.",
  "limitations": "It matches a lockfile hash that is not SHA-256 in the parsed mix.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "mix.lock",
      "document": {
        "packages": {
          "phoenix": {
            "version": "1.7.10",
            "hash": "md5:aaaabbbb"
          }
        }
      },
      "match": true
    },
    {
      "file": "mix.lock",
      "document": {
        "packages": {
          "ecto": {
            "version": "3.11.2",
            "hash": "sha1:ccccdddd"
          }
        }
      },
      "match": true
    },
    {
      "file": "mix.lock",
      "document": {
        "packages": {
          "phoenix": {
            "version": "1.7.10",
            "hash": "sha256:aaaa"
          }
        }
      },
      "match": false
    },
    {
      "file": "mix.lock",
      "document": {
        "packages": {
          "ecto": {
            "version": "3.11.2",
            "hash": "sha256:bbbb"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A mix.lock that mentions a lockfile hash that is not SHA-256 in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0218"
  ],
  "origin": "original-authored",
  "cell": "sca:hex-lock-hash-not-sha256",
  "validationStatus": "VALIDATED"
}
