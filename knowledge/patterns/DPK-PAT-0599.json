{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0599",
  "title": "Signal: Unsafe .NET call Html.Raw (csharp) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Html\\.Raw)\\s*\\("
  },
  "scope": "Single-line lexical match on the Html.Raw call in csharp code.",
  "limitations": "Lexical, line-based: any Html.Raw call matches.",
  "examples": [
    {
      "line": "Html.Raw(payload)",
      "match": true
    },
    {
      "line": "out = Html.Raw(data)",
      "match": true
    },
    {
      "line": "myHtmlRaw(x)",
      "match": false
    },
    {
      "line": "Html.Raw_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted local data is the common false positive.",
  "linkedRules": [
    "DPK-SAST-482"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-call:csharp:raw",
  "validationStatus": "VALIDATED"
}
