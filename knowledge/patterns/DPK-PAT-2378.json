{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2378",
  "title": "Signal: vcpkg registry cloned over cleartext",
  "targets": [
    "vcpkg"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "registries[].repository",
      "valuePattern": "^http://"
    }
  },
  "scope": "A vcpkg-configuration.json file that declares a registry repository URL that uses cleartext http.",
  "limitations": "It matches a registry repository URL that uses cleartext http in the parsed vcpkg-configuration.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "vcpkg-configuration.json",
      "document": {
        "registries": [
          {
            "kind": "git",
            "repository": "http://git.acme.example/vcpkg-registry",
            "baseline": "9f2c4a1"
          }
        ]
      },
      "match": true
    },
    {
      "file": "vcpkg-configuration.json",
      "document": {
        "registries": [
          {
            "kind": "git",
            "repository": "http://10.24.8.9/vcpkg-registry",
            "baseline": "0a1b2c3"
          }
        ]
      },
      "match": true
    },
    {
      "file": "vcpkg-configuration.json",
      "document": {
        "registries": [
          {
            "kind": "git",
            "repository": "https://git.acme.example/vcpkg-registry",
            "baseline": "9f2c4a1"
          }
        ]
      },
      "match": false
    },
    {
      "file": "vcpkg-configuration.json",
      "document": {
        "registries": [
          {
            "kind": "filesystem",
            "path": "../vcpkg-registry"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A vcpkg-configuration.json that mentions a registry repository URL that uses cleartext http in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0241"
  ],
  "origin": "original-authored",
  "cell": "sca:vcpkg-registry-cleartext",
  "validationStatus": "VALIDATED"
}
