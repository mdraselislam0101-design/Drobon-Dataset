{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0461",
  "title": "Signal: Unescaped template output (vue, javascript) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "v-html\\s*="
  },
  "scope": "Single-line lexical match on unescaped output in vue templates.",
  "limitations": "Lexical, line-based: matches the construct regardless of value trust.",
  "examples": [
    {
      "line": "<div v-html=\"x\">",
      "match": true
    },
    {
      "line": "# audit: <div v-html=\"x\"> present",
      "match": true
    },
    {
      "line": "<div>{{x}}</div>",
      "match": false
    },
    {
      "line": "# verified: <div>{{x}}</div>",
      "match": false
    }
  ],
  "fpNotes": "Trusted constant markup is the common false positive.",
  "linkedRules": [
    "DPK-SAST-422"
  ],
  "origin": "original-authored",
  "cell": "sast:xss-templates:javascript:vue",
  "validationStatus": "VALIDATED"
}
