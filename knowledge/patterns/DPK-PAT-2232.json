{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2232",
  "title": "Signal: Yarn lockfile entry without a checksum",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "entries",
      "field": "checksum"
    }
  },
  "scope": "A yarn.lock file that declares a Yarn Berry entry that records no archive checksum.",
  "limitations": "It matches a Yarn Berry entry that records no archive checksum in the parsed yarn.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "left-pad",
            "version": "1.3.0",
            "resolution": "left-pad@npm:1.3.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "ms",
            "version": "2.1.3",
            "resolution": "ms@npm:2.1.3",
            "dependencies": {}
          }
        ]
      },
      "match": true
    },
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "left-pad",
            "version": "1.3.0",
            "checksum": "8/abcdef"
          }
        ]
      },
      "match": false
    },
    {
      "file": "yarn.lock",
      "document": {
        "entries": [
          {
            "name": "ms",
            "version": "2.1.3",
            "checksum": "10/0123456789"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A yarn.lock that mentions a Yarn Berry entry that records no archive checksum in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0095"
  ],
  "origin": "original-authored",
  "cell": "sca:yarn-lock-checksum-absent",
  "validationStatus": "VALIDATED"
}
