{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2143",
  "title": "Signal: Dependency fetched over the unauthenticated git protocol",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^git://"
    }
  },
  "scope": "A package.json file that declares a dependency URL that uses the `git://` protocol.",
  "limitations": "It matches a dependency URL that uses the `git://` protocol in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "git://github.com/acme/sdk.git"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-cli": "git://gitlab.com/acme/cli.git"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "git+https://github.com/acme/sdk.git"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "acme-sdk": "4.2.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A local mirror configured for `git://` inside a hardened build network is a policy exception, not a detection difference.",
  "linkedRules": [
    "DPK-SCA-0006"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-git-protocol",
  "validationStatus": "VALIDATED"
}
