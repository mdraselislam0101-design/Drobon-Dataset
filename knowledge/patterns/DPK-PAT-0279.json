{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0279",
  "title": "Signal: Redirect via Redirect::to (rust) — review required",
  "targets": [
    "rust"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Redirect::to)\\s*\\("
  },
  "scope": "Single-line lexical match on the Redirect::to call in rust code.",
  "limitations": "Lexical, line-based: any Redirect::to call matches.",
  "examples": [
    {
      "line": "Redirect::to(payload)",
      "match": true
    },
    {
      "line": "out = Redirect::to(data)",
      "match": true
    },
    {
      "line": "myRedirectto(x)",
      "match": false
    },
    {
      "line": "Redirect::to_safe()",
      "match": false
    }
  ],
  "fpNotes": "Fixed targets are the common false positive.",
  "linkedRules": [
    "DPK-SAST-240"
  ],
  "origin": "original-authored",
  "cell": "sast:redirect-call-extra:rust",
  "validationStatus": "VALIDATED"
}
