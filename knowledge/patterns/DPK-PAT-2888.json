{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2888",
  "title": "Signal: Version forced by a resolution strategy",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "configurations[].resolutionStrategy.force[].version",
      "valuePattern": "^.+$"
    }
  },
  "scope": "A build.gradle file that declares a forced version that overrides every declared constraint.",
  "limitations": "It matches a forced version that overrides every declared constraint in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [
          {
            "name": "runtimeClasspath",
            "resolutionStrategy": {
              "force": [
                {
                  "group": "com.acme",
                  "name": "sdk",
                  "version": "4.2.0"
                }
              ]
            }
          }
        ],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [
          {
            "name": "compileClasspath",
            "resolutionStrategy": {
              "force": [
                {
                  "group": "org.slf4j",
                  "name": "slf4j-api",
                  "version": "1.7.36"
                }
              ]
            }
          }
        ],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [
          {
            "name": "runtimeClasspath",
            "resolutionStrategy": {
              "force": []
            }
          }
        ],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "central",
            "url": "https://repo1.maven.org/maven2"
          }
        ],
        "dependencies": [
          {
            "group": "org.slf4j",
            "name": "slf4j-api",
            "version": "2.0.13"
          }
        ],
        "configurations": [],
        "dependencyLocking": {
          "lockAllConfigurations": true
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A build.gradle that mentions a forced version that overrides every declared constraint in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0751"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-forced-version",
  "validationStatus": "VALIDATED"
}
