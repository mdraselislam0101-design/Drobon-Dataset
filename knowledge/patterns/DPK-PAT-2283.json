{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2283",
  "title": "Signal: Python requirement pinned without a hash",
  "targets": [
    "pypi"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "requirements",
      "field": "hashes"
    }
  },
  "scope": "A requirements.txt file that declares a pinned requirement that carries no `--hash` value.",
  "limitations": "It matches a pinned requirement that carries no `--hash` value in the parsed requirements.txt; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "requests",
            "specifier": "==2.32.3"
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "flask",
            "specifier": "==3.0.3"
          },
          {
            "name": "jinja2",
            "specifier": "==3.1.4"
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "urllib3",
            "specifier": "==2.2.2"
          },
          {
            "name": "certifi",
            "specifier": "==2024.8.30"
          }
        ]
      },
      "match": true
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "requests",
            "specifier": "==2.32.3",
            "hashes": [
              "sha256:aaaa"
            ]
          },
          {
            "name": "flask",
            "specifier": "==3.0.3",
            "hashes": [
              "sha256:bbbb"
            ]
          }
        ]
      },
      "match": false
    },
    {
      "file": "requirements.txt",
      "document": {
        "requirements": [
          {
            "name": "jinja2",
            "specifier": "==3.1.4",
            "hashes": [
              "sha256:cccc"
            ]
          },
          {
            "name": "click",
            "specifier": "==8.1.7",
            "hashes": [
              "sha256:dddd"
            ]
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A requirements.txt that mentions a pinned requirement that carries no `--hash` value in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0146"
  ],
  "origin": "original-authored",
  "cell": "sca:pypi-requirement-no-hash",
  "validationStatus": "VALIDATED"
}
