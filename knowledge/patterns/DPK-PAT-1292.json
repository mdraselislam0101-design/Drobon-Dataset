{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1292",
  "title": "Signal: H2 database console disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*H2\\ Console)(?=[\\s\\S]*JDBC\\ URL)"
    }
  },
  "scope": "One response whose body renders the H2 console login form.",
  "limitations": "One response body. The rule reports the console form; it does not submit a JDBC URL and cannot show which databases the server can reach.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>H2 Console</title></head><body><form method=\"post\" action=\"login.do\"><input name=\"url\" value=\"jdbc:h2:mem:test\"><label>JDBC URL</label><input name=\"user\"></form></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><h1>H2 Console</h1><form><input name=\"driver\" value=\"org.h2.Driver\"><span>JDBC URL</span></form></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title></title></head><body><form method=\"post\" action=\"login.do\"><input name=\"url\" value=\"jdbc:h2:mem:test\"><label></label><input name=\"user\"></form></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that describes the console without the JDBC URL field is not reported.",
  "linkedRules": [
    "DPK-DAST-223"
  ],
  "origin": "original-authored",
  "cell": "dast:body-h2-console:h2-console",
  "validationStatus": "VALIDATED"
}
