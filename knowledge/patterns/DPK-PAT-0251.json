{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0251",
  "title": "Signal: File access built from input (matlab) — review required",
  "targets": [
    "matlab"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:fopen\\s*\\([^)]*\\+)"
  },
  "scope": "Single-line lexical match on input-built paths in matlab code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "fopen(dir + f)",
      "match": true
    },
    {
      "line": "# audit: fopen(dir + f) present",
      "match": true
    },
    {
      "line": "fopen(fixed)",
      "match": false
    },
    {
      "line": "# verified: fopen(fixed)",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-212"
  ],
  "origin": "original-authored",
  "cell": "sast:path-langs:matlab",
  "validationStatus": "VALIDATED"
}
