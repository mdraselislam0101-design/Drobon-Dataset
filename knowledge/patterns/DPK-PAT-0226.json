{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0226",
  "title": "Signal: Android component exported (xml) — review required",
  "targets": [
    "xml"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:android:exported\\s*=\\s*[\"']true[\"'])"
  },
  "scope": "Single-line lexical match on the manifest flag.",
  "limitations": "Lexical, line-based: matches the flag regardless of permissions.",
  "examples": [
    {
      "line": "android:exported=\"true\"",
      "match": true
    },
    {
      "line": "# audit: android:exported=\"true\" present",
      "match": true
    },
    {
      "line": "android:exported=\"false\"",
      "match": false
    },
    {
      "line": "# verified: android:exported=\"false\"",
      "match": false
    }
  ],
  "fpNotes": "Launcher activities are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-187"
  ],
  "origin": "original-authored",
  "cell": "sast:mobile-exported:xml:exported",
  "validationStatus": "VALIDATED"
}
