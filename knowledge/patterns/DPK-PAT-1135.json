{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1135",
  "title": "Signal: Release variant signed with the debug key in gradle — review required",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\bsigningConfig\\s+signingConfigs\\.debug\\b"
  },
  "scope": "Single-line match on debug signing in gradle.",
  "limitations": "Lexical: matches the assignment; a release build type that overrides it later is not linked.",
  "examples": [
    {
      "line": "signingConfig signingConfigs.debug",
      "match": true
    },
    {
      "line": "# audit: signingConfig signingConfigs.debug present",
      "match": true
    },
    {
      "line": "signingConfig signingConfigs.release",
      "match": false
    },
    {
      "line": "# verified: signingConfig signingConfigs.release",
      "match": false
    }
  ],
  "fpNotes": "A debug-only variant is the accepted exception.",
  "linkedRules": [
    "DPK-SAST-950"
  ],
  "origin": "original-authored",
  "cell": "sast:gradle-debug-signing:gradle",
  "validationStatus": "VALIDATED"
}
