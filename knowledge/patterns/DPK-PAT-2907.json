{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2907",
  "title": "Signal: Pod declared from a local path",
  "targets": [
    "cocoapods"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "pods[].path",
      "valuePattern": "^\\.{0,2}/"
    }
  },
  "scope": "A Podfile file that declares a pod resolved from a directory on the build machine.",
  "limitations": "It matches a pod resolved from a directory on the build machine in the parsed Podfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "AcmeCore",
            "path": "../acme-core"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "AcmeSDK",
            "path": "/opt/vendor/acme-sdk"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": "~> 5.9"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "SnapKit",
            "requirement": "~> 5.7"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Podfile that mentions a pod resolved from a directory on the build machine in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0770"
  ],
  "origin": "original-authored",
  "cell": "sca:podfile-local-path",
  "validationStatus": "VALIDATED"
}
