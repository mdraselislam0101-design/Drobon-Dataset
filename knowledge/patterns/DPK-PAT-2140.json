{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2140",
  "title": "Signal: Dependency pinned to the latest dist-tag",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*",
      "valuePattern": "^latest$"
    }
  },
  "scope": "A package.json file that declares a dependency pinned to the `latest` dist-tag instead of a version.",
  "limitations": "It matches a dependency pinned to the `latest` dist-tag instead of a version in the parsed package.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "typescript": "latest"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "eslint": "latest"
        }
      },
      "match": true
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "typescript": "5.5.4"
        }
      },
      "match": false
    },
    {
      "file": "package.json",
      "document": {
        "name": "demo-service",
        "version": "1.4.0",
        "dependencies": {
          "eslint": "^9.9.0"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A tooling script that documents `latest` in prose is not reported.",
  "linkedRules": [
    "DPK-SCA-0003"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-dependency-latest-tag",
  "validationStatus": "VALIDATED"
}
