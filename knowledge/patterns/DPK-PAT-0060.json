{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0060",
  "title": "Signal: Server version disclosed (Server header)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Server",
      "valuePattern": "[0-9]+\\.[0-9]+"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Banner check: version visibility alone is not exploitability.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "Apache/2.4.58"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "nginx/1.25.3"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "Honeypot banners are the rare false positive.",
  "linkedRules": [
    "DPK-DAST-030"
  ],
  "origin": "original-authored",
  "cell": "dast:server-version:server",
  "validationStatus": "VALIDATED"
}
