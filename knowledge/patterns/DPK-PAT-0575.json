{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0575",
  "title": "Signal: Weak response control (protocol-relative Location)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Location",
      "valuePattern": "^//"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Header check: it cannot confirm exploitability.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 302,
        "headers": {
          "Location": "//evil.example/x"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 301,
        "headers": {
          "Location": "//cdn.example/x"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 302,
        "headers": {
          "Location": "https://app.example/x"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "CDN behaviors are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-050"
  ],
  "origin": "original-authored",
  "cell": "dast:response-weak-2:location-proto",
  "validationStatus": "VALIDATED"
}
