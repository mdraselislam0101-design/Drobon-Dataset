{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1203",
  "title": "Signal: better_errors debug page disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*better_errors)(?=[\\s\\S]*Better Errors)"
    }
  },
  "scope": "One response whose body references better_errors and renders the Better Errors heading.",
  "limitations": "Two body markers. A generic Rails stack frame is reported by the Rails stack rule; this rule requires the gem's own page markers.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/boom",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<div id=\"better_errors_dialog\"><h1>Better Errors</h1><p>RuntimeError: boom</p><div class=\"console\">>> </div></div><script src=\"/assets/better_errors.js\"></script>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/api/boom",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<h1>Better Errors</h1> raised in better_errors/renderer.rb"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>Home</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/boom",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<h1>We are sorry, but something went wrong.</h1>"
      },
      "match": false
    }
  ],
  "fpNotes": "A Gemfile snippet quoted in a page is reported only if the gem markers appear as rendered content.",
  "linkedRules": [
    "DPK-DAST-134"
  ],
  "origin": "original-authored",
  "cell": "dast:body-rails-better-errors:body-rails-better-errors",
  "validationStatus": "VALIDATED"
}
