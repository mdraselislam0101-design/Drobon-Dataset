{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0681",
  "title": "Signal: Dangerous JS construct (proto) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "__proto__"
  },
  "scope": "Single-line lexical match on dangerous constructs (proto).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "a.__proto__ = b",
      "match": true
    },
    {
      "line": "# audit: a.__proto__ = b present",
      "match": true
    },
    {
      "line": "a.prototype = b",
      "match": false
    },
    {
      "line": "# verified: a.prototype = b",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-564"
  ],
  "origin": "original-authored",
  "cell": "sast:js-flag:javascript:proto",
  "validationStatus": "VALIDATED"
}
