{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2203",
  "title": "Signal: Lockfile entry records no supported Node version",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-entry-missing-field",
      "path": "packages",
      "field": "engines"
    }
  },
  "scope": "A package-lock.json file that declares a package entry that declares no supported Node runtime.",
  "limitations": "It matches a package entry that declares no supported Node runtime in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "engines": {
              "node": ">=18"
            },
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "engines": {
              "node": ">=20.11"
            },
            "integrity": "sha512-BBBB"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pure-data package with no runtime requirement is still reported; the missing constraint is the finding.",
  "linkedRules": [
    "DPK-SCA-0066"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-engine-node-absent",
  "validationStatus": "VALIDATED"
}
