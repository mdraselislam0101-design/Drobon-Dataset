{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2925",
  "title": "Signal: Build flags that trade safety for speed",
  "targets": [
    "cargo"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "build.rustflags[]",
      "valuePattern": "^(?:-C\\s)?(?:panic=abort|codegen-units=[0-9]+)$"
    }
  },
  "scope": "A .cargo/config.toml file that declares a rustflag that changes code generation for the whole workspace.",
  "limitations": "It matches a rustflag that changes code generation for the whole workspace in the parsed .cargo/config.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": ".cargo/config.toml",
      "document": {
        "source": {
          "crates-io": {
            "replace-with": "acme"
          }
        },
        "registries": {
          "acme": {
            "index": "https://registry.acme.example/index"
          }
        },
        "build": {
          "rustflags": [
            "codegen-units=16"
          ]
        }
      },
      "match": true
    },
    {
      "file": ".cargo/config.toml",
      "document": {
        "source": {
          "crates-io": {
            "replace-with": "acme"
          }
        },
        "registries": {
          "acme": {
            "index": "https://registry.acme.example/index"
          }
        },
        "build": {
          "rustflags": [
            "-C",
            "panic=abort"
          ]
        }
      },
      "match": true
    },
    {
      "file": ".cargo/config.toml",
      "document": {
        "source": {
          "crates-io": {
            "replace-with": "acme"
          }
        },
        "registries": {
          "acme": {
            "index": "https://registry.acme.example/index"
          }
        },
        "build": {
          "rustflags": []
        }
      },
      "match": false
    },
    {
      "file": ".cargo/config.toml",
      "document": {
        "source": {
          "crates-io": {
            "replace-with": "acme"
          }
        },
        "registries": {
          "acme": {
            "index": "https://registry.acme.example/index"
          }
        },
        "build": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A .cargo/config.toml that mentions a rustflag that changes code generation for the whole workspace in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0788"
  ],
  "origin": "original-authored",
  "cell": "sca:cargo-rustflags-lto-off",
  "validationStatus": "VALIDATED"
}
