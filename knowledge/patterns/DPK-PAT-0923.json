{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0923",
  "title": "Signal: Server-side fetch of assembled URL (apex) — review required",
  "targets": [
    "apex"
  ],
  "signal": {
    "kind": "regex",
    "source": "setEndpoint\\s*\\([^)]*\\+"
  },
  "scope": "Single-line lexical match on assembled fetch URLs in apex code.",
  "limitations": "Lexical, line-based: any assembled fetch URL matches, including trusted ones.",
  "examples": [
    {
      "line": "req.setEndpoint('https://api.corp.invalid/' + path);",
      "match": true
    },
    {
      "line": "# audit: req.setEndpoint('https://api.corp.invalid/' + path); present",
      "match": true
    },
    {
      "line": "req.setEndpoint(FIXED_ENDPOINT);",
      "match": false
    },
    {
      "line": "# verified: req.setEndpoint(FIXED_ENDPOINT);",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed API paths on a fixed host is the common false positive.",
  "linkedRules": [
    "DPK-SAST-767"
  ],
  "origin": "original-authored",
  "cell": "sast:ssrf-url:apex",
  "validationStatus": "VALIDATED"
}
