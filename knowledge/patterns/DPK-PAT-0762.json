{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0762",
  "title": "Signal: Cleartext protocol client (httpclient) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "http\\.client\\.HTTPConnection\\s*\\("
  },
  "scope": "Single-line lexical match on cleartext clients (httpclient).",
  "limitations": "Lexical, line-based: matches the client.",
  "examples": [
    {
      "line": "http.client.HTTPConnection(h)",
      "match": true
    },
    {
      "line": "# audit: http.client.HTTPConnection(h) present",
      "match": true
    },
    {
      "line": "http.client.HTTPSConnection(h)",
      "match": false
    },
    {
      "line": "# verified: http.client.HTTPSConnection(h)",
      "match": false
    }
  ],
  "fpNotes": "Loopback use is the common accepted case.",
  "linkedRules": [
    "DPK-SAST-645"
  ],
  "origin": "original-authored",
  "cell": "sast:python-net-plain:python:httpclient",
  "validationStatus": "VALIDATED"
}
