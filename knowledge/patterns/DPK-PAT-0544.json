{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0544",
  "title": "Signal: LDAP filter built by concatenation (php) — review required",
  "targets": [
    "php"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:ldap_search\\s*\\([^)]*(?:\"[^\"\\n]*\\$|\\.\\s*\\$))"
  },
  "scope": "Single-line lexical match on assembled LDAP filters in php code.",
  "limitations": "Lexical, line-based: any assembled filter matches, including trusted ones.",
  "examples": [
    {
      "line": "ldap_search($c, $b, \"(uid=$u)\")",
      "match": true
    },
    {
      "line": "# audit: ldap_search($c, $b, \"(uid=$u)\") present",
      "match": true
    },
    {
      "line": "ldap_search($c, $b, FIXED)",
      "match": false
    },
    {
      "line": "# verified: ldap_search($c, $b, FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed organizational units is the common false positive.",
  "linkedRules": [
    "DPK-SAST-447"
  ],
  "origin": "original-authored",
  "cell": "sast:ldap-inject:php",
  "validationStatus": "VALIDATED"
}
