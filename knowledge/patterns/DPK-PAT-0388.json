{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0388",
  "title": "Signal: TLS verification weakened (ssleay) — review required",
  "targets": [
    "perl"
  ],
  "signal": {
    "kind": "regex",
    "source": "SSL_verify_mode\\s*(?:=>|=)\\s*(?:0|SSL_VERIFY_NONE)"
  },
  "scope": "Single-line lexical match on TLS-weakening settings for ssleay.",
  "limitations": "Lexical, line-based: matches the setting regardless of environment.",
  "examples": [
    {
      "line": "SSL_verify_mode => 0",
      "match": true
    },
    {
      "line": "# audit: SSL_verify_mode => 0 present",
      "match": true
    },
    {
      "line": "SSL_verify_mode => SSL_VERIFY_PEER",
      "match": false
    },
    {
      "line": "# verified: SSL_verify_mode => SSL_VERIFY_PEER",
      "match": false
    }
  ],
  "fpNotes": "Test fixtures are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-349"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-verify-off-extra:perl:ssleay",
  "validationStatus": "VALIDATED"
}
