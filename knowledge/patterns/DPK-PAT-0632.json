{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0632",
  "title": "Signal: Risky Express setting (dotfiles) — review required",
  "targets": [
    "javascript"
  ],
  "signal": {
    "kind": "regex",
    "source": "dotfiles\\s*:\\s*[\"']allow[\"']"
  },
  "scope": "Single-line lexical match on Express config.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "dotfiles: \"allow\"",
      "match": true
    },
    {
      "line": "# audit: dotfiles: \"allow\" present",
      "match": true
    },
    {
      "line": "dotfiles: \"deny\"",
      "match": false
    },
    {
      "line": "# verified: dotfiles: \"deny\"",
      "match": false
    }
  ],
  "fpNotes": "Internal apps are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-515"
  ],
  "origin": "original-authored",
  "cell": "sast:express-risk:javascript:dotfiles",
  "validationStatus": "VALIDATED"
}
