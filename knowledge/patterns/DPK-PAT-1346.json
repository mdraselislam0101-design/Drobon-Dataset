{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1346",
  "title": "Signal: pgAdmin management interface disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "pgAdmin 4"
    }
  },
  "scope": "One response body containing the pgAdmin 4 interface marker.",
  "limitations": "One response body. The marker identifies the pgAdmin login page; it does not test credentials, and it does not prove that saved server definitions exist.",
  "examples": [
    {
      "observation": {
        "url": "https://db.example/pgadmin4/login",
        "status": 200,
        "headers": {},
        "body": "<html><head><title>pgAdmin 4</title></head><body><form id=\"login\"></form></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://db.example/",
        "status": 200,
        "headers": {},
        "body": "pgAdmin 4 v8.6"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://db.example/",
        "status": 200,
        "headers": {},
        "body": "<title>Internal tools</title>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://db.example/help",
        "status": 200,
        "headers": {},
        "body": "Use psql or any SQL client; the admin UI is on the bastion."
      },
      "match": false
    }
  ],
  "fpNotes": "A screenshot of pgAdmin in documentation is reported; confirm the endpoint is unreachable rather than assuming the copy is inert.",
  "linkedRules": [
    "DPK-DAST-277"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-pgadmin-login:pgadmin-login",
  "validationStatus": "VALIDATED"
}
