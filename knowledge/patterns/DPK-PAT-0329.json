{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0329",
  "title": "Signal: SQL built by concatenation (r) — review required",
  "targets": [
    "r"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:dbGetQuery\\s*\\([^)]*(?:\\+|paste0?\\s*\\())"
  },
  "scope": "Single-line lexical match on assembled SQL in r code.",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "dbGetQuery(c, paste0(\"SELECT \", q))",
      "match": true
    },
    {
      "line": "# audit: dbGetQuery(c, paste0(\"SELECT \", q)) present",
      "match": true
    },
    {
      "line": "dbGetQuery(c, FIXED)",
      "match": false
    },
    {
      "line": "# verified: dbGetQuery(c, FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-290"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-langs:r",
  "validationStatus": "VALIDATED"
}
