{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1468",
  "title": "Signal: TensorBoard is reachable without authentication",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "<title>[^<]{0,60}TensorBoard"
    }
  },
  "scope": "One response body containing the TensorBoard shell.",
  "limitations": "One response body. The rule reports the TensorBoard shell; it does not read a scalar or a text sample.",
  "examples": [
    {
      "observation": {
        "url": "https://ml.example:6006/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>TensorBoard</title></head><body><script>window.tensorboard = {};</script><div id=\"root\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://ml.example:6006/#runs",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>TensorBoard · runs</title></head><body><h3>Runs</h3><p>tensorboard reads /logs/exp-42</p></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Training guide</title></head><body><p>TensorBoard reads event files from the log directory.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/dashboard",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Dashboard</title></head><body><p>Model version 4 is live.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that mentions TensorBoard in prose is not reported, because the shell marker is required.",
  "linkedRules": [
    "DPK-DAST-399"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-console-tensorboard:tensorboard",
  "validationStatus": "VALIDATED"
}
