{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1313",
  "title": "Signal: Symfony profiler toolbar disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*sf\\-toolbar)(?=[\\s\\S]*Symfony)"
    }
  },
  "scope": "One response whose body injects the Symfony profiler toolbar.",
  "limitations": "One response body. The rule reports the toolbar; it does not request a profile token and cannot show what a stored profile contains.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"sfToolbarMainContent\"><span>Symfony</span></div><style>#sf-toolbar{}</style><script>var sf_toolbar = 1;</script></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><div class=\"sf-toolbar\" data-sf-role=\"toolbar\"><span>Symfony v6.3</span></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><div id=\"sfToolbarMainContent\"><span></span></div><style>#{}</style><script>var sf_toolbar = 1;</script></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A Symfony page without the toolbar is not reported; the toolbar element is required.",
  "linkedRules": [
    "DPK-DAST-244"
  ],
  "origin": "original-authored",
  "cell": "dast:body-symfony-profiler:symfony-profiler",
  "validationStatus": "VALIDATED"
}
