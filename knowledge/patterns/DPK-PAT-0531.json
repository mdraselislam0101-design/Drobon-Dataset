{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0531",
  "title": "Signal: Possible a Vault token in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "s\\.[A-Za-z0-9]{24,}"
  },
  "scope": "Single-line shape match for a Vault token.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "token = \"s.AAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: token = \"s.AAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "token = \"xy\"",
      "match": false
    },
    {
      "line": "token = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-065"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:vault-token",
  "validationStatus": "VALIDATED"
}
