{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0721",
  "title": "Signal: File access built from input (julia) — review required",
  "targets": [
    "julia"
  ],
  "signal": {
    "kind": "regex",
    "source": "open\\s*\\([^)]*\\*"
  },
  "scope": "Single-line lexical match on input-built paths in julia code.",
  "limitations": "Lexical, line-based: any input-built path matches.",
  "examples": [
    {
      "line": "open(dir * f)",
      "match": true
    },
    {
      "line": "# audit: open(dir * f) present",
      "match": true
    },
    {
      "line": "open(fixed)",
      "match": false
    },
    {
      "line": "# verified: open(fixed)",
      "match": false
    }
  ],
  "fpNotes": "Trusted directories are the common false positive.",
  "linkedRules": [
    "DPK-SAST-604"
  ],
  "origin": "original-authored",
  "cell": "sast:path-3:julia",
  "validationStatus": "VALIDATED"
}
