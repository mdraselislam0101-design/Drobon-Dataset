{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0231",
  "title": "Signal: Observability service left open (pwsecret) — review required",
  "targets": [
    "graylog"
  ],
  "signal": {
    "kind": "regex",
    "source": "password_secret\\s*=\\s*changeme"
  },
  "scope": "Single-line lexical match on open settings (pwsecret).",
  "limitations": "Lexical, line-based: matches the setting regardless of network scope.",
  "examples": [
    {
      "line": "password_secret = changeme",
      "match": true
    },
    {
      "line": "# audit: password_secret = changeme present",
      "match": true
    },
    {
      "line": "password_secret = ${SECRET}",
      "match": false
    },
    {
      "line": "# verified: password_secret = ${SECRET}",
      "match": false
    }
  ],
  "fpNotes": "Loopback-only instances are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-192"
  ],
  "origin": "original-authored",
  "cell": "sast:obs-services:graylog:pwsecret",
  "validationStatus": "VALIDATED"
}
