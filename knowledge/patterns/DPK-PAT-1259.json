{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1259",
  "title": "Signal: Secure cookie attribute delivered over plaintext HTTP",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Set-Cookie",
      "valuePattern": ";\\s*secure(?=[\\s;=]|$)",
      "requireScheme": "http"
    }
  },
  "scope": "One http response whose Set-Cookie header carries the Secure attribute.",
  "limitations": "One header value and the scheme of the observation URL. The rule judges a Secure attribute on an http response only; over https the same header is correct and is not reported.",
  "examples": [
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; Secure; HttpOnly; SameSite=Lax"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Secure; SameSite=Strict; HttpOnly"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; Secure; HttpOnly; SameSite=Lax"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "http://app.example/",
        "status": 200,
        "headers": {
          "Set-Cookie": "sid=abc; Path=/; HttpOnly; SameSite=Lax"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A plaintext redirect that sets no cookie is not reported; the rule needs the attribute in the same response.",
  "linkedRules": [
    "DPK-DAST-190"
  ],
  "origin": "original-authored",
  "cell": "dast:cookie-secure-over-http:secure-over-http",
  "validationStatus": "VALIDATED"
}
