{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2297",
  "title": "Signal: Maven dependency on a snapshot build",
  "targets": [
    "maven"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "project.dependencies[].version",
      "valuePattern": "-SNAPSHOT$"
    }
  },
  "scope": "A pom.xml file that declares a `-SNAPSHOT` dependency, which is rebuilt by its publisher at any time.",
  "limitations": "It matches a `-SNAPSHOT` dependency, which is rebuilt by its publisher at any time in the parsed pom.xml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "internal-core",
              "version": "1.5.0-SNAPSHOT"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "internal-util",
              "version": "2.0.0-SNAPSHOT"
            }
          ]
        }
      },
      "match": true
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "internal-core",
              "version": "1.5.0"
            }
          ]
        }
      },
      "match": false
    },
    {
      "file": "pom.xml",
      "document": {
        "project": {
          "modelVersion": "4.0.0",
          "groupId": "com.acme",
          "artifactId": "demo-service",
          "version": "1.4.0",
          "dependencies": [
            {
              "groupId": "com.acme",
              "artifactId": "internal-util",
              "version": "2.0.0"
            }
          ]
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A pom.xml that mentions a `-SNAPSHOT` dependency, which is rebuilt by its publisher at any time in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0160"
  ],
  "origin": "original-authored",
  "cell": "sca:maven-snapshot-dependency",
  "validationStatus": "VALIDATED"
}
