{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0181",
  "title": "Signal: Public storage canned ACL (cfnacl) — review required",
  "targets": [
    "yaml"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:PublicRead\\b)"
  },
  "scope": "Single-line lexical match on public ACLs (cfnacl).",
  "limitations": "Lexical, line-based: matches the ACL regardless of bucket purpose.",
  "examples": [
    {
      "line": "AccessControl: PublicRead",
      "match": true
    },
    {
      "line": "# audit: AccessControl: PublicRead present",
      "match": true
    },
    {
      "line": "AccessControl: Private",
      "match": false
    },
    {
      "line": "# verified: AccessControl: Private",
      "match": false
    }
  ],
  "fpNotes": "Public asset buckets are the common accepted case.",
  "linkedRules": [
    "DPK-SAST-142"
  ],
  "origin": "original-authored",
  "cell": "sast:iac-storage:yaml:cfnacl",
  "validationStatus": "VALIDATED"
}
