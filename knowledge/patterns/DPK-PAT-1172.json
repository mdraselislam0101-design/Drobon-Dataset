{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1172",
  "title": "Signal: Content-Security-Policy form-action allows plaintext HTTP submissions",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "^(?:(?!form-action(?=[\\s;]|$))[^;]*;\\s*)*form-action(?=[\\s;]|$)[^;]*?(?<=\\s)(?:http:|http://[^\\s;]+)(?=\\s|;|$)"
    }
  },
  "scope": "One Content-Security-Policy value whose first form-action declaration contains http: or an http:// host source.",
  "limitations": "One header value, first declaration of the directive only. The rule cannot see which forms exist or what they submit.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "form-action http:"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; form-action 'self' http://api.example"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "form-action 'self' https://api.example wss://api.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "form-action 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src http:"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "form-action https://api.example; form-action http:"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "A form that intentionally posts to a plaintext host on a private network can be reported; the observation has no network-context evidence.",
  "linkedRules": [
    "DPK-DAST-103"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-form-action-plaintext:form-action",
  "validationStatus": "VALIDATED"
}
