{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0158",
  "title": "Signal: Framework SQL built from input (asyncpg) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "fetch\\s*\\([^)]*(?:\\+|\\{)"
  },
  "scope": "Single-line lexical match on assembled SQL (asyncpg).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "fetch(\"SELECT \" + q)",
      "match": true
    },
    {
      "line": "# audit: fetch(\"SELECT \" + q) present",
      "match": true
    },
    {
      "line": "fetch(FIXED)",
      "match": false
    },
    {
      "line": "# verified: fetch(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-119"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli-extra:python:asyncpg",
  "validationStatus": "VALIDATED"
}
