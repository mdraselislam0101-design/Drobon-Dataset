{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2308",
  "title": "Signal: Gradle explicitly permits an insecure repository protocol",
  "targets": [
    "gradle"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "repositories[].allowInsecureProtocol",
      "valuePattern": "^true$"
    }
  },
  "scope": "A build.gradle file that declares a repository with `allowInsecureProtocol = true`.",
  "limitations": "It matches a repository with `allowInsecureProtocol = true` in the parsed build.gradle; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "acme",
            "url": "http://repo.acme.example/maven2",
            "allowInsecureProtocol": true
          }
        ],
        "dependencies": []
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mirror",
            "url": "http://10.24.8.9/maven2",
            "allowInsecureProtocol": true
          }
        ],
        "dependencies": []
      },
      "match": true
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "acme",
            "url": "https://repo.acme.example/maven2"
          }
        ],
        "dependencies": []
      },
      "match": false
    },
    {
      "file": "build.gradle",
      "document": {
        "repositories": [
          {
            "name": "mavenCentral",
            "url": "https://repo.maven.apache.org/maven2"
          }
        ],
        "dependencies": []
      },
      "match": false
    }
  ],
  "fpNotes": "A build.gradle that mentions a repository with `allowInsecureProtocol = true` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0171"
  ],
  "origin": "original-authored",
  "cell": "sca:gradle-insecure-protocol-allowed",
  "validationStatus": "VALIDATED"
}
