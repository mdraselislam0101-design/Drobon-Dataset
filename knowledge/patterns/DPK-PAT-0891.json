{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0891",
  "title": "Signal: Dangerous .NET construct (validatereq) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:ValidateRequest\\s*=\\s*[\"']?false)"
  },
  "scope": "Single-line lexical match on .NET constructs (validatereq).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "ValidateRequest=\"false\"",
      "match": true
    },
    {
      "line": "# audit: ValidateRequest=\"false\" present",
      "match": true
    },
    {
      "line": "ValidateRequest=\"true\"",
      "match": false
    },
    {
      "line": "# verified: ValidateRequest=\"true\"",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-740"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-flag:csharp:validatereq",
  "validationStatus": "VALIDATED"
}
