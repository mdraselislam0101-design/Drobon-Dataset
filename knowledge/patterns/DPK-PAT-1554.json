{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1554",
  "title": "Signal: Date of birth column served in a CSV response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?:date_of_birth|birth_date|\\bdob\\b)[\\s\\S]{0,120}?\\b[0-9]{2}[/-][0-9]{2}[/-][0-9]{4}\\b"
    }
  },
  "scope": "A response body containing a dob or date_of_birth header cell with a dated value.",
  "limitations": "One response body. The rule reads the header and the first dated row; it does not count rows.",
  "examples": [
    {
      "observation": {
        "url": "https://crm.example/export/customers.csv",
        "status": 200,
        "headers": {
          "Content-Type": "text/csv; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "id,name,dob,email\n1,Rahim,14/03/1988,rahim@example.com\n2,Karim,02/11/1979,karim@example.com"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://crm.example/export/members.csv",
        "status": 200,
        "headers": {
          "Content-Type": "text/csv; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "member_id;date_of_birth;city\n88;07-09-1992;Rajshahi"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://crm.example/help/export",
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY",
          "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
          "Referrer-Policy": "no-referrer",
          "Cross-Origin-Embedder-Policy": "require-corp",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
          "X-Permitted-Cross-Domain-Policies": "none",
          "X-DNS-Prefetch-Control": "off",
          "Origin-Agent-Cluster": "?1",
          "Cache-Control": "no-store",
          "NEL": "{\"report_to\":\"default\",\"max_age\":86400}",
          "Report-To": "{\"group\":\"default\",\"max_age\":86400,\"endpoints\":[{\"url\":\"https://reports.example/csp\"}]}",
          "Expect-CT": "max-age=86400, enforce"
        },
        "body": "<html><body><h1>Exports</h1><p>The customers export contains the date_of_birth column only for compliance officers.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that mentions a date-of-birth field in prose is not reported, because the header and the delimiter must match.",
  "linkedRules": [
    "DPK-DAST-485"
  ],
  "origin": "original-authored",
  "cell": "dast:pii-dob-csv:pii-dob-csv",
  "validationStatus": "VALIDATED"
}
