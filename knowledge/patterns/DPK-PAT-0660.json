{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0660",
  "title": "Signal: Unsafe decoding via u.unmarshal (java) — review required",
  "targets": [
    "java"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:unmarshal)\\s*\\("
  },
  "scope": "Single-line lexical match on the u.unmarshal call in java code.",
  "limitations": "Lexical, line-based: any u.unmarshal call matches.",
  "examples": [
    {
      "line": "u.unmarshal(payload)",
      "match": true
    },
    {
      "line": "out = u.unmarshal(data)",
      "match": true
    },
    {
      "line": "myuunmarshal(x)",
      "match": false
    },
    {
      "line": "u.unmarshal_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted local data is the common false positive.",
  "linkedRules": [
    "DPK-SAST-543"
  ],
  "origin": "original-authored",
  "cell": "sast:java-deser-more:java:jaxb",
  "validationStatus": "VALIDATED"
