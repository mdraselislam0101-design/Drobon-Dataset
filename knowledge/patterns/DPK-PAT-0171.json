{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0171",
  "title": "Signal: Framework SQL built from input (railsfindsql) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:find_by_sql\\s*\\([^)]*(?:\\+|#\\{))"
  },
  "scope": "Single-line lexical match on assembled framework SQL (railsfindsql).",
  "limitations": "Lexical, line-based: any assembled query matches, including trusted ones.",
  "examples": [
    {
      "line": "find_by_sql(\"SELECT #{q}\")",
      "match": true
    },
    {
      "line": "# audit: find_by_sql(\"SELECT #{q}\") present",
      "match": true
    },
    {
      "line": "find_by_sql(FIXED)",
      "match": false
    },
    {
      "line": "# verified: find_by_sql(FIXED)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-132"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli:ruby:railsfindsql",
  "validationStatus": "VALIDATED"
}
