{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0005",
  "title": "Signal: X-Content-Type-Options header missing",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "missing-response-header",
      "header": "x-content-type-options"
    }
  },
  "scope": "Legacy signal mirrored from DPK-DAST-005.",
  "limitations": "Presence-only: the header value is not inspected, so a present-but-wrong value still passes this check.",
  "examples": [
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "server": "example"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "X-Content-Type-Options": "nosniff"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "x-content-type-options": "nosniff"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Presence-only: the header value is not inspected, so a present-but-wrong value still passes this check.",
  "linkedRules": [
    "DPK-DAST-005"
  ],
  "origin": "original-authored",
  "cell": "legacy:DPK-DAST-005",
  "validationStatus": "VALIDATED"
}
