{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0374",
  "title": "Signal: TLS checks disabled (helm) — review required",
  "targets": [
    "shell"
  ],
  "signal": {
    "kind": "regex",
    "source": "--insecure-skip-tls-verify"
  },
  "scope": "Single-line lexical match on TLS-disabling flags for helm.",
  "limitations": "Lexical, line-based: matches the flag regardless of environment.",
  "examples": [
    {
      "line": "helm upgrade --insecure-skip-tls-verify",
      "match": true
    },
    {
      "line": "# audit: helm upgrade --insecure-skip-tls-verify present",
      "match": true
    },
    {
      "line": "helm upgrade",
      "match": false
    },
    {
      "line": "# verified: helm upgrade",
      "match": false
    }
  ],
  "fpNotes": "Local bootstrap scripts are the common false positive — confirm test scope.",
  "linkedRules": [
    "DPK-SAST-335"
  ],
  "origin": "original-authored",
  "cell": "sast:tls-cli:shell:helm",
  "validationStatus": "VALIDATED"
}
