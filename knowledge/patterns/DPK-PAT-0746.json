{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0746",
  "title": "Signal: Weak proxy or service setting (tls) — review required",
  "targets": [
    "caddy"
  ],
  "signal": {
    "kind": "regex",
    "source": "tls\\s+off"
  },
  "scope": "Single-line lexical match on service settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "tls off",
      "match": true
    },
    {
      "line": "# audit: tls off present",
      "match": true
    },
    {
      "line": "tls internal",
      "match": false
    },
    {
      "line": "# verified: tls internal",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-629"
  ],
  "origin": "original-authored",
  "cell": "sast:proxy-misc:caddy:tls",
  "validationStatus": "VALIDATED"
}
