{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0591",
  "title": "Signal: Shell expansion of a variable (varexpand) — review required",
  "targets": [
    "cmd"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:cmd\\s*/[cC]\\s+[^\\n]*%[A-Za-z_]+%)"
  },
  "scope": "Single-line lexical match on shell expansion (varexpand).",
  "limitations": "Lexical, line-based: matches the expansion.",
  "examples": [
    {
      "line": "cmd /c %CMD%",
      "match": true
    },
    {
      "line": "# audit: cmd /c %CMD% present",
      "match": true
    },
    {
      "line": "cmd /c dir",
      "match": false
    },
    {
      "line": "# verified: cmd /c dir",
      "match": false
    }
  ],
  "fpNotes": "Trusted variables are the common false positive.",
  "linkedRules": [
    "DPK-SAST-474"
  ],
  "origin": "original-authored",
  "cell": "sast:cmd-var-expand:cmd:varexpand",
  "validationStatus": "VALIDATED"
}
