{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2913",
  "title": "Signal: renv package restored from a non-repository source",
  "targets": [
    "cran"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "Packages.*.Source",
      "valuePattern": "^(?:GitHub|GitLab|Bitbucket|URL)$"
    }
  },
  "scope": "A renv.lock file that declares a package whose `Source` is a code host rather than a repository.",
  "limitations": "It matches a package whose `Source` is a code host rather than a repository in the parsed renv.lock; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1",
          "Repositories": [
            {
              "Name": "CRAN",
              "URL": "https://cloud.r-project.org"
            }
          ]
        },
        "Packages": {
          "dplyr": {
            "Package": "dplyr",
            "Version": "1.1.4",
            "Source": "GitHub"
          }
        }
      },
      "match": true
    },
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1",
          "Repositories": [
            {
              "Name": "CRAN",
              "URL": "https://cloud.r-project.org"
            }
          ]
        },
        "Packages": {
          "dplyr": {
            "Package": "dplyr",
            "Version": "1.1.4",
            "Source": "Repository"
          },
          "tidyr": {
            "Package": "tidyr",
            "Version": "1.3.1",
            "Source": "URL"
          }
        }
      },
      "match": true
    },
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1",
          "Repositories": [
            {
              "Name": "CRAN",
              "URL": "https://cloud.r-project.org"
            }
          ]
        },
        "Packages": {
          "dplyr": {
            "Package": "dplyr",
            "Version": "1.1.4",
            "Source": "Repository"
          }
        }
      },
      "match": false
    },
    {
      "file": "renv.lock",
      "document": {
        "R": {
          "Version": "4.4.1",
          "Repositories": [
            {
              "Name": "CRAN",
              "URL": "https://cloud.r-project.org"
            }
          ]
        },
        "Packages": {
          "dplyr": {
            "Package": "dplyr",
            "Version": "1.1.4",
            "Source": "Repository"
          },
          "tidyr": {
            "Package": "tidyr",
            "Version": "1.3.1",
            "Source": "Repository"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A renv.lock that mentions a package whose `Source` is a code host rather than a repository in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0776"
  ],
  "origin": "original-authored",
  "cell": "sca:renv-source-not-repository",
  "validationStatus": "VALIDATED"
}
