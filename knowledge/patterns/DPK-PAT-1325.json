{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1325",
  "title": "Signal: Obsolete Feature-Policy header present",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Feature-Policy",
      "valuePattern": "\\S"
    }
  },
  "scope": "One response that carries a Feature-Policy header.",
  "limitations": "One header value. The rule reports the obsolete header; it does not compare it with any Permissions-Policy that is also present and cannot say which features end up allowed.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Feature-Policy": "camera 'none'; microphone 'none'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Feature-Policy": "geolocation=()"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Permissions-Policy": "camera=()"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A deployment that keeps Feature-Policy for an old client is still reported; current browsers ignore the header.",
  "linkedRules": [
    "DPK-DAST-256"
  ],
  "origin": "original-authored",
  "cell": "dast:feature-policy-obsolete:policy-obsolete",
  "validationStatus": "VALIDATED"
}
