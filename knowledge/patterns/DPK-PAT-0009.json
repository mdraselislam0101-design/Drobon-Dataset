{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0009",
  "title": "Signal: Referrer-Policy header missing",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "missing-response-header",
      "header": "referrer-policy"
    }
  },
  "scope": "Legacy signal mirrored from DPK-DAST-009.",
  "limitations": "Header presence only: the value is not validated, so a present-but-lax policy still passes this check.",
  "examples": [
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "server": "example"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "Referrer-Policy": "strict-origin-when-cross-origin"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Header presence only: the value is not validated, so a present-but-lax policy still passes this check.",
  "linkedRules": [
    "DPK-DAST-009"
  ],
  "origin": "original-authored",
  "cell": "legacy:DPK-DAST-009",
  "validationStatus": "VALIDATED"
}
