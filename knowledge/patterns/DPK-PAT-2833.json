{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2833",
  "title": "Signal: Dependency pulls its full default feature surface",
  "targets": [
    "cargo"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "dependencies.*.default-features",
      "valuePattern": "^true$"
    }
  },
  "scope": "A Cargo.toml file that declares a dependency that keeps all default features on.",
  "limitations": "It matches a dependency that keeps all default features on in the parsed Cargo.toml; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          },
          "reqwest": {
            "version": "0.12.8",
            "default-features": true
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210",
            "default-features": "true"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": true
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210"
          },
          "reqwest": {
            "version": "0.12.8",
            "default-features": false
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": false
    },
    {
      "file": "Cargo.toml",
      "document": {
        "package": {
          "name": "demo-service",
          "version": "0.1.0",
          "license": "MIT"
        },
        "dependencies": {
          "serde": {
            "version": "1.0.210",
            "default-features": "false"
          }
        },
        "patch": {},
        "workspace": {
          "dependencies": {
            "serde": "1.0.210"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A Cargo.toml that mentions a dependency that keeps all default features on in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0696"
  ],
  "origin": "original-authored",
  "cell": "sca:cargo-feature-unused-default",
  "validationStatus": "VALIDATED"
}
