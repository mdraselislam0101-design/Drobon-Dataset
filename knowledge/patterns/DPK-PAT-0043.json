{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0043",
  "title": "Signal: Missing Cross-Origin-Opener-Policy response header",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "missing-response-header",
      "header": "Cross-Origin-Opener-Policy"
    }
  },
  "scope": "Single response: confirm the header is absent.",
  "limitations": "Header-name check on one response. It cannot show whether an opener relationship actually exists, and it does not see the popups a page opens.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Server": "web"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 500,
        "headers": {
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Non-browser endpoints are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-013"
  ],
  "origin": "original-authored",
  "cell": "dast:header-missing:coop",
  "validationStatus": "VALIDATED"
}
