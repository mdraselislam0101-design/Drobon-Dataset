{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1473",
  "title": "Signal: Flask Debug Toolbar disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*flDebug)(?=[\\s\\S]*flt-)"
    }
  },
  "scope": "One response body containing the Flask Debug Toolbar container and a panel marker.",
  "limitations": "One response body. The rule reports the toolbar container; it does not open a panel.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/invoices",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Invoices</h1><div id=\"flDebug\" class=\"debug-toolbar\"><span id=\"flt-sql\"></span><span id=\"flt-config\"></span></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/search",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<div id=\"flDebug\"><div id=\"flt-sql-panel\"><pre>SELECT id FROM items LIMIT 20</pre></div></div>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/invoices",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Invoices</h1><p>No open invoices.</p></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://docs.example/guide",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Flask guide</title></head><body><p>The toolbar is enabled only when DEBUG is true.</p></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "A page that names the toolbar in prose is not reported, because the container and panel markers are both required.",
  "linkedRules": [
    "DPK-DAST-404"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-debug-flask-toolbar:flask-debugtoolbar",
  "validationStatus": "VALIDATED"
}
