{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0817",
  "title": "Signal: Weak SSH daemon setting (usepam) — review required",
  "targets": [
    "sshd"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:UsePAM\\s+no)"
  },
  "scope": "Single-line lexical match on sshd settings.",
  "limitations": "Lexical, line-based: matches the setting regardless of Match blocks.",
  "examples": [
    {
      "line": "UsePAM no",
      "match": true
    },
    {
      "line": "# audit: UsePAM no present",
      "match": true
    },
    {
      "line": "UsePAM yes",
      "match": false
    },
    {
      "line": "# verified: UsePAM yes",
      "match": false
    }
  ],
  "fpNotes": "Bastion-specific needs are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-700"
  ],
  "origin": "original-authored",
  "cell": "sast:sshd-strict:sshd:usepam",
  "validationStatus": "VALIDATED"
}
