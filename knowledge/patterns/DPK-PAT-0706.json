{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0706",
  "title": "Signal: Sensitive value in log call (haskell) — review required",
  "targets": [
    "haskell"
  ],
  "signal": {
    "kind": "regex",
    "source": "putStrLn\\s+[^\\n]*(?:password|passwd|secret|token)"
  },
  "scope": "Single-line lexical match on credential-named log values in haskell code.",
  "limitations": "Lexical, line-based: matches credential-adjacent names.",
  "examples": [
    {
      "line": "putStrLn (\"password: \" ++ p)",
      "match": true
    },
    {
      "line": "# audit: putStrLn (\"password: \" ++ p) present",
      "match": true
    },
    {
      "line": "putStrLn (\"user: \" ++ u)",
      "match": false
    },
    {
      "line": "# verified: putStrLn (\"user: \" ++ u)",
      "match": false
    }
  ],
  "fpNotes": "Presence flags are the common false positive.",
  "linkedRules": [
    "DPK-SAST-589"
  ],
  "origin": "original-authored",
  "cell": "sast:log-4:haskell",
  "validationStatus": "VALIDATED"
}
