{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0626",
  "title": "Signal: Open DNS resolver (access) — review required",
  "targets": [
    "unbound"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:access-control\\s*:\\s*0\\.0\\.0\\.0/0\\s+allow)"
  },
  "scope": "Single-line lexical match on DNS settings.",
  "limitations": "Lexical, line-based: matches the setting.",
  "examples": [
    {
      "line": "access-control: 0.0.0.0/0 allow",
      "match": true
    },
    {
      "line": "# audit: access-control: 0.0.0.0/0 allow present",
      "match": true
    },
    {
      "line": "access-control: 10.0.0.0/8 allow",
      "match": false
    },
    {
      "line": "# verified: access-control: 10.0.0.0/8 allow",
      "match": false
    }
  ],
  "fpNotes": "Public resolvers are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-509"
  ],
  "origin": "original-authored",
  "cell": "sast:dns-open:unbound:access",
  "validationStatus": "VALIDATED"
}
