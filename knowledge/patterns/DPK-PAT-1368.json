{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1368",
  "title": "Signal: Windows ini file content served in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "for 16-bit app support"
    }
  },
  "scope": "One response body containing the win.ini section marker.",
  "limitations": "One response body. The check proves one file was read; it does not enumerate what else the same parameter can reach.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/get?p=..%5c..%5cwindows%5cwin.ini",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "; for 16-bit app support\n[fonts]\n[extensions]\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/files/../../win.ini",
        "status": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "[windows]\nfor 16-bit app support\n"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/get?p=..%5c..%5cwindows%5cwin.ini",
        "status": 404,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body>Not found</body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/blog/legacy",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>We still provide support for 16-bit applications on legacy hardware.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A documentation page quoting win.ini is reported; a page that mentions the filename is not. The pattern requires the marker line itself.",
  "linkedRules": [
    "DPK-DAST-299"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-windows-ini-served:win-ini-marker",
  "validationStatus": "VALIDATED"
}
