{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2839",
  "title": "Signal: Dependency resolved from a local directory",
  "targets": [
    "composer"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "repositories[].type",
      "valuePattern": "^path$"
    }
  },
  "scope": "A composer.json file that declares a repository of type `path`.",
  "limitations": "It matches a repository of type `path` in the parsed composer.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "path",
            "url": "../acme-core"
          }
        ]
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "path",
            "url": "/opt/vendor/acme-core"
          }
        ]
      },
      "match": true
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": [
          {
            "type": "composer",
            "url": "https://packagist.acme.example"
          }
        ]
      },
      "match": false
    },
    {
      "file": "composer.json",
      "document": {
        "require": {
          "monolog/monolog": "^3.7"
        },
        "license": [
          "MIT"
        ],
        "config": {
          "secure-http": true,
          "platform": {
            "php": "8.3.0"
          }
        },
        "prefer-stable": true,
        "scripts": {},
        "repositories": []
      },
      "match": false
    }
  ],
  "fpNotes": "A composer.json that mentions a repository of type `path` in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0702"
  ],
  "origin": "original-authored",
  "cell": "sca:composer-path-repository",
  "validationStatus": "VALIDATED"
}
