{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0610",
  "title": "Signal: Dangerous .NET construct (trace) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:trace\\s+enabled\\s*=\\s*[\"']?true)"
  },
  "scope": "Single-line lexical match on .NET constructs (trace).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "<trace enabled=\"true\"",
      "match": true
    },
    {
      "line": "# audit: <trace enabled=\"true\" present",
      "match": true
    },
    {
      "line": "<trace enabled=\"false\"",
      "match": false
    },
    {
      "line": "# verified: <trace enabled=\"false\"",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-493"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-flag:csharp:trace",
  "validationStatus": "VALIDATED"
}
