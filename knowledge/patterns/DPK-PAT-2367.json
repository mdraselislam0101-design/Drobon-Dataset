{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2367",
  "title": "Signal: Podfile installs a pod from git",
  "targets": [
    "cocoapods"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "pods[].git",
      "valuePattern": "^https?://"
    }
  },
  "scope": "A Podfile file that declares a pod sourced from a git remote.",
  "limitations": "It matches a pod sourced from a git remote in the parsed Podfile; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "AcmeSDK",
            "git": "https://github.com/acme/sdk.git",
            "tag": "4.2.0"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "AcmeCLI",
            "git": "https://github.com/acme/cli.git",
            "branch": "main"
          }
        ]
      },
      "match": true
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "Alamofire",
            "requirement": "~> 5.9.1"
          }
        ]
      },
      "match": false
    },
    {
      "file": "Podfile",
      "document": {
        "sources": [
          "https://cdn.cocoapods.org/"
        ],
        "pods": [
          {
            "name": "SnapKit",
            "requirement": "5.7.1"
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Podfile that mentions a pod sourced from a git remote in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0230"
  ],
  "origin": "original-authored",
  "cell": "sca:podfile-git-pod",
  "validationStatus": "VALIDATED"
}
