{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1159",
  "title": "Signal: Rust panic message with source location disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "thread '[^']{1,64}' panicked at"
    }
  },
  "scope": "One response body: confirm the Rust panic banner.",
  "limitations": "Observation-level: matches the standard panic banner. A custom panic hook that prints its own message is out of scope.",
  "examples": [
    {
      "observation": {
        "url": "https://api.example/orders/42",
        "status": 500,
        "headers": {
          "Content-Type": "text/plain; charset=utf-8"
        },
        "body": "thread 'main' panicked at src/handlers/orders.rs:42:9:\ncalled `Result::unwrap()` on an `Err` value"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/v1/pay",
        "status": 500,
        "headers": {},
        "body": "thread 'actix-rt|system:0|arbiter:1' panicked at src/payments.rs:118:5:"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/orders/42",
        "status": 500,
        "headers": {},
        "body": "Internal error. Reference 12ab34."
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://api.example/health",
        "status": 200,
        "headers": {},
        "body": "{\"status\":\"ok\"}"
      },
      "match": false
    }
  ],
  "fpNotes": "A deliberately published crash report is reported by design.",
  "linkedRules": [
    "DPK-DAST-090"
  ],
  "origin": "original-authored",
  "cell": "dast:rust-panic:panic",
  "validationStatus": "VALIDATED"
}
