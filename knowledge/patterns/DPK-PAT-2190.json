{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2190",
  "title": "Signal: Lockfile records a dependency that runs an install script",
  "targets": [
    "npm"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "packages.*.hasInstallScript",
      "valuePattern": "^true$"
    }
  },
  "scope": "A package-lock.json file that declares a package entry flagged as running an install script.",
  "limitations": "It matches a package entry flagged as running an install script in the parsed package-lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "hasInstallScript": true
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "hasInstallScript": true,
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": true
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "1.0.0",
            "hasInstallScript": false
          }
        }
      },
      "match": false
    },
    {
      "file": "package-lock.json",
      "document": {
        "name": "demo-service",
        "lockfileVersion": 3,
        "packages": {
          "node_modules/dependency-0": {
            "version": "2.0.0",
            "integrity": "sha512-AAAA"
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A package with a build script that only prints a notice is still reported; the install hook is the finding.",
  "linkedRules": [
    "DPK-SCA-0053"
  ],
  "origin": "original-authored",
  "cell": "sca:npm-lock-install-script",
  "validationStatus": "VALIDATED"
}
