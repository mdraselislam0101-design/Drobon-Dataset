{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0757",
  "title": "Signal: Dynamic execution via __import__ (python) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:__import__)\\s*\\("
  },
  "scope": "Single-line lexical match on the __import__ call in python code.",
  "limitations": "Lexical, line-based: any __import__ call matches.",
  "examples": [
    {
      "line": "__import__(payload)",
      "match": true
    },
    {
      "line": "out = __import__(data)",
      "match": true
    },
    {
      "line": "my__import__(x)",
      "match": false
    },
    {
      "line": "__import___safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted tooling is the common false positive.",
  "linkedRules": [
    "DPK-SAST-640"
  ],
  "origin": "original-authored",
  "cell": "sast:python-dyn-more:python:import",
  "validationStatus": "VALIDATED"
}
