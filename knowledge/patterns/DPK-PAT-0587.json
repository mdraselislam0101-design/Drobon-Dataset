{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0587",
  "title": "Signal: OS command execution via fpSystem (pascal) — review required",
  "targets": [
    "pascal"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:fpSystem)\\s*\\("
  },
  "scope": "Single-line lexical match on the fpSystem call in pascal code.",
  "limitations": "Lexical, line-based: any fpSystem call matches.",
  "examples": [
    {
      "line": "fpSystem(payload)",
      "match": true
    },
    {
      "line": "out = fpSystem(data)",
      "match": true
    },
    {
      "line": "myfpSystem(x)",
      "match": false
    },
    {
      "line": "fpSystem_safe()",
      "match": false
    }
  ],
  "fpNotes": "Fixed maintenance commands are the common false positive.",
  "linkedRules": [
    "DPK-SAST-470"
  ],
  "origin": "original-authored",
  "cell": "sast:cmd-exec-3:pascal",
  "validationStatus": "VALIDATED"
}
