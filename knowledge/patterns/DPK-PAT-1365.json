{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1365",
  "title": "Signal: Rails detailed exception page disclosed in a response",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?:ActionView::Template::Error|ActionController::RoutingError|Extracted source \\(around line)"
    }
  },
  "scope": "One response body containing a Rails detailed-exception marker.",
  "limitations": "One response body. The check recognises the page markers; it does not enumerate which parameters the page printed.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/orders/12",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<h1>ActionView::Template::Error</h1><p>undefined method `total&#39; for nil</p>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/orders/12",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<h2>Extracted source (around line #14):</h2><pre>@order.total</pre>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/orders/12",
        "status": 500,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><body><h1>Internal Server Error</h1></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/docs/errors",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<p>Configure a custom error page for production deployments.</p>"
      },
      "match": false
    }
  ],
  "fpNotes": "A Rails documentation page that quotes the marker is reported; a plain 500 page rendered by the app is not.",
  "linkedRules": [
    "DPK-DAST-296"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-body-rails-detailed-exception:rails-exception-page",
  "validationStatus": "VALIDATED"
}
