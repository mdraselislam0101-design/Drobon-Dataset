{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1264",
  "title": "Signal: Access-Control-Allow-Origin names more than one origin",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Access-Control-Allow-Origin",
      "valuePattern": "^\\s*https?://[^\\s/]+(?:\\s+|,\\s*)https?://"
    }
  },
  "scope": "One response whose Access-Control-Allow-Origin value contains two origin tokens.",
  "limitations": "One header value. The rule reads the declared value and cannot see the request Origin, so it cannot tell which of the listed origins was intended for this response.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://a.example https://b.example"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://a.example, https://b.example"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://a.example"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Access-Control-Allow-Origin": "https://a.example/"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A header that lists one origin is not reported; the rule needs the second token in the same value.",
  "linkedRules": [
    "DPK-DAST-195"
  ],
  "origin": "original-authored",
  "cell": "dast:cors-origin-multiple-values:origin-multiple-values",
  "validationStatus": "VALIDATED"
}
