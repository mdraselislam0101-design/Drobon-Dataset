{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0140",
  "title": "Signal: Dynamic evaluation via Eval (vba) — review required",
  "targets": [
    "vba"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:Eval)\\s*\\("
  },
  "scope": "Single-line lexical match on the Eval call in vba code.",
  "limitations": "Lexical, line-based: any Eval call matches.",
  "examples": [
    {
      "line": "Eval(payload)",
      "match": true
    },
    {
      "line": "out = Eval(data)",
      "match": true
    },
    {
      "line": "myEval(x)",
      "match": false
    },
    {
      "line": "Eval_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted tooling is the common false positive.",
  "linkedRules": [
    "DPK-SAST-101"
  ],
  "origin": "original-authored",
  "cell": "sast:eval-call-extra:vba",
  "validationStatus": "VALIDATED"
}
