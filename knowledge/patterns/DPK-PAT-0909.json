{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0909",
  "title": "Signal: Redirect to another host (Location header)",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-host-differs",
      "header": "Location"
    }
  },
  "scope": "Single redirect response: confirm the target host differs from the request host.",
  "limitations": "Single-response check: it cannot tell whether the target is attacker-controlled. Passive scope only; no redirect is followed.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 302,
        "headers": {
          "Location": "https://other.example/home"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 302,
        "headers": {
          "Location": "/home"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 200,
        "headers": {
          "Location": "https://other.example/"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/login",
        "status": 302,
        "headers": {
          "Location": "https://app.example/x"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "Intentional redirects to a partner or identity provider are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-056"
  ],
  "origin": "original-authored",
  "cell": "dast:redirect-host-change:cross-host",
  "validationStatus": "VALIDATED"
}
