{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1146",
  "title": "Signal: Windows shell object created in vba — review required",
  "targets": [
    "vba"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:CreateObject\\s*\\(\\s*[\"']WScript\\.Shell[\"'])"
  },
  "scope": "Single-line match on WScript.Shell creation in vba.",
  "limitations": "Lexical: matches the object creation; later Run calls are not linked.",
  "examples": [
    {
      "line": "Set sh = CreateObject(\"WScript.Shell\")",
      "match": true
    },
    {
      "line": "# audit: Set sh = CreateObject(\"WScript.Shell\") present",
      "match": true
    },
    {
      "line": "Set fso = CreateObject(\"Scripting.FileSystemObject\")",
      "match": false
    },
    {
      "line": "# verified: Set fso = CreateObject(\"Scripting.FileSystemObject\")",
      "match": false
    }
  ],
  "fpNotes": "A signed administrative macro that only launches a fixed internal tool is the reviewed exception.",
  "linkedRules": [
    "DPK-SAST-961"
  ],
  "origin": "original-authored",
  "cell": "sast:vba-createobject-wscript:vba",
  "validationStatus": "VALIDATED"
}
