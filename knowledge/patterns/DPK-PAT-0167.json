{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0167",
  "title": "Signal: Framework SQL built from input (djangoextra) — review required",
  "targets": [
    "python"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\.extra\\s*\\("
  },
  "scope": "Single-line lexical match on assembled framework SQL (djangoextra).",
  "limitations": "Lexical, line-based: any assembled query matches, including trusted ones.",
  "examples": [
    {
      "line": "qs.extra(where=[\"x=%s\" % v])",
      "match": true
    },
    {
      "line": "# audit: qs.extra(where=[\"x=%s\" % v]) present",
      "match": true
    },
    {
      "line": "qs.filter(x=v)",
      "match": false
    },
    {
      "line": "# verified: qs.filter(x=v)",
      "match": false
    }
  ],
  "fpNotes": "Assembling fixed fragments is the common false positive.",
  "linkedRules": [
    "DPK-SAST-128"
  ],
  "origin": "original-authored",
  "cell": "sast:framework-sqli:python:djangoextra",
  "validationStatus": "VALIDATED"
}
