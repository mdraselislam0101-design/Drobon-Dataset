{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0806",
  "title": "Signal: SQL built by concatenation (nim) — review required",
  "targets": [
    "nim"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:exec\\s*\\([^)]*&)"
  },
  "scope": "Single-line lexical match on assembled SQL in nim code.",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "db.exec(sql\"SELECT \" & q)",
      "match": true
    },
    {
      "line": "# audit: db.exec(sql\"SELECT \" & q) present",
      "match": true
    },
    {
      "line": "db.exec(sqlFIXED)",
      "match": false
    },
    {
      "line": "# verified: db.exec(sqlFIXED)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-689"
  ],
  "origin": "original-authored",
  "cell": "sast:sql-4:nim",
  "validationStatus": "VALIDATED"
}
