{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0010",
  "title": "Signal: Content-Security-Policy without frame-ancestors",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-missing-directive",
      "header": "content-security-policy",
      "directive": "frame-ancestors"
    }
  },
  "scope": "Legacy signal mirrored from DPK-DAST-010.",
  "limitations": "Directive-presence only: a present-but-permissive frame-ancestors value still passes this check. Policy strength is out of scope. A response with no Content-Security-Policy header also matches; DPK-DAST-002 reports that absence as the stronger finding.",
  "examples": [
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {}
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "content-security-policy": "default-src 'self'; frame-ancestors 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; report-uri https://c.example/r"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://example.com/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "frame-ancestors 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": [
            "default-src 'self'",
            "script-src 'self'; frame-ancestors 'none'"
          ]
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": [
            "",
            ""
          ]
        }
      },
      "match": true
    }
  ],
  "fpNotes": "Directive-presence only: a present-but-permissive frame-ancestors value still passes this check. Policy strength is out of scope. A response with no Content-Security-Policy header also matches; DPK-DAST-002 reports that absence as the stronger finding.",
  "linkedRules": [
    "DPK-DAST-010"
  ],
  "origin": "original-authored",
  "cell": "legacy:DPK-DAST-010",
  "validationStatus": "VALIDATED"
}
