  "signal": {
    "kind": "regex",
    "source": "\\b(?:read-string)\\s*\\("
  },
  "scope": "Single-line lexical match on the read-string call in clojure code.",
  "limitations": "Lexical, line-based: any read-string call matches.",
  "examples": [
    {
      "line": "read-string(payload)",
      "match": true
    },
    {
      "line": "out = read-string(data)",
      "match": true
    },
    {
      "line": "myreadstring(x)",
      "match": false
    },
    {
      "line": "read-string_safe()",
      "match": false
    }
  ],
  "fpNotes": "Trusted local data is the common false positive.",
