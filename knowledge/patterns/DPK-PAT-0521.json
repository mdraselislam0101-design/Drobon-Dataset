{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0521",
  "title": "Signal: Possible a Stripe live key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "sk_live_[A-Za-z0-9]{24,}"
  },
  "scope": "Single-line shape match for a Stripe live key.",
  "limitations": "Shape-only: matches the documented prefix and length family, which cannot prove a live credential.",
  "examples": [
    {
      "line": "key = \"sk_live_AAAAAAAAAAAAAAAAAAAAAAAA\"",
      "match": true
    },
    {
      "line": "# audit: key = \"sk_live_AAAAAAAAAAAAAAAAAAAAAAAA\" present",
      "match": true
    },
    {
      "line": "key = \"xy\"",
      "match": false
    },
    {
      "line": "key = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    }
  ],
  "fpNotes": "Documentation and redacted examples using the same prefix are the common false positives.",
  "linkedRules": [
    "DPK-SEC-055"
  ],
  "origin": "original-authored",
  "cell": "secrets:token-shapes:stripe-live",
  "validationStatus": "VALIDATED"
}
