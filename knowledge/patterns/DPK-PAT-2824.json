{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-2824",
  "title": "Signal: Lock file uses the first format, which records less restore detail",
  "targets": [
    "nuget"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-matches",
      "path": "version",
      "valuePattern": "^1$"
    }
  },
  "scope": "A packages.lock.json file that declares a `packages.lock.json` on the older lock-file format.",
  "limitations": "It matches a `packages.lock.json` on the older lock-file format in the parsed packages.lock.json; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "packages.lock.json",
      "document": {
        "version": 1,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": "1",
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            }
          }
        }
      },
      "match": true
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 2,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            }
          }
        }
      },
      "match": false
    },
    {
      "file": "packages.lock.json",
      "document": {
        "version": 2,
        "dependencies": {
          "net8.0": {
            "Newtonsoft.Json": {
              "type": "Direct",
              "resolved": "13.0.3"
            }
          }
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A packages.lock.json that mentions a `packages.lock.json` on the older lock-file format in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0687"
  ],
  "origin": "original-authored",
  "cell": "sca:nuget-lock-file-format-old",
  "validationStatus": "VALIDATED"
}
