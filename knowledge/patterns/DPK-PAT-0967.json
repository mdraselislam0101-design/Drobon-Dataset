{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0967",
  "title": "Signal: Possible Azure storage account key in source",
  "targets": [
    "universal"
  ],
  "signal": {
    "kind": "regex",
    "source": "AccountKey=[A-Za-z0-9+/]{86,}=="
  },
  "scope": "Single-line shape match for Azure storage account key.",
  "limitations": "Shape-only: matches the documented syntax of this configuration form. It cannot prove the value is a live credential.",
  "examples": [
    {
      "line": "conn = \"AccountKey=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\"",
      "match": true
    },
    {
      "line": "# audit: conn = \"AccountKey=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\" present",
      "match": true
    },
    {
      "line": "conn = \"xy\"",
      "match": false
    },
    {
      "line": "conn = \"EXAMPLE-NOT-A-REAL-VALUE\"",
      "match": false
    },
    {
      "line": "conn = \"AccountKey=<account-key>\"",
      "match": false
    },
    {
      "line": "conn = \"AccountKey=xyz==\"",
      "match": false
    }
  ],
  "fpNotes": "Placeholders and documentation that reuse the same syntax are the common false positives.",
  "linkedRules": [
    "DPK-SEC-101"
  ],
  "origin": "original-authored",
  "cell": "secrets:protocol-config:azure-account-key",
  "validationStatus": "VALIDATED"
}
