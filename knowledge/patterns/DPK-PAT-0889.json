{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0889",
  "title": "Signal: Dangerous .NET construct (machinedec) — review required",
  "targets": [
    "csharp"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:decryptionKey\\s*=\\s*\"[0-9A-Fa-f]{16,})"
  },
  "scope": "Single-line lexical match on .NET constructs (machinedec).",
  "limitations": "Lexical, line-based: matches the construct.",
  "examples": [
    {
      "line": "decryptionKey=\"AB12CD34EF560189\"",
      "match": true
    },
    {
      "line": "# audit: decryptionKey=\"AB12CD34EF560189\" present",
      "match": true
    },
    {
      "line": "decryptionKey=\"AutoGenerate,IsolateApps\"",
      "match": false
    },
    {
      "line": "# verified: decryptionKey=\"AutoGenerate,IsolateApps\"",
      "match": false
    }
  ],
  "fpNotes": "Trusted local use is the common false positive.",
  "linkedRules": [
    "DPK-SAST-738"
  ],
  "origin": "original-authored",
  "cell": "sast:csharp-flag:csharp:machinedec",
  "validationStatus": "VALIDATED"
}
