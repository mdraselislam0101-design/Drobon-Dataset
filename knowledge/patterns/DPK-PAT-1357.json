{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1357",
  "title": "Signal: X-B3-TraceId exposes internal tracing identifiers",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "X-B3-TraceId",
      "valuePattern": "^\\s*[0-9a-f]{16}(?:[0-9a-f]{16})?\\s*$"
    }
  },
  "scope": "One X-B3-TraceId response header carrying a 16- or 32-character lowercase hex value.",
  "limitations": "One header value. The check validates the hex shape of a B3 trace id; it does not prove that logs or dashboards are reachable, and a trace id alone is not an exploit.",
  "examples": [
    {
      "observation": {
        "url": "https://api.example/v1/items",
        "status": 200,
        "headers": {
          "X-B3-TraceId": "a3ce929d0e0e4736"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/v1/items",
        "status": 200,
        "headers": {
          "x-b3-traceid": "a3ce929d0e0e4736ffa1b2c3d4e5f607"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://api.example/",
        "status": 200,
        "headers": {
          "X-B3-TraceId": "a3ce929d"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://api.example/",
        "status": 200,
        "headers": {
          "X-Request-Id": "req-1234"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A service that intentionally exposes its trace id for support correlation is reported; the correlation benefit is real and the risk must be accepted in writing.",
  "linkedRules": [
    "DPK-DAST-288"
  ],
  "origin": "original-authored",
  "cell": "dast:dast-x-b3-traceid-header:x-b3-traceid-present",
  "validationStatus": "VALIDATED"
}
