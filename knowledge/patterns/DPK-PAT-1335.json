{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1335",
  "title": "Signal: Content-Security-Policy declares a directive more than once",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "(?:^|;)\\s*(script-src|default-src|object-src|frame-ancestors|base-uri|form-action|connect-src|img-src|style-src|worker-src|frame-src|font-src|media-src|manifest-src)\\s(?=[\\s\\S]*;\\s*\\1\\s[^;]*)"
    }
  },
  "scope": "One policy value in which a directive name appears more than once.",
  "limitations": "One header value. The rule reports a repeated directive name; it does not compute which of the two lists the browser applies, because that depends on the user agent and on the surrounding policy text.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; img-src 'self'; script-src 'none'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; default-src https:"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'; img-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'self'; style-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; report-uri /csp?d=script-src; script-src 'self'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; script-src 'self'; connect-src 'self'"
        }
      },
      "match": false
    }
  ],
  "fpNotes": "A policy that repeats a directive with identical lists is still reported; the finding is the duplicate, not the content.",
  "linkedRules": [
    "DPK-DAST-266"
  ],
  "origin": "original-authored",
  "cell": "dast:csp-duplicate-directive:duplicate-directive",
  "validationStatus": "VALIDATED"
}
