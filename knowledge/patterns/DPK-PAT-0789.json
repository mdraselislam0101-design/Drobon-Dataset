{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0789",
  "title": "Signal: ActiveRecord SQL from input (order) — review required",
  "targets": [
    "ruby"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:order\\s*\\(\\s*params)"
  },
  "scope": "Single-line lexical match on assembled SQL (order).",
  "limitations": "Lexical, line-based: any assembled query matches.",
  "examples": [
    {
      "line": "order(params[:sort])",
      "match": true
    },
    {
      "line": "# audit: order(params[:sort]) present",
      "match": true
    },
    {
      "line": "order(:name)",
      "match": false
    },
    {
      "line": "# verified: order(:name)",
      "match": false
    }
  ],
  "fpNotes": "Fixed fragments are the common false positive.",
  "linkedRules": [
    "DPK-SAST-672"
  ],
  "origin": "original-authored",
  "cell": "sast:ruby-flag:ruby:order",
  "validationStatus": "VALIDATED"
}
