{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0368",
  "title": "Signal: Risky Terraform setting (iamact) — review required",
  "targets": [
    "hcl"
  ],
  "signal": {
    "kind": "regex",
    "source": "\"Action\"\\s*:\\s*\"\\*\""
  },
  "scope": "Single-line lexical match on risky Terraform settings (iamact).",
  "limitations": "Lexical, line-based: matches the setting regardless of account scope.",
  "examples": [
    {
      "line": "\"Action\": \"*\"",
      "match": true
    },
    {
      "line": "# audit: \"Action\": \"*\" present",
      "match": true
    },
    {
      "line": "\"Action\": \"s3:GetObject\"",
      "match": false
    },
    {
      "line": "# verified: \"Action\": \"s3:GetObject\"",
      "match": false
    }
  ],
  "fpNotes": "Sandbox accounts are the common false positive — confirm account scope.",
  "linkedRules": [
    "DPK-SAST-329"
  ],
  "origin": "original-authored",
  "cell": "sast:terraform-strict:hcl:iamact",
  "validationStatus": "VALIDATED"
}
