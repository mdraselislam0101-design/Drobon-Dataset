{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-3122",
  "title": "Signal: Resolved pin whose revision is not a full SHA",
  "targets": [
    "swift"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "sca-field-not-matches",
      "path": "pins[].state.revision",
      "valuePattern": "^[0-9a-f]{40}$"
    }
  },
  "scope": "A Package.resolved file that declares a pin whose revision is shorter than 40 hex characters.",
  "limitations": "It matches a pin whose revision is shorter than 40 hex characters in the parsed Package.resolved; it cannot tell whether the package is installed, whether any published version is affected by an advisory, or whether the dependency reaches production code.",
  "examples": [
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "sdk",
            "location": "https://github.com/acme/sdk",
            "state": {
              "revision": "9f2c3d4e"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "core",
            "location": "https://github.com/acme/core",
            "state": {
              "revision": "a1b2"
            }
          }
        ]
      },
      "match": true
    },
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "sdk",
            "location": "https://github.com/acme/sdk",
            "state": {
              "revision": "9f2c3d4e5f60718293a4b5c6d7e8f90123456789"
            }
          }
        ]
      },
      "match": false
    },
    {
      "file": "Package.resolved",
      "document": {
        "pins": [
          {
            "identity": "core",
            "location": "https://github.com/acme/core",
            "state": {
              "revision": "abcdef0123456789abcdef0123456789abcdef01"
            }
          }
        ]
      },
      "match": false
    }
  ],
  "fpNotes": "A Package.resolved that mentions a pin whose revision is shorter than 40 hex characters in a comment, a documentation example or a template placeholder is not reported; the rule reads the parsed value that the installer acts on.",
  "linkedRules": [
    "DPK-SCA-0985"
  ],
  "origin": "original-authored",
  "cell": "sca:swift-resolved-pin-revision-short",
  "validationStatus": "VALIDATED"
}
