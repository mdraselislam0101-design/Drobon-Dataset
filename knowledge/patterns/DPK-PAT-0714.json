{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0714",
  "title": "Signal: Authentication bypass (permit) — review required",
  "targets": [
    "pam"
  ],
  "signal": {
    "kind": "regex",
    "source": "auth\\s+sufficient\\s+pam_permit"
  },
  "scope": "Single-line lexical match on auth configuration.",
  "limitations": "Lexical, line-based: matches the entry.",
  "examples": [
    {
      "line": "auth sufficient pam_permit.so",
      "match": true
    },
    {
      "line": "# audit: auth sufficient pam_permit.so present",
      "match": true
    },
    {
      "line": "auth required pam_unix.so",
      "match": false
    },
    {
      "line": "# verified: auth required pam_unix.so",
      "match": false
    }
  ],
  "fpNotes": "Recovery consoles are the rare accepted case.",
  "linkedRules": [
    "DPK-SAST-597"
  ],
  "origin": "original-authored",
  "cell": "sast:pam-unsafe:pam:permit",
  "validationStatus": "VALIDATED"
}
