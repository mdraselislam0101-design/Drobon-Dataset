{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0051",
  "title": "Signal: Weak Content-Security-Policy (unsafe-inline) header value",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "(?:^|;)\\s*(?:script-src(?:-elem|-attr)?|style-src(?:-elem|-attr)?|default-src)(?=[\\s;]|$)(?![^;]*(?:'nonce-[^'\\s]+'|'sha(?:256|384|512)-[^'\\s]+'))[^;]*'?unsafe-inline'?(?=['\\s;]|$)"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Directive-scoped value check: a nonce or hash anywhere in the same directive neutralises 'unsafe-inline' and suppresses the finding. It cannot tell whether the nonce is actually random, nor whether every inline script carries it, and it does not evaluate the deployment context.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'unsafe-inline'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; style-src 'unsafe-inline'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src-attr 'unsafe-inline'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'unsafe-inline' 'nonce-abc'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'unsafe-inline' 'sha256-AAA'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "style-src 'unsafe-inline' 'nonce-xyz'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "img-src 'unsafe-inline'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'unsafe-inline-x'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'nonce-a1b2'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src https://nonce-cdn.example 'unsafe-inline'"
        }
      },
      "match": true
    }
  ],
  "fpNotes": "Transitional deployments are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-021"
  ],
  "origin": "original-authored",
  "cell": "dast:header-weak:csp-unsafe",
  "validationStatus": "VALIDATED"
}
