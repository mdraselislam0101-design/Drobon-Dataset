{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0051",
  "title": "Signal: Weak Content-Security-Policy (unsafe-inline) header value",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-header-matches",
      "header": "Content-Security-Policy",
      "valuePattern": "unsafe-inline"
    }
  },
  "scope": "Single response header value.",
  "limitations": "Value check: it cannot confirm the deployment context.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'unsafe-inline'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; style-src 'unsafe-inline'"
        }
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Security-Policy": "script-src 'nonce-a1b2'"
        }
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {}
      },
      "match": false
    }
  ],
  "fpNotes": "Transitional deployments are the common accepted case.",
  "linkedRules": [
    "DPK-DAST-021"
  ],
  "origin": "original-authored",
  "cell": "dast:header-weak:csp-unsafe",
  "validationStatus": "VALIDATED"
}
