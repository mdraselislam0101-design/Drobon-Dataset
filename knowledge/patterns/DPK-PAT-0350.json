{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-0350",
  "title": "Signal: Weak service hardening (stats) — review required",
  "targets": [
    "haproxy"
  ],
  "signal": {
    "kind": "regex",
    "source": "\\b(?:stats\\s+socket)"
  },
  "scope": "Single-line lexical match on weak settings (stats).",
  "limitations": "Lexical, line-based: matches the setting regardless of host trust.",
  "examples": [
    {
      "line": "stats socket /run/h.sock",
      "match": true
    },
    {
      "line": "# audit: stats socket /run/h.sock present",
      "match": true
    },
    {
      "line": "# stats disabled",
      "match": false
    },
    {
      "line": "# verified: # stats disabled",
      "match": false
    }
  ],
  "fpNotes": "Lab hosts are the common false positive.",
  "linkedRules": [
    "DPK-SAST-311"
  ],
  "origin": "original-authored",
  "cell": "sast:sys-services:haproxy:stats",
  "validationStatus": "VALIDATED"
}
