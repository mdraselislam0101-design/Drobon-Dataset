{
  "schemaVersion": "drobon.knowledge.pattern/v1",
  "id": "DPK-PAT-1302",
  "title": "Signal: MinIO object-storage console disclosed",
  "targets": [
    "http"
  ],
  "signal": {
    "kind": "check",
    "check": {
      "type": "response-body-matches",
      "valuePattern": "(?=[\\s\\S]*MinIO)(?=[\\s\\S]*Console)"
    }
  },
  "scope": "One response whose body renders the MinIO console.",
  "limitations": "One response body. The rule reports the console shell; it does not list a bucket and cannot show whether a login would succeed.",
  "examples": [
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>MinIO Console</title></head><body><div id=\"minio-console\"></div><script src=\"/static/minio.js\"></script><h1>Console</h1></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<!doctype html><html><body><span>MinIO</span><div class=\"console-app\" data-console=\"minio\"></div></body></html>"
      },
      "match": true
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title> </title></head><body><div id=\"-\"></div><script src=\"/static/.js\"></script><h1></h1></body></html>"
      },
      "match": false
    },
    {
      "observation": {
        "url": "https://app.example/",
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html><head><title>Welcome</title></head><body><h1>It works</h1></body></html>"
      },
      "match": false
    }
  ],
  "fpNotes": "The bucket-listing rule reports anonymous listings and is a different finding.",
  "linkedRules": [
    "DPK-DAST-233"
  ],
  "origin": "original-authored",
  "cell": "dast:body-minio-console:minio-console",
  "validationStatus": "VALIDATED"
}
