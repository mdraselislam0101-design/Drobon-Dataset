[
 {
  "kind": "secrets",
  "cwe": "CWE-798",
  "severity": "HIGH",
  "framing": "custom",
  "title": "Possible {name} in source",
  "confidence": "MEDIUM",
  "class": "tool-credential-carriers",
  "category": "hardcoded-credential",
  "description": "The file contains {name}. Tool invocations end up in scripts, images and CI logs, which spreads a single committed value across many systems. Shape-only: the match does not prove the credential is live.",
  "scopeT": "One line, matching {name}.",
  "recordDesc": "{name} places a credential directly in a tool invocation. The value then propagates through build logs, image layers and copied commands, so it must be treated as exposed the moment it is committed.",
  "why": "{name} is captured by the shell history, the CI log and the image layer, so deleting the line later does not undo the exposure.",
  "applicability": "Scripts, Makefiles, CI definitions and runbooks that may contain {name}.",
  "risk": "Use of the credential through the tool it was meant for, by anyone who reads the script or the log; HIGH severity.",
  "fix": [
   "Rotate the credential at the target system.",
   "Pass the value through the environment or a protected credential file instead of the command line.",
   "Scrub the value from logs, images and history."
  ],
  "verifyT": "The old credential is rejected and no invocation of this shape carries a literal any more.",
  "remediation": "Rotate the credential, replace the inline value with an environment variable or a protected file, and purge the invocation from images, logs and shell history.",
  "limitation": "Shape-only: one tool-specific invocation carrying a credential-shaped literal. It cannot prove the credential is live, and it does not resolve values assembled at run time.",
  "fp": "Documentation and test scripts that show the tool with a placeholder value are the common false positives; the pattern requires a shaped literal and vetoes EXAMPLE text.",
