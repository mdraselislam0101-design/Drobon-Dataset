    },
    "tests": [
     {
      "line": "tool --password Zq7mKp4tQQQQQQQQQQQQ",
      "match": true
     },
     {
      "line": "tool --password=\"Zq7mKp4tQQQQQQQQQQQQ\"",
      "match": true
     },
     {
      "line": "tool --password-file /run/secrets/db",
      "match": false
     },
     {
      "line": "tool --password short",
      "match": false
     },
     {
      "line": "# --password EXAMPLE value is documented here",
      "match": false
