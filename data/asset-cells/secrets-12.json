[
 {
  "kind": "secrets",
  "cwe": "CWE-798",
  "severity": "HIGH",
  "framing": "custom",
  "title": "Possible {name} in source",
  "confidence": "MEDIUM",
  "class": "cli-credential-flags",
  "category": "hardcoded-credential",
  "description": "The file contains {name}. Command lines are copied into scripts, CI jobs, container entrypoints and shell history, so one committed argument spreads far past the file that first held it. Shape-only: the match does not prove the credential is live.",
  "scopeT": "One line, matching {name}.",
  "recordDesc": "{name} written into a script ships with the repository and with every build log that echoes the command. Rotation plus removing the literal argument is the durable fix.",
  "why": "{name} stays in the file, the image layers and the CI logs after the run, so the exposure outlives the moment it was typed.",
  "applicability": "Shell scripts, CI job definitions, Dockerfiles, Makefiles and runbooks that may contain {name}.",
  "risk": "Use of the credential by anyone who can read the script, the image or the CI log; HIGH severity.",
  "fix": [
   "Rotate the credential at the tool or service.",
   "Replace the literal argument with an environment variable or a protected credential file.",
   "Purge the flag from images, CI logs and shell history."
  ],
  "verifyT": "The old credential no longer authenticates and no invocation carries the literal argument any more.",
  "remediation": "Rotate the credential, remove the literal argument from the script, and let the tool read the value from an environment variable, a protected credential file, or a secret manager.",
  "limitation": "Shape-only: a specific tool flag followed by a password- or token-shaped literal. It cannot prove the value is live, and it does not see credentials assembled at run time from several variables.",
  "fp": "Documentation pages that show the flag with a placeholder value, and wrapper scripts that pass an environment-variable reference, are the common false positives; the pattern requires a shaped literal and vetoes EXAMPLE text.",
  "cells": [
   {
    "suffix": "flag-password",
