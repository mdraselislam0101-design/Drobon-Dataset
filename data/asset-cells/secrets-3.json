[
  {
    "class": "protocol-config",
    "kind": "secrets",
    "category": "service-credential",
    "cwe": "CWE-798",
    "severity": "HIGH",
    "confidence": "HIGH",
    "framing": "custom",
    "title": "Possible {name} in source",
    "description": "A committed {name} was found in a configuration or source file. Anyone with repository access can use it to reach the service it names until it is rotated. Shape-only: the match does not prove the value is live.",
    "remediation": "Rotate the credential in the provider console, check its access logs, and load the replacement from a secret manager at run time.",
    "limitation": "Shape-only: matches the documented syntax of this configuration form. It cannot prove the value is a live credential.",
    "scopeT": "Single-line shape match for {name}.",
    "fp": "Placeholders and documentation that reuse the same syntax are the common false positives.",
    "recordDesc": "{name} in source grants the access it names to every reader of the repository until it is rotated.",
    "applicability": "Configuration files and source that may embed {name}.",
    "risk": "Service access with the credential's scopes; HIGH severity.",
    "why": "A {name} committed to source works for anyone who can read it, until it is rotated.",
    "fix": [
      "Rotate the credential.",
      "Review access logs for use of the old value.",
      "Load the replacement from a secret manager."
    ],
    "verifyT": "The old value no longer authenticates, and no matching literal remains committed.",
    "cells": [
      {
        "suffix": "azure-account-key",
        "lang": "universal",
        "name": "Azure storage account key",
        "build": {
          "var": "conn",
          "confidence": "HIGH",
          "segments": [
            {
              "t": "lit",
              "v": [
                "AccountKey",
                "="
              ]
            },
            {
              "t": "run",
              "ch": "A",
              "n": 86,
              "cls": "A-Za-z0-9+/"
            },
            {
              "t": "ex",
              "sig": "==",
              "fix": "=="
            }
          ],
          "extraTests": [
            {
              "line": "conn = \"AccountKey=<account-key>\"",
              "match": false
            },
            {
              "line": "conn = \"AccountKey=xyz==\"",
              "match": false
            }
          ]
        }
      },
      {
        "suffix": "kafka-sasl-plain",
        "lang": "universal",
        "name": "Kafka SASL PLAIN password",
        "build": {
          "var": "jaas",
          "confidence": "HIGH",
          "segments": [
            {
              "t": "lit",
              "v": [
                "PlainLoginModule",
                " required"
              ]
            },
            {
              "t": "ex",
              "sig": "[^\\n]{0,80}\\bpassword=\"",
              "fix": " username=\"svc\" password=\""
            },
            {
              "t": "run",
              "ch": "A",
              "n": 16,
              "cls": "^\"\\s"
            },
            {
              "t": "lit",
              "v": [
                "\""
              ]
            }
          ],
          "extraTests": [
            {
              "line": "jaas = \"PlainLoginModule required username=\"svc\"\"",
              "match": false
            },
            {
              "line": "jaas = \"PlainLoginModule required username=\"svc\" password=\"<password>\"\"",
              "match": false
            }
          ]
        }
      },
      {
        "suffix": "jdbc-url-password",
        "lang": "universal",
        "name": "password in a JDBC URL",
        "build": {
          "var": "url",
          "confidence": "MEDIUM",
          "segments": [
            {
              "t": "lit",
              "v": [
                "jdbc:"
              ]
            },
            {
              "t": "ex",
              "sig": "[a-z0-9]+:[^\\s\"']{0,200}[?&;]password=",
              "fix": "postgresql://db.internal/app?ssl=true&password="
            },
            {
              "t": "run",
              "ch": "A",
              "n": 8,
              "cls": "^\\s\"'&;"
            }
          ],
          "extraTests": [
            {
              "line": "url = \"jdbc:postgresql://db.internal/app?ssl=true\"",
              "match": false
            },
            {
              "line": "url = \"jdbc:postgresql://db.internal/app?password=\"",
              "match": false
            }
          ]
        }
      },
      {
        "suffix": "docker-config-auth",
        "lang": "universal",
        "name": "Docker registry auth value in config.json",
        "build": {
          "var": "config",
          "confidence": "MEDIUM",
          "segments": [
            {
              "t": "lit",
              "v": [
                "\"auth\""
              ]
            },
            {
              "t": "ex",
              "sig": "\\s*:\\s*\"",
              "fix": " : \""
            },
            {
              "t": "run",
              "ch": "A",
              "n": 24,
              "cls": "A-Za-z0-9+/"
            },
            {
              "t": "ex",
              "sig": "={0,2}\"",
              "fix": "\""
            }
          ],
          "extraTests": [
            {
              "line": "config = \"auth\": \"none\"",
              "match": false
            },
            {
              "line": "config = \"authority\": \"https://login.internal\"",
              "match": false
            }
          ]
        }
      }
    ]
  }
]
