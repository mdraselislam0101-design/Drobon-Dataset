    "category": "information-disclosure",
    "cwe": "CWE-200",
    "severity": "LOW",
    "title": "GraphQL field suggestion disclosed",
    "description": "A GraphQL suggestion list in an error response appears in the response body. The suggestion list names fields that exist but were not queried, so an attacker can walk the schema one typo at a time even when introspection is disabled.",
    "remediation": "Disable field suggestions in production and return a generic error for an unknown field.",
    "limitation": "One response body. It matches the suggestion wording or array, not the schema itself.",
    "scopeT": "One response body. It matches the suggestion wording or array, not the schema itself.",
    "fp": "A page that documents a GraphQL client's error format is still reported; confirm it is static text.",
    "recordDesc": "A GraphQL suggestion list in an error response in a response gives every reader the same view the bank has internally: The suggestion list names fields that exist but were not queried, so an attacker can walk the schema one typo at a time even when introspection is disabled.",
    "applicability": "GraphQL endpoints reachable by customers or partners.",
    "risk": "A derived schema reveals internal fields, including administrative mutations that should not be discoverable.",
    "why": "Suggestions exist for developers and are a schema oracle in production.",
    "fix": [
      "Disable did-you-mean suggestions outside development.",
      "Require authentication for any schema-shaped error."
    ],
    "verifyT": "Send an unknown field and confirm the response carries no suggestion list.",
    "cells": [
      {
        "suffix": "body-graphql-suggestions",
        "lang": "http",
        "check": {
          "type": "response-body-matches",
          "valuePattern": "did you mean|graphql suggestion|\\\"suggestions\\\"\\s*:\\s*\\["
        },
        "tests": [
          {
            "observation": {
              "url": "https://bank.example/portal/home",
              "status": 200,
              "headers": {
                "Content-Type": "text/html; charset=utf-8",
