          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-Redirect-By": "Drupal"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "xdrupal",
        "lang": "http",
        "name": "X-Drupal-Cache header",
        "safe": "stripped platform headers",
        "check": {
          "type": "response-header-matches",
          "header": "X-Drupal-Cache",
          "valuePattern": "[^ ]"
        },
        "tests": [
