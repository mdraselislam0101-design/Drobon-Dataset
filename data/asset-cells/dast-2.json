  {
    "class": "response-weak-2",
    "kind": "dast",
    "category": "security-headers",
    "cwe": "CWE-693",
    "severity": "MEDIUM",
    "framing": "custom",
    "title": "Weak response control ({name})",
    "description": "The response weakens a control: {name}. Protocol-relative redirects, wildcard timing origins, and charset-less content types widen attacks. This check matches the weakness directly.",
    "remediation": "Strengthen the control ({safe}).",
    "limitation": "Header check: it cannot confirm exploitability.",
    "scopeT": "Single response header value.",
    "fp": "CDN behaviors are the common accepted case.",
    "recordDesc": "{name} in responses weakens a control. Hardening the value restores the protection.",
    "applicability": "HTTP responses carrying the header.",
    "risk": "Varies by control; MEDIUM severity.",
    "why": "{name} weakens a response control.",
    "fix": [
      "Strengthen to {safe}."
    ],
    "verifyT": "Rescan observes the hardened value.",
    "cells": [
      {
        "suffix": "location-proto",
        "lang": "http",
        "name": "protocol-relative Location",
        "safe": "absolute https URLs",
        "check": {
          "type": "response-header-matches",
          "header": "Location",
          "valuePattern": "^//"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 302,
              "headers": {
                "Location": "//evil.example/x"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 301,
              "headers": {
                "Location": "//cdn.example/x"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 302,
              "headers": {
                "Location": "https://app.example/x"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "timing-star",
        "lang": "http",
        "name": "wildcard Timing-Allow-Origin",
        "safe": "explicit origins",
        "check": {
          "type": "response-header-matches",
          "header": "Timing-Allow-Origin",
          "valuePattern": "^\\*$"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Timing-Allow-Origin": "*"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/x",
              "status": 200,
              "headers": {
                "Timing-Allow-Origin": "*"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Timing-Allow-Origin": "https://app.example/"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "charset-missing",
        "lang": "http",
        "name": "charset-less Content-Type",
        "safe": "charset=utf-8",
        "check": {
          "type": "response-header-missing-directive",
          "header": "Content-Type",
          "directive": "charset"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/html"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/plain"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/html; charset=utf-8"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "http://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/html; charset=utf-8"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "hsts-nosub",
        "lang": "http",
        "name": "HSTS without includeSubDomains",
        "safe": "includeSubDomains",
        "check": {
          "type": "response-header-missing-directive",
          "header": "Strict-Transport-Security",
          "directive": "includeSubDomains"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Strict-Transport-Security": "max-age=31536000"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Strict-Transport-Security": "max-age=1000"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "http://app.example/",
              "status": 200,
              "headers": {
                "Strict-Transport-Security": "max-age=1; includeSubDomains"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "coop-lax",
        "lang": "http",
        "name": "COOP without same-origin",
        "safe": "same-origin",
        "check": {
          "type": "response-header-missing-directive",
          "header": "Cross-Origin-Opener-Policy",
          "directive": "same-origin"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Cross-Origin-Opener-Policy": "unsafe-none"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Cross-Origin-Opener-Policy": "same-origin"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "http://app.example/",
              "status": 200,
              "headers": {
                "Cross-Origin-Opener-Policy": "same-origin"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "coep-lax",
