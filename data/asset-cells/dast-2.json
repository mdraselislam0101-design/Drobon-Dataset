            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-Served-By": "edge-2"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
