[
  {
    "class": "header-missing-2",
    "kind": "dast",
    "category": "security-headers",
    "cwe": "CWE-693",
    "severity": "MEDIUM",
    "framing": "custom",
    "title": "Missing {name} response header",
    "description": "The response carries no {name} header. Its absence forfeits the protection the header provides. This check evaluates a normal observation and confirms the header is absent.",
    "remediation": "Emit {name} on every response ({safe}).",
    "limitation": "Header-name check: it cannot judge whether the header value is correct.",
    "scopeT": "Single response: confirm the header is absent.",
    "fp": "Non-browser endpoints are the common accepted case.",
    "recordDesc": "{name} is a response header with no equivalent protection when absent. Responses carrying no such header fail this check.",
    "applicability": "HTTP responses serving browser clients.",
    "risk": "Loss of the header's protection; MEDIUM severity.",
    "why": "Responses carry no {name} header.",
    "fix": [
      "Emit {name} on every response.",
      "Confirm at the edge and the origin."
    ],
    "verifyT": "Rescan observes the header.",
    "cells": [
      {
        "suffix": "xpcp",
        "lang": "http",
        "name": "X-Permitted-Cross-Domain-Policies",
        "safe": "none",
        "check": {
          "type": "missing-response-header",
          "header": "X-Permitted-Cross-Domain-Policies"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/html"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/login",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-Permitted-Cross-Domain-Policies": "none"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 500,
              "headers": {
                "X-Permitted-Cross-Domain-Policies": "none"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "expectct",
        "lang": "http",
        "name": "Expect-CT header",
        "safe": "enforce with report-uri",
        "check": {
          "type": "missing-response-header",
          "header": "Expect-CT"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/html"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/login",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Expect-CT": "enforce, max-age=86400"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 500,
              "headers": {
                "Expect-CT": "enforce, max-age=1"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "nel",
        "lang": "http",
        "name": "NEL header",
        "safe": "a report-to group",
        "check": {
          "type": "missing-response-header",
          "header": "NEL"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/html"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/login",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "NEL": "{\"report_to\":\"x\"}"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 500,
              "headers": {
                "NEL": "{\"report_to\":\"x\"}"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "reportto",
        "lang": "http",
        "name": "Report-To header",
        "safe": "an endpoint group",
        "check": {
          "type": "missing-response-header",
          "header": "Report-To"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/html"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/login",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Report-To": "{\"group\":\"x\"}"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 500,
              "headers": {
                "Report-To": "{\"group\":\"x\"}"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "dnsprefetch",
        "lang": "http",
        "name": "X-DNS-Prefetch-Control header",
        "safe": "off",
        "check": {
          "type": "missing-response-header",
          "header": "X-DNS-Prefetch-Control"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/html"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/login",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-DNS-Prefetch-Control": "off"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 500,
              "headers": {
                "X-DNS-Prefetch-Control": "off"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "oac",
        "lang": "http",
        "name": "Origin-Agent-Cluster header",
        "safe": "?1",
        "check": {
          "type": "missing-response-header",
          "header": "Origin-Agent-Cluster"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/html"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/login",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Origin-Agent-Cluster": "?1"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 500,
              "headers": {
                "Origin-Agent-Cluster": "?1"
              }
            },
            "match": false
          }
        ]
      }
    ]
  },
  {
    "class": "banner-more",
    "kind": "dast",
    "category": "information-disclosure",
    "cwe": "CWE-200",
    "severity": "LOW",
    "framing": "custom",
    "title": "Infrastructure banner disclosed ({name})",
    "description": "The response discloses a {name} banner. Infrastructure banners map the stack for attackers. This check matches the banner directly.",
    "remediation": "Suppress the banner ({safe}).",
    "limitation": "Banner check: version visibility alone is not exploitability.",
    "scopeT": "Single response header value.",
    "fp": "CDN-added banners are the common accepted case.",
    "recordDesc": "{name} banners in responses map infrastructure. Quiet banners slow targeted attacks.",
    "applicability": "HTTP responses carrying banners.",
    "risk": "Stack fingerprinting; LOW severity.",
    "why": "{name} discloses infrastructure detail.",
    "fix": [
      "Suppress with {safe}."
    ],
    "verifyT": "Rescan observes no banner.",
    "cells": [
      {
        "suffix": "via",
        "lang": "http",
        "name": "Via header",
        "safe": "stripped proxy headers",
        "check": {
          "type": "response-header-matches",
          "header": "Via",
          "valuePattern": "[^ ]"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Via": "1.1 proxy"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Via": "2.0 edge"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "xcache",
        "lang": "http",
        "name": "X-Cache header",
        "safe": "stripped cache headers",
        "check": {
          "type": "response-header-matches",
          "header": "X-Cache",
          "valuePattern": "[^ ]"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-Cache": "HIT"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-Cache": "MISS"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "xvarnish",
        "lang": "http",
        "name": "X-Varnish header",
        "safe": "stripped cache headers",
        "check": {
          "type": "response-header-matches",
          "header": "X-Varnish",
          "valuePattern": "[^ ]"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-Varnish": "123 456"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-Varnish": "789"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "xredirectby",
        "lang": "http",
        "name": "X-Redirect-By header",
        "safe": "stripped platform headers",
        "check": {
          "type": "response-header-matches",
          "header": "X-Redirect-By",
          "valuePattern": "[^ ]"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
