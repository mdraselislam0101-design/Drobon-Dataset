    "class": "body-form-missing-csrf",
    "category": "weak-markup",
    "cwe": "CWE-352",
    "severity": "MEDIUM",
    "title": "POST form without a CSRF token",
    "description": "A form that posts and carries no anti-CSRF field appears in the response body. Without a token the endpoint accepts a request the browser sends on behalf of a logged-in user from another site, so an attacker can submit the action with the victim's session.",
    "remediation": "Add a per-session CSRF token to every state-changing form and verify it server-side.",
    "limitation": "One response body. It matches a POST form whose markup contains no csrf-shaped field, not whether the endpoint checks a header instead.",
    "scopeT": "One response body. It matches a POST form whose markup contains no csrf-shaped field, not whether the endpoint checks a header instead.",
    "fp": "An application that validates a custom header or SameSite=Strict on every state-changing route may be safe; confirm the server check.",
    "recordDesc": "A form that posts and carries no anti-CSRF field in a response gives every reader the same view the bank has internally: Without a token the endpoint accepts a request the browser sends on behalf of a logged-in user from another site, so an attacker can submit the action with the victim's session.",
    "applicability": "Transfers, profile changes, card controls and any form that changes state.",
    "risk": "A forged request executes with the victim's session and moves money or changes credentials.",
    "why": "A token the attacker cannot read is the only thing that distinguishes the user's own submission from a forged one.",
    "fix": [
      "Emit a CSRF token per session and validate it on every state-changing request.",
      "Set SameSite=Lax or Strict on the session cookie as defence in depth."
    ],
    "verifyT": "Submit the form from another origin and confirm the server rejects the request.",
    "cells": [
      {
        "suffix": "body-form-missing-csrf",
        "lang": "http",
        "check": {
          "type": "response-body-matches",
          "valuePattern": "<form\\b(?=[^>]{0,300}method\\s*=\\s*[\\\"']?post)(?=[\\s\\S]{0,1200}?<input)(?![\\s\\S]{0,1200}?csrf)[\\s\\S]{0,1200}?</form>"
        },
