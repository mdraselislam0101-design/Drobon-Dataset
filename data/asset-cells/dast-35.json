  {
    "kind": "dast",
    "framing": "custom",
    "class": "body-standing-instruction",
    "category": "privacy-exposure",
    "cwe": "CWE-359",
    "severity": "MEDIUM",
    "title": "Standing instruction detail in a response",
    "description": "A standing order or direct-debit record with its amount appears in the response body. The record names the beneficiary and the recurring amount, which describes the customer's obligations and cash flow without any need for the value to reach the page.",
    "remediation": "Return a masked beneficiary and a rounded amount, and require re-authentication for the mandate detail.",
    "limitation": "One response body. It matches the instruction word and an amount field within 200 characters.",
    "scopeT": "One response body. It matches the instruction word and an amount field within 200 characters.",
    "fp": "A page that lists standing orders with masked amounts is not reported, because the amount field must be present.",
    "recordDesc": "A standing order or direct-debit record with its amount in a response gives every reader the same view the bank has internally: The record names the beneficiary and the recurring amount, which describes the customer's obligations and cash flow without any need for the value to reach the page.",
    "applicability": "Payments hub, mandate management and account summary pages.",
    "risk": "Recurring obligations reveal income timing and commitments that support targeted fraud and social engineering.",
    "why": "A mandate is financial personal data, and the page only needs to show that it exists.",
    "fix": [
      "Mask the beneficiary and the amount in list views.",
      "Require step-up authentication to edit or view the mandate."
    ],
    "verifyT": "Open the payments hub and confirm the list shows no full mandate amount.",
    "cells": [
      {
        "suffix": "body-standing-instruction",
        "lang": "http",
        "check": {
          "type": "response-body-matches",
          "valuePattern": "\\b(?:standing[_ ]?(?:order|instruction)|direct[_ ]?debit|auto[_ ]?debit)[\\s\\S]{0,160}?\\b(?:amount|installment|instalment|frequency)\\b"
        },
        "tests": [
          {
            "observation": {
              "url": "https://bank.example/portal/home",
              "status": 200,
              "headers": {
                "Content-Type": "text/html; charset=utf-8",
                "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
                "X-Content-Type-Options": "nosniff",
