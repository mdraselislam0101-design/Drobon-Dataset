[
  {
    "kind": "dast",
    "framing": "custom",
    "class": "body-sort-code-pair",
    "category": "privacy-exposure",
    "cwe": "CWE-359",
    "severity": "HIGH",
    "title": "Sort code and account number pair in a response",
    "description": "A UK sort code followed by an eight-digit account number appears in the response body. The pair is enough to set up a direct debit or a bank transfer at many institutions, and it appears together exactly as a payment instruction needs it.",
    "remediation": "Mask both values to the last four digits in every response and require re-authentication for the full detail.",
    "limitation": "One response body. It matches the pair within 200 characters, not whether the account is still open.",
    "scopeT": "One response body. It matches the pair within 200 characters, not whether the account is still open.",
    "fp": "A page that shows the sort code alone, with no account number, is not reported.",
    "recordDesc": "A UK sort code followed by an eight-digit account number in a response gives every reader the same view the bank has internally: The pair is enough to set up a direct debit or a bank transfer at many institutions, and it appears together exactly as a payment instruction needs it.",
    "applicability": "Account summary, direct-debit setup and statement pages.",
    "risk": "The pair plus a name is a payment instruction; leaking it supports fraudulent mandates.",
    "why": "Sort code and account number are stable identifiers, unlike a session or a token.",
    "fix": [
      "Mask the account number to the last four digits.",
      "Require step-up authentication for the full payment detail."
    ],
    "verifyT": "Open the account page and confirm only masked values are returned.",
    "cells": [
      {
        "suffix": "body-sort-code-pair",
        "lang": "http",
        "check": {
          "type": "response-body-matches",
          "valuePattern": "sort[_ -]?code\\b[\\s\\S]{0,60}?\\d{2}[- ]?\\d{2}[- ]?\\d{2}\\b[\\s\\S]{0,260}?(?:account|acct)[_ ]?(?:number|no)\\b[\\s\\S]{0,40}?\\d{8}\\b"
        },
        "tests": [
          {
            "observation": {
              "url": "https://bank.example/portal/home",
              "status": 200,
              "headers": {
                "Content-Type": "text/html; charset=utf-8",
                "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
                "X-Content-Type-Options": "nosniff",
                "X-Frame-Options": "DENY",
                "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
                "Referrer-Policy": "no-referrer",
                "Cross-Origin-Embedder-Policy": "require-corp",
                "Cross-Origin-Opener-Policy": "same-origin",
                "Cross-Origin-Resource-Policy": "same-origin",
                "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
                "X-Permitted-Cross-Domain-Policies": "none",
                "Cache-Control": "no-store"
              },
              "body": "<dl><dt>Sort code</dt><dd>20-45-11</dd><dt>Account number</dt><dd>account no: 31926819</dd></dl>"
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://bank.example/api/detail",
              "status": 200,
              "headers": {
                "Content-Type": "text/html; charset=utf-8",
                "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
                "X-Content-Type-Options": "nosniff",
                "X-Frame-Options": "DENY",
                "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
                "Referrer-Policy": "no-referrer",
                "Cross-Origin-Embedder-Policy": "require-corp",
                "Cross-Origin-Opener-Policy": "same-origin",
                "Cross-Origin-Resource-Policy": "same-origin",
                "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
                "X-Permitted-Cross-Domain-Policies": "none",
                "Cache-Control": "no-store"
              },
              "body": "{\"sortCode\":\"30-96-26\",\"account\":{\"accountNumber\":\"12345678\"}}"
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://bank.example/help/security",
              "status": 200,
              "headers": {
                "Content-Type": "text/html; charset=utf-8",
                "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
                "X-Content-Type-Options": "nosniff",
                "X-Frame-Options": "DENY",
                "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
                "Referrer-Policy": "no-referrer",
                "Cross-Origin-Embedder-Policy": "require-corp",
                "Cross-Origin-Opener-Policy": "same-origin",
                "Cross-Origin-Resource-Policy": "same-origin",
                "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
                "X-Permitted-Cross-Domain-Policies": "none",
                "Cache-Control": "no-store"
              },
              "body": "<dl><dt>Sort code</dt><dd>20-45-11</dd></dl>"
            },
            "match": false
          }
        ]
      }
    ]
  },
  {
    "kind": "dast",
    "framing": "custom",
    "class": "body-card-expiry-pair",
    "category": "privacy-exposure",
    "cwe": "CWE-359",
    "severity": "MEDIUM",
    "title": "Card expiry date served in a response",
    "description": "A card expiry month and year next to card wording appears in the response body. An expiry date is one of the three values a card-not-present transaction needs, and it is useless to the customer but valuable alongside a leaked number.",
    "remediation": "Return a masked expiry only, or the last four digits with no date, and keep the full detail behind a re-authenticated view.",
    "limitation": "One response body. It matches a card word and an expiry value in the same body, not the card number itself.",
    "scopeT": "One response body. It matches a card word and an expiry value in the same body, not the card number itself.",
    "fp": "A page that explains when a card expires, with no value, is not reported.",
    "recordDesc": "A card expiry month and year next to card wording in a response gives every reader the same view the bank has internally: An expiry date is one of the three values a card-not-present transaction needs, and it is useless to the customer but valuable alongside a leaked number.",
    "applicability": "Card management, subscription billing and saved-card pages.",
    "risk": "Expiry dates complete partial card data that leaks through other channels such as receipts and support tickets.",
    "why": "The expiry date has one purpose in a payment and none in a page.",
    "fix": [
      "Mask the expiry to the month only, or omit it.",
      "Require re-authentication to view the saved card's full detail."
    ],
    "verifyT": "Open the saved-cards page and confirm no full expiry date is returned.",
    "cells": [
      {
        "suffix": "body-card-expiry-pair",
        "lang": "http",
        "check": {
          "type": "response-body-matches",
          "valuePattern": "(?:card|visa|mastercard)[\\s\\S]{0,140}?\\b(?:expiry|expires|valid[_ ]?thru)\\b[\\s\\S]{0,40}?(?:0[1-9]|1[0-2])\\s*/\\s*\\d{2}\\b"
        },
        "tests": [
          {
            "observation": {
              "url": "https://bank.example/portal/home",
              "status": 200,
              "headers": {
                "Content-Type": "text/html; charset=utf-8",
                "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
                "X-Content-Type-Options": "nosniff",
                "X-Frame-Options": "DENY",
                "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
                "Referrer-Policy": "no-referrer",
                "Cross-Origin-Embedder-Policy": "require-corp",
                "Cross-Origin-Opener-Policy": "same-origin",
                "Cross-Origin-Resource-Policy": "same-origin",
                "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
                "X-Permitted-Cross-Domain-Policies": "none",
                "Cache-Control": "no-store"
              },
              "body": "<div class=\"card\">Visa ending 4242 &middot; expiry: 09/28</div>"
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://bank.example/api/detail",
              "status": 200,
              "headers": {
                "Content-Type": "text/html; charset=utf-8",
                "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
                "X-Content-Type-Options": "nosniff",
                "X-Frame-Options": "DENY",
                "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
                "Referrer-Policy": "no-referrer",
                "Cross-Origin-Embedder-Policy": "require-corp",
                "Cross-Origin-Opener-Policy": "same-origin",
                "Cross-Origin-Resource-Policy": "same-origin",
                "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
                "X-Permitted-Cross-Domain-Policies": "none",
                "Cache-Control": "no-store"
              },
              "body": "{\"card\":{\"brand\":\"mastercard\",\"expiry\":\"04/27\"}}"
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://bank.example/help/security",
              "status": 200,
              "headers": {
                "Content-Type": "text/html; charset=utf-8",
                "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
                "X-Content-Type-Options": "nosniff",
                "X-Frame-Options": "DENY",
                "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
                "Referrer-Policy": "no-referrer",
                "Cross-Origin-Embedder-Policy": "require-corp",
                "Cross-Origin-Opener-Policy": "same-origin",
                "Cross-Origin-Resource-Policy": "same-origin",
                "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
                "X-Permitted-Cross-Domain-Policies": "none",
                "Cache-Control": "no-store"
              },
              "body": "<div class=\"card\">Visa ending 4242 &middot; expires next year</div>"
