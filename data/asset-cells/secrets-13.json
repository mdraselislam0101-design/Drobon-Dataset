 {
  "kind": "secrets",
  "cwe": "CWE-798",
  "severity": "HIGH",
  "framing": "custom",
  "title": "Possible {name} in source",
  "confidence": "MEDIUM",
  "class": "http-credential-headers",
  "category": "service-token",
  "description": "The file contains {name}. Header values are copied into clients, tests and proxy configuration, so a committed one authorises every reader until it is revoked. Shape-only: the match does not prove the token is live.",
  "scopeT": "One line, matching {name}.",
  "recordDesc": "{name} in a committed file hands the bearer credential to every reader and to every tool that replays the request. Revoking the token is the only step that ends the exposure.",
  "why": "{name} copies cleanly into bug reports, fixtures and client bundles, so revocation rather than deletion is what ends the exposure.",
  "applicability": "Source, tests, HTTP fixtures, proxy configuration and browser bundles that may contain {name}.",
  "risk": "API access with the header credential's scopes, from anywhere the value was copied; HIGH severity.",
  "fix": [
   "Revoke the credential at the service that issued it.",
   "Load the header value at run time from a secret manager.",
   "Search fixtures, bundles and logs for the same value and purge them."
  ],
  "verifyT": "The revoked value is rejected and no literal of this header remains in the tree.",
  "remediation": "Revoke the token at the service, replace the literal header with a value loaded at run time from a secret manager, and check client bundles and logs for the same value.",
  "limitation": "Shape-only, case-insensitive match on a specific header name followed by a token-shaped value. It cannot prove the token is valid, and it does not see headers assembled dynamically.",
  "fp": "Sample requests in documentation, test doubles and recorded HTTP fixtures are the common false positives; the pattern requires a shaped value and vetoes EXAMPLE text.",
  "cells": [
   {
    "suffix": "hdr-authorization-basic",
    "lang": "universal",
    "name": "HTTP Basic credentials in an Authorization header",
    "signal": {
     "source": "\\bauthorization\\s*:\\s*basic\\s+[A-Za-z0-9+/]{16,}={0,2}",
     "flags": "i"
    },
    "tests": [
     {
      "line": "Authorization: Basic dXNlcjpQQQQQQQQQQQQQQQQ",
      "match": true
     },
     {
      "line": "Authorization: Basic QQQQQQQQ",
      "match": false
     },
     {
      "line": "# Authorization: Basic <token> placeholder",
      "match": false
     }
    ]
   },
