[
  {
    "class": "header-missing",
    "kind": "dast",
    "category": "security-headers",
    "cwe": "CWE-693",
    "cweDef": {
      "name": "Protection Mechanism Failure",
      "summary": "Missing response headers remove a protection layer the browser would otherwise enforce."
    },
    "severity": "MEDIUM",
    "framing": "custom",
    "title": "Missing {name} response header",
    "description": "The response carries no {name} header. Its absence forfeits the protection the header provides. This check evaluates a normal observation and confirms the header is absent.",
    "remediation": "Emit {name} on every response ({safe}).",
    "limitation": "Header-name check: it cannot judge whether the header value is correct.",
    "scopeT": "Single response: confirm the header is absent.",
    "fp": "Non-browser endpoints are the common accepted case.",
    "recordDesc": "{name} is a response header with no equivalent protection when absent. Responses carrying no such header fail this check.",
    "applicability": "HTTP responses serving browser clients.",
    "risk": "Loss of the header's protection; MEDIUM severity.",
    "why": "Responses carry no {name} header.",
    "fix": [
      "Emit {name} on every response.",
      "Confirm at the edge and the origin."
    ],
    "verifyT": "Rescan observes the header.",
    "cells": [
      {
        "suffix": "hsts",
        "lang": "http",
        "name": "Strict-Transport-Security",
        "safe": "max-age=31536000; includeSubDomains",
        "check": {
          "type": "missing-response-header",
          "header": "Strict-Transport-Security"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/html"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/login",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Strict-Transport-Security": "max-age=31536000"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 500,
              "headers": {
                "Strict-Transport-Security": "max-age=1"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "permissions",
        "lang": "http",
        "name": "Permissions-Policy",
        "safe": "camera=(), microphone=()",
        "check": {
          "type": "missing-response-header",
          "header": "Permissions-Policy"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/html"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/login",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Permissions-Policy": "camera=()"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 500,
              "headers": {
                "Permissions-Policy": "camera=()"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "coep",
        "lang": "http",
        "name": "Cross-Origin-Embedder-Policy",
        "safe": "require-corp",
        "check": {
          "type": "missing-response-header",
          "header": "Cross-Origin-Embedder-Policy"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/html"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/login",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Cross-Origin-Embedder-Policy": "require-corp"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 500,
              "headers": {
                "Cross-Origin-Embedder-Policy": "require-corp"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "coop",
        "lang": "http",
        "name": "Cross-Origin-Opener-Policy",
        "safe": "same-origin",
        "check": {
          "type": "missing-response-header",
          "header": "Cross-Origin-Opener-Policy"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/html"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/login",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Cross-Origin-Opener-Policy": "same-origin"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 500,
              "headers": {
                "Cross-Origin-Opener-Policy": "same-origin"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "corp",
        "lang": "http",
        "name": "Cross-Origin-Resource-Policy",
        "safe": "same-origin",
        "check": {
          "type": "missing-response-header",
          "header": "Cross-Origin-Resource-Policy"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Type": "text/html"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/login",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Cross-Origin-Resource-Policy": "same-origin"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 500,
              "headers": {
                "Cross-Origin-Resource-Policy": "same-origin"
              }
            },
            "match": false
          }
        ]
      }
    ]
  },
  {
    "class": "header-weak",
    "kind": "dast",
    "category": "security-headers",
    "cwe": "CWE-693",
    "severity": "LOW",
    "framing": "custom",
    "title": "Weak {name} header value",
    "description": "The response carries {name} with a weak or deprecated value. A weak value grants partial protection at best. This check matches the weak value directly.",
    "remediation": "Strengthen the value ({safe}).",
    "limitation": "Value check: it cannot confirm the deployment context.",
    "scopeT": "Single response header value.",
    "fp": "Transitional deployments are the common accepted case.",
    "recordDesc": "{name} with a weak value leaves most of the attack class open. Weak values are worth flagging even where the header exists.",
    "applicability": "HTTP responses carrying the header.",
    "risk": "Partial protection only; LOW severity.",
    "why": "{name} carries a weak value.",
    "fix": [
      "Strengthen to {safe}."
    ],
    "verifyT": "Rescan observes the strong value.",
    "cells": [
      {
        "suffix": "hsts-short",
        "lang": "http",
        "name": "Strict-Transport-Security max-age",
        "safe": "max-age=31536000",
        "check": {
          "type": "response-header-matches",
          "header": "Strict-Transport-Security",
          "valuePattern": "max-age\\s*=\\s*[0-9]{1,7}\\b"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Strict-Transport-Security": "max-age=86400"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Strict-Transport-Security": "max-age=1000; includeSubDomains"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Strict-Transport-Security": "max-age=31536000"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "hsts-nopreload",
        "lang": "http",
        "name": "HSTS preload directive",
        "safe": "preload with list submission",
        "check": {
          "type": "response-header-missing-directive",
          "header": "Strict-Transport-Security",
          "directive": "preload"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Strict-Transport-Security": "max-age=31536000"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Strict-Transport-Security": "max-age=63072000; includeSubDomains"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Strict-Transport-Security": "max-age=31536000; preload"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "http://app.example/",
              "status": 200,
              "headers": {
                "Strict-Transport-Security": "max-age=1; preload"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "csp-unsafe",
        "lang": "http",
        "name": "Content-Security-Policy (unsafe-inline)",
        "safe": "nonce-based scripts",
        "check": {
          "type": "response-header-matches",
          "header": "Content-Security-Policy",
          "valuePattern": "unsafe-inline"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Security-Policy": "script-src 'unsafe-inline'"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Security-Policy": "default-src 'self'; style-src 'unsafe-inline'"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Security-Policy": "script-src 'nonce-a1b2'"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "csp-wildcard",
        "lang": "http",
        "name": "Content-Security-Policy default-src wildcard",
        "safe": "explicit source lists",
        "check": {
          "type": "response-header-matches",
          "header": "Content-Security-Policy",
          "valuePattern": "default-src(?=\\s)[^;*]*?(?<=\\s)\\*(?=\\s*(?:;|$))"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Security-Policy": "default-src *"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Security-Policy": "default-src *; script-src 'self'"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Security-Policy": "default-src 'self'"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Security-Policy": "default-src 'self' *"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Security-Policy": "default-src *.example.com"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Content-Security-Policy": "default-src 'self'; script-src *"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "xfo-allowfrom",
        "lang": "http",
        "name": "X-Frame-Options (ALLOW-FROM)",
        "safe": "frame-ancestors in CSP",
        "check": {
          "type": "response-header-matches",
          "header": "X-Frame-Options",
          "valuePattern": "ALLOW-FROM"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-Frame-Options": "ALLOW-FROM https://a.example/"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-Frame-Options": "ALLOW-FROM https://b.example/"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-Frame-Options": "DENY"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          }
        ]
      }
    ]
  },
  {
    "class": "server-version",
    "kind": "dast",
    "category": "information-disclosure",
    "cwe": "CWE-200",
    "severity": "LOW",
    "framing": "custom",
    "title": "Server version disclosed ({name})",
    "description": "The response discloses a versioned {name} banner. Version banners let attackers aim known exploits. This check matches the banner directly.",
    "remediation": "Suppress the version ({safe}).",
    "limitation": "Banner check: version visibility alone is not exploitability.",
    "scopeT": "Single response header value.",
    "fp": "Honeypot banners are the rare false positive.",
    "recordDesc": "{name} banners carrying release numbers turn reconnaissance into a version lookup. Quiet banners slow targeted attacks.",
    "applicability": "HTTP responses carrying banners.",
    "risk": "Targeted exploit selection; LOW severity.",
    "why": "{name} discloses its release number.",
    "fix": [
      "Suppress with {safe}."
    ],
    "verifyT": "Rescan observes no versioned banner.",
    "cells": [
      {
        "suffix": "server",
        "lang": "http",
        "name": "Server header",
        "safe": "ServerTokens Prod",
        "check": {
          "type": "response-header-matches",
          "header": "Server",
          "valuePattern": "[0-9]+\\.[0-9]+"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Server": "Apache/2.4.58"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Server": "nginx/1.25.3"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "xpoweredby",
        "lang": "http",
        "name": "X-Powered-By header",
        "safe": "expose_php Off or header removal",
        "check": {
          "type": "response-header-matches",
          "header": "X-Powered-By",
          "valuePattern": "[^ ]"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-Powered-By": "PHP/8.2.1"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-Powered-By": "Express"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "aspnet",
        "lang": "http",
        "name": "X-AspNet-Version header",
        "safe": "enableVersionHeader false",
        "check": {
          "type": "response-header-matches",
          "header": "X-AspNet-Version",
          "valuePattern": "[^ ]"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-AspNet-Version": "4.0.30319"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-AspNet-Version": "2.0.50727"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "generator",
        "lang": "http",
        "name": "X-Generator header",
        "safe": "header removal",
        "check": {
          "type": "response-header-matches",
          "header": "X-Generator",
          "valuePattern": "[^ ]"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-Generator": "Drupal 10"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "X-Generator": "WordPress 6.4"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Server": "web"
              }
            },
            "match": false
          }
        ]
      },
      {
        "suffix": "jenkins",
        "lang": "http",
        "name": "X-Jenkins header",
        "safe": "restricted Jenkins access",
        "check": {
          "type": "response-header-matches",
          "header": "X-Jenkins",
          "valuePattern": "[^ ]"
        },
        "tests": [
          {
