  {
    "class": "cors-open",
    "kind": "dast",
    "category": "cors",
    "cwe": "CWE-942",
    "cweDef": {
      "name": "Overly Permissive Cross-domain Whitelist",
      "summary": "Wildcard CORS origins let any site read responses."
    },
    "severity": "MEDIUM",
    "framing": "custom",
    "title": "Wildcard CORS ({name})",
    "description": "The response allows every origin: {name}. Any site can read the response. This check matches the wildcard directly.",
    "remediation": "Allowlist origins ({safe}).",
    "limitation": "Header check: it cannot confirm which callers are legitimate.",
    "scopeT": "Single response header value.",
    "fp": "Public APIs are the common accepted case.",
    "recordDesc": "{name} lets arbitrary sites read responses.",
    "applicability": "HTTP responses with CORS headers.",
    "risk": "Cross-origin data theft; MEDIUM severity.",
    "why": "CORS allows every origin ({name}).",
    "fix": [
      "Allowlist with {safe}."
    ],
    "verifyT": "Rescan observes explicit origins.",
    "cells": [
      {
        "suffix": "wildcard",
        "lang": "http",
        "name": "Access-Control-Allow-Origin *",
        "safe": "an explicit origin list",
        "check": {
          "type": "response-header-matches",
          "header": "Access-Control-Allow-Origin",
          "valuePattern": "^\\*$"
        },
        "tests": [
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Access-Control-Allow-Origin": "*"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/api",
              "status": 200,
              "headers": {
                "Access-Control-Allow-Origin": "*"
              }
            },
            "match": true
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {
                "Access-Control-Allow-Origin": "https://app.example/"
              }
            },
            "match": false
          },
          {
            "observation": {
              "url": "https://app.example/",
              "status": 200,
              "headers": {}
            },
            "match": false
          }
        ]
      }
    ]
  },
  {
    "class": "http-methods",
    "kind": "dast",
    "category": "http-methods",
    "cwe": "CWE-749",
    "cweDef": {
