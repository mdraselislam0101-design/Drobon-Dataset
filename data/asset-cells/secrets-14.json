    ]
   },
   {
    "suffix": "fmt-openvpn-static-key",
    "lang": "universal",
    "name": "an OpenVPN static key block header",
    "signal": {
     "source": "-----BEGIN OpenVPN Static key V1-----"
    },
    "tests": [
     {
      "line": "-----BEGIN OpenVPN Static key V1-----",
      "match": true
     },
     {
      "line": "# OpenVPN static keys live in the key directory",
      "match": false
     },
     {
      "line": "-----BEGIN OpenVPN Static key V0-----",
      "match": false
     }
    ]
   },
   {
    "suffix": "fmt-wireguard-private-key",
    "lang": "universal",
    "name": "a WireGuard PrivateKey line",
    "signal": {
     "source": "\\bPrivateKey\\s*=\\s*[A-Za-z0-9+/]{42,44}="
    },
    "tests": [
     {
      "line": "PrivateKey = QQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQ=",
      "match": true
     },
     {
      "line": "PrivateKey = <redacted>",
      "match": false
     },
     {
      "line": "# PrivateKey is produced by wg genkey",
      "match": false
     }
    ]
   },
   {
    "suffix": "fmt-ssh2-encrypted-key",
    "lang": "universal",
    "name": "an SSH2 encrypted private-key header",
    "signal": {
     "source": "-----BEGIN SSH2 ENCRYPTED PRIVATE KEY-----"
    },
    "tests": [
     {
      "line": "-----BEGIN SSH2 ENCRYPTED PRIVATE KEY-----",
      "match": true
     },
     {
      "line": "-----BEGIN SSH2 PUBLIC KEY-----",
      "match": false
     },
     {
      "line": "# SSH2 keys are converted on import",
      "match": false
     }
    ]
   },
   {
    "suffix": "fmt-der-key-material",
    "lang": "universal",
    "name": "DER-encoded key material in base64",
    "signal": {
     "source": "\\bMII[A-Za-z0-9+/]{60,}={0,2}"
