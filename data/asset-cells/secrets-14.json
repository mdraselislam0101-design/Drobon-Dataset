[
 {
  "kind": "secrets",
  "cwe": "CWE-798",
  "severity": "HIGH",
  "framing": "custom",
  "title": "Possible {name} in source",
  "confidence": "MEDIUM",
  "class": "credential-file-formats",
  "category": "hardcoded-credential",
  "description": "The file contains {name}. The format is ordinary text, so committing the file exposes the whole credential to everyone with repository access. Shape-only: the match does not prove the credential is live.",
  "scopeT": "One line, matching {name}.",
  "recordDesc": "{name} is a credential stored in a tool-specific file. Because the format is plain text, every clone, backup and artifact copy carries the credential until it is rotated and the file is provisioned at run time.",
  "why": "{name} is plain text by design, so version control stores it forever and every copy of the tree is a copy of the credential.",
  "applicability": "Configuration files, credential files and deploy templates that may contain {name}.",
  "risk": "Use of the credential by anyone who can read a clone or an artifact; HIGH severity.",
  "fix": [
   "Rotate the credential the file holds.",
   "Remove the file from the repository and from image layers.",
   "Provision the file at run time from the platform credential store."
  ],
  "verifyT": "The rotated credential no longer works and the tree contains no file of this shape.",
  "remediation": "Rotate the credential the file describes, delete the file from the repository, and provision it at run time from a secret manager or the platform credential store with restrictive permissions.",
  "limitation": "Shape-only: the rule recognises one file format and one credential position inside it. It cannot prove the value is live and it does not parse the surrounding document.",
  "fp": "Template files and documentation that use the same format with placeholder bodies are the common false positives; the pattern requires a shaped value and vetoes EXAMPLE text.",
  "cells": [
   {
    "suffix": "fmt-netrc-password",
    "lang": "universal",
    "name": "a .netrc password entry",
    "signal": {
     "source": "\\bmachine\\s+\\S+\\s+login\\s+\\S+\\s+password\\s+\\S{6,}"
    },
    "tests": [
     {
      "line": "machine api.internal login deploy password Zq7mKp4tQQQQQQQQQQQQ",
      "match": true
     },
     {
      "line": "# .netrc is generated by the deploy job",
      "match": false
     }
    ]
   },
   {
    "suffix": "fmt-pgpass-entry",
    "lang": "universal",
    "name": "a .pgpass credential line",
    "signal": {
     "source": "[A-Za-z0-9_.\\-]+:\\d{2,5}:[A-Za-z0-9_*.\\-]+:[A-Za-z0-9_*.\\-]+:\\S{6,}"
    },
    "tests": [
     {
      "line": "db.internal:5432:appdb:appuser:Zq7mKp4tQQQQQQQQQQQQ",
      "match": true
     },
     {
      "line": "# .pgpass lines are written at deploy time",
      "match": false
     }
    ]
   },
   {
    "suffix": "fmt-odbc-pwd",
    "lang": "universal",
    "name": "an ODBC DSN password (PWD) entry",
    "signal": {
     "source": "\\bPWD\\s*=\\s*[^;\\s]{6,}"
    },
    "tests": [
     {
      "line": "PWD=Zq7mKp4tQQQQQQQQQQQQ;",
      "match": true
     },
     {
      "line": "; PWD is supplied by the connection manager",
      "match": false
     }
    ]
   },
   {
    "suffix": "fmt-webconfig-decryption-key",
    "lang": "universal",
    "name": "an ASP.NET machineKey decryption key",
    "signal": {
     "source": "\\bdecryptionKey\\s*=\\s*\"[A-Za-z0-9+/=]{24,}\""
    },
    "tests": [
     {
      "line": "decryptionKey=\"MIIEvQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQ\"",
      "match": true
     },
     {
      "line": "decryptionKey=\"EXAMPLE-EXAMPLE-EXAMPLE\"",
      "match": false
     },
     {
      "line": "<!-- decryptionKey is generated per deployment -->",
      "match": false
     }
    ]
   },
   {
    "suffix": "fmt-webconfig-validation-key",
    "lang": "universal",
    "name": "an ASP.NET machineKey validation key",
    "signal": {
     "source": "\\bvalidationKey\\s*=\\s*\"[A-Za-z0-9+/=]{24,}\""
    },
    "tests": [
     {
      "line": "validationKey=\"MIIEvQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQ\"",
      "match": true
     },
     {
      "line": "validationKey=\"EXAMPLE-EXAMPLE-EXAMPLE\"",
      "match": false
     },
     {
      "line": "<!-- validationKey rotates automatically -->",
      "match": false
     }
    ]
   },
   {
    "suffix": "fmt-redis-requirepass",
    "lang": "universal",
    "name": "a redis.conf requirepass directive",
    "signal": {
     "source": "^\\s*requirepass\\s+\\S{8,}"
    },
    "tests": [
     {
      "line": "requirepass Zq7mKp4tQQQQQQQQQQQQ",
      "match": true
     },
     {
      "line": "requirepass EXAMPLE",
      "match": false
     },
     {
      "line": "# requirepass is managed by the operator",
      "match": false
     }
    ]
   },
   {
    "suffix": "fmt-jmxremote-role",
    "lang": "universal",
    "name": "a JMX remote role password",
    "signal": {
     "source": "^\\s*(?:monitorRole|controlRole)\\s+\\S{8,}"
    },
    "tests": [
     {
      "line": "monitorRole Zq7mKp4tQQQQQQQQQQQQ",
      "match": true
     },
     {
      "line": "monitorRole EXAMPLE",
      "match": false
     },
     {
      "line": "# monitorRole is disabled by default",
      "match": false
     }
    ]
   },
   {
    "suffix": "fmt-ansible-vault-header",
    "lang": "universal",
    "name": "an Ansible Vault encrypted payload header",
    "signal": {
     "source": "\\$ANSIBLE_VAULT;1\\.[12];AES256"
    },
    "tests": [
     {
      "line": "$ANSIBLE_VAULT;1.1;AES256",
      "match": true
     },
     {
      "line": "$ANSIBLE_VAULT;1.2;AES128",
      "match": false
     },
     {
      "line": "# vault files are decrypted by the playbook",
      "match": false
