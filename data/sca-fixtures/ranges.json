{
  "schemaVersion": "drobon.sca.fixture-corpus/v1",
  "corpus": "ranges",
  "synthetic": true,
  "productionData": false,
  "note": "Synthetic version-range boundary cases for the local evaluator. npm comparators/hyphen/OR/wildcards; pypi PEP 440 specifier sets. Caret and tilde are npm-unsupported here and appear only as invalid cases.",
  "cases": [
    {
      "id": "RANGE-001",
      "ecosystem": "npm",
      "version": "1.5.0",
      "range": ">=1.0.0 <2.0.0",
      "expected": true,
      "reason": "inside an AND comparator set"
    },
    {
      "id": "RANGE-002",
      "ecosystem": "npm",
      "version": "2.0.0",
      "range": ">=1.0.0 <2.0.0",
      "expected": false,
      "reason": "upper bound is exclusive"
    },
    {
      "id": "RANGE-003",
      "ecosystem": "npm",
      "version": "1.0.0",
      "range": ">=1.0.0 <2.0.0",
      "expected": true,
      "reason": "lower bound is inclusive"
    },
    {
      "id": "RANGE-004",
      "ecosystem": "npm",
      "version": "1.2.9",
      "range": "1.2.x",
      "expected": true,
      "reason": "wildcard matches within the minor line"
    },
    {
      "id": "RANGE-005",
      "ecosystem": "npm",
      "version": "1.3.0",
      "range": "1.2.x",
      "expected": false,
      "reason": "wildcard does not cross the minor boundary"
    },
    {
      "id": "RANGE-006",
      "ecosystem": "npm",
      "version": "1.5.0",
      "range": "1.0.0 - 2.0.0",
      "expected": true,
      "reason": "hyphen range includes the interior"
    },
    {
      "id": "RANGE-007",
      "ecosystem": "npm",
      "version": "2.1.0",
      "range": "1.0.0 - 2.0.0",
      "expected": false,
      "reason": "hyphen range excludes versions above the upper bound"
    },
    {
      "id": "RANGE-008",
      "ecosystem": "npm",
      "version": "3.0.0",
      "range": "1.x || 3.x",
      "expected": true,
      "reason": "the second OR branch matches"
    },
    {
      "id": "RANGE-009",
      "ecosystem": "npm",
      "version": "2.0.0",
      "range": "1.x || 3.x",
      "expected": false,
      "reason": "neither OR branch matches"
    },
    {
      "id": "RANGE-010",
      "ecosystem": "npm",
      "version": "1.2.3-beta.1",
      "range": ">=1.0.0 <2.0.0",
      "expected": true,
      "reason": "a prerelease inside the numeric bounds is evaluated, not guessed"
    },
    {
      "id": "RANGE-011",
      "ecosystem": "pypi",
      "version": "1.4.2",
      "range": "==1.4.*",
      "expected": true,
      "reason": "prefix match covers the release line"
    },
    {
      "id": "RANGE-012",
      "ecosystem": "pypi",
      "version": "1.5.0",
      "range": "==1.4.*",
      "expected": false,
      "reason": "prefix match stops at the boundary"
    },
    {
      "id": "RANGE-013",
      "ecosystem": "pypi",
      "version": "1.4.5",
      "range": "~=1.4.2",
      "expected": true,
      "reason": "compatible release includes later patch versions"
    },
    {
      "id": "RANGE-014",
      "ecosystem": "pypi",
      "version": "1.5.0",
      "range": "~=1.4.2",
      "expected": false,
      "reason": "compatible release excludes the next minor"
    },
    {
      "id": "RANGE-015",
      "ecosystem": "pypi",
      "version": "1.9.9",
      "range": ">=1.0,<2.0",
      "expected": true,
      "reason": "AND comparator set"
    },
    {
      "id": "RANGE-016",
      "ecosystem": "pypi",
      "version": "2.0",
      "range": ">=1.0,<2.0",
      "expected": false,
      "reason": "upper bound is exclusive"
    },
    {
      "id": "RANGE-017",
      "ecosystem": "pypi",
      "version": "1.4.2",
      "range": "!=1.4.2",
      "expected": false,
      "reason": "exclusion matches the exact version"
    },
    {
      "id": "RANGE-018",
      "ecosystem": "pypi",
      "version": "2.0.0",
      "range": "~=1.4.2",
      "expected": false,
      "reason": "compatible release never spans a major bump"
    }
  ],
  "invalidRanges": [
    {
      "id": "RANGE-BAD-001",
      "ecosystem": "npm",
      "range": "^1.2.3",
      "reasonFragment": "bad comparator"
    },
    {
      "id": "RANGE-BAD-002",
      "ecosystem": "npm",
      "range": "*",
      "reasonFragment": "bare \"*\""
    },
    {
      "id": "RANGE-BAD-003",
      "ecosystem": "pypi",
      "range": "~=1",
      "reasonFragment": "at least two release segments"
    }
  ]
}
