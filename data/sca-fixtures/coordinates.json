{
  "schemaVersion": "drobon.sca.fixture-corpus/v1",
  "corpus": "coordinates",
  "synthetic": true,
  "productionData": false,
  "note": "Synthetic contract fixtures only. No package metadata, no advisory data, no third-party identifiers. Excluded from every production count.",
  "cases": [
    {
      "id": "COORD-001",
      "ecosystem": "pypi",
      "input": "Django",
      "expected": {
        "ok": true,
        "name": "django"
      },
      "reason": "PEP 503 lowercases the project name"
    },
    {
      "id": "COORD-002",
      "ecosystem": "pypi",
      "input": "Zope.Interface",
      "expected": {
        "ok": true,
        "name": "zope-interface"
      },
      "reason": "PEP 503 collapses runs of . _ - into a single hyphen"
    },
    {
      "id": "COORD-003",
      "ecosystem": "pypi",
      "input": "my_pkg",
      "expected": {
        "ok": true,
        "name": "my-pkg"
      },
      "reason": "underscores normalise to hyphens"
    },
    {
      "id": "COORD-004",
      "ecosystem": "pypi",
      "input": "  requests  ",
      "expected": {
        "ok": true,
        "name": "requests"
      },
      "reason": "surrounding whitespace is trimmed"
    },
    {
      "id": "COORD-005",
      "ecosystem": "pypi",
      "input": "a__b..c--d",
      "expected": {
        "ok": true,
        "name": "a-b-c-d"
      },
      "reason": "a run of separators collapses to one hyphen"
    },
    {
      "id": "COORD-006",
      "ecosystem": "pypi",
      "input": "-leading",
      "expected": {
        "ok": false,
        "code": "INVALID_NAME"
      },
      "reason": "a leading separator leaves no leading alphanumeric"
    },
    {
      "id": "COORD-007",
      "ecosystem": "pypi",
      "input": "   ",
      "expected": {
        "ok": false,
        "code": "EMPTY_NAME"
      },
      "reason": "whitespace-only names are refused, never trimmed to empty"
    },
    {
      "id": "COORD-008",
      "ecosystem": "npm",
      "input": "Lodash",
      "expected": {
        "ok": true,
        "name": "lodash"
      },
      "reason": "npm names are lowercase"
    },
    {
      "id": "COORD-009",
      "ecosystem": "npm",
      "input": "  React ",
      "expected": {
        "ok": true,
        "name": "react"
      },
      "reason": "whitespace is trimmed before validation"
    },
    {
      "id": "COORD-010",
      "ecosystem": "npm",
      "input": "@scope/pkg",
      "expected": {
        "ok": false,
        "code": "SCOPED_NAME_UNSUPPORTED"
      },
      "reason": "the bounded record schema covers unscoped names only; identity is not mangled"
    },
    {
      "id": "COORD-011",
      "ecosystem": "npm",
      "input": "pkg/sub",
      "expected": {
        "ok": false,
        "code": "SCOPED_NAME_UNSUPPORTED"
      },
      "reason": "a path separator is never silently removed"
    },
    {
      "id": "COORD-012",
      "ecosystem": "npm",
      "input": "bad name",
      "expected": {
        "ok": false,
        "code": "INVALID_NAME"
      },
      "reason": "spaces are outside the bounded name grammar"
    },
    {
      "id": "COORD-013",
      "ecosystem": "maven",
      "input": "log4j-core",
      "expected": {
        "ok": false,
        "code": "UNKNOWN_ECOSYSTEM"
      },
      "reason": "only the allowlisted ecosystems are supported"
    },
    {
      "id": "COORD-014",
      "ecosystem": "npm",
      "input": "",
      "expected": {
        "ok": false,
        "code": "EMPTY_NAME"
      },
      "reason": "empty names are refused"
    }
  ]
}
