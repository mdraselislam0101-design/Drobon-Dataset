{
  "schemaVersion": "drobon.sca.fixture-corpus/v1",
  "synthetic": true,
  "productionData": false,
  "note": "Synthetic duplicate-coordinate corpus for the offline SCA contract. It proves that a coordinate declared more than once resolves to the same classification whatever the listing order. Every name is invented for the test; it contains no real package, version or advisory.",
  "scenarios": [
    {
      "id": "direct-first",
      "entries": [
        {
          "ecosystem": "npm",
          "name": "order-a",
          "version": "1.0.0",
          "direct": true,
          "requires": []
        },
        {
          "ecosystem": "npm",
          "name": "order-a",
          "version": "1.0.0",
          "direct": false,
          "requires": []
        }
      ]
    },
    {
      "id": "direct-last",
      "entries": [
        {
          "ecosystem": "npm",
          "name": "order-a",
          "version": "1.0.0",
          "direct": false,
          "requires": []
        },
        {
          "ecosystem": "npm",
          "name": "order-a",
          "version": "1.0.0",
          "direct": true,
          "requires": []
        }
      ]
    },
    {
      "id": "all-transitive",
      "entries": [
        {
          "ecosystem": "npm",
          "name": "order-b",
          "version": "2.0.0",
          "direct": false,
          "requires": []
        },
        {
          "ecosystem": "npm",
          "name": "order-b",
          "version": "2.0.0",
          "requires": []
        }
      ]
    }
  ],
  "expected": {
    "duplicateNoted": ["npm:order-a@1.0.0", "npm:order-b@2.0.0"],
    "directForOrderA": ["npm:order-a@1.0.0"],
    "directForOrderB": [],
    "reason": "A coordinate declared direct by any entry is a root; the same coordinate declared only transitively stays transitive. The duplicate is always reported, and the resolved classification never depends on listing order."
  }
}
