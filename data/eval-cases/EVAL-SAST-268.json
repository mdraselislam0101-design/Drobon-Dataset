  "fixture": {
    "name": "synthetic_eval_sast_268.php",
    "lines": [
      "<?php",
      "",
      "declare(strict_types=1);",
      "",
      "namespace App\\Reports;",
      "",
      "use PDO;",
      "",
      "final class AccountRepository",
      "{",
      "    public function __construct(private readonly PDO $pdo)",
      "    {",
      "    }",
      "",
      "    public function findEmail(int $accountId): ?string",
      "    {",
      "        $statement = $this->pdo->prepare('SELECT email FROM accounts WHERE account_id = :id');",
      "        $statement->execute(['id' => $accountId]);",
      "        $row = $statement->fetch(PDO::FETCH_ASSOC);",
      "        return $row === false ? null : (string) $row['email'];",
      "    }",
      "",
      "    public function create(string $email, string $password): int",
      "    {",
      "        $hash = password_hash($password, PASSWORD_DEFAULT);",
      "        $statement = $this->pdo->prepare(",
      "            'INSERT INTO accounts (email, password_hash) VALUES (:email, :hash)'",
      "        );",
      "        $statement->execute(['email' => $email, 'hash' => $hash]);",
      "        return (int) $this->pdo->lastInsertId();",
      "    }",
      "",
      "    public function render(array $rows): string",
      "    {",
      "        $cells = array_map(",
      "            static fn (array $row): string => '<td>' . htmlspecialchars((string) $row['email'], ENT_QUOTES, 'UTF-8') . '</td>',",
      "            $rows",
      "        );",
      "        return '<tr>' . implode('', $cells) . '</tr>';",
      "    }",
      "",
      "    public function newToken(): string",
      "    {",
      "        return bin2hex(random_bytes(16));",
      "    }",
      "",
      "    public function encode(array $payload): string",
      "    {",
      "        return json_encode($payload, JSON_THROW_ON_ERROR);",
      "    }",
      "}"
    ]
  },
