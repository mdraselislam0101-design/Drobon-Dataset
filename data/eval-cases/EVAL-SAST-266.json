  "fixture": {
    "name": "synthetic_eval_sast_266.js",
    "lines": [
      "import { createHash, randomBytes } from 'node:crypto';",
      "import { readFile, writeFile, mkdir } from 'node:fs/promises';",
      "import path from 'node:path';",
      "",
      "const REPORT_DIR = path.join(process.cwd(), 'reports');",
      "const TIMEOUT_MS = 5000;",
      "",
      "export function cacheKey(payload) {",
      "  return createHash('sha256').update(JSON.stringify(payload)).digest('hex');",
      "}",
      "",
      "export async function fetchJson(url, signal) {",
      "  const controller = new AbortController();",
      "  const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);",
      "  try {",
      "    const response = await fetch(url, {",
      "      signal: signal ?? controller.signal,",
      "      headers: { accept: 'application/json' },",
      "    });",
      "    if (!response.ok) {",
      "      throw new Error(`unexpected status ${response.status}`);",
      "    }",
      "    return await response.json();",
      "  } finally {",
      "    clearTimeout(timer);",
      "  }",
      "}",
      "",
      "export async function saveReport(name, rows) {",
      "  await mkdir(REPORT_DIR, { recursive: true });",
      "  const target = path.join(REPORT_DIR, path.basename(name));",
      "  const body = rows.map((row) => `${row.id}: ${row.count}`).join('\\n');",
      "  await writeFile(target, body, 'utf8');",
      "  return target;",
      "}",
      "",
      "export function newToken(size = 24) {",
      "  return randomBytes(size).toString('base64url');",
      "}",
      "",
      "export async function readConfig(file) {",
      "  return JSON.parse(await readFile(path.resolve(file), 'utf8'));",
      "}"
    ]
  },
