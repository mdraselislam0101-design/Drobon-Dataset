    "name": "synthetic_eval_sast_269.rb",
    "lines": [
      "require 'json'",
      "require 'securerandom'",
      "require 'yaml'",
      "require 'open3'",
      "require 'erb'",
      "",
      "module Reports",
      "  class AccountService",
      "    def initialize(store)",
      "      @store = store",
      "    end",
      "",
      "    def find_email(account_id)",
      "      row = @store.fetch(account_id)",
      "      row && row[:email]",
      "    end",
      "",
      "    def load_config(path)",
      "      YAML.safe_load(File.read(path), permitted_classes: [Symbol])",
      "    rescue Psych::Exception => error",
      "      warn \"config unreadable: #{error.class}\"",
      "      {}",
      "    end",
      "",
      "    def render(rows)",
      "      cells = rows.map { |row| \"<td>#{ERB::Util.html_escape(row[:email])}</td>\" }",
      "      \"<tr>#{cells.join}</tr>\"",
      "    end",
      "",
      "    def run_report(command, *args)",
      "      _stdout, stderr, status = Open3.capture3(command, *args)",
      "      raise \"report failed: #{status.exitstatus}\" unless status.success?",
      "      stderr",
      "    end",
      "",
      "    def new_token",
      "      SecureRandom.urlsafe_base64(24)",
      "    end",
      "",
      "    def save(payload, directory)",
      "      target = File.join(directory, 'report.json')",
      "      File.write(target, JSON.pretty_generate(payload))",
      "      target",
      "    end",
      "  end",
      "end"
    ]
  },
